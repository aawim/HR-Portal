<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HRM.ErrorLogs.Cli</RootNamespace>
    <UserSecretsId>hrm-local-development-20261022</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.7" />
    <!-- Override SqlClient's legacy CNG dependency chain; 5.0.0 is affected by CVE-2024-38095. -->
    <PackageReference Include="System.Formats.Asn1" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRM.Core\HRM.Core.csproj" />
    <ProjectReference Include="..\HRM.ErrorLogs\HRM.ErrorLogs.csproj" />
  </ItemGroup>

</Project>
