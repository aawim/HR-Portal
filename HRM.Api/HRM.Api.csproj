<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>HRM</RootNamespace>
    <UserSecretsId>hrm-local-development-20261022</UserSecretsId>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>

  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Hosting/SecureDataProtection.cs" Link="Hosting/SecureDataProtection.cs" />
    <Compile Include="../Hosting/TrustedProxyHeaders.cs" Link="Hosting/TrustedProxyHeaders.cs" />
    <Compile Include="../Hosting/RuntimeRequirements.cs" Link="Hosting/RuntimeRequirements.cs" />
    <ProjectReference Include="../HRM.Core/HRM.Core.csproj" />
    <ProjectReference Include="../HRM.Application/HRM.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource LogicalName="HRM.Database.Scripts.20261029_RetireUnusedLegacyTables.sql" Include="Database\Scripts\20261029_RetireUnusedLegacyTables.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261020_IndependentLeaveChangeRequests.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261022_PrefixFeatureTables.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261025_WorkingHoursAndScheduleAmendments.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261025_TemplateDerivedWorkingHours.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261025_ScopeScheduleAssignments.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261025_LegacySchemaCompatibility.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261026_UnifiedLeaveTypes.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261026_PrefixLeavePolicyTables.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261026_ScopedLeaveHandoverRules.sql" />
    <EmbeddedResource LogicalName="HRM.Database.Scripts.%(Filename)%(Extension)" Include="Database\Scripts\20261027_PrefixBusinessEntityTables.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.26" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.27">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>






</Project>
