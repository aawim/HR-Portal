<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><RootNamespace>HRM</RootNamespace><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors><NoWarn>$(NoWarn);NU1900</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><NuGetAudit>false</NuGetAudit><NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Hosting/SecureDataProtection.cs" Link="Hosting/SecureDataProtection.cs" />
    <Compile Include="../Hosting/TrustedProxyHeaders.cs" Link="Hosting/TrustedProxyHeaders.cs" />
    <Compile Include="../Hosting/RuntimeRequirements.cs" Link="Hosting/RuntimeRequirements.cs" />
    <ProjectReference Include="../HRM.Application/HRM.Application.csproj" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.0" />
  </ItemGroup>
</Project>
