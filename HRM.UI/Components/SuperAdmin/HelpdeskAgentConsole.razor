</section>

@code {
    [Parameter] public bool Embedded { get; set; }

    private static readonly (string Key, string Label)[] QueueFilters =
    [
        ("queue", "Needs Attention"),
        ("waiting", "Waiting"),
        ("active", "Live"),
        ("bot", "Bot"),
        ("resolved", "Resolved"),
        ("all", "All")
    ];

    private string subTab = "queue";
    private string statusFilter = "queue";
    private int selectedOrganisationId;
    private string queueSearch = "", kbSearch = "";
    private string agentReplyBody = "";
    private bool agentInternalNote;
    private string? error;
    private bool busy, disposed, scroll;

    private HelpdeskAgentInboxDto inbox = new();
    private HelpdeskTicketDetailDto? selectedTicket;
    private List<HelpdeskArticleDto> articles = [];
    private bool showArticleModal, showImportModal;
    private HelpdeskArticleDto articleDraft = new();
    private string importCategory = "General";
    private List<ImportDraftItem> importedDrafts = [];

    private sealed class ImportDraftItem
    {
        public bool Selected { get; set; } = true;
        public string Title { get; set; } = "";
        public string Keywords { get; set; } = "";
        public string Answer { get; set; } = "";
    }

    private ElementReference agentMessagesEl;
    private readonly CancellationTokenSource stop = new();
    private Task? watching;

    protected override async Task OnInitializedAsync()
    {
        await LoadInboxAsync();
        watching = WatchAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scroll && selectedTicket != null)
        {
            scroll = false;
            try { await JS.InvokeVoidAsync("hrmChat.scrollToLatest", agentMessagesEl, true); } catch { }
        }
    }

    private async Task SwitchSubTabAsync(string next)
    {
        subTab = next;
        if (next == "kb") await LoadArticlesAsync();
        else await LoadInboxAsync();
    }

    private async Task RefreshCurrentAsync()
    {
        if (subTab == "kb") await LoadArticlesAsync();
        else
        {
            await LoadInboxAsync();
            if (selectedTicket != null) await SelectTicketAsync(selectedTicket.Ticket.Id);
        }
    }

    private async Task SetStatusFilterAsync(string filterKey)
    {
        statusFilter = filterKey;
        await LoadInboxAsync();
    }

    private async Task LoadInboxAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try { inbox = await Helpdesk.GetAgentInboxAsync(statusFilter, selectedOrganisationId, queueSearch); }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task SelectTicketAsync(long ticketId)
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            selectedTicket = await Helpdesk.GetTicketAsync(ticketId);
            scroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task TakeOverAsync()
    {
        if (busy || selectedTicket == null) return;
        busy = true;
        error = null;
        try
        {
            selectedTicket = await Helpdesk.TakeOverTicketAsync(selectedTicket.Ticket.Id);
            inbox = await Helpdesk.GetAgentInboxAsync(statusFilter, selectedOrganisationId, queueSearch);
            Toast.Success($"You have taken over {selectedTicket.Ticket.TicketNumber}.");
            scroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task SendAgentReplyAsync()
    {
        if (busy || selectedTicket == null || string.IsNullOrWhiteSpace(agentReplyBody)) return;
        busy = true;
        error = null;
        try
        {
            selectedTicket = await Helpdesk.SendAgentMessageAsync(selectedTicket.Ticket.Id, agentReplyBody, agentInternalNote);
            agentReplyBody = "";
            inbox = await Helpdesk.GetAgentInboxAsync(statusFilter, selectedOrganisationId, queueSearch);
            scroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task ResolveAsAgentAsync()
    {
        if (busy || selectedTicket == null) return;
        busy = true;
        error = null;
        try
        {
            selectedTicket = await Helpdesk.ResolveTicketByAgentAsync(selectedTicket.Ticket.Id, "");
            inbox = await Helpdesk.GetAgentInboxAsync(statusFilter, selectedOrganisationId, queueSearch);
            Toast.Success($"Ticket {selectedTicket.Ticket.TicketNumber} marked resolved.");
            scroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task ReopenAsAgentAsync()
    {
        if (busy || selectedTicket == null) return;
        busy = true;
        error = null;
        try
        {
            selectedTicket = await Helpdesk.ReopenTicketAsync(selectedTicket.Ticket.Id);
            inbox = await Helpdesk.GetAgentInboxAsync(statusFilter, selectedOrganisationId, queueSearch);
            scroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task LoadArticlesAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try { articles = await Helpdesk.GetArticlesAsync(kbSearch); }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private void OpenNewArticleModal()
    {
        articleDraft = new HelpdeskArticleDto { Category = "General", IsActive = true, SortOrder = (articles.Count + 1) * 10 };
        showArticleModal = true;
    }

    private void OpenImportModal()
    {
        importCategory = "General";
        importedDrafts = [];
        showImportModal = true;
    }

    private async Task OnPolicyFileSelectedAsync(InputFileChangeEventArgs e)
    {
        error = null;
        importedDrafts = [];
        var file = e.File;
        if (file == null) return;
        if (file.Size > 512 * 1024)
        {
            error = "Policy file must be 512 KB or smaller.";
            return;
        }
        try
        {
            using var reader = new StreamReader(file.OpenReadStream(512 * 1024));
            var raw = await reader.ReadToEndAsync();
            importedDrafts = ParsePolicySections(file.Name, raw);
            if (importedDrafts.Count == 0)
                error = "No readable text sections were found in the uploaded file.";
        }
        catch (Exception ex) { Fail(ex); }
    }

    private static List<ImportDraftItem> ParsePolicySections(string fileName, string content)
    {
        var results = new List<ImportDraftItem>();
        var lines = content.Replace("\r\n", "\n").Split('\n');
        var currentTitle = Path.GetFileNameWithoutExtension(fileName);
        var buffer = new List<string>();

        void Flush()
        {
            var body = string.Join("\n", buffer).Trim();
            buffer.Clear();
            if (body.Length < 15) return;
            if (body.Length > 3900) body = body[..3900].TrimEnd() + "...";
            var cleanTitle = currentTitle.Trim('#', ' ', '\t');
            if (string.IsNullOrWhiteSpace(cleanTitle)) cleanTitle = "Policy Guide";
            if (cleanTitle.Length > 190) cleanTitle = cleanTitle[..190];
            var words = System.Text.RegularExpressions.Regex.Matches(cleanTitle.ToLowerInvariant(), "[a-z0-9]{3,}")
                .Select(m => m.Value)
                .Distinct()
                .Take(12);
            results.Add(new ImportDraftItem
            {
                Selected = true,
                Title = cleanTitle,
                Keywords = string.Join(", ", words),
                Answer = body
            });
        }

        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            if (trimmed.StartsWith("#", StringComparison.Ordinal))
            {
                Flush();
                currentTitle = trimmed.TrimStart('#').Trim();
            }
            else
            {
                buffer.Add(line);
            }
        }
        Flush();
        return results;
    }

    private async Task ImportSelectedArticlesAsync()
    {
        if (busy) return;
        var selected = importedDrafts.Where(x => x.Selected).ToList();
        if (selected.Count == 0) return;
        busy = true;
        error = null;
        var imported = 0;
        try
        {
            var order = (articles.Count + 1) * 10;
            foreach (var item in selected)
            {
                var res = await Helpdesk.SaveArticleAsync(new HelpdeskArticleDto
                {
                    Category = importCategory,
                    Title = item.Title,
                    Keywords = item.Keywords,
                    Answer = item.Answer,
                    IsActive = true,
                    SortOrder = order
                });
                if (res.Success)
                {
                    imported++;
                    order += 10;
                }
            }
            Toast.Success($"Imported {imported} Knowledge Base article{(imported == 1 ? "" : "s")}.");
            showImportModal = false;
            importedDrafts = [];
            articles = await Helpdesk.GetArticlesAsync(kbSearch);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private void OpenEditArticleModal(HelpdeskArticleDto art)
    {
        articleDraft = new HelpdeskArticleDto
        {
            Id = art.Id,
            Category = art.Category,
            Title = art.Title,
            Keywords = art.Keywords,
            Answer = art.Answer,
            IsActive = art.IsActive,
            SortOrder = art.SortOrder
        };
        showArticleModal = true;
    }

    private void OpenKbFromTicket()
    {
        if (selectedTicket == null) return;
        var lastAgentMsg = selectedTicket.Messages.LastOrDefault(m => m.SenderType == HelpdeskSenderTypes.Agent && !m.IsInternalNote)?.Body ?? "";
        articleDraft = new HelpdeskArticleDto
        {
            Category = selectedTicket.Ticket.Category,
            Title = selectedTicket.Ticket.Subject,
            Keywords = selectedTicket.Ticket.Category.ToLowerInvariant(),
            Answer = lastAgentMsg,
            IsActive = true,
            SortOrder = 100
        };
        showArticleModal = true;
    }

    private async Task SaveArticleAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            var result = await Helpdesk.SaveArticleAsync(articleDraft);
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message);
            showArticleModal = false;
            articles = await Helpdesk.GetArticlesAsync(kbSearch);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task DeleteArticleAsync(int id)
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            var result = await Helpdesk.DeleteArticleAsync(id);
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message);
            articles = await Helpdesk.GetArticlesAsync(kbSearch);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task WatchAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (busy || disposed || subTab != "queue") return;
                    try
                    {
                        inbox = await Helpdesk.GetAgentInboxAsync(statusFilter, selectedOrganisationId, queueSearch);
                        if (selectedTicket != null)
                        {
                            var prevCount = selectedTicket.Messages.Count;
                            selectedTicket = await Helpdesk.GetTicketAsync(selectedTicket.Ticket.Id);
                            if (selectedTicket.Messages.Count > prevCount) scroll = true;
                        }
                        StateHasChanged();
                    }
                    catch { }
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private static string StatusLabel(string status) => status switch
    {
        HelpdeskTicketStatuses.BotActive => "Bot",
        HelpdeskTicketStatuses.WaitingForAgent => "Waiting",
        HelpdeskTicketStatuses.AgentAssigned => "Live",
        HelpdeskTicketStatuses.Resolved => "Resolved",
        _ => status
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        HelpdeskTicketStatuses.BotActive => "bg-blue-50 text-blue-700 border border-blue-200",
        HelpdeskTicketStatuses.WaitingForAgent => "bg-amber-100 text-amber-800 border border-amber-200",
        HelpdeskTicketStatuses.AgentAssigned => "bg-emerald-100 text-emerald-800 border border-emerald-200",
        HelpdeskTicketStatuses.Resolved => "bg-slate-100 text-slate-600 border border-slate-200",
        _ => "bg-slate-100 text-slate-700"
    };

    private void Fail(Exception ex)
    {
        Logger.LogWarning(ex, "Helpdesk agent console operation failed");
        error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Could not load Helpdesk console.";
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await stop.CancelAsync();
        if (watching != null) await watching;
        stop.Dispose();
    }
}
