@using Microsoft.AspNetCore.Components.Routing

<li>
    @if (Disabled)
    {
        <span aria-disabled="true" title="@(Compact ? Text : null)" class="app-nav-link @(Compact ? "is-compact" : null) flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 cursor-not-allowed">
            <span class="w-5 h-5 shrink-0 flex items-center justify-center"><AppIcon Name="@Icon" Class="text-xl" /></span>
            @if (!Compact) { <span class="text-sm">@Text</span> }
        </span>
    }
    else
    {
    <NavLink href="@Href"
             Match="@Match"
             title="@(Compact ? (BadgeCount > 0 ? $"{Text} ({BadgeCount})" : Text) : null)" aria-label="@(Compact ? Text : null)"
             class="@LinkClass"
             ActiveClass="app-nav-active font-semibold">

        <!-- Icon Rendering -->
        <span class="relative w-5 h-5 shrink-0 flex items-center justify-center">
            <AppIcon Name="@Icon" Class="text-xl" />
            @if (Compact && BadgeCount > 0)
            {
                <span class="absolute -top-1 -right-1.5 inline-flex min-w-[1rem] h-4 items-center justify-center rounded-full bg-rose-500 px-1 text-[9px] font-bold leading-none text-white">
                    @(BadgeCount > 99 ? "99+" : BadgeCount.ToString())
                </span>
            }
        </span>

        @if (!Compact)
        {
            <span class="text-sm flex-1 truncate">@Text</span>
            @if (BadgeCount > 0)
            {
                <span class="ml-auto inline-flex min-w-[1.25rem] h-5 items-center justify-center rounded-full bg-rose-500 px-1.5 text-[10px] font-bold leading-none text-white">
                    @(BadgeCount > 99 ? "99+" : BadgeCount.ToString())
                </span>
            }
        }
    </NavLink>
    }
</li>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public int BadgeCount { get; set; }
    [Parameter, EditorRequired]
    public string Href { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = "document";

    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    [Parameter]
    public bool IsActive { get; set; } // Optional: Can be used if you want to force an active state manually

    private string LinkClass => "app-nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors text-slate-300 hover:text-white" +
        (Compact ? " is-compact" : string.Empty);

}
