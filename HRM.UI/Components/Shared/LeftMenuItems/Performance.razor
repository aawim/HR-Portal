@page "/admin/performance"
@using Microsoft.AspNetCore.Components.Authorization

@rendermode RenderMode.InteractiveServer

<PageTitle>Performance - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="max-w-7xl mx-auto py-8 px-4">
            <div class="mb-6">
                <h1 class="text-3xl font-extrabold text-slate-800">Performance</h1>
                <p class="text-slate-500 mt-2">Manage employee goals, evaluations, and performance reviews.</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xs">
                <p class="text-base font-semibold text-slate-700">Performance Management is coming soon.</p>
                <p class="mt-1 text-sm text-slate-500">This module is currently under development. Return to your workspace to continue managing staff operations.</p>
                <a href="/admin/my/workspace" class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">
                    Return to My Workspace
                </a>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="p-6">
            <p class="text-slate-500">
                Please log in to view performance management.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>
