@page "/admin/attendance"
@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@inject IUserAccessService UserAccess

@rendermode RenderMode.InteractiveServer

<PageTitle>Attendance - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="max-w-12xl mx-auto py-8 px-4">
            <div class="mb-10">
                <h1 class="text-3xl font-extrabold text-slate-800">Attendance</h1>
                <p class="text-slate-500 mt-2">Manage staff attendance logs, leave applications, and overtime requests.</p>
            </div>

            @if (loading)
            {
                <div class="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Checking attendance permissions…</div>
            }
            else if (visibleCategories.Count == 0)
            {
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
                    You do not have permission to view any Attendance modules.
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    @foreach (var cat in visibleCategories)
                    {
                        <a href="@cat.Target"
                           class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-400 hover:bg-slate-50 transition-all duration-200 group flex items-center gap-6">

                            <div class="w-16 h-16 flex items-center justify-center rounded-lg bg-blue-50 text-3xl text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 flex-shrink-0">
                                @cat.Icon
                            </div>

                            <div class="flex-grow">
                                <h3 class="font-bold text-slate-800 text-lg mb-1 group-hover:text-blue-700">@cat.Title</h3>
                                <p class="text-slate-500 text-sm leading-tight">@cat.Description</p>
                            </div>

                            <div class="text-slate-300 group-hover:text-blue-600 transition-colors">
                                <AppIcon Name="chevron_right" Class="w-6 h-6 text-2xl" />
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="p-6">
            <p class="text-slate-500">
                Please log in to view attendance management.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private record Category(string Title, string Target, string Icon, string Description, params string[] Permissions);

    private bool loading = true;
    private List<Category> visibleCategories = new();

    private readonly List<Category> mainCategories = new()
    {
        new("Attendance Operations", "/admin/attendance/manage-attendance", "⏱️", "Review individual, department, and daily attendance logs, requests, and uneven punches.", "Admin", "Attendance.View", "Attendance.Manage"),
        new("Leave Management", "/admin/my/workspace/leave", "📅", "Review staff leave applications, leave changes, and leave balances.", "Admin", "Leave.View", "Leave.Approve"),
        new("Overtime Requests", "/admin/attendance/manage-overtimes", "📈", "Review, approve, and manage staff overtime pre-approvals and claims.", "Admin", "Attendance.View", "Attendance.Manage")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await UserAccess.RequireContextAsync();
            var isAdmin = actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Admin");
            var isHr = await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head");
            if (isAdmin || isHr)
            {
                visibleCategories = mainCategories.ToList();
                return;
            }

            var result = new List<Category>();
            foreach (var cat in mainCategories)
            {
                foreach (var perm in cat.Permissions)
                {
                    if (await UserAccess.HasPermissionAsync(perm))
                    {
                        result.Add(cat);
                        break;
                    }
                }
            }
            visibleCategories = result;
        }
        catch
        {
            visibleCategories = new();
        }
        finally
        {
            loading = false;
        }
    }
}
