@page "/admin/budget"
@page "/budget"
@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Models
@using HRM.Services
@rendermode RenderMode.InteractiveServer

<PageTitle>Budget - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="max-w-7xl mx-auto p-2 space-y-6">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-800">State Budget &amp; Appropriations</h1>
                <p class="text-sm text-slate-500 mt-1">Manage fiscal years, Ministry of Finance allocations, virements, ledger transactions, and payroll budget checks.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var cat in mainCategories)
                {
                    <a href="/admin/budget/@cat.Url"
                       class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs hover:shadow-md hover:border-blue-400 hover:bg-slate-50 transition-all duration-200 group flex items-center gap-5">

                        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-blue-50 text-2xl text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 flex-shrink-0">
                            @cat.Icon
                        </div>

                        <div class="flex-grow min-w-0">
                            <h3 class="font-bold text-slate-800 text-base mb-1 group-hover:text-blue-700">@cat.Title</h3>
                            <p class="text-slate-500 text-xs leading-relaxed">@cat.Description</p>
                        </div>

                        <div class="text-slate-300 group-hover:text-blue-600 transition-colors flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </div>
                    </a>
                }
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="p-6">
            <p class="text-slate-500">
                Please log in to view the dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private record Category(string Title, string Url, string Icon, string Description);

    private readonly List<Category> mainCategories = new()
    {
        new("Overview & Execution Reports", "overview", "📊", "Executive summary of budget allocations, personal emoluments utilization, and MoF CSV/PDF exports."),
        new("Budget Operations & Fiscal Years", "manage", "🏛️", "Configure Fiscal Years, State Budget Allocations, MoF Economic Codes, Virements, and Ledger Transactions."),
        new("Payroll Budget Bridge", "payroll-bridge", "🔗", "Automated pre-payroll budget solvency checks and payroll component to MoF COA mappings.")
    };
}
