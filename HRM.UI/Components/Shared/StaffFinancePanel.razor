@using HRM.Application.Contracts.Pages
@using HRM.DTOs
@using HRM.Components.Admin.My.Workspace
@using Microsoft.AspNetCore.Components.Forms
@inject IStaffFinance Finance
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject HRM.Services.Interfaces.Profile.IProfileService Profiles
@inject HRM.Services.ToastService Toasts
@inject IJSRuntime JS
@inject ILogger<StaffFinancePanel> Logger

<section class="staff-finance w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100">

    <!-- Compact Header (no background/border) -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">Allowances &amp; Deductions</h1>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Finance
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Manage recurring employee allowances, deduction agreements, repayment schedules, and financial requests.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    disabled="@busy"
                    @onclick="Load">
                <AppIcon Name="refresh" Class="@(busy ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
            <button type="button"
                    class="app-button app-button-primary app-button-sm"
                    disabled="@busy"
                    @onclick='() => tab = "New request"'>
                <AppIcon Name="add" Class="text-xs" />
                <span>New Request</span>
            </button>
        </div>
    </header>

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 px-3.5 py-2.5 text-xs text-rose-800 dark:text-rose-200">
            <span>@error</span>
            <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 hover:text-rose-800 dark:text-rose-400 ml-2" aria-label="Dismiss error">✕</button>
        </div>
    }

    @if (busy && (data == null || config == null))
    {
        <div role="status" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-xs text-slate-500 dark:text-slate-400">
            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
            <span>Loading finance details…</span>
        </div>
    }

    @if (data != null && config != null)
    {
        var activeAgreementsCount = data.Agreements.Count(x => x.Outstanding > 0);
        var pendingRequestsCount = data.Requests.Count(x => x.Status.Contains("Processing", StringComparison.OrdinalIgnoreCase) || x.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase));

        <!-- Narrow Sub-Navigation & Inline KPI Bar -->
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-xs">
            <nav class="flex flex-wrap items-center gap-1 overflow-x-auto" aria-label="Finance sections">
                @foreach (var item in Sections)
                {
                    var isActive = tab == item;
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors whitespace-nowrap @(isActive
                                ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800"
                                : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                            @onclick="() => SelectTab(item)">
                        <span>@item</span>
                        @if (item == "Requests" && data.Requests.Count > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold @(isActive ? "bg-teal-100 dark:bg-teal-900 text-teal-900 dark:text-teal-200" : "bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800")">
                                @data.Requests.Count
                            </span>
                        }
                        else if (item == "Allowances" && data.Allowances.Count > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold @(isActive ? "bg-teal-100 dark:bg-teal-900 text-teal-900 dark:text-teal-200" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300")">
                                @data.Allowances.Count
                            </span>
                        }
                        else if (item == "Agreements" && data.Agreements.Count > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold @(isActive ? "bg-teal-100 dark:bg-teal-900 text-teal-900 dark:text-teal-200" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300")">
                                @data.Agreements.Count
                            </span>
                        }
                    </button>
                }
            </nav>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500 dark:text-slate-400">
                <span class="inline-flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Allowances: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@data.Allowances.Count</strong>
                </span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span class="inline-flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                    Active Agreements: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@activeAgreementsCount</strong>
                </span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span class="inline-flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                    Pending: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@pendingRequestsCount</strong>
                </span>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- VIEW: NEW REQUEST (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        @if (tab == "New request")
        {
            @if (AdminMode && StaffId == 0 && data.CanManage)
            {
                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-3">
                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Select Employee</label>
                    <WorkspaceSearch StaffOnly="true" RequireActivePosition="true" OnSelected="SelectStaff" />
                    @if (selectedName != null)
                    {
                        <p class="text-xs font-semibold text-teal-700 dark:text-teal-300 mt-1.5">Selected: @selectedName</p>
                    }
                </div>
            }

            @if (jobId <= 0)
            {
                <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center text-xs text-slate-500 dark:text-slate-400">
                    Select a staff member with active employment to proceed with financial requests.
                </div>
            }
            else
            {
                <div class="sf-grid-7-5">

                    <!-- Left Column: New Request Form -->
                    <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                        <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                            <h2 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Create Financial Request</h2>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Submit an allowance, deduction agreement, or instalment modification.</p>
                        </div>

                        <fieldset disabled="@busy" class="p-3.5 space-y-3">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Request Type</label>
                                    <select @bind="kind"
                                            class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                        <option value="Allowance">Staff-requested allowance</option>
                                        <option value="Agreement">Deduction agreement</option>
                                        <option value="Defer">Defer an instalment</option>
                                        <option value="Payment">Payment by staff or another payer</option>
                                        <option value="EndAllowance">End an allowance</option>
                                    </select>
                                </div>

                                @if (kind == "Allowance")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Allowance Type</label>
                                        <select @bind="allowanceType"
                                                class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                            <option value="0">Select type</option>
                                            @foreach (var a in config.AllowanceTypes)
                                            {
                                                <option value="@a.Id">@a.Name</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (kind == "EndAllowance")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Select Allowance to End</label>
                                        <select @bind="allowanceType"
                                                class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                            <option value="0">Select allowance</option>
                                            @foreach (var a in data.Allowances.Where(x => x.JobId == jobId))
                                            {
                                                <option value="@a.Id">@a.Type · @a.Amount.ToString("N2")</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (kind is "Defer" or "Payment")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Agreement</label>
                                        <select @bind="agreementId"
                                                class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                            <option value="0">Select agreement</option>
                                            @foreach (var a in data.Agreements.Where(x => x.JobId == jobId && x.Outstanding > 0))
                                            {
                                                <option value="@a.Id">@a.Reference · @a.Outstanding.ToString("N2") outstanding</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (kind is "Agreement" or "Payment")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Amount</label>
                                        <InputNumber @bind-Value="amount" min="0.01" step="0.01"
                                                     class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                    </div>
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Currency</label>
                                        <select @bind="currency"
                                                class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                            <option value="0">Select currency</option>
                                            @foreach (var c in config.Currencies)
                                            {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">@DateLabel</label>
                                    <InputDate @bind-Value="from"
                                               class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                </div>

                                @if (kind == "Allowance")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">End Date (optional)</label>
                                        <InputDate @bind-Value="to"
                                                   class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                    </div>
                                }

                                @if (kind is "Allowance" or "Agreement")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Frequency</label>
                                        <select @bind="frequency"
                                                class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                            <option value="1">Monthly</option>
                                            <option value="6">Every six months</option>
                                            <option value="12">Annually</option>
                                        </select>
                                    </div>
                                }

                                @if (kind == "Agreement")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Instalment Count</label>
                                        <InputNumber @bind-Value="count" min="1" max="120"
                                                     class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                    </div>
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Category</label>
                                        <select @bind="category"
                                                class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                            <option>Loan</option>
                                            <option>Goods</option>
                                            <option>Insurance</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                }

                                @if (kind is "Agreement" or "Payment")
                                {
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                            @(kind == "Agreement" ? "Creditor / Registry ID" : "Payer Registry ID")
                                        </label>
                                        <InputNumber @bind-Value="entityId" min="1"
                                                     class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                    </div>
                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                            @(kind == "Agreement" ? "Agreement Reference" : "Receipt / Txn Reference")
                                        </label>
                                        <input @bind="reference" maxlength="200"
                                               class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                    </div>
                                }
                            </div>

                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Reason / Justification</label>
                                <textarea @bind="reason" rows="3" maxlength="2000"
                                          class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none"
                                          placeholder="Provide clear justification for this request…"></textarea>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 pt-2.5 border-t border-slate-200 dark:border-slate-800">
                                @if (kind == "Agreement")
                                {
                                    <button type="button"
                                            class="app-button app-button-secondary app-button-sm"
                                            @onclick="PreviewSchedule">
                                        Preview Repayments
                                    </button>
                                }
                                <button type="button"
                                        class="app-button app-button-primary app-button-sm"
                                        @onclick="Submit">
                                    Submit for Approval
                                </button>
                            </div>
                        </fieldset>
                    </div>

                    <!-- Right Column: Repayment Preview & Financial Context -->
                    <div class="min-w-0 flex flex-col gap-3">
                        @if (schedule.Count > 0 && kind == "Agreement")
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                                <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                                    <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Repayment Schedule Preview</h3>
                                    <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-800 dark:text-teal-300">
                                        @schedule.Count instalments
                                    </span>
                                </div>
                                <div class="max-h-72 overflow-y-auto">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-slate-50/60 dark:bg-slate-800/40 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
                                            <tr>
                                                <th class="px-3 py-2">Due Date</th>
                                                <th class="px-3 py-2 text-right">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                            @foreach (var i in schedule)
                                            {
                                                <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40">
                                                    <td class="px-3 py-2 font-mono text-[11px]">@i.DueDate.ToString("dd MMM yyyy")</td>
                                                    <td class="px-3 py-2 text-right font-semibold tabular-nums">@i.Amount.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        <!-- Financial Commitments Summary Card -->
                        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                            <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                                <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
                                    Current Financial Commitments
                                </h3>
                            </div>
                            <div class="p-3.5 space-y-3">
                                <div class="grid grid-cols-2 gap-2.5 text-xs">
                                    <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2.5">
                                        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Active Allowances</span>
                                        <span class="mt-0.5 block text-base font-bold text-slate-900 dark:text-slate-100 tabular-nums">
                                            @data.Allowances.Count(x => x.JobId == jobId)
                                        </span>
                                    </div>
                                    <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2.5">
                                        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Active Agreements</span>
                                        <span class="mt-0.5 block text-base font-bold text-slate-900 dark:text-slate-100 tabular-nums">
                                            @data.Agreements.Count(x => x.JobId == jobId && x.Outstanding > 0)
                                        </span>
                                    </div>
                                </div>
                                <div class="rounded-lg border border-teal-200/80 dark:border-teal-800/60 bg-teal-50/50 dark:bg-teal-950/20 p-3 text-[11px] text-teal-900 dark:text-teal-200">
                                    <p class="font-semibold mb-0.5">Supporting Documentation</p>
                                    <p class="text-slate-600 dark:text-slate-400">
                                        Agreement and payment receipts can be attached to the submitted request after creation before approval.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        }
        <!-- ======================================================== -->
        <!-- VIEW: REQUESTS (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        else if (tab == "Requests")
        {
            var filteredRequests = data.Requests
                .Where(x => (string.IsNullOrEmpty(status) || x.Status == status) &&
                            (string.IsNullOrEmpty(requestKind) || x.Kind == requestKind))
                .OrderByDescending(x => x.Id)
                .ToList();

            var currentSelected = filteredRequests.FirstOrDefault(x => x.Id == selectedRequestId)
                                  ?? filteredRequests.FirstOrDefault();

            <div class="sf-grid-5-7">

                <!-- Left Column: Filterable Requests List -->
                <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-[11px] font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Requests</h2>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@filteredRequests.Count</span>
                    </div>

                    <div class="p-3 space-y-3">
                        <!-- Filter Controls -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">Status</label>
                                <select @bind="status"
                                        class="w-full h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2 text-xs text-slate-800 dark:text-slate-200 focus:border-teal-600 focus:outline-none">
                                    <option value="">All Statuses</option>
                                    @foreach (var s in data.Requests.Select(x => x.Status).Distinct())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">Type</label>
                                <select @bind="requestKind"
                                        class="w-full h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2 text-xs text-slate-800 dark:text-slate-200 focus:border-teal-600 focus:outline-none">
                                    <option value="">All Types</option>
                                    @foreach (var k in data.Requests.Select(x => x.Kind).Distinct())
                                    {
                                        <option value="@k">@k</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Request List Cards -->
                        <div class="space-y-1.5 max-h-[600px] overflow-y-auto pr-0.5">
                            @foreach (var row in filteredRequests)
                            {
                                var isSelected = currentSelected?.Id == row.Id;
                                <button type="button"
                                        class="w-full text-left rounded-lg border p-2.5 text-xs transition-colors flex flex-col gap-1 @(isSelected ? "border-teal-500 bg-teal-50/70 dark:bg-teal-950/40 dark:border-teal-600" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/60")"
                                        @onclick="() => selectedRequestId = row.Id">
                                    <div class="flex items-center justify-between gap-1 flex-wrap w-full">
                                        <span class="font-mono text-[11px] font-bold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">
                                            @row.Reference
                                        </span>
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @StatusBadgeClass(row.Status)">
                                            @row.Status
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between text-slate-700 dark:text-slate-300 mt-0.5 w-full">
                                        <span class="font-semibold">@row.Kind</span>
                                        <span class="text-slate-500 dark:text-slate-400 text-[11px]">@row.Application.FromDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    @if (row.Kind != "Allowance")
                                    {
                                        <div class="text-slate-600 dark:text-slate-400 font-semibold text-[11px] tabular-nums">
                                            Amount: @row.Application.Amount.ToString("N2") @CurrencyName(row.Application.CurrencyTypeId)
                                        </div>
                                    }
                                    @if (StaffId == 0 && !string.IsNullOrEmpty(row.Staff))
                                    {
                                        <div class="text-[11px] text-slate-500">Employee: @row.Staff</div>
                                    }
                                </button>
                            }

                            @if (filteredRequests.Count == 0)
                            {
                                <div class="rounded-lg border border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 p-6 text-center text-xs text-slate-500">
                                    No requests found matching the current filters.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Column: Selected Request Inspector & Workflow Actions -->
                <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                    @if (currentSelected is not null)
                    {
                        var row = currentSelected;
                        <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="font-mono text-xs font-bold text-slate-900 dark:text-slate-100">@row.Reference</span>
                                <span class="text-slate-400">·</span>
                                <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">@row.Kind</span>
                            </div>
                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @StatusBadgeClass(row.Status)">
                                @row.Status
                            </span>
                        </div>

                        <div class="p-3.5 space-y-3.5">
                            <!-- Application Summary Details -->
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
                                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2.5">
                                    <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Effective Date</span>
                                    <span class="font-semibold text-slate-900 dark:text-slate-100">
                                        @row.Application.FromDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                                @if (row.Kind != "Allowance")
                                {
                                    <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2.5">
                                        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Application Amount</span>
                                        <span class="font-semibold text-slate-900 dark:text-slate-100 tabular-nums">
                                            @row.Application.Amount.ToString("N2") @CurrencyName(row.Application.CurrencyTypeId)
                                        </span>
                                    </div>
                                }
                                @if (row.Application.ToDate.HasValue)
                                {
                                    <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2.5">
                                        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">End Date</span>
                                        <span class="font-semibold text-slate-900 dark:text-slate-100">
                                            @row.Application.ToDate.Value.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(row.Application.Reason))
                            {
                                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-3 text-xs">
                                    <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 block mb-1">Reason / Notes</span>
                                    <p class="text-slate-600 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">@row.Application.Reason</p>
                                </div>
                            }

                            <!-- HR Assessment Section (For Allowance Requests) -->
                            @if (row.Kind == "Allowance")
                            {
                                <div class="rounded-lg border border-teal-200 dark:border-teal-800/60 bg-teal-50/40 dark:bg-teal-950/20 p-3 space-y-2">
                                    <h4 class="text-[11px] font-bold uppercase tracking-wider text-teal-900 dark:text-teal-300">HR Assessment</h4>
                                    @if (row.Assessments.Count == 0)
                                    {
                                        <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">Awaiting HR amount assessment.</p>
                                    }
                                    @foreach (var a in row.Assessments)
                                    {
                                        <p class="text-xs text-slate-700 dark:text-slate-300">
                                            <span class="font-semibold">@(a == row.Assessments[0] ? "Current assessment" : "Previous assessment"):</span>
                                            <span class="tabular-nums">@a.Amount.ToString("N2") @CurrencyName(a.CurrencyTypeId)</span>
                                            <span class="text-[11px] text-slate-400 ml-1">· @a.AssessedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm")</span>
                                        </p>
                                    }
                                    @if (AdminMode && row.CanAssess)
                                    {
                                        <div class="flex flex-wrap items-end gap-2 pt-2 border-t border-teal-200/70 dark:border-teal-800/40">
                                            <div>
                                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Assessed Amount</label>
                                                <InputNumber @bind-Value="assessmentAmounts[row.Id]" min="0.01" step="0.01"
                                                             class="h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                                            </div>
                                            <div>
                                                <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Currency</label>
                                                <select @bind="assessmentCurrencies[row.Id]"
                                                        class="h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none">
                                                    <option value="0">Select currency</option>
                                                    @foreach (var c in config.Currencies)
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <button type="button"
                                                    class="app-button app-button-primary app-button-sm"
                                                    disabled="@busy"
                                                    @onclick="() => Assess(row)">
                                                Save HR Assessment
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Supporting Documents / Attachments -->
                            <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-slate-800">
                                <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Attached Documents</span>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var d in data.Documents.Where(x => x.RequestId == row.Id))
                                    {
                                        <button type="button"
                                                class="app-button app-button-secondary app-button-sm"
                                                @onclick="() => Download(d.Id)">
                                            <AppIcon Name="download" Class="text-xs" />
                                            <span>@d.Name</span>
                                        </button>
                                    }
                                    @if (!data.Documents.Any(x => x.RequestId == row.Id))
                                    {
                                        <span class="text-xs text-slate-400">No attached files.</span>
                                    }
                                </div>
                                @if (row.CanCancel || data.CanManage && row.Status.StartsWith("Processing · ", StringComparison.Ordinal))
                                {
                                    <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5 mt-2">
                                        <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">Attach Evidence File (PDF, PNG, JPG)</label>
                                        <InputFile OnChange="e => Upload(row.Id, e)" accept=".pdf,.png,.jpg,.jpeg"
                                                   class="text-xs text-slate-600 dark:text-slate-400 file:mr-2 file:rounded-lg file:border file:border-slate-300 file:bg-white file:px-2.5 file:py-1 file:text-xs file:font-semibold file:text-slate-700 hover:file:bg-slate-50" />
                                    </div>
                                }
                            </div>

                            <!-- Workflow Actions & Approval Buttons -->
                            @if (row.CanApprove || row.CanCancel)
                            {
                                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 space-y-2.5">
                                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300">Action Comment</label>
                                    <textarea @bind="comments[row.Id]" maxlength="2000" rows="2"
                                              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none"
                                              placeholder="Optional approval or rejection notes…"></textarea>
                                    <div class="flex flex-wrap items-center gap-2">
                                        @if (row.CanApprove)
                                        {
                                            <button type="button"
                                                    class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50 transition-colors"
                                                    disabled="@busy"
                                                    @onclick='() => Act(row, "Approve")'>
                                                Approve Stage
                                            </button>
                                            <button type="button"
                                                    class="inline-flex items-center gap-1.5 rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 hover:bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 dark:text-rose-300 disabled:opacity-50 transition-colors"
                                                    disabled="@busy"
                                                    @onclick='() => Act(row, "Reject")'>
                                                Reject
                                            </button>
                                        }
                                        @if (row.CanCancel)
                                        {
                                            <button type="button"
                                                    class="app-button app-button-secondary app-button-sm"
                                                    disabled="@busy"
                                                    @onclick='() => Act(row, "Cancel")'>
                                                Cancel Request
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                            Select a request from the list to view its details and workflow actions.
                        </div>
                    }
                </div>

            </div>
        }
        <!-- ======================================================== -->
        <!-- VIEW: ALLOWANCES (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        else if (tab == "Allowances")
        {
            <div class="sf-grid-8-4">
                <!-- Left Column: Allowances Table -->
                <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-[11px] font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">
                            Active &amp; Recurring Allowances
                        </h2>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                            @data.Allowances.Count
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50/60 dark:bg-slate-800/40 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    @if (StaffId == 0)
                                    {
                                        <th class="px-3 py-2">Staff</th>
                                    }
                                    <th class="px-3 py-2">Allowance Type</th>
                                    <th class="px-3 py-2 text-right">Amount</th>
                                    <th class="px-3 py-2">Period</th>
                                    <th class="px-3 py-2">Source</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                @foreach (var a in data.Allowances)
                                {
                                    <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                        @if (StaffId == 0)
                                        {
                                            <td class="px-3 py-2 font-medium">@a.Staff</td>
                                        }
                                        <td class="px-3 py-2 font-semibold text-slate-900 dark:text-slate-100">@a.Type</td>
                                        <td class="px-3 py-2 text-right font-bold font-mono tabular-nums text-slate-900 dark:text-slate-100">
                                            @a.Amount.ToString("N2") @CurrencyName(a.CurrencyTypeId)
                                        </td>
                                        <td class="px-3 py-2 text-slate-600 dark:text-slate-400 whitespace-nowrap">
                                            @a.FromDate.ToString("dd MMM yyyy") – @(a.ToDate?.ToString("dd MMM yyyy") ?? "Ongoing")
                                        </td>
                                        <td class="px-3 py-2">
                                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-300">
                                                @a.Source
                                            </span>
                                        </td>
                                    </tr>
                                }
                                @if (data.Allowances.Count == 0)
                                {
                                    <tr>
                                        <td colspan="@(StaffId == 0 ? 5 : 4)" class="p-6 text-center text-slate-500">
                                            No active allowances configured.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Right Column: Summary Card & Quick Action -->
                <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Allowance Summary</h3>
                    </div>
                    <div class="p-3.5 space-y-3">
                        <div class="rounded-lg border border-teal-200 dark:border-teal-800/60 bg-teal-50/50 dark:bg-teal-950/20 p-3.5 space-y-1">
                            <span class="text-[11px] font-semibold text-teal-900 dark:text-teal-300">Monthly Entitlement</span>
                            <div class="text-2xl font-bold font-mono tabular-nums text-teal-800 dark:text-teal-200">
                                @data.Allowances.Sum(x => x.Amount).ToString("N2")
                            </div>
                            <p class="text-[11px] text-slate-600 dark:text-slate-400">
                                Based on active recurring allowances registered in the system.
                            </p>
                        </div>

                        <button type="button"
                                class="w-full app-button app-button-primary app-button-sm justify-center"
                                @onclick='() => { tab = "New request"; kind = "Allowance"; }'>
                            <AppIcon Name="add" Class="text-xs" />
                            <span>Request New Allowance</span>
                        </button>
                    </div>
                </div>
            </div>
        }
        <!-- ======================================================== -->
        <!-- VIEW: AGREEMENTS (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        else if (tab == "Agreements")
        {
            var selectedAgreement = data.Agreements.FirstOrDefault(x => x.Id == selectedAgreementId)
                                    ?? data.Agreements.FirstOrDefault();

            <div class="sf-grid-5-7">
                <!-- Left Column: Agreements List -->
                <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-[11px] font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Deduction Agreements</h2>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@data.Agreements.Count</span>
                    </div>

                    <div class="p-3 space-y-2 max-h-[600px] overflow-y-auto">
                        @foreach (var a in data.Agreements)
                        {
                            var isSel = selectedAgreement?.Id == a.Id;
                            <button type="button"
                                    class="w-full text-left rounded-lg border p-2.5 text-xs transition-colors flex flex-col gap-1 @(isSel ? "border-teal-500 bg-teal-50/70 dark:bg-teal-950/40 dark:border-teal-600" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/60")"
                                    @onclick="() => selectedAgreementId = a.Id">
                                <div class="flex items-center justify-between gap-1 flex-wrap w-full">
                                    <span class="font-mono text-xs font-bold text-slate-900 dark:text-slate-100">@a.Reference</span>
                                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-300">@a.Category</span>
                                </div>
                                <div class="flex items-center justify-between mt-0.5 w-full">
                                    <span class="text-slate-500 dark:text-slate-400 text-[11px]">Outstanding:</span>
                                    <span class="font-bold text-teal-800 dark:text-teal-300 font-mono tabular-nums">
                                        @a.Outstanding.ToString("N2") @CurrencyName(a.CurrencyTypeId)
                                    </span>
                                </div>
                                <div class="text-[11px] text-slate-500">@a.Instalments.Count instalments configured</div>
                                @if (StaffId == 0 && !string.IsNullOrEmpty(a.Staff))
                                {
                                    <div class="text-[11px] text-slate-500">Staff: @a.Staff</div>
                                }
                            </button>
                        }

                        @if (data.Agreements.Count == 0)
                        {
                            <div class="rounded-lg border border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 p-6 text-center text-xs text-slate-500">
                                No approved deduction agreements on record.
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Column: Selected Agreement Instalments Schedule -->
                <div class="min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                    @if (selectedAgreement is not null)
                    {
                        var a = selectedAgreement;
                        <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2">
                            <div class="min-w-0">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">@a.Reference</h3>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400">Category: @a.Category · Outstanding: <strong class="tabular-nums">@a.Outstanding.ToString("N2") @CurrencyName(a.CurrencyTypeId)</strong></p>
                            </div>
                            <span class="rounded-full border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 text-[10px] font-semibold">
                                Active Agreement
                            </span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50/60 dark:bg-slate-800/40 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
                                    <tr>
                                        <th class="px-3 py-2">Version</th>
                                        <th class="px-3 py-2">Due Date</th>
                                        <th class="px-3 py-2 text-right">Amount</th>
                                        <th class="px-3 py-2 text-right">Paid</th>
                                        <th class="px-3 py-2 text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                    @foreach (var i in a.Instalments)
                                    {
                                        <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="px-3 py-2 font-mono text-[11px]">v@(i.Version)</td>
                                            <td class="px-3 py-2 font-mono text-[11px]">@i.DueDate.ToString("dd MMM yyyy")</td>
                                            <td class="px-3 py-2 text-right font-semibold tabular-nums">@i.Amount.ToString("N2")</td>
                                            <td class="px-3 py-2 text-right font-semibold tabular-nums text-emerald-700 dark:text-emerald-400">@i.Paid.ToString("N2")</td>
                                            <td class="px-3 py-2 text-center">
                                                <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(i.Superseded ? "bg-slate-100 text-slate-600 border border-slate-200" : i.Paid == i.Amount ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-amber-50 text-amber-800 border border-amber-200")">
                                                    @(i.Superseded ? "Superseded" : i.Paid == i.Amount ? "Paid" : "Outstanding")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                            Select a deduction agreement from the left to view its repayment schedule.
                        </div>
                    }
                </div>
            </div>
        }
        <!-- ======================================================== -->
        <!-- VIEW: CONFIGURATION -->
        <!-- ======================================================== -->
        else if (tab == "Configuration")
        {
            <FinanceConfigurationPanel Config="config" OnSaved="Load" />
        }
        <!-- ======================================================== -->
        <!-- VIEW: PAYROLL / HISTORY -->
        <!-- ======================================================== -->
        else if (tab == "Payroll")
        {
            <FinancePayrollPanel StaffId="@(StaffId > 0 ? StaffId : null)" />
        }
        else if (tab == "History")
        {
            <FinancePayrollPanel StaffId="@(StaffId > 0 ? StaffId : null)" ReadOnly="true" />
        }
    }

</section>

<style>
    .sf-grid-7-5,
    .sf-grid-5-7,
    .sf-grid-8-4 {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
    }

    @@media (min-width: 1024px) {
        .sf-grid-7-5 {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        }

        .sf-grid-5-7 {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }

        .sf-grid-8-4 {
            grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
        }
    }
</style>

@code {
    [Parameter] public bool AdminMode { get; set; }
    [Parameter] public int StaffId { get; set; }
    [Parameter] public int? RequestId { get; set; }

    private FinanceWorkspace? data;
    private FinanceConfiguration? config;
    private string? error;
    private bool busy;

    private string tab = "Requests";
    private string kind = "Allowance";
    private string category = "Loan";
    private string reference = "";
    private string reason = "";
    private string status = "";
    private string requestKind = "";

    private int? selectedRequestId;
    private long? selectedAgreementId;

    private int jobId, currency, frequency = 1, count = 12, entityId;
    private long allowanceType, agreementId;
    private decimal amount;
    private DateTime from = DateTime.UtcNow.AddHours(5).Date;
    private DateTime? to;
    private string? selectedName;
    private Guid clientId = Guid.NewGuid();

    private Dictionary<int, string?> comments = new();
    private Dictionary<int, decimal> assessmentAmounts = new();
    private Dictionary<int, int> assessmentCurrencies = new();
    private List<FinanceInstalmentRow> schedule = new();

    private IEnumerable<string> Sections => new[] { "Requests", "New request", "Allowances", "Agreements", "History" }
        .Concat(AdminMode && config?.CanConfigure == true ? new[] { "Configuration" } : Array.Empty<string>())
        .Concat(AdminMode && data?.CanPost == true ? new[] { "Payroll" } : Array.Empty<string>());

    private string DateLabel => kind switch
    {
        "Agreement" => "First due date",
        "Payment" => "Payment date",
        "Defer" => "Instalment month to defer",
        "EndAllowance" => "Last entitlement date",
        _ => "Effective from"
    };

    protected override async Task OnInitializedAsync()
    {
        var actor = await Access.RequireContextAsync();
        if (StaffId > 0)
            jobId = (await Profiles.GetProfileAsync(StaffId))?.ActiveJob?.JobId ?? 0;
        else if (!AdminMode)
            jobId = actor.ActiveJob?.JobId ?? 0;

        if (RequestId.HasValue)
            selectedRequestId = RequestId.Value;

        await Load();
    }

    private void SelectTab(string newTab)
    {
        tab = newTab;
    }

    private string CurrencyName(int id) =>
        config?.Currencies.FirstOrDefault(x => x.Id == id)?.Name ?? "";

    private async Task Load()
    {
        busy = true;
        error = null;
        try
        {
            config = await Finance.GetConfigurationAsync();
            data = await Finance.LoadAsync(StaffId > 0 ? StaffId : null);
            foreach (var r in data.Requests)
            {
                comments.TryAdd(r.Id, null);
                assessmentAmounts[r.Id] = r.Assessments.FirstOrDefault()?.Amount ?? 0;
                assessmentCurrencies[r.Id] = r.Assessments.FirstOrDefault()?.CurrencyTypeId ?? 0;
            }

            if (selectedRequestId == null && data.Requests.Count > 0)
                selectedRequestId = data.Requests[0].Id;
            if (selectedAgreementId == null && data.Agreements.Count > 0)
                selectedAgreementId = data.Agreements[0].Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Finance workspace failed to load");
            error = "Finance information could not be loaded. Please contact HR if this continues.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectStaff(WorkspaceSearchResult item)
    {
        try
        {
            jobId = (await Profiles.GetProfileAsync(item.Id))?.ActiveJob?.JobId ?? 0;
            selectedName = item.Name;
            data = await Finance.LoadAsync(item.Id);
            foreach (var r in data.Requests)
            {
                comments.TryAdd(r.Id, null);
                assessmentAmounts[r.Id] = r.Assessments.FirstOrDefault()?.Amount ?? 0;
                assessmentCurrencies[r.Id] = r.Assessments.FirstOrDefault()?.CurrencyTypeId ?? 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Finance staff selection failed");
            error = "Staff finance information could not be loaded.";
        }
    }

    private FinanceApplication Input() => new()
    {
        ClientRequestId = clientId,
        Kind = kind,
        JobId = jobId,
        AllowanceTypeId = allowanceType,
        AgreementId = agreementId,
        BusinessEntityId = entityId,
        CurrencyTypeId = kind == "Allowance" ? 0 : currency,
        Amount = kind == "Allowance" ? 0 : amount,
        InstalmentCount = count,
        FrequencyMonths = frequency,
        FromDate = from,
        ToDate = to,
        Category = category,
        Reference = reference,
        Reason = reason
    };

    private async Task Run(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return;
        busy = true;
        error = null;
        bool saved = false;
        try
        {
            var result = await action();
            saved = result.Success;
            if (saved) Toasts.Success(result.Message);
            else error = result.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Finance action failed");
            error = "This action could not be completed. Please refresh or contact HR.";
        }
        finally
        {
            busy = false;
        }
        if (saved) await Load();
    }

    private async Task Submit()
    {
        await Run(() => Finance.SubmitAsync(Input()));
        if (error == null)
        {
            clientId = Guid.NewGuid();
            tab = "Requests";
        }
    }

    private async Task PreviewSchedule()
    {
        try
        {
            schedule = await Finance.PreviewAgreementAsync(Input());
            error = null;
        }
        catch (Exception)
        {
            error = "Enter a valid total, instalment count and repayment dates.";
        }
    }

    private Task Act(FinanceRequestRow row, string action) =>
        Run(() => Finance.ActAsync(row.Id, row.StateId, action, comments.GetValueOrDefault(row.Id)));

    private Task Assess(FinanceRequestRow row) =>
        Run(() => Finance.AssessAllowanceAsync(row.Id, row.StateId, assessmentAmounts[row.Id], assessmentCurrencies[row.Id]));

    private async Task Upload(int id, InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await Run(() => Finance.UploadDocumentAsync(new(id, e.File.Name, e.File.ContentType, memory.ToArray())));
        }
        catch (Exception)
        {
            error = "Choose a PDF, PNG or JPEG file up to 5 MB.";
        }
    }

    private async Task Download(long id)
    {
        try
        {
            var file = await Finance.DownloadDocumentAsync(id);
            using var stream = new MemoryStream(file.Content);
            using var reference = new DotNetStreamReference(stream);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            await module.InvokeVoidAsync("download", file.Name, file.ContentType, reference);
        }
        catch (Exception)
        {
            error = "This document could not be downloaded.";
        }
    }

    private static string StatusBadgeClass(string status)
    {
        if (status.StartsWith("Approved", StringComparison.OrdinalIgnoreCase))
            return "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
        if (status.StartsWith("Reject", StringComparison.OrdinalIgnoreCase) || status.StartsWith("Cancel", StringComparison.OrdinalIgnoreCase))
            return "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800";
        return "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800";
    }
}
