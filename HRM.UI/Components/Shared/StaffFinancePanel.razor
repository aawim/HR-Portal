@using HRM.Application.Contracts.Pages
@using HRM.DTOs
@using HRM.Components.Admin.My.Workspace
@using Microsoft.AspNetCore.Components.Forms
@inject IStaffFinance Finance
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject HRM.Services.Interfaces.Profile.IProfileService Profiles
@inject HRM.Services.ToastService Toasts
@inject IJSRuntime JS
@inject ILogger<StaffFinancePanel> Logger

<section class="space-y-4 staff-finance w-full min-w-0">

    <!-- Header Bar with Consistent Green Actions -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-wrap justify-between items-center gap-3">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">Allowances &amp; Deductions</h1>
                <span class="rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/50 px-2.5 py-0.5 text-xs font-semibold">
                    Finance
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Manage recurring employee allowances, deduction agreements, repayment schedules, and financial requests.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-emerald-300 dark:border-emerald-700 bg-emerald-50/80 dark:bg-emerald-950/40 px-3.5 py-1.5 text-xs font-semibold text-emerald-800 dark:text-emerald-200 shadow-xs hover:bg-emerald-100 dark:hover:bg-emerald-900/60 disabled:opacity-50 transition"
                    disabled="@busy"
                    @onclick="Load">
                <span>↻</span>
                <span>Refresh</span>
            </button>
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs disabled:opacity-50 transition"
                    disabled="@busy"
                    @onclick='() => tab = "New request"'>
                <span>+</span>
                <span>New Request</span>
            </button>
        </div>
    </div>

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 dark:border-rose-800 dark:bg-rose-950/50 dark:text-rose-200">
            <span>@error</span>
            <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 hover:text-rose-800 dark:text-rose-400 ml-2">✕</button>
        </div>
    }

    @if (busy)
    {
        <div class="flex items-center gap-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400 p-2">
            <span class="animate-spin inline-block">⏳</span>
            <span>Loading finance details...</span>
        </div>
    }

    @if (data != null && config != null)
    {
        <!-- Section Tabs Navigation (Folder/Pill Buttons with Green Accents) -->
        <nav class="flex flex-wrap items-center gap-1.5 border-b border-slate-200 dark:border-slate-800 pb-2" aria-label="Finance sections">
            @foreach (var item in Sections)
            {
                <button type="button"
                        class="@(tab == item
                            ? "inline-flex items-center justify-center gap-1.5 rounded-lg px-3.5 py-1.5 text-xs font-bold text-white bg-emerald-600 dark:bg-emerald-500 shadow-xs transition"
                            : "inline-flex items-center justify-center gap-1.5 rounded-lg px-3.5 py-1.5 text-xs font-semibold text-emerald-950 dark:text-slate-300 bg-emerald-50/70 hover:bg-emerald-100/90 dark:bg-slate-800 dark:hover:bg-slate-700 border border-emerald-200/80 dark:border-slate-700 transition")"
                        @onclick="() => SelectTab(item)">
                    @item
                    @if (item == "Requests" && data.Requests.Count > 0)
                    {
                        <span class="ml-1 rounded-full px-1.5 py-0.2 text-[10px] @(tab == item ? "bg-white/20 text-white" : "bg-emerald-200/80 text-emerald-900 dark:bg-slate-700 dark:text-slate-200")">
                            @data.Requests.Count
                        </span>
                    }
                    else if (item == "Allowances" && data.Allowances.Count > 0)
                    {
                        <span class="ml-1 rounded-full px-1.5 py-0.2 text-[10px] @(tab == item ? "bg-white/20 text-white" : "bg-emerald-200/80 text-emerald-900 dark:bg-slate-700 dark:text-slate-200")">
                            @data.Allowances.Count
                        </span>
                    }
                    else if (item == "Agreements" && data.Agreements.Count > 0)
                    {
                        <span class="ml-1 rounded-full px-1.5 py-0.2 text-[10px] @(tab == item ? "bg-white/20 text-white" : "bg-emerald-200/80 text-emerald-900 dark:bg-slate-700 dark:text-slate-200")">
                            @data.Agreements.Count
                        </span>
                    }
                </button>
            }
        </nav>

        <!-- ======================================================== -->
        <!-- VIEW: NEW REQUEST (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        @if (tab == "New request")
        {
            @if (AdminMode && StaffId == 0 && data.CanManage)
            {
                <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs mb-3">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Select Employee</label>
                    <WorkspaceSearch StaffOnly="true" RequireActivePosition="true" OnSelected="SelectStaff" />
                    @if (selectedName != null)
                    {
                        <p class="text-xs font-medium text-emerald-700 mt-1">Selected: @selectedName</p>
                    }
                </div>
            }

            @if (jobId <= 0)
            {
                <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                    Select a staff member with active employment to proceed with financial requests.
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

                    <!-- Left Column: New Request Form -->
                    <div class="lg:col-span-7 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
                        <div class="border-b border-slate-200 dark:border-slate-800 pb-2">
                            <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Create Financial Request</h2>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Submit an allowance, deduction agreement, or instalment modification.</p>
                        </div>

                        <fieldset disabled="@busy" class="space-y-3">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Request Type</label>
                                    <select @bind="kind"
                                            class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                        <option value="Allowance">Staff-requested allowance</option>
                                        <option value="Agreement">Deduction agreement</option>
                                        <option value="Defer">Defer an instalment</option>
                                        <option value="Payment">Payment by staff or another payer</option>
                                        <option value="EndAllowance">End an allowance</option>
                                    </select>
                                </div>

                                @if (kind == "Allowance")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Allowance Type</label>
                                        <select @bind="allowanceType"
                                                class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                            <option value="0">Select type</option>
                                            @foreach (var a in config.AllowanceTypes)
                                            {
                                                <option value="@a.Id">@a.Name</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (kind == "EndAllowance")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Select Allowance to End</label>
                                        <select @bind="allowanceType"
                                                class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                            <option value="0">Select allowance</option>
                                            @foreach (var a in data.Allowances.Where(x => x.JobId == jobId))
                                            {
                                                <option value="@a.Id">@a.Type · @a.Amount.ToString("N2")</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (kind is "Defer" or "Payment")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Agreement</label>
                                        <select @bind="agreementId"
                                                class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                            <option value="0">Select agreement</option>
                                            @foreach (var a in data.Agreements.Where(x => x.JobId == jobId && x.Outstanding > 0))
                                            {
                                                <option value="@a.Id">@a.Reference · @a.Outstanding.ToString("N2") outstanding</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (kind is "Agreement" or "Payment")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Amount</label>
                                        <InputNumber @bind-Value="amount" min="0.01" step="0.01"
                                                     class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Currency</label>
                                        <select @bind="currency"
                                                class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                            <option value="0">Select currency</option>
                                            @foreach (var c in config.Currencies)
                                            {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">@DateLabel</label>
                                    <InputDate @bind-Value="from"
                                               class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs" />
                                </div>

                                @if (kind == "Allowance")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">End Date (optional)</label>
                                        <InputDate @bind-Value="to"
                                                   class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs" />
                                    </div>
                                }

                                @if (kind is "Allowance" or "Agreement")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Frequency</label>
                                        <select @bind="frequency"
                                                class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                            <option value="1">Monthly</option>
                                            <option value="6">Every six months</option>
                                            <option value="12">Annually</option>
                                        </select>
                                    </div>
                                }

                                @if (kind == "Agreement")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Instalment Count</label>
                                        <InputNumber @bind-Value="count" min="1" max="120"
                                                     class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Category</label>
                                        <select @bind="category"
                                                class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs">
                                            <option>Loan</option>
                                            <option>Goods</option>
                                            <option>Insurance</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                }

                                @if (kind is "Agreement" or "Payment")
                                {
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                            @(kind == "Agreement" ? "Creditor / Registry ID" : "Payer Registry ID")
                                        </label>
                                        <InputNumber @bind-Value="entityId" min="1"
                                                     class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                            @(kind == "Agreement" ? "Agreement Reference" : "Receipt / Txn Reference")
                                        </label>
                                        <input @bind="reference" maxlength="200"
                                               class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs" />
                                    </div>
                                }
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Reason / Justification</label>
                                <textarea @bind="reason" rows="3" maxlength="2000"
                                          class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs"
                                          placeholder="Provide clear justification for this request..."></textarea>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-200 dark:border-slate-800">
                                @if (kind == "Agreement")
                                {
                                    <button type="button"
                                            class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-emerald-300 dark:border-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 px-3.5 py-2 text-xs font-semibold text-emerald-800 dark:text-emerald-200 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 shadow-xs transition"
                                            @onclick="PreviewSchedule">
                                        ⚡ Preview Repayments
                                    </button>
                                }
                                <button type="button"
                                        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-4 py-2 text-xs font-semibold text-white shadow-xs disabled:opacity-50 transition"
                                        @onclick="Submit">
                                    ✓ Submit for Approval
                                </button>
                            </div>
                        </fieldset>
                    </div>

                    <!-- Right Column: Repayment Preview & Financial Context -->
                    <div class="lg:col-span-5 min-w-0 space-y-4">
                        @if (schedule.Count > 0 && kind == "Agreement")
                        {
                            <div class="rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
                                <div class="flex items-center justify-between border-b border-emerald-100 dark:border-emerald-800/60 pb-2 mb-3">
                                    <h3 class="text-xs font-bold text-emerald-900 dark:text-emerald-300">Repayment Schedule Preview</h3>
                                    <span class="rounded-full bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 px-2 py-0.5 text-[10px] font-bold">
                                        @schedule.Count instalments
                                    </span>
                                </div>
                                <div class="max-h-72 overflow-y-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-emerald-50/80 dark:bg-slate-800 text-emerald-950 dark:text-slate-300 font-semibold border-b border-emerald-200 dark:border-slate-700">
                                            <tr>
                                                <th class="p-2">Due Date</th>
                                                <th class="p-2 text-right">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
                                            @foreach (var i in schedule)
                                            {
                                                <tr class="hover:bg-emerald-50/40 dark:hover:bg-slate-800/60">
                                                    <td class="p-2 font-mono">@i.DueDate.ToString("dd MMM yyyy")</td>
                                                    <td class="p-2 text-right font-semibold">@i.Amount.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        <!-- Financial Commitments Summary Card -->
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                            <h3 class="text-xs font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-800 pb-2">
                                Current Financial Commitments
                            </h3>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/60 p-2.5">
                                    <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Active Allowances</span>
                                    <span class="text-sm font-bold text-slate-800 dark:text-slate-100">
                                        @data.Allowances.Count(x => x.JobId == jobId)
                                    </span>
                                </div>
                                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/60 p-2.5">
                                    <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Active Agreements</span>
                                    <span class="text-sm font-bold text-slate-800 dark:text-slate-100">
                                        @data.Agreements.Count(x => x.JobId == jobId && x.Outstanding > 0)
                                    </span>
                                </div>
                            </div>
                            <div class="rounded-xl border border-emerald-200 dark:border-emerald-800/50 bg-emerald-50/50 dark:bg-emerald-950/20 p-3 text-[11px] text-emerald-900 dark:text-emerald-300">
                                <p class="font-semibold mb-1">💡 Supporting Documentation</p>
                                <p class="text-slate-600 dark:text-slate-400">
                                    Agreement and payment receipts can be attached to the submitted request after creation before approval.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            }
        }
        <!-- ======================================================== -->
        <!-- VIEW: REQUESTS (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        else if (tab == "Requests")
        {
            var filteredRequests = data.Requests
                .Where(x => (string.IsNullOrEmpty(status) || x.Status == status) &&
                            (string.IsNullOrEmpty(requestKind) || x.Kind == requestKind))
                .OrderByDescending(x => x.Id)
                .ToList();

            var currentSelected = filteredRequests.FirstOrDefault(x => x.Id == selectedRequestId)
                                  ?? filteredRequests.FirstOrDefault();

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

                <!-- Left Column: Filterable Requests List -->
                <div class="lg:col-span-5 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5">
                        <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                            Requests (@filteredRequests.Count)
                        </h2>
                    </div>

                    <!-- Filter Controls -->
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">Status</label>
                            <select @bind="status"
                                    class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-xs text-slate-800 dark:text-slate-200 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                                <option value="">All Statuses</option>
                                @foreach (var s in data.Requests.Select(x => x.Status).Distinct())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">Type</label>
                            <select @bind="requestKind"
                                    class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-xs text-slate-800 dark:text-slate-200 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                                <option value="">All Types</option>
                                @foreach (var k in data.Requests.Select(x => x.Kind).Distinct())
                                {
                                    <option value="@k">@k</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Request List Cards -->
                    <div class="space-y-2 max-h-[600px] overflow-y-auto pr-1">
                        @foreach (var row in filteredRequests)
                        {
                            var isSelected = currentSelected?.Id == row.Id;
                            <div class="rounded-xl border p-3 text-xs transition cursor-pointer flex flex-col gap-1.5 @(isSelected ? "border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/30 ring-1 ring-emerald-500 shadow-xs" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700")"
                                 @onclick="() => selectedRequestId = row.Id">
                                <div class="flex items-center justify-between gap-1 flex-wrap">
                                    <span class="font-mono text-[11px] font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 px-1.5 py-0.5 rounded">
                                        @row.Reference
                                    </span>
                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @StatusBadgeClass(row.Status)">
                                        @row.Status
                                    </span>
                                </div>
                                <div class="flex items-center justify-between text-slate-700 dark:text-slate-300 mt-1">
                                    <span class="font-semibold">@row.Kind</span>
                                    <span class="text-slate-500 dark:text-slate-400 text-[11px]">@row.Application.FromDate.ToString("dd MMM yyyy")</span>
                                </div>
                                @if (row.Kind != "Allowance")
                                {
                                    <div class="text-slate-600 dark:text-slate-400 font-semibold text-[11px]">
                                        Amount: @row.Application.Amount.ToString("N2") @CurrencyName(row.Application.CurrencyTypeId)
                                    </div>
                                }
                                @if (StaffId == 0 && !string.IsNullOrEmpty(row.Staff))
                                {
                                    <div class="text-[11px] text-slate-500">Employee: @row.Staff</div>
                                }
                            </div>
                        }

                        @if (filteredRequests.Count == 0)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-6 text-center text-xs text-slate-500">
                                No requests found matching the current filters.
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Column: Selected Request Inspector & Workflow Actions -->
                <div class="lg:col-span-7 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
                    @if (currentSelected is not null)
                    {
                        var row = currentSelected;
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-bold text-slate-900 dark:text-slate-100">@row.Reference</span>
                                <span class="text-slate-400">·</span>
                                <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">@row.Kind</span>
                            </div>
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold @StatusBadgeClass(row.Status)">
                                @row.Status
                            </span>
                        </div>

                        <!-- Application Summary Details -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
                            <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 p-2.5">
                                <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Effective Date</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200">
                                    @row.Application.FromDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            @if (row.Kind != "Allowance")
                            {
                                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 p-2.5">
                                    <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Application Amount</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200">
                                        @row.Application.Amount.ToString("N2") @CurrencyName(row.Application.CurrencyTypeId)
                                    </span>
                                </div>
                            }
                            @if (row.Application.ToDate.HasValue)
                            {
                                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 p-2.5">
                                    <span class="text-slate-500 dark:text-slate-400 block text-[11px]">End Date</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200">
                                        @row.Application.ToDate.Value.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(row.Application.Reason))
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 text-xs">
                                <span class="font-semibold text-slate-700 dark:text-slate-300 block mb-1">Reason / Notes</span>
                                <p class="text-slate-600 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">@row.Application.Reason</p>
                            </div>
                        }

                        <!-- HR Assessment Section (For Allowance Requests) -->
                        @if (row.Kind == "Allowance")
                        {
                            <div class="rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/40 dark:bg-emerald-950/20 p-3.5 space-y-2">
                                <h4 class="text-xs font-bold text-emerald-900 dark:text-emerald-300">HR Assessment</h4>
                                @if (row.Assessments.Count == 0)
                                {
                                    <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">⏳ Awaiting HR amount assessment.</p>
                                }
                                @foreach (var a in row.Assessments)
                                {
                                    <p class="text-xs text-slate-700 dark:text-slate-300">
                                        <span class="font-semibold">@(a == row.Assessments[0] ? "Current assessment" : "Previous assessment"):</span>
                                        @a.Amount.ToString("N2") @CurrencyName(a.CurrencyTypeId)
                                        <span class="text-[11px] text-slate-400 ml-1">· @a.AssessedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm")</span>
                                    </p>
                                }
                                @if (AdminMode && row.CanAssess)
                                {
                                    <div class="flex flex-wrap items-end gap-2 pt-2 border-t border-emerald-200 dark:border-emerald-800/40">
                                        <div>
                                            <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-0.5">Assessed Amount</label>
                                            <InputNumber @bind-Value="assessmentAmounts[row.Id]" min="0.01" step="0.01"
                                                         class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" />
                                        </div>
                                        <div>
                                            <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-0.5">Currency</label>
                                            <select @bind="assessmentCurrencies[row.Id]"
                                                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500">
                                                <option value="0">Select currency</option>
                                                @foreach (var c in config.Currencies)
                                                {
                                                    <option value="@c.Id">@c.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <button type="button"
                                                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white shadow-xs disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick="() => Assess(row)">
                                            Save HR Assessment
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Supporting Documents / Attachments -->
                        <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-slate-800">
                            <span class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Attached Documents</span>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var d in data.Documents.Where(x => x.RequestId == row.Id))
                                {
                                    <button type="button"
                                            class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 dark:border-emerald-700 bg-emerald-50/70 hover:bg-emerald-100 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-200 text-xs font-semibold px-2.5 py-1 shadow-2xs transition"
                                            @onclick="() => Download(d.Id)">
                                        📎 @d.Name
                                    </button>
                                }
                                @if (!data.Documents.Any(x => x.RequestId == row.Id))
                                {
                                    <span class="text-xs text-slate-400">No attached files.</span>
                                }
                            </div>
                            @if (row.CanCancel || data.CanManage && row.Status.StartsWith("Processing · ", StringComparison.Ordinal))
                            {
                                <div class="pt-2">
                                    <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">Attach Evidence File (PDF, PNG, JPG)</label>
                                    <InputFile OnChange="e => Upload(row.Id, e)" accept=".pdf,.png,.jpg,.jpeg"
                                               class="text-xs text-slate-600 dark:text-slate-400 file:mr-2 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-3 file:py-1 file:text-xs file:font-semibold file:text-emerald-700 hover:file:bg-emerald-100" />
                                </div>
                            }
                        </div>

                        <!-- Workflow Actions & Approval Buttons -->
                        @if (row.CanApprove || row.CanCancel)
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 p-3 space-y-2.5">
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Action Comment</label>
                                <textarea @bind="comments[row.Id]" maxlength="2000" rows="2"
                                          class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-2xs"
                                          placeholder="Optional approval or rejection notes..."></textarea>
                                <div class="flex flex-wrap items-center gap-2">
                                    @if (row.CanApprove)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick='() => Act(row, "Approve")'>
                                            ✓ Approve Stage
                                        </button>
                                        <button type="button"
                                                class="inline-flex items-center gap-1.5 rounded-lg border border-rose-300 bg-white hover:bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 shadow-xs disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick='() => Act(row, "Reject")'>
                                            ✕ Reject
                                        </button>
                                    }
                                    @if (row.CanCancel)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick='() => Act(row, "Cancel")'>
                                            Cancel Request
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-8 text-center text-xs text-slate-500">
                            Select a request from the list to view its details and workflow actions.
                        </div>
                    }
                </div>

            </div>
        }
        <!-- ======================================================== -->
        <!-- VIEW: ALLOWANCES (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        else if (tab == "Allowances")
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                <!-- Left Column: Allowances Table -->
                <div class="lg:col-span-8 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5">
                        <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                            Active &amp; Recurring Allowances (@data.Allowances.Count)
                        </h2>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                <tr>
                                    @if (StaffId == 0)
                                    {
                                        <th class="p-2.5">Staff</th>
                                    }
                                    <th class="p-2.5">Allowance Type</th>
                                    <th class="p-2.5">Amount</th>
                                    <th class="p-2.5">Period</th>
                                    <th class="p-2.5">Source</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
                                @foreach (var a in data.Allowances)
                                {
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                                        @if (StaffId == 0)
                                        {
                                            <td class="p-2.5 font-medium">@a.Staff</td>
                                        }
                                        <td class="p-2.5 font-semibold text-emerald-800 dark:text-emerald-300">@a.Type</td>
                                        <td class="p-2.5 font-bold font-mono">
                                            @a.Amount.ToString("N2") @CurrencyName(a.CurrencyTypeId)
                                        </td>
                                        <td class="p-2.5 text-slate-600 dark:text-slate-400">
                                            @a.FromDate.ToString("dd MMM yyyy") – @(a.ToDate?.ToString("dd MMM yyyy") ?? "Ongoing")
                                        </td>
                                        <td class="p-2.5">
                                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-300">
                                                @a.Source
                                            </span>
                                        </td>
                                    </tr>
                                }
                                @if (data.Allowances.Count == 0)
                                {
                                    <tr>
                                        <td colspan="@(StaffId == 0 ? 5 : 4)" class="p-6 text-center text-slate-500">
                                            No active allowances configured.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Right Column: Summary Card & Quick Action -->
                <div class="lg:col-span-4 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
                    <h3 class="text-xs font-bold text-slate-800 dark:text-slate-200 border-b border-slate-100 dark:border-slate-800 pb-2">
                        Allowance Summary
                    </h3>
                    <div class="rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/50 dark:bg-emerald-950/20 p-4 space-y-2">
                        <span class="text-xs font-semibold text-emerald-900 dark:text-emerald-300">Monthly Entitlement</span>
                        <div class="text-2xl font-bold font-mono text-emerald-800 dark:text-emerald-200">
                            @data.Allowances.Sum(x => x.Amount).ToString("N2")
                        </div>
                        <p class="text-[11px] text-emerald-700 dark:text-emerald-400">
                            Based on active recurring allowances registered in the system.
                        </p>
                    </div>

                    <button type="button"
                            class="w-full inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3.5 py-2 text-xs font-semibold text-white shadow-xs transition"
                            @onclick='() => { tab = "New request"; kind = "Allowance"; }'>
                        + Request New Allowance
                    </button>
                </div>
            </div>
        }
        <!-- ======================================================== -->
        <!-- VIEW: AGREEMENTS (Two-Column Grid Layout) -->
        <!-- ======================================================== -->
        else if (tab == "Agreements")
        {
            var selectedAgreement = data.Agreements.FirstOrDefault(x => x.Id == selectedAgreementId)
                                    ?? data.Agreements.FirstOrDefault();

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                <!-- Left Column: Agreements List -->
                <div class="lg:col-span-5 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5">
                        <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                            Deduction Agreements (@data.Agreements.Count)
                        </h2>
                    </div>

                    <div class="space-y-2.5 max-h-[600px] overflow-y-auto pr-1">
                        @foreach (var a in data.Agreements)
                        {
                            var isSel = selectedAgreement?.Id == a.Id;
                            <div class="rounded-xl border p-3 text-xs transition cursor-pointer flex flex-col gap-1.5 @(isSel ? "border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/30 ring-1 ring-emerald-500 shadow-xs" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700")"
                                 @onclick="() => selectedAgreementId = a.Id">
                                <div class="flex items-center justify-between gap-1 flex-wrap">
                                    <span class="font-mono text-xs font-bold text-slate-900 dark:text-slate-100">
                                        @a.Reference
                                    </span>
                                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-300">
                                        @a.Category
                                    </span>
                                </div>
                                <div class="flex items-center justify-between mt-1">
                                    <span class="text-slate-500 dark:text-slate-400 text-[11px]">Outstanding:</span>
                                    <span class="font-bold text-emerald-800 dark:text-emerald-300 font-mono">
                                        @a.Outstanding.ToString("N2") @CurrencyName(a.CurrencyTypeId)
                                    </span>
                                </div>
                                <div class="text-[11px] text-slate-500">
                                    @a.Instalments.Count instalments configured
                                </div>
                                @if (StaffId == 0 && !string.IsNullOrEmpty(a.Staff))
                                {
                                    <div class="text-[11px] text-slate-500">Staff: @a.Staff</div>
                                }
                            </div>
                        }

                        @if (data.Agreements.Count == 0)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center text-xs text-slate-500">
                                No approved deduction agreements on record.
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Column: Selected Agreement Instalments Schedule -->
                <div class="lg:col-span-7 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
                    @if (selectedAgreement is not null)
                    {
                        var a = selectedAgreement;
                        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@a.Reference</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Category: @a.Category · Outstanding: @a.Outstanding.ToString("N2") @CurrencyName(a.CurrencyTypeId)</p>
                            </div>
                            <span class="rounded-full bg-emerald-100 text-emerald-800 px-2.5 py-0.5 text-xs font-semibold">
                                Active Agreement
                            </span>
                        </div>

                        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                    <tr>
                                        <th class="p-2.5">Version</th>
                                        <th class="p-2.5">Due Date</th>
                                        <th class="p-2.5 text-right">Amount</th>
                                        <th class="p-2.5 text-right">Paid</th>
                                        <th class="p-2.5 text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
                                    @foreach (var i in a.Instalments)
                                    {
                                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                                            <td class="p-2.5 font-mono">v@(i.Version)</td>
                                            <td class="p-2.5 font-mono">@i.DueDate.ToString("dd MMM yyyy")</td>
                                            <td class="p-2.5 text-right font-semibold">@i.Amount.ToString("N2")</td>
                                            <td class="p-2.5 text-right font-semibold text-emerald-700 dark:text-emerald-400">@i.Paid.ToString("N2")</td>
                                            <td class="p-2.5 text-center">
                                                <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(i.Superseded ? "bg-slate-100 text-slate-600" : i.Paid == i.Amount ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                                    @(i.Superseded ? "Superseded" : i.Paid == i.Amount ? "Paid" : "Outstanding")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-8 text-center text-xs text-slate-500">
                            Select a deduction agreement from the left to view its repayment schedule.
                        </div>
                    }
                </div>
            </div>
        }
        <!-- ======================================================== -->
        <!-- VIEW: CONFIGURATION -->
        <!-- ======================================================== -->
        else if (tab == "Configuration")
        {
            <FinanceConfigurationPanel Config="config" OnSaved="Load" />
        }
        <!-- ======================================================== -->
        <!-- VIEW: PAYROLL / HISTORY -->
        <!-- ======================================================== -->
        else if (tab == "Payroll")
        {
            <FinancePayrollPanel StaffId="@(StaffId > 0 ? StaffId : null)" />
        }
        else if (tab == "History")
        {
            <FinancePayrollPanel StaffId="@(StaffId > 0 ? StaffId : null)" ReadOnly="true" />
        }
    }

</section>

@code {
    [Parameter] public bool AdminMode { get; set; }
    [Parameter] public int StaffId { get; set; }
    [Parameter] public int? RequestId { get; set; }

    private FinanceWorkspace? data;
    private FinanceConfiguration? config;
    private string? error;
    private bool busy;

    private string tab = "Requests";
    private string kind = "Allowance";
    private string category = "Loan";
    private string reference = "";
    private string reason = "";
    private string status = "";
    private string requestKind = "";

    private int? selectedRequestId;
    private long? selectedAgreementId;

    private int jobId, currency, frequency = 1, count = 12, entityId;
    private long allowanceType, agreementId;
    private decimal amount;
    private DateTime from = DateTime.UtcNow.AddHours(5).Date;
    private DateTime? to;
    private string? selectedName;
    private Guid clientId = Guid.NewGuid();

    private Dictionary<int, string?> comments = new();
    private Dictionary<int, decimal> assessmentAmounts = new();
    private Dictionary<int, int> assessmentCurrencies = new();
    private List<FinanceInstalmentRow> schedule = new();

    private IEnumerable<string> Sections => new[] { "Requests", "New request", "Allowances", "Agreements", "History" }
        .Concat(AdminMode && config?.CanConfigure == true ? new[] { "Configuration" } : Array.Empty<string>())
        .Concat(AdminMode && data?.CanPost == true ? new[] { "Payroll" } : Array.Empty<string>());

    private string DateLabel => kind switch
    {
        "Agreement" => "First due date",
        "Payment" => "Payment date",
        "Defer" => "Instalment month to defer",
        "EndAllowance" => "Last entitlement date",
        _ => "Effective from"
    };

    protected override async Task OnInitializedAsync()
    {
        var actor = await Access.RequireContextAsync();
        if (StaffId > 0)
            jobId = (await Profiles.GetProfileAsync(StaffId))?.ActiveJob?.JobId ?? 0;
        else if (!AdminMode)
            jobId = actor.ActiveJob?.JobId ?? 0;

        if (RequestId.HasValue)
            selectedRequestId = RequestId.Value;

        await Load();
    }

    private void SelectTab(string newTab)
    {
        tab = newTab;
    }

    private string CurrencyName(int id) =>
        config?.Currencies.FirstOrDefault(x => x.Id == id)?.Name ?? "";

    private async Task Load()
    {
        busy = true;
        error = null;
        try
        {
            config = await Finance.GetConfigurationAsync();
            data = await Finance.LoadAsync(StaffId > 0 ? StaffId : null);
            foreach (var r in data.Requests)
            {
                comments.TryAdd(r.Id, null);
                assessmentAmounts[r.Id] = r.Assessments.FirstOrDefault()?.Amount ?? 0;
                assessmentCurrencies[r.Id] = r.Assessments.FirstOrDefault()?.CurrencyTypeId ?? 0;
            }

            if (selectedRequestId == null && data.Requests.Count > 0)
                selectedRequestId = data.Requests[0].Id;
            if (selectedAgreementId == null && data.Agreements.Count > 0)
                selectedAgreementId = data.Agreements[0].Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Finance workspace failed to load");
            error = "Finance information could not be loaded. Please contact HR if this continues.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectStaff(WorkspaceSearchResult item)
    {
        try
        {
            jobId = (await Profiles.GetProfileAsync(item.Id))?.ActiveJob?.JobId ?? 0;
            selectedName = item.Name;
            data = await Finance.LoadAsync(item.Id);
            foreach (var r in data.Requests)
            {
                comments.TryAdd(r.Id, null);
                assessmentAmounts[r.Id] = r.Assessments.FirstOrDefault()?.Amount ?? 0;
                assessmentCurrencies[r.Id] = r.Assessments.FirstOrDefault()?.CurrencyTypeId ?? 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Finance staff selection failed");
            error = "Staff finance information could not be loaded.";
        }
    }

    private FinanceApplication Input() => new()
    {
        ClientRequestId = clientId,
        Kind = kind,
        JobId = jobId,
        AllowanceTypeId = allowanceType,
        AgreementId = agreementId,
        BusinessEntityId = entityId,
        CurrencyTypeId = kind == "Allowance" ? 0 : currency,
        Amount = kind == "Allowance" ? 0 : amount,
        InstalmentCount = count,
        FrequencyMonths = frequency,
        FromDate = from,
        ToDate = to,
        Category = category,
        Reference = reference,
        Reason = reason
    };

    private async Task Run(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return;
        busy = true;
        error = null;
        bool saved = false;
        try
        {
            var result = await action();
            saved = result.Success;
            if (saved) Toasts.Success(result.Message);
            else error = result.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Finance action failed");
            error = "This action could not be completed. Please refresh or contact HR.";
        }
        finally
        {
            busy = false;
        }
        if (saved) await Load();
    }

    private async Task Submit()
    {
        await Run(() => Finance.SubmitAsync(Input()));
        if (error == null)
        {
            clientId = Guid.NewGuid();
            tab = "Requests";
        }
    }

    private async Task PreviewSchedule()
    {
        try
        {
            schedule = await Finance.PreviewAgreementAsync(Input());
            error = null;
        }
        catch (Exception)
        {
            error = "Enter a valid total, instalment count and repayment dates.";
        }
    }

    private Task Act(FinanceRequestRow row, string action) =>
        Run(() => Finance.ActAsync(row.Id, row.StateId, action, comments.GetValueOrDefault(row.Id)));

    private Task Assess(FinanceRequestRow row) =>
        Run(() => Finance.AssessAllowanceAsync(row.Id, row.StateId, assessmentAmounts[row.Id], assessmentCurrencies[row.Id]));

    private async Task Upload(int id, InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await Run(() => Finance.UploadDocumentAsync(new(id, e.File.Name, e.File.ContentType, memory.ToArray())));
        }
        catch (Exception)
        {
            error = "Choose a PDF, PNG or JPEG file up to 5 MB.";
        }
    }

    private async Task Download(long id)
    {
        try
        {
            var file = await Finance.DownloadDocumentAsync(id);
            using var stream = new MemoryStream(file.Content);
            using var reference = new DotNetStreamReference(stream);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            await module.InvokeVoidAsync("download", file.Name, file.ContentType, reference);
        }
        catch (Exception)
        {
            error = "This document could not be downloaded.";
        }
    }

    private static string StatusBadgeClass(string status)
    {
        if (status.StartsWith("Approved", StringComparison.OrdinalIgnoreCase))
            return "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
        if (status.StartsWith("Reject", StringComparison.OrdinalIgnoreCase) || status.StartsWith("Cancel", StringComparison.OrdinalIgnoreCase))
            return "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800";
        return "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800";
    }
}
