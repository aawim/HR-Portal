<div class="cep-root">
    <button type="button"
            class="cep-trigger @(open ? "cep-trigger-active" : null) @(Compact ? "cep-trigger-compact" : null)"
            disabled="@Disabled"
            title="Insert emoji"
            aria-label="Insert emoji"
            aria-expanded="@open.ToString().ToLowerInvariant()"
            @onclick="Toggle">
        <AppIcon Name="bi-emoji-smile" Class="@(Compact ? "text-xs" : "text-sm")" />
    </button>

    @if (open)
    {
        <div class="cep-backdrop" @onclick="Close" aria-hidden="true"></div>
        <div class="cep-popover @(AlignRight ? "cep-popover-right" : "cep-popover-left") @(Compact ? "cep-popover-compact" : null)"
             role="dialog"
             aria-label="Emoji picker">
            <div class="cep-header">
                <div class="cep-tabs" role="tablist">
                    @foreach (var cat in Categories)
                    {
                        var key = cat.Key;
                        <button type="button"
                                role="tab"
                                aria-selected="@(activeCategory == key ? "true" : "false")"
                                title="@cat.Label"
                                class="cep-tab @(activeCategory == key ? "cep-tab-active" : null)"
                                @onclick="() => activeCategory = key">
                            <span>@cat.Icon</span>
                        </button>
                    }
                </div>
                <button type="button" class="cep-close" aria-label="Close emoji picker" @onclick="Close">
                    <AppIcon Name="close" Class="text-[11px]" />
                </button>
            </div>

            <div class="cep-category-title">@ActiveCategoryRecord.Label</div>

            <div class="cep-grid">
                @foreach (var emoji in ActiveCategoryRecord.Emojis)
                {
                    var selectedEmoji = emoji;
                    <button type="button"
                            class="cep-emoji-btn"
                            title="@selectedEmoji"
                            @onclick="() => SelectEmojiAsync(selectedEmoji)">
                        @selectedEmoji
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnEmojiSelected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AlignRight { get; set; }
    [Parameter] public bool Compact { get; set; }

    private bool open;
    private string activeCategory = "smileys";

    private sealed record EmojiCategory(string Key, string Label, string Icon, string[] Emojis);

    private static readonly EmojiCategory[] Categories =
    [
        new("smileys", "Smileys & Expressions", "😊", [
            "😀", "😃", "😄", "😁", "😅", "😂", "🤣",
            "🙂", "😉", "😊", "😇", "🥰", "😍", "🤩",
            "😘", "😋", "😎", "🤓", "🤔", "🤨", "😐",
            "😮", "😲", "🥺", "😢", "😭", "😤", "🥳"
        ]),
        new("gestures", "Reactions & Hearts", "👍", [
            "👍", "👎", "👏", "🙌", "🤝", "🙏", "👌",
            "✌️", "🤞", "💪", "👋", "🫡", "🫶", "❤️",
            "🧡", "💛", "💚", "💙", "💜", "🤍", "✨",
            "🔥", "💯", "⭐"
        ]),
        new("work", "Work & Support", "💼", [
            "✅", "❌", "⚠️", "ℹ️", "📌", "📎", "📄",
            "📋", "📅", "🗓️", "⏰", "💼", "📊", "💻",
            "📧", "📞", "🔔", "💡", "🔍", "🛠️", "🤖",
            "🎧", "🎉", "🚀"
        ])
    ];

    private EmojiCategory ActiveCategoryRecord =>
        Categories.FirstOrDefault(c => c.Key == activeCategory) ?? Categories[0];

    private void Toggle()
    {
        if (Disabled) return;
        open = !open;
    }

    private void Close() => open = false;

    private async Task SelectEmojiAsync(string emoji)
    {
        await OnEmojiSelected.InvokeAsync(emoji);
    }
}
