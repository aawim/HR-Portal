@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Services
@using HRM.Components.Shared
@using HRM.Services.Interfaces


@inject NavigationManager Navigation
@inject IUserAccessService UserAccess



@if (MobileOpen)
{
     <button type="button" class="sidebar-backdrop md:hidden" aria-label="Close navigation menu" @onclick="CloseMobileAsync"></button>
}
<aside id="portal-sidebar" class="app-sidebar @(collapsed ? "is-collapsed" : null) @(MobileOpen ? "is-mobile-open" : null) text-slate-300 flex-col shadow-xl">
    <!-- Logo Area (Always Visible) -->
    <div class="sidebar-header h-16 flex items-center border-b border-slate-700">
        <div class="flex min-w-0 flex-1 items-center gap-2 text-white font-bold text-xl">
            <svg class="w-8 h-8 text-blue-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
            @if (!collapsed)
            {
                <span class="whitespace-nowrap">GHR Platform</span>
            }
        </div>
        <button type="button" class="sidebar-collapse" @onclick="HandleNavigationButton" aria-label="@(MobileOpen ? "Close navigation" : collapsed ? "Expand navigation" : "Collapse navigation")" title="@(MobileOpen ? "Close navigation" : collapsed ? "Expand navigation" : "Collapse navigation")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="@(collapsed ? "m9 18 6-6-6-6" : "m15 18-6-6 6-6")" /></svg>
        </button>
    </div>

    <AuthorizeView>
        <Authorized>
            @if (HasSystemAccess)
            {
                <!-- Active Navigation Links -->
                <nav class="flex-1 overflow-y-auto py-4">
                    <ul class="space-y-1 px-3">
                        @if (IsDeveloperPortal && (CanAccessDeveloperPortal || isDeveloper))
                        {
                            <!-- Developer Menu -->
                            <NavItem Compact="collapsed" Href="/developer" Icon="code" Text="Workspace" IsActive="true" />
                            <NavItem Compact="collapsed" Href="/developer/overview" Icon="home" Text="Overview" />
                            <NavItem Compact="collapsed" Href="/developer/request-types" Icon="document" Text="Request Types" />
                            <NavItem Compact="collapsed" Href="/developer/transitions" Icon="trending-up" Text="Transitions" />
                            <NavItem Compact="collapsed" Href="/developer/workflows" Icon="briefcase" Text="Workflows" />
                            <NavItem Compact="collapsed" Href="/developer/health" Icon="trending-up" Text="Health" />
                            <NavItem Compact="collapsed" Href="/developer/diagnostics" Icon="cog" Text="Diagnostics" />
                            <hr class="my-2 border-white/15" />
                            <NavItem Compact="collapsed" Href="/online" Icon="users" Text="Employee Portal" />
                            @if (CanAccessAdminPortal)
                            {
                                <NavItem Compact="collapsed" Href="/admin" Icon="briefcase" Text="Admin Portal" />
                            }
                        }
                        else if (IsAdminPortal && CanAccessAdminPortal)
                        {
                            <!-- Admin Menu-->

                            <NavItem Compact="collapsed" Href="/admin/my/workspace" Icon="briefcase" Text="Home" IsActive="true" />
                            <NavItem Compact="collapsed" Href="/admin" Icon="home" Text="Dashboard" />
                            <NavItem Compact="collapsed" Href="admin/hr" Icon="users" Text="HR" />
                            <NavItem Compact="collapsed" Href="admin/settings" Icon="cog" Text="Settings" />
                            <NavItem Compact="collapsed" Href="/admin/goods-loans" Icon="currency-dollar" Text="Goods Loans" />
                            <hr class="my-2 border-white/15" />
                            <NavItem Compact="collapsed" Href="admin/recruitment" Icon="user-plus" Text="Recruitment" />
                            @if (isDeveloper)
                            {
                                <NavItem Compact="collapsed" Href="/developer" Icon="code" Text="Developer" />
                            }
                        }
                        else
                        {
                            <!-- User Menu-->
                            <NavItem Compact="collapsed" Href="/online" Icon="home" Text="Home" IsActive="true" />

                            <NavItem Compact="collapsed" Href="/online/attendance" Icon="clock" Text="Attendance" />
                            <NavItem Compact="collapsed" Href="/online/duty-roster" Icon="calendar" Text="Duty roster" />

                            <NavItem Compact="collapsed" Href="/online/break-time-request" Icon="currency-dollar" Text="Break Time Request" />

                            <NavItem Compact="collapsed" Href="/online/ot" Icon="trending-up" Text="Overtime" />
                            <NavItem Compact="collapsed" Href="/online/item-requests" Icon="briefcase" Text="Item requests" />
                            <NavItem Compact="collapsed" Href="/online/goods-loans" Icon="currency-dollar" Text="Goods Loans" />
                            <NavItem Compact="collapsed" Href="/online/my-assets" Icon="briefcase" Text="My assets" />
                            <NavItem Compact="collapsed" Href="/online/staff-transfers" Icon="briefcase" Text="Staff transfers" />
                            <NavItem Compact="collapsed" Href="/online/certificates" Icon="document" Text="Certificates" />
                            <NavItem Compact="collapsed" Href="/online/documents" Icon="document" Text="Documents" />

                            <NavItem Compact="collapsed" Href="/online/leaves" Icon="calendar" Text="Leaves" />
                            <NavItem Compact="collapsed" Href="/online/leave-handovers" Icon="briefcase" Text="Work handovers" />
                            <NavItem Compact="collapsed" Href="/online/chat" Icon="chat" Text="Chat" />
                            @if (isDeveloper && !CanAccessAdminPortal)
                            {
                                <hr class="my-2 border-white/15" />
                                <NavItem Compact="collapsed" Href="/developer" Icon="code" Text="Developer Portal" />
                            }
                        }
                    </ul>
                </nav>


                <PortalSwitcher CanAccessAdminPortal="CanAccessAdminPortal" CanAccessDeveloperPortal="CanAccessDeveloperPortal || isDeveloper" @rendermode="RenderMode.InteractiveServer" />
            }
            else
            {
                @DisabledEmployeeMenu
            }


            <div class="sidebar-bottom mt-auto p-2 border-t border-slate-800">
                <LogoutButton Class="sidebar-logout flex items-center gap-3 text-slate-300 hover:text-white transition-colors w-full px-3 py-2 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    @if (!collapsed)
                    {
                        <span>Logout</span>
                    }
                </LogoutButton>
            </div>
        </Authorized>

        <NotAuthorized>
            <!-- Disabled Navigation State -->
            @DisabledEmployeeMenu

            <!-- Locked Indicator instead of Logout -->
            <div class="sidebar-bottom mt-auto p-4 border-t border-slate-800">
                <div class="flex items-center gap-3 text-slate-500 px-3 py-2 text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2-2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    @if (!collapsed)
                    {
                        <span>Login required</span>
                    }
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</aside>
@code {
    [Parameter] public bool HasSystemAccess { get; set; }
    [Parameter] public bool CanAccessAdminPortal { get; set; }
    [Parameter] public bool CanAccessDeveloperPortal { get; set; }
    [Parameter] public bool CanAccessAuditPortal { get; set; }
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback OnMobileClose { get; set; }
    private bool collapsed;
    private bool isDeveloper;

    protected override async Task OnParametersSetAsync()
    {
        if (MobileOpen) collapsed = false;
        try
        {
            isDeveloper = CanAccessDeveloperPortal || (HasSystemAccess && (await UserAccess.HasUserGroupAsync("Developer") || await UserAccess.HasPermissionAsync("Developer")));
        }
        catch
        {
            isDeveloper = CanAccessDeveloperPortal;
        }
    }

    private void ToggleCollapsed() => collapsed = !collapsed;
    private Task CloseMobileAsync() => OnMobileClose.InvokeAsync();
    private async Task HandleNavigationButton()
    {
        if (MobileOpen) await CloseMobileAsync();
        else ToggleCollapsed();
    }
    private RenderFragment DisabledEmployeeMenu => @<nav aria-label="Employee navigation" class="flex-1 overflow-y-auto py-4 opacity-50">
        <ul class="space-y-1 px-3">
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="home" Text="Home" />
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="clock" Text="Attendance" />
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="calendar" Text="Duty roster" />
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="currency-dollar" Text="Break Time Request" />
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="trending-up" Text="Overtime" />
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="calendar" Text="Leaves" />
            <NavItem Compact="collapsed" Href="" Disabled="true" Icon="briefcase" Text="Work handovers" />
        </ul>
    </nav>;


    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool IsDeveloperPortal =>
        new Uri(Navigation.Uri).AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries).Any(s => s.Equals("developer", StringComparison.OrdinalIgnoreCase));

    private bool IsAdminPortal =>
        !IsDeveloperPortal && new Uri(Navigation.Uri).AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true;

}