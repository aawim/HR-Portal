@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using HRM.Services
@using HRM.Components.Shared
@using HRM.Services.Interfaces
@implements IDisposable

@inject NavigationManager Navigation
@inject IUserAccessService UserAccess
@inject HRM.Services.Contracts.LeadershipAuthorityServiceContracts.IOperations LeadershipAccess



@if (MobileOpen)
{
     <button type="button" class="sidebar-backdrop md:hidden" aria-label="Close navigation menu" @onclick="CloseMobileAsync"></button>
}
<aside id="portal-sidebar" class="app-sidebar @(collapsed ? "is-collapsed" : null) @(MobileOpen ? "is-mobile-open" : null) text-slate-300 flex-col shadow-xl">
    <!-- Logo Area (Always Visible) -->
    <div class="sidebar-header h-16 flex items-center border-b border-slate-700">
        <div class="flex min-w-0 flex-1 items-center gap-2 text-white font-bold text-xl">
            <AppIcon Name="layers" Class="w-8 h-8 text-3xl text-blue-500" />
            @if (!collapsed)
            {
                <span class="whitespace-nowrap">GHR Platform</span>
            }
        </div>
        <button type="button" class="sidebar-collapse" @onclick="HandleNavigationButton" aria-label="@(MobileOpen ? "Close navigation" : collapsed ? "Expand navigation" : "Collapse navigation")" title="@(MobileOpen ? "Close navigation" : collapsed ? "Expand navigation" : "Collapse navigation")">
            <AppIcon Name="@(collapsed ? "chevron_right" : "arrow_back")" />
        </button>
    </div>

    <AuthorizeView>
        <Authorized>
            @if (HasSystemAccess)
            {
                <!-- Active Navigation Links -->
                <nav class="flex-1 overflow-y-auto py-4">
                    <ul class="space-y-1 px-3">
                        @if (IsDeveloperPortal && (CanAccessDeveloperPortal || isDeveloper))
                        {
                            <!-- Developer Menu -->
                            @SectionGroup("dev-monitoring", "Monitoring", @<text>
                                <NavItem Compact="collapsed" Href="/developer/overview" Icon="home" Text="Overview" />
                                <NavItem Compact="collapsed" Href="/developer/error-logs" Icon="exclamation" Text="Error Logs" />
                                <NavItem Compact="collapsed" Href="/admin/settings/audit-logs" Icon="bi-shield-check" Text="Audit Logs" />
                                <NavItem Compact="collapsed" Href="/admin/settings/activity-logs" Icon="bi-activity" Text="Activity Logs" />
                                <NavItem Compact="collapsed" Href="/developer/health" Icon="bi-heart-pulse" Text="Application Health" />
                            </text>, isFirst: true)

                            @SectionGroup("dev-workflows", "Workflows", @<text>
                                <NavItem Compact="collapsed" Href="/developer/request-types" Icon="bi-ui-checks" Text="Request Types" />
                                <NavItem Compact="collapsed" Href="/developer/transitions" Icon="bi-arrow-repeat" Text="Transition States" />
                                <NavItem Compact="collapsed" Href="/developer/notification-resolution" Icon="bi-bell" Text="Notification Resolution" />
                                <NavItem Compact="collapsed" Href="/developer/workflows" Icon="bi-diagram-3" Text="Approval Workflows" />
                            </text>)

                            @SectionGroup("dev-infra", "Infrastructure", @<text>
                                <NavItem Compact="collapsed" Href="/developer/edge-agents" Icon="bi-pc-display" Text="Client Agents" />
                                <NavItem Compact="collapsed" Href="/developer/diagnostics" Icon="cog" Text="System & Diagnostics" />
                            </text>)
                        }
                        else if (IsAdminPortal && CanAccessAdminPortal)
                        {
                            <!-- Admin Menu -->
                            @SectionGroup("admin-workspace", "Workspace", @<text>
                                <NavItem Compact="collapsed" Href="/admin/my/workspace" Match="NavLinkMatch.All" Icon="briefcase" Text="My Workspace" />
                                <NavItem Compact="collapsed" Href="/admin" Match="NavLinkMatch.All" Icon="home" Text="Dashboard" />
                                @if (canViewRequests)
                                {
                                    <NavItem Compact="collapsed" Href="/admin/hr/requests" Icon="bi-inbox" Text="Requests Inbox" />
                                }
                            </text>, isFirst: true)

                            @if (canViewStaff || canViewRecruitment || canViewTransfers || canViewSeparations || canManageLeadership)
                            {
                                @SectionGroup("admin-people", "People & HR", @<text>
                                    @if (canViewStaff)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/staff/manage" Icon="users" Text="Staff" />
                                    }
                                    @if (canViewRecruitment)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/recruitment" Icon="user-plus" Text="Recruitment" />
                                    }
                                    @if (canViewTransfers)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/staff-transfers" Icon="bi-arrow-left-right" Text="Transfers" />
                                    }
                                    @if (canViewSeparations)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/separations" Icon="bi-box-arrow-right" Text="Separations" />
                                    }
                                    @if (canViewStaff)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/staff-groups" Icon="bi-collection" Text="Staff Groups" />
                                    }
                                    @if (canManageLeadership)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/settings/leadership/management" Icon="workspace_premium" Text="Leadership" />
                                    }
                                </text>)
                            }

                            @if (canViewAttendance || canViewLeaves || canViewDutyRoster)
                            {
                                @SectionGroup("admin-time", "Time & Attendance", @<text>
                                    @if (canViewAttendance)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/attendance/manage-attendance" Icon="clock" Text="Attendance" />
                                    }
                                    @if (canViewLeaves)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/my/workspace/leave" Icon="calendar" Text="Leave Management" />
                                    }
                                    @if (canViewAttendance)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/attendance/manage-overtimes" Icon="trending-up" Text="Overtime" />
                                    }
                                    @if (canViewDutyRoster)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/work-planning/duty-roster" Icon="bi-calendar2-week" Text="Duty Roster" />
                                    }
                                    @if (canViewLeaves)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/work-handovers" Icon="bi-people-fill" Text="Work Handovers" />
                                    }
                                </text>)
                            }

                            @if (canViewPayroll || canViewBudget || canViewGoodsLoans)
                            {
                                @SectionGroup("admin-finance", "Finance & Payroll", @<text>
                                    @if (canViewPayroll)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/payroll/payroll" Icon="payments" Text="Payroll" />
                                        <NavItem Compact="collapsed" Href="/admin/payroll/finance" Icon="currency-dollar" Text="Allowances & Deductions" />
                                    }
                                    @if (canViewBudget)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/budget" Icon="bi-pie-chart" Text="Budget" />
                                    }
                                    @if (canViewGoodsLoans)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/goods-loans" Icon="bi-bag-check" Text="Goods Loans" />
                                    }
                                </text>)
                            }

                            @if (canViewItems || canViewDocuments)
                            {
                                @SectionGroup("admin-assets", "Assets & Records", @<text>
                                    @if (canViewItems)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/items" Icon="bi-box-seam" Text="Items & Assets" />
                                    }
                                    @if (canViewDocuments)
                                    {
                                        <NavItem Compact="collapsed" Href="/admin/hr/certificates" Icon="bi-patch-check" Text="Certificates" />
                                        <NavItem Compact="collapsed" Href="/admin/hr/documents" Icon="bi-folder2-open" Text="Document Centre" />
                                    }
                                </text>)
                            }

                            @SectionGroup("admin-org", "Organisation", @<text>
                                @if (canViewDepartments)
                                {
                                    <NavItem Compact="collapsed" Href="/admin/my/workspace/organisation" Icon="corporate_fare" Text="Departments" />
                                }
                                @if (canViewSupervisors)
                                {
                                    <NavItem Compact="collapsed" Href="/admin/hr/supervisors" Icon="bi-person-badge" Text="Supervisors" />
                                }
                                @if (canViewDepartments)
                                {
                                    <NavItem Compact="collapsed" Href="/admin/hr/events" Icon="bi-calendar-event" Text="Events" />
                                }
                                <NavItem Compact="collapsed" Href="/admin/chat" Icon="chat" Text="Chat" />
                            </text>)

                            @if (canViewSettings)
                            {
                                @SectionGroup("admin-settings", "Administration", @<text>
                                    <NavItem Compact="collapsed" Href="/admin/settings" Icon="cog" Text="Settings" />
                                    <NavItem Compact="collapsed" Href="/admin/settings/audit-logs" Icon="bi-shield-check" Text="Audit Logs" />
                                    <NavItem Compact="collapsed" Href="/admin/settings/activity-logs" Icon="bi-activity" Text="Activity Logs" />
                                </text>)
                            }
                        }
                        else
                        {
                            <!-- Employee (Self) Menu -->
                            @SectionGroup("emp-overview", "Overview", @<text>
                                <NavItem Compact="collapsed" Href="/online" Match="NavLinkMatch.All" Icon="home" Text="Home" />
                                <NavItem Compact="collapsed" Href="/online/chat" Icon="chat" Text="Chat" />
                            </text>, isFirst: true)

                            @SectionGroup("emp-time", "Time & Leave", @<text>
                                <NavItem Compact="collapsed" Href="/online/attendance" Icon="clock" Text="Attendance" />
                                <NavItem Compact="collapsed" Href="/online/duty-roster" Icon="bi-calendar2-week" Text="Duty Roster" />
                                <NavItem Compact="collapsed" Href="/online/leaves" Icon="calendar" Text="Leave" />
                                <NavItem Compact="collapsed" Href="/online/leave-handovers" Icon="bi-people-fill" Text="Work Handovers" />
                                <NavItem Compact="collapsed" Href="/online/ot" Icon="trending-up" Text="Overtime" />
                            </text>)

                            @SectionGroup("emp-pay", "Pay & Benefits", @<text>
                                <NavItem Compact="collapsed" Href="/online/payslips" Icon="bi-receipt" Text="My Payslips" />
                                <NavItem Compact="collapsed" Href="/online/allowances-deductions" Icon="payments" Text="Allowances & Deductions" />
                                <NavItem Compact="collapsed" Href="/online/goods-loans" Icon="currency-dollar" Text="Goods Loans" />
                            </text>)

                            @SectionGroup("emp-services", "Services & Assets", @<text>
                                <NavItem Compact="collapsed" Href="/online/item-requests" Icon="bi-box-seam" Text="Item Requests" />
                                <NavItem Compact="collapsed" Href="/online/my-assets" Icon="briefcase" Text="My Assets" />
                                <NavItem Compact="collapsed" Href="/online/certificates" Icon="bi-patch-check" Text="Certificates" />
                                <NavItem Compact="collapsed" Href="/online/documents" Icon="bi-folder2-open" Text="My Documents" />
                            </text>)

                            @SectionGroup("emp-career", "Career & HR", @<text>
                                <NavItem Compact="collapsed" Href="/online/staff-transfers" Icon="bi-arrow-left-right" Text="Transfers" />
                                <NavItem Compact="collapsed" Href="/online/staff-separation" Icon="bi-box-arrow-right" Text="Separation" />
                                <NavItem Compact="collapsed" Href="/online/recruitment" Icon="user-plus" Text="Internal Vacancies" />
                                @if (hasLeadershipAuthority)
                                {
                                    <NavItem Compact="collapsed" Href="/online/leadership" Icon="workspace_premium" Text="Leadership" />
                                }
                            </text>)
                        }
                    </ul>
                </nav>


                <PortalSwitcher CanAccessAdminPortal="CanAccessAdminPortal" CanAccessDeveloperPortal="CanAccessDeveloperPortal || isDeveloper" @rendermode="RenderMode.InteractiveServer" />
            }
            else
            {
                @DisabledEmployeeMenu
            }


            <div class="sidebar-bottom mt-auto p-2 border-t border-slate-800">
                <LogoutButton Class="sidebar-logout flex items-center gap-3 text-slate-300 hover:text-white transition-colors w-full px-3 py-2 rounded-lg">
                    <AppIcon Name="logout" Class="w-5 h-5 text-xl" />
                    @if (!collapsed)
                    {
                        <span>Log Out</span>
                    }
                </LogoutButton>
            </div>
        </Authorized>

        <NotAuthorized>
            <!-- Disabled Navigation State -->
            @DisabledEmployeeMenu

            <!-- Locked Indicator instead of Logout -->
            <div class="sidebar-bottom mt-auto p-4 border-t border-slate-800">
                <div class="flex items-center gap-3 text-slate-500 px-3 py-2 text-sm">
                    <AppIcon Name="lock" Class="w-5 h-5 text-xl" />
                    @if (!collapsed)
                    {
                        <span>Login required</span>
                    }
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</aside>
@code {
    [Parameter] public bool HasSystemAccess { get; set; }
    [Parameter] public bool CanAccessAdminPortal { get; set; }
    [Parameter] public bool CanAccessDeveloperPortal { get; set; }
    [Parameter] public bool CanAccessAuditPortal { get; set; }
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback OnMobileClose { get; set; }
    private bool collapsed;
    private bool isDeveloper;
    private bool hasLeadershipAuthority;
    private bool canManageLeadership;
    private bool canViewRequests;
    private bool canViewStaff;
    private bool canViewRecruitment;
    private bool canViewTransfers;
    private bool canViewSeparations;
    private bool canViewAttendance;
    private bool canViewLeaves;
    private bool canViewDutyRoster;
    private bool canViewPayroll;
    private bool canViewBudget;
    private bool canViewGoodsLoans;
    private bool canViewItems;
    private bool canViewDocuments;
    private bool canViewDepartments;
    private bool canViewSupervisors;
    private bool canViewSettings;

    private async Task<bool> HasAnyPermissionAsync(params string[] permissions)
    {
        foreach (var permission in permissions)
        {
            if (await UserAccess.HasPermissionAsync(permission))
                return true;
        }
        return false;
    }

    private void ResetPermissions()
    {
        hasLeadershipAuthority = false;
        canManageLeadership = false;
        canViewRequests = false;
        canViewStaff = false;
        canViewRecruitment = false;
        canViewTransfers = false;
        canViewSeparations = false;
        canViewAttendance = false;
        canViewLeaves = false;
        canViewDutyRoster = false;
        canViewPayroll = false;
        canViewBudget = false;
        canViewGoodsLoans = false;
        canViewItems = false;
        canViewDocuments = false;
        canViewDepartments = false;
        canViewSupervisors = false;
        canViewSettings = false;
    }

    private (bool HasAccess, bool CanAdmin, bool CanDev, string Portal)? loadedPermissionScope;

    private string CurrentPortalKey => IsDeveloperPortal ? "dev" : IsAdminPortal ? "admin" : "emp";

    protected override async Task OnParametersSetAsync()
    {
        if (MobileOpen) collapsed = false;
        EnsurePortalGroupsInitialized();

        var scope = (HasSystemAccess, CanAccessAdminPortal, CanAccessDeveloperPortal, CurrentPortalKey);
        if (loadedPermissionScope == scope)
            return;

        if (!HasSystemAccess)
        {
            ResetPermissions();
            isDeveloper = CanAccessDeveloperPortal;
            loadedPermissionScope = scope;
            return;
        }

        try
        {
            var actor = await UserAccess.RequireContextAsync();
            var isAdmin = actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Admin");
            var isHrGroup = await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head");
            var isAdminOrHr = isAdmin || isHrGroup;

            var nextManageLeadership = actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Leadership.Appointment.Manage");
            var nextRequests = isAdminOrHr || await HasAnyPermissionAsync("Requests.View", "Employee.View");
            var nextStaff = isAdminOrHr || await HasAnyPermissionAsync("Employee.View", "Staff.Details");
            var nextRecruitment = isAdmin || await HasAnyPermissionAsync("Recruitment.View", "Recruitment.Manage");
            var nextTransfers = isAdminOrHr || await HasAnyPermissionAsync("Staff.Transfer", "Employee.View");
            var nextSeparations = isAdminOrHr || await HasAnyPermissionAsync("Staff.Separation", "Employee.View");
            var nextAttendance = isAdminOrHr || await HasAnyPermissionAsync("Attendance.View", "Attendance.Manage");
            var nextLeaves = isAdminOrHr || await HasAnyPermissionAsync("Leave.View", "Leave.Approve");
            var nextDutyRoster = isAdminOrHr || await HasAnyPermissionAsync("WorkPlanning.Manage", "DutyRoster.View");
            var nextPayroll = isAdminOrHr || await HasAnyPermissionAsync("Payroll.View", "Payroll.Review");
            var nextBudget = isAdminOrHr || await HasAnyPermissionAsync("Budget.View", "Budget.Manage");
            var nextGoodsLoans = isAdminOrHr || await HasAnyPermissionAsync("GoodsLoans.View", "GoodsLoans.Manage", "GoodsLoan.Manage", "Payroll.View");
            var nextItems = isAdminOrHr || await HasAnyPermissionAsync("Items.View", "Items.Manage");
            var nextDocuments = isAdminOrHr || await HasAnyPermissionAsync("Documents.View", "Documents.Manage", "Employee.View");
            var nextDepartments = isAdminOrHr || await HasAnyPermissionAsync("Organisation.View", "Employee.View");
            var nextSupervisors = isAdminOrHr || await HasAnyPermissionAsync("Organisation.Manage", "Team.Manage");
            var nextSettings = isAdmin || await HasAnyPermissionAsync(
                "Configuration.View", "Roles.View", "UserOrganisation.Groups.View", "Organisation.Groups.View",
                "Organisation.View", "Organisation.Manage", "User.View", "User.Manage", "AdminAccess.Manage",
                "WorkTypes.Manage", "WorkPlanning.Manage", "Schedules.Manage",
                "Leave.Configure", "Payroll.View", "Payroll.Configure",
                "Position.Details", "Staff.Positions.Manage", "Positions.Configure",
                "Project.View", "Project.Manage");

            var nextLeadershipAuthority = hasLeadershipAuthority;
            if (!IsAdminPortal && !IsDeveloperPortal)
            {
                try
                {
                    var leadershipOrgs = await LeadershipAccess.GetCurrentOrganisationAccessAsync();
                    nextLeadershipAuthority = leadershipOrgs.Any();
                }
                catch
                {
                    nextLeadershipAuthority = false;
                }
            }

            var nextIsDeveloper = CanAccessDeveloperPortal || await UserAccess.HasUserGroupAsync("Developer") || await UserAccess.HasPermissionAsync("Developer");

            // Assign atomically after all awaits complete to prevent intermediate blank-menu flashes.
            canManageLeadership = nextManageLeadership;
            canViewRequests = nextRequests;
            canViewStaff = nextStaff;
            canViewRecruitment = nextRecruitment;
            canViewTransfers = nextTransfers;
            canViewSeparations = nextSeparations;
            canViewAttendance = nextAttendance;
            canViewLeaves = nextLeaves;
            canViewDutyRoster = nextDutyRoster;
            canViewPayroll = nextPayroll;
            canViewBudget = nextBudget;
            canViewGoodsLoans = nextGoodsLoans;
            canViewItems = nextItems;
            canViewDocuments = nextDocuments;
            canViewDepartments = nextDepartments;
            canViewSupervisors = nextSupervisors;
            canViewSettings = nextSettings;
            hasLeadershipAuthority = nextLeadershipAuthority;
            isDeveloper = nextIsDeveloper;
            loadedPermissionScope = scope;
        }
        catch
        {
            ResetPermissions();
            isDeveloper = CanAccessDeveloperPortal;
        }
    }

    private static readonly string[] AllGroupKeys =
    [
        "dev-monitoring", "dev-workflows", "dev-infra",
        "admin-workspace", "admin-people", "admin-time", "admin-finance", "admin-assets", "admin-org", "admin-settings",
        "emp-overview", "emp-time", "emp-pay", "emp-services", "emp-career"
    ];

    private readonly HashSet<string> collapsedGroups = new(StringComparer.OrdinalIgnoreCase);
    private string? initializedPortal;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        EnsurePortalGroupsInitialized();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        EnsurePortalGroupsInitialized();
        var active = GetActiveGroupKey();
        if (!string.IsNullOrEmpty(active))
            collapsedGroups.Remove(active);
        InvokeAsync(StateHasChanged);
    }

    private void EnsurePortalGroupsInitialized()
    {
        var portal = IsDeveloperPortal ? "dev" : IsAdminPortal ? "admin" : "emp";
        if (string.Equals(initializedPortal, portal, StringComparison.Ordinal))
            return;

        initializedPortal = portal;
        collapsedGroups.Clear();
        foreach (var key in AllGroupKeys)
        {
            if (key.StartsWith(portal + "-", StringComparison.Ordinal))
                collapsedGroups.Add(key);
        }

        var defaultGroup = portal switch
        {
            "dev" => "dev-monitoring",
            "admin" => "admin-workspace",
            _ => "emp-overview"
        };
        collapsedGroups.Remove(defaultGroup);

        var active = GetActiveGroupKey();
        if (!string.IsNullOrEmpty(active))
            collapsedGroups.Remove(active);
    }

    private string? GetActiveGroupKey()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(path)) path = "/";

        if (IsDeveloperPortal)
        {
            if (path.Contains("/request-types") || path.Contains("/transitions") || path.Contains("/notification-resolution") || path.Contains("/workflows"))
                return "dev-workflows";
            if (path.Contains("/edge-agents") || path.Contains("/diagnostics"))
                return "dev-infra";
            return "dev-monitoring";
        }

        if (IsAdminPortal)
        {
            if (path == "/admin" || path == "/admin/my/workspace" || path.StartsWith("/admin/hr/requests"))
                return "admin-workspace";
            if (path.StartsWith("/admin/hr/staff") || path.StartsWith("/admin/hr/recruitment") || path.StartsWith("/admin/hr/separations") || path.StartsWith("/admin/settings/leadership"))
                return "admin-people";
            if (path.StartsWith("/admin/attendance") || path.StartsWith("/admin/my/workspace/leave") || path.StartsWith("/admin/hr/work-planning") || path.StartsWith("/admin/hr/work-handovers"))
                return "admin-time";
            if (path.StartsWith("/admin/payroll") || path.StartsWith("/admin/budget") || path.StartsWith("/admin/goods-loans") || path.StartsWith("/admin/hr/goods-loans"))
                return "admin-finance";
            if (path.StartsWith("/admin/hr/items") || path.StartsWith("/admin/hr/certificates") || path.StartsWith("/admin/hr/documents") || path.StartsWith("/admin/hr/slogans"))
                return "admin-assets";
            if (path.StartsWith("/admin/my/workspace/organisation") || path.StartsWith("/admin/hr/supervisors") || path.StartsWith("/admin/hr/events") || path.StartsWith("/admin/chat"))
                return "admin-org";
            if (path.StartsWith("/admin/settings"))
                return "admin-settings";
            return "admin-workspace";
        }

        if (path == "/" || path == "/online" || path.StartsWith("/online/chat"))
            return "emp-overview";
        if (path.StartsWith("/online/attendance") || path.StartsWith("/online/duty-roster") || path.StartsWith("/online/leaves") || path.StartsWith("/online/leave-handovers") || path.StartsWith("/online/ot") || path.StartsWith("/online/overtime"))
            return "emp-time";
        if (path.StartsWith("/online/payslips") || path.StartsWith("/online/my-payslips") || path.StartsWith("/online/allowances-deductions") || path.StartsWith("/online/goods-loans"))
            return "emp-pay";
        if (path.StartsWith("/online/item-requests") || path.StartsWith("/online/my-assets") || path.StartsWith("/online/certificates") || path.StartsWith("/online/documents"))
            return "emp-services";
        if (path.StartsWith("/online/staff-transfers") || path.StartsWith("/online/staff-separation") || path.StartsWith("/online/recruitment") || path.StartsWith("/online/leadership"))
            return "emp-career";
        return "emp-overview";
    }

    private bool IsGroupCollapsed(string key) => !collapsed && collapsedGroups.Contains(key);

    private void ToggleGroup(string key)
    {
        if (!collapsedGroups.Add(key))
            collapsedGroups.Remove(key);
    }

    private RenderFragment SectionGroup(string key, string title, RenderFragment items, bool isFirst = false) => @<text>
        @if (collapsed)
        {
            @if (!isFirst)
            {
                <li aria-hidden="true"><hr class="sidebar-group-divider" /></li>
            }
            @items
        }
        else
        {
            var isCollapsed = IsGroupCollapsed(key);
            <li class="@(isFirst ? null : "pt-1.5 mt-1 border-t border-white/15")">
                <button type="button"
                        class="sidebar-group-toggle"
                        aria-expanded="@((!isCollapsed).ToString().ToLowerInvariant())"
                        @onclick="() => ToggleGroup(key)">
                    <span class="truncate">@title</span>
                    <AppIcon Name="chevron_down" Class="@($"sidebar-group-chevron {(isCollapsed ? "is-collapsed" : null)}")" />
                </button>
            </li>
            @if (!isCollapsed)
            {
                @items
            }
        }
    </text>;

    private void ToggleCollapsed() => collapsed = !collapsed;
    private Task CloseMobileAsync() => OnMobileClose.InvokeAsync();
    private async Task HandleNavigationButton()
    {
        if (MobileOpen) await CloseMobileAsync();
        else ToggleCollapsed();
    }
    private RenderFragment DisabledEmployeeMenu => @<nav aria-label="Employee navigation" class="flex-1 overflow-y-auto py-4 opacity-50">
        <ul class="space-y-1 px-3">
