@implements IDisposable

@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Enum

@inject IUserContext UserContext
@inject PortalContext PortalContext
@inject NavigationManager NavManager

@if (ShowThreeWaySwitcher)
{
    <div class="portal-switch-container">
        <div class="portal-segmented-group" role="group" aria-label="Portal Selection">
            <button type="button" class="portal-seg-btn @(IsSelfActive ? "active" : "")"
                    title="Switch to Self (Employee) Portal"
                    disabled="@switching" @onclick="SwitchToSelf">
                Self
            </button>
            <button type="button" class="portal-seg-btn @(PortalContext.IsAdminPortal ? "active admin" : "")"
                    title="Switch to Admin Portal"
                    disabled="@switching" @onclick="SwitchToOrganisation">
                Admin
            </button>
            <button type="button" class="portal-seg-btn @(PortalContext.IsDeveloperPortal ? "active dev" : "")"
                    title="Switch to Developer Portal"
                    disabled="@switching" @onclick="SwitchToDeveloper">
                Dev
            </button>
        </div>
    </div>
}
else if (CanAccessDeveloperPortal && PortalContext.CanAccessDeveloperPortal)
{
    <div class="portal-switch-container">
        <button type="button" role="switch" class="portal-switch"
                aria-label="Developer portal" aria-checked="@(PortalContext.IsDeveloperPortal ? "true" : "false")"
                title="@(PortalContext.IsDeveloperPortal ? "Switch to Self" : "Switch to Developer")"
                disabled="@switching" @onclick="ToggleDeveloperAsync">
            <span class="portal-label @(!PortalContext.IsDeveloperPortal ? "selected" : "")">Self</span>
            <span class="portal-track @(PortalContext.IsDeveloperPortal ? "developer-active" : "")" aria-hidden="true"><span class="portal-thumb"></span></span>
            <span class="portal-label @(PortalContext.IsDeveloperPortal ? "selected" : "")">Dev</span>
        </button>
    </div>
}
else if (CanAccessAdminPortal && PortalContext.CanAccessAdminPortal)
{
    <div class="portal-switch-container">
        <button type="button" role="switch" class="portal-switch"
                aria-label="Admin portal" aria-checked="@(PortalContext.IsAdminPortal ? "true" : "false")"
                title="@(PortalContext.IsAdminPortal ? "Switch to Self" : "Switch to Admin")"
                disabled="@switching" @onclick="ToggleAdminAsync">
            <span class="portal-label @(!PortalContext.IsAdminPortal ? "selected" : "")">Self</span>
            <span class="portal-track @(PortalContext.IsAdminPortal ? "admin" : "")" aria-hidden="true"><span class="portal-thumb"></span></span>
            <span class="portal-label @(PortalContext.IsAdminPortal ? "selected" : "")">Admin</span>
        </button>
    </div>
}

@code
{
    [Parameter] public bool CanAccessAdminPortal { get; set; }
    [Parameter] public bool CanAccessDeveloperPortal { get; set; }

    private bool switching;

    private bool ShowThreeWaySwitcher =>
        CanAccessAdminPortal && PortalContext.CanAccessAdminPortal &&
        CanAccessDeveloperPortal && PortalContext.CanAccessDeveloperPortal;

    private bool IsSelfActive => !PortalContext.IsAdminPortal && !PortalContext.IsDeveloperPortal;

    private async Task ToggleAdminAsync()
    {
        if (switching || !CanAccessAdminPortal || !PortalContext.CanAccessAdminPortal) return;
        switching = true;
        try
        {
            if (PortalContext.IsAdminPortal) SwitchToSelf();
            else await SwitchToOrganisation();
        }
        finally { switching = false; }
    }

    private async Task ToggleDeveloperAsync()
    {
        if (switching || !CanAccessDeveloperPortal || !PortalContext.CanAccessDeveloperPortal) return;
        switching = true;
        try
        {
            if (PortalContext.IsDeveloperPortal) SwitchToSelf();
            else await SwitchToDeveloper();
        }
        finally { switching = false; }
    }

    protected override void OnInitialized()
    {
        DetermineContextFromUrl();
        PortalContext.OnChange += Refresh;
    }

    private void DetermineContextFromUrl()
    {
        var path = new Uri(NavManager.Uri).AbsolutePath.ToLower();

        if (path == "/admin" || path.StartsWith("/admin/"))
            PortalContext.SwitchToAdmin();
        else if (path == "/developer" || path.StartsWith("/developer/"))
            PortalContext.SwitchToDeveloper();
        else
            PortalContext.SwitchToEmployee();
    }

    private void SwitchToSelf()
    {
        PortalContext.SwitchToEmployee();
        NavManager.NavigateTo("/online", forceLoad: true);
    }

    private async Task SwitchToOrganisation()
    {
        if (!CanAccessAdminPortal) return;
        var session = await UserContext.GetSessionAsync();
        PortalContext.Initialize(session?.OrganisationId, session?.OrganisationName ?? "", session?.CanAccessAdminPortal == true, session?.CanAccessDeveloperPortal == true, session?.CanAccessAuditPortal == true);
        if (!PortalContext.CanAccessAdminPortal) return;
        PortalContext.SwitchToAdmin();

        NavManager.NavigateTo("/admin", forceLoad: true);
    }

    private async Task SwitchToDeveloper()
    {
        if (!CanAccessDeveloperPortal) return;
        var session = await UserContext.GetSessionAsync();
        PortalContext.Initialize(session?.OrganisationId, session?.OrganisationName ?? "", session?.CanAccessAdminPortal == true, session?.CanAccessDeveloperPortal == true, session?.CanAccessAuditPortal == true);
        if (!PortalContext.CanAccessDeveloperPortal) return;
        PortalContext.SwitchToDeveloper();

        NavManager.NavigateTo("/developer", forceLoad: true);
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PortalContext.OnChange -= Refresh;
    }
}
