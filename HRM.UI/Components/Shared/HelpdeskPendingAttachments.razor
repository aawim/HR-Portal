@using HRM.UI.Helpers

@if (Items != null && Items.Count > 0)
{
    <div class="flex flex-wrap items-center gap-1.5 @(Compact ? "pb-1.5" : "pb-2")">
        @for (var i = 0; i < Items.Count; i++)
        {
            var idx = i;
            var item = Items[i];
            <div class="inline-flex items-center gap-1.5 rounded-lg border border-teal-200 dark:border-teal-800 bg-teal-50/75 dark:bg-teal-950/40 px-2 py-1 text-[11px] text-slate-800 dark:text-slate-100 max-w-full">
                @if (item.IsImage && !string.IsNullOrEmpty(item.PreviewDataUrl))
                {
                    <img src="@item.PreviewDataUrl" alt="@item.FileName" class="h-7 w-7 rounded object-cover border border-slate-200 dark:border-slate-700 shrink-0" />
                }
                else
                {
                    <AppIcon Name="@HelpdeskAttachmentUiHelper.FileIcon(item.FileName, item.IsImage)" Class="text-xs text-teal-700 dark:text-teal-300 shrink-0" />
                }
                <div class="min-w-0 leading-tight">
                    <div class="truncate max-w-[10rem] font-semibold">@item.FileName</div>
                    <div class="text-[9px] text-slate-500 dark:text-slate-400">@HelpdeskAttachmentUiHelper.FormatSize(item.SizeBytes)</div>
                </div>
                <button type="button"
                        class="inline-flex h-5 w-5 items-center justify-center rounded-md text-slate-500 hover:bg-rose-100 hover:text-rose-700 dark:hover:bg-rose-950 dark:hover:text-rose-300 transition shrink-0"
                        title="Remove attachment"
                        aria-label="Remove @item.FileName"
                        disabled="@Disabled"
                        @onclick="() => OnRemove.InvokeAsync(idx)">
                    <AppIcon Name="close" Class="text-[10px]" />
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<StagedHelpdeskAttachment>? Items { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public EventCallback<int> OnRemove { get; set; }
}
