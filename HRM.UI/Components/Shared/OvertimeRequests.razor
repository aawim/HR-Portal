@page "/online/overtime-requests"
@page "/admin/attendance/manage-overtimes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HRM.Services.Contracts.OvertimeRequestServiceContracts.IOperations Requests
@inject HRM.Services.ToastService Toasts
@inject ILogger<OvertimeRequests> Logger
@inject NavigationManager Navigation
<section class="space-y-3 rounded-xl border p-4">
    <div class="flex flex-wrap items-center justify-between gap-2"><h1 class="font-semibold">@(PendingOnly?"Pending overtime requests":"Overtime requests")</h1><button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Refresh</button></div>
    @if(PendingOnly){<a class="text-sm underline" href="/admin/attendance/manage-overtimes">Overtime and payroll</a>}
    <div class="@(PendingOnly ? "" : "grid min-w-0 items-start gap-4 xl:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]")">
    <div class="min-w-0 space-y-3">
    @if(!PendingOnly)
    {
        <nav class="flex flex-wrap gap-2" aria-label="Overtime request types">
            @foreach(var option in tabs.Where(t => CanReview || t.Key != "Payroll"))
            { <button type="button" class="app-button @(tab==option.Key ? "app-button-primary" : "app-button-secondary")" disabled="@busy" @onclick="()=>ChangeTab(option.Key)">@option.Value</button> }
        </nav>
        @if(tab=="Payroll")
        {
            <OvertimePayroll Rows="rows" OnProcessed="LoadAsync" />
        }
        else
        {
        <fieldset disabled="@busy" class="grid min-w-0 gap-4">
        <div class="min-w-0 space-y-3">
        @if(tab=="Preapproval")
        {
            <div class="flex flex-wrap gap-3"><label>From date<input type="date" @bind="from" class="mt-1 block rounded border bg-transparent p-2" /></label><label>To date<input type="date" @bind="to" class="mt-1 block rounded border bg-transparent p-2" /></label></div>
            <label class="block">Tasks to perform<textarea @bind="taskText" maxlength="15000" rows="3" placeholder="One task per line" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label>
        }
        else if(tab=="ClockEvents")
        {
            <p class="text-sm text-slate-500">Request missing OT punches. They become saved clock events only after approval.</p>
            <div class="flex flex-wrap gap-3"><label>Start date<input type="date" @bind="from" class="mt-1 block rounded border bg-transparent p-2" /></label><label>Start time<input type="time" @bind="startTime" class="mt-1 block rounded border bg-transparent p-2" /></label><label>End date<input type="date" @bind="to" class="mt-1 block rounded border bg-transparent p-2" /></label><label>End time<input type="time" @bind="endTime" class="mt-1 block rounded border bg-transparent p-2" /></label></div>
        }
        else
        {
            @if(tab=="Planned")
            {
                @if(tasks.Count==0)
                {
                    <div class="space-y-2 rounded-lg border p-3 text-sm" role="status">
                        <p>No approved OT preapproval with tasks is available for your account. Planned OT needs an approved request first.</p>
                        <div class="flex flex-wrap gap-2"><button type="button" class="app-button app-button-secondary" @onclick='()=>ChangeTab("Preapproval")'>Request OT preapproval</button><button type="button" class="app-button app-button-secondary" @onclick='()=>ChangeTab("Unplanned")'>Claim unplanned OT</button></div>
                    </div>
                }
                <div class="grid gap-3 sm:grid-cols-2"><label>Approved OT request<select class="mt-1 block w-full rounded border bg-transparent p-2" value="@preapprovalId" @onchange="SelectPreapproval"><option value="0">Select request</option>@foreach(var group in tasks.GroupBy(t=>t.RequestId)){var first=group.First();<option value="@group.Key">@first.Reference · @first.From.ToString("dd MMM")–@first.To.ToString("dd MMM yyyy")</option>}</select></label>
                <label>Task<select disabled="@(preapprovalId==0)" class="mt-1 block w-full rounded border bg-transparent p-2" @bind="taskId"><option value="0">Select task</option>@foreach(var task in tasks.Where(t=>t.RequestId==preapprovalId)){<option value="@task.Id">@task.Task</option>}</select></label></div>
            }
            <div class="flex flex-wrap items-end gap-3"><label>Work date<input type="date" value="@date.ToString("yyyy-MM-dd")" @onchange="DateChanged" class="mt-1 block rounded border bg-transparent p-2" /></label><button type="button" class="app-button app-button-secondary" @onclick="LoadEvents">Refresh clock events</button></div>
            @if(SelectedStart!=null)
            {
                <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm" aria-live="polite">
                    <span>Start: <strong>@SelectedStart.Time.ToString("dd MMM HH:mm:ss")</strong></span>
                    <span>End: <strong>@(SelectedEnd?.Time.ToString("dd MMM HH:mm:ss")??"Select an event")</strong></span>
                    @if(SelectedEnd!=null){<span>Duration: <strong>@((SelectedEnd.Time-SelectedStart.Time).TotalHours.ToString("0.##")) hours</strong></span>}
                </div>
            }
            <p class="text-xs text-slate-500">Only unused saved events outside official time are listed. Cancel a claim to release its events.</p>
        }
        <label class="block">@(tab=="Preapproval" ? "Purpose" : "Work performed / reason")<textarea @bind="reason" maxlength="1000" rows="2" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label>
        <button class="app-button app-button-primary" disabled="@(tab=="Planned"&&taskId==0)" @onclick="SubmitAsync">Submit for approval</button>
        </div>
        @if(tab is "Planned" or "Unplanned")
        {
            <aside class="min-w-0 self-start overflow-hidden rounded-lg border" aria-labelledby="ot-clock-events-heading" aria-busy="@loadingEvents">
                <h2 id="ot-clock-events-heading" class="border-b px-3 py-2 text-sm font-semibold">Clock events outside official hours</h2>
                @if(loadingEvents){<p class="px-3 py-3 text-sm text-slate-500">Loading clock events…</p>}
                else if(clocks.Count==0){<p class="px-3 py-3 text-sm text-slate-500">No unused clock events outside official hours for this date. Events used in pending or approved claims are unavailable.</p>}
                else
                {
                    @foreach(var clock in clocks)
                    {
                        <div @key="clock.Id" class="flex flex-wrap items-center justify-between gap-2 border-b px-3 py-2 last:border-b-0">
                            <time datetime="@clock.Time.ToString("yyyy-MM-ddTHH:mm:ss")" class="text-sm font-medium">@clock.Time.ToString("dd MMM yyyy · HH:mm:ss")</time>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" class="app-button @(startId==clock.Id?"app-button-primary":"app-button-secondary")" aria-pressed="@(startId==clock.Id)" @onclick="()=>SelectStart(clock.Id)">@(startId==clock.Id?"Start selected":"Use as start")</button>
                                <button type="button" class="app-button @(endId==clock.Id?"app-button-primary":"app-button-secondary")" aria-pressed="@(endId==clock.Id)" disabled="@(SelectedStart==null||clock.Time<=SelectedStart.Time)" @onclick="()=>endId=clock.Id">@(endId==clock.Id?"End selected":"Use as end")</button>
                            </div>
                        </div>
                    }
                }
            </aside>
        }
        </fieldset>
        }
    }
    @if(error!=null){<p role="alert" class="text-sm">@error</p>}
    </div>
    <aside class="min-w-0 space-y-3" aria-label="Overtime request history">
    @if(!PendingOnly)
    {
        <OvertimeRequestTable Claims="rows" WorkRequests="workRows" Busy="busy" SelectedId="selectedRequestId" OnSelected="SelectRequest" OnFiltersChanged="ClearRequest" />
        @if(selectedRequestId.HasValue){<div class="flex items-center justify-between gap-2"><h2 class="text-sm font-semibold">Request details</h2><button type="button" class="app-button app-button-secondary" @onclick="ClearRequest">Close details</button></div>}
    }
    @foreach(var work in workRows.Where(w=>PendingOnly||w.Id==selectedRequestId))
    {
        <article class="space-y-2 border-t pt-3 text-sm" @key="work">
            <p class="font-semibold">@work.Reference · @work.Staff · @(work.Kind=="Preapproval" ? "OT preapproval" : "OT clock events")</p>
            <p>@work.From.ToString("dd MMM yyyy") – @work.To.ToString("dd MMM yyyy") · @work.Status</p>
            @if(work.Start.HasValue){<p>@work.Start.Value.ToString("dd MMM HH:mm") – @work.End?.ToString("dd MMM HH:mm")</p>}
            <p>@work.Reason</p>
            @if(work.Tasks.Count>0){<ul class="list-disc pl-5">@foreach(var task in work.Tasks){<li>@task</li>}</ul>}
            @if(!CanReview && work.CanApprove){<a class="app-button app-button-primary" href="@HRM.Application.Presentation.OvertimeNavigation.ReviewUrl(work.Id)">Review in Admin portal</a>}
            @if(CanReview && work.CanApprove||work.CanCancel)
            {
                <label class="block">Action comment<textarea @bind="comments[work.Id]" maxlength="2000" rows="2" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label>
                <div class="flex flex-wrap gap-2">@if(CanReview && work.CanApprove){<button class="app-button app-button-primary" disabled="@busy" @onclick='()=>ActWork(work,"Approve")'>Approve stage</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>ActWork(work,"Reject")'>Reject</button>}@if(work.CanCancel){<button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>ActWork(work,"Cancel")'>Cancel</button>}</div>
            }
        </article>
    }
    @foreach(var row in rows.Where(r=>PendingOnly||r.Id==selectedRequestId))
    {
        <article class="space-y-2 border-t pt-3 text-sm" @key="row.Id"><p class="font-semibold">@row.Reference · @row.Staff</p><p>@row.Date.ToString("dd MMM yyyy") · @((row.Minutes/60m).ToString("0.##")) hours · @row.Status</p><p>@row.Source · @row.Start?.ToString("dd MMM HH:mm:ss") – @row.End?.ToString("dd MMM HH:mm:ss")</p>@if(row.Task!=null){<p>Task: @row.Task</p>}<p>@row.Reason</p>
        @if(row.StateId==4){<p>Payroll: @(row.PayrollProcessed ? "Processed" : "Awaiting payroll") @row.PayrollMonth?.ToString("MMMM yyyy") @row.PayrollReference</p>}
        @if(row.CanResubmit){<label class="block">Work performed / reason<textarea @bind="reasons[row.Id]" maxlength="1000" rows="2" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label><button class="app-button app-button-primary" disabled="@busy" @onclick="()=>Resubmit(row.Id)">Resubmit for approval</button>}
        @if(row.PaymentReference!=null){<p>Payroll/payment reference: @row.PaymentReference</p>}
        @if(!CanReview && (row.CanApprove||row.CanReviseApproved)){<a class="app-button app-button-primary" href="@HRM.Application.Presentation.OvertimeNavigation.ReviewUrl(row.Id)">Review in Admin portal</a>}
        @if(CanReview && (row.CanApprove||row.CanReviseApproved)||CanCancelInPortal(row)){<label class="block">Action comment<textarea @bind="comments[row.Id]" maxlength="2000" rows="2" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label><div class="flex flex-wrap gap-2">@if(CanReview && row.CanApprove){<button class="app-button app-button-primary" disabled="@busy" @onclick='()=>Act(row,"Approve")'>Approve stage</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>Act(row,"Reject")'>Reject</button>}@if(CanReview && row.CanReviseApproved){<button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>Act(row,"Reject")'>Reject</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>Act(row,"Incomplete")'>Return as Incomplete</button>}@if(CanCancelInPortal(row)){<button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>Act(row,"Cancel")'>Cancel</button>}</div>}

        </article>
    }
    @if(PendingOnly&&!busy&&rows.Count==0&&workRows.Count==0&&error==null){<p class="text-sm text-slate-500">No overtime claims found.</p>}
    </aside>
    </div>
</section>
@code {
    private bool CanCancelInPortal(HRM.Services.OvertimeRow row) => row.CanCancel && (CanReview || !row.CanReviseApproved);
    private bool CanReview => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);
    [SupplyParameterFromQuery(Name = "requestId")] public int? RequestId { get; set; }
    protected override void OnParametersSet() { if(RequestId is > 0) selectedRequestId = RequestId; }
    [Parameter] public bool PendingOnly {get;set;}
    private List<HRM.Services.OvertimeRow> rows=[];private Dictionary<int,string?> comments=[];private Dictionary<int,string> reasons=[];
    private DateTime date=DateTime.UtcNow.AddHours(5).Date;private string reason="";private bool busy;private string? error;
    private int? selectedRequestId;
    private void SelectRequest(int id){selectedRequestId=id;}
    private void ClearRequest(){selectedRequestId=null;}
    private string tab="Preapproval",taskText="";
    private TimeOnly? startTime,endTime;
    private DateTime from=DateTime.UtcNow.AddHours(5).Date,to=DateTime.UtcNow.AddHours(5).Date;
    private int startId,endId,taskId,preapprovalId;
    private bool loadingEvents;
    private int eventLoadVersion;
    private HRM.Services.OvertimeClockOption? SelectedStart=>clocks.FirstOrDefault(c=>c.Id==startId);
    private HRM.Services.OvertimeClockOption? SelectedEnd=>clocks.FirstOrDefault(c=>c.Id==endId);
    private void SelectStart(int id){startId=id;if(SelectedEnd!=null&&SelectedEnd.Time<=SelectedStart!.Time)endId=0;}
    private List<HRM.Services.OvertimeWorkRow> workRows=[];
    private List<HRM.Services.OvertimeTaskOption> tasks=[];
    private List<HRM.Services.OvertimeClockOption> clocks=[];
    private readonly Dictionary<string,string> tabs=new(){{"Preapproval","OT preapproval"},{"Planned","Planned OT claim"},{"Unplanned","Unplanned OT claim"},{"ClockEvents","OT clock events"},{"Payroll","Approved & payroll"}};
    private async Task ChangeTab(string value)
    {
        tab=value;error=null;startId=endId=0;
        if(value=="Planned")
        {
            try{tasks=await Requests.LoadApprovedTasksAsync();if(!tasks.Any(t=>t.Id==taskId&&t.RequestId==preapprovalId))taskId=0;}
            catch(Exception ex){tasks=[];taskId=preapprovalId=0;Fail(ex);return;}
        }
        if(value is "Planned" or "Unplanned")await LoadEvents();
    }
    private void SelectPreapproval(ChangeEventArgs e)
    {
        preapprovalId=int.TryParse(e.Value?.ToString(),out var id)?id:0;
        var choices=tasks.Where(t=>t.RequestId==preapprovalId).ToList();
        taskId=choices.Count==1?choices[0].Id:0;error=null;
    }
    private async Task DateChanged(ChangeEventArgs e){if(DateTime.TryParse(e.Value?.ToString(),out var value)){date=value.Date;await LoadEvents();}}
    private async Task LoadEvents()
    {
        var version=++eventLoadVersion;var selectedDate=date;
        startId=endId=0;clocks=[];loadingEvents=true;error=null;
        try{var result=await Requests.LoadClockEventsAsync(selectedDate);if(version==eventLoadVersion)clocks=result;}
        catch(Exception ex){if(version==eventLoadVersion)Fail(ex);}
        finally{if(version==eventLoadVersion)loadingEvents=false;}
    }
    protected override Task OnInitializedAsync()=>LoadAsync();
    private async Task LoadAsync(){busy=true;error=null;try{rows=await Requests.LoadAsync(PendingOnly);workRows=await Requests.LoadWorkAsync(PendingOnly);if(!PendingOnly)tasks=await Requests.LoadApprovedTasksAsync();foreach(var work in workRows)comments.TryAdd(work.Id,null);foreach(var row in rows){comments.TryAdd(row.Id,null);reasons[row.Id]=row.Reason;}if(!PendingOnly&&tab is "Planned" or "Unplanned")await LoadEvents();}catch(Exception ex){Fail(ex);}finally{busy=false;}}
    private Task SubmitAsync()
    {
        if(tab=="Preapproval")return Execute(()=>Requests.SubmitWorkAsync(tab,from,to,reason,taskText.Split('\n').ToList()));
        if(tab=="ClockEvents")
        {
            if(startTime is not { } start || endTime is not { } finish){error="Select the missing start and end times.";return Task.CompletedTask;}
            return Execute(()=>Requests.SubmitWorkAsync(tab,from,to,reason,[],from.Date.Add(start.ToTimeSpan()),to.Date.Add(finish.ToTimeSpan())));
        }
        if(loadingEvents||SelectedStart==null||SelectedEnd==null){error="Select a saved clock event as the start and a later event as the end.";return Task.CompletedTask;}
        if(tab=="Planned"&&taskId==0){error="Select an approved request and task.";return Task.CompletedTask;}
        return Execute(()=>Requests.SubmitClaimAsync(startId,endId,reason,tab=="Planned"?taskId:null));
    }
    private Task ActWork(HRM.Services.OvertimeWorkRow row,string action)=>!CanReview && action != "Cancel" ? Task.CompletedTask : Execute(()=>Requests.ActWorkAsync(row.Id,row.StateId,action,comments.GetValueOrDefault(row.Id)));
    private Task Act(HRM.Services.OvertimeRow row,string action)=>!CanReview && (action != "Cancel" || !CanCancelInPortal(row)) ? Task.CompletedTask : Execute(()=>Requests.ActAsync(row.Id,row.StateId,action,comments.GetValueOrDefault(row.Id)));
    private Task Resubmit(int id)=>Execute(()=>Requests.ResubmitClaimAsync(id,reasons.GetValueOrDefault(id,"")));
    private async Task Execute(Func<Task<HRM.DTOs.ServiceResult>> action){if(busy)return;busy=true;error=null;var saved=false;try{var result=await action();saved=result.Success;if(saved)Toasts.Success(result.Message);else error=result.Message;}catch(Exception ex){Fail(ex);}finally{busy=false;}if(saved)await LoadAsync();}
    private void Fail(Exception ex){Logger.LogError(ex,"Overtime claim processing");error=ex is InvalidOperationException or UnauthorizedAccessException?ex.Message:"Overtime claims could not be loaded or saved. Please refresh or contact HR.";}
}
