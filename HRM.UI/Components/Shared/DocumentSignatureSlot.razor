@using HRM.Application.Contracts.Signatures
@using HRM.UI.Services.Signatures
@inject HRM.UI.Services.Signatures.IDocumentSignatureApiClient SignatureApi
@inject NavigationManager Navigation

<div class="rounded-xl border border-slate-200 bg-white p-3 text-xs space-y-2">
    <div class="flex items-center justify-between gap-2">
        <span class="font-bold text-slate-800">@SlotLabel</span>
        @if (Signature is not null)
        {
            <a href="@($"/verify/{Signature.VerificationCode}")"
               target="_blank"
               rel="noopener"
               class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-mono font-semibold text-emerald-800 hover:bg-emerald-100">
                <i class="bi bi-patch-check-fill text-emerald-600" aria-hidden="true"></i>
                <span>@Signature.VerificationCode</span>
            </a>
        }
        else
        {
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unsigned</span>
        }
    </div>

    @if (Signature is not null)
    {
        var verifyUrl = $"{Navigation.BaseUri.TrimEnd('/')}/verify/{Signature.VerificationCode}";
        var qrUri = QrCodeSvgHelper.GenerateSvgDataUri(verifyUrl, pixelsPerModule: 3);
        <div class="flex items-center justify-between gap-3">
            <div class="flex flex-col items-start gap-1 min-w-0">
                <img src="@Signature.SignatureImageDataUrl" alt="@($"Signature of {Signature.SignerName}")" class="h-12 max-w-[11rem] object-contain" />
                <div class="font-semibold text-slate-900">@Signature.SignerName</div>
                @if (!string.IsNullOrWhiteSpace(Signature.SignerPosition))
                {
                    <div class="text-[11px] text-slate-600">@Signature.SignerPosition</div>
                }
                <div class="text-[10px] text-slate-500">Signed @Signature.SignedAtUtc.AddHours(5).ToString("dd MMM yyyy, HH:mm") MVT</div>
            </div>
            <a href="@($"/verify/{Signature.VerificationCode}")" target="_blank" rel="noopener" title="Scan to verify signature" class="shrink-0 rounded border border-slate-200 bg-white p-1">
                <img src="@qrUri" alt="@($"QR Code {Signature.VerificationCode}")" class="w-14 h-14 block" />
            </a>
        </div>

        @if (AllowSigning && Signature.CanRevoke)
        {
            <div class="pt-1 print:hidden">
                @if (revoking)
                {
                    <div class="flex flex-wrap items-center gap-1.5">
                        <input class="flex-1 min-w-[10rem] rounded-lg border border-slate-300 px-2 py-1 text-[11px]"
                               placeholder="Reason for revoking..."
                               @bind="revokeReason"
                               @bind:event="oninput" />
                        <button type="button"
                                class="rounded-lg bg-rose-600 px-2.5 py-1 text-[11px] font-semibold text-white hover:bg-rose-700 disabled:opacity-50"
                                disabled="@(busy || string.IsNullOrWhiteSpace(revokeReason))"
                                @onclick="ConfirmRevokeAsync">
                            Confirm
                        </button>
                        <button type="button"
                                class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-[11px] font-semibold text-slate-700"
                                @onclick="() => { revoking = false; revokeReason = string.Empty; }">
                            Cancel
                        </button>
                    </div>
                }
                else
                {
                    <button type="button"
                            class="text-[11px] font-semibold text-rose-600 hover:underline"
                            @onclick="() => revoking = true">
                        Revoke Signature
                    </button>
                }
            </div>
        }
    }
    else if (AllowSigning)
    {
        <div class="pt-1 print:hidden flex flex-wrap items-center gap-2">
            <button type="button"
                    style="background-color:#075985; color:#ffffff;"
                    class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold shadow-xs hover:opacity-90 disabled:opacity-50"
                    disabled="@busy"
                    @onclick="() => showPinModal = true">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                <span>Sign as @SlotLabel</span>
            </button>
            <a href="/profile" class="text-[11px] font-semibold text-slate-500 hover:text-blue-700 hover:underline">Manage signature &amp; PIN</a>
        </div>
    }

    <SignaturePinModal IsOpen="showPinModal"
                       SlotLabel="@SlotLabel"
                       OnConfirmed="SignWithPinAsync"
                       OnCancelled="() => showPinModal = false" />

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-2.5 py-1.5 print:hidden">@feedback</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string DocumentType { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DocumentId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SlotKey { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SlotLabel { get; set; } = string.Empty;
    [Parameter] public string DocumentContentSnapshot { get; set; } = string.Empty;
    [Parameter] public DocumentSignatureDto? Signature { get; set; }
    [Parameter] public bool AllowSigning { get; set; } = true;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool busy, revoking, showPinModal;
    private string revokeReason = "";
    private string? feedback;

    private async Task SignWithPinAsync(string verifiedPin)
    {
        showPinModal = false;
        if (busy) return;
        busy = true;
        feedback = null;
        try
        {
            var res = await SignatureApi.SignDocumentAsync(new SignDocumentInput(
                DocumentType,
                DocumentId,
                SlotKey,
                SlotLabel,
                DocumentContentSnapshot,
                Pin: verifiedPin));
            if (!res.Success)
                feedback = res.Message;
            else
                await OnChanged.InvokeAsync();
        }
        catch
        {
            feedback = "Signing failed. Check your session, saved profile signature, and Signing PIN.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmRevokeAsync()
    {
        if (busy || Signature is null || string.IsNullOrWhiteSpace(revokeReason)) return;
        busy = true;
        feedback = null;
        try
        {
            var res = await SignatureApi.RevokeSignatureAsync(Signature.Id, revokeReason.Trim());
            if (!res.Success)
                feedback = res.Message;
            else
            {
                revoking = false;
                revokeReason = "";
                await OnChanged.InvokeAsync();
            }
        }
        catch
        {
            feedback = "Could not revoke signature.";
        }
        finally
        {
            busy = false;
        }
    }
}
