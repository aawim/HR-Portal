@using HRM.ActivityLogs.Models
@using HRM.UI.Services.Activity
@inject IActivityLogApiClient ActivityApi

<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <div>
            <h3 class="text-sm font-semibold text-slate-900">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="text-xs text-slate-500">@Subtitle</p>
            }
        </div>
        <button type="button"
                @onclick="LoadAsync"
                disabled="@loading"
                class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50">
            <i class="bi bi-arrow-clockwise"></i>
            Refresh
        </button>
    </div>

    @if (loading)
    {
        <div class="p-6 text-center text-xs text-slate-500">Loading recent activity...</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="p-4 text-xs text-rose-600">@errorMessage</div>
    }
    else if (items.Count == 0)
    {
        <div class="p-6 text-center text-xs text-slate-500">No recent activity recorded.</div>
    }
    else
    {
        <ul class="divide-y divide-slate-100">
            @foreach (var item in items)
            {
                <li class="px-4 py-3 hover:bg-slate-50 transition-colors">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-1.5">
                                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-[11px] font-medium text-indigo-700">
                                    @item.ActivityCategory
                                </span>
                                <span class="text-xs font-medium text-slate-900">@item.Module</span>
                                <span class="text-xs text-slate-400">·</span>
                                <span class="text-xs text-slate-600">@(!string.IsNullOrWhiteSpace(item.UserName) ? item.UserName : (item.UserId.HasValue ? $"User #{item.UserId}" : "System"))</span>
                                @if (!string.IsNullOrWhiteSpace(item.IpAddress))
                                {
                                    <span class="text-xs text-slate-400">·</span>
                                    <span class="font-mono text-[11px] text-slate-500">@item.IpAddress</span>
                                }
                            </div>
                            <p class="mt-1 text-xs text-slate-700">@item.Description</p>
                            @if (!string.IsNullOrWhiteSpace(item.TargetDisplayName))
                            {
                                <p class="mt-0.5 text-[11px] text-slate-500">Target: @item.TargetDisplayName</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <p class="mt-0.5 truncate font-mono text-[11px] text-slate-500" title="@item.Url">URL: @item.Url</p>
                            }
                        </div>
                        <time class="shrink-0 font-mono text-[11px] text-slate-400">
                            @item.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")
                        </time>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Recent Activity";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Mode { get; set; } = "My"; // My | Employee | Team | Organisation | Entity
    [Parameter] public int? UserId { get; set; }
    [Parameter] public int? TeamId { get; set; }
    [Parameter] public int? OrganisationId { get; set; }
    [Parameter] public string? EntityType { get; set; }
    [Parameter] public string? EntityId { get; set; }
    [Parameter] public int PageSize { get; set; } = 15;

    private bool loading;
    private string? errorMessage;
    private IReadOnlyList<ActivityLogDto> items = [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            items = Mode switch
            {
                "Employee" when UserId.HasValue =>
                    (await ActivityApi.GetEmployeeTimelineAsync(UserId.Value, 1, PageSize)).Items,
                "Team" when TeamId.HasValue =>
                    (await ActivityApi.GetTeamActivitiesAsync(TeamId.Value, 1, PageSize)).Items,
                "Organisation" when OrganisationId.HasValue =>
                    (await ActivityApi.GetOrganisationActivitiesAsync(OrganisationId.Value, 1, PageSize)).Items,
                "Entity" when !string.IsNullOrWhiteSpace(EntityType) && !string.IsNullOrWhiteSpace(EntityId) =>
                    (await ActivityApi.GetEntityActivitiesAsync(EntityType, EntityId, 1, PageSize)).Items,
                _ => (await ActivityApi.GetMyRecentAsync(1, PageSize)).Items
            };
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            errorMessage = "Activity feed is restricted for your current role.";
            items = [];
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load activity feed: {ex.Message}";
            items = [];
        }
        finally
        {
            loading = false;
        }
    }
}
