@using Microsoft.AspNetCore.Components.Authorization
@inject HRM.Services.Interfaces.IUserAccessService UserAccess
@inject ILogger<Topbar> Logger
<header class="h-16 bg-white shadow-sm flex items-center justify-between px-6 relative z-50">
    <button type="button" class="mobile-menu-button" @onclick="OnMobileMenu" aria-label="Open navigation menu" aria-controls="portal-sidebar" title="Open navigation menu">
        <AppIcon Name="menu" />
    </button>


    <!-- LEFT SIDE: Search Bar -->
    <AuthorizeView>
        <Authorized>
            <div class="flex-1 max-w-md hidden sm:block">
                <div class="relative">
                    @* <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <AppIcon Name="search" Class="w-5 h-5 text-xl" />
                    </span> *@
                    @* <input type="text" class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-slate-50" placeholder="Search employees, documents..." /> *@
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="flex-1"></div>
        </NotAuthorized>
    </AuthorizeView>

    <!-- RIGHT SIDE: Actions & Auth -->
    <div class="topbar-actions flex items-center gap-4 pl-4 sm:w-auto justify-end">
        <div class="text-sm text-slate-500 hidden lg:block">
            @DateTime.Now.ToString("dddd, yyyy-MM-dd h:mm tt")
        </div>

        <AuthorizeView>
            <Authorized>
                <ThemeToggle />
                @if (HasSystemAccess)
                {
                <NotificationBell />

                <!-- Profile Dropdown Container -->
                <div class="relative border-l border-slate-200 pl-4 ml-2">

                    <!-- Trigger Button -->
                    <button type="button" @onclick="ToggleProfileMenu" aria-label="Employee menu" aria-expanded="@isProfileMenuOpen.ToString().ToLowerInvariant()" aria-controls="employee-menu" class="flex items-center gap-3 focus:outline-none hover:bg-slate-50 p-1 pr-2 rounded-lg transition-colors relative z-50">
                        @if (!string.IsNullOrWhiteSpace(userPhotoUrl))
                        {
                            <img src="@userPhotoUrl" alt="Profile" class="w-9 h-9 rounded-full border-2 border-blue-100 object-cover" />
                        }
                        else
                        {
                            <div class="w-9 h-9 rounded-full border-2 border-blue-100 bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm select-none">
                                @UserInitial
                            </div>
                        }
                        <div class="hidden md:block text-left">
                            <p class="max-w-[16rem] truncate text-sm font-semibold text-slate-700" title="@UserName">Hello, @UserName!</p>
                            <p class="max-w-[16rem] truncate text-xs text-slate-500" title="@UserGroupLabel">@UserGroupLabel</p>
                        </div>
                        <AppIcon Name="chevron_down" Class="w-4 h-4 text-base text-slate-400 hidden md:block" />
                    </button>

                    <!-- Dropdown Menu -->
                    @if (isProfileMenuOpen)
                    {
                        <!-- Invisible Backdrop to catch clicks -->
                        <div class="fixed inset-0 z-40 cursor-default" @onclick="CloseProfileMenu"></div>

                        <!-- Menu Box -->
                        @* <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-slate-100 py-1 z-50 relative"> *@
                        <div id="employee-menu" class="absolute right-0 top-full mt-2 w-48 bg-white rounded-lg shadow-lg border border-slate-100 py-1 z-50">
                            <div class="border-b border-slate-100 px-4 py-2 md:hidden"><p class="break-words text-sm font-semibold text-slate-700">@UserName</p><p class="mt-1 break-words text-xs text-slate-500">@UserGroupLabel</p></div>
                            <a href="/profile" @onclick="CloseProfileMenu" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition-colors">
                                <AppIcon Name="person" Class="w-4 h-4 text-base" />
                                My Profile
                            </a>
                            <a href="/online/chat" @onclick="CloseProfileMenu" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50"><AppIcon Name="chat" Class="h-4 w-4 text-base" />Chat</a>
                            <details class="px-4 py-2 text-sm text-slate-700">
                                <summary class="cursor-pointer font-medium">Settings</summary>
                                <div class="pt-3"><FontSizeSetting /></div>
                            </details>

                            <div class="border-t border-slate-100 my-1"></div>

                            <LogoutButton Class="w-full flex items-center gap-2 px-4 py-2 text-sm text-rose-600 hover:bg-rose-50 transition-colors text-left">
                                    <AppIcon Name="logout" Class="w-4 h-4 text-base" />
                                    Log Out
                            </LogoutButton>
                        </div>
                    }
                </div>
                }
                else
                {
                    <a href="/Online/Auth/NoAccessLogout" class="text-sm underline">Sign out</a>
                }
            </Authorized>

            <NotAuthorized>
                <a href="/Online/Auth/login" class="text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg shadow-sm transition-colors">Log In</a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</header>

@code {
    [Parameter] public bool HasSystemAccess { get; set; }
    [Parameter] public EventCallback OnMobileMenu { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string UserName = "";
    private List<string> userGroups = [];
    private string UserGroupLabel => userGroups.Count == 0 ? "Employee" : string.Join(" · ", userGroups);
    private (string Username, bool Access)? loadedIdentity;
    private int groupLoadVersion;
    private bool isProfileMenuOpen = false;
    private string? userPhotoUrl;
    private string UserInitial => !string.IsNullOrWhiteSpace(UserName) ? UserName.Trim().Substring(0, 1).ToUpperInvariant() : "U";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            var username = user.Identity?.IsAuthenticated == true ? user.FindFirst("idnumber")?.Value ?? "" : "";
            UserName = user.Identity?.IsAuthenticated == true ? user.FindFirst("full_name")?.Value ?? user.Identity.Name ?? "User" : "";
            var identity = (username, HasSystemAccess);
            if (loadedIdentity == identity) return;
            loadedIdentity = identity;
            var version = ++groupLoadVersion;
            userGroups = [];
            if (HasSystemAccess && !string.IsNullOrWhiteSpace(username))
            {
                try
                {
                    var context = await UserAccess.GetContextAsync();
                    var groups = context?.UserGroups.Select(g => g.GroupName).Distinct().OrderBy(g => g).ToList() ?? [];
                    if (version == groupLoadVersion)
                    {
                        userGroups = groups;
                        userPhotoUrl = context?.ImageUrl;
                    }
                }
                catch (Exception ex) { Logger.LogWarning(ex, "Could not load current user's group labels"); }
            }
        }
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    private void CloseProfileMenu()
    {
        isProfileMenuOpen = false;
    }
}
