@page "/online/supervisor-requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HRM.Services.Contracts.SupervisorChangeRequestServiceContracts.IOperations Requests
@inject HRM.Services.ToastService Toasts
@inject ILogger<SupervisorChangeRequests> Logger
<section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
    <header class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
            <h2 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
                @(PendingOnly ? "Pending supervisor requests" : "Supervisor change requests")
            </h2>
            <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                @rows.Count
            </span>
        </div>
        <button type="button"
                class="app-button app-button-secondary app-button-sm"
                disabled="@busy"
                @onclick="Load">
            <AppIcon Name="refresh" Class="@(busy ? "animate-spin text-xs" : "text-xs")" />
            <span>Refresh</span>
        </button>
    </header>

    <div class="p-3.5 space-y-3">
        @if (error != null)
        {
            <div role="alert" class="rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 px-3 py-2 text-xs text-rose-800 dark:text-rose-200">
                @error
            </div>
        }

        @foreach (var row in rows)
        {
            <article class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/40 p-3 space-y-2 text-xs" @key="row.Id">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-1.5 min-w-0">
                        <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:text-slate-300">@row.Reference</span>
                        <h3 class="text-xs font-semibold text-slate-900 dark:text-slate-100">@row.Change</h3>
                    </div>
                    <span class="inline-flex items-center rounded-full border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/50 px-2 py-0.5 text-[10px] font-semibold text-teal-800 dark:text-teal-300">
                        @row.Status @(!string.IsNullOrEmpty(row.Stage) ? $"· {row.Stage}" : "")
                    </span>
                </div>

                <p class="text-xs font-medium text-slate-700 dark:text-slate-200">
                    @row.Person <span class="text-slate-400 mx-1">·</span> @row.Target
                </p>

                @if (!string.IsNullOrWhiteSpace(row.Reason))
                {
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">@row.Reason</p>
                }

                @if (row.CanApprove || row.CanCancel)
                {
                    <div class="rounded-lg border border-slate-200/80 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/60 p-2.5 space-y-2.5 mt-2">
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                            Action comment
                            <textarea class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-2 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none"
                                      rows="2" maxlength="2000" @bind="comments[row.Id]"></textarea>
                        </label>
                        <div class="flex flex-wrap items-center gap-2">
                            @if (row.CanApprove)
                            {
                                <button type="button"
                                        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                                        disabled="@busy"
                                        @onclick='() => Act(row, "Approve")'>
                                    Approve stage
                                </button>
                                <button type="button"
                                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 hover:bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 dark:text-rose-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                                        disabled="@busy"
                                        @onclick='() => Act(row, "Reject")'>
                                    Reject
                                </button>
                            }
                            @if (row.CanCancel)
                            {
                                <button type="button"
                                        class="app-button app-button-secondary app-button-sm"
                                        disabled="@busy"
                                        @onclick='() => Act(row, "Cancel")'>
                                    Cancel request
                                </button>
                            }
                        </div>
                    </div>
                }
            </article>
        }

        @if (!busy && rows.Count == 0 && error == null)
        {
            <div class="rounded-lg border border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 p-5 text-center text-xs text-slate-500 dark:text-slate-400">
                No supervisor change requests found.
            </div>
        }
    </div>
</section>
@code {
    [Parameter] public int? OrganisationId {get;set;}
    [Parameter] public bool PendingOnly {get;set;}
    [Parameter] public int RefreshVersion {get;set;}
    [Parameter] public EventCallback OnChanged {get;set;}
    private int? loadedOrg;private int loadedVersion=-1;private bool busy;private string? error;
    private List<HRM.Services.SupervisorRequestRow> rows=[];private Dictionary<int,string?> comments=[];
    protected override async Task OnParametersSetAsync(){if(loadedVersion!=RefreshVersion||loadedOrg!=OrganisationId){loadedVersion=RefreshVersion;loadedOrg=OrganisationId;await Load();}}
    private async Task Load(){busy=true;error=null;try{rows=await Requests.LoadAsync(OrganisationId,PendingOnly);foreach(var row in rows)comments.TryAdd(row.Id,null);}catch(Exception ex){Fail(ex);}finally{busy=false;}}
    private async Task Act(HRM.Services.SupervisorRequestRow row,string action){if(busy)return;busy=true;error=null;var saved=false;try{var result=await Requests.ActAsync(row.Id,row.StateId,action,comments.GetValueOrDefault(row.Id),OrganisationId);saved=result.Success;if(saved)Toasts.Success(result.Message);else error=result.Message;}catch(Exception ex){Fail(ex);}finally{busy=false;}if(saved){await Load();await OnChanged.InvokeAsync();}}
    private void Fail(Exception ex){Logger.LogError(ex,"Supervisor request processing");error=ex is UnauthorizedAccessException or InvalidOperationException?ex.Message:"Supervisor requests could not be loaded or saved. Refresh or contact HR.";}
}
