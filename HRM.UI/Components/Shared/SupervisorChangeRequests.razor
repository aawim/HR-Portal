@page "/online/supervisor-requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HRM.Services.Contracts.SupervisorChangeRequestServiceContracts.IOperations Requests
@inject HRM.Services.ToastService Toasts
@inject ILogger<SupervisorChangeRequests> Logger
<section class="space-y-3 rounded-xl border p-4">
    <header class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-semibold">@(PendingOnly?"Pending supervisor requests":"Supervisor change requests")</h2><button class="app-button app-button-secondary" disabled="@busy" @onclick="Load">Refresh</button></header>
    @if(error!=null){<p role="alert" class="rounded border p-3 text-sm">@error</p>}
    @foreach(var row in rows)
    {
        <article class="space-y-2 border-t pt-3 text-sm" @key="row.Id"><h3 class="font-semibold">@row.Reference · @row.Change</h3><p>@row.Person · @row.Target</p><p>@row.Status @(!string.IsNullOrEmpty(row.Stage)?$"· {row.Stage}":"")</p><p>@row.Reason</p>
        @if(row.CanApprove||row.CanCancel){<label class="block">Action comment<textarea class="mt-1 w-full rounded border bg-transparent p-2" rows="2" maxlength="2000" @bind="comments[row.Id]"></textarea></label><div class="flex flex-wrap gap-3">@if(row.CanApprove){<button class="app-button app-button-primary" disabled="@busy" @onclick='()=>Act(row,"Approve")'>Approve stage</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>Act(row,"Reject")'>Reject</button>}@if(row.CanCancel){<button class="app-button app-button-secondary" disabled="@busy" @onclick='()=>Act(row,"Cancel")'>Cancel request</button>}</div>}
        </article>
    }
    @if(!busy&&rows.Count==0&&error==null){<p class="text-sm text-slate-500">No supervisor change requests found.</p>}
</section>
@code {
    [Parameter] public int? OrganisationId {get;set;}
    [Parameter] public bool PendingOnly {get;set;}
    [Parameter] public int RefreshVersion {get;set;}
    [Parameter] public EventCallback OnChanged {get;set;}
    private int? loadedOrg;private int loadedVersion=-1;private bool busy;private string? error;
    private List<HRM.Services.SupervisorRequestRow> rows=[];private Dictionary<int,string?> comments=[];
    protected override async Task OnParametersSetAsync(){if(loadedVersion!=RefreshVersion||loadedOrg!=OrganisationId){loadedVersion=RefreshVersion;loadedOrg=OrganisationId;await Load();}}
    private async Task Load(){busy=true;error=null;try{rows=await Requests.LoadAsync(OrganisationId,PendingOnly);foreach(var row in rows)comments.TryAdd(row.Id,null);}catch(Exception ex){Fail(ex);}finally{busy=false;}}
    private async Task Act(HRM.Services.SupervisorRequestRow row,string action){if(busy)return;busy=true;error=null;var saved=false;try{var result=await Requests.ActAsync(row.Id,row.StateId,action,comments.GetValueOrDefault(row.Id),OrganisationId);saved=result.Success;if(saved)Toasts.Success(result.Message);else error=result.Message;}catch(Exception ex){Fail(ex);}finally{busy=false;}if(saved){await Load();await OnChanged.InvokeAsync();}}
    private void Fail(Exception ex){Logger.LogError(ex,"Supervisor request processing");error=ex is UnauthorizedAccessException or InvalidOperationException?ex.Message:"Supervisor requests could not be loaded or saved. Refresh or contact HR.";}
}
