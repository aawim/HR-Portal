@using HRM.DTOs.Attendance
@inject HRM.Services.Contracts.WeeklyWorkingHoursServiceContracts.IOperations WorkingHours
@inject ILogger<WeeklyHoursReview> Logger

<section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-slate-900 dark:text-slate-100">
    <header class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex flex-wrap items-center gap-2 min-w-0">
            <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Weekly Hours Reconciliation</h3>
            @if (result != null)
            {
                <span class="inline-flex items-center rounded-full border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/50 px-2 py-0.5 text-[10px] font-semibold text-teal-800 dark:text-teal-300">
                    @result.WeekStart.ToString("dd MMM") – @result.WeekEnd.ToString("dd MMM yyyy")
                </span>
            }
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <label class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                <span>Week</span>
                <InputDate @bind-Value="week" class="h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
            </label>
            <button type="button"
                    class="app-button app-button-primary app-button-sm"
                    disabled="@busy"
                    @onclick="LoadAsync">
                Show week
            </button>
            @if (result != null)
            {
                <HRM.Components.Shared.AttendanceExportButtons CreateReport="BuildExport" Disabled="@busy" />
            }
        </div>
    </header>

    <div class="p-3.5 space-y-3">
        @if (error != null)
        {
            <div role="alert" class="rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 px-3 py-2 text-xs text-rose-800 dark:text-rose-200">
                @error
            </div>
        }

        @if (busy)
        {
            <div role="status" class="flex items-center gap-2 py-2 text-xs text-slate-500 dark:text-slate-400">
                <span class="h-3.5 w-3.5 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
                <span>Loading weekly hours…</span>
            </div>
        }
        else if (result != null)
        {
            @if (!result.HasWorkingHoursRule)
            {
                <div role="status" class="rounded-lg border border-amber-200 dark:border-amber-800 bg-amber-50/80 dark:bg-amber-950/40 px-3 py-2 text-xs text-amber-800 dark:text-amber-200">
                    @result.ConfigurationMessage
                </div>
            }

            <dl class="whr-kpi-grid">
                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 px-3 py-2">
                    <dt class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                        <span>Required</span>
                    </dt>
                    <dd class="mt-0.5 text-base font-bold text-slate-900 dark:text-slate-100 tabular-nums">@(result.HasWorkingHoursRule ? Hours(result.RequiredWeekHours) : "Not configured")</dd>
                </div>
                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 px-3 py-2">
                    <dt class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                        <span>Worked</span>
                    </dt>
                    <dd class="mt-0.5 text-base font-bold text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.CurrentWeekHours)</dd>
                </div>
                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 px-3 py-2">
                    <dt class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                        <span>Remaining</span>
                    </dt>
                    <dd class="mt-0.5 text-base font-bold text-slate-900 dark:text-slate-100 tabular-nums">@(result.HasWorkingHoursRule ? Hours(result.RemainingWeekHours) : "—")</dd>
                </div>
                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 px-3 py-2">
                    <dt class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                        <span>Potential overtime</span>
                    </dt>
                    <dd class="mt-0.5 text-base font-bold text-slate-900 dark:text-slate-100 tabular-nums">@(result.HasWorkingHoursRule ? Hours(result.PotentialOvertimeHours) : "—")</dd>
                </div>
            </dl>

            <div class="rounded-lg border border-slate-200/80 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-3 py-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-600 dark:text-slate-300">
                <span>Official: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.OfficialHours)</strong></span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>Duty: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.DutyHours)</strong></span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>Overlap: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.DutyOverlapHours)</strong></span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>Org waived: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.AmendmentCreditHours)</strong></span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>Leave credit: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.LeaveCreditHours)</strong></span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>Duty counts toward week: <strong class="text-slate-900 dark:text-slate-100">@(result.DutyCountsTowardWeek ? "Yes" : "No")</strong></span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>Extra duty outside official: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@Hours(result.DutyOutsideOfficialHours)</strong></span>
            </div>

            @if (result.ApprovedEarlyCheckoutShortfallHours > 0)
            {
                <div class="rounded-lg border border-amber-200 dark:border-amber-800 bg-amber-50/70 dark:bg-amber-950/30 px-3 py-2 text-xs text-amber-900 dark:text-amber-200">
                    Early check-out make-up: <strong>@Hours(result.ApprovedEarlyCheckoutShortfallHours)</strong> owed · <strong>@Hours(result.MakeupCompletedHours)</strong> completed · <strong>@Hours(result.MakeupRemainingHours)</strong> remaining.
                </div>
            }

            @if (result.ApprovedExceptionHours > 0)
            {
                <div class="rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50/70 dark:bg-blue-950/30 px-3 py-2 text-xs text-blue-900 dark:text-blue-200">
                    Approved exceptions: <strong>@Hours(result.ApprovedExceptionHours)</strong> · applied to shortfall: <strong>@Hours(result.ExceptionCreditHours)</strong>.
                </div>
            }

            <p class="text-[11px] text-slate-500 dark:text-slate-400">
                Only completed clock pairs count as worked time. Overlapping periods count once. Early check-out still requires make-up within the same week. An organisation amendment waives time and keeps the original end time.
            </p>
        }
    </div>
</section>

<style>
    .whr-kpi-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.625rem;
    }

    @@media (min-width: 768px) {
        .whr-kpi-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
</style>

@code {
    [Parameter] public int StaffId { get; set; }
    private int loadedStaff = -1;
    private DateTime week = DateTime.UtcNow.AddHours(5).Date;
    private WeeklyWorkedHoursDto? result;
    private bool busy;
    private int version;
    private string? error;
    private HRM.Services.AttendanceExportReport BuildExport()
    {
        var r = result ?? throw new InvalidOperationException("Load a week before exporting.");
        return new("Weekly hours reconciliation", $"Employee {StaffId} · {r.WeekStart:dd MMM yyyy} – {r.WeekEnd:dd MMM yyyy}",
            [new("Weekly hours", ["Metric", "Hours"], new List<object?[]> {
                new object?[] { "Required", r.HasWorkingHoursRule ? r.RequiredWeekHours : null },
                new object?[] { "Worked", r.CurrentWeekHours }, new object?[] { "Remaining", r.HasWorkingHoursRule ? r.RemainingWeekHours : null },
                new object?[] { "Official", r.OfficialHours }, new object?[] { "Duty", r.DutyHours }, new object?[] { "Overlap", r.DutyOverlapHours },
                new object?[] { "Additional duty outside official hours", r.DutyOutsideOfficialHours },
                new object?[] { "Organisation waiver", r.AmendmentCreditHours }, new object?[] { "Approved leave credit", r.LeaveCreditHours },
                new object?[] { "Approved exception credit", r.ExceptionCreditHours }, new object?[] { "Early checkout make-up remaining", r.MakeupRemainingHours },
                new object?[] { "Potential overtime", r.HasWorkingHoursRule ? r.PotentialOvertimeHours : null }
            })]);
    }
    protected override async Task OnParametersSetAsync() { if (loadedStaff != StaffId) { loadedStaff = StaffId; await LoadAsync(); } }
    private async Task LoadAsync() { var request = ++version; var staff = StaffId; busy = true; error = null; result = null; try { var value = await WorkingHours.LoadAsync(staff, week); if (request == version) result = value; } catch (Exception ex) { Logger.LogError(ex, "Weekly hours review failed"); if (request == version) error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Weekly hours could not be loaded. Please refresh and try again."; } finally { if (request == version) busy = false; } }
    private static string Hours(decimal value) { var minutes = (int)Math.Round(value * 60); return $"{minutes / 60}h {minutes % 60}m"; }
}
