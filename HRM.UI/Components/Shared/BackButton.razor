<a href="@Url"
   class="inline-flex items-center gap-1.5 text-slate-500 hover:text-slate-800 text-sm font-medium mb-3 transition-colors w-fit">
    <AppIcon Name="arrow_back" Class="w-4 h-4" />
    @(string.IsNullOrWhiteSpace(Text) || Text == "Back" ? "Back to Attendance Hub" : Text)
</a>

@code {
    [Parameter]
    public string Url { get; set; } = "/";

    [Parameter]
    public string Text { get; set; } = "Back";
}
