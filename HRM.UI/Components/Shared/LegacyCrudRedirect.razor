@inject NavigationManager Navigation
<p role="status" class="rounded-xl border p-4 text-sm">Continue to <a href="@Url" class="underline">@Label</a>.</p>
@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "/";
    [Parameter] public string Label { get; set; } = "the current editor";
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) Navigation.NavigateTo(Url, replace: true);
        return Task.CompletedTask;
    }
}
