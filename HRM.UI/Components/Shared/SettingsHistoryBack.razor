@implements IDisposable
@inject NavigationManager Navigation

@if (IsSettings && trail?.Previous != null)
{
    <a class="inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors mb-3" href="@trail.Previous" aria-label="Back to previous location">
        <AppIcon Name="arrow_back" /> Back
    </a>
}

@code {
    private HRM.Helpers.NavigationTrail? trail;
    private bool IsSettings
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            if (path.Equals("/admin/settings/positions", StringComparison.OrdinalIgnoreCase) ||
                path.StartsWith("/admin/settings/positions/", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            return path.Equals("/admin/settings", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("/admin/settings/", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        trail = new(Navigation.Uri);
        Navigation.LocationChanged += LocationChanged;
    }

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        trail?.Visit(args.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
