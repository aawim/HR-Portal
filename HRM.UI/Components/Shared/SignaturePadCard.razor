@using HRM.Application.Contracts.Signatures
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HRM.UI.Services.Signatures.IDocumentSignatureApiClient SignatureApi
@inject IJSRuntime JS

<div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
        <div>
            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                <i class="bi bi-pen text-blue-600" aria-hidden="true"></i>
                <span>My Digital Signature</span>
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">Save your handwritten signature once to sign official HRM documents (A2 sheets, screening sheets, leave notes, etc.) with one click.</p>
        </div>
        @if (saved is not null)
        {
            <div class="flex items-center gap-1.5">
                <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-800">Saved</span>
                <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(saved.HasPin ? "bg-blue-100 text-blue-800" : "bg-amber-100 text-amber-800")">
                    @(saved.HasPin ? "PIN Protected" : "PIN Required")
                </span>
            </div>
        }
    </div>

    @if (saved is not null && !editing)
    {
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 flex flex-col items-center gap-3">
            <div class="rounded-lg border border-slate-200 bg-white px-6 py-3 flex items-center justify-center min-h-[5.5rem] w-full max-w-md">
                <img src="@saved.SignatureDataUrl" alt="My Saved Signature" class="max-h-20 max-w-full object-contain" />
            </div>
            <div class="text-[11px] text-slate-500">
                Last updated: @saved.UpdatedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                        disabled="@busy"
                        @onclick="StartEdit">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                    <span>Update Signature</span>
                </button>
                <button type="button"
                        class="inline-flex items-center gap-1 rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100"
                        disabled="@busy"
                        @onclick="DeleteAsync">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                    <span>Remove</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-3">
            <div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-xs">
                <button type="button"
                        class="rounded-md px-3 py-1 font-semibold transition @(mode == "draw" ? "bg-white text-blue-700 shadow-xs" : "text-slate-600 hover:text-slate-900")"
                        @onclick='() => SwitchMode("draw")'>
                    <i class="bi bi-brush mr-1" aria-hidden="true"></i>Draw Signature
                </button>
                <button type="button"
                        class="rounded-md px-3 py-1 font-semibold transition @(mode == "upload" ? "bg-white text-blue-700 shadow-xs" : "text-slate-600 hover:text-slate-900")"
                        @onclick='() => SwitchMode("upload")'>
                    <i class="bi bi-upload mr-1" aria-hidden="true"></i>Upload Image
                </button>
            </div>

            @if (mode == "draw")
            {
                <div class="space-y-2">
                    <div class="rounded-xl border-2 border-dashed border-slate-300 bg-white overflow-hidden">
                        <canvas id="@canvasId" class="w-full h-40 block cursor-crosshair touch-none"></canvas>
                    </div>
                    <p class="text-[11px] text-slate-500">Sign inside the box above using your mouse, trackpad, or touch screen.</p>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <button type="button"
                                class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                disabled="@busy"
                                @onclick="ClearCanvasAsync">
                            Clear Pad
                        </button>
                        <div class="flex items-center gap-2">
                            @if (saved is not null)
                            {
                                <button type="button"
                                        class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                        disabled="@busy"
                                        @onclick="() => editing = false">
                                    Cancel
                                </button>
                            }
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50"
                                    disabled="@busy"
                                    @onclick="SaveDrawnAsync">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                <span>Save Signature</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 space-y-2">
                        <InputFile OnChange="OnUploadFileSelected" accept=".png,.webp,.jpg,.jpeg" class="block w-full text-xs text-slate-600" />
                        <p class="text-[11px] text-slate-500">Upload a transparent PNG (recommended), WebP, or JPG image up to 300 KB.</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(uploadedDataUrl))
                    {
                        <div class="rounded-lg border border-slate-200 bg-white p-3 flex items-center justify-center">
                            <img src="@uploadedDataUrl" alt="Signature preview" class="max-h-20 max-w-full object-contain" />
                        </div>
                    }
                    <div class="flex justify-end gap-2">
                        @if (saved is not null)
                        {
                            <button type="button"
                                    class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                    disabled="@busy"
                                    @onclick="() => editing = false">
                                Cancel
                            </button>
                        }
                        <button type="button"
                                class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50"
                                disabled="@(busy || string.IsNullOrWhiteSpace(uploadedDataUrl))"
                                @onclick="SaveUploadedAsync">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                            <span>Save Signature</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @if (saved is not null)
    {
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 space-y-2.5 text-xs">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h4 class="font-bold text-slate-800 flex items-center gap-1.5">
                        <i class="bi bi-shield-lock text-[#075985]" aria-hidden="true"></i>
                        <span>Signing PIN Protection</span>
                    </h4>
                    <p class="text-[11px] text-slate-500">Required every time you open the signature panel to sign a document.</p>
                </div>
                <button type="button"
                        class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50"
                        @onclick="() => { showPinForm = !showPinForm; currentPin = newPin = confirmPin = string.Empty; }">
                    @(showPinForm ? "Cancel" : saved.HasPin ? "Change PIN" : "Set Signing PIN")
                </button>
            </div>

            @if (!saved.HasPin && !showPinForm)
            {
                <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-[11px] text-amber-900">
                    Set a 4–8 digit Signing PIN to authorize signing documents with your signature.
                </div>
            }

            @if (showPinForm)
            {
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1">
                    @if (saved.HasPin)
                    {
                        <label class="block font-medium text-slate-700">
                            Current PIN
                            <input type="password" inputmode="numeric" maxlength="8" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 font-mono text-xs" @bind="currentPin" @bind:event="oninput" placeholder="••••" />
                        </label>
                    }
                    <label class="block font-medium text-slate-700">
                        New PIN (4–8 digits)
                        <input type="password" inputmode="numeric" maxlength="8" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 font-mono text-xs" @bind="newPin" @bind:event="oninput" placeholder="••••" />
                    </label>
                    <label class="block font-medium text-slate-700">
                        Confirm PIN
                        <input type="password" inputmode="numeric" maxlength="8" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 font-mono text-xs" @bind="confirmPin" @bind:event="oninput" placeholder="••••" />
                    </label>
                </div>
                <div class="flex justify-end">
                    <button type="button"
                            class="inline-flex items-center gap-1 rounded-lg bg-[#075985] hover:bg-[#0c4a6e] px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50"
                            disabled="@(busy || newPin.Length < 4 || newPin != confirmPin || (saved.HasPin && currentPin.Length < 4))"
                            @onclick="SavePinAsync">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                        <span>Save Signing PIN</span>
                    </button>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div role="status" class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-800">
            <span>@message</span>
            <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
        </div>
    }
</div>

@code {
    private readonly string canvasId = $"sig-pad-{Guid.NewGuid():N}";
    private UserSignatureDto? saved;
    private string mode = "draw";
    private bool editing, busy, canvasNeedsInit, showPinForm;
    private string? uploadedDataUrl, message;
    private string currentPin = "", newPin = "", confirmPin = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            saved = await SignatureApi.GetMySignatureAsync();
            if (saved is null)
            {
                editing = true;
                canvasNeedsInit = true;
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (canvasNeedsInit && editing && mode == "draw")
        {
            canvasNeedsInit = false;
            try { await JS.InvokeVoidAsync("hrmSignaturePad.init", canvasId); } catch { }
        }
    }

    private void StartEdit()
    {
        editing = true;
        mode = "draw";
        uploadedDataUrl = null;
        canvasNeedsInit = true;
    }

    private void SwitchMode(string next)
    {
        mode = next;
        if (next == "draw") canvasNeedsInit = true;
    }

    private async Task ClearCanvasAsync()
    {
        try { await JS.InvokeVoidAsync("hrmSignaturePad.clear", canvasId); } catch { }
    }

    private async Task SaveDrawnAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            var dataUrl = await JS.InvokeAsync<string>("hrmSignaturePad.toDataUrl", canvasId);
            if (string.IsNullOrWhiteSpace(dataUrl))
            {
                message = "Please draw your signature inside the box before saving.";
                return;
            }
            var res = await SignatureApi.SaveMySignatureAsync(dataUrl);
            message = res.Message;
            if (res.Success)
            {
                saved = await SignatureApi.GetMySignatureAsync();
                editing = false;
            }
        }
        catch
        {
            message = "Could not save signature. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnUploadFileSelected(InputFileChangeEventArgs e)
    {
        message = null;
        try
        {
            using var stream = e.File.OpenReadStream(300 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var ct = string.IsNullOrWhiteSpace(e.File.ContentType) ? "image/png" : e.File.ContentType;
            uploadedDataUrl = $"data:{ct};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (IOException)
        {
            message = "Signature image must be 300 KB or smaller.";
            uploadedDataUrl = null;
        }
    }

    private async Task SaveUploadedAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(uploadedDataUrl)) return;
        busy = true;
        message = null;
        try
        {
            var res = await SignatureApi.SaveMySignatureAsync(uploadedDataUrl);
            message = res.Message;
            if (res.Success)
            {
                saved = await SignatureApi.GetMySignatureAsync();
                editing = false;
                uploadedDataUrl = null;
            }
        }
        catch
        {
            message = "Could not save uploaded signature.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SavePinAsync()
    {
        if (busy) return;
        if (newPin.Length is < 4 or > 8 || !newPin.All(char.IsDigit))
        {
            message = "Signing PIN must be 4 to 8 numeric digits.";
            return;
        }
        if (newPin != confirmPin)
        {
            message = "New PIN and Confirm PIN do not match.";
            return;
        }
        busy = true;
        message = null;
        try
        {
            var res = await SignatureApi.SetSignaturePinAsync(newPin, saved?.HasPin == true ? currentPin : null);
            message = res.Message;
            if (res.Success)
            {
                showPinForm = false;
                currentPin = newPin = confirmPin = "";
                saved = await SignatureApi.GetMySignatureAsync();
            }
        }
        catch
        {
            message = "Could not save Signing PIN.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            var res = await SignatureApi.DeleteMySignatureAsync();
            message = res.Message;
            if (res.Success)
            {
                saved = null;
                editing = true;
                mode = "draw";
                canvasNeedsInit = true;
            }
        }
        catch
        {
            message = "Could not remove signature.";
        }
        finally
        {
            busy = false;
        }
    }
}
