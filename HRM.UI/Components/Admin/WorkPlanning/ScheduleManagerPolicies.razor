@using HRM.WorkPlanning.Abstractions
@inject HRM.UI.Services.WorkPlanning.IWorkforceScheduleApiClient ScheduleApi
@inject HRM.Services.PortalContext Portal
@inject HRM.Services.ToastService Toasts

<div class="page-panels page-panels-standard">
    <section class="page-panel-left space-y-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-xs">
        <div><h2 class="font-bold text-slate-800">Duty types and policies</h2><p class="text-xs text-slate-500">Define reusable duty classifications and effective-dated workforce rules.</p></div>
        <div class="grid gap-2 sm:grid-cols-2">
            <label class="text-xs font-medium text-slate-700">Duty code<input class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="dutyCode" /></label>
            <label class="text-xs font-medium text-slate-700">Duty name<input class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="dutyName" /></label>
            <label class="text-xs font-medium text-slate-700">Category<input class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="dutyCategory" /></label>
            <label class="text-xs font-medium text-slate-700">Attendance strategy<input class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="attendanceStrategy" /></label>
        </div>
        <button class="app-button app-button-primary app-button-sm" @onclick="CreateDutyTypeAsync">Add duty type</button>
        <div class="border-t border-slate-200 pt-2"><h3 class="font-semibold text-slate-800">Policy version</h3><div class="mt-2 grid gap-2 sm:grid-cols-2"><label class="text-xs font-medium text-slate-700">Policy code<input class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="policyCode" /></label><label class="text-xs font-medium text-slate-700">Policy name<input class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="policyName" /></label><label class="text-xs font-medium text-slate-700">Effective from<input type="date" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="effectiveFrom" /></label><label class="text-xs font-medium text-slate-700">Effective to<input type="date" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="effectiveTo" /></label></div><label class="mt-2 block text-xs font-medium text-slate-700">Rules JSON<textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 p-2 font-mono text-xs" @bind="rulesJson"></textarea></label><button class="mt-2 app-button app-button-primary app-button-sm" @onclick="CreatePolicyAsync">Add policy version</button></div>
        <div class="border-t border-slate-200 pt-2"><h3 class="font-semibold text-slate-800">Policy assignment</h3><div class="mt-2 grid gap-2 sm:grid-cols-2"><label class="text-xs font-medium text-slate-700">Policy ID<input type="number" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="assignmentPolicyId" /></label><label class="text-xs font-medium text-slate-700">Priority<input type="number" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="priority" /></label><label class="text-xs font-medium text-slate-700">Job ID (optional)<input type="number" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="jobId" /></label><label class="text-xs font-medium text-slate-700">Individual ID (optional)<input type="number" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="individualId" /></label><label class="text-xs font-medium text-slate-700">Duty type ID (optional)<input type="number" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="assignmentDutyTypeId" /></label></div><button class="mt-2 app-button app-button-secondary app-button-sm" @onclick="CreateAssignmentAsync">Assign policy</button></div>
        @if (!string.IsNullOrWhiteSpace(message)){<p class="text-xs text-slate-600">@message</p>}
    </section>
    <aside class="page-panel-right space-y-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-xs"><h2 class="font-bold text-slate-800">Configured rules</h2><div><h3 class="text-xs font-semibold text-slate-600">Duty types</h3>@foreach(var item in dutyTypes){<p class="mt-1 text-xs text-slate-700"><span class="font-semibold">@item.Code</span> — @item.Name</p>}</div><div><h3 class="text-xs font-semibold text-slate-600">Policies</h3>@foreach(var item in policies){<p class="mt-1 text-xs text-slate-700"><span class="font-semibold">@item.Code</span> — @item.Name</p>}</div><div><h3 class="text-xs font-semibold text-slate-600">Assignments</h3>@foreach(var item in assignments){<p class="mt-1 text-xs text-slate-700">@item.PolicyName · priority @item.Priority</p>}</div></aside>
</div>

@code { int organisationId; string dutyCode="",dutyName="",dutyCategory="Standard",attendanceStrategy="CheckInOut",policyCode="",policyName="",rulesJson="{}",message="";DateTime effectiveFrom=DateTime.Today,effectiveTo=DateTime.Today.AddYears(1);int assignmentPolicyId,priority=100;int? jobId,individualId,assignmentDutyTypeId;IReadOnlyList<WorkforceDutyTypeRow> dutyTypes=[];IReadOnlyList<WorkforcePolicyRow> policies=[];IReadOnlyList<WorkforcePolicyAssignmentRow> assignments=[];protected override async Task OnInitializedAsync(){organisationId=Portal.CurrentOrganisationId??0;await ReloadAsync();}async Task ReloadAsync(){dutyTypes=await ScheduleApi.GetDutyTypesAsync();policies=await ScheduleApi.GetPoliciesAsync();assignments=await ScheduleApi.GetPolicyAssignmentsAsync();}async Task CreateDutyTypeAsync(){try{await ScheduleApi.CreateDutyTypeAsync(new(organisationId,dutyCode,dutyName,dutyCategory,attendanceStrategy,null,0));message="Duty type saved.";Toasts.Success(message);await ReloadAsync();}catch(Exception ex){message="Duty type was not saved. "+ex.Message;Toasts.Error(message);}}async Task CreatePolicyAsync(){try{assignmentPolicyId=await ScheduleApi.CreatePolicyAsync(new(organisationId,policyCode,policyName,rulesJson,DateOnly.FromDateTime(effectiveFrom),DateOnly.FromDateTime(effectiveTo),0));message=$"Policy version saved as ID {assignmentPolicyId}.";Toasts.Success(message);await ReloadAsync();}catch(Exception ex){message="Policy version was not saved. "+ex.Message;Toasts.Error(message);}}async Task CreateAssignmentAsync(){try{await ScheduleApi.CreatePolicyAssignmentAsync(new(organisationId,assignmentPolicyId,jobId,individualId,assignmentDutyTypeId,DateOnly.FromDateTime(effectiveFrom),DateOnly.FromDateTime(effectiveTo),priority,0));message="Policy assignment saved.";Toasts.Success(message);await ReloadAsync();}catch(Exception ex){message="Policy assignment was not saved. "+ex.Message;Toasts.Error(message);}}}
