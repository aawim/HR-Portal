@using HRM.WorkPlanning.Abstractions
@inject HRM.UI.Services.WorkPlanning.IWorkforceScheduleApiClient ScheduleApi
@inject HRM.Services.PortalContext Portal
@inject HRM.Services.ToastService Toasts

<div class="grid items-start gap-4 lg:grid-cols-12">
    <section class="lg:col-span-7 space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
        <div>
            <h2 class="text-sm font-bold text-slate-900">Duty Types &amp; Workforce Policies</h2>
            <p class="mt-0.5 text-xs text-slate-500">Define reusable duty classifications, effective-dated policy versions, and policy assignments.</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">1. Duty Type</h3>
            <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-xs font-medium text-slate-700">Duty Code<input class="@InputClass" @bind="dutyCode" /></label>
                <label class="block text-xs font-medium text-slate-700">Duty Name<input class="@InputClass" @bind="dutyName" /></label>
                <label class="block text-xs font-medium text-slate-700">Category<input class="@InputClass" @bind="dutyCategory" /></label>
                <label class="block text-xs font-medium text-slate-700">Attendance Strategy<input class="@InputClass" @bind="attendanceStrategy" /></label>
            </div>
            <div class="flex justify-end">
                <button type="button" class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition-colors" @onclick="CreateDutyTypeAsync">Add Duty Type</button>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">2. Policy Version</h3>
            <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-xs font-medium text-slate-700">Policy Code<input class="@InputClass" @bind="policyCode" /></label>
                <label class="block text-xs font-medium text-slate-700">Policy Name<input class="@InputClass" @bind="policyName" /></label>
                <label class="block text-xs font-medium text-slate-700">Effective From<input type="date" class="@InputClass" @bind="effectiveFrom" /></label>
                <label class="block text-xs font-medium text-slate-700">Effective To<input type="date" class="@InputClass" @bind="effectiveTo" /></label>
            </div>
            <label class="block text-xs font-medium text-slate-700">
                Rules JSON
                <textarea rows="4" class="@InputClass font-mono" @bind="rulesJson"></textarea>
            </label>
            <div class="flex justify-end">
                <button type="button" class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition-colors" @onclick="CreatePolicyAsync">Add Policy Version</button>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">3. Policy Assignment</h3>
            <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-xs font-medium text-slate-700">Policy ID<input type="number" class="@InputClass" @bind="assignmentPolicyId" /></label>
                <label class="block text-xs font-medium text-slate-700">Priority<input type="number" class="@InputClass" @bind="priority" /></label>
                <label class="block text-xs font-medium text-slate-700">Job ID (optional)<input type="number" class="@InputClass" @bind="jobId" /></label>
                <label class="block text-xs font-medium text-slate-700">Individual ID (optional)<input type="number" class="@InputClass" @bind="individualId" /></label>
                <label class="block text-xs font-medium text-slate-700 sm:col-span-2">Duty Type ID (optional)<input type="number" class="@InputClass" @bind="assignmentDutyTypeId" /></label>
            </div>
            <div class="flex justify-end">
                <button type="button" class="rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors" @onclick="CreateAssignmentAsync">Assign Policy</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div role="status" class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800">@message</div>
        }
    </section>

    <aside class="lg:col-span-5 space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
        <h2 class="text-sm font-bold text-slate-900">Configured Rules</h2>

        <div class="space-y-1.5">
            <h3 class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Duty Types (@dutyTypes.Count)</h3>
            @if (dutyTypes.Count == 0)
            {
                <p class="text-xs text-slate-400">No duty types configured.</p>
            }
            else
            {
                @foreach (var item in dutyTypes)
                {
                    <div class="rounded-lg border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs text-slate-700">
                        <span class="font-mono font-semibold text-blue-700">@item.Code</span> — @item.Name
                    </div>
                }
            }
        </div>

        <div class="space-y-1.5 border-t border-slate-100 pt-3">
            <h3 class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Policies (@policies.Count)</h3>
            @if (policies.Count == 0)
            {
                <p class="text-xs text-slate-400">No policies configured.</p>
            }
            else
            {
                @foreach (var item in policies)
                {
                    <div class="rounded-lg border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs text-slate-700">
                        <span class="font-mono font-semibold text-blue-700">@item.Code</span> — @item.Name
                    </div>
                }
            }
        </div>

        <div class="space-y-1.5 border-t border-slate-100 pt-3">
            <h3 class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Assignments (@assignments.Count)</h3>
            @if (assignments.Count == 0)
            {
                <p class="text-xs text-slate-400">No policy assignments configured.</p>
            }
            else
            {
                @foreach (var item in assignments)
                {
                    <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs text-slate-700">
                        <span class="font-medium">@item.PolicyName</span>
                        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-700">Priority @item.Priority</span>
                    </div>
                }
            }
        </div>
    </aside>
</div>

@code {
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500";
    int organisationId;
    string dutyCode = "", dutyName = "", dutyCategory = "Standard", attendanceStrategy = "CheckInOut", policyCode = "", policyName = "", rulesJson = "{}", message = "";
    DateTime effectiveFrom = DateTime.Today, effectiveTo = DateTime.Today.AddYears(1);
    int assignmentPolicyId, priority = 100;
    int? jobId, individualId, assignmentDutyTypeId;
    IReadOnlyList<WorkforceDutyTypeRow> dutyTypes = [];
    IReadOnlyList<WorkforcePolicyRow> policies = [];
    IReadOnlyList<WorkforcePolicyAssignmentRow> assignments = [];

    protected override async Task OnInitializedAsync()
    {
        organisationId = Portal.CurrentOrganisationId ?? 0;
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        dutyTypes = await ScheduleApi.GetDutyTypesAsync();
        policies = await ScheduleApi.GetPoliciesAsync();
        assignments = await ScheduleApi.GetPolicyAssignmentsAsync();
    }

    async Task CreateDutyTypeAsync()
    {
        try
        {
            await ScheduleApi.CreateDutyTypeAsync(new(organisationId, dutyCode, dutyName, dutyCategory, attendanceStrategy, null, 0));
            message = "Duty type saved.";
            Toasts.Success(message);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            message = "Duty type was not saved. " + ex.Message;
            Toasts.Error(message);
        }
    }

    async Task CreatePolicyAsync()
    {
        try
        {
            assignmentPolicyId = await ScheduleApi.CreatePolicyAsync(new(organisationId, policyCode, policyName, rulesJson, DateOnly.FromDateTime(effectiveFrom), DateOnly.FromDateTime(effectiveTo), 0));
            message = $"Policy version saved as ID {assignmentPolicyId}.";
            Toasts.Success(message);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            message = "Policy version was not saved. " + ex.Message;
            Toasts.Error(message);
        }
    }

    async Task CreateAssignmentAsync()
    {
        try
        {
            await ScheduleApi.CreatePolicyAssignmentAsync(new(organisationId, assignmentPolicyId, jobId, individualId, assignmentDutyTypeId, DateOnly.FromDateTime(effectiveFrom), DateOnly.FromDateTime(effectiveTo), priority, 0));
            message = "Policy assignment saved.";
            Toasts.Success(message);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            message = "Policy assignment was not saved. " + ex.Message;
            Toasts.Error(message);
        }
    }
}
