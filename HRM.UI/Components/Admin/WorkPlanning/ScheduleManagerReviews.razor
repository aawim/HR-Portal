@using HRM.WorkPlanning.Abstractions
@inject HRM.UI.Services.WorkPlanning.IWorkforceScheduleApiClient ScheduleApi

<div class="space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><div class="flex items-center justify-between"><div><h2 class="font-bold text-slate-800">Session and ledger review</h2><p class="text-xs text-slate-500">Review evaluated sessions and payroll-finalization state.</p></div><button class="app-button app-button-secondary app-button-sm" @onclick="LoadAsync">Refresh</button></div><div class="overflow-x-auto"><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 text-slate-500"><tr><th class="p-2">Session</th><th class="p-2">Status</th><th class="p-2">Minutes</th><th class="p-2">Evaluated</th></tr></thead><tbody>@foreach(var row in sessions){<tr class="border-b border-slate-100"><td class="p-2">#@row.Id / segment @row.WorkPlanSegmentId</td><td class="p-2">@row.Status</td><td class="p-2">@row.CreditedMinutes</td><td class="p-2">@row.EvaluatedAtUtc.ToLocalTime()</td></tr>}</tbody></table></div><div class="overflow-x-auto"><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 text-slate-500"><tr><th class="p-2">Ledger</th><th class="p-2">Staff</th><th class="p-2">Category</th><th class="p-2">Status</th><th class="p-2">Export</th></tr></thead><tbody>@foreach(var row in ledger){<tr class="border-b border-slate-100"><td class="p-2">#@row.Id</td><td class="p-2">@row.IndividualId / @row.JobId</td><td class="p-2">@row.TimeCategory (@row.CreditedMinutes)</td><td class="p-2">@row.Status</td><td class="p-2">@(row.PayrollExportReference ?? "Not exported")</td></tr>}</tbody></table></div></div>
@code { IReadOnlyList<WorkforceSessionReviewRow> sessions=[];IReadOnlyList<WorkforceLedgerReviewRow> ledger=[];protected override Task OnInitializedAsync()=>LoadAsync();async Task LoadAsync(){sessions=await ScheduleApi.GetSessionsAsync();ledger=await ScheduleApi.GetLedgerAsync();}}
