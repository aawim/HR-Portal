@using HRM.DTOs.WorkPlanning
@using HRM.WorkPlanning.Abstractions
@using HRM.Services
@using HRM.Services.Interfaces
@inject IWorkAssignmentManagementService Assignments
@inject IManualWorkAssignmentLookupService TemplateLookup
@inject IManualWorkAssignmentService ManualAssignments
@inject IUserAccessService UserAccess
@inject ToastService Toasts
@inject ILogger<CreateRoster> Logger

<section class="space-y-4">
    <div>
        <h2 class="text-xl font-semibold">Create a roster</h2>
        <p class="mt-1 text-sm text-slate-500">Create dated duty assignments for several staff members over a date range. Each staff member keeps their own daily plan and clock events. Duty dates still need the staff member's official hours.</p>
    </div>
    @if (error != null) { <p role="alert" class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm">@error</p> }
    @if (loading) { <p class="text-sm text-slate-500">Loading roster options...</p> }
    else
    {
        <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
            <div class="space-y-4 xl:col-span-2">
                <fieldset disabled="@busy" class="space-y-4 rounded-xl border p-4">
                    <h3 class="font-semibold">1. Staff</h3>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <label class="block text-sm">Department
                            <select @bind="departmentId" @bind:after="DepartmentChangedAsync" class="mt-1 block w-full rounded border bg-transparent p-2">
                                <option value="0">Select department</option>
                                @foreach (var department in Departments) { <option value="@department.OrganisationStructureId">@department.DepartmentName</option> }
                            </select>
                        </label>
                        <label class="block text-sm">Search staff
                            <input @bind="staffSearch" @bind:event="oninput" maxlength="150" placeholder="Name or job title" class="mt-1 block w-full rounded border bg-transparent p-2" />
                        </label>
                    </div>
                    @if (departmentId <= 0)
                    {
                        <p class="text-sm text-slate-500">Select a department to load its staff.</p>
                    }
                    else if (Staff.Count == 0)
                    {
                        <p class="text-sm text-slate-500">This department has no active staff with a job.</p>
                    }
                    else
                    {
                        <div class="flex flex-wrap items-center gap-3">
                            <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" checked="@(FilteredStaff.Any() && FilteredStaff.All(x => selectedIds.Contains(x.IndividualId)))" @onchange="e => SelectAllStaff(e.Value is true)" /> Select all staff</label>
                            <span class="text-xs text-slate-500">@selectedIds.Count of @Staff.Count selected</span>
                        </div>
                        <div class="max-h-72 space-y-1 overflow-y-auto rounded border p-2">
                            @foreach (var staff in FilteredStaff)
                            {
                                <label class="flex items-start gap-2 rounded p-1 text-sm">
                                    <input type="checkbox" class="mt-1" checked="@selectedIds.Contains(staff.IndividualId)" @onchange="e => ToggleStaff(staff.IndividualId, e.Value is true)" />
                                    <span>@staff.EmployeeName<div class="text-xs text-slate-500">@staff.JobTitle</div></span>
                                </label>
                            }
                            @if (!FilteredStaff.Any()) { <p class="p-2 text-sm text-slate-500">No staff match the search.</p> }
                        </div>
                    }
                </fieldset>
                <fieldset disabled="@busy" class="space-y-4 rounded-xl border p-4">
                    <h3 class="font-semibold">2. Duty schedule</h3>
                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        <label class="block text-sm">Duty template
                            <select @bind="workTemplateId" class="mt-1 block w-full rounded border bg-transparent p-2">
                                <option value="0">Select template</option>
                                @foreach (var template in Templates) { <option value="@template.WorkTemplateId">@template.TemplateName</option> }
                            </select>
                        </label>
                        <label class="block text-sm">From <InputDate @bind-Value="fromDate" @bind-Value:after="FromDateChangedAsync" class="mt-1 block w-full rounded border bg-transparent p-2" /></label>
                        <label class="block text-sm">To <InputDate @bind-Value="toDate" @bind-Value:after="ToDateChangedAsync" class="mt-1 block w-full rounded border bg-transparent p-2" /></label>
                        <label class="block text-sm">Assignment title
                            <input @bind="assignmentTitle" maxlength="250" class="mt-1 block w-full rounded border bg-transparent p-2" />
                        </label>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            var bit = 1 << (int)day;
                            <label class="inline-flex items-center gap-1 text-sm"><input type="checkbox" checked="@((weekdayMask & bit) != 0)" @onchange="e => ToggleDay(bit, e.Value is true)" /> @day</label>
                        }
                    </div>
                    @if (Templates.Count == 0) { <p class="text-xs text-slate-500">No active template covers the selected date in this organisation. Check Templates or Schedule assignments first.</p> }
                    <p class="text-xs text-slate-500">Only the selected weekdays inside the date range are created. Existing duties for the same staff, day and template are kept and reported as skipped.</p>
                </fieldset>
                <fieldset disabled="@busy" class="space-y-4 rounded-xl border p-4">
                    <h3 class="font-semibold">3. Options</h3>
                    <div class="flex flex-wrap gap-4">
                        <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" checked="@requiresAttendance" @onchange="e => requiresAttendance = e.Value is true" /> Requires check in</label>
                        <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" checked="@requiresCheckout" @onchange="e => requiresCheckout = e.Value is true" /> Requires check out</label>
                    </div>
                    <label class="block text-sm">Remarks
                        <textarea @bind="remarks" maxlength="500" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea>
                    </label>
                </fieldset>
            </div>
            <div class="xl:col-span-1">
                <div class="space-y-3 rounded-xl border p-4 xl:sticky xl:top-6">
                    <h3 class="font-semibold">Preview</h3>
                    <p class="text-sm">@selectedIds.Count staff × @DayCount day(s) = <strong>@TotalAssignments</strong> assignment(s)</p>
                    <p class="text-xs text-slate-500">@fromDate.ToString("dd MMM yyyy") – @toDate.ToString("dd MMM yyyy")</p>
                    @if (busy)
                    {
                        <div class="space-y-1" role="status">
                            <p class="text-sm">Creating @processed of @total...</p>
                            <div class="h-2 overflow-hidden rounded bg-slate-200"><div class="h-full bg-slate-700" style="@($"width:{ProgressPercent}%")"></div></div>
                        </div>
                    }
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="app-button app-button-primary" disabled="@(busy || !CanGenerate)" @onclick="GenerateAsync">Create roster</button>
                        @if (busy) { <button type="button" class="app-button app-button-secondary" @onclick="RequestStop">Stop</button> }
                    </div>
                    @if (resultMessage != null) { <p role="status" class="rounded border p-3 text-sm">@resultMessage</p> }
                    @if (warnings.Count > 0)
                    {
                        <div class="space-y-1 rounded border border-amber-200 bg-amber-50 p-3 text-sm" role="alert">
                            <p class="font-semibold">Skipped</p>
                            @foreach (var warning in warnings) { <p>@warning</p> }
                        </div>
                    }
                    @if (created > 0) { <a class="text-sm underline" href="/admin/work-planning/duty-roster?tab=roster">Open the roster</a> }
                </div>
            </div>
        </div>
    }
</section>

@code {
    private const int MaxAssignments = 400;
    private static DateTime Today => DateTime.UtcNow.AddHours(5).Date;

    private bool loading = true, busy, stopRequested;
    private string? error, resultMessage;
    private string staffSearch = "", assignmentTitle = "Duty", remarks = "";
    private bool requiresAttendance = true, requiresCheckout = true;
    private int organisationId, departmentId, workTemplateId;
    private int weekdayMask = DefaultWeekdayMask();
    private DateTime fromDate = Today, toDate = Today;
    private int processed, total, created, skipped;
    private readonly HashSet<int> selectedIds = [];
    private readonly List<string> warnings = [];
    private List<WorkAssignmentDepartmentDto> Departments = [];
    private List<EligibleAssignmentStaffDto> Staff = [];
    private List<AssignedWorkTemplateDto> Templates = [];

    private IEnumerable<EligibleAssignmentStaffDto> FilteredStaff => string.IsNullOrWhiteSpace(staffSearch)
        ? Staff
        : Staff.Where(x => $"{x.EmployeeName} {x.JobTitle}".Contains(staffSearch, StringComparison.OrdinalIgnoreCase));
    private int DayCount => Dates().Count();
    private int TotalAssignments => selectedIds.Count * DayCount;
    private int ProgressPercent => total == 0 ? 0 : (int)Math.Round(processed * 100d / total);
    private bool CanGenerate => departmentId > 0 && selectedIds.Count > 0 && workTemplateId > 0 && DayCount > 0 && TotalAssignments <= MaxAssignments;
    private int TemplateOrganisationId => organisationId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await UserAccess.RequireContextAsync();
            organisationId = context.UserOrganisationId ?? 0;
            Departments = await Assignments.GetDepartmentsAsync();
            if (Departments.Count == 1)
            {
                departmentId = Departments[0].OrganisationStructureId;
                await LoadStaffAsync();
            }
            await LoadTemplatesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the roster builder");
            error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "The roster builder could not be loaded. Please contact HR.";
        }
        finally { loading = false; }
    }

    private static int DefaultWeekdayMask()
    {
        var mask = 0;
        for (var day = 0; day <= (int)DayOfWeek.Thursday; day++) mask |= 1 << day;
        return mask;
    }

    private IEnumerable<DateTime> Dates()
    {
        if (fromDate == default || toDate == default || toDate.Date < fromDate.Date) yield break;
        for (var date = fromDate.Date; date <= toDate.Date; date = date.AddDays(1))
            if ((weekdayMask & (1 << (int)date.DayOfWeek)) != 0) yield return date;
    }

    private async Task DepartmentChangedAsync()
    {
        selectedIds.Clear();
        staffSearch = "";
        workTemplateId = 0;
        await LoadStaffAsync();
        await LoadTemplatesAsync();
    }

    private async Task LoadStaffAsync()
    {
        Staff = [];
        if (departmentId <= 0) return;
        try { Staff = await Assignments.GetDepartmentStaffAsync(departmentId); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading department staff for the roster builder");
            error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Department staff could not be loaded.";
        }
    }

    private async Task LoadTemplatesAsync()
    {
        Templates = [];
        if (TemplateOrganisationId <= 0) return;
        try
        {
            var templates = await TemplateLookup.GetAvailableTemplatesAsync(TemplateOrganisationId, fromDate);
            Templates = templates.OrderBy(x => x.TemplateName).ToList();
            if (Templates.All(x => x.WorkTemplateId != workTemplateId)) workTemplateId = Templates.Count == 1 ? Templates[0].WorkTemplateId : 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading duty templates for the roster builder");
            Templates = [];
        }
    }

    private async Task FromDateChangedAsync()
    {
        if (toDate.Date < fromDate.Date) toDate = fromDate;
        await LoadTemplatesAsync();
    }

    private Task ToDateChangedAsync()
    {
        if (toDate.Date < fromDate.Date) fromDate = toDate;
        return Task.CompletedTask;
    }

    private void ToggleDay(int bit, bool selected) => weekdayMask = selected ? weekdayMask | bit : weekdayMask & ~bit;

    private void ToggleStaff(int individualId, bool selected)
    {
        if (selected) selectedIds.Add(individualId);
        else selectedIds.Remove(individualId);
    }

    private void SelectAllStaff(bool selected)
    {
        selectedIds.Clear();
        if (selected) foreach (var staff in FilteredStaff) selectedIds.Add(staff.IndividualId);
    }

    private void RequestStop() => stopRequested = true;

    private async Task GenerateAsync()
    {
        if (busy) return;
        error = null;
        resultMessage = null;
        warnings.Clear();
        created = skipped = processed = 0;
        var dates = Dates().ToList();
        if (departmentId <= 0) { error = "Select a department."; return; }
        if (selectedIds.Count == 0) { error = "Select at least one staff member."; return; }
        if (workTemplateId <= 0) { error = "Select a duty template."; return; }
        if (dates.Count == 0) { error = "Select at least one weekday inside the date range."; return; }
        if (dates.Count * selectedIds.Count > MaxAssignments) { error = $"This would create {dates.Count * selectedIds.Count} assignments. Create at most {MaxAssignments} at a time by shortening the date range or the staff selection."; return; }
        var organisation = TemplateOrganisationId;
        if (organisation <= 0) { error = "The current organisation could not be resolved."; return; }
        busy = true;
        stopRequested = false;
        total = dates.Count * selectedIds.Count;
        try
        {
            foreach (var individualId in selectedIds)
            {
                var staff = Staff.FirstOrDefault(x => x.IndividualId == individualId);
                if (staff == null) continue;
                foreach (var date in dates)
                {
                    if (stopRequested) break;
                    GeneratedWorkPlanResult outcome;
                    try
                    {
                        outcome = await ManualAssignments.GenerateAsync(new ManualWorkAssignmentRequest
                        {
                            IndividualId = staff.IndividualId,
                            JobId = staff.JobId,
                            OrganisationBusinessEntityId = organisation,
                            WorkTemplateId = workTemplateId,
                            WorkDate = date,
                            AssignmentTitle = assignmentTitle,
                            Remarks = remarks,
                            RequiresAttendance = requiresAttendance,
                            RequiresCheckout = requiresCheckout
                        });
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Creating a roster duty for staff {IndividualId} on {WorkDate}", staff.IndividualId, date);
                        outcome = GeneratedWorkPlanResult.Failure("The assignment could not be created.");
                    }
                    processed++;
                    if (outcome.Success) created++;
                    else
                    {
                        skipped++;
                        if (warnings.Count < 12) warnings.Add($"{staff.EmployeeName} · {date:dd MMM yyyy}: {OutcomeText(outcome)}");
                    }
                    if (processed % 5 == 0) await InvokeAsync(StateHasChanged);
                }
                if (stopRequested) break;
            }
            resultMessage = $"{created} assignment(s) created; {skipped} skipped{(stopRequested ? " before you stopped" : "")}.";
            if (warnings.Count >= 12 && skipped > warnings.Count) warnings.Add($"{skipped - warnings.Count} more skipped. Open the roster to review.");
            if (created > 0) Toasts.Success(resultMessage); else Toasts.Warning(resultMessage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating the duty roster");
            error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "The roster could not be created. Review the selected staff and try again.";
        }
        finally { busy = false; }
    }

    private static string OutcomeText(GeneratedWorkPlanResult outcome) =>
        string.IsNullOrWhiteSpace(outcome.Message) ? outcome.ErrorMessage ?? "The assignment was rejected." : outcome.Message;
}
