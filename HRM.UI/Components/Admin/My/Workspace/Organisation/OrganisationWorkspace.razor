@using HRM.DTOs
@using HRM.Enum
@using HRM.Services.Interfaces
@inject HRM.Services.Contracts.OrganisationWorkspaceServiceContracts.IOperations WorkspaceService
@inject IUserAccessService UserAccess
@inject ILogger<OrganisationWorkspace> Logger
@inject IJSRuntime JS

<div class="min-w-0 space-y-2">
    @if (loading)
    {
        <p role="status" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-sm text-slate-500 dark:text-slate-400">Loading organisation workspace…</p>
    }
    else if (error != null)
    {
        <div role="alert" class="rounded-2xl border border-red-200 dark:border-red-900/50 bg-white dark:bg-slate-900 p-4 text-sm text-red-700 dark:text-red-400">@error <button type="button" class="ml-2 underline font-semibold" @onclick="LoadAsync">Retry</button></div>
    }
    else if (data != null)
    {
        @if (!HideHeader)
        {
            <section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <h1 class="text-base font-bold text-slate-900 dark:text-slate-100">@data.Name</h1>
                        @if (!string.IsNullOrWhiteSpace(data.DhivehiName))
                        {
                            <p lang="dv" dir="rtl" class="mt-0.5 text-xs text-slate-500 dark:text-slate-400 font-medium">@data.DhivehiName</p>
                        }
                        <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">@data.Type</p>
                    </div>
                    <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="LoadAsync">
                        <AppIcon Name="refresh" Class="text-xs" />
                        <span>Refresh</span>
                    </button>
                </div>
            </section>
        }

        @if (ActiveTab == WorkspaceTab.Overview)
        {
            <!-- Compact Inline KPI & Organisation Metadata Bar (UI_DESIGN_STANDARD Section 6.5) -->
            <section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
                    @if (!string.IsNullOrWhiteSpace(data.Type))
                    {
                        <span class="inline-flex rounded-full border border-indigo-200/80 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/60 px-2 py-0.5 text-[10px] font-semibold text-indigo-700 dark:text-indigo-300">@data.Type</span>
                    }
                    <span>Reg: <strong class="font-mono text-slate-800 dark:text-slate-100">@(data.RegistrationNumber ?? "—")</strong></span>
                    <span>·</span>
                    <span>Parent: <strong class="text-slate-800 dark:text-slate-100">@(data.Parent ?? "—")</strong></span>
                    @if (!string.IsNullOrWhiteSpace(data.DhivehiName))
                    {
                        <span>·</span>
                        <span lang="dv" dir="rtl" class="font-medium text-slate-700 dark:text-slate-300">@data.DhivehiName</span>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
                    <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Staff: <strong class="text-slate-800 dark:text-slate-100">@data.StaffCount</strong></span>
                    <span>·</span>
                    <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>Departments: <strong class="text-slate-800 dark:text-slate-100">@data.Departments.Count</strong></span>
                    <span>·</span>
                    <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>Teams: <strong class="text-slate-800 dark:text-slate-100">@data.Teams.Count</strong></span>
                    <button type="button"
                            class="app-button @(showAnalytics ? "app-button-neutral" : "app-button-primary") app-button-sm ml-1"
                            @onclick="() => showAnalytics = !showAnalytics">
                        <i class="bi @(showAnalytics ? "bi-grid" : "bi-bar-chart-line")" aria-hidden="true"></i>
                        <span>@(showAnalytics ? "Standard Overview" : "Analytics")</span>
                    </button>
                    @if (HideHeader)
                    {
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="LoadAsync">
                            <AppIcon Name="refresh" Class="text-xs" />
                            <span>Refresh</span>
                        </button>
                    }
                </div>
            </section>

            @if (showAnalytics)
            {
                <OrganisationAnalyticsDashboard OrganisationId="@OrganisationId" OnClose="() => showAnalytics = false" />
            }
            else
            {
            <!-- 3-Column Responsive Enterprise Cards: Departments, Teams, Roles & Permissions -->
            <div class="org-overview-grid">
                <section class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-100">Departments</h2>
                        <span class="inline-flex rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200/80 dark:border-blue-800 px-2 py-0.5 text-[10px] font-semibold text-blue-700 dark:text-blue-300">@data.Departments.Count</span>
                    </div>
                    @if (data.Departments.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500 dark:text-slate-400">No active departments.</p>
                    }
                    else
                    {
                        <div class="max-h-96 overflow-y-auto">
                            <table class="min-w-full divide-y divide-slate-200/80 dark:divide-slate-800 text-left text-xs">
                                <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/90 text-[10px] font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300">
                                    <tr>
                                        <th class="px-3.5 py-2">Department</th>
                                        <th class="px-3.5 py-2 text-right">Staff</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                    @for (var i = 0; i < data.Departments.Count; i++)
                                    {
                                        var group = data.Departments[i];
                                        var isAlt = i % 2 == 1;
                                        <tr class="@(isAlt ? "bg-[#f3f8fd] dark:bg-slate-800/30" : "bg-white dark:bg-slate-900")">
                                            <td class="px-3.5 py-2 font-semibold text-slate-900 dark:text-slate-100">@group.Name</td>
                                            <td class="px-3.5 py-2 text-right whitespace-nowrap">
                                                <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold @(group.Members > 0 ? "bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                                                    @group.Members staff
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-100">Teams</h2>
                        <span class="inline-flex rounded-full bg-teal-50 dark:bg-teal-950/50 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">@data.Teams.Count</span>
                    </div>
                    @if (data.Teams.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500 dark:text-slate-400">No active teams.</p>
                    }
                    else
                    {
                        <div class="max-h-96 overflow-y-auto">
                            <table class="min-w-full divide-y divide-slate-200/80 dark:divide-slate-800 text-left text-xs">
                                <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/90 text-[10px] font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300">
                                    <tr>
                                        <th class="px-3.5 py-2">Team</th>
                                        <th class="px-3.5 py-2 text-right">Members</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                    @for (var i = 0; i < data.Teams.Count; i++)
                                    {
                                        var group = data.Teams[i];
                                        var isAlt = i % 2 == 1;
                                        <tr class="@(isAlt ? "bg-[#f3f8fd] dark:bg-slate-800/30" : "bg-white dark:bg-slate-900")">
                                            <td class="px-3.5 py-2 font-semibold text-slate-900 dark:text-slate-100">@group.Name</td>
                                            <td class="px-3.5 py-2 text-right whitespace-nowrap">
                                                <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold @(group.Members > 0 ? "bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                                                    @group.Members members
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                @if (canViewRolesAndPermissions)
                {
                    <section class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                            <div class="flex items-center gap-2">
                                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-100">Roles</h2>
                                <span class="inline-flex items-center rounded-full border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">Read-only · @overviewRoles.Count</span>
                            </div>
                            <input type="search"
                                   placeholder="Filter roles…"
                                   @bind="overviewRoleSearch"
                                   @bind:event="oninput"
                                   class="h-8 rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                        @{
                            var filteredRoles = FilteredOverviewRoles.ToList();
                        }
                        @if (filteredRoles.Count == 0)
                        {
                            <p class="p-4 text-xs text-slate-500 dark:text-slate-400">No roles configured for this organisation.</p>
                        }
                        else
                        {
                            <div class="max-h-96 divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto">
                                @for (var i = 0; i < filteredRoles.Count; i++)
                                {
                                    var role = filteredRoles[i];
                                    var isAlt = i % 2 == 1;
                                    <details @key="role.Id" class="px-3.5 py-2.5 text-xs @(isAlt ? "bg-[#f3f8fd] dark:bg-slate-800/30" : "bg-white dark:bg-slate-900")">
                                        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-slate-100 hover:text-teal-700 dark:hover:text-teal-400 transition">
                                            @role.Name
                                            <span class="mt-0.5 block text-[11px] font-normal text-slate-500 dark:text-slate-400">@role.Summary</span>
                                        </summary>
                                        @if (role.Details.Count == 0)
                                        {
                                            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">No assignments recorded.</p>
                                        }
                                        else
                                        {
                                            <ul class="mt-2 space-y-1 pl-3 border-l-2 border-slate-200 dark:border-slate-700 text-[11px] text-slate-600 dark:text-slate-400">
                                                @foreach (var detail in role.Details)
                                                {
                                                    <li class="break-words">@detail</li>
                                                }
                                            </ul>
                                        }
                                    </details>
                                }
                            </div>
                        }
                    </section>

                    <section class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                            <div class="flex items-center gap-2">
                                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-100">Permissions</h2>
                                <span class="inline-flex items-center rounded-full border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">Read-only · @overviewPermissions.Count</span>
                            </div>
                            <input type="search"
                                   placeholder="Filter permissions…"
                                   @bind="overviewPermissionSearch"
                                   @bind:event="oninput"
                                   class="h-8 rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                        @{
                            var filteredPerms = FilteredOverviewPermissions.ToList();
                        }
                        @if (filteredPerms.Count == 0)
                        {
                            <p class="p-4 text-xs text-slate-500 dark:text-slate-400">No permissions enabled for this organisation.</p>
                        }
                        else
                        {
                            <div class="max-h-96 overflow-y-auto">
                                <table class="min-w-full divide-y divide-slate-200/80 dark:divide-slate-800 text-left text-xs">
                                    <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/90 text-[10px] font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300">
                                        <tr>
                                            <th class="px-3.5 py-2">Permission</th>
                                            <th class="px-3.5 py-2">Key</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                        @for (var i = 0; i < filteredPerms.Count; i++)
                                        {
                                            var perm = filteredPerms[i];
                                            var isAlt = i % 2 == 1;
                                            <tr @key="perm.Id" class="@(isAlt ? "bg-[#f3f8fd] dark:bg-slate-800/30" : "bg-white dark:bg-slate-900")">
                                                <td class="px-3.5 py-2">
                                                    <div class="font-semibold text-slate-900 dark:text-slate-100">@perm.Name</div>
                                                    @if (perm.Details.Count > 0 && !string.IsNullOrWhiteSpace(perm.Details[0]))
                                                    {
                                                        <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">@perm.Details[0]</div>
                                                    }
                                                </td>
                                                <td class="px-3.5 py-2 font-mono text-[11px] text-slate-500 dark:text-slate-400 break-all">@perm.Summary</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
            </div>
            @if (canManageLeadership)
            {
                <HRM.Components.Admin.Settings.LeadershipAdministrationPage Embedded="true" InitialOrganisationId="OrganisationId" />
            }
            }
        }
        else if (ActiveTab == WorkspaceTab.Staff)
        {
            <section class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                <div class="flex flex-wrap items-end gap-2 border-b border-slate-100 dark:border-slate-800 px-4 py-3">
                    <div class="flex rounded-lg border border-slate-300 p-0.5 bg-slate-50 text-xs">
                        @foreach (var option in new[] { ("active", "Active Staff"), ("former", "Former Staff"), ("individuals", "Individuals") })
                        {
                            <button type="button" disabled="@staffRefreshing" class="rounded-md px-2.5 py-1 font-semibold disabled:opacity-60 @(staffScope == option.Item1 ? "bg-white text-teal-700 shadow-xs" : "text-slate-600")" @onclick="() => SetStaffScopeAsync(option.Item1)">@option.Item2</button>
                        }
                    </div>
                    <label class="min-w-0 flex-1 text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                        Search Staff
                        <input class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                               placeholder="Name, employee or SAP number"
                               @bind="search"
                               @bind:event="oninput" />
                    </label>
                    <label class="text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                        Department
                        <select class="mt-1 block max-w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                @bind="department">
                            <option value="0">All departments</option>
                            @foreach (var group in data.Departments)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </label>
                    <button type="button" disabled="@staffRefreshing" class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 px-3 py-1.5 text-xs font-semibold text-white shadow-xs transition disabled:opacity-60" @onclick="FilterAsync">@(staffRefreshing ? "Updating…" : "Search")</button>
                    <button type="button" disabled="@(staffRefreshing || staff.Count == 0)" class="app-button app-button-secondary app-button-sm" @onclick="ExportStaffAsync"><AppIcon Name="download" /> Export Excel</button>
                </div>
                @if (staff.Count == 0)
                {
                    <div class="m-4 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800 p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                        No @(staffScope == "active" ? "active staff" : staffScope == "former" ? "former staff" : "unassigned individuals") match your filters.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 dark:bg-slate-800/60 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                                <tr>
                                    <th class="px-3 py-2.5">Name</th>
                                    <th class="px-3 py-2.5">Department</th>
                                    <th class="px-3 py-2.5">Active Position</th>
                                    <th class="px-3 py-2.5">Employee No.</th>
                                    <th class="px-3 py-2.5">SAP No.</th>
                                    <th class="px-3 py-2.5">Joined</th>
                                    <th class="px-3 py-2.5">Service</th>
                                    <th class="px-3 py-2.5 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @foreach (var person in staff)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                                        <td class="px-3 py-2.5">
                                            <button type="button" class="text-left font-semibold text-teal-700 dark:text-teal-400 hover:underline" @onclick="() => OpenStaffAsync(person)">
                                                @person.Name
                                            </button>
                                        </td>
                                        <td class="px-3 py-2.5 text-slate-700 dark:text-slate-300">@person.Department</td>
                                        <td class="px-3 py-2.5 text-slate-700 dark:text-slate-300">@person.Position</td>
                                        <td class="px-3 py-2.5 text-slate-500 dark:text-slate-400 font-mono">@(person.EmployeeNumber ?? "—")</td>
                                        <td class="px-3 py-2.5 text-slate-500 dark:text-slate-400 font-mono">@(person.SapNumber ?? "—")</td>
                                        <td class="whitespace-nowrap px-3 py-2.5 text-slate-600 dark:text-slate-400">@(person.Joined == DateTime.MinValue ? "—" : person.Joined.ToString("dd MMM yyyy"))</td>
                                        <td class="whitespace-nowrap px-3 py-2.5 text-slate-600 dark:text-slate-400">@ServiceLength(person.Joined)</td>
                                        <td class="px-3 py-2.5 text-right">
                                            <button type="button" class="app-button app-button-ghost app-button-sm" title="Quick staff history" @onclick="() => OpenQuickHistory(person)">
                                                <AppIcon Name="history" /> History
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="flex items-center justify-between gap-2 border-t border-slate-100 dark:border-slate-800 px-4 py-3 text-xs text-slate-500 dark:text-slate-400">
                    <span>@total results · Page @(page + 1) of @Math.Max(1, (int)Math.Ceiling(total / 20m))</span>
                    <div class="flex gap-2">
                        <button type="button" disabled="@(staffRefreshing || page == 0)" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-slate-700 dark:text-slate-200 disabled:opacity-40 hover:bg-slate-50 dark:hover:bg-slate-700 transition" @onclick="() => MoveAsync(-1)">Previous</button>
                        <button type="button" disabled="@(staffRefreshing || (page + 1) * 20 >= total)" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-slate-700 dark:text-slate-200 disabled:opacity-40 hover:bg-slate-50 dark:hover:bg-slate-700 transition" @onclick="() => MoveAsync(1)">Next</button>
                    </div>
                </div>
            </section>
            @if (historyPerson != null)
            {
                <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 p-4" role="dialog" aria-modal="true" aria-label="Quick staff history">
                    <div class="w-full max-w-2xl rounded-2xl border border-slate-200 bg-white shadow-xl">
                        <div class="flex items-start justify-between gap-3 border-b border-slate-200 p-4">
                            <div><h3 class="text-base font-bold text-slate-900">@historyPerson.Name</h3><p class="mt-0.5 text-xs text-slate-500">Quick history</p></div>
                            <button type="button" class="app-button app-button-ghost app-button-icon app-button-sm" aria-label="Close" title="Close" @onclick="CloseQuickHistory"><AppIcon Name="close" /></button>
                        </div>
                        <div class="grid gap-3 p-4 sm:grid-cols-3">
                            <section class="rounded-xl border border-slate-200 bg-slate-50 p-3"><h4 class="text-xs font-bold text-slate-800">Position</h4><p class="mt-1 text-xs text-slate-600">@historyPerson.Position</p><p class="mt-1 text-[11px] text-slate-500">Active assignment</p></section>
                            <section class="rounded-xl border border-slate-200 bg-slate-50 p-3"><h4 class="text-xs font-bold text-slate-800">Contact</h4><p class="mt-1 text-xs text-slate-500">View the staff workspace for contact history.</p></section>
                            <section class="rounded-xl border border-slate-200 bg-slate-50 p-3"><h4 class="text-xs font-bold text-slate-800">Address</h4><p class="mt-1 text-xs text-slate-500">View the staff workspace for address history.</p></section>
                        </div>
                        <div class="flex justify-end gap-2 border-t border-slate-200 bg-slate-50 p-3"><button type="button" class="app-button app-button-secondary app-button-sm" @onclick="OpenHistoryStaffAsync">Open full staff workspace</button></div>
                    </div>
                </div>
            }
        }
        else if (ActiveTab == WorkspaceTab.Teams)
        {
            <OrganisationTeamsDirectoryPanel OrganisationId="OrganisationId" OnStaffSelected="OnStaffSelected" />
        }
        else if (ActiveTab == WorkspaceTab.LeaveType)
        {
            <HRM.Components.Leave.LeaveTypeManagement />
        }
        else if (ActiveTab is WorkspaceTab.AssignedRoles or WorkspaceTab.Permissions)
        {
            <section class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 p-4">
                    <div>
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">@ResourceTitle</h2>
                        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">@ResourceDescription</p>
                    </div>
                    <label class="text-xs font-medium text-slate-600 dark:text-slate-400 flex items-center">
                        Filter
                        <input class="ml-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                               @bind="resourceSearch"
                               @bind:event="oninput"
                               @bind:after="ResetResourceLimit" />
                    </label>
                </div>
                @if (!FilteredResources.Any())
                {
                    <p class="p-4 text-xs text-slate-500 dark:text-slate-400">No @ResourceTitle.ToLowerInvariant() match this view.</p>
                }
                <div class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var resource in FilteredResources.Take(resourceLimit))
                    {
                        <details @key="resource.Id" class="px-4 py-3 text-xs">
                            <summary class="cursor-pointer font-semibold text-slate-800 dark:text-slate-200 hover:text-teal-600 dark:hover:text-teal-400 transition">
                                @resource.Name
                                <span class="mt-0.5 block text-[11px] font-normal text-slate-500 dark:text-slate-400">@resource.Summary</span>
                            </summary>
                            @if (resource.Details.Count == 0)
                            {
                                <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">No assignments recorded.</p>
                            }
                            else
                            {
                                <ul class="mt-2.5 space-y-1 text-xs text-slate-600 dark:text-slate-400 pl-3 border-l-2 border-slate-200 dark:border-slate-700">
                                    @foreach (var detail in resource.Details)
                                    {
                                        <li class="break-words">@detail</li>
                                    }
                                </ul>
                            }
                        </details>
                    }
                </div>
                @if (FilteredResources.Count() > resourceLimit)
                {
                    <button type="button" class="m-4 text-xs font-semibold text-teal-600 dark:text-teal-400 hover:underline" @onclick="() => resourceLimit += 50">Show more</button>
                }
            </section>
        }
        else if (ActiveTab == WorkspaceTab.Departments)
        {
            <HRM.Components.Admin.Hr.Group.DepartmentManagement HideHeader="true" />
        }
        else if (ActiveTab == WorkspaceTab.Attendance)
        {
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-2xs">
                <HRM.Components.Admin.Attendance.Attendance.OrganisationDaily />
            </div>
            @if (canManageLeadership)
            {
                <HRM.Components.Admin.Settings.LeadershipAdministrationPage Embedded="true" InitialOrganisationId="OrganisationId" />
            }
        }
        else if (ActiveTab == WorkspaceTab.Documents)
        {
            <HRM.Components.Admin.Hr.Documents.DocumentCentreAdminPanel InitialSection="types" />
        }
    }
</div>

<style>
    .org-overview-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 0.5rem;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    @@media (min-width: 768px) {
        .org-overview-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1024px) {
        .org-overview-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>

@code {
    [Parameter] public int OrganisationId { get; set; }
    [Parameter] public WorkspaceTab ActiveTab { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public bool HideHeader { get; set; }
    private bool canManageLeadership;
    private bool canViewRolesAndPermissions;
    private List<OrganisationWorkspaceResource> overviewRoles = [];
    private List<OrganisationWorkspaceResource> overviewPermissions = [];
    private string overviewRoleSearch = "";
    private string overviewPermissionSearch = "";
    private IEnumerable<OrganisationWorkspaceResource> FilteredOverviewRoles => overviewRoles.Where(x => string.IsNullOrWhiteSpace(overviewRoleSearch) || x.Name.Contains(overviewRoleSearch, StringComparison.OrdinalIgnoreCase) || x.Summary.Contains(overviewRoleSearch, StringComparison.OrdinalIgnoreCase) || x.Details.Any(d => d.Contains(overviewRoleSearch, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<OrganisationWorkspaceResource> FilteredOverviewPermissions => overviewPermissions.Where(x => string.IsNullOrWhiteSpace(overviewPermissionSearch) || x.Name.Contains(overviewPermissionSearch, StringComparison.OrdinalIgnoreCase) || x.Summary.Contains(overviewPermissionSearch, StringComparison.OrdinalIgnoreCase) || x.Details.Any(d => d.Contains(overviewPermissionSearch, StringComparison.OrdinalIgnoreCase)));
    [Parameter] public EventCallback<WorkspaceSearchResult> OnStaffSelected { get; set; }
    [Parameter] public EventCallback<OrganisationWorkspaceData> OnLoaded { get; set; }

    private List<OrganisationWorkspaceResource> resources = [];
    private string resourceSearch = "";
    private int resourceLimit = 50;
    private void ResetResourceLimit() => resourceLimit = 50;
    private IEnumerable<OrganisationWorkspaceResource> FilteredResources => resources.Where(x => string.IsNullOrWhiteSpace(resourceSearch) || x.Name.Contains(resourceSearch, StringComparison.OrdinalIgnoreCase) || x.Summary.Contains(resourceSearch, StringComparison.OrdinalIgnoreCase) || x.Details.Any(d => d.Contains(resourceSearch, StringComparison.OrdinalIgnoreCase)));
    private string ResourceTitle => ActiveTab switch { WorkspaceTab.Teams => "Teams", WorkspaceTab.AssignedRoles => "Assigned roles", WorkspaceTab.Permissions => "Permissions", _ => "Leave types" };
    private string ResourceDescription => ActiveTab switch { WorkspaceTab.Teams => "Active teams, supervisors and members", WorkspaceTab.AssignedRoles => "Organisation roles, assigned accounts and role permissions", WorkspaceTab.Permissions => "Permissions enabled for this organisation", _ => "Configured leave types and current staff assignments" };
    private OrganisationWorkspaceData? data;
    private List<OrganisationWorkspaceStaff> staff = [];
    private OrganisationWorkspaceStaff? historyPerson;
    private List<OrganisationWorkspaceDocument> documents = [];
    private bool loading, staffRefreshing, showAnalytics;
    private string? error;
    private string search = "", staffScope = "active";
    private int department, page, total, loadedId;
    private WorkspaceTab loadedTab;
    private int loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == OrganisationId && loadedTab == ActiveTab) return;
        try
        {
            var actor = await UserAccess.RequireContextAsync();
            canManageLeadership = actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Leadership.Appointment.Manage");
        }
        catch { canManageLeadership = false; }
        if (loadedId != OrganisationId) { data = null; search = ""; department = 0; showAnalytics = false; }
        loadedId = OrganisationId; loadedTab = ActiveTab; page = 0; resourceSearch = ""; resourceLimit = 50;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        var org = OrganisationId; var tab = ActiveTab;
        loading = true; error = null;
        try
        {
            var overview = await WorkspaceService.LoadAsync(org);
            if (version != loadVersion) return;
            data = overview;
            if (OnLoaded.HasDelegate)
            {
                await OnLoaded.InvokeAsync(overview);
            }
            if (tab == WorkspaceTab.Overview)
            {
                try
                {
                    var rolesTask = WorkspaceService.ResourcesAsync(org, WorkspaceTab.AssignedRoles);
                    var permsTask = WorkspaceService.ResourcesAsync(org, WorkspaceTab.Permissions);
                    await Task.WhenAll(rolesTask, permsTask);
                    if (version != loadVersion) return;
                    overviewRoles = rolesTask.Result;
                    overviewPermissions = permsTask.Result;
                    canViewRolesAndPermissions = true;
                }
                catch (UnauthorizedAccessException)
                {
                    if (version != loadVersion) return;
                    overviewRoles = [];
                    overviewPermissions = [];
                    canViewRolesAndPermissions = false;
                }
            }
            else if (tab == WorkspaceTab.Staff)
            {
                var result = await WorkspaceService.StaffAsync(org, search, staffScope == "individuals" ? 0 : department, page, staffScope);
                if (version != loadVersion) return;
                staff = result.Rows; total = result.Total;
            }
            else if (tab is WorkspaceTab.AssignedRoles or WorkspaceTab.Permissions or WorkspaceTab.LeaveType)
            {
                var result = await WorkspaceService.ResourcesAsync(org, tab);
                if (version != loadVersion) return;
                resources = result;
            }
            else if (tab == WorkspaceTab.Documents)
            {
                var result = await WorkspaceService.DocumentsAsync(org, page);
                if (version != loadVersion) return;
                documents = result.Rows; total = result.Total;
            }
        }
        catch (UnauthorizedAccessException ex) { if (version == loadVersion) { data = null; error = ex.Message; } }
        catch (Exception ex) { Logger.LogError(ex, "Could not load organisation workspace {OrganisationId}", org); if (version == loadVersion) { data = null; error = "The organisation workspace could not be loaded. Please retry."; } }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task ReloadStaffAsync()
    {
        var version = ++loadVersion;
        staffRefreshing = true;
        error = null;
        try
        {
            var result = await WorkspaceService.StaffAsync(OrganisationId, search, staffScope == "individuals" ? 0 : department, page, staffScope);
            if (version != loadVersion) return;
            staff = result.Rows;
            total = result.Total;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load organisation staff for {OrganisationId}", OrganisationId);
            if (version == loadVersion) error = "The staff list could not be refreshed. Please retry.";
        }
        finally { if (version == loadVersion) staffRefreshing = false; }
    }

    private async Task FilterAsync() { page = 0; await ReloadStaffAsync(); }
    private async Task SetStaffScopeAsync(string scope) { if (staffScope == scope) return; staffScope = scope; page = 0; department = 0; await ReloadStaffAsync(); }
    private async Task MoveAsync(int change) { page += change; await ReloadStaffAsync(); }
    private static string ServiceLength(DateTime joined) { if (joined == DateTime.MinValue) return "—"; var days = Math.Max(0, (DateTime.UtcNow.Date - joined.Date).Days); return $"{days / 365}y {(days % 365) / 30}m"; }
    private static string CsvValue(string? value)
    {
        var quote = ((char)34).ToString();
        return quote + (value ?? string.Empty).Replace(quote, quote + quote) + quote;
    }
    private async Task ExportStaffAsync()
    {
        var rows = new[] { "Name,Department,Active Position,Employee No.,SAP No.,Joined,Service" }.Concat(staff.Select(p => string.Join(",", CsvValue(p.Name), CsvValue(p.Department), CsvValue(p.Position), CsvValue(p.EmployeeNumber), CsvValue(p.SapNumber), CsvValue(p.Joined == DateTime.MinValue ? "" : p.Joined.ToString("yyyy-MM-dd")), CsvValue(ServiceLength(p.Joined)))));
        var bytes = System.Text.Encoding.UTF8.GetBytes(string.Join("\r\n", rows));
        await using var stream = new MemoryStream(bytes);
        using var reference = new DotNetStreamReference(stream);
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
        await module.InvokeVoidAsync("download", $"organisation-{staffScope}-staff.csv", "text/csv;charset=utf-8", reference);
        await module.DisposeAsync();
    }

    private Task OpenStaffAsync(OrganisationWorkspaceStaff person) => OnStaffSelected.InvokeAsync(new WorkspaceSearchResult
    {
        Id = person.Id,
        IndividualId = person.Id,
        BusinessEntityId = person.Id,
        Name = person.Name,
        Description = person.Department,
        EntityType = WorkspaceEntityType.Staff
    });
    private void OpenQuickHistory(OrganisationWorkspaceStaff person) => historyPerson = person;
    private void CloseQuickHistory() => historyPerson = null;
    private async Task OpenHistoryStaffAsync()
    {
        var person = historyPerson;
        if (person == null) return;
        historyPerson = null;
        await OpenStaffAsync(person);
    }

}
