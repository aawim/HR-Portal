@using HRM.DTOs
@using HRM.Services.Interfaces
@inject ITeam TeamService
@inject ILogger<EditTaskModal> Logger
@inject HRM.Services.ToastService ToastService

@if (Visible && Task != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 overflow-y-auto"
         role="dialog" aria-modal="true" aria-labelledby="edit-task-title"
         @onkeydown="HandleKeyDown" tabindex="0">
        <div class="fixed inset-0" @onclick="CloseAsync" aria-hidden="true"></div>

        <div class="relative w-full max-w-xl rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto z-10"
             @onclick:stopPropagation>
            <!-- Header -->
            <div class="flex items-start justify-between border-b border-slate-100 dark:border-slate-800 pb-3 gap-3">
                <div>
                    <h3 id="edit-task-title" class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                        <span class="p-1 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400">✏️</span>
                        Edit Project Task
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-mono">
                        @Task.TaskReference · @Task.ProjectName
                    </p>
                </div>
                <button type="button" class="rounded-lg p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                        @onclick="CloseAsync" aria-label="Close dialog">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="rounded-lg border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/40 px-3 py-2 text-xs font-medium text-red-700 dark:text-red-300" role="alert">
                    @error
                </div>
            }

            <div class="space-y-3">
                <!-- Task Title -->
                <div>
                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Task Title <span class="text-red-500">*</span>
                    </label>
                    <input type="text"
                           maxlength="200"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                           @bind="model.Title" />
                </div>

                <!-- Reference & Priority -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Task Code / Reference
                        </label>
                        <input type="text"
                               maxlength="50"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-mono text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                               @bind="model.TaskReference" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Priority <span class="text-red-500">*</span>
                        </label>
                        <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                                @bind="model.Priority">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>
                </div>

                <!-- Assignee & Status -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Assigned To
                        </label>
                        <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                                @bind="model.AssignedStaffId">
                            <option value="0">Unassigned</option>
                            @if (StaffOptions != null)
                            {
                                @foreach (var s in StaffOptions)
                                {
                                    <option value="@s.StaffId">@s.FullName</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Status
                        </label>
                        <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                                @bind="model.Status">
                            <option value="Ongoing">Ongoing</option>
                            <option value="Parked">Parked</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                </div>

                <!-- Progress & Completion Date -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Progress (%: @model.Progress%)
                        </label>
                        <input type="range" min="0" max="100" step="5"
                               class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg cursor-pointer accent-teal-600 mt-2"
                               @bind="model.Progress" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Actual Completion Date
                        </label>
                        <input type="date"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                               @bind="model.ActualCompletionDate" />
                    </div>
                </div>

                <!-- Start Date & Expected End Date -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Start Date
                        </label>
                        <input type="date"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                               @bind="model.StartDate" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Expected End / Due Date
                        </label>
                        <input type="date"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                               @bind="model.ExpectedEndDate" />
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Task Description
                    </label>
                    <textarea rows="2"
                              maxlength="1000"
                              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                              @bind="model.Description"></textarea>
                </div>

                <!-- Remarks -->
                <div>
                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Internal Notes / Remarks
                    </label>
                    <input type="text"
                           maxlength="1000"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                           @bind="model.Remarks" />
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="flex items-center justify-end gap-2 border-t border-slate-100 dark:border-slate-800 pt-3">
                <button type="button"
                        class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        @onclick="CloseAsync"
                        disabled="@busy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 dark:bg-teal-600 px-4 py-2 text-xs font-semibold text-white hover:bg-teal-800 dark:hover:bg-teal-700 transition disabled:opacity-50"
                        @onclick="SaveAsync"
                        disabled="@busy">
                    @if (busy)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public TeamProjectTaskDto? Task { get; set; }
    [Parameter] public List<CreateProjectModal.StaffOptionDto>? StaffOptions { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private UpdateTaskInputDto model = new();
    private bool busy;
    private string? error;

    protected override void OnParametersSet()
    {
        if (Visible && Task != null)
        {
            error = null;
            model = new UpdateTaskInputDto
            {
                TaskId = Task.TaskId,
                ProjectId = Task.ProjectId,
                TaskReference = Task.TaskReference,
                Title = Task.Title,
                Description = Task.Description,
                AssignedStaffId = Task.AssignedStaffId,
                AssignedStaffName = Task.AssignedStaffName,
                Priority = Task.Priority,
                Status = Task.Status,
                Progress = Task.Progress,
                StartDate = Task.StartDate,
                ExpectedEndDate = Task.ExpectedEndDate,
                ActualCompletionDate = Task.ActualCompletionDate,
                Remarks = Task.Remarks
            };
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Title))
        {
            error = "Task title is required.";
            return;
        }

        if (model.StartDate.HasValue && model.ExpectedEndDate.HasValue && model.ExpectedEndDate.Value.Date < model.StartDate.Value.Date)
        {
            error = "Expected end date cannot be earlier than start date.";
            return;
        }

        try
        {
            busy = true;
            error = null;

            var ok = await TeamService.UpdateTaskAsync(model);
            if (ok)
            {
                ToastService.Success("Task updated successfully.");
                await OnSaved.InvokeAsync();
            }
            else
            {
                error = "Failed to update task.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update task");
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CloseAsync()
    {
        error = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }
}
