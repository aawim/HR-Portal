@using HRM.DTOs
@inject HRM.Services.Interfaces.ITeam TeamService
@inject HRM.Services.ToastService Toasts

<section class="w-full min-w-0 p-2 space-y-3">
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">@error</div>
    }
    @if (loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center text-xs text-slate-500">Loading sub-teams…</div>
    }
    else if (data != null)
    {
        <div class="grid min-w-0 grid-cols-1 gap-3 xl:grid-cols-[minmax(16rem,0.8fr)_minmax(0,1.5fr)]">
            <aside class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between gap-2">
                    <div><h3 class="font-bold text-slate-800 p-1">Sub-teams</h3><p class="text-xs text-slate-500">Under @data.ParentTeamName</p></div>
                    @if (data.CanManage) { <button class="inline-flex items-center rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700" @onclick="NewTeam">+ New</button> }
                </div>
                @if (data.SubTeams.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">No sub-teams created.</div>
                }
                @foreach (var team in data.SubTeams)
                {
                    <button type="button" @onclick="() => Select(team)"
                            class="w-full rounded-xl border p-2.5 text-left text-xs transition hover:shadow-xs @(selected?.TeamId == team.TeamId ? "border-blue-500 bg-blue-50/70 ring-1 ring-blue-500" : "border-slate-200 bg-white hover:border-slate-300")">
                        <span class="block font-semibold text-slate-900">@team.Name</span>
                        <span class="mt-1 block text-slate-500">@team.OrganisationStructureName · @team.Members.Count members</span>
                        @if (team.OvertimeEnabled) { <span class="mt-1 inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-800">OT enabled · @team.MaximumWeeklyOvertimeHours h/week</span> }
                    </button>
                }
            </aside>

            <div class="min-w-0 space-y-3">
                @if (data.CanManage && editing)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                        <h3 class="font-bold text-slate-800 p-1">@(draft.TeamId == 0 ? "Create sub-team" : "Sub-team configuration")</h3>
                        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                            <label class="block text-xs font-medium text-slate-700 p-1">Name<input class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1 text-xs" @bind="draft.Name" /></label>
                            <label class="block text-xs font-medium text-slate-700 p-1">Organisation structure<select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1 text-xs" @bind="draft.OrganisationStructureId"><option value="">Select structure</option>@foreach(var o in data.Structures){<option value="@o.Id">@o.Name</option>}</select></label>
                        </div>
                        <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-3.5 space-y-2">
                            <label class="flex items-center gap-2 text-xs font-semibold text-slate-800"><input type="checkbox" @bind="draft.OvertimeEnabled" /> Allow OT through this sub-team</label>
                            <p class="text-[11px] text-slate-600">This grants eligibility when the member's job type disallows OT. Evidence and the normal OT approval workflow still apply.</p>
                            @if (draft.OvertimeEnabled)
                            {
                                <div class="grid grid-cols-2 gap-3">
                                    <label class="text-xs text-slate-700">Daily limit (hours)<input type="number" step="0.25" min="0.25" max="24" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="draft.MaximumDailyOvertimeHours" /></label>
                                    <label class="text-xs text-slate-700">Weekly limit (hours)<input type="number" step="0.25" min="0.25" max="168" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="draft.MaximumWeeklyOvertimeHours" /></label>
                                </div>
                            }
                        </div>
                        <button disabled="@busy" class="inline-flex items-center rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50" @onclick="SaveTeam">Save sub-team</button>
                    </div>
                }

                @if (selected != null)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                        <div><h3 class="font-bold text-slate-800 p-1">Members and roles</h3><p class="text-xs text-slate-500">Supervisor and Team Lead roles apply inside this sub-team.</p></div>
                        @if (data.CanManage)
                        {
                            <div class="grid grid-cols-1 gap-2 rounded-xl border border-slate-200 bg-slate-50/70 p-3 md:grid-cols-[1fr_10rem_auto]">
                                <select class="rounded-lg border border-slate-300 bg-white p-1 text-xs" @bind="memberStaffId"><option value="0">Select staff</option>@foreach(var o in data.Staff){<option value="@o.Id">@o.Name</option>}</select>
                                <select class="rounded-lg border border-slate-300 bg-white p-1 text-xs" @bind="memberRole"><option>Member</option><option>Supervisor</option><option value="TeamLead">Team Lead</option></select>
                                <button disabled="@(busy || memberStaffId <= 0)" class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50" @onclick="SaveMember">Assign</button>
                            </div>
                        }
                        <div class="overflow-x-auto rounded-xl border border-slate-200"><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 bg-slate-50 text-slate-700"><tr><th class="p-2.5">Staff</th><th class="p-2.5">Role</th><th class="p-2.5"></th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var m in selected.Members){<tr><td class="p-2.5 font-medium">@m.StaffName</td><td class="p-2.5">@(m.Role == "TeamLead" ? "Team Lead" : m.Role)</td><td class="p-2.5 text-right">@if(data.CanManage){<button class="text-xs font-semibold text-rose-700" @onclick="() => RemoveMember(m.StaffId)">Remove</button>}</td></tr>}</tbody></table></div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                        <div><h3 class="font-bold text-slate-800 p-1">Check-in/check-out adjustment</h3><p class="text-xs text-slate-500">Only a parent-team supervisor or authorised administrator can save this dated overlay.</p></div>
                        @if (data.CanManage)
                        {
                            <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                                <label class="text-xs text-slate-700">Work date<input type="date" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="adjustmentDate" /></label>
                                <label class="text-xs text-slate-700">New check-in (optional)<input type="text" inputmode="numeric" placeholder="HH:mm" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="checkIn" /></label>
                                <label class="text-xs text-slate-700">New check-out (optional)<input type="text" inputmode="numeric" placeholder="HH:mm" class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" @bind="checkOut" /></label>
                            </div>
                            <label class="block text-xs text-slate-700">Reason<textarea class="mt-1 w-full rounded-lg border border-slate-300 p-1 text-xs" rows="2" @bind="adjustmentReason"></textarea></label>
                            <button disabled="@busy" class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white disabled:opacity-50" @onclick="SaveAdjustment">Save adjustment</button>
                        }
                        @foreach(var a in selected.Adjustments.Where(x => x.IsActive))
                        {
                            <div class="rounded-xl border border-slate-200 p-2.5 text-xs"><span class="font-semibold">@a.WorkDate.ToString("dd MMM yyyy")</span> · Check-in @(a.RevisedCheckIn?.ToString("hh\\:mm") ?? "scheduled") · Check-out @(a.RevisedCheckOut?.ToString("hh\\:mm") ?? "scheduled")<p class="mt-1 text-slate-500">@a.Reason</p></div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public int ParentTeamId { get; set; }
    private int loadedTeamId; private bool loading; private bool busy; private bool editing; private string? error;
    private SubTeamWorkspaceDto? data; private SubTeamDto? selected; private SaveSubTeamDto draft = new();
    private int memberStaffId; private string memberRole = "Member"; private DateTime adjustmentDate = DateTime.Today;
    private string checkIn = ""; private string checkOut = ""; private string adjustmentReason = "";
    protected override async Task OnParametersSetAsync(){ if(ParentTeamId > 0 && loadedTeamId != ParentTeamId){ loadedTeamId=ParentTeamId; await Load(); } }
    private async Task Load(int? selectId=null){ loading=true;error=null;try{data=await TeamService.LoadSubTeamsAsync(ParentTeamId);selected=data.SubTeams.FirstOrDefault(x=>x.TeamId==(selectId??selected?.TeamId))??data.SubTeams.FirstOrDefault();if(selected!=null)Select(selected);}catch(Exception ex){error=ex.Message;}finally{loading=false;} }
    private void NewTeam(){selected=null;editing=true;draft=new(){ParentTeamId=ParentTeamId,IsActive=true,MaximumDailyOvertimeHours=4,MaximumWeeklyOvertimeHours=24};}
    private void Select(SubTeamDto team){selected=team;editing=data?.CanManage==true;draft=new(){TeamId=team.TeamId,ParentTeamId=team.ParentTeamId,Name=team.Name,NameDhivehi=team.NameDhivehi,OrganisationStructureId=team.OrganisationStructureId,OvertimeEnabled=team.OvertimeEnabled,MaximumDailyOvertimeHours=team.MaximumDailyOvertimeHours,MaximumWeeklyOvertimeHours=team.MaximumWeeklyOvertimeHours,IsActive=team.IsActive};}
    private async Task Run(Func<Task> action,string success){busy=true;error=null;try{await action();Toasts.Success(success);}catch(Exception ex){error=ex.Message;}finally{busy=false;}}
    private async Task SaveTeam(){var id=0;await Run(async()=>id=await TeamService.SaveSubTeamAsync(draft),"Sub-team saved.");if(id>0)await Load(id);}
    private async Task SaveMember(){if(selected==null)return;await Run(()=>TeamService.SaveSubTeamMemberAsync(new(){TeamId=selected.TeamId,StaffId=memberStaffId,Role=memberRole,StartDate=DateTime.Today}),"Member assigned.");await Load(selected.TeamId);}
    private async Task RemoveMember(int staffId){if(selected==null)return;await Run(()=>TeamService.RemoveSubTeamMemberAsync(selected.TeamId,staffId),"Member removed.");await Load(selected.TeamId);}
    private async Task SaveAdjustment(){if(selected==null)return;TimeSpan? start=TimeSpan.TryParse(checkIn,out var s)?s:null;TimeSpan? end=TimeSpan.TryParse(checkOut,out var e)?e:null;await Run(()=>TeamService.SaveTeamScheduleAdjustmentAsync(new(){TeamId=selected.TeamId,WorkDate=adjustmentDate,RevisedCheckIn=start,RevisedCheckOut=end,Reason=adjustmentReason}),"Schedule adjustment saved.");checkIn=checkOut=adjustmentReason="";await Load(selected.TeamId);}
}
