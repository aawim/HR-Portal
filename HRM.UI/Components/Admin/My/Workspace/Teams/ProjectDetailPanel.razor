@using HRM.DTOs
@using HRM.Services.Interfaces
@inject ITeam TeamService
@inject ILogger<ProjectDetailPanel> Logger
@inject HRM.Services.ToastService ToastService

<aside class="min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
    <!-- Header -->
    <div class="flex items-start justify-between border-b border-slate-100 dark:border-slate-800 pb-3 gap-2">
        <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-mono text-[11px] font-semibold text-blue-700 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/40 px-2 py-0.2 rounded-md">
                    @(Project?.Reference ?? "PRJ")
                </span>
                <span class="rounded-full px-2.5 py-0.5 text-[10px] font-bold @GetStatusBadge(Project?.Status)">
                    @(Project?.Status ?? "Active")
                </span>
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-1 break-words">
                @(Project?.Name ?? $"Project #{ProjectId}")
            </h3>
        </div>
        <button type="button"
                class="rounded-lg p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                @onclick="CloseAsync"
                title="Close project details panel">
            ✕
        </button>
    </div>

    @if (loading)
    {
        <div class="py-12 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            Loading project details…
        </div>
    }
    else if (Project != null)
    {
        <!-- Description -->
        @if (!string.IsNullOrWhiteSpace(Project.Description))
        {
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 p-3 text-xs text-slate-700 dark:text-slate-300">
                @Project.Description
            </div>
        }

        <!-- Details Grid -->
        <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="p-2.5 rounded-xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-800/40">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-medium">Project Owner / Manager</span>
                <span class="font-bold text-slate-900 dark:text-slate-100 block truncate">
                    @(!string.IsNullOrWhiteSpace(Project.ProjectManagerName) ? Project.ProjectManagerName : "Unassigned")
                </span>
            </div>
            <div class="p-2.5 rounded-xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-800/40">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-medium">Assigned Team</span>
                <span class="font-bold text-slate-900 dark:text-slate-100 block truncate">@Project.TeamName</span>
            </div>
        </div>

        <!-- Timeline Dates -->
        <div class="grid grid-cols-3 gap-1.5 text-[11px] p-2 rounded-xl bg-slate-50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-800">
            <div>
                <span class="text-[10px] text-slate-500 block">Start Date</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">@Project.StartDate.ToString("dd MMM yyyy")</span>
            </div>
            <div>
                <span class="text-[10px] text-slate-500 block">Planned End</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">@(Project.PlannedEndDate?.ToString("dd MMM yyyy") ?? "-")</span>
            </div>
            <div>
                <span class="text-[10px] text-slate-500 block">Actual End</span>
                <span class="font-semibold @(Project.ActualEndDate.HasValue ? "text-emerald-600" : "text-slate-500")">
                    @(Project.ActualEndDate?.ToString("dd MMM yyyy") ?? "In Progress")
                </span>
            </div>
        </div>

        <!-- Progress Indicator -->
        <div class="space-y-1">
            <div class="flex items-center justify-between text-xs">
                <span class="font-semibold text-slate-700 dark:text-slate-300">Project Completion</span>
                <span class="font-bold text-slate-900 dark:text-slate-100">@Project.ProgressPercentage%</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                <div class="h-full rounded-full bg-teal-600 transition-all duration-300"
                     @GetProgressWidthClass(Project.ProgressPercentage)"></div>
            </div>
        </div>

        <!-- Assigned Members -->
        <div class="space-y-1.5">
            <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Project Members (@Project.Members.Count)</span>
                @if (Project.CanManageAssignments)
                {
                    <div class="flex items-center gap-1">
                        <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition" @onclick="OpenAddMemberAsync">Add Team Member</button>
                        <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition disabled:opacity-50" disabled="@(Project.Members.Count == 0)" @onclick="OpenAssignTask">Assign Task</button>
                    </div>
                }
            </div>
            @if (Project.Members.Count == 0)
            {
                <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No members assigned.</p>
            }
            @foreach (var m in Project.Members)
            {
                <div @key="m.ProjectMemberId" class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-[11px] text-slate-800 dark:text-slate-200">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <span class="font-semibold">@m.StaffName</span>
                            <span class="text-slate-400 text-[10px]">(@m.Role)</span>
                            <p class="text-[10px] text-slate-500 dark:text-slate-400">Since @m.AssignedDate.ToString("dd MMM yyyy")@(m.ExpectedEndDate.HasValue ? $" · Ends {m.ExpectedEndDate:dd MMM yyyy}" : "")</p>
                            @if (!string.IsNullOrWhiteSpace(m.Remarks))
                            {
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 break-words">@m.Remarks</p>
                            }
                        </div>
                        @if (Project.CanManageAssignments)
                        {
                            <div class="flex items-center gap-2 shrink-0">
                                <button type="button" class="text-[10px] font-semibold text-blue-600 hover:underline" @onclick="() => BeginEdit(m)">Edit</button>
                                <button type="button" class="text-[10px] font-semibold text-red-600 hover:underline" @onclick="() => removeConfirmId = m.ProjectMemberId">Remove</button>
                            </div>
                        }
                    </div>
                    @if (editingId == m.ProjectMemberId)
                    {
                        <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1.5 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500" aria-label="Assignment role" @bind="editRole">
                                @foreach (var r in Roles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <input type="date" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1.5 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500" aria-label="Expected end date" @bind="editEnd" />
                            <input type="text" maxlength="1000" placeholder="Remarks" class="sm:col-span-2 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1.5 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500" aria-label="Remarks" @bind="editRemarks" />
                            <div class="sm:col-span-2 flex justify-end gap-1.5">
                                <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold" @onclick="() => editingId = null">Cancel</button>
                                <button type="button" class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2 py-1 text-[10px] font-semibold text-white disabled:opacity-50" disabled="@busy" @onclick="SaveEditAsync">Save</button>
                            </div>
                        </div>
                    }
                    @if (removeConfirmId == m.ProjectMemberId)
                    {
                        var open = Project.Tasks.Count(t => t.AssignedStaffId == m.StaffId && t.Status != "Completed");
                        <div class="mt-2 rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 p-2 text-amber-800 dark:text-amber-300" role="alert">
                            Remove @m.StaffName from this project? History is kept.@(open > 0 ? $" {open} open task(s) stay assigned and need review." : "")
                            <div class="flex gap-1.5 mt-1.5">
                                <button type="button" class="rounded-lg bg-red-600 hover:bg-red-700 px-2 py-1 text-[10px] font-semibold text-white disabled:opacity-50" disabled="@busy" @onclick="() => RemoveMemberAsync(m.ProjectMemberId)">Confirm remove</button>
                                <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-700 dark:text-slate-300" @onclick="() => removeConfirmId = null">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <button type="button" class="text-[11px] font-semibold text-blue-600 hover:underline" @onclick="ToggleHistoryAsync">@(showHistory ? "Hide assignment history" : "View assignment history")</button>
            @if (showHistory)
            {
                <div class="max-h-48 overflow-y-auto rounded-lg border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-800">
                    @if (history.Count == 0)
                    {
                        <p class="p-2 text-[11px] text-slate-500 italic">No assignment history yet.</p>
                    }
                    @foreach (var h in history)
                    {
                        <div class="p-2 text-[11px]">
                            <span class="font-semibold text-slate-800 dark:text-slate-200">@HistoryLabel(h.Action)</span>
                            <span class="text-slate-600 dark:text-slate-400">@h.StaffName@(string.IsNullOrEmpty(h.PreviousStaffName) ? "" : $" (from {h.PreviousStaffName})")@(string.IsNullOrEmpty(h.TaskTitle) ? "" : $" · {h.TaskTitle}")</span>
                            <p class="text-[10px] text-slate-500 dark:text-slate-400">By @h.PerformedByName · @h.PerformedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                            @if (!string.IsNullOrWhiteSpace(h.Details))
                            {
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 break-words">@h.Details</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <AssignmentModal Visible="showAssign" Mode="assignMode" ProjectId="ProjectId" StaffOptions="assignStaffOptions"
                         OnSaved="OnAssignedAsync" OnClose="() => showAssign = false" />
        <!-- Tasks Grouped by Category -->
        <div class="space-y-3 pt-2 border-t border-slate-100 dark:border-slate-800">
            <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                    Project Tasks (@Project.TotalTaskCount)
                </h4>
            </div>

            <!-- 1. Ongoing Tasks -->
            <div class="space-y-1.5">
                <div class="flex items-center justify-between text-[11px] font-bold text-blue-700 dark:text-blue-400">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                        Ongoing Tasks
                    </span>
                    <span class="rounded-full bg-blue-100 dark:bg-blue-950/60 px-2 py-0.2 text-[10px]">
                        @Project.OngoingTaskCount
                    </span>
                </div>
                @if (Project.Tasks.Count(t => t.Status is "Ongoing" or "In Progress" or "Active") == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No active ongoing tasks.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var task in Project.Tasks.Where(t => t.Status is "Ongoing" or "In Progress" or "Active"))
                        {
                            <div @key="task.TaskId"
                                 class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-300 dark:hover:border-blue-700 transition cursor-pointer shadow-2xs group"
                                 @onclick="() => SelectTaskAsync(task)">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono text-[10px] text-blue-600 dark:text-blue-400 font-bold">@task.TaskReference</span>
                                            <span class="font-semibold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 transition truncate block">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            Assigned: @(!string.IsNullOrWhiteSpace(task.AssignedStaffName) ? task.AssignedStaffName : "Unassigned") · @task.Priority
                                        </p>
                                    </div>
                                    <span class="font-bold text-xs text-slate-700 dark:text-slate-300 shrink-0">@task.Progress%</span>
                                </div>
                                <div class="w-full h-1 rounded-full bg-slate-100 dark:bg-slate-800 mt-2 overflow-hidden">
                                    <div class="h-full rounded-full bg-blue-600 @GetProgressWidthClass(task.Progress)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 2. Completed Tasks -->
            <div class="space-y-1.5 pt-1">
                <div class="flex items-center justify-between text-[11px] font-bold text-emerald-700 dark:text-emerald-400">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        Completed Tasks
                    </span>
                    <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.2 text-[10px]">
                        @Project.CompletedTaskCount
                    </span>
                </div>
                @if (Project.Tasks.Count(t => t.Status is "Completed") == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No completed tasks yet.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var task in Project.Tasks.Where(t => t.Status is "Completed"))
                        {
                            <div @key="task.TaskId"
                                 class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-300 dark:hover:border-emerald-700 transition cursor-pointer shadow-2xs group"
                                 @onclick="() => SelectTaskAsync(task)">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-bold">@task.TaskReference</span>
                                            <span class="font-semibold text-xs text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 transition truncate block">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            Delivered on @(task.ActualCompletionDate?.ToString("dd MMM yyyy") ?? "-")
                                        </p>
                                    </div>
                                    <span class="rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 px-1.5 py-0.2 text-[9px] font-bold shrink-0">
                                        ✓ 100%
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 3. Parked Tasks -->
            <div class="space-y-1.5 pt-1">
                <div class="flex items-center justify-between text-[11px] font-bold text-purple-700 dark:text-purple-400">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                        Parked / Paused Tasks
                    </span>
                    <span class="rounded-full bg-purple-100 dark:bg-purple-950/60 px-2 py-0.2 text-[10px]">
                        @Project.ParkedTaskCount
                    </span>
                </div>
                @if (Project.Tasks.Count(t => t.Status is "Parked" or "On Hold" or "Paused") == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No parked tasks.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var task in Project.Tasks.Where(t => t.Status is "Parked" or "On Hold" or "Paused"))
                        {
                            <div @key="task.TaskId"
                                 class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-purple-300 dark:hover:border-purple-700 transition cursor-pointer shadow-2xs group"
                                 @onclick="() => SelectTaskAsync(task)">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono text-[10px] text-purple-600 dark:text-purple-400 font-bold">@task.TaskReference</span>
                                            <span class="font-semibold text-xs text-slate-900 dark:text-slate-100 group-hover:text-purple-600 transition truncate block">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            @(string.IsNullOrWhiteSpace(task.Remarks) ? "On Hold" : task.Remarks)
                                        </p>
                                    </div>
                                    <span class="rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 px-1.5 py-0.2 text-[9px] font-bold shrink-0">
                                        Parked
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Footer -->
    <div class="flex items-center justify-end pt-3 border-t border-slate-100 dark:border-slate-800">
        <button type="button"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                @onclick="CloseAsync">
            Close Project Details
        </button>
    </div>
</aside>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TeamProjectTaskDto> OnTaskClick { get; set; }
    /// <summary>Raised after an assignment changes so the parent can refresh member and project views.</summary>
    [Parameter] public EventCallback OnAssignmentsChanged { get; set; }

    private static readonly string[] Roles = ["Member", "Lead", "Coordinator", "Contributor", "Reviewer"];
    private TeamProjectDto? Project;
    private bool loading = true;
    private bool showAssign, busy, showHistory;
    private AssignmentModal.AssignmentMode assignMode;
    private List<TeamStaffDto> assignStaffOptions = new();
    private List<AssignmentHistoryDto> history = new();
    private int? editingId, removeConfirmId;
    private string editRole = "Member", editRemarks = "";
    private DateTime? editEnd;

    private async Task OpenAddMemberAsync()
    {
        assignMode = AssignmentModal.AssignmentMode.Project;
        assignStaffOptions = new();
        try
        {
            if (Project?.TeamId is int teamId)
            {
                var team = await TeamService.GetTeamByIdAsync(teamId);
                var existing = Project.Members.Select(m => m.StaffId).ToHashSet();
                assignStaffOptions = team?.Staffs.Where(s => !existing.Contains(s.StaffId)).ToList() ?? new();
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to load team members for project {ProjectId}", ProjectId); }
        showAssign = true;
    }

    private void OpenAssignTask()
    {
        assignMode = AssignmentModal.AssignmentMode.Task;
        assignStaffOptions = Project?.Members.Select(m => new TeamStaffDto { StaffId = m.StaffId, FullName = m.StaffName }).ToList() ?? new();
        showAssign = true;
    }

    private async Task OnAssignedAsync()
    {
        await LoadProjectAsync();
        if (showHistory) history = await TeamService.GetAssignmentHistoryAsync(ProjectId, null);
        await OnAssignmentsChanged.InvokeAsync();
    }

    private void BeginEdit(TeamProjectMemberDto m)
    {
        removeConfirmId = null; editingId = m.ProjectMemberId;
        editRole = m.Role; editEnd = m.ExpectedEndDate; editRemarks = m.Remarks;
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not int id) return;
        busy = true;
        try
        {
            await TeamService.UpdateProjectAssignmentAsync(new UpdateProjectAssignmentRequestDto { ProjectMemberId = id, Role = editRole, ExpectedEndDate = editEnd, Remarks = editRemarks });
            ToastService.Success("Assignment updated.");
            editingId = null;
            await OnAssignedAsync();
        }
        catch (Exception ex) { ToastService.Error(ex is UnauthorizedAccessException ? "You are not authorised to update this assignment." : ex.Message); }
        finally { busy = false; }
    }

    private async Task RemoveMemberAsync(int projectMemberId)
    {
        busy = true;
        try
        {
            await TeamService.RemoveProjectAssignmentAsync(projectMemberId, null);
            ToastService.Success("Member removed from the project. History has been kept.");
            removeConfirmId = null;
            await OnAssignedAsync();
        }
        catch (Exception ex) { ToastService.Error(ex is UnauthorizedAccessException ? "You are not authorised to remove this member." : ex.Message); }
        finally { busy = false; }
    }

    private async Task ToggleHistoryAsync()
    {
        showHistory = !showHistory;
        if (showHistory)
        {
            try { history = await TeamService.GetAssignmentHistoryAsync(ProjectId, null); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to load assignment history for {ProjectId}", ProjectId); history = new(); }
        }
    }

    private static string HistoryLabel(string action) => action switch
    {
        "ProjectAssigned" => "Assigned to project",
        "ProjectUpdated" => "Assignment updated",
        "ProjectRemoved" => "Removed from project",
        "TaskAssigned" => "Task assigned",
        "TaskReassigned" => "Task reassigned",
        _ => action
    };

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId > 0 && (Project == null || Project.ProjectId != ProjectId))
        {
            await LoadProjectAsync();
        }
    }

    private async Task LoadProjectAsync()
    {
        loading = true;
        try
        {
            Project = await TeamService.GetProjectDetailsAsync(ProjectId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load project details for {ProjectId}", ProjectId);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CloseAsync() => await OnClose.InvokeAsync();

    private async Task SelectTaskAsync(TeamProjectTaskDto task) => await OnTaskClick.InvokeAsync(task);

    private static string GetProgressWidthClass(int progress) => progress switch
    {
        <= 0 => "w-0",
        <= 10 => "w-1/12",
        <= 20 => "w-2/12",
        <= 25 => "w-1/4",
        <= 33 => "w-4/12",
        <= 40 => "w-5/12",
        <= 50 => "w-1/2",
        <= 60 => "w-7/12",
        <= 70 => "w-8/12",
        <= 75 => "w-3/4",
        <= 80 => "w-10/12",
        <= 90 => "w-11/12",
        _ => "w-full"
    };

    private static string GetStatusBadge(string? status) => status switch
    {
        "Completed" => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40",
        "Ongoing" or "In Progress" or "Active" => "bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800/40",
        "Parked" or "On Hold" => "bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40",
        _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
    };
}
