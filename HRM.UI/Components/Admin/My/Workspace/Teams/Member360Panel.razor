@using HRM.DTOs
@using HRM.Services.Interfaces
@inject ITeam TeamService
@inject ILogger<Member360Panel> Logger
@inject HRM.Services.ToastService ToastService

<aside class="min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
    <!-- Header -->
    <div class="flex items-start justify-between border-b border-slate-100 dark:border-slate-800 pb-3 gap-2">
        <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 font-bold flex items-center justify-center text-sm shadow-xs shrink-0">
                @GetInitials(Summary?.FullName ?? "Staff")
            </div>
            <div class="min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">
                        @(Summary?.FullName ?? $"Staff #{StaffId}")
                    </h3>
                    <span class="rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800/40 px-2 py-0.2 text-[10px] font-semibold">
                        360° Profile
                    </span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                    ID: #@StaffId · @(Summary?.Designation ?? "Specialist")
                </p>
            </div>
        </div>
        <button type="button"
                class="rounded-lg p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                @onclick="CloseAsync"
                title="Close contextual panel">
            ✕
        </button>
    </div>

    @if (loading)
    {
        <div class="py-12 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            Loading 360° work profile…
        </div>
    }
    else if (Summary != null)
    {
        <!-- Basic Info Card -->
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 p-3 space-y-2 text-xs">
            <div class="grid grid-cols-2 gap-2 text-[11px]">
                <div>
                    <span class="text-slate-500 dark:text-slate-400 block font-medium">Department</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200 truncate block">@Summary.Department</span>
                </div>
                <div>
                    <span class="text-slate-500 dark:text-slate-400 block font-medium">Official Email</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200 truncate block">@Summary.Email</span>
                </div>
            </div>

            <!-- Assigned Teams -->
            @if (Summary.AssignedTeams.Count > 0)
            {
                <div class="pt-1 border-t border-slate-200/60 dark:border-slate-700/60">
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-medium mb-1">Assigned Team(s)</span>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var team in Summary.AssignedTeams)
                        {
                            <span class="rounded bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold">
                                @team
                            </span>
                        }
                    </div>
                </div>
            }

            <!-- Assigned Projects -->
            <div class="pt-2 border-t border-slate-200/60 dark:border-slate-700/60 space-y-1.5">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Assigned Projects (@Summary.ProjectAssignments.Count(a => a.IsActive))</span>
                    <div class="flex items-center gap-1">
                        <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition" @onclick="() => OnAssignProject.InvokeAsync()">Assign Project</button>
                        <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition" @onclick="() => OnAssignTask.InvokeAsync()">Assign Task</button>
                    </div>
                </div>
                @if (Summary.ProjectAssignments.Count == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No project assignments.</p>
                }
                @foreach (var a in Summary.ProjectAssignments)
                {
                    <div @key="a.ProjectMemberId" class="p-2 rounded-xl border @(a.IsActive ? "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900" : "border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 opacity-70")">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <button type="button" class="text-xs font-semibold text-blue-700 dark:text-blue-400 hover:underline text-left break-words" @onclick="() => OnProjectClick.InvokeAsync(a.ProjectId)">@a.ProjectName</button>
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                    @a.Role · Assigned @a.AssignedDate.ToString("dd MMM yyyy")@(a.ExpectedEndDate.HasValue ? $" · Ends {a.ExpectedEndDate:dd MMM yyyy}" : "")
                                </p>
                            </div>
                            <span class="rounded-full px-2 py-0.5 text-[10px] font-bold shrink-0 @(a.IsActive ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" : "bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300")">
                                @(a.IsActive ? a.ProjectStatus : $"Removed {a.RemovedAt:dd MMM yyyy}")
                            </span>
                        </div>
                        @if (a.IsActive && a.CanManage)
                        {
                            @if (removeConfirmId == a.ProjectMemberId)
                            {
                                var open = Summary.OngoingTasks.Concat(Summary.ParkedTasks).Count(t => t.ProjectId == a.ProjectId);
                                <div class="mt-1.5 rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 p-2 text-[11px] text-amber-800 dark:text-amber-300" role="alert">
                                    Remove from this project? History is kept.@(open > 0 ? $" {open} open task(s) stay assigned and need review." : "")
                                    <div class="flex gap-1.5 mt-1.5">
                                        <button type="button" class="rounded-lg bg-red-600 hover:bg-red-700 px-2 py-1 text-[10px] font-semibold text-white disabled:opacity-50" disabled="@removing" @onclick="() => RemoveAsync(a.ProjectMemberId)">Confirm remove</button>
                                        <button type="button" class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-700 dark:text-slate-300" @onclick="() => removeConfirmId = null">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="mt-1 text-[10px] font-semibold text-red-600 hover:underline" @onclick="() => removeConfirmId = a.ProjectMemberId">Remove from project</button>
                            }
                        }
                    </div>
                }
            </div>
            <!-- Overall Task Performance Gauge -->
            <div class="pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
                <div class="flex items-center justify-between text-[11px] mb-1">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">Task Completion Rate</span>
                    <span class="font-bold text-slate-900 dark:text-slate-100">@Summary.CompletionRate% (@Summary.CompletedTasks.Count/@Summary.TotalTasks)</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
                    <div class="h-full rounded-full bg-emerald-500 transition-all duration-300"
                         @GetProgressWidthClass(Summary.CompletionRate)"></div>
                </div>
            </div>
        </div>

        <!-- Task Groups Accordion / Tabs -->
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                    Assigned Tasks (@Summary.TotalTasks)
                </h4>
                <div class="flex items-center gap-1 text-[11px]">
                    <span class="rounded-full bg-blue-100 text-blue-800 px-2 py-0.2 font-semibold">
                        @Summary.OngoingTasks.Count Ongoing
                    </span>
                    <span class="rounded-full bg-emerald-100 text-emerald-800 px-2 py-0.2 font-semibold">
                        @Summary.CompletedTasks.Count Done
                    </span>
                    <span class="rounded-full bg-purple-100 text-purple-800 px-2 py-0.2 font-semibold">
                        @Summary.ParkedTasks.Count Parked
                    </span>
                </div>
            </div>

            <!-- Group 1: Ongoing Tasks -->
            <div class="space-y-1.5">
                <span class="text-[11px] font-bold text-blue-700 dark:text-blue-400 block flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                    Ongoing Tasks (@Summary.OngoingTasks.Count)
                </span>
                @if (Summary.OngoingTasks.Count == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No active ongoing tasks.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var task in Summary.OngoingTasks)
                        {
                            <div @key="task.TaskId"
                                 class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-300 dark:hover:border-blue-700 transition cursor-pointer shadow-2xs group"
                                 @onclick="() => SelectTaskAsync(task)">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono text-[10px] text-blue-600 dark:text-blue-400 font-bold">@task.TaskReference</span>
                                            <span class="font-semibold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 transition truncate block">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            @task.ProjectName · @(task.StartDate?.ToString("dd MMM yyyy") ?? "No start") → @(task.ExpectedEndDate?.ToString("dd MMM yyyy") ?? "Open") · @task.Priority Priority
                                        </p>
                                    </div>
                                    <span class="font-bold text-xs text-slate-700 dark:text-slate-300 shrink-0">@task.Progress%</span>
                                </div>
                                <div class="w-full h-1.5 rounded-full bg-slate-100 dark:bg-slate-800 mt-2 overflow-hidden">
                                    <div class="h-full rounded-full bg-blue-600 @GetProgressWidthClass(task.Progress)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Group 2: Completed Tasks -->
            <div class="space-y-1.5 pt-1">
                <span class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400 block flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    Completed Tasks (@Summary.CompletedTasks.Count)
                </span>
                @if (Summary.CompletedTasks.Count == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No completed tasks yet.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var task in Summary.CompletedTasks)
                        {
                            <div @key="task.TaskId"
                                 class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-300 dark:hover:border-emerald-700 transition cursor-pointer shadow-2xs group"
                                 @onclick="() => SelectTaskAsync(task)">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-bold">@task.TaskReference</span>
                                            <span class="font-semibold text-xs text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 transition truncate block">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            Completed: @(task.ActualCompletionDate?.ToString("dd MMM yyyy") ?? "Delivered") · @task.ProjectName · @(task.StartDate?.ToString("dd MMM yyyy") ?? "No start") → @(task.ExpectedEndDate?.ToString("dd MMM yyyy") ?? "Open") · @task.Priority Priority
                                        </p>
                                    </div>
                                    <span class="rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 px-1.5 py-0.2 text-[9px] font-bold shrink-0">
                                        ✓ 100%
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Group 3: Parked / Paused Tasks -->
            <div class="space-y-1.5 pt-1">
                <span class="text-[11px] font-bold text-purple-700 dark:text-purple-400 block flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                    Parked / Paused Tasks (@Summary.ParkedTasks.Count)
                </span>
                @if (Summary.ParkedTasks.Count == 0)
                {
                    <p class="text-[11px] text-slate-400 italic p-2 bg-slate-50 dark:bg-slate-800/30 rounded-lg">No parked tasks.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var task in Summary.ParkedTasks)
                        {
                            <div @key="task.TaskId"
                                 class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-purple-300 dark:hover:border-purple-700 transition cursor-pointer shadow-2xs group"
                                 @onclick="() => SelectTaskAsync(task)">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono text-[10px] text-purple-600 dark:text-purple-400 font-bold">@task.TaskReference</span>
                                            <span class="font-semibold text-xs text-slate-900 dark:text-slate-100 group-hover:text-purple-600 transition truncate block">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            @task.ProjectName · @(task.StartDate?.ToString("dd MMM yyyy") ?? "No start") → @(task.ExpectedEndDate?.ToString("dd MMM yyyy") ?? "Open") · @task.Priority Priority
                                        </p>
                                    </div>
                                    <span class="rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 px-1.5 py-0.2 text-[9px] font-bold shrink-0">
                                        Parked
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Footer Action -->
    <div class="flex items-center justify-end pt-3 border-t border-slate-100 dark:border-slate-800">
        <button type="button"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                @onclick="CloseAsync">
            Close 360° View
        </button>
    </div>
</aside>

@code {
    [Parameter] public int StaffId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TeamProjectTaskDto> OnTaskClick { get; set; }
    [Parameter] public EventCallback<int> OnProjectClick { get; set; }
    [Parameter] public EventCallback OnAssignProject { get; set; }
    [Parameter] public EventCallback OnAssignTask { get; set; }
    [Parameter] public EventCallback OnAssignmentsChanged { get; set; }
    /// <summary>Incremented by the parent after an assignment is saved so the summary reloads.</summary>
    [Parameter] public int RefreshVersion { get; set; }

    private int lastRefreshVersion;
    private int? removeConfirmId;
    private bool removing;

    private Staff360SummaryDto? Summary;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (StaffId > 0 && (Summary == null || Summary.StaffId != StaffId || RefreshVersion != lastRefreshVersion))
        {
            lastRefreshVersion = RefreshVersion;
            await LoadStaff360Async();
        }
    }

    private async Task LoadStaff360Async()
    {
        loading = true;
        try
        {
            Summary = await TeamService.GetStaff360Async(StaffId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load 360 for staff {StaffId}", StaffId);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RemoveAsync(int projectMemberId)
    {
        removing = true;
        try
        {
            await TeamService.RemoveProjectAssignmentAsync(projectMemberId, null);
            ToastService.Success("Project assignment removed. History has been kept.");
            removeConfirmId = null;
            await LoadStaff360Async();
            await OnAssignmentsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to remove project assignment {Id}", projectMemberId);
            ToastService.Error(ex is UnauthorizedAccessException ? "You are not authorised to remove this assignment." : ex.Message);
        }
        finally { removing = false; }
    }

    private async Task CloseAsync() => await OnClose.InvokeAsync();

    private async Task SelectTaskAsync(TeamProjectTaskDto task) => await OnTaskClick.InvokeAsync(task);

    private static string GetProgressWidthClass(int progress) => progress switch
    {
        <= 0 => "w-0",
        <= 10 => "w-1/12",
        <= 20 => "w-2/12",
        <= 25 => "w-1/4",
        <= 33 => "w-4/12",
        <= 40 => "w-5/12",
        <= 50 => "w-1/2",
        <= 60 => "w-7/12",
        <= 70 => "w-8/12",
        <= 75 => "w-3/4",
        <= 80 => "w-10/12",
        <= 90 => "w-11/12",
        _ => "w-full"
    };

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "S";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}
