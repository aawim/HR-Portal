@using HRM.DTOs
@using HRM.Services.Interfaces
@inject ITeam TeamService
@inject ILogger<SearchTeamsModal> Logger

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 overflow-y-auto"
         role="dialog"
         aria-modal="true"
         aria-labelledby="search-teams-title"
         @onkeydown="HandleKeyDown"
         tabindex="0">
        <!-- Backdrop click target -->
        <div class="fixed inset-0" @onclick="CloseAsync" aria-hidden="true"></div>

        <div class="relative w-full max-w-xl rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-2xl space-y-4 max-h-[85vh] flex flex-col z-10"
             @onclick:stopPropagation>
            <!-- Header -->
            <div class="flex items-start justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                <div>
                    <h3 id="search-teams-title" class="text-base font-bold text-slate-900 dark:text-slate-100">
                        Search Teams in Organisation
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Discover supervised and authorised teams across your organisation.
                    </p>
                </div>
                <button type="button"
                        class="rounded-lg p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                        @onclick="CloseAsync"
                        aria-label="Close dialog">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Live Search Input -->
            <div class="relative w-full">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400 dark:text-slate-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text"
                       class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 py-2 pl-10 pr-9 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
                       placeholder="Type team name or Dhivehi title to search..."
                       @bind="query"
                       @bind:event="oninput"
                       @bind:after="TriggerSearchDebounced"
                       autofocus />
                @if (searching)
                {
                    <span class="absolute inset-y-0 right-3 flex items-center">
                        <span class="w-3.5 h-3.5 border-2 border-teal-600 border-t-transparent rounded-full animate-spin"></span>
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(query))
                {
                    <button type="button"
                            class="absolute inset-y-0 right-3 flex items-center text-slate-400 hover:text-slate-600 text-xs font-bold"
                            @onclick="ClearQuery">
                        ✕
                    </button>
                }
            </div>

            <!-- Results List -->
            <div class="flex-1 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800 min-h-[12rem] max-h-80 pr-1">
                @if (searching && teams.Count == 0)
                {
                    <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
                        <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                        Searching teams…
                    </div>
                }
                else if (teams.Count == 0)
                {
                    <div class="py-12 text-center text-xs text-slate-500 dark:text-slate-400">
                        <p class="font-semibold text-slate-700 dark:text-slate-300">No teams found</p>
                        <p class="text-[11px] mt-1 text-slate-400">Try adjusting your search query or view all available teams.</p>
                    </div>
                }
                else
                {
                    @foreach (var team in teams)
                    {
                        <div @key="team.TeamId"
                             class="p-3 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 rounded-xl transition cursor-pointer group"
                             @onclick="() => SelectTeamAsync(team.TeamId)">
                            <div class="min-w-0 pr-3">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition">
                                        @team.Name
                                    </h4>
                                    @if (team.IsMyTeam)
                                    {
                                        <span class="rounded bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800/40 px-1.5 py-0.2 text-[9px] font-bold">
                                            My Team
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(team.NameDhivehi))
                                {
                                    <p lang="dv" dir="rtl" class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                        @team.NameDhivehi
                                    </p>
                                }
                                <div class="flex items-center gap-3 text-[10px] text-slate-500 dark:text-slate-400 mt-1">
                                    <span>🏢 @team.OrganisationName</span>
                                    <span>👥 @team.MemberCount @(team.MemberCount == 1 ? "member" : "members")</span>
                                    @if (!string.IsNullOrWhiteSpace(team.LeadSupervisorName))
                                    {
                                        <span>👑 Supervisor: @team.LeadSupervisorName</span>
                                    }
                                </div>
                            </div>
                            <button type="button"
                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs group-hover:border-teal-500 group-hover:text-teal-600 transition shrink-0">
                                <span>Select</span>
                                <span>→</span>
                            </button>
                        </div>
                    }
                }
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
                <span class="text-[11px] text-slate-400">@teams.Count team(s) matching</span>
                <button type="button"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        @onclick="CloseAsync">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnTeamSelected { get; set; }

    private string query = "";
    private bool searching;
    private List<TeamSearchItemDto> teams = new();
    private CancellationTokenSource? searchCts;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && teams.Count == 0)
        {
            await ExecuteSearchAsync("");
        }
    }

    private void TriggerSearchDebounced()
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(300, token);
                if (token.IsCancellationRequested) return;

                await InvokeAsync(async () =>
                {
                    await ExecuteSearchAsync(query);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task ExecuteSearchAsync(string term)
    {
        searching = true;
        try
        {
            teams = await TeamService.SearchTeamsAsync(term) ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Live team search failed for {Query}", term);
            teams.Clear();
        }
        finally
        {
            searching = false;
        }
    }

    private void ClearQuery()
    {
        query = "";
        TriggerSearchDebounced();
    }

    private async Task SelectTeamAsync(int teamId)
    {
        await OnTeamSelected.InvokeAsync(teamId);
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        query = "";
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }
}
