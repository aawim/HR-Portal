    private int GetTeamPendingRequestsCount()
    {
        if (CurrentTeamStaffList.Count == 0) return 0;
        var teamStaffNames = CurrentTeamStaffList.Select(m => m.FullName.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var teamStaffIds = CurrentTeamStaffList.Select(m => m.StaffId).ToHashSet();

        return pendingLeaves.Count(l => teamStaffNames.Contains(l.Applicant?.Trim() ?? ""))
            + attendanceRequestsList.Count(a => (a.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || a.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase) || a.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase) || a.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase)) && teamStaffNames.Contains(a.StaffName?.Trim() ?? ""))
            + pendingDutyRequests.Count(d => teamStaffNames.Contains(d.Source?.Trim() ?? "") || teamStaffNames.Contains(d.Target?.Trim() ?? ""))
            + itemRequestsList.Count(r => (r.Status is "Submitted" or "ReturnRequested") && (teamStaffIds.Contains(r.IndividualId) || teamStaffNames.Contains(r.StaffName?.Trim() ?? "")))
            + certificateRequestsList.Count(c => (c.Status is "Submitted" or "UnderReview") && (teamStaffIds.Contains(c.IndividualId) || teamStaffNames.Contains(c.EmployeeName?.Trim() ?? "")));
    }

    private int GetTeamOnLeaveCount()
    {
        if (CurrentTeamStaffList.Count == 0) return 0;
        var teamStaffIds = CurrentTeamStaffList.Select(m => m.StaffId).ToHashSet();
        return todayAttendance.Count(a => teamStaffIds.Contains(a.StaffID) && a.Status is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave);
    }

