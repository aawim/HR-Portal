                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Documents ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Documents)">
                        Documents
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Schedule ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Schedule)">
                        Schedule
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.WorkTypes ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.WorkTypes)">
                        Work Types
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.StaffTransfer ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.StaffTransfer)">
                        Transfer
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r flex items-center gap-1.5 @(inspectedStaffTab == WorkspaceTab.Certificates ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Certificates)">
                        <span>Certificates</span>
                        @if (GetStaffPendingCertificatesCount(inspectedStaffId.Value) > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(inspectedStaffTab == WorkspaceTab.Certificates ? "bg-white/25 text-white" : "bg-amber-500 text-white")">
                                @GetStaffPendingCertificatesCount(inspectedStaffId.Value)
                            </span>
                        }
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.GoodsLoans ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.GoodsLoans)">
                        Goods loans
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Bank ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Bank)">
                        Bank details
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.EmergencyContact ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.EmergencyContact)">
                        Emergency contacts
                    </button>
                </nav>
            </div>

            <!-- Staff Workspace Body -->
            <div class="w-full min-w-0 flex flex-col gap-2">
                <StaffWorkspace StaffId="inspectedStaffId.Value" ActiveTab="inspectedStaffTab" OnRequestsChanged="RefreshRequestsAsync" />
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB: ORGANISATION WORKSPACE (Full Width Dedicated Organisation Workspace) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Organisation" && inspectedOrgId.HasValue)
    {
        <div class="flex flex-col gap-2 p-2">
            <!-- Organisation Workspace Header Bar -->
            <div class="org-workspace-header rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-2 shadow-xs flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-10 h-10 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-sm shadow-xs shrink-0">
                        @GetInitials(inspectedOrgName)
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">@inspectedOrgName</h2>
                            <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold">
                                Organisation Workspace
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            ID: #@inspectedOrgId · Departments, Teams, Staff, Roles, Permissions &amp; Documents
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                            @onclick="CloseOrganisationWorkspace">
                        ✕ Close Organisation View
                    </button>
                </div>
            </div>

            <!-- Full Organisation Sub-Tabs Bar (Folder Tabs with Lighter Green) -->
            <div class="org-workspace-tabs w-full border-b-2 border-emerald-600 dark:border-emerald-500 overflow-x-auto">
                <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Organisation Workspace Tabs">
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.Overview ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.Overview)">
                        Overview
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.Staff ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.Staff)">
                        Staff
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.Teams ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.Teams)">
                        Teams
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.AssignedRoles ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.AssignedRoles)">
                        Roles
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.Permissions ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.Permissions)">
                        Permissions
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.LeaveType ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.LeaveType)">
                        Leave Types
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedOrgTab == WorkspaceTab.Documents ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetOrgTab(WorkspaceTab.Documents)">
                        Documents
                    </button>
                </nav>
            </div>

            <!-- Organisation Workspace Body -->
            <div class="w-full min-w-0 flex flex-col gap-2">
                <OrganisationWorkspace OrganisationId="inspectedOrgId.Value" ActiveTab="inspectedOrgTab" OnStaffSelected="SelectSearchResult" OnLoaded="OnOrgLoaded" />
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 1: HOME (Responsive Three-Column Grid: 23% / 54% / 23%) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Home")
    {
        @if (loading && myTeams.Count == 0)
        {
            <div class="flex flex-col items-center justify-center p-12 my-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
                <div class="w-12 h-12 border-4 border-teal-600 border-t-transparent rounded-full animate-spin"></div>
                <p class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-200">Loading Workspace Dashboard...</p>
                <p class="text-xs text-slate-400 mt-0.5">Fetching supervised teams, tasks, and requests</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-2 p-2 xl:grid-cols-[minmax(0,23fr)_minmax(0,54fr)_minmax(0,23fr)] items-start">
            
            <!-- LEFT COLUMN (23%): My Team(s), Help Desk & Service Desk Team, My Team Requests -->
            <aside class="min-w-0 m-0 p-0 flex flex-col gap-2">
                
                <!-- Card 1: My Team(s) with clickable heading and clickable team items -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 transition group"
                         @onclick="NavigateToTeamsTab"
                         title="Click to open Teams tab">
                        <div class="flex items-center gap-1.5">
                            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition">
                                My Team(s)
                            </h2>
                            <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold group-hover:underline">
                                ↗ View Tab
                            </span>
                        </div>
                        <span class="rounded-full bg-teal-100 dark:bg-teal-950/60 px-2 py-0.2 text-[10px] font-bold text-teal-800 dark:text-teal-300">
                            @myTeams.Count
                        </span>
                    </div>
                    @if (myTeams.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500">No active supervised teams found.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-72 overflow-y-auto">
                            @foreach (var team in myTeams)
                            {
                                <div @key="team.TeamId"
                                     class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition cursor-pointer @(selectedTeamId == team.TeamId ? "bg-teal-50/40 dark:bg-teal-950/20" : "")"
                                     @onclick="() => NavigateToSpecificTeam(team.TeamId)">
                                    <div class="min-w-0 pr-2">
                                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate hover:text-teal-600">
                                            @team.Name
                                        </h3>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            @team.Staffs.Count Members · @team.Staffs.Count(s => s.IsSuperVisor) Supervisors
                                        </p>
                                    </div>
                                    <button type="button"
                                            class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium shrink-0"
                                            @onclick:stopPropagation
                                            @onclick="() => NavigateToSpecificTeam(team.TeamId)">
                                        Open →
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Card 2: Help Desk & Service Desk Team -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                                @(helpDeskTeam?.Name ?? "Help Desk & Service Desk Team")
                            </h2>
                        </div>
                        <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.2 text-[10px] font-bold text-emerald-800 dark:text-emerald-300">
                            Live Support
                        </span>
                    </div>
                    @if (helpDeskTeam == null || helpDeskTeam.Staffs.Count == 0)
                    {
                        <div class="p-3 text-xs text-slate-500 space-y-1">
                            <p class="font-medium text-slate-700 dark:text-slate-300">IT &amp; HR Service Desk</p>
                            <p class="text-[11px] text-slate-400">Direct Extension: #8800 · support@hrm.gov.mv</p>
                        </div>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-56 overflow-y-auto">
                            @foreach (var member in helpDeskTeam.Staffs)
                            {
                                <div @key="member.StaffId" class="p-2.5 flex items-center justify-between text-xs hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                                    <div class="min-w-0 pr-2">
                                        <div class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            <span class="font-semibold text-slate-900 dark:text-slate-100 truncate block">
                                                @member.FullName
                                            </span>
                                        </div>
                                        <span class="text-[10px] text-slate-500 dark:text-slate-400 ml-3 block">
                                            @(member.IsSuperVisor ? "Help Desk Lead" : "Support Officer")
                                        </span>
                                    </div>
                                    <a href="@($"/admin/my/workspace?entityType=Staff&entityId={member.StaffId}")"
                                       class="text-[10px] text-blue-600 dark:text-blue-400 hover:underline shrink-0">
                                        Profile ↗
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    <div class="p-2 bg-slate-50/60 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 text-[11px] text-center text-slate-500">
                        <span>Ext: <strong class="text-slate-700 dark:text-slate-300">8800</strong> · Hours: 08:00 - 16:00</span>
                    </div>
                </div>

                <!-- Card 3: My Team Requests -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
