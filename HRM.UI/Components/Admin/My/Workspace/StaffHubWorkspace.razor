                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Annual Leave</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    @pendingLeaves.Count(l => l.LeaveType.Contains("Annual", StringComparison.OrdinalIgnoreCase)) Pending
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("leave")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Sick Leave</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    @pendingLeaves.Count(l => l.LeaveType.Contains("Sick", StringComparison.OrdinalIgnoreCase)) Pending
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("leave")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Duty &amp; Roster</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    @pendingDutyRequests.Count Pending Swaps
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("duty")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Position Changes</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    In Approval Flow
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("position")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Employment Certificates</span>
                                <span class="text-[10px] @(CertificatesPendingCount > 0 ? "text-amber-600 dark:text-amber-400 font-bold" : "text-slate-500 dark:text-slate-400")">
                                    @CertificatesPendingCount Pending
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("certificates")'>
                                View
                            </button>
                        </div>
                    </div>
                </div>

            </aside>

            <!-- CENTER COLUMN (54%): Metric Cards & Live Operations -->
            <main class="min-w-0 m-0 p-0 flex flex-col gap-2">
                
                <!-- Metric Cards Row 1: Staff Count, Attendance, Sick Leave, Family Leave -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Staff Count</span>
                        <span class="text-3xl font-black text-slate-900 dark:text-slate-100">@TotalStaffCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Attendance</span>
                        <span class="text-3xl font-black text-emerald-600 dark:text-emerald-400">@PresentCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Sick Leave</span>
                        <span class="text-3xl font-black text-amber-600 dark:text-amber-400">@SickLeaveCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Family Leave</span>
                        <span class="text-3xl font-black text-purple-600 dark:text-purple-400">@FamilyLeaveCount</span>
                    </div>
                </div>

                <!-- Metric Cards Row 2: Total Leaves, Absents, Available Staff -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Total Leaves</span>
                        <span class="text-3xl font-black text-indigo-600 dark:text-indigo-400">@TotalLeavesCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Absents</span>
                        <span class="text-3xl font-black text-rose-600 dark:text-rose-400">@AbsentCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs text-center flex flex-col justify-center items-center min-h-[5.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Available Staff</span>
                        <span class="text-3xl font-black text-blue-600 dark:text-blue-400">@AvailableStaffCount</span>
                    </div>
                </div>

                <!-- Selected Team Roster Summary on Home -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs space-y-2">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
                        <div class="flex items-center gap-2">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                                @(selectedTeam?.Name ?? "Supervised Team Roster")
                            </h3>
                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                                @CurrentTeamStaffList.Count active staff
                            </span>
                        </div>
                        <button type="button"
                                class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                                @onclick="NavigateToTeamsTab">
                            Manage in Teams Tab →
                        </button>
                    </div>

                    @if (CurrentTeamStaffList.Count == 0)
                    {
                        <p class="py-6 text-center text-xs text-slate-500">No staff assigned to this team.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-64 overflow-y-auto">
                            @foreach (var staff in CurrentTeamStaffList)
                            {
                                <div @key="staff.StaffId" class="py-2 flex items-center justify-between text-xs hover:bg-slate-50 dark:hover:bg-slate-800/60 rounded-lg px-2 transition">
                                    <div class="flex items-center gap-2 min-w-0 pr-2">
                                        <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-800 font-bold flex items-center justify-center text-xs shrink-0">
                                            @GetInitials(staff.FullName)
                                        </div>
                                        <div class="min-w-0">
                                            <a href="@($"/admin/my/workspace/staff/{staff.StaffId}/overview")"
                                               class="font-semibold text-slate-900 dark:text-slate-100 hover:text-teal-600 dark:hover:text-teal-400 hover:underline block truncate"
                                               title="Open Staff Workspace">
                                                @staff.FullName
                                            </a>
                                            <span class="text-[10px] text-slate-500">ID: #@staff.StaffId · @(staff.IsSuperVisor ? "Supervisor" : "Member")</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <button type="button"
                                                class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50"
                                                @onclick="() => OpenMember360(staff.StaffId)">
                                            Inspect 360
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Embedded Entity Inspector (Organisation / Individual) -->
                @if (selectedEntityItem != null && activeWorkspaceTab == "Home")
                {
                    <div class="rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-2 shadow-md space-y-2">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 flex-wrap gap-2">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">@selectedEntityItem.EntityType Profile:</span>
                                <span class="font-semibold text-teal-700 dark:text-teal-300 text-sm">@selectedEntityItem.Name</span>
                                <span class="text-xs text-slate-500">(#@selectedEntityItem.Id)</span>
                            </div>
                            <button type="button"
                                    class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                                    @onclick="() => selectedEntityItem = null">
                                ✕ Close
                            </button>
                        </div>
                        <WorkspaceContent Item="selectedEntityItem" OnSelected="SelectSearchResult" ActiveTab="WorkspaceTab.Overview" />
                    </div>
                }


            </main>

            <!-- RIGHT COLUMN (23%): Recent Search & To Do -->
            <aside class="min-w-0 m-0 p-0 flex flex-col gap-2">
                
                <!-- Card 1: Recent Search -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800">
                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">Recent Search</h2>
                    </div>
                    @if (recentSearchItems.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500">No recent searches yet.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var item in recentSearchItems.Take(5))
                            {
                                <div @key="@($"{item.EntityType}-{item.Id}")"
                                     class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition cursor-pointer"
                                     @onclick="() => SelectSearchResult(item)">
                                    <div class="min-w-0 pr-2">
                                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">@item.Name</h3>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400">
                                            @(item.EntityType == WorkspaceEntityType.Organisation ? "Organisation" : "Employee")
                                        </p>
                                    </div>
                                    <span class="text-[10px] text-blue-600 dark:text-blue-400 font-semibold">Open →</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Card 2: To Do -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">To Do</h2>
                        <span class="text-[11px] text-slate-500 dark:text-slate-400">@todoItems.Count tasks</span>
                    </div>
                    @if (todoItems.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500">No open to-do tasks.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-64 overflow-y-auto">
                            @foreach (var todo in todoItems.Take(6))
                            {
                                <div @key="todo.Id" class="p-2.5 flex items-start justify-between gap-2 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                                    <div class="min-w-0">
                                        <h3 class="text-xs font-medium text-slate-900 dark:text-slate-100 break-words">@todo.Title</h3>
                                        @if (todo.DueDate.HasValue)
                                        {
                                            <p class="text-[10px] text-slate-500 dark:text-slate-400">
                                                Due: @todo.DueDate.Value.ToString("dd MMM yyyy")
                                            </p>
                                        }
                                    </div>
                                    <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold @(todo.Priority == "High" ? "bg-rose-100 text-rose-800" : "bg-slate-100 text-slate-700")">
                                        @todo.Priority
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

            </aside>

        </div>
        }
    }

    <!-- ======================================================== -->
    <!-- TAB 2: TEAMS (Master-Detail Grid with Contextual Panels) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "MyTeam")
    {
        <div class="flex flex-col gap-2 p-2">
            
            <!-- Teams Header with Search Teams Button -->
            <div class="flex items-center justify-between flex-wrap gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">Teams &amp; Projects Management Center</h2>
                        @if (selectedTeam != null)
                        {
                            <span class="rounded-full bg-teal-100 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 px-2.5 py-0.5 text-xs font-bold">
                                @selectedTeam.Name
                            </span>
                        }
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Manage supervised teams, member 360° work summaries, performance evaluations, and project deliverables.
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                            @onclick="() => showSearchTeamsModal = true">
                        <AppIcon Name="search" Class="w-3.5 h-3.5 text-slate-500 text-sm" />
                        <span>Search Teams</span>
                    </button>
                    <a href="/admin/settings/organisations/teams" class="rounded-lg bg-teal-700 hover:bg-teal-800 px-3 py-1.5 text-xs font-semibold text-white shadow-xs transition">
                        ⚙️ Teams Config
                    </a>
                </div>
            </div>

            <!-- 3-Column Layout:
                 Left:   Parent Teams with nested sub-teams (~22-25%)
                 Center: Team Members, Projects & Details (~45-48%)
                 Right:  360 View when open, or Creating Sub-Teams & Adding Staff when closed (~30-33%)
            -->
            <style>
                @@media (min-width: 1024px) {
                    .workspace-teams-grid-3col {
                        display: grid !important;
                        grid-template-columns: minmax(220px, 2.8fr) minmax(360px, 5.2fr) minmax(280px, 4fr) !important;
                    }
                    .workspace-teams-grid-2col {
                        display: grid !important;
                        grid-template-columns: minmax(220px, 2.8fr) minmax(0, 9.2fr) !important;
                    }
                    .workspace-teams-col-left {
                        grid-column: 1 !important;
                    }
                    .workspace-teams-col-center {
                        grid-column: 2 !important;
                    }
                    .workspace-teams-col-right {
                        grid-column: 3 !important;
                    }
                }
            </style>
            <div class="@(activeRightPanel != RightPanelType.None ? "workspace-teams-grid-3col" : "workspace-teams-grid-2col") grid grid-cols-1 lg:grid-cols-12 gap-2 p-2 items-start">
                
                <!-- COLUMN 1: Parent Teams on the left with Sub-Teams (~22% width) -->
                <aside class="workspace-teams-col-left col-span-12 lg:col-span-3 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs space-y-2">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
                        <div>
                            <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate" title="Teams Directory">
                                Parent Teams
                            </h3>
                            <p class="text-[10px] text-slate-400">@myTeams.Count team@(myTeams.Count == 1 ? "" : "s")</p>
                        </div>
                        @if (selectedSubTeamId.HasValue)
                        {
                            <button type="button"
                                    class="text-[10px] font-semibold text-teal-600 dark:text-teal-400 hover:underline px-1.5 py-0.5 rounded border border-teal-200 dark:border-teal-800 bg-teal-50/50 dark:bg-teal-950/40"
                                    @onclick="ClearSubTeamSelection"
                                    title="Clear sub-team filter">
                                Clear filter ✕
                            </button>
                        }
                    </div>

                    @if (myTeams.Count == 0)
                    {
                        <p class="py-6 text-center text-xs text-slate-500">No teams found.</p>
                    }
                    else
                    {
                        <div class="space-y-1.5 max-h-[42rem] overflow-y-auto pr-1">
                            @foreach (var team in myTeams)
                            {
                                var isTeamSelected = selectedTeamId == team.TeamId;
                                <div @key="team.TeamId" class="rounded-xl border transition @(isTeamSelected ? "border-teal-500 bg-teal-50/30 dark:bg-teal-950/20 shadow-xs ring-1 ring-teal-500/50" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700")">
                                    <!-- Parent Team Header / Button -->
                                    <button type="button"
                                            class="w-full text-left p-2 rounded-t-xl text-xs transition cursor-pointer flex flex-col gap-1"
                                            @onclick="() => SelectTeamAsync(team.TeamId)">
                                        <div class="flex items-center justify-between gap-1">
                                            <h4 class="font-bold text-slate-900 dark:text-slate-100 truncate text-xs" title="@team.Name">@team.Name</h4>
                                            <span class="rounded bg-teal-100 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 px-1.5 py-0.2 text-[10px] font-bold shrink-0 whitespace-nowrap">
                                                @team.SubTeamCount @(team.SubTeamCount == 1 ? "sub-team" : "sub-teams")
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(team.NameDhivehi))
                                        {
                                            <p lang="dv" dir="rtl" class="text-[10px] text-slate-400 truncate">@team.NameDhivehi</p>
                                        }
                                        <div class="flex items-center justify-between text-[10px] text-slate-500">
                                            <span>@team.Staffs.Count member@(team.Staffs.Count == 1 ? "" : "s")</span>
                                            <span>@team.Staffs.Count(s => s.IsSuperVisor) sup</span>
                                        </div>
                                    </button>

                                    <!-- Nested Sub-Teams under Selected Parent Team -->
                                    @if (isTeamSelected)
                                    {
                                        <div class="border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/30 p-1.5 rounded-b-xl space-y-1">
                                            <div class="flex items-center justify-between px-1 pb-1">
                                                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Sub-teams</span>
                                                @if (currentSubTeamWorkspace?.CanManage == true)
                                                {
                                                    <button type="button"
                                                            class="text-[10px] font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                                                            @onclick="OpenCreateSubTeam">
                                                        + New
                                                    </button>
                                                }
                                            </div>

                                            @if (loadingSubTeams)
                                            {
                                                <div class="py-2 text-center text-[10px] text-slate-400">Loading sub-teams…</div>
                                            }
                                            else if (currentSubTeamWorkspace?.SubTeams == null || !currentSubTeamWorkspace.SubTeams.Any(st => st.IsActive))
                                            {
                                                <div class="py-2 text-center text-[10px] text-slate-400">
                                                    No sub-teams yet.
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="w-full text-left px-2 py-1 rounded-lg text-[11px] font-semibold transition cursor-pointer flex items-center justify-between @(!selectedSubTeamId.HasValue && activeRightPanel != RightPanelType.SubTeamStaff ? "bg-teal-700 text-white shadow-2xs" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")"
                                                        @onclick="ClearSubTeamSelection">
                                                    <span>All Members</span>
                                                    <span class="text-[10px] opacity-80">@team.Staffs.Count</span>
                                                </button>

                                                @foreach (var st in currentSubTeamWorkspace.SubTeams.Where(st => st.IsActive))
                                                {
                                                    var isSubSelected = selectedSubTeamId == st.TeamId && activeRightPanel == RightPanelType.SubTeamStaff;
                                                    <button type="button" @key="st.TeamId"
                                                            class="w-full text-left px-2 py-1 rounded-lg text-[11px] font-semibold transition cursor-pointer flex items-center justify-between @(isSubSelected ? "bg-teal-700 text-white shadow-2xs" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")"
                                                            @onclick="() => OpenSubTeamStaff(st.TeamId)">
                                                        <span class="truncate pr-1" title="@st.Name">@st.Name</span>
                                                        <span class="text-[10px] opacity-80 shrink-0">@st.Members.Count</span>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </aside>

                <!-- COLUMN 2: Selected Team Members & Projects -->
                <section class="workspace-teams-col-center col-span-12 @(activeRightPanel != RightPanelType.None ? "lg:col-span-5" : "lg:col-span-9") min-w-0 space-y-2">
                    @if (selectedTeam == null)
                    {
                        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-12 text-center text-xs text-slate-500">
                            Select a team from the list to view members and projects.
                        </div>
                    }
                    else
                    {
                        <!-- Team Info Summary Banner -->
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs space-y-2">
                            <div class="flex items-center justify-between flex-wrap gap-2">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">@selectedTeam.Name</h3>
                                        @if (selectedSubTeam != null)
                                        {
                                            <span class="rounded-full bg-teal-100 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 px-2 py-0.2 text-[10px] font-bold">
                                                Sub-Team: @selectedSubTeam.Name
                                            </span>
                                        }
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                        @CurrentTeamStaffList.Count assigned personnel · @currentTeamProjects.Count active projects
                                        @if (currentSubTeamWorkspace?.SubTeams != null)
                                        {
                                            <span> · @currentSubTeamWorkspace.SubTeams.Count(st => st.IsActive) sub-teams</span>
                                        }
                                    </p>
                                </div>
                                <!-- Subtabs: Members, Projects, Attendance, Request, Schedule, Leaves -->
                                <div class="flex flex-wrap items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 p-0.5 bg-slate-100 dark:bg-slate-800 text-xs">
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition @(teamCenterSubTab == "members" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => SetTeamCenterSubTab("members")'>
                                        Members (@CurrentTeamStaffList.Count)
                                    </button>
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition @(teamCenterSubTab == "projects" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => SetTeamCenterSubTab("projects")'>
                                        Projects (@currentTeamProjects.Count)
                                    </button>
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition flex items-center gap-1.5 @(teamCenterSubTab is "attendance" or "attendace" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => SetTeamCenterSubTab("attendance")'>
                                        <span>Attendance</span>
                                    </button>
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition flex items-center gap-1.5 @(teamCenterSubTab is "requests" or "request" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => SetTeamCenterSubTab("requests")'>
                                        <span>Request</span>
                                        @if (GetTeamPendingRequestsCount() > 0)
                                        {
                                            <span class="rounded-full bg-amber-500 text-white px-1.5 py-0.2 text-[10px] font-bold">
                                                @GetTeamPendingRequestsCount()
                                            </span>
                                        }
                                    </button>
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition flex items-center gap-1.5 @(teamCenterSubTab == "schedule" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => SetTeamCenterSubTab("schedule")'>
                                        <span>Schedule</span>
                                    </button>
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition flex items-center gap-1.5 @(teamCenterSubTab is "leaves" or "leave" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => SetTeamCenterSubTab("leaves")'>
                                        <span>Leaves</span>
                                        @if (GetTeamOnLeaveCount() > 0)
                                        {
                                            <span class="rounded-full bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 px-1.5 py-0.2 text-[10px] font-bold">
                                                @GetTeamOnLeaveCount()
                                            </span>
                                        }
                                    </button>
                                </div>
                            </div>

                            <!-- SUB-TAB 1: MEMBERS TABLE WITH ACTIONS -->
                            @if (teamCenterSubTab == "members")
                            {
                                @if (selectedSubTeam != null)
                                {
                                    <div class="flex items-center justify-between rounded-xl bg-teal-50/70 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800/40 p-2 text-xs">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-bold text-teal-900 dark:text-teal-200">Filtered by Sub-Team:</span>
                                            <span class="font-semibold text-teal-800 dark:text-teal-300">@selectedSubTeam.Name</span>
                                            <span class="text-slate-500">(@CurrentTeamStaffList.Count members)</span>
                                        </div>
                                        <button type="button" class="text-[11px] font-semibold text-teal-700 dark:text-teal-300 hover:underline" @onclick="ClearSubTeamSelection">
                                            Clear filter ✕
                                        </button>
                                    </div>
                                }
                                @if (CurrentTeamStaffList.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500">No members assigned to this team.</div>
                                }
                                else
                                {
                                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                        <table class="w-full text-left text-xs">
                                            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                                <tr>
                                                    <th class="p-2.5">Member</th>
                                                    <th class="p-2.5">Sub-Team</th>
                                                    <th class="p-2.5">Role</th>
                                                    <th class="p-2.5">Today Attendance</th>
<th class="p-2.5">Projects</th>
                                                    <th class="p-2.5 text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                @foreach (var member in CurrentTeamStaffList)
                                                {
                                                    var att = GetTodayAttendance(member.StaffId);
                                                    var subTeamName = GetMemberSubTeamName(member.StaffId);
                                                    var memberProjects = GetMemberProjects(member.StaffId);
                                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition">
                                                        <td class="p-2.5">
                                                            <div class="flex items-center gap-2">
                                                                <div class="w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 font-bold flex items-center justify-center text-xs shrink-0">
                                                                    @GetInitials(member.FullName)
                                                                </div>
                                                                <div>
                                                                    <a href="@($"/admin/my/workspace/staff/{member.StaffId}/overview")"
                                                                       class="font-bold text-slate-900 dark:text-slate-100 hover:text-teal-600 dark:hover:text-teal-400 hover:underline block"
                                                                       title="Open Staff Workspace">
                                                                        @member.FullName
                                                                    </a>
                                                                    <span class="text-[10px] text-slate-500">ID: #@member.StaffId</span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="p-2.5">
                                                            @if (!string.IsNullOrWhiteSpace(subTeamName))
                                                            {
                                                                <span class="inline-flex items-center rounded-md bg-teal-50 dark:bg-teal-950/60 px-2 py-0.5 text-[11px] font-semibold text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800/50">
                                                                    @subTeamName
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-slate-400 dark:text-slate-500 text-xs">—</span>
                                                            }
                                                        </td>
                                                        <td class="p-2.5">
                                                            <span class="rounded px-2 py-0.5 text-[10px] font-semibold @(member.IsSuperVisor ? "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                                                                @(member.IsSuperVisor ? "Supervisor" : "Member")
                                                            </span>
                                                        </td>
                                                        <td class="p-2.5">
                                                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @GetAttendanceBadgeClass(att?.Status)">
                                                                @(att != null ? att.Status.ToString() : "Not Clocked")
                                                            </span>
                                                        </td>
                                                        <td class="p-2.5">
                                                            @if (memberProjects.Count == 0)
                                                            {
                                                                <span class="text-slate-400 dark:text-slate-500">—</span>
                                                            }
                                                            else
                                                            {
                                                                <div class="flex flex-col gap-1">
                                                                    @foreach (var project in memberProjects)
                                                                    {
                                                                        var assignment = project.Members.First(m => m.StaffId == member.StaffId);
                                                                        <button type="button"
                                                                                class="max-w-40 truncate text-left text-[11px] font-semibold text-teal-700 hover:underline dark:text-teal-300"
                                                                                title="@($"{project.Name} · {assignment.Role}")"
                                                                                @onclick="() => OpenProjectDetails(project.ProjectId)">
                                                                            @project.Name <span class="font-normal text-slate-500 dark:text-slate-400">· @assignment.Role</span>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            }
                                                        </td>
                                                        <td class="p-2.5 text-right">
                                                            <div class="relative inline-flex">
                                                                <button type="button"
                                                                        class="app-button app-button-ghost app-button-sm app-button-icon"
                                                                        aria-label="Actions for @member.FullName"
                                                                        title="More actions"
                                                                        @onclick="() => ToggleMemberActionsMenu(member.StaffId)">
                                                                    <AppIcon Name="more_horiz" Class="text-base" />
                                                                </button>
                                                                @if (memberActionsMenuStaffId == member.StaffId)
                                                                {
                                                                    <div class="absolute right-0 top-full z-30 mt-1 w-40 rounded-xl border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                                                                        <button type="button" class="w-full rounded-lg px-2 py-1.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="() => { memberActionsMenuStaffId = null; OpenMember360(member.StaffId); }">View 360</button>
                                                                        <button type="button" class="w-full rounded-lg px-2 py-1.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="() => { memberActionsMenuStaffId = null; OpenMemberEvaluation(member.StaffId, member.FullName); }">Evaluation</button>
                                                                        <button type="button" class="w-full rounded-lg px-2 py-1.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="() => { memberActionsMenuStaffId = null; OpenAssignment(AssignmentModal.AssignmentMode.Project, member.StaffId, member.FullName); }">Assign project</button>
                                                                        <button type="button" class="w-full rounded-lg px-2 py-1.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800" @onclick="() => { memberActionsMenuStaffId = null; OpenAssignment(AssignmentModal.AssignmentMode.Task, member.StaffId, member.FullName); }">Assign task</button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }

                            <!-- SUB-TAB 2: PROJECTS LIST -->
                            @if (teamCenterSubTab == "projects")
                            {
                                @if (!IsSupervisorOfCurrentTeam)
                                {
                                    <div class="rounded-2xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/40 p-8 text-center space-y-2 my-2">
                                        <div class="text-3xl">🔒</div>
                                        <h4 class="font-bold text-sm text-amber-900 dark:text-amber-200">Restricted Project Access</h4>
                                        <p class="text-xs text-amber-700 dark:text-amber-300 max-w-md mx-auto">
                                            Only supervisors of this team or department are authorized to view and manage projects and tasks.
                                        </p>
                                    </div>
                                }
                                else
                                {
                                <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200 dark:border-slate-800 flex-wrap gap-2">
                                    <div>
                                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                            <span>📁 Team Projects</span>
                                            <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800/40 px-2 py-0.2 text-[10px] font-semibold">
                                                @currentTeamProjects.Count active
                                            </span>
                                        </h3>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                                            Manage deliverables, milestones, and member assignments.
                                        </p>
                                    </div>
                                    <button type="button"
                                            class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 text-white px-3 py-1.5 text-xs font-semibold shadow-xs transition"
                                            @onclick="OpenCreateProjectModal">
                                        <span>+ Add Project</span>
                                    </button>
                                </div>

                                @if (loadingProjects)
                                {
                                    <div class="py-12 text-center text-xs text-slate-500">
                                        <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                                        Loading team projects…
                                    </div>
                                }
                                else if (currentTeamProjects.Count == 0)
                                {
                                    <div class="py-12 text-center text-xs text-slate-500 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800 p-8 space-y-2">
                                        <div class="w-12 h-12 rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 flex items-center justify-center mx-auto text-xl font-bold">
                                            📁
                                        </div>
                                        <h4 class="font-bold text-sm text-slate-800 dark:text-slate-200">No active projects linked to this team</h4>
                                        <p class="text-xs text-slate-500 max-w-md mx-auto">
                                            Create a project to define deliverables, set milestones, and assign tasks to your team members.
                                        </p>
                                        <div class="pt-2">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 text-white px-4 py-2 text-xs font-semibold shadow-xs transition"
                                                    @onclick="OpenCreateProjectModal">
                                                + Create Project
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                        @foreach (var proj in currentTeamProjects)
                                        {
                                            <div @key="proj.ProjectId"
                                                 class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 space-y-2.5 shadow-2xs hover:shadow-xs hover:border-teal-500 dark:hover:border-teal-500 transition cursor-pointer @(selectedProjectId == proj.ProjectId ? "ring-2 ring-teal-500" : "")"
                                                 @onclick="() => OpenProjectDetails(proj.ProjectId)">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="min-w-0">
                                                        <div class="flex items-center gap-1.5 mb-1">
                                                            <span class="font-mono text-[10px] font-bold text-blue-700 bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/40 px-1.5 py-0.2 rounded">
                                                                @proj.Reference
                                                            </span>
                                                            <span class="rounded px-2 py-0.2 text-[10px] font-bold @GetStatusBadgeClass(proj.Status)">
                                                                @proj.Status
                                                            </span>
                                                        </div>
                                                        <h4 class="font-bold text-xs text-slate-900 dark:text-slate-100 truncate">
                                                            @proj.Name
                                                        </h4>
                                                    </div>
                                                    <span class="font-black text-xs text-teal-700 dark:text-teal-400 shrink-0">
                                                        @proj.ProgressPercentage%
                                                    </span>
                                                </div>

                                                <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
                                                    @proj.Description
                                                </p>

                                                <!-- Progress Bar -->
                                                <div class="w-full h-1.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                                    <div class="h-full rounded-full bg-teal-600 @GetProgressWidthClass(proj.ProgressPercentage)"></div>
                                                </div>

                                                <!-- Tasks Breakdown -->
                                                <div class="flex items-center justify-between text-[10px] text-slate-500 pt-1 border-t border-slate-100 dark:border-slate-800">
                                                    <span>Tasks: <strong>@proj.TotalTaskCount</strong></span>
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-blue-600 font-semibold">@proj.OngoingTaskCount Ongoing</span>
                                                        <span>·</span>
                                                        <span class="text-emerald-600 font-semibold">@proj.CompletedTaskCount Done</span>
                                                        <span>·</span>
                                                        <span class="text-purple-600 font-semibold">@proj.ParkedTaskCount Parked</span>
                                                    </div>
                                                </div>

                                                <div class="flex items-center justify-between pt-1">
                                                    <span class="text-[10px] text-slate-400">
                                                        Mgr: @(!string.IsNullOrWhiteSpace(proj.ProjectManagerName) ? proj.ProjectManagerName : "Unassigned")
                                                    </span>
                                                    <button type="button"
                                                            class="text-[11px] font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                                                            @onclick:stopPropagation
                                                            @onclick="() => OpenProjectDetails(proj.ProjectId)">
                                                        View Details →
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                }
                            }

                            <!-- SUB-TAB 3: ATTENDANCE -->
                            @if (teamCenterSubTab is "attendance" or "attendace")
                            {
                                var teamStaffIds = CurrentTeamStaffList.Select(s => s.StaffId).ToHashSet();
                                var teamAttendance = todayAttendance.Where(a => (selectedTeamId.HasValue && a.TeamID == selectedTeamId.Value) || teamStaffIds.Contains(a.StaffID)).ToList();

                                var pCount = CurrentTeamStaffList.Count(m => (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.Present);
                                var lCount = CurrentTeamStaffList.Count(m => (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.Late);
                                var mcCount = CurrentTeamStaffList.Count(m => (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.MissingCheckout);
                                var olCount = CurrentTeamStaffList.Count(m => (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave);
                                var abCount = CurrentTeamStaffList.Count(m => (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.Absent);

                                <!-- Attendance Summary Cards -->
                                <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                                    <button type="button" class="p-2.5 rounded-xl border text-left transition cursor-pointer @(teamAttendanceFilter == "present" ? "border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 ring-1 ring-emerald-500" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-slate-100")"
                                            @onclick='() => teamAttendanceFilter = (teamAttendanceFilter == "present" ? "all" : "present")'>
                                        <div class="text-lg font-black text-emerald-600 dark:text-emerald-400">@pCount</div>
                                        <div class="text-[10px] font-semibold text-slate-500">Present</div>
                                    </button>
                                    <button type="button" class="p-2.5 rounded-xl border text-left transition cursor-pointer @(teamAttendanceFilter == "late" ? "border-amber-500 bg-amber-50 dark:bg-amber-950/40 ring-1 ring-amber-500" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-slate-100")"
                                            @onclick='() => teamAttendanceFilter = (teamAttendanceFilter == "late" ? "all" : "late")'>
                                        <div class="text-lg font-black text-amber-600 dark:text-amber-400">@lCount</div>
                                        <div class="text-[10px] font-semibold text-slate-500">Late</div>
                                    </button>
                                    <button type="button" class="p-2.5 rounded-xl border text-left transition cursor-pointer @(teamAttendanceFilter == "missing" ? "border-sky-500 bg-sky-50 dark:bg-sky-950/40 ring-1 ring-sky-500" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-slate-100")"
                                            @onclick='() => teamAttendanceFilter = (teamAttendanceFilter == "missing" ? "all" : "missing")'>
                                        <div class="text-lg font-black text-sky-600 dark:text-sky-400">@mcCount</div>
                                        <div class="text-[10px] font-semibold text-slate-500">Missing Checkout</div>
                                    </button>
                                    <button type="button" class="p-2.5 rounded-xl border text-left transition cursor-pointer @(teamAttendanceFilter == "leave" ? "border-purple-500 bg-purple-50 dark:bg-purple-950/40 ring-1 ring-purple-500" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-slate-100")"
                                            @onclick='() => teamAttendanceFilter = (teamAttendanceFilter == "leave" ? "all" : "leave")'>
                                        <div class="text-lg font-black text-purple-600 dark:text-purple-400">@olCount</div>
                                        <div class="text-[10px] font-semibold text-slate-500">On Leave</div>
                                    </button>
                                    <button type="button" class="p-2.5 rounded-xl border text-left transition cursor-pointer @(teamAttendanceFilter == "absent" ? "border-rose-500 bg-rose-50 dark:bg-rose-950/40 ring-1 ring-rose-500" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-slate-100")"
                                            @onclick='() => teamAttendanceFilter = (teamAttendanceFilter == "absent" ? "all" : "absent")'>
                                        <div class="text-lg font-black text-rose-600 dark:text-rose-400">@abCount</div>
                                        <div class="text-[10px] font-semibold text-slate-500">Absent</div>
                                    </button>
                                </div>

                                <!-- Search & Quick Actions -->
                                <div class="flex items-center justify-between flex-wrap gap-2 pt-1">
                                    <div class="relative w-full max-w-xs">
                                        <input class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400"
                                               placeholder="Filter members..."
                                               @bind="teamAttendanceSearch"
                                               @bind:event="oninput" />
                                    </div>
                                    @if (teamAttendanceFilter != "all")
                                    {
                                        <button type="button" class="text-xs text-teal-700 dark:text-teal-400 font-semibold hover:underline"
                                                @onclick='() => teamAttendanceFilter = "all"'>
                                            Clear Filter (@teamAttendanceFilter)
                                        </button>
                                    }
                                </div>

                                <!-- Attendance Table -->
                                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                            <tr>
                                                <th class="p-2.5">Member</th>
                                                <th class="p-2.5">Role</th>
                                                <th class="p-2.5">Clock In</th>
                                                <th class="p-2.5">Clock Out</th>
                                                <th class="p-2.5">Status</th>
                                                <th class="p-2.5 text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                            @foreach (var member in CurrentTeamStaffList.Where(m =>
                                                (string.IsNullOrWhiteSpace(teamAttendanceSearch) || m.FullName.Contains(teamAttendanceSearch, StringComparison.OrdinalIgnoreCase)) &&
                                                (teamAttendanceFilter == "all" ||
                                                 (teamAttendanceFilter == "present" && (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.Present) ||
                                                 (teamAttendanceFilter == "late" && (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.Late) ||
                                                 (teamAttendanceFilter == "missing" && (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.MissingCheckout) ||
                                                 (teamAttendanceFilter == "leave" && ((teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave)) ||
                                                 (teamAttendanceFilter == "absent" && (teamAttendance.FirstOrDefault(a => a.StaffID == m.StaffId)?.Status ?? GetTodayAttendance(m.StaffId)?.Status) == AttendanceStatus.Absent)
                                                )))
                                            {
                                                var att = teamAttendance.FirstOrDefault(a => a.StaffID == member.StaffId) ?? GetTodayAttendance(member.StaffId);
                                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition">
                                                    <td class="p-2.5">
                                                        <div class="flex items-center gap-2">
                                                            <div class="w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 font-bold flex items-center justify-center text-xs shrink-0">
                                                                @GetInitials(member.FullName)
                                                            </div>
                                                            <div>
                                                                <a href="@($"/admin/my/workspace/staff/{member.StaffId}/overview")"
                                                                   class="font-bold text-slate-900 dark:text-slate-100 hover:text-teal-600 dark:hover:text-teal-400 hover:underline block"
                                                                   title="Open Staff Workspace">
                                                                    @member.FullName
                                                                </a>
                                                                <span class="text-[10px] text-slate-500">ID: #@member.StaffId</span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="p-2.5">
                                                        <span class="rounded px-2 py-0.5 text-[10px] font-semibold @(member.IsSuperVisor ? "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                                                            @(member.IsSuperVisor ? "Supervisor" : "Member")
                                                        </span>
                                                    </td>
                                                    <td class="p-2.5">
                                                        <span class="font-medium text-slate-800 dark:text-slate-200">
                                                            @(att?.CheckIn.HasValue == true ? att.CheckIn.Value.ToString("hh:mm tt") : "—")
                                                        </span>
                                                    </td>
                                                    <td class="p-2.5">
                                                        <span class="font-medium text-slate-800 dark:text-slate-200">
                                                            @(att?.CheckOut.HasValue == true ? att.CheckOut.Value.ToString("hh:mm tt") : "—")
                                                        </span>
                                                    </td>
                                                    <td class="p-2.5">
                                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @GetAttendanceBadgeClass(att?.Status)">
                                                            @(att != null ? att.Status.ToString() : "Not Clocked")
                                                        </span>
                                                    </td>
                                                    <td class="p-2.5 text-right">
                                                        <div class="inline-flex items-center gap-1">
                                                            <button type="button"
                                                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                                                    @onclick="() => OpenMember360(member.StaffId)">
                                                                View 360
                                                            </button>
                                                            <a href="@($"/admin/my/workspace/staff/{member.StaffId}/attendance")"
                                                               class="inline-flex items-center gap-1 rounded-lg border border-teal-300 dark:border-teal-700 bg-teal-50 dark:bg-teal-950/50 px-2 py-1 text-[11px] font-semibold text-teal-700 dark:text-teal-300 shadow-2xs hover:bg-teal-100 dark:hover:bg-teal-900/60 transition"
                                                               title="Open Staff Attendance">
                                                                Attendance &gt;
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <!-- SUB-TAB 4: REQUEST -->
                            @if (teamCenterSubTab is "requests" or "request")
                            {
                                var teamStaffNames = CurrentTeamStaffList.Select(m => m.FullName.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
                                var teamStaffIds = CurrentTeamStaffList.Select(m => m.StaffId).ToHashSet();

                                var tLeaves = pendingLeaves.Where(l => teamStaffNames.Contains(l.Applicant?.Trim() ?? "")).ToList();
                                var tAtt = attendanceRequestsList.Where(a => (a.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || a.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase) || a.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase) || a.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase)) && teamStaffNames.Contains(a.StaffName?.Trim() ?? "")).ToList();
                                var tDuties = pendingDutyRequests.Where(d => teamStaffNames.Contains(d.Source?.Trim() ?? "") || teamStaffNames.Contains(d.Target?.Trim() ?? "")).ToList();
                                var tItems = itemRequestsList.Where(r => (r.Status is "Submitted" or "ReturnRequested") && (teamStaffIds.Contains(r.IndividualId) || teamStaffNames.Contains(r.StaffName?.Trim() ?? ""))).ToList();
                                var tCerts = certificateRequestsList.Where(c => (c.Status is "Submitted" or "UnderReview") && (teamStaffIds.Contains(c.IndividualId) || teamStaffNames.Contains(c.EmployeeName?.Trim() ?? ""))).ToList();

                                var totalRequests = tLeaves.Count + tAtt.Count + tDuties.Count + tItems.Count + tCerts.Count;

                                <!-- Category Filter Pills -->
                                <div class="flex flex-wrap items-center gap-1.5 border-b border-slate-100 dark:border-slate-800 pb-2">
                                    <button type="button" class="rounded-lg px-2.5 py-1 text-xs font-bold transition @(teamRequestFilter == "all" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                                            @onclick='() => teamRequestFilter = "all"'>
                                        All (@totalRequests)
                                    </button>
                                    <button type="button" class="rounded-lg px-2.5 py-1 text-xs font-bold transition @(teamRequestFilter == "leaves" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                                            @onclick='() => teamRequestFilter = "leaves"'>
                                        Leaves (@tLeaves.Count)
                                    </button>
                                    <button type="button" class="rounded-lg px-2.5 py-1 text-xs font-bold transition @(teamRequestFilter == "attendance" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                                            @onclick='() => teamRequestFilter = "attendance"'>
                                        Attendance (@tAtt.Count)
                                    </button>
                                    <button type="button" class="rounded-lg px-2.5 py-1 text-xs font-bold transition @(teamRequestFilter == "items" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                                            @onclick='() => teamRequestFilter = "items"'>
                                        Equipment (@tItems.Count)
                                    </button>
                                    <button type="button" class="rounded-lg px-2.5 py-1 text-xs font-bold transition @(teamRequestFilter == "certificates" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                                            @onclick='() => teamRequestFilter = "certificates"'>
                                        Certificates (@tCerts.Count)
                                    </button>
                                    <button type="button" class="rounded-lg px-2.5 py-1 text-xs font-bold transition @(teamRequestFilter == "duties" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                                            @onclick='() => teamRequestFilter = "duties"'>
                                        Duty Swaps (@tDuties.Count)
                                    </button>
                                </div>

                                @if (totalRequests == 0)
                                {
                                    <div class="py-10 text-center text-xs text-slate-500">
                                        No pending requests for members of this team.
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-2">
                                        @if (teamRequestFilter is "all" or "leaves")
                                        {
                                            @foreach (var req in tLeaves)
                                            {
                                                <div @key="@($"leave-{req.RequestId}")" class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between flex-wrap gap-2 hover:border-teal-400 transition">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center text-xs">🌴</div>
                                                        <div>
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@req.Applicant</span>
                                                                <span class="rounded bg-purple-50 text-purple-700 border border-purple-200 px-1.5 py-0.2 text-[10px] font-semibold">@req.LeaveType</span>
                                                            </div>
                                                            <p class="text-[11px] text-slate-500 mt-0.5">
                                                                @req.FromDate.ToString("dd MMM yyyy") – @req.ToDate.ToString("dd MMM yyyy") (@req.Duration days) · @req.Reason
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-bold">@req.Status</span>
                                                        <button type="button"
                                                                class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-xs font-semibold text-white transition shadow-2xs"
                                                                @onclick="() => ReviewTeamLeave(req)">
                                                            Review &gt;
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        @if (teamRequestFilter is "all" or "attendance")
                                        {
                                            @foreach (var req in tAtt)
                                            {
                                                <div @key="@($"att-{req.RequestId}")" class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between flex-wrap gap-2 hover:border-teal-400 transition">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-xs">⏰</div>
                                                        <div>
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@req.StaffName</span>
                                                                <span class="rounded bg-blue-50 text-blue-700 border border-blue-200 px-1.5 py-0.2 text-[10px] font-semibold">@req.Kind</span>
                                                            </div>
                                                            <p class="text-[11px] text-slate-500 mt-0.5">
                                                                @req.ClockTime.ToString("dd MMM yyyy, hh:mm tt") (@req.Mode) · Ref: @req.Reference
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-bold">@req.Status</span>
                                                        <button type="button"
                                                                class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-xs font-semibold text-white transition shadow-2xs"
                                                                @onclick="() => ReviewTeamAttendance(req)">
                                                            Review &gt;
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        @if (teamRequestFilter is "all" or "items")
                                        {
                                            @foreach (var req in tItems)
                                            {
                                                var itemSummary = req.Lines.Count > 0 ? string.Join(", ", req.Lines.Select(l => $"{l.Quantity}x {l.ItemName}")) : req.Kind;
                                                <div @key="@($"item-{req.RequestId}")" class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between flex-wrap gap-2 hover:border-teal-400 transition">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">📦</div>
                                                        <div>
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@req.StaffName</span>
                                                                <span class="rounded bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.2 text-[10px] font-semibold">@itemSummary</span>
                                                            </div>
                                                            <p class="text-[11px] text-slate-500 mt-0.5">
                                                                Purpose: @req.Purpose · Status: @req.Status
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-bold">@req.Status</span>
                                                        <button type="button"
                                                                class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-xs font-semibold text-white transition shadow-2xs"
                                                                @onclick="() => ReviewTeamItem(req)">
                                                            Review &gt;
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        @if (teamRequestFilter is "all" or "certificates")
                                        {
                                            @foreach (var req in tCerts)
                                            {
                                                <div @key="@($"cert-{req.CertificateRequestId}")" class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between flex-wrap gap-2 hover:border-teal-400 transition">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-xs">📜</div>
                                                        <div>
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@req.EmployeeName</span>
                                                                <span class="rounded bg-indigo-50 text-indigo-700 border border-indigo-200 px-1.5 py-0.2 text-[10px] font-semibold">@req.CertificateType</span>
                                                            </div>
                                                            <p class="text-[11px] text-slate-500 mt-0.5">
                                                                Requested: @req.CreatedAt.ToString("dd MMM yyyy") · Purpose: @req.Purpose
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-bold">@req.Status</span>
                                                        <button type="button"
                                                                class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-xs font-semibold text-white transition shadow-2xs"
                                                                @onclick="ReviewTeamCertificates">
                                                            Review &gt;
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        @if (teamRequestFilter is "all" or "duties")
                                        {
                                            @foreach (var req in tDuties)
                                            {
                                                <div @key="@($"duty-{req.RequestId}")" class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between flex-wrap gap-2 hover:border-teal-400 transition">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 text-teal-700 font-bold flex items-center justify-center text-xs">🔄</div>
                                                        <div>
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@req.Source → @req.Target</span>
                                                                <span class="rounded bg-teal-50 text-teal-700 border border-teal-200 px-1.5 py-0.2 text-[10px] font-semibold">@req.Kind</span>
                                                            </div>
                                                            <p class="text-[11px] text-slate-500 mt-0.5">
                                                                Ref: @req.Reference · Status: @req.Status
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <a href="/admin/hr/work-planning/duty-roster?tab=requests"
                                                           class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-xs font-semibold text-white transition shadow-2xs">
                                                            Manage Roster &gt;
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            }

                            <!-- SUB-TAB 5: SCHEDULE -->
                            @if (teamCenterSubTab == "schedule")
                            {
                                @if (selectedTeamScheduleStaffId.HasValue)
                                {
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 transition"
                                                    @onclick="() => selectedTeamScheduleStaffId = null">
                                                ← Back to Team Roster
                                            </button>
                                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">
                                                Individual Staff Schedule
                                            </span>
                                        </div>
                                        <Schedule @key="selectedTeamScheduleStaffId.Value" StaffId="selectedTeamScheduleStaffId.Value" />
                                    </div>
                                }
                                else
                                {
                                    <!-- Date Navigator Toolbar -->
                                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                                        <div class="flex items-center gap-1.5">
                                            <button type="button"
                                                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition"
                                                    disabled="@loadingTeamSchedule"
                                                    @onclick="() => ChangeTeamScheduleDateAsync(-1)">
                                                ‹ Prev Day
                                            </button>
                                            <button type="button"
                                                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition"
                                                    disabled="@loadingTeamSchedule"
                                                    @onclick="SetTeamScheduleDateTodayAsync">
                                                Today
                                            </button>
                                            <button type="button"
                                                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition"
                                                    disabled="@loadingTeamSchedule"
                                                    @onclick="() => ChangeTeamScheduleDateAsync(1)">
                                                Next Day ›
                                            </button>
                                            <span class="font-bold text-xs text-slate-900 dark:text-slate-100 ml-1">
                                                @teamScheduleDate.ToString("dddd, dd MMM yyyy")
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition"
                                                    disabled="@loadingTeamSchedule"
                                                    @onclick="LoadTeamScheduleAsync">
                                                <span class="@(loadingTeamSchedule ? "animate-spin" : "")">↻</span>
                                                <span>Refresh</span>
                                            </button>
                                            <a href="/admin/hr/work-planning/duty-roster"
                                               class="rounded-lg bg-teal-700 hover:bg-teal-800 px-3 py-1 text-xs font-semibold text-white transition shadow-2xs">
                                                Duty Roster Admin &gt;
                                            </a>
                                        </div>
                                    </div>

                                    @if (loadingTeamSchedule)
                                    {
                                        <div class="py-12 text-center text-xs text-slate-500">
                                            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                                            Loading team schedule for @teamScheduleDate.ToString("dd MMM yyyy")…
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(teamScheduleError))
                                    {
                                        <div class="p-4 rounded-xl border border-amber-200 bg-amber-50 text-xs text-amber-800">
                                            @teamScheduleError
                                        </div>
                                    }
                                    else if (teamDutyRoster.Count == 0)
                                    {
                                        <div class="py-10 text-center text-xs text-slate-500 space-y-2">
                                            <p>No duty assignments or shifts scheduled for this team on @teamScheduleDate.ToString("dd MMM yyyy").</p>
                                            <p class="text-[11px] text-slate-400">Click below to view individual schedules or manage duty rosters.</p>
                                            <div class="flex justify-center gap-2 pt-2">
                                                <a href="/admin/hr/work-planning/duty-roster" class="text-xs text-teal-700 font-semibold hover:underline">
                                                    Open Duty Roster Admin →
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                            <table class="w-full text-left text-xs">
                                                <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                                    <tr>
                                                        <th class="p-2.5">Member</th>
                                                        <th class="p-2.5">Duty / Shift</th>
                                                        <th class="p-2.5">Timing</th>
                                                        <th class="p-2.5">Attendance</th>
                                                        <th class="p-2.5 text-right">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                    @foreach (var row in teamDutyRoster)
                                                    {
                                                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition">
                                                            <td class="p-2.5 font-bold text-slate-900 dark:text-slate-100">
                                                                <div class="flex items-center gap-2">
                                                                    <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-xs shrink-0">
                                                                        @GetInitials(row.Staff)
                                                                    </div>
                                                                    <div>
                                                                        <span class="block">@row.Staff</span>
                                                                        <span class="text-[10px] text-slate-500">@row.Department</span>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="p-2.5">
                                                                <span class="rounded bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[11px] font-bold">
                                                                    @row.Duty
                                                                </span>
                                                            </td>
                                                            <td class="p-2.5 whitespace-nowrap text-slate-700 dark:text-slate-300">
                                                                @row.Start.ToString("HH:mm") – @row.End.ToString("HH:mm")
                                                            </td>
                                                            <td class="p-2.5">
                                                                <span class="text-[10px] font-medium text-slate-600 dark:text-slate-400">
                                                                    @(row.RequiresAttendance ? "Check-in required" : "Optional")
                                                                    @(row.RequiresCheckout ? " · Checkout required" : "")
                                                                </span>
                                                            </td>
                                                            <td class="p-2.5">
                                                             <span class="text-slate-400 dark:text-slate-500 text-xs">—</span>
                                                         </td>
                                                         <td class="p-2.5 text-right">
                                                                <button type="button"
                                                                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 transition"
                                                                        @onclick="() => selectedTeamScheduleStaffId = row.IndividualId">
                                                                    Full Schedule
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            }

                            <!-- SUB-TAB 6: LEAVES -->
                            @if (teamCenterSubTab is "leaves" or "leave")
                            {
                                var teamStaffNames = CurrentTeamStaffList.Select(m => m.FullName.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
                                var teamStaffIds = CurrentTeamStaffList.Select(m => m.StaffId).ToHashSet();

                                var membersOnLeave = CurrentTeamStaffList.Where(m =>
                                {
                                    var att = todayAttendance.FirstOrDefault(a => a.StaffID == m.StaffId) ?? GetTodayAttendance(m.StaffId);
                                    return att?.Status is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave;
                                }).ToList();

                                var teamPendingLeaves = pendingLeaves.Where(l => teamStaffNames.Contains(l.Applicant?.Trim() ?? "")).ToList();

                                if (selectedTeamLeaveStaffId.HasValue)
                                {
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 transition"
                                                    @onclick="() => selectedTeamLeaveStaffId = null">
                                                ← Back to Team Leaves Summary
                                            </button>
                                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">
                                                Staff Leave Manager
                                            </span>
                                        </div>
                                        <HRM.Components.Admin.My.Workspace.Staff.Tabs.StaffLeave @key="selectedTeamLeaveStaffId.Value" StaffId="selectedTeamLeaveStaffId.Value" />
                                    </div>
                                }
                                else
                                {
                                    <!-- Summary Header -->
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                        <div class="p-3.5 rounded-xl border border-purple-200 dark:border-purple-800/40 bg-purple-50/50 dark:bg-purple-950/20 flex items-center justify-between">
                                            <div>
                                                <div class="text-lg font-black text-purple-700 dark:text-purple-300">@membersOnLeave.Count</div>
                                                <div class="text-xs font-semibold text-slate-600 dark:text-slate-400">On Leave Today</div>
                                            </div>
                                            <span class="text-2xl">🌴</span>
                                        </div>
                                        <div class="p-3.5 rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50/50 dark:bg-amber-950/20 flex items-center justify-between">
                                            <div>
                                                <div class="text-lg font-black text-amber-700 dark:text-amber-300">@teamPendingLeaves.Count</div>
                                                <div class="text-xs font-semibold text-slate-600 dark:text-slate-400">Pending Leave Applications</div>
                                            </div>
                                            <span class="text-2xl">📋</span>
                                        </div>
                                    </div>

                                    <!-- Section 1: Members on Leave Today -->
                                    <div class="space-y-2 pt-2">
                                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Members on Leave Today</h4>
                                        @if (membersOnLeave.Count == 0)
                                        {
                                            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 text-xs text-slate-500 text-center">
                                                All @CurrentTeamStaffList.Count team members are scheduled to be active today. No one is on leave.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                                @foreach (var m in membersOnLeave)
                                                {
                                                    var att = todayAttendance.FirstOrDefault(a => a.StaffID == m.StaffId) ?? GetTodayAttendance(m.StaffId);
                                                    <div class="p-2.5 rounded-xl border border-purple-200 dark:border-purple-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between">
                                                        <div class="flex items-center gap-2">
                                                            <div class="w-7 h-7 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center text-xs">
                                                                @GetInitials(m.FullName)
                                                            </div>
                                                            <div>
                                                                <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@m.FullName</span>
                                                                <span class="rounded px-1.5 py-0.2 text-[10px] font-bold @GetAttendanceBadgeClass(att?.Status)">
                                                                    @(att?.Status.ToString() ?? "On Leave")
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <button type="button"
                                                                class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 transition"
                                                                @onclick="() => selectedTeamLeaveStaffId = m.StaffId">
                                                            Leave History
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Section 2: Pending Leave Requests -->
                                    <div class="space-y-2 pt-2">
                                        <div class="flex items-center justify-between">
                                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Pending Leave Requests (@teamPendingLeaves.Count)</h4>
                                        </div>
                                        @if (teamPendingLeaves.Count == 0)
                                        {
                                            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 text-xs text-slate-500 text-center">
                                                No pending leave applications for this team.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="space-y-2">
                                                @foreach (var req in teamPendingLeaves)
                                                {
                                                    <div @key="@($"tleave-{req.RequestId}")" class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs flex items-center justify-between flex-wrap gap-2 hover:border-teal-400 transition">
                                                        <div class="flex items-center gap-2.5">
                                                            <div class="w-8 h-8 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center text-xs">🌴</div>
                                                            <div>
                                                                <div class="flex items-center gap-1.5">
                                                                    <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@req.Applicant</span>
                                                                    <span class="rounded bg-purple-50 text-purple-700 border border-purple-200 px-1.5 py-0.2 text-[10px] font-semibold">@req.LeaveType</span>
                                                                </div>
                                                                <p class="text-[11px] text-slate-500 mt-0.5">
                                                                    @req.FromDate.ToString("dd MMM yyyy") – @req.ToDate.ToString("dd MMM yyyy") (@req.Duration days) · @req.Reason
                                                                </p>
                                                            </div>
                                                        </div>
                                                        <div class="flex items-center gap-2">
                                                            <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-bold">@req.Status</span>
                                                            <button type="button"
                                                                    class="rounded-lg bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-xs font-semibold text-white transition shadow-2xs"
                                                                    @onclick="() => ReviewTeamLeave(req)">
                                                                Review &gt;
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </section>

                <!-- COLUMN 3: Right Panel: 360 View, Sub-Team Staff, or New Sub-Team Creator (~30% width) -->
                @if (activeRightPanel != RightPanelType.None)
                {
                    <aside class="workspace-teams-col-right col-span-12 lg:col-span-4 min-w-0 space-y-2">
                        @if (activeRightPanel == RightPanelType.Member360 && inspectedStaffId.HasValue)
                        {
                            <Member360Panel StaffId="inspectedStaffId.Value"
                                            OnClose="CloseRightPanel"
                                            OnTaskClick="OpenTaskModal"
                                            OnProjectClick="OpenProjectDetails"
                                            OnAssignProject="() => OpenAssignment(AssignmentModal.AssignmentMode.Project, inspectedStaffId!.Value, inspectedStaffName)"
                                            OnAssignTask="() => OpenAssignment(AssignmentModal.AssignmentMode.Task, inspectedStaffId!.Value, inspectedStaffName)"
                                            OnAssignmentsChanged="RefreshAssignmentViewsAsync"
                                            OnOpenEvaluation="id => OpenMemberEvaluation(id, inspectedStaffName)"
                                            RefreshVersion="assignmentRefresh" />
                        }
                        else if (activeRightPanel == RightPanelType.Evaluation && evalStaffId.HasValue)
                        {
                            <MemberEvaluationPanel StaffId="evalStaffId.Value"
                                                   StaffName="@evalStaffName"
                                                   OnClose="CloseRightPanel"
                                                   OnEvaluationSaved="RefreshRequestsAsync" />
                        }
                        else if (activeRightPanel == RightPanelType.ProjectDetails && selectedProjectId.HasValue)
                        {
                            <ProjectDetailPanel ProjectId="selectedProjectId.Value"
                                                OnClose="CloseRightPanel"
                                                OnTaskClick="OpenTaskModal"
                                                OnAssignmentsChanged="RefreshAssignmentViewsAsync" />
                        }
                        else if (activeRightPanel == RightPanelType.SubTeamStaff && selectedTeam != null)
                        {
                            <div class="min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs">
                                <SubTeamManagement ParentTeamId="selectedTeam.TeamId"
                                                   SelectedSubTeamId="selectedSubTeamId"
                                                   CompactMode="true"
                                                   CreateModeOnly="false"
                                                   OnClose="CloseRightPanel"
                                                   OnSubTeamSelected="HandleRightPanelSubTeamSelected"
                                                   OnSubTeamsChanged="OnSubTeamsChangedAsync" />
                            </div>
                        }
                        else if (activeRightPanel == RightPanelType.CreateSubTeam && selectedTeam != null)
                        {
                            <div class="min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs">
                                <SubTeamManagement ParentTeamId="selectedTeam.TeamId"
                                                   CompactMode="true"
                                                   CreateModeOnly="true"
                                                   OnClose="CloseRightPanel"
                                                   OnSubTeamSelected="HandleRightPanelSubTeamSelected"
                                                   OnSubTeamsChanged="OnSubTeamsChangedAsync" />
                            </div>
                        }
                    </aside>
                }

            </div>

        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 3: CALENDARS                                         -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Calendar")
    {
        <WorkspaceCalendarCard />
    }

    <!-- ======================================================== -->
    <!-- TAB 4: REQUEST (Team Requests & Approvals Queue)        -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Request")
    {
        <div class="flex flex-col gap-2 p-2">
            <!-- Header Area -->
            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 gap-2 shadow-xs flex items-center justify-between flex-wrap">
                <div>
                    <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">Organisation Requests &amp; Approvals Command Center</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Review and manage all organisation requests: leaves, attendance corrections, duty swaps, overtime, time changes, equipment, and certificates.</p>
                </div>
                <button type="button" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-teal-700 dark:text-teal-400 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer transition" @onclick="RefreshRequestsAsync">
                    <span>↻ Refresh Queue</span>
                </button>
            </div>

            <!-- Horizontal Request Tabs -->
            <nav class="flex flex-wrap items-center gap-1.5 border-b border-slate-200 dark:border-slate-800 pb-2" aria-label="Request Categories">
                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "leave" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("leave")'>
                    <AppIcon Name="calendar_month" Class="w-4 h-4 text-base" />
                    <span>Leave Requests</span>
                    @if (pendingLeaves.Count > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "leave" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @pendingLeaves.Count
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "attendance" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("attendance")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Attendance Requests</span>
                    @if (AttendancePendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "attendance" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @AttendancePendingCount
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "uneven-log" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("uneven-log")'>
                    <AppIcon Name="warning" Class="w-4 h-4 text-base" />
                    <span>Uneven Log Requests</span>
                    @if (UnevenLogPendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "uneven-log" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @UnevenLogPendingCount
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "duty" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("duty")'>
                    <AppIcon Name="refresh" Class="w-4 h-4 text-base" />
                    <span>Duty &amp; Roster</span>
                    @if (pendingDutyRequests.Count > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "duty" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @pendingDutyRequests.Count
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "overtime" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("overtime")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    <span>Overtime</span>
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "late" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("late")'>
                    <AppIcon Name="warning" Class="w-4 h-4 text-base" />
                    <span>Late Check-In</span>
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "position" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("position")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    <span>Position Changes</span>
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "job-items" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("job-items")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    <span>Job-Related Equipment</span>
                    @if (JobItemsPendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "job-items" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @JobItemsPendingCount
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "personal-items" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("personal-items")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                    <span>Personal Items &amp; Supplies</span>
                    @if (PersonalItemsPendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "personal-items" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @PersonalItemsPendingCount
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "certificates" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("certificates")'>
                    <AppIcon Name="description" Class="w-4 h-4 text-base" />
                    <span>Employment Certificates</span>
                    @if (CertificatesPendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "certificates" ? "bg-white/20 text-white" : "bg-amber-500 text-white")">
                            @CertificatesPendingCount
                        </span>
                    }
                </button>
            </nav>

            <!-- Two-Column Workspace Layout (Left: Form to approve & details, Right: All requests) -->
            @if (activeReqSubTab is "leave" or "attendance" or "uneven-log" or "duty" or "job-items" or "personal-items" or "certificates")
            {
                <div class="grid grid-cols-1 xl:grid-cols-12 gap-2 p-2 items-start w-full">
                    
                    <!-- ======================================================== -->
                    <!-- LEFT PANEL (5 cols): FORM TO APPROVE & DETAILS           -->
                    <!-- ======================================================== -->
                    <aside class="col-span-12 xl:col-span-5 flex flex-col gap-2 min-w-0">
                        @if (activeReqSubTab == "leave")
                        {
                            @if (selectedLeave != null)
                            {
                                <div class="rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-2 shadow-xs sticky top-4">
                                    <LeaveRequestDetails @key="selectedLeave.RequestId"
                                                         Item="selectedLeave"
                                                         Busy="executingAction"
                                                         Message="@leaveActionMessage"
                                                         OnClose="() => selectedLeave = null"
                                                         OnExecute="ExecuteLeaveActionAsync"
                                                         OnChanged="RefreshRequestsAsync" />
                                </div>
                            }
                            else
                            {
                                <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center shadow-xs">
                                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 mb-3 border border-teal-200 dark:border-teal-800/40">
                                        <AppIcon Name="description" Class="h-6 w-6 text-2xl" />
                                    </div>
                                    <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">No Leave Request Selected</h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs mx-auto">
                                        Select any pending leave request from the queue on the right to inspect applicant details, balances, and take approval actions.
                                    </p>
                                </div>
                            }
                        }
                        else if (activeReqSubTab is "attendance" or "uneven-log")
                        {
                            @if (selectedAttendanceRequest != null)
                            {
                                <div class="rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-2 shadow-xs flex flex-col gap-2 sticky top-4">
                                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
                                        <div>
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
                                                @(activeReqSubTab == "uneven-log" ? "Uneven Log Correction" : "Attendance Request")
                                            </span>
                                            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@selectedAttendanceRequest.StaffName</h3>
                                        </div>
                                        <button type="button" class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer" @onclick="() => selectedAttendanceRequest = null">✕</button>
                                    </div>

