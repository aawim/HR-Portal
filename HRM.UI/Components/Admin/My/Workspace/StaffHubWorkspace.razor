                            @onclick="() => SetStaffTab(WorkspaceTab.PersonalItems)">
                        <span>Personal Items</span>
                        @if (GetStaffPendingPersonalItemsCount(inspectedStaffId.Value, inspectedStaffName) > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(inspectedStaffTab == WorkspaceTab.PersonalItems ? "bg-white/25 text-white" : "bg-amber-500 text-white")">
                                @GetStaffPendingPersonalItemsCount(inspectedStaffId.Value, inspectedStaffName)
                            </span>
