    private async Task SelectAttendanceRequest(AttendanceRequestRow row)
    {
        selectedAttendanceRequest = row;
        attendanceActionComment = string.Empty;
        attendanceReviewError = null;
        try
        {
            attendanceReview = await AttendanceReviewService.GetAsync(row.RequestId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching attendance review details");
            attendanceReviewError = "Failed to load approval actions.";
        }
    }

    private async Task ActAttendanceRequest(string action)
    {
        if (selectedAttendanceRequest == null || attendanceReview == null || attendanceActing) return;
        attendanceActing = true;
        attendanceReviewError = null;
        try
        {
            var result = await AttendanceReviewService.ActAsync(selectedAttendanceRequest.RequestId, attendanceReview.StateId, action, attendanceActionComment);
            if (result.Success)
            {
                ToastService.Success(result.Message ?? $"Attendance request {action.ToLowerInvariant()}d successfully.");
                selectedAttendanceRequest = null;
                attendanceReview = null;
                await RefreshRequestsAsync();
            }
            else
            {
                attendanceReviewError = result.Message ?? "Failed to perform action.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing action on attendance request");
            attendanceReviewError = ex.Message;
        }
        finally
        {
            attendanceActing = false;
        }
    }

    private void OpenRequestTab(string subTab)
    {
        activeWorkspaceTab = "Request";
        SetReqSubTab(subTab);
        UpdateUrl();
    }

    private async Task ExecuteLeaveActionAsync(RequestActionSubmissionDto action)
    {
        if (selectedLeave == null || executingAction) return;
        executingAction = true;
        leaveActionMessage = null;
        var reqId = selectedLeave.RequestId;
        try
        {
            var result = await Leaves.ExecuteLeaveActionAsync(reqId, action);
            leaveActionMessage = result.Message;
            if (result.Success)
            {
                ToastService.Success(result.Message);
                selectedLeave = null;
                await RefreshRequestsAsync();
            }
            else
            {
                ToastService.Error(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to act on leave request {RequestId}", reqId);
            leaveActionMessage = "Action execution failed. Check logs.";
            ToastService.Error(leaveActionMessage);
        }
        finally
        {
            executingAction = false;
        }
    }

    private async Task SelectSearchResult(WorkspaceSearchResult item)
    {
        try
        {
            await RecentSearches.RememberAsync(item);
            recentSearchItems = await RecentSearches.GetAsync() ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to remember recent search");
        }

        if (item.EntityType == WorkspaceEntityType.Staff)
        {
            selectedEntityItem = null;
            inspectedStaffId = item.Id;
            inspectedStaffName = !string.IsNullOrWhiteSpace(item.Name) ? item.Name : (allTeamStaff.FirstOrDefault(s => s.StaffId == item.Id)?.FullName ?? $"Staff #{item.Id}");
            inspectedStaffTab = WorkspaceTab.Overview;
            activeWorkspaceTab = "Staff";
            UpdateUrl();
            StateHasChanged();
        }
        else
        {
            inspectedStaffId = null;
            selectedEntityItem = item;
            activeWorkspaceTab = "Home";
            UpdateUrl();
            StateHasChanged();
        }
    }

    // Position Change Workflow
    private async Task OpenPositionChangeModal(int staffId, string staffName)
    {
        posModalStaffId = staffId;
        posModalStaffName = staffName;
        posModalError = null;
        loadingPositionData = true;
        showPositionChangeModal = true;
        posJobId = 0;
        posSelectedFrameworkId = 0;
        posSelectedMatrixId = 0;
        posSelectedPositionId = 0;
        posSelectedJobMatrixStepId = null;
        posFromDate = DateTime.Today.AddDays(1);
        posReason = "";

        try
        {
            posData = await PositionService.LoadAsync(staffId);
            posCurrentAssignment = posData.Assignments.FirstOrDefault(a => a.StateId == 4 && (!a.To.HasValue || a.To.Value.Date >= DateTime.Today));
            posJobId = posCurrentAssignment?.JobId ?? posData.Jobs.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load positions for modal {StaffId}", staffId);
            posModalError = "Unable to load position options for this staff member. Please retry.";
        }
        finally
        {
            loadingPositionData = false;
        }
    }

    private void ClosePositionChangeModal()
    {
        showPositionChangeModal = false;
        posData = null;
        posCurrentAssignment = null;
    }

    private void OnPosFrameworkChanged()
    {
        posSelectedMatrixId = 0;
        posSelectedPositionId = 0;
        posSelectedJobMatrixStepId = null;
    }

    private void OnPosMatrixChanged()
    {
        posSelectedPositionId = 0;
        posSelectedJobMatrixStepId = null;
    }

    private async Task SubmitPositionChangeAsync()
    {
        if (submittingPosChange || !posModalStaffId.HasValue || posData == null) return;

        if (posJobId == 0)
        {
            posModalError = "Please select an employment contract.";
            return;
        }

        if (posSelectedFrameworkId == 0 || posSelectedMatrixId == 0 || posSelectedPositionId == 0)
        {
            posModalError = "Please select a framework, matrix, and vacant position slot.";
            return;
        }

        if (string.IsNullOrWhiteSpace(posReason))
        {
            posModalError = "Please provide a reason / justification for this position change.";
            return;
        }

        submittingPosChange = true;
        posModalError = null;

        try
        {
            await PositionService.SaveAsync(
                posModalStaffId.Value,
                posJobId,
                posSelectedPositionId,
                posFromDate,
                null,
                posReason,
                posCurrentAssignment,
                change: true,
                remove: false,
                posSelectedJobMatrixStepId,
                terminationRequestTypeId: null
            );

            ToastService.Success("Position change request submitted for approval.");
            ClosePositionChangeModal();

            activeWorkspaceTab = "Request";
            activeReqSubTab = "position";
            UpdateUrl();
            await RefreshRequestsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit position change for staff {StaffId}", posModalStaffId);
            posModalError = ex.Message;
        }
        finally
        {
            submittingPosChange = false;
        }
    }

    private TeamAttendanceDto? GetTodayAttendance(int staffId)
    {
        return todayAttendance.FirstOrDefault(a => a.StaffID == staffId);
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "S";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetAttendanceBadgeClass(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40",
        AttendanceStatus.Late => "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40",
        AttendanceStatus.Absent => "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800/40",
        AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave => "bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40",
        AttendanceStatus.MissingCheckout => "bg-sky-100 text-sky-800 dark:bg-sky-950/60 dark:text-sky-300 border border-sky-200 dark:border-sky-800/40",
