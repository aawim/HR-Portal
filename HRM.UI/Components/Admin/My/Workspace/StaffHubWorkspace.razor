@page "/admin/my/workspace"
@page "/admin/my/workspace/{ActiveSection}"
@page "/admin/my/workspace/{EntityRoute}/{EntityId:int}/{ActiveSection}"
@page "/admin/my/workspace/hub"
@page "/admin/my/workspace/team-hub"
@page "/admin/my/workspace-hub"
@page "/admin/my/workspace/v2"
@page "/admin/my/workspace/hub/{ActiveSection}"
@using HRM.DTOs
@using HRM.DTOs.Leave
@using HRM.DTOs.WorkPlanning
@using HRM.Enum
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Components.Admin.My.Workspace.Cards
@using HRM.Components.Admin.My.Workspace.Staff
@using HRM.Components.Admin.My.Workspace.Staff.Tabs
@using HRM.Components.Admin.My.Workspace.Teams
@using static HRM.Services.Contracts.StaffPositionManagementServiceContracts
@using HRM.Application.Contracts.Pages
@inject ITeam TeamService
@inject HRM.Application.Contracts.Pages.IAttendanceRequestQueries AttendanceQueries
@inject HRM.Application.Contracts.Pages.IAttendanceRequestReview AttendanceReviewService
@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService
@inject ILeaveChangeService Leaves
@inject HRM.WorkPlanning.Services.Contracts.DutyRosterServiceContracts.IOperations Duties
@inject HRM.Services.Contracts.StaffPositionManagementServiceContracts.IOperations PositionService
@inject IWorkspaceDirectoryService Directory
@inject HRM.Services.Contracts.WorkspaceRecentSearchServiceContracts.IOperations RecentSearches
@inject IUserTodoService Todos
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<StaffHubWorkspace> Logger
@inject HRM.Services.ToastService ToastService
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer

<PageTitle>Admin Workspace - HR Portal</PageTitle>

<section class="my-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-all duration-300 @(isFullWidth ? "max-w-none" : "max-w-7xl mx-auto")">
    
    <!-- Top Header Area Matching HRM.UI Standard -->
    <div class="my-workspace-header staff-overview-no-print flex flex-col gap-2 p-2">
        <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Admin Workspace</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Management dashboard for supervised teams, employee evaluations, projects, and workforce requests.</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        @onclick="ToggleFullWidthAsync">
                    <span>@(isFullWidth ? "⤢ Shrink View" : "⤡ Full Width")</span>
                </button>
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        disabled="@loading"
                        @onclick="RefreshAllAsync">
                    <span class="@(loading ? "animate-spin" : "")">↻</span>
                    <span>Refresh</span>
                </button>

            </div>
        </div>

        <!-- Workspace Directory Search (Using Standard Workspace Directory Search Component) -->
        <div class="relative w-full max-w-xl">
            <WorkspaceSearch OnSelected="SelectSearchResult" />
        </div>
    </div>

    <!-- Solid Folder Navigation Tabs -->
    <div class="my-workspace-tabs staff-overview-no-print w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
        <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Workspace Tabs">
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Home" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("Home")'>
                Home
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "MyTeam" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("MyTeam")'>
                Teams (@myTeams.Count)
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Calendar" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("Calendar")'>
                Calendars
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Request" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("Request")'>
                Request (@TotalPendingRequestsCount)
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Onboarding" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("Onboarding")'>
                Onboarding
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "LeaveLog" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("LeaveLog")'>
                Leave Log
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Attendance" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("Attendance")'>
                Attendance
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "TimeChange" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("TimeChange")'>
                Time Change
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "OrgDaily" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                    @onclick='() => SetActiveTab("OrgDaily")'>
                Org Daily
            </button>
            @if (inspectedStaffId.HasValue)
            {
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Staff" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#86b0be]/60")"
                        @onclick='() => SetActiveTab("Staff")'>
                    👤 @inspectedStaffName
                </button>
            }
        </nav>
    </div>

    <!-- ======================================================== -->
    <!-- TAB: STAFF WORKSPACE (Full Width Dedicated Employee Workspace) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Staff" && inspectedStaffId.HasValue)
    {
        <div class="flex flex-col gap-2 p-2">
            <!-- Staff Workspace Header Bar -->
            <div class="staff-workspace-header staff-overview-no-print rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex items-center justify-between flex-wrap gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-sm shadow-xs shrink-0">
                        @GetInitials(inspectedStaffName)
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">@inspectedStaffName</h2>
                            <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold">
                                Staff Workspace
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            ID: #@inspectedStaffId · Complete Employee Records, Attendance, Leaves, Positions &amp; Performance
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 px-3 py-1.5 text-xs font-bold text-white shadow-xs transition"
                            @onclick="() => OpenPositionChangeModal(inspectedStaffId.Value, inspectedStaffName)">
                        ⚡ Change Position
                    </button>
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                            @onclick="CloseStaffWorkspace">
                        ✕ Close Staff View
                    </button>
                </div>
            </div>

            <!-- Full Staff Sub-Tabs Bar (Folder Tabs with Lighter Green) -->
            <div class="staff-workspace-tabs staff-overview-no-print w-full border-b-2 border-emerald-600 dark:border-emerald-500 overflow-x-auto">
                <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Staff Workspace Tabs">
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Overview ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Overview)">
                        Overview
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Performance ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Performance)">
                        Performance
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Leave ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Leave)">
                        Leave
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Attendance ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Attendance)">
                        Attendance
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Position ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Position)">
                        Positions
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Finance ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Finance)">
                        Finance
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.OT ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.OT)">
                        Overtime
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.JobRelatedItems ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.JobRelatedItems)">
                        Job Items
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.PersonalItems ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.PersonalItems)">
                        Personal Items
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Documents ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Documents)">
                        Documents
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Schedule ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Schedule)">
                        Schedule
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.WorkTypes ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.WorkTypes)">
                        Work Types
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.StaffTransfer ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.StaffTransfer)">
                        Transfer
                    </button>
                </nav>
            </div>

            <!-- Staff Workspace Body -->
            <div class="w-full min-w-0 flex flex-col gap-2">
                <StaffWorkspace StaffId="inspectedStaffId.Value" ActiveTab="inspectedStaffTab" />
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 1: HOME (Responsive Three-Column Grid: 23% / 54% / 23%) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Home")
    {
        <div class="grid grid-cols-1 gap-2 p-2 xl:grid-cols-[minmax(0,23fr)_minmax(0,54fr)_minmax(0,23fr)] items-start">
            
            <!-- LEFT COLUMN (23%): My Team(s), Help Desk & Service Desk Team, My Team Requests -->
            <aside class="min-w-0 p-2 flex flex-col gap-2">
                
                <!-- Card 1: My Team(s) with clickable heading and clickable team items -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 transition group"
                         @onclick="NavigateToTeamsTab"
                         title="Click to open Teams tab">
                        <div class="flex items-center gap-1.5">
                            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition">
                                My Team(s)
                            </h2>
                            <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold group-hover:underline">
                                ↗ View Tab
                            </span>
                        </div>
                        <span class="rounded-full bg-teal-100 dark:bg-teal-950/60 px-2 py-0.2 text-[10px] font-bold text-teal-800 dark:text-teal-300">
                            @myTeams.Count
                        </span>
                    </div>
                    @if (myTeams.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500">No active supervised teams found.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-72 overflow-y-auto">
                            @foreach (var team in myTeams)
                            {
                                <div @key="team.TeamId"
                                     class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition cursor-pointer @(selectedTeamId == team.TeamId ? "bg-teal-50/40 dark:bg-teal-950/20" : "")"
                                     @onclick="() => NavigateToSpecificTeam(team.TeamId)">
                                    <div class="min-w-0 pr-2">
                                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate hover:text-teal-600">
                                            @team.Name
                                        </h3>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                                            @team.Staffs.Count Members · @team.Staffs.Count(s => s.IsSuperVisor) Supervisors
                                        </p>
                                    </div>
                                    <button type="button"
                                            class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium shrink-0"
                                            @onclick:stopPropagation
                                            @onclick="() => NavigateToSpecificTeam(team.TeamId)">
                                        Open →
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Card 2: Help Desk & Service Desk Team -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                                @(helpDeskTeam?.Name ?? "Help Desk & Service Desk Team")
                            </h2>
                        </div>
                        <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.2 text-[10px] font-bold text-emerald-800 dark:text-emerald-300">
                            Live Support
                        </span>
                    </div>
                    @if (helpDeskTeam == null || helpDeskTeam.Staffs.Count == 0)
                    {
                        <div class="p-3 text-xs text-slate-500 space-y-1">
                            <p class="font-medium text-slate-700 dark:text-slate-300">IT &amp; HR Service Desk</p>
                            <p class="text-[11px] text-slate-400">Direct Extension: #8800 · support@hrm.gov.mv</p>
                        </div>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-56 overflow-y-auto">
                            @foreach (var member in helpDeskTeam.Staffs)
                            {
                                <div @key="member.StaffId" class="p-2.5 flex items-center justify-between text-xs hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                                    <div class="min-w-0 pr-2">
                                        <div class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            <span class="font-semibold text-slate-900 dark:text-slate-100 truncate block">
                                                @member.FullName
                                            </span>
                                        </div>
                                        <span class="text-[10px] text-slate-500 dark:text-slate-400 ml-3 block">
                                            @(member.IsSuperVisor ? "Help Desk Lead" : "Support Officer")
                                        </span>
                                    </div>
                                    <a href="@($"/admin/my/workspace?entityType=Staff&entityId={member.StaffId}")"
                                       class="text-[10px] text-blue-600 dark:text-blue-400 hover:underline shrink-0">
                                        Profile ↗
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    <div class="p-2 bg-slate-50/60 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 text-[11px] text-center text-slate-500">
                        <span>Ext: <strong class="text-slate-700 dark:text-slate-300">8800</strong> · Hours: 08:00 - 16:00</span>
                    </div>
                </div>

                <!-- Card 3: My Team Requests -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">My Team Requests</h2>
                        <span class="rounded-full bg-amber-100 dark:bg-amber-950/60 px-2 py-0.2 text-[10px] font-bold text-amber-800 dark:text-amber-300">
                            @TotalPendingRequestsCount
                        </span>
                    </div>
                    <div class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Annual Leave</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    @pendingLeaves.Count(l => l.LeaveType.Contains("Annual", StringComparison.OrdinalIgnoreCase)) Pending
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("leave")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Sick Leave</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    @pendingLeaves.Count(l => l.LeaveType.Contains("Sick", StringComparison.OrdinalIgnoreCase)) Pending
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("leave")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Duty &amp; Roster</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    @pendingDutyRequests.Count Pending Swaps
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("duty")'>
                                View
                            </button>
                        </div>
                        <div class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100 block">Position Changes</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400">
                                    In Approval Flow
                                </span>
                            </div>
                            <button type="button"
                                    class="text-[11px] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-0.5 hover:bg-white dark:hover:bg-slate-800 shadow-2xs font-medium"
                                    @onclick='() => OpenRequestTab("position")'>
                                View
                            </button>
                        </div>
                    </div>
                </div>

            </aside>

            <!-- CENTER COLUMN (54%): Metric Cards & Live Operations -->
            <main class="min-w-0 p-2 flex flex-col gap-2">
                
                <!-- Metric Cards Row 1: Staff Count, Attendance, Sick Leave, Family Leave -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-2">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Staff Count</span>
                        <span class="text-3xl font-black text-slate-900 dark:text-slate-100">@TotalStaffCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Attendance</span>
                        <span class="text-3xl font-black text-emerald-600 dark:text-emerald-400">@PresentCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Sick Leave</span>
                        <span class="text-3xl font-black text-amber-600 dark:text-amber-400">@SickLeaveCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Family Leave</span>
                        <span class="text-3xl font-black text-purple-600 dark:text-purple-400">@FamilyLeaveCount</span>
                    </div>
                </div>

                <!-- Metric Cards Row 2: Total Leaves, Absents, Available Staff -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-2">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Total Leaves</span>
                        <span class="text-3xl font-black text-indigo-600 dark:text-indigo-400">@TotalLeavesCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Absents</span>
                        <span class="text-3xl font-black text-rose-600 dark:text-rose-400">@AbsentCount</span>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs text-center flex flex-col justify-center items-center min-h-[6.5rem]">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Available Staff</span>
                        <span class="text-3xl font-black text-blue-600 dark:text-blue-400">@AvailableStaffCount</span>
                    </div>
                </div>

                <!-- Selected Team Roster Summary on Home -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
                        <div class="flex items-center gap-2">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                                @(selectedTeam?.Name ?? "Supervised Team Roster")
                            </h3>
                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                                @CurrentTeamStaffList.Count active staff
                            </span>
                        </div>
                        <button type="button"
                                class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                                @onclick="NavigateToTeamsTab">
                            Manage in Teams Tab →
                        </button>
                    </div>

                    @if (CurrentTeamStaffList.Count == 0)
                    {
                        <p class="py-6 text-center text-xs text-slate-500">No staff assigned to this team.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-64 overflow-y-auto">
                            @foreach (var staff in CurrentTeamStaffList)
                            {
                                <div @key="staff.StaffId" class="py-2 flex items-center justify-between text-xs hover:bg-slate-50 dark:hover:bg-slate-800/60 rounded-lg px-2 transition">
                                    <div class="flex items-center gap-2 min-w-0 pr-2">
                                        <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-800 font-bold flex items-center justify-center text-xs shrink-0">
                                            @GetInitials(staff.FullName)
                                        </div>
                                        <div class="min-w-0">
                                            <a href="@($"/admin/my/workspace/staff/{staff.StaffId}/overview")"
                                               class="font-semibold text-slate-900 dark:text-slate-100 hover:text-teal-600 dark:hover:text-teal-400 hover:underline block truncate"
                                               title="Open Staff Workspace">
                                                @staff.FullName
                                            </a>
                                            <span class="text-[10px] text-slate-500">ID: #@staff.StaffId · @(staff.IsSuperVisor ? "Supervisor" : "Member")</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <a href="@($"/admin/my/workspace/staff/{staff.StaffId}/overview")"
                                           class="rounded-lg border border-teal-300 dark:border-teal-700 bg-teal-50 dark:bg-teal-950/50 px-2 py-1 text-[11px] font-semibold text-teal-700 dark:text-teal-300 hover:bg-teal-100 dark:hover:bg-teal-900/60 transition"
                                           title="Open Staff Workspace">
                                            Staff Workspace &gt;
                                        </a>
                                        <button type="button"
                                                class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50"
                                                @onclick="() => OpenMember360(staff.StaffId)">
                                            Inspect 360
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Embedded Entity Inspector (Organisation / Individual) -->
                @if (selectedEntityItem != null && activeWorkspaceTab == "Home")
                {
                    <div class="rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-4 shadow-md space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 flex-wrap gap-2">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">@selectedEntityItem.EntityType Profile:</span>
                                <span class="font-semibold text-teal-700 dark:text-teal-300 text-sm">@selectedEntityItem.Name</span>
                                <span class="text-xs text-slate-500">(#@selectedEntityItem.Id)</span>
                            </div>
                            <button type="button"
                                    class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                                    @onclick="() => selectedEntityItem = null">
                                ✕ Close
                            </button>
                        </div>
                        <WorkspaceContent Item="selectedEntityItem" OnSelected="SelectSearchResult" ActiveTab="WorkspaceTab.Overview" />
                    </div>
                }


            </main>

            <!-- RIGHT COLUMN (23%): Recent Search & To Do -->
            <aside class="min-w-0 p-2 flex flex-col gap-2">
                
                <!-- Card 1: Recent Search -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800">
                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">Recent Search</h2>
                    </div>
                    @if (recentSearchItems.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500">No recent searches yet.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var item in recentSearchItems.Take(5))
                            {
                                <div @key="@($"{item.EntityType}-{item.Id}")"
                                     class="p-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/60 transition cursor-pointer"
                                     @onclick="() => SelectSearchResult(item)">
                                    <div class="min-w-0 pr-2">
                                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">@item.Name</h3>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400">
                                            @(item.EntityType == WorkspaceEntityType.Organisation ? "Organisation" : "Employee")
                                        </p>
                                    </div>
                                    <span class="text-[10px] text-blue-600 dark:text-blue-400 font-semibold">Open →</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Card 2: To Do -->
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
                    <div class="bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">To Do</h2>
                        <span class="text-[11px] text-slate-500 dark:text-slate-400">@todoItems.Count tasks</span>
                    </div>
                    @if (todoItems.Count == 0)
                    {
                        <p class="p-4 text-xs text-slate-500">No open to-do tasks.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-64 overflow-y-auto">
                            @foreach (var todo in todoItems.Take(6))
                            {
                                <div @key="todo.Id" class="p-2.5 flex items-start justify-between gap-2 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                                    <div class="min-w-0">
                                        <h3 class="text-xs font-medium text-slate-900 dark:text-slate-100 break-words">@todo.Title</h3>
                                        @if (todo.DueDate.HasValue)
                                        {
                                            <p class="text-[10px] text-slate-500 dark:text-slate-400">
                                                Due: @todo.DueDate.Value.ToString("dd MMM yyyy")
                                            </p>
                                        }
                                    </div>
                                    <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold @(todo.Priority == "High" ? "bg-rose-100 text-rose-800" : "bg-slate-100 text-slate-700")">
                                        @todo.Priority
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

            </aside>

        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 2: TEAMS (Master-Detail Grid with Contextual Panels) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "MyTeam")
    {
        <div class="flex flex-col gap-2 p-2">
            
            <!-- Teams Header with Search Teams Button -->
            <div class="flex items-center justify-between flex-wrap gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">Teams &amp; Projects Management Center</h2>
                        @if (selectedTeam != null)
                        {
                            <span class="rounded-full bg-teal-100 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 px-2.5 py-0.5 text-xs font-bold">
                                @selectedTeam.Name
                            </span>
                        }
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Manage supervised teams, member 360° work summaries, performance evaluations, and project deliverables.
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                            @onclick="() => showSearchTeamsModal = true">
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <span>Search Teams</span>
                    </button>
                    <a href="/admin/settings/organisations/teams" class="rounded-lg bg-teal-700 hover:bg-teal-800 px-3 py-1.5 text-xs font-semibold text-white shadow-xs transition">
                        ⚙️ Teams Config
                    </a>
                </div>
            </div>

            <!-- Master-Detail Grid Layout:
                 When right panel is open:   lg:grid-cols-[minmax(0,23fr)_minmax(0,47fr)_minmax(0,30fr)]
                 When right panel is closed: lg:grid-cols-[minmax(0,23fr)_minmax(0,77fr)]
            -->
            <div class="grid grid-cols-1 gap-2 p-2 @(activeRightPanel != RightPanelType.None ? "lg:grid-cols-[minmax(0,23fr)_minmax(0,47fr)_minmax(0,30fr)]" : "lg:grid-cols-[minmax(0,23fr)_minmax(0,77fr)]") items-start">
                
                <!-- LEFT: Team List (~23% width, non-collapsing) -->
                <aside class="min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 shadow-xs space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">Teams Directory</h3>
                        <span class="text-[10px] text-slate-400">@myTeams.Count teams</span>
                    </div>

                    @if (myTeams.Count == 0)
                    {
                        <p class="py-6 text-center text-xs text-slate-500">No teams found.</p>
                    }
                    else
                    {
                        <div class="space-y-1.5 max-h-[36rem] overflow-y-auto pr-1">
                            @foreach (var team in myTeams)
                            {
                                <div @key="team.TeamId"
                                     class="p-2.5 rounded-xl border text-xs transition cursor-pointer flex flex-col gap-1 @(selectedTeamId == team.TeamId ? "border-teal-500 bg-teal-50/70 dark:bg-teal-950/40 shadow-xs ring-1 ring-teal-500" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700")"
                                     @onclick="() => SelectTeamAsync(team.TeamId)">
                                    <div class="flex items-center justify-between">
                                        <h4 class="font-bold text-slate-900 dark:text-slate-100 truncate">@team.Name</h4>
                                        <span class="rounded bg-teal-100 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 px-1.5 py-0.2 text-[10px] font-bold shrink-0">
                                            @team.Staffs.Count
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(team.NameDhivehi))
                                    {
                                        <p lang="dv" dir="rtl" class="text-[10px] text-slate-400 truncate">@team.NameDhivehi</p>
                                    }
                                    <span class="text-[10px] text-slate-500">
                                        @team.Staffs.Count(s => s.IsSuperVisor) Supervisor(s)
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </aside>

                <!-- CENTER: Selected Team Members & Projects -->
                <section class="min-w-0 space-y-4">
                    @if (selectedTeam == null)
                    {
                        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-12 text-center text-xs text-slate-500">
                            Select a team from the list to view members and projects.
                        </div>
                    }
                    else
                    {
                        <!-- Team Info Summary Banner -->
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                            <div class="flex items-center justify-between flex-wrap gap-2">
                                <div>
                                    <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">@selectedTeam.Name</h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                        @CurrentTeamStaffList.Count assigned personnel · @currentTeamProjects.Count active projects
                                    </p>
                                </div>
                                <!-- Subtabs: Members vs Projects -->
                                <div class="flex rounded-lg border border-slate-300 dark:border-slate-700 p-0.5 bg-slate-100 dark:bg-slate-800 text-xs">
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition @(teamCenterSubTab == "members" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => teamCenterSubTab = "members"'>
                                        Members (@CurrentTeamStaffList.Count)
                                    </button>
                                    <button type="button"
                                            class="rounded-md px-3 py-1 font-semibold transition @(teamCenterSubTab == "projects" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400")"
                                            @onclick='() => teamCenterSubTab = "projects"'>
                                        Projects (@currentTeamProjects.Count)
                                    </button>
                                </div>
                            </div>

                            <!-- SUB-TAB 1: MEMBERS TABLE WITH ACTIONS -->
                            @if (teamCenterSubTab == "members")
                            {
                                @if (CurrentTeamStaffList.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500">No members assigned to this team.</div>
                                }
                                else
                                {
                                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                        <table class="w-full text-left text-xs">
                                            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                                <tr>
                                                    <th class="p-2.5">Member</th>
                                                    <th class="p-2.5">Role</th>
                                                    <th class="p-2.5">Today Attendance</th>
                                                    <th class="p-2.5 text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                @foreach (var member in CurrentTeamStaffList)
                                                {
                                                    var att = GetTodayAttendance(member.StaffId);
                                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition">
                                                        <td class="p-2.5">
                                                            <div class="flex items-center gap-2">
                                                                <div class="w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 font-bold flex items-center justify-center text-xs shrink-0">
                                                                    @GetInitials(member.FullName)
                                                                </div>
                                                                <div>
                                                                    <a href="@($"/admin/my/workspace/staff/{member.StaffId}/overview")"
                                                                       class="font-bold text-slate-900 dark:text-slate-100 hover:text-teal-600 dark:hover:text-teal-400 hover:underline block"
                                                                       title="Open Staff Workspace">
                                                                        @member.FullName
                                                                    </a>
                                                                    <span class="text-[10px] text-slate-500">ID: #@member.StaffId</span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="p-2.5">
                                                            <span class="rounded px-2 py-0.5 text-[10px] font-semibold @(member.IsSuperVisor ? "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                                                                @(member.IsSuperVisor ? "Supervisor" : "Member")
                                                            </span>
                                                        </td>
                                                        <td class="p-2.5">
                                                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @GetAttendanceBadgeClass(att?.Status)">
                                                                @(att != null ? att.Status.ToString() : "Not Clocked")
                                                            </span>
                                                        </td>
                                                        <td class="p-2.5 text-right">
                                                            <div class="inline-flex items-center gap-1">
                                                                <button type="button"
                                                                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                                                        @onclick="() => OpenMember360(member.StaffId)">
                                                                    View 360
                                                                </button>
                                                                <button type="button"
                                                                        class="inline-flex items-center gap-1 rounded-lg border border-amber-300 dark:border-amber-700 bg-amber-50/50 dark:bg-amber-950/40 px-2 py-1 text-[11px] font-semibold text-amber-800 dark:text-amber-300 shadow-2xs hover:bg-amber-100 transition"
                                                                        @onclick="() => OpenMemberEvaluation(member.StaffId, member.FullName)">
                                                                    Evaluation
                                                                </button>
                                                                <button type="button"
                                                                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                                                        @onclick="() => OpenAssignment(AssignmentModal.AssignmentMode.Project, member.StaffId, member.FullName)">
                                                                    Assign Project
                                                                </button>
                                                                <button type="button"
                                                                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                                                        @onclick="() => OpenAssignment(AssignmentModal.AssignmentMode.Task, member.StaffId, member.FullName)">
                                                                    Assign Task
                                                                </button>
                                                                <a href="@($"/admin/my/workspace/staff/{member.StaffId}/overview")"
                                                                   class="inline-flex items-center gap-1 rounded-lg border border-teal-300 dark:border-teal-700 bg-teal-50 dark:bg-teal-950/50 px-2 py-1 text-[11px] font-semibold text-teal-700 dark:text-teal-300 shadow-2xs hover:bg-teal-100 dark:hover:bg-teal-900/60 transition"
                                                                   title="Open Staff Workspace">
                                                                    Staff Workspace &gt;
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }

                            <!-- SUB-TAB 2: PROJECTS LIST -->
                            @if (teamCenterSubTab == "projects")
                            {
                                @if (loadingProjects)
                                {
                                    <div class="py-12 text-center text-xs text-slate-500">
                                        <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                                        Loading team projects…
                                    </div>
                                }
                                else if (currentTeamProjects.Count == 0)
                                {
                                    <div class="py-10 text-center text-xs text-slate-500">
                                        No active projects linked to this team.
                                    </div>
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                        @foreach (var proj in currentTeamProjects)
                                        {
                                            <div @key="proj.ProjectId"
                                                 class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 space-y-2.5 shadow-2xs hover:shadow-xs hover:border-teal-500 dark:hover:border-teal-500 transition cursor-pointer @(selectedProjectId == proj.ProjectId ? "ring-2 ring-teal-500" : "")"
                                                 @onclick="() => OpenProjectDetails(proj.ProjectId)">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="min-w-0">
                                                        <div class="flex items-center gap-1.5 mb-1">
                                                            <span class="font-mono text-[10px] font-bold text-blue-700 bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/40 px-1.5 py-0.2 rounded">
                                                                @proj.Reference
                                                            </span>
                                                            <span class="rounded px-2 py-0.2 text-[10px] font-bold @GetStatusBadgeClass(proj.Status)">
                                                                @proj.Status
                                                            </span>
                                                        </div>
                                                        <h4 class="font-bold text-xs text-slate-900 dark:text-slate-100 truncate">
                                                            @proj.Name
                                                        </h4>
                                                    </div>
                                                    <span class="font-black text-xs text-teal-700 dark:text-teal-400 shrink-0">
                                                        @proj.ProgressPercentage%
                                                    </span>
                                                </div>

                                                <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
                                                    @proj.Description
                                                </p>

                                                <!-- Progress Bar -->
                                                <div class="w-full h-1.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                                    <div class="h-full rounded-full bg-teal-600 @GetProgressWidthClass(proj.ProgressPercentage)"></div>
                                                </div>

                                                <!-- Tasks Breakdown -->
                                                <div class="flex items-center justify-between text-[10px] text-slate-500 pt-1 border-t border-slate-100 dark:border-slate-800">
                                                    <span>Tasks: <strong>@proj.TotalTaskCount</strong></span>
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-blue-600 font-semibold">@proj.OngoingTaskCount Ongoing</span>
                                                        <span>·</span>
                                                        <span class="text-emerald-600 font-semibold">@proj.CompletedTaskCount Done</span>
                                                        <span>·</span>
                                                        <span class="text-purple-600 font-semibold">@proj.ParkedTaskCount Parked</span>
                                                    </div>
                                                </div>

                                                <div class="flex items-center justify-between pt-1">
                                                    <span class="text-[10px] text-slate-400">
                                                        Mgr: @(!string.IsNullOrWhiteSpace(proj.ProjectManagerName) ? proj.ProjectManagerName : "Unassigned")
                                                    </span>
                                                    <button type="button"
                                                            class="text-[11px] font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                                                            @onclick:stopPropagation
                                                            @onclick="() => OpenProjectDetails(proj.ProjectId)">
                                                        View Details →
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </section>

                <!-- RIGHT: Shared Contextual Detail Panel (Only One Active at a Time) -->
                @if (activeRightPanel == RightPanelType.Member360 && inspectedStaffId.HasValue)
                {
                    <Member360Panel StaffId="inspectedStaffId.Value"
                                    OnClose="CloseRightPanel"
                                    OnTaskClick="OpenTaskModal"
                                    OnProjectClick="OpenProjectDetails"
                                    OnAssignProject="() => OpenAssignment(AssignmentModal.AssignmentMode.Project, inspectedStaffId!.Value, inspectedStaffName)"
                                    OnAssignTask="() => OpenAssignment(AssignmentModal.AssignmentMode.Task, inspectedStaffId!.Value, inspectedStaffName)"
                                    OnAssignmentsChanged="RefreshAssignmentViewsAsync"
                                    OnOpenEvaluation="id => OpenMemberEvaluation(id, inspectedStaffName)"
                                    RefreshVersion="assignmentRefresh" />
                }
                else if (activeRightPanel == RightPanelType.Evaluation && evalStaffId.HasValue)
                {
                    <MemberEvaluationPanel StaffId="evalStaffId.Value"
                                           StaffName="@evalStaffName"
                                           OnClose="CloseRightPanel"
                                           OnEvaluationSaved="RefreshRequestsAsync" />
                }
                else if (activeRightPanel == RightPanelType.ProjectDetails && selectedProjectId.HasValue)
                {
                    <ProjectDetailPanel ProjectId="selectedProjectId.Value"
                                        OnClose="CloseRightPanel"
                                        OnTaskClick="OpenTaskModal"
                                        OnAssignmentsChanged="RefreshAssignmentViewsAsync" />
                }

            </div>

        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 3: CALENDARS                                         -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Calendar")
    {
        <WorkspaceCalendarCard />
    }

    <!-- ======================================================== -->
    <!-- TAB 4: REQUEST (Team Requests & Approvals Queue)        -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Request")
    {
        <div class="flex flex-col gap-2 p-2">
            <!-- Header Area -->
            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 gap-2 shadow-xs flex items-center justify-between flex-wrap">
                <div>
                    <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">Team Requests &amp; Approvals Command Center</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Review pending leaves, clock attendance entries, uneven log corrections, and workforce requests.</p>
                </div>
                <button type="button" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-teal-700 dark:text-teal-400 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer transition" @onclick="RefreshRequestsAsync">
                    <span>↻ Refresh Queue</span>
                </button>
            </div>

            <!-- Horizontal Request Tabs -->
            <nav class="flex flex-wrap items-center gap-1.5 border-b border-slate-200 dark:border-slate-800 pb-2" aria-label="Request Categories">
                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "leave" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("leave")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <span>Leave Requests</span>
                    @if (pendingLeaves.Count > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "leave" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @pendingLeaves.Count
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "attendance" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("attendance")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Attendance Requests</span>
                    @if (AttendancePendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "attendance" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @AttendancePendingCount
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "uneven-log" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("uneven-log")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    <span>Uneven Log Requests</span>
                    @if (UnevenLogPendingCount > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "uneven-log" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @UnevenLogPendingCount
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "duty" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("duty")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    <span>Duty &amp; Roster</span>
                    @if (pendingDutyRequests.Count > 0)
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @(activeReqSubTab == "duty" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                            @pendingDutyRequests.Count
                        </span>
                    }
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "overtime" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("overtime")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    <span>Overtime</span>
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "late" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("late")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    <span>Late Check-In</span>
                </button>

                <button type="button"
                        class="rounded-xl px-3.5 py-2 text-xs font-bold transition flex items-center gap-2 cursor-pointer @(activeReqSubTab == "position" ? "bg-teal-700 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60")"
                        @onclick='() => SetReqSubTab("position")'>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    <span>Position Changes</span>
                </button>
            </nav>

            <!-- Two-Column Workspace Layout (Left: Form to approve & details, Right: All requests) -->
            @if (activeReqSubTab is "leave" or "attendance" or "uneven-log" or "duty")
            {
                <div class="grid grid-cols-1 xl:grid-cols-12 gap-3 p-2 items-start w-full">
                    
                    <!-- ======================================================== -->
                    <!-- LEFT PANEL (5 cols): FORM TO APPROVE & DETAILS           -->
                    <!-- ======================================================== -->
                    <aside class="col-span-12 xl:col-span-5 flex flex-col gap-3 min-w-0">
                        @if (activeReqSubTab == "leave")
                        {
                            @if (selectedLeave != null)
                            {
                                <div class="rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-4 shadow-xs sticky top-4">
                                    <LeaveRequestDetails @key="selectedLeave.RequestId"
                                                         Item="selectedLeave"
                                                         Busy="executingAction"
                                                         Message="@leaveActionMessage"
                                                         OnClose="() => selectedLeave = null"
                                                         OnExecute="ExecuteLeaveActionAsync"
                                                         OnChanged="RefreshRequestsAsync" />
                                </div>
                            }
                            else
                            {
                                <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center shadow-xs">
                                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 mb-3 border border-teal-200 dark:border-teal-800/40">
                                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                        </svg>
                                    </div>
                                    <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">No Leave Request Selected</h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs mx-auto">
                                        Select any pending leave request from the queue on the right to inspect applicant details, balances, and take approval actions.
                                    </p>
                                </div>
                            }
                        }
                        else if (activeReqSubTab is "attendance" or "uneven-log")
                        {
                            @if (selectedAttendanceRequest != null)
                            {
                                <div class="rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-3 sticky top-4">
                                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
                                        <div>
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
                                                @(activeReqSubTab == "uneven-log" ? "Uneven Log Correction" : "Attendance Request")
                                            </span>
                                            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@selectedAttendanceRequest.StaffName</h3>
                                        </div>
                                        <button type="button" class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer" @onclick="() => selectedAttendanceRequest = null">✕</button>
                                    </div>

                                    <div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                        <div>
                                            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Reference</span>
                                            <span class="font-mono font-bold text-slate-800 dark:text-slate-200">@selectedAttendanceRequest.Reference</span>
                                        </div>
                                        <div>
                                            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Status</span>
                                            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                                                @selectedAttendanceRequest.Status
                                            </span>
                                        </div>
                                        <div>
                                            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Clock Time</span>
                                            <span class="font-bold text-slate-800 dark:text-slate-200">@selectedAttendanceRequest.ClockTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                        <div>
                                            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Clock Mode</span>
                                            <span class="inline-block px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 font-bold text-slate-800 dark:text-slate-200">
                                                @selectedAttendanceRequest.Mode
                                            </span>
                                        </div>
                                        <div class="col-span-2">
                                            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Organisation</span>
                                            <span class="text-slate-700 dark:text-slate-300 truncate block">@selectedAttendanceRequest.OrganisationName</span>
                                        </div>
                                        <div class="col-span-2 pt-1 border-t border-slate-200 dark:border-slate-700">
                                            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Applicant Remarks</span>
                                            <p class="text-slate-700 dark:text-slate-300 whitespace-pre-wrap mt-0.5">
                                                @(string.IsNullOrWhiteSpace(selectedAttendanceRequest.Comments) ? "No remarks provided." : selectedAttendanceRequest.Comments)
                                            </p>
                                        </div>
                                    </div>

                                    @if (attendanceReview != null)
                                    {
                                        <div class="p-2.5 rounded-xl bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs flex items-center justify-between">
                                            <div>
                                                <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block">Workflow Stage</span>
                                                <span class="font-bold text-slate-900 dark:text-slate-100">@attendanceReview.Stage</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(attendanceReview.Message))
                                            {
                                                <span class="text-[11px] text-slate-500 dark:text-slate-400">@attendanceReview.Message</span>
                                            }
                                        </div>
                                    }

                                    <div class="border-t border-slate-200 dark:border-slate-800 pt-2 flex flex-col gap-2">
                                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
                                            Approval Decision &amp; Action
                                        </h4>

                                        @if (!string.IsNullOrWhiteSpace(attendanceReviewError))
                                        {
                                            <div class="p-2.5 rounded-xl border border-rose-200 bg-rose-50 dark:bg-rose-950/40 dark:border-rose-900 text-xs text-rose-800 dark:text-rose-200">
                                                @attendanceReviewError
                                            </div>
                                        }

                                        @if (attendanceReview != null && (attendanceReview.CanApprove || attendanceReview.CanCancel))
                                        {
                                            <div class="space-y-1">
                                                <label for="hubAttActionComment" class="text-xs font-semibold text-slate-700 dark:text-slate-300 block">
                                                    Action Remarks / Notes
                                                </label>
                                                <textarea id="hubAttActionComment"
                                                          @bind="attendanceActionComment"
                                                          rows="2"
                                                          disabled="@attendanceActing"
                                                          placeholder="Enter optional comments or decision notes..."
                                                          class="w-full p-2 text-xs text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-teal-600 resize-none"></textarea>
                                            </div>

                                            <div class="flex flex-wrap items-center gap-2 pt-1">
                                                @if (attendanceReview.CanApprove)
                                                {
                                                    <button type="button"
                                                            class="inline-flex items-center gap-1.5 rounded-xl bg-teal-700 hover:bg-teal-800 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs transition cursor-pointer disabled:opacity-50"
                                                            disabled="@attendanceActing"
                                                            @onclick='() => ActAttendanceRequest("Approve")'>
                                                        ✓ @attendanceReview.ActionLabel
                                                    </button>
                                                    <button type="button"
                                                            class="inline-flex items-center gap-1.5 rounded-xl bg-rose-600 hover:bg-rose-700 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs transition cursor-pointer disabled:opacity-50"
                                                            disabled="@attendanceActing"
                                                            @onclick='() => ActAttendanceRequest("Reject")'>
                                                        ✕ Reject
                                                    </button>
                                                }
                                                @if (attendanceReview.CanCancel)
                                                {
                                                    <button type="button"
                                                            class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 px-3.5 py-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 shadow-xs transition cursor-pointer disabled:opacity-50"
                                                            disabled="@attendanceActing"
                                                            @onclick='() => ActAttendanceRequest("Cancel")'>
                                                        Cancel Request
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else if (attendanceReview != null)
                                        {
                                            <p class="text-xs text-slate-500 italic">No further approval actions can be taken by your account on this request at its current stage.</p>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center shadow-xs">
                                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 mb-3 border border-teal-200 dark:border-teal-800/40">
                                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">No Request Selected</h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs mx-auto">
                                        Select an @(activeReqSubTab == "uneven-log" ? "uneven log correction" : "attendance request") from the queue on the right to inspect details and take approval actions.
                                    </p>
                                </div>
                            }
                        }
                        else if (activeReqSubTab == "duty")
                        {
                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center shadow-xs">
                                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 mb-3 border border-teal-200 dark:border-teal-800/40">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                    </svg>
                                </div>
                                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Duty &amp; Roster Management</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md mx-auto">
                                    Review shift exchanges, off-day swaps, and roster adjustments selected from the queue on the right.
                                </p>
                                <div class="mt-4">
                                    <a href="/admin/hr/work-planning/duty-roster?tab=requests"
                                       class="inline-flex items-center gap-2 rounded-lg bg-teal-700 hover:bg-teal-800 px-4 py-2 text-xs font-semibold text-white transition">
                                        Open Full Duty Roster Workspace ↗
                                    </a>
                                </div>
                            </div>
                        }
                    </aside>

                    <!-- ======================================================== -->
                    <!-- RIGHT PANEL (7 cols): ALL THE REQUESTS                   -->
                    <!-- ======================================================== -->
                    <main class="col-span-12 xl:col-span-7 flex flex-col gap-3 min-w-0">
                        @if (activeReqSubTab == "leave")
                        {
                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-3">
                                <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Pending Leave Requests</h3>
                                        <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-xs font-bold">
                                            @pendingLeaves.Count
                                        </span>
                                    </div>
                                    <button type="button" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline cursor-pointer" @onclick="RefreshRequestsAsync">
                                        ↻ Refresh
                                    </button>
                                </div>

                                @if (loading)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 animate-pulse">Loading leave requests...</div>
                                }
                                else if (pendingLeaves.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                        All caught up! No pending leave requests awaiting approval.
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var item in pendingLeaves)
                                        {
                                            var isSelected = selectedLeave?.RequestId == item.RequestId;
                                            <button type="button"
                                                    class="w-full text-left rounded-xl p-3 border transition-all cursor-pointer @(isSelected ? "bg-teal-50/80 dark:bg-teal-950/40 border-teal-500 ring-1 ring-teal-500 shadow-xs" : "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50/50")"
                                                    @onclick="() => selectedLeave = item">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-xs shrink-0">
                                                            @GetInitials(item.Applicant)
                                                        </div>
                                                        <div>
                                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">@item.Applicant</h4>
                                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5 flex-wrap">
                                                                <span class="font-medium text-teal-700 dark:text-teal-400">@item.LeaveType</span>
                                                                <span>•</span>
                                                                <span>@item.FromDate.ToString("dd MMM yyyy") – @item.ToDate.ToString("dd MMM yyyy")</span>
                                                                <span>(@item.Duration @(item.Duration == 1 ? "day" : "days"))</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold @(item.IsProcessing ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                                                            @item.Status
                                                        </span>
                                                        <span class="text-[10px] text-slate-400 font-mono">@item.Reference</span>
                                                    </div>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (activeReqSubTab is "attendance" or "uneven-log")
                        {
                            var reqs = attendanceRequestsList.Where(r => activeReqSubTab == "uneven-log" ? r.Kind == "Uneven-log correction" : r.Kind == "Attendance").ToList();
                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-3">
                                <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">
                                            @(activeReqSubTab == "uneven-log" ? "Uneven Log Correction Requests" : "Attendance Requests")
                                        </h3>
                                        <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-xs font-bold">
                                            @reqs.Count
                                        </span>
                                    </div>
                                    <button type="button" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline cursor-pointer" @onclick="RefreshRequestsAsync">
                                        ↻ Refresh
                                    </button>
                                </div>

                                @if (attendanceLoading)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 animate-pulse">Loading requests...</div>
                                }
                                else if (reqs.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                        No @(activeReqSubTab == "uneven-log" ? "uneven log correction" : "attendance") requests found.
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var row in reqs)
                                        {
                                            var isSelected = selectedAttendanceRequest?.RequestId == row.RequestId;
                                            <button type="button"
                                                    class="w-full text-left rounded-xl p-3 border transition-all cursor-pointer @(isSelected ? "bg-teal-50/80 dark:bg-teal-950/40 border-teal-500 ring-1 ring-teal-500 shadow-xs" : "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50/50")"
                                                    @onclick="() => SelectAttendanceRequest(row)">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-xs shrink-0">
                                                            @GetInitials(row.StaffName)
                                                        </div>
                                                        <div>
                                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">@row.StaffName</h4>
                                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5 flex-wrap">
                                                                <span class="font-bold text-slate-700 dark:text-slate-300">@row.ClockTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                                <span>•</span>
                                                                <span class="inline-block bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 px-1.5 py-0.2 rounded font-semibold text-[10px]">@row.Mode</span>
                                                                @if (!string.IsNullOrWhiteSpace(row.Comments))
                                                                {
                                                                    <span>•</span>
                                                                    <span class="italic truncate max-w-xs text-slate-400">@row.Comments</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold @(row.Status.Contains("Approve", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : row.Status.Contains("Reject", StringComparison.OrdinalIgnoreCase) ? "bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300" : "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300")">
                                                            @row.Status
                                                        </span>
                                                        <span class="text-[10px] text-slate-400 font-mono">@row.Reference</span>
                                                    </div>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (activeReqSubTab == "duty")
                        {
                            <PendingDutyRequestsCard />
                        }
                    </main>
                </div>
            }
            else if (activeReqSubTab == "overtime")
            {
                <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 shadow-xs">
                    <HRM.Components.Shared.OvertimeRequests PendingOnly="true" />
                </div>
            }
            else if (activeReqSubTab == "late")
            {
                <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 shadow-xs">
                    <HRM.Components.Shared.LateCheckInRequests PendingOnly="true" />
                </div>
            }
            else if (activeReqSubTab == "position")
            {
                <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 shadow-xs">
                    <HRM.Components.Shared.StaffPositionRequests PendingOnly="true" />
                </div>
            }
        </div>
    }

    <!-- TAB 5: ONBOARDING                                        -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Onboarding")
    {
        <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 gap-2 flex flex-col shadow-xs">
            <HRM.Components.Admin.My.Workspace.Onboarding.StaffOnboarding />
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 6: LEAVE LOG                                         -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "LeaveLog")
    {
        <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 gap-2 flex flex-col shadow-xs">
            <HRM.Components.Admin.My.Workspace.Staff.Tabs.StaffLeave StaffId="@(inspectedStaffId ?? CurrentTeamStaffList.FirstOrDefault()?.StaffId ?? 0)" />
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 7: ATTENDANCE                                        -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Attendance")
    {
        <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 gap-2 flex flex-col shadow-xs">
            <TeamAttendanceCard />
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 8: TIME CHANGE                                       -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "TimeChange")
    {
        <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 gap-2 flex flex-col shadow-xs">
            <HRM.Components.Shared.WeeklyHoursExceptions PendingOnly="false" />
        </div>
    }

    <!-- ======================================================== -->
    <!-- TAB 9: ORG DAILY                                         -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "OrgDaily")
    {
        <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 gap-2 flex flex-col shadow-xs">
            <HRM.Components.Admin.Attendance.Attendance.OrganisationDaily />
        </div>
    }

    <!-- Modals -->
    <!-- 1. Task Details Modal -->
    <TaskDetailModal TaskItem="selectedTaskModalItem" OnClose="() => selectedTaskModalItem = null" />

    <!-- Assignment Modal (project / task assignment from a team member) -->
    <AssignmentModal Visible="showAssignModal" Mode="assignMode" StaffId="assignStaffId" StaffName="@assignStaffName"
                     OnSaved="RefreshAssignmentViewsAsync" OnClose="() => showAssignModal = false" />

    <!-- 2. Search Teams Modal -->
    <SearchTeamsModal IsOpen="showSearchTeamsModal"
                      OnClose="() => showSearchTeamsModal = false"
                      OnTeamSelected="HandleSearchTeamSelected" />

    <!-- 3. Position Change Modal (Through Approval Flow) -->
    @if (showPositionChangeModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
            <div class="w-full max-w-xl rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Request Position Change</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@posModalStaffName (ID: #@posModalStaffId)</p>
                    </div>
                    <button type="button"
                            class="rounded-lg p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                            @onclick="ClosePositionChangeModal">
                        ✕
                    </button>
                </div>

                @if (posModalError != null)
                {
                    <div class="rounded-lg border border-rose-200 bg-rose-50 dark:bg-rose-950/40 p-2.5 text-xs text-rose-800 dark:text-rose-300">
                        @posModalError
                    </div>
                }

                @if (loadingPositionData)
                {
                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                        <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                        Loading staff position and framework details…
                    </div>
                }
                else if (posData != null)
                {
                    <div class="rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/30 p-3 text-xs text-amber-900 dark:text-amber-200 flex items-start gap-2">
                        <span class="text-base">ℹ️</span>
                        <div>
                            <span class="font-bold">Approval Flow Required:</span>
                            This action initiates a formal <strong>Job Position Request</strong>. It must be reviewed and approved through the organizational approval flow before taking effect.
                        </div>
                    </div>

                    @if (posCurrentAssignment != null)
                    {
                        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-2.5 text-xs">
                            <span class="font-semibold text-slate-700 dark:text-slate-300">Current Position:</span>
                            <span class="font-bold text-slate-900 dark:text-slate-100 ml-1">@posCurrentAssignment.Name</span>
                            <span class="text-slate-500 dark:text-slate-400 ml-1">(Job #@posCurrentAssignment.JobId · From @posCurrentAssignment.From.ToString("dd MMM yyyy"))</span>
                        </div>
                    }

                    <form @onsubmit="SubmitPositionChangeAsync" @onsubmit:preventDefault class="space-y-3 text-xs">
                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Employment</label>
                            <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                    @bind="posJobId" required>
                                <option value="0">Select employment contract</option>
                                @foreach (var job in posData.Jobs)
                                {
                                    <option value="@job.Id">@job.Name</option>
                                }
                            </select>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Framework</label>
                                <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                        @bind="posSelectedFrameworkId" @bind:after="OnPosFrameworkChanged" required>
                                    <option value="0">Select framework</option>
                                    @foreach (var fw in posData.Frameworks)
                                    {
                                        <option value="@fw.Id">@fw.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Position Matrix</label>
                                <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                        @bind="posSelectedMatrixId" @bind:after="OnPosMatrixChanged" disabled="@(posSelectedFrameworkId == 0)" required>
                                    <option value="0">Select position matrix</option>
                                    @foreach (var matrix in posData.PositionMatrices.Where(x => x.FrameworkId == posSelectedFrameworkId))
                                    {
                                        <option value="@matrix.Id" disabled="@(matrix.AvailableSlots == 0)">
                                            @matrix.Name (@matrix.AvailableSlots/@matrix.ApprovedSlots slots available)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Vacant Position Slot</label>
                            <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                    @bind="posSelectedPositionId" disabled="@(posSelectedMatrixId == 0)" required>
                                <option value="0">Select vacant position</option>
                                @foreach (var pos in posData.Positions.Where(p => p.FrameworkId == posSelectedFrameworkId && p.MatrixId == posSelectedMatrixId))
                                {
                                    <option value="@pos.Id">@pos.Name · #@pos.Id</option>
                                }
                            </select>
                        </div>

                        @if (posData.Positions.FirstOrDefault(x => x.Id == posSelectedPositionId)?.Pay is {} payDef && payDef.Steps.Count > 0)
                        {
                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Job Pay Step</label>
                                <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                        @bind="posSelectedJobMatrixStepId">
                                    <option value="">Select pay step</option>
                                    @foreach (var s in payDef.Steps)
                                    {
                                        <option value="@s.Id">Step @s.Number · @s.JobAllowance.ToString("N2") @payDef.Currency</option>
                                    }
                                </select>
                            </div>
                        }

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Effective Date (From)</label>
                            <input type="date"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                   @bind="posFromDate" required />
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Reason / Justification</label>
                            <textarea class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                      rows="2" maxlength="500" placeholder="State the reason for this position change..."
                                      @bind="posReason" required></textarea>
                        </div>

                        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
                            <button type="button"
                                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50"
                                    @onclick="ClosePositionChangeModal"
                                    disabled="@submittingPosChange">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="rounded-lg bg-teal-700 px-4 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-teal-800 disabled:opacity-50 transition"
                                    disabled="@submittingPosChange">
                                @(submittingPosChange ? "Submitting for Approval…" : "Submit for Approval →")
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public string? ActiveSection { get; set; }
    [Parameter] public string? EntityRoute { get; set; }
    [Parameter] public int? EntityId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? QueryTab { get; set; }
    [SupplyParameterFromQuery(Name = "teamId")] public int? QueryTeamId { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public int? QueryProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "requestId")] public int? NotificationRequestId { get; set; }
    [SupplyParameterFromQuery(Name = "entityType")] public string? EntityTypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "entityId")] public int? EntityIdQuery { get; set; }

    // Tab state: "Home", "MyTeam", "Calendar", "Request", "Onboarding", "LeaveLog", "Attendance", "TimeChange", "OrgDaily"
    private string activeWorkspaceTab = "Home";
    private string activeReqSubTab = "leave";
    private string teamCenterSubTab = "members";

    // Teams & Staff data
    private List<TeamDto> myTeams = new();
    private int? selectedTeamId;
    private TeamDto? selectedTeam => myTeams.FirstOrDefault(t => t.TeamId == selectedTeamId);
    private TeamDto? helpDeskTeam;

    public sealed record TeamStaffFlattened(int StaffId, string FullName, bool IsSuperVisor, int TeamId, string TeamName);
    private List<TeamStaffFlattened> allTeamStaff = new();
    private List<TeamStaffFlattened> CurrentTeamStaffList =>
        (selectedTeamId.HasValue ? allTeamStaff.Where(s => s.TeamId == selectedTeamId.Value) : allTeamStaff)
        .OrderBy(s => !s.IsSuperVisor).ThenBy(s => s.FullName).ToList();

    // Projects & Tasks
    private List<TeamProjectDto> currentTeamProjects = new();
    private bool loadingProjects;
    private int? selectedProjectId;
    private TeamProjectTaskDto? selectedTaskModalItem;
    private bool showSearchTeamsModal;

    // Attendance
    private List<TeamAttendanceDto> todayAttendance = new();

    // Requests
    private List<PendingLeaveRequestDto> pendingLeaves = new();
    private PendingLeaveRequestDto? selectedLeave;
    private List<DutyRequestRow> pendingDutyRequests = new();
    private string? leaveActionMessage;
    private bool executingAction;

    // Attendance & Uneven log request state in workspace
    private List<AttendanceRequestRow> attendanceRequestsList = new();
    private AttendanceRequestRow? selectedAttendanceRequest;
    private AttendanceReview? attendanceReview;
    private string? attendanceActionComment;
    private string? attendanceReviewError;
    private bool attendanceActing;
    private bool attendanceLoading;

    private int AttendancePendingCount => attendanceRequestsList.Count(r => r.Kind == "Attendance" && (r.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase)));
    private int UnevenLogPendingCount => attendanceRequestsList.Count(r => r.Kind == "Uneven-log correction" && (r.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase)));


    // Search & Directory

    // Recent Searches & Todos
    private List<WorkspaceSearchResult> recentSearchItems = new();
    private List<UserTodoDto> todoItems = new();

    // Contextual Panel Management
    private enum RightPanelType { None, Member360, Evaluation, ProjectDetails }
    private RightPanelType activeRightPanel = RightPanelType.None;
    private WorkspaceSearchResult? selectedEntityItem;
    private int? inspectedStaffId;
    private string inspectedStaffName = "";
    private WorkspaceTab inspectedStaffTab = WorkspaceTab.Overview;

    private int? evalStaffId;
    private string evalStaffName = "";

    // Position Change Modal
    private bool showPositionChangeModal;
    private bool loadingPositionData;
    private bool submittingPosChange;
    private int? posModalStaffId;
    private string posModalStaffName = "";
    private string? posModalError;
    private Data? posData;
    private Assignment? posCurrentAssignment;
    private int posJobId;
    private int posSelectedFrameworkId;
    private int posSelectedMatrixId;
    private int posSelectedPositionId;
    private int? posSelectedJobMatrixStepId;
    private DateTime posFromDate = DateTime.Today.AddDays(1);
    private string posReason = "";

    // Overall states
    private bool loading = true;
    private bool isFullWidth;

    // Metric Calculations
    private int TotalStaffCount => allTeamStaff.Select(s => s.StaffId).Distinct().Count();
    private int PresentCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Present);
    private int SickLeaveCount => todayAttendance.Count(a => a.Status == AttendanceStatus.SickLeave);
    private int FamilyLeaveCount => todayAttendance.Count(a => a.Status == AttendanceStatus.FamilyLeave);
    private int TotalLeavesCount => todayAttendance.Count(a => a.Status is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave);
    private int AbsentCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Absent);
    private int AvailableStaffCount => Math.Max(0, TotalStaffCount - TotalLeavesCount - AbsentCount);
    private int TotalPendingRequestsCount => pendingLeaves.Count + pendingDutyRequests.Count + AttendancePendingCount + UnevenLogPendingCount;

    protected override async Task OnInitializedAsync()
    {
        SyncTabsFromRouteAndQuery();
        await LoadAllDataAsync();
        if (inspectedStaffId.HasValue)
        {
            var match = allTeamStaff.FirstOrDefault(s => s.StaffId == inspectedStaffId.Value);
            if (match != null && !string.IsNullOrWhiteSpace(match.FullName))
            {
                inspectedStaffName = match.FullName;
            }
        }
        if (NotificationRequestId.HasValue && selectedLeave == null)
        {
            selectedLeave = pendingLeaves.FirstOrDefault(l => l.RequestId == NotificationRequestId.Value);
        }
        if (selectedEntityItem != null && (selectedEntityItem.Name?.StartsWith(selectedEntityItem.EntityType.ToString()) ?? true))
        {
            try
            {
                var resolved = await RecentSearches.ResolveAsync(selectedEntityItem.EntityType, selectedEntityItem.Id);
                if (resolved != null) selectedEntityItem = resolved;
            }
            catch { }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        SyncTabsFromRouteAndQuery();
        if (inspectedStaffId.HasValue && (string.IsNullOrWhiteSpace(inspectedStaffName) || inspectedStaffName.StartsWith("Staff #")))
        {
            var match = allTeamStaff.FirstOrDefault(s => s.StaffId == inspectedStaffId.Value);
            if (match != null && !string.IsNullOrWhiteSpace(match.FullName))
            {
                inspectedStaffName = match.FullName;
            }
        }
        if (selectedEntityItem != null && (selectedEntityItem.Name?.StartsWith(selectedEntityItem.EntityType.ToString()) ?? true))
        {
            try
            {
                var resolved = await RecentSearches.ResolveAsync(selectedEntityItem.EntityType, selectedEntityItem.Id);
                if (resolved != null) selectedEntityItem = resolved;
            }
            catch { }
        }
        if (selectedTeamId.HasValue && activeWorkspaceTab == "MyTeam" && currentTeamProjects.Count == 0)
        {
            await LoadTeamProjectsAsync(selectedTeamId.Value);
        }
    }

    private void SyncTabsFromRouteAndQuery()
    {
        if (string.Equals(QueryTab, "home", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(EntityRoute))
        {
            activeWorkspaceTab = "Home";
            inspectedStaffId = null;
            selectedEntityItem = null;
            return;
        }
        var entity = EntityRoute ?? EntityTypeQuery;
        var id = EntityId ?? EntityIdQuery;
        if (id.HasValue && id.Value > 0)
        {
            if (string.Equals(entity, "staff", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(entity, WorkspaceEntityType.Staff.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                inspectedStaffId = id.Value;
                inspectedStaffName = allTeamStaff.FirstOrDefault(s => s.StaffId == id.Value)?.FullName ?? $"Staff #{id.Value}";
                inspectedStaffTab = (ActiveSection?.ToLowerInvariant()) switch
                {
                    "leave" => WorkspaceTab.Leave,
                    "attendance" => WorkspaceTab.Attendance,
                    "position" => WorkspaceTab.Position,
                    "finance" => WorkspaceTab.Finance,
                    "performance" => WorkspaceTab.Performance,
                    "ot" or "overtime" => WorkspaceTab.OT,
                    "job-related" or "job-related-items" or "jobrelateditems" or "job-items" or "jobitems" or "jobitem" => WorkspaceTab.JobRelatedItems,
                    "personal-items" or "personalitems" or "personal-item" or "personal" => WorkspaceTab.PersonalItems,
                    "documents" => WorkspaceTab.Documents,
                    "leave-type" or "leavetype" => WorkspaceTab.LeaveType,
                    "schedule" => WorkspaceTab.Schedule,
                    "work-types" or "worktypes" => WorkspaceTab.WorkTypes,
                    "staff-transfer" or "stafftransfer" => WorkspaceTab.StaffTransfer,
                    _ => WorkspaceTab.Overview
                };
                activeWorkspaceTab = "Staff";
                return;
            }
            else if (Enum.TryParse<WorkspaceEntityType>(entity, true, out var parsedType) && Enum.IsDefined(parsedType))
            {
                selectedEntityItem = new WorkspaceSearchResult
                {
                    Id = id.Value,
                    EntityType = parsedType,
                    Name = $"{parsedType} #{id.Value}"
                };
                activeWorkspaceTab = "Home";
            }
        }

        if (NotificationRequestId.HasValue && NotificationRequestId.Value > 0)
        {
            activeWorkspaceTab = "Request";
            activeReqSubTab = "leave";
            selectedLeave = pendingLeaves.FirstOrDefault(l => l.RequestId == NotificationRequestId.Value);
        }
        else if (!string.IsNullOrWhiteSpace(QueryTab))
        {
            activeWorkspaceTab = QueryTab.ToLowerInvariant() switch
            {
                "my-teams" or "myteam" or "teams" or "team" => "MyTeam",
                "calendar" or "calendars" => "Calendar",
                "requests" or "request" => "Request",
                "onboarding" => "Onboarding",
                "leave-log" or "leave" => "LeaveLog",
                "attendance" => "Attendance",
                "time-change" or "timechange" or "shift" => "TimeChange",
                "org-daily" or "orgdaily" or "daily" => "OrgDaily",
                _ => "Home"
            };
        }
        else if (!string.IsNullOrWhiteSpace(ActiveSection))
        {
            activeWorkspaceTab = ActiveSection.ToLowerInvariant() switch
            {
                "team" or "teams" or "my-teams" => "MyTeam",
                "calendar" or "calendars" => "Calendar",
                "request" or "requests" => "Request",
                "onboarding" => "Onboarding",
                "leave" or "leave-log" => "LeaveLog",
                "attendance" => "Attendance",
                "time-change" or "shift" => "TimeChange",
                "org-daily" or "daily" => "OrgDaily",
                _ => "Home"
            };
        }

        if (QueryTeamId.HasValue && QueryTeamId.Value > 0)
        {
            selectedTeamId = QueryTeamId.Value;
        }

        if (QueryProjectId.HasValue && QueryProjectId.Value > 0)
        {
            selectedProjectId = QueryProjectId.Value;
            activeRightPanel = RightPanelType.ProjectDetails;
        }
    }

    private void UpdateUrl()
    {
        if (activeWorkspaceTab == "Staff" && inspectedStaffId.HasValue)
        {
            var sectionSlug = HRM.Helpers.SectionRoutes.Slug(inspectedStaffTab.ToString());
            var staffUri = $"/admin/my/workspace/staff/{inspectedStaffId.Value}/{sectionSlug}";
            Navigation.NavigateTo(staffUri, replace: false);
            return;
        }

        var tabKey = activeWorkspaceTab switch
        {
            "MyTeam" => "my-teams",
            "Calendar" => "calendar",
            "Request" => "requests",
            "Onboarding" => "onboarding",
            "LeaveLog" => "leave-log",
            "Attendance" => "attendance",
            "TimeChange" => "time-change",
            "OrgDaily" => "org-daily",
            _ => "home"
        };

        var uri = $"/admin/my/workspace?tab={tabKey}";
        if (activeWorkspaceTab == "MyTeam" && selectedTeamId.HasValue)
        {
            uri += $"&teamId={selectedTeamId.Value}";
        }
        if (activeWorkspaceTab == "MyTeam" && selectedProjectId.HasValue && activeRightPanel == RightPanelType.ProjectDetails)
        {
            uri += $"&projectId={selectedProjectId.Value}";
        }
        if (activeWorkspaceTab == "Home")
        {
            if (false && inspectedStaffId.HasValue)
            {
                uri += $"&entityType=Staff&entityId={inspectedStaffId.Value}";
            }
            else if (selectedEntityItem != null)
            {
                uri += $"&entityType={selectedEntityItem.EntityType}&entityId={selectedEntityItem.Id}";
            }
        }

        Navigation.NavigateTo(uri, replace: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.workspace.full-width");
                if (bool.TryParse(saved, out var val) && val != isFullWidth)
                {
                    isFullWidth = val;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "hrm.workspace.full-width", isFullWidth.ToString().ToLowerInvariant());
        }
        catch { }
    }

    private async Task LoadAllDataAsync()
    {
        loading = true;
        try
        {
            // 1. Teams & Staff
            myTeams = await TeamService.GetMyTeamsAsync() ?? new();
            if (selectedTeamId.HasValue && !myTeams.Any(t => t.TeamId == selectedTeamId.Value))
            {
                var discovered = await TeamService.GetTeamByIdAsync(selectedTeamId.Value);
                if (discovered != null)
                {
                    myTeams.Insert(0, discovered);
                }
            }
            allTeamStaff = myTeams
                .SelectMany(t => t.Staffs.Select(s => new TeamStaffFlattened(s.StaffId, s.FullName, s.IsSuperVisor, t.TeamId, t.Name)))
                .GroupBy(s => s.StaffId)
                .Select(g => g.First())
                .ToList();

            if (selectedTeamId == null && myTeams.Count > 0)
            {
                selectedTeamId = myTeams[0].TeamId;
            }

            // 2. Help Desk Team
            try
            {
                helpDeskTeam = await TeamService.GetHelpDeskTeamAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load Help Desk team for workspace.");
            }

            // 3. Team Projects
            if (selectedTeamId.HasValue)
            {
                await LoadTeamProjectsAsync(selectedTeamId.Value);
            }

            // 4. Attendance
            try
            {
                todayAttendance = await AttendanceLogService.GetMyTeamAttendanceTodayAsync() ?? new();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load today's attendance for workspace.");
            }

            // 5. Requests
            await RefreshRequestsAsync();

            // 6. Recent Searches
            try
            {
                recentSearchItems = await RecentSearches.GetAsync() ?? new();
            }
            catch { }

            // 7. To Do Items
            try
            {
                var todoPage = await Todos.GetMyTodosAsync(includeCompleted: false, page: 1);
                todoItems = todoPage?.Items?.ToList() ?? new();
            }
            catch { }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load complete workspace data.");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadTeamProjectsAsync(int teamId)
    {
        loadingProjects = true;
        try
        {
            currentTeamProjects = await TeamService.GetTeamProjectsAsync(teamId) ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load team projects for team {TeamId}", teamId);
            currentTeamProjects.Clear();
        }
        finally
        {
            loadingProjects = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        await LoadAllDataAsync();
        ToastService.Success("Workspace refreshed.");
    }

    private async Task RefreshRequestsAsync()
    {
        try
        {
            pendingLeaves = await Leaves.GetPendingLeaveRequestsAsync() ?? new();
            if (selectedLeave != null)
            {
                selectedLeave = pendingLeaves.FirstOrDefault(r => r.RequestId == selectedLeave.RequestId);
            }
        }
        catch { }

        try
        {
            var dutyRows = await Duties.GetRequestsAsync() ?? new();
            pendingDutyRequests = dutyRows.Where(r => r.CanAccept || r.CanApprove).ToList();
        }
        catch { }

        try
        {
            attendanceLoading = true;
            var filter = new AttendanceRequestFilter(DateOnly.FromDateTime(DateTime.Today.AddDays(-60)), DateOnly.FromDateTime(DateTime.Today.AddDays(30)));
            var page = await AttendanceQueries.GetReceivedAsync(filter);
            attendanceRequestsList = page?.Requests ?? new();
            if (selectedAttendanceRequest != null)
            {
                selectedAttendanceRequest = attendanceRequestsList.FirstOrDefault(r => r.RequestId == selectedAttendanceRequest.RequestId);
                if (selectedAttendanceRequest != null)
                {
                    attendanceReview = await AttendanceReviewService.GetAsync(selectedAttendanceRequest.RequestId);
                }
                else
                {
                    attendanceReview = null;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed loading attendance requests for workspace");
        }
        finally
        {
            attendanceLoading = false;
        }
    }

    private string? previousTabBeforeStaff;

    private void SetActiveTab(string tab)
    {
        if (activeWorkspaceTab != "Staff")
        {
            previousTabBeforeStaff = activeWorkspaceTab;
        }
        if (tab == "Home")
        {
            inspectedStaffId = null;
            selectedEntityItem = null;
        }
        activeWorkspaceTab = tab;
        UpdateUrl();
    }

    private void OpenStaffWorkspace(int staffId, string? staffName = null)
    {
        if (activeWorkspaceTab != "Staff")
        {
            previousTabBeforeStaff = activeWorkspaceTab;
        }
        inspectedStaffId = staffId;
        inspectedStaffName = staffName ?? allTeamStaff.FirstOrDefault(s => s.StaffId == staffId)?.FullName ?? $"Staff #{staffId}";
        inspectedStaffTab = WorkspaceTab.Overview;
        activeWorkspaceTab = "Staff";
        UpdateUrl();
