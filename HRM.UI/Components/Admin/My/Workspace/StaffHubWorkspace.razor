    private async Task SubmitPositionChangeAsync()
    {
        if (submittingPosChange || !posModalStaffId.HasValue || posData == null) return;

        if (posJobId == 0)
        {
            posModalError = "Please select an employment contract.";
            return;
        }

        if (posSelectedFrameworkId == 0 || posSelectedMatrixId == 0 || posSelectedPositionId == 0)
        {
            posModalError = "Please select a framework, matrix, and vacant position slot.";
            return;
        }

        if (string.IsNullOrWhiteSpace(posReason))
        {
            posModalError = "Please provide a reason / justification for this position change.";
            return;
        }

        submittingPosChange = true;
        posModalError = null;

        try
        {
            await PositionService.SaveAsync(
                posModalStaffId.Value,
                posJobId,
                posSelectedPositionId,
                posFromDate,
                null,
                posReason,
                posCurrentAssignment,
                change: true,
                remove: false,
                posSelectedJobMatrixStepId,
                terminationRequestTypeId: null
            );

            ToastService.Success("Position change request submitted for approval.");
            ClosePositionChangeModal();

            activeWorkspaceTab = "Request";
            activeReqSubTab = "position";
            UpdateUrl();
            await RefreshRequestsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit position change for staff {StaffId}", posModalStaffId);
            posModalError = ex.Message;
        }
        finally
        {
            submittingPosChange = false;
        }
    }

