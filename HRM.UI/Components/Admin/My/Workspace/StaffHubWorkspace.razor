    <!-- Modals -->
    <!-- 1. Task Details Modal -->
    <TaskDetailModal TaskItem="selectedTaskModalItem" OnClose="() => selectedTaskModalItem = null" />

    <!-- Assignment Modal (project / task assignment from a team member) -->
    <AssignmentModal Visible="showAssignModal" Mode="assignMode" StaffId="assignStaffId" StaffName="@assignStaffName"
                     OnSaved="RefreshAssignmentViewsAsync" OnClose="() => showAssignModal = false" />

    <!-- Create Project Modal -->
    <CreateProjectModal Visible="showCreateProjectModal"
                        TeamId="selectedTeamId"
                        TeamName="@(selectedTeam?.Name)"
                        Teams="myTeams"
                        StaffOptions="GetStaffOptionsForProjectModal()"
                        OnSaved="HandleProjectCreatedAsync"
                        OnClose="() => showCreateProjectModal = false" />

    <!-- 2. Search Teams Modal -->
    <SearchTeamsModal IsOpen="showSearchTeamsModal"
                      OnClose="() => showSearchTeamsModal = false"
                      OnTeamSelected="HandleSearchTeamSelected" />

    <!-- 3. Position Change Modal (Through Approval Flow) -->
    @if (showPositionChangeModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
            <div class="w-full max-w-xl rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-2xl space-y-2 max-h-[90vh] overflow-y-auto">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Request Position Change</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@posModalStaffName (ID: #@posModalStaffId)</p>
                    </div>
                    <button type="button"
                            class="rounded-lg p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                            @onclick="ClosePositionChangeModal">
                        ✕
                    </button>
                </div>

                @if (posModalError != null)
                {
                    <div class="rounded-lg border border-rose-200 bg-rose-50 dark:bg-rose-950/40 p-2.5 text-xs text-rose-800 dark:text-rose-300">
                        @posModalError
                    </div>
                }

                @if (loadingPositionData)
                {
                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                        <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                        Loading staff position and framework details…
                    </div>
                }
                else if (posData != null)
                {
                    <div class="rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/30 p-3 text-xs text-amber-900 dark:text-amber-200 flex items-start gap-2">
                        <span class="text-base">ℹ️</span>
                        <div>
                            <span class="font-bold">Approval Flow Required:</span>
                            This action initiates a formal <strong>Job Position Request</strong>. It must be reviewed and approved through the organizational approval flow before taking effect.
                        </div>
                    </div>

                    @if (posCurrentAssignment != null)
                    {
                        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-2.5 text-xs">
                            <span class="font-semibold text-slate-700 dark:text-slate-300">Current Position:</span>
                            <span class="font-bold text-slate-900 dark:text-slate-100 ml-1">@posCurrentAssignment.Name</span>
                            <span class="text-slate-500 dark:text-slate-400 ml-1">(Job #@posCurrentAssignment.JobId · From @posCurrentAssignment.From.ToString("dd MMM yyyy"))</span>
                        </div>
                    }

                    <form @onsubmit="SubmitPositionChangeAsync" @onsubmit:preventDefault class="space-y-2 text-xs">
                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Employment</label>
                            <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                    @bind="posJobId" required>
                                <option value="0">Select employment contract</option>
                                @foreach (var job in posData.Jobs)
                                {
                                    <option value="@job.Id">@job.Name</option>
                                }
                            </select>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Framework</label>
                                <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                        @bind="posSelectedFrameworkId" @bind:after="OnPosFrameworkChanged" required>
                                    <option value="0">Select framework</option>
                                    @foreach (var fw in posData.Frameworks)
                                    {
                                        <option value="@fw.Id">@fw.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Position Matrix</label>
                                <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                        @bind="posSelectedMatrixId" @bind:after="OnPosMatrixChanged" disabled="@(posSelectedFrameworkId == 0)" required>
                                    <option value="0">Select position matrix</option>
                                    @foreach (var matrix in posData.PositionMatrices.Where(x => x.FrameworkId == posSelectedFrameworkId))
                                    {
                                        <option value="@matrix.Id" disabled="@(matrix.AvailableSlots == 0)">
                                            @matrix.Name (@matrix.AvailableSlots/@matrix.ApprovedSlots slots available)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Vacant Position Slot</label>
                            <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                    @bind="posSelectedPositionId" disabled="@(posSelectedMatrixId == 0)" required>
                                <option value="0">Select vacant position</option>
                                @foreach (var pos in posData.Positions.Where(p => p.FrameworkId == posSelectedFrameworkId && p.MatrixId == posSelectedMatrixId))
                                {
                                    <option value="@pos.Id">@pos.Name · #@pos.Id</option>
                                }
                            </select>
                        </div>

                        @if (posData.Positions.FirstOrDefault(x => x.Id == posSelectedPositionId)?.Pay is {} payDef && payDef.Steps.Count > 0)
                        {
                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Job Pay Step</label>
                                <select class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                        @bind="posSelectedJobMatrixStepId">
                                    <option value="">Select pay step</option>
                                    @foreach (var s in payDef.Steps)
                                    {
                                        <option value="@s.Id">Step @s.Number · @s.JobAllowance.ToString("N2") @payDef.Currency</option>
                                    }
                                </select>
                            </div>
                        }

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Effective Date (From)</label>
                            <input type="date"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                   @bind="posFromDate" required />
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 p-1">Reason / Justification</label>
                            <textarea class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100"
                                      rows="2" maxlength="500" placeholder="State the reason for this position change..."
                                      @bind="posReason" required></textarea>
                        </div>

                        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
                            <button type="button"
                                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50"
                                    @onclick="ClosePositionChangeModal"
                                    disabled="@submittingPosChange">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="rounded-lg bg-teal-700 px-4 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-teal-800 disabled:opacity-50 transition"
                                    disabled="@submittingPosChange">
                                @(submittingPosChange ? "Submitting for Approval…" : "Submit for Approval →")
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public string? ActiveSection { get; set; }
    [Parameter] public string? EntityRoute { get; set; }
    [Parameter] public int? EntityId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? QueryTab { get; set; }
    [SupplyParameterFromQuery(Name = "teamId")] public int? QueryTeamId { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public int? QueryProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "requestId")] public int? NotificationRequestId { get; set; }
    [SupplyParameterFromQuery(Name = "entityType")] public string? EntityTypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "entityId")] public int? EntityIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "subtab")] public string? QuerySubTab { get; set; }
    [SupplyParameterFromQuery(Name = "teamTab")] public string? QueryTeamTab { get; set; }

    // Tab state: "Home", "MyTeam", "Calendar", "Request", "Onboarding", "LeaveLog", "Attendance", "TimeChange", "OrgDaily"
    private string activeWorkspaceTab = "Home";
    private string activeReqSubTab = "leave";
    private string teamCenterSubTab = "members";

    // Selected Team Subtab Filter States
    private string teamAttendanceFilter = "all";
    private string teamAttendanceSearch = "";
    private string teamRequestFilter = "all";
    private DateTime teamScheduleDate = DateTime.Today;
    private List<DutyRosterRow> teamDutyRoster = new();
    private bool loadingTeamSchedule;
    private string? teamScheduleError;
    private int? selectedTeamScheduleStaffId;
    private int? selectedTeamLeaveStaffId;

    // Teams & Staff data
    private List<TeamDto> myTeams = new();
    private int? selectedTeamId;
    private TeamDto? selectedTeam => myTeams.FirstOrDefault(t => t.TeamId == selectedTeamId);
    private TeamDto? helpDeskTeam;

    private SubTeamWorkspaceDto? currentSubTeamWorkspace;
    private int? selectedSubTeamId;
    private SubTeamDto? selectedSubTeam => currentSubTeamWorkspace?.SubTeams.FirstOrDefault(st => st.TeamId == selectedSubTeamId);
    private bool loadingSubTeams;
    private string subTeamMemberSearchTerm = "";
    private bool isCompactDirectory => activeRightPanel != RightPanelType.None;

    public sealed record TeamStaffFlattened(int StaffId, string FullName, bool IsSuperVisor, int TeamId, string TeamName);
    private List<TeamStaffFlattened> allTeamStaff = new();
    private List<TeamStaffFlattened> CurrentTeamStaffList
    {
        get
        {
            if (selectedTeam == null)
            {
                return [];
            }

            // The parent team roster is already restricted to active staff by the API.
            // Sub-team assignments only classify those staff; they must not add people
            // who are no longer part of the parent team.
            IEnumerable<TeamStaffFlattened> baseList = selectedTeam.Staffs.Select(s => new TeamStaffFlattened(
                s.StaffId, s.FullName, s.IsSuperVisor, selectedTeam.TeamId, selectedTeam.Name));
            if (selectedSubTeamId.HasValue && selectedSubTeam != null)
            {
                var subStaffIds = selectedSubTeam.Members.Select(m => m.StaffId).ToHashSet();
                baseList = baseList.Where(s => subStaffIds.Contains(s.StaffId));
            }
            return baseList.OrderBy(s => !s.IsSuperVisor).ThenBy(s => s.FullName).ToList();
        }
    }

    private string? GetMemberSubTeamName(int staffId)
    {
        if (currentSubTeamWorkspace?.SubTeams == null) return null;
        return currentSubTeamWorkspace.SubTeams
            .FirstOrDefault(st => st.Members.Any(m => m.StaffId == staffId))?.Name;
    }

    private void OpenSubTeamStaff(int subTeamId)
    {
        if (selectedSubTeamId == subTeamId && activeRightPanel == RightPanelType.SubTeamStaff)
        {
            CloseRightPanel();
        }
        else
        {
            selectedSubTeamId = subTeamId;
            subTeamMemberSearchTerm = "";
            activeRightPanel = RightPanelType.SubTeamStaff;
        }
    }

    private void OpenCreateSubTeam()
    {
        selectedSubTeamId = null;
        activeRightPanel = RightPanelType.CreateSubTeam;
    }

    private void ClearSubTeamSelection()
    {
        selectedSubTeamId = null;
        subTeamMemberSearchTerm = "";
        if (activeRightPanel is RightPanelType.SubTeamStaff or RightPanelType.CreateSubTeam)
        {
            activeRightPanel = RightPanelType.None;
        }
    }

    private void HandleRightPanelSubTeamSelected(int? subTeamId)
    {
        selectedSubTeamId = subTeamId;
        subTeamMemberSearchTerm = "";
        if (subTeamId.HasValue)
        {
            activeRightPanel = RightPanelType.SubTeamStaff;
        }
        else
        {
            activeRightPanel = RightPanelType.CreateSubTeam;
        }
    }

    private async Task LoadSubTeamsForCurrentTeamAsync()
    {
        if (!selectedTeamId.HasValue)
        {
            currentSubTeamWorkspace = null;
            return;
        }
        loadingSubTeams = true;
        try
        {
            currentSubTeamWorkspace = await TeamService.LoadSubTeamsAsync(selectedTeamId.Value);
            if (selectedTeam != null && currentSubTeamWorkspace != null)
            {
                selectedTeam.SubTeamCount = currentSubTeamWorkspace.SubTeams.Count(st => st.IsActive);
            }
        }
        catch
        {
            currentSubTeamWorkspace = null;
        }
        finally
        {
            loadingSubTeams = false;
        }
    }

    private async Task OnSubTeamsChangedAsync()
    {
        await LoadSubTeamsForCurrentTeamAsync();
        try
        {
            var refreshed = await TeamService.GetMyTeamsAsync();
            if (refreshed != null)
            {
                foreach (var t in refreshed)
                {
                    var match = myTeams.FirstOrDefault(m => m.TeamId == t.TeamId);
                    if (match != null) match.SubTeamCount = t.SubTeamCount;
                }
            }
        }
        catch { }
        StateHasChanged();
    }

    private HRM.DTOs.UserContext.UserContextDto? currentUserContext;
    private bool IsSupervisorOfCurrentTeam
    {
        get
        {
            if (currentUserContext?.IsSuperAdministrator == true || currentUserContext?.IsOrganisationAdmin == true) return true;
            if (!selectedTeamId.HasValue) return false;
            var staffId = currentUserContext?.IndividualId ?? currentUserContext?.BusinessEntityId ?? 0;
            if (staffId <= 0) return false;
            return CurrentTeamStaffList.Any(s => s.StaffId == staffId && s.IsSuperVisor);
        }
    }

    // Projects & Tasks
    private List<TeamProjectDto> currentTeamProjects = new();
    private bool loadingProjects;
    private int? selectedProjectId;
    private int? memberActionsMenuStaffId;
    private TeamProjectTaskDto? selectedTaskModalItem;
    private bool showSearchTeamsModal;

    // Attendance
    private List<TeamAttendanceDto> todayAttendance = new();

    // Requests
    private List<PendingLeaveRequestDto> pendingLeaves = new();
    private PendingLeaveRequestDto? selectedLeave;
    private List<DutyRequestRow> pendingDutyRequests = new();
    private string? leaveActionMessage;
    private bool executingAction;

    // Attendance & Uneven log request state in workspace
    private List<AttendanceRequestRow> attendanceRequestsList = new();
    private AttendanceRequestRow? selectedAttendanceRequest;
    private AttendanceReview? attendanceReview;
    private string? attendanceActionComment;
    private string? attendanceReviewError;
    private bool attendanceActing;
    private bool attendanceLoading;

    private int AttendancePendingCount => attendanceRequestsList.Count(r => r.Kind == "Attendance" && (r.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase)));
    private int UnevenLogPendingCount => attendanceRequestsList.Count(r => r.Kind == "Uneven-log correction" && (r.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase) || r.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase)));


    // Search & Directory

    // Recent Searches & Todos
    private List<WorkspaceSearchResult> recentSearchItems = new();
    private List<UserTodoDto> todoItems = new();

    // Contextual Panel Management
    private enum RightPanelType { None, Member360, Evaluation, ProjectDetails, SubTeamStaff, CreateSubTeam }
    private RightPanelType activeRightPanel = RightPanelType.None;
    private WorkspaceSearchResult? selectedEntityItem;
    private int? inspectedStaffId;
    private string inspectedStaffName = "";
    private ProfileOverviewDto? inspectedStaffProfile;
    private int? loadedProfileStaffId;
    private WorkspaceTab inspectedStaffTab = WorkspaceTab.Overview;

    private async Task EnsureInspectedStaffProfileLoadedAsync()
    {
        if (!inspectedStaffId.HasValue)
        {
            inspectedStaffProfile = null;
            loadedProfileStaffId = null;
            return;
        }

        if (loadedProfileStaffId == inspectedStaffId.Value && inspectedStaffProfile != null)
        {
            return;
        }

        try
        {
            loadedProfileStaffId = inspectedStaffId.Value;
            inspectedStaffProfile = await ProfileService.GetProfileAsync(inspectedStaffId.Value);
            if (inspectedStaffProfile != null && !string.IsNullOrWhiteSpace(inspectedStaffProfile.FullName))
            {
                inspectedStaffName = inspectedStaffProfile.FullName;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load profile for staff {StaffId}", inspectedStaffId.Value);
        }
    }
    private int? inspectedOrgId;
    private string inspectedOrgName = "";
    private WorkspaceTab inspectedOrgTab = WorkspaceTab.Overview;

    private int? evalStaffId;
    private string evalStaffName = "";

    // Position Change Modal
    private bool showPositionChangeModal;
    private bool loadingPositionData;
    private bool submittingPosChange;
    private int? posModalStaffId;
    private string posModalStaffName = "";
    private string? posModalError;
    private Data? posData;
    private Assignment? posCurrentAssignment;
    private int posJobId;
    private int posSelectedFrameworkId;
    private int posSelectedMatrixId;
    private int posSelectedPositionId;
    private int? posSelectedJobMatrixStepId;
    private DateTime posFromDate = DateTime.Today.AddDays(1);
    private string posReason = "";

    // Overall states
    private bool loading = true;
    private bool isFullWidth;

    // Metric Calculations
    private int TotalStaffCount => allTeamStaff.Select(s => s.StaffId).Distinct().Count();
    private int PresentCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Present);
    private int SickLeaveCount => todayAttendance.Count(a => a.Status == AttendanceStatus.SickLeave);
    private int FamilyLeaveCount => todayAttendance.Count(a => a.Status == AttendanceStatus.FamilyLeave);
    private int TotalLeavesCount => todayAttendance.Count(a => a.Status is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave);
    private int AbsentCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Absent);
    private int AvailableStaffCount => Math.Max(0, TotalStaffCount - TotalLeavesCount - AbsentCount);
    private int JobItemsPendingCount => itemRequestsList.Count(r => r.Purpose == "Job related" && (r.Status is "Submitted" or "ReturnRequested"));
    private int PersonalItemsPendingCount => itemRequestsList.Count(r => r.Purpose != "Job related" && (r.Status is "Submitted" or "ReturnRequested"));
    private int CertificatesPendingCount => certificateRequestsList.Count(r => r.Status is "Submitted" or "UnderReview");
    private int TotalPendingRequestsCount => pendingLeaves.Count + pendingDutyRequests.Count + AttendancePendingCount + UnevenLogPendingCount + JobItemsPendingCount + PersonalItemsPendingCount + CertificatesPendingCount;

    // Staff-scoped Pending Badge Helpers for Staff Workspace Tabs
    private int GetStaffPendingLeaveCount(int staffId, string? staffName) =>
        !string.IsNullOrWhiteSpace(staffName)
            ? pendingLeaves.Count(l => string.Equals(l.Applicant?.Trim(), staffName.Trim(), StringComparison.OrdinalIgnoreCase))
            : 0;

    private int GetStaffPendingAttendanceCount(int staffId, string? staffName) =>
        !string.IsNullOrWhiteSpace(staffName)
            ? attendanceRequestsList.Count(a =>
                (a.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase)
                 || a.Status.Contains("Submitted", StringComparison.OrdinalIgnoreCase)
                 || a.Status.Contains("Verification", StringComparison.OrdinalIgnoreCase)
                 || a.Status.Contains("Approval", StringComparison.OrdinalIgnoreCase))
                && string.Equals(a.StaffName?.Trim(), staffName.Trim(), StringComparison.OrdinalIgnoreCase))
            : 0;

    private int GetStaffPendingJobItemsCount(int staffId, string? staffName) =>
        !string.IsNullOrWhiteSpace(staffName)
            ? itemRequestsList.Count(r => string.Equals(r.StaffName?.Trim(), staffName.Trim(), StringComparison.OrdinalIgnoreCase) && r.Purpose == "Job related" && (r.Status is "Submitted" or "ReturnRequested"))
            : 0;

    private int GetStaffPendingPersonalItemsCount(int staffId, string? staffName) =>
        !string.IsNullOrWhiteSpace(staffName)
            ? itemRequestsList.Count(r => string.Equals(r.StaffName?.Trim(), staffName.Trim(), StringComparison.OrdinalIgnoreCase) && r.Purpose != "Job related" && (r.Status is "Submitted" or "ReturnRequested"))
            : 0;

    private int GetStaffPendingCertificatesCount(int staffId) =>
        certificateRequestsList.Count(r => r.IndividualId == staffId && (r.Status is "Submitted" or "UnderReview"));

    private int GetStaffTotalPendingCount(int staffId, string? staffName) =>
        GetStaffPendingLeaveCount(staffId, staffName)
        + GetStaffPendingAttendanceCount(staffId, staffName)
        + GetStaffPendingJobItemsCount(staffId, staffName)
        + GetStaffPendingPersonalItemsCount(staffId, staffName)
        + GetStaffPendingCertificatesCount(staffId);

