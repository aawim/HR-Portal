                        <span class="rounded-full bg-amber-100 dark:bg-amber-950/60 px-2 py-0.2 text-[10px] font-bold text-amber-800 dark:text-amber-300">
                            @TotalPendingRequestsCount
                        </span>
                    </div>
                    <div class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
