@page "/admin/my/workspace/hub"
@page "/admin/my/workspace/team-hub"
@page "/admin/my/workspace/hub/{ActiveSection}"
@using HRM.DTOs
@using HRM.DTOs.Leave
@using HRM.DTOs.WorkPlanning
@using HRM.Enum
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Components.Admin.My.Workspace.Cards
@using HRM.Components.Admin.My.Workspace.Staff
@using HRM.Components.Admin.My.Workspace.Staff.Tabs
@inject ITeam TeamService
@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService
@inject ILeaveChangeService Leaves
@inject HRM.WorkPlanning.Services.Contracts.DutyRosterServiceContracts.IOperations Duties
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<StaffHubWorkspace> Logger
@inject HRM.Services.ToastService ToastService
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer

<PageTitle>Staff &amp; Team Workspace Hub - HR Portal</PageTitle>

<section class="staff-hub-page w-full min-w-0 p-2 space-y-4 bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors">
    <!-- Sticky Header complying with UI_DESIGN_STANDARD.md -->
    <header class="sticky top-0 z-30 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs px-4 py-3 shadow-xs rounded-2xl">
        <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/40 dark:text-blue-400 shadow-xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">Staff &amp; Team Workspace Hub</h1>
                    @if (selectedTeamId.HasValue && selectedTeam != null)
                    {
                        <span class="rounded-full bg-blue-100 dark:bg-blue-900/40 px-2.5 py-0.5 text-xs font-semibold text-blue-800 dark:text-blue-300">
                            @selectedTeam.Name
                        </span>
                    }
                    else
                    {
                        <span class="rounded-full bg-indigo-100 dark:bg-indigo-900/40 px-2.5 py-0.5 text-xs font-semibold text-indigo-800 dark:text-indigo-300">
                            All Teams (@myTeams.Count)
                        </span>
                    }
                    <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40 flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Live Active
                    </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Unified management center for supervised teams, live workforce attendance, employee 360°, and approval queues.</p>
            </div>
        </div>

        <!-- Header Actions -->
        <div class="flex flex-wrap items-center gap-2">
            <!-- Full Width / Shrink View Toggle -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
                    title="@(isFullWidth ? "Shrink view to standard container" : "Expand to full viewport width")"
                    @onclick="ToggleFullWidthAsync">
                @if (isFullWidth)
                {
                    <svg class="h-3.5 w-3.5 text-slate-600 dark:text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 9L4 4m0 0l5 0m-5 0l0 5M15 9l5-5m0 0l-5 0m5 0l0 5M9 15l-5 5m0 0l5 0m-5 0l0-5M15 15l5 5m0 0l-5 0m5 0l0-5" />
                    </svg>
                    <span>Shrink View</span>
                }
                else
                {
                    <svg class="h-3.5 w-3.5 text-slate-600 dark:text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                    <span>Full Width</span>
                }
            </button>

            <!-- Refresh Button -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition-colors"
                    disabled="@loading"
                    @onclick="RefreshAllAsync">
                <span class="@(loading ? "animate-spin" : "")">↻</span>
                <span>Refresh</span>
            </button>

            <!-- Quick Action: Onboarding -->
            <a href="/admin/my/workspace/onboarding"
               class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 dark:bg-blue-700 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors">
                <span>+</span>
                <span>Staff Onboarding</span>
            </a>

            <!-- Traditional Workspace Link -->
            <a href="/admin/my/workspace"
               class="inline-flex items-center justify-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
               title="Open Classic Workspace">
                <span>Classic View ↗</span>
            </a>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/40 p-3.5 text-xs text-rose-800 dark:text-rose-300 shadow-xs">
            <div class="flex items-center gap-2">
                <span class="text-base">⚠️</span>
                <span>@errorMessage</span>
            </div>
            <button type="button" @onclick="() => errorMessage = null" class="font-bold text-rose-600 dark:text-rose-400 hover:text-rose-800">✕</button>
        </div>
    }

    <!-- KPI Metric Summary Ribbon -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <!-- Metric 1: My Teams -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
                <span class="text-xs font-medium">Supervised Teams</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 text-xs font-bold">
                    👥
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-slate-100">@myTeams.Count</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">teams · @TotalStaffCount staff</span>
            </div>
            <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px]">
                <span class="text-slate-500 dark:text-slate-400">Supervisors: @TotalSupervisorsCount</span>
                <span class="text-blue-600 dark:text-blue-400 font-medium cursor-pointer hover:underline" @onclick='() => FilterTeam(null)'>View all</span>
            </div>
        </div>

        <!-- Metric 2: Today's Team Presence -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
                <span class="text-xs font-medium">Present Today</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 text-xs font-bold">
                    ✓
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">@PresentCount</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">/ @todayAttendance.Count active punches</span>
            </div>
            <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-2 text-[11px]">
                <span class="text-amber-600 dark:text-amber-400 font-semibold cursor-pointer" @onclick="() => FilterAttendanceStatus(AttendanceStatus.Late)">@LateCount Late</span>
                <span class="text-slate-300 dark:text-slate-700">·</span>
                <span class="text-rose-600 dark:text-rose-400 font-semibold cursor-pointer" @onclick="() => FilterAttendanceStatus(AttendanceStatus.Absent)">@AbsentCount Absent</span>
                <span class="text-slate-300 dark:text-slate-700">·</span>
                <span class="text-indigo-600 dark:text-indigo-400 font-semibold cursor-pointer" @onclick="() => FilterAttendanceStatus(AttendanceStatus.Leave)">@LeaveCount Leave</span>
            </div>
        </div>

        <!-- Metric 3: Pending Team Requests -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
                <span class="text-xs font-medium">Pending Approvals</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 text-xs font-bold">
                    ⏳
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-amber-600 dark:text-amber-400">@TotalPendingRequestsCount</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">require supervisor action</span>
            </div>
            <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px]">
                <span class="text-slate-500 dark:text-slate-400">@pendingLeaves.Count Leaves · @pendingDutyRequests.Count Duties</span>
                <span class="text-amber-700 dark:text-amber-400 font-medium cursor-pointer hover:underline" @onclick='() => activeRequestTab = "leave"'>Review Queue</span>
            </div>
        </div>

        <!-- Metric 4: Quick Launch Shortcuts -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3.5 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
                <span class="text-xs font-medium">Quick Operations</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-purple-50 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 text-xs font-bold">
                    ⚡
                </span>
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
                <a href="/online/duty-roster" class="rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    📅 Shift Roster
                </a>
                <a href="/admin/settings/organisations/teams" class="rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    ⚙️ Teams Config
                </a>
                <a href="/admin/my/workspace/onboarding?tab=requests" class="rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    📝 Intakes
                </a>
            </div>
            <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px] text-slate-400 dark:text-slate-500">
                Direct administrative workflows
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 shadow-xs flex flex-wrap items-center justify-between gap-3">
        <!-- Team Selector Pills -->
        <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-1">Team:</span>
            <button type="button"
                    class="rounded-lg px-3 py-1 text-xs font-semibold transition-colors @(selectedTeamId == null ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                    @onclick="() => FilterTeam(null)">
                All Teams (@TotalStaffCount)
            </button>
            @foreach (var team in myTeams)
            {
                <button type="button"
                        @key="team.TeamId"
                        class="rounded-lg px-3 py-1 text-xs font-semibold transition-colors @(selectedTeamId == team.TeamId ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                        @onclick="() => FilterTeam(team.TeamId)">
                    @team.Name (@team.Staffs.Count)
                </button>
            }
        </div>

        <!-- Search Bar -->
        <div class="relative w-full sm:w-72">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text"
                   class="w-full pl-9 pr-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                   placeholder="Search staff name or ID..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button type="button"
                        class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                        @onclick="() => searchTerm = string.Empty">
                    ✕
                </button>
            }
        </div>
    </div>

    <!-- Main Two-Panel Content Grid conforming to UI_DESIGN_STANDARD.md -->
    <div class="page-panels @(isFullWidth ? "page-panels-full" : "page-panels-standard")">
        
        <!-- ========================================== -->
        <!-- LEFT PANEL: Staff & Team Management (7fr)  -->
        <!-- ========================================== -->
        <div class="page-panel-left min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-4">
            
            <!-- Left Panel Navigation Header -->
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3 flex-wrap gap-2">
                <div class="flex items-center gap-2">
                    <!-- Tab Switcher -->
                    <div class="flex rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-slate-50 dark:bg-slate-800/80 text-xs">
                        <button type="button"
                                class="rounded-md px-3 py-1 font-semibold transition @(activeMainTab == "roster" ? "bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200")"
                                @onclick='() => SwitchMainTab("roster")'>
                            👥 Team Roster (@FilteredStaffList.Count)
                        </button>
                        <button type="button"
                                class="rounded-md px-3 py-1 font-semibold transition @(activeMainTab == "attendance" ? "bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200")"
                                @onclick='() => SwitchMainTab("attendance")'>
                            ⏱️ Today's Attendance
                        </button>
                        @if (inspectedStaffId.HasValue)
                        {
                            <button type="button"
                                    class="rounded-md px-3 py-1 font-semibold transition @(activeMainTab == "staff-360" ? "bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200")"
                                    @onclick='() => SwitchMainTab("staff-360")'>
                                👤 Staff 360° (#@inspectedStaffId)
                            </button>
                        }
                    </div>
                </div>

                <!-- View Layout Toggle (Grid vs Compact List) -->
                @if (activeMainTab == "roster")
                {
                    <div class="flex items-center gap-1.5 text-xs text-slate-500">
                        <!-- Status Filter Dropdown -->
                        <select class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 py-1 px-2 text-xs text-slate-800 dark:text-slate-200 focus:outline-none"
                                @bind="selectedAttendanceFilter">
                            <option value="">All Attendance Statuses</option>
                            <option value="Present">Present</option>
                            <option value="Late">Late</option>
                            <option value="Absent">Absent</option>
                            <option value="Leave">On Leave</option>
                            <option value="MissingCheckout">Missing Checkout</option>
                        </select>

                        <button type="button"
                                class="p-1 rounded-md border border-slate-200 dark:border-slate-700 @(isRosterGridView ? "bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400")"
                                title="Grid View"
                                @onclick="() => isRosterGridView = true">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                            </svg>
                        </button>
                        <button type="button"
                                class="p-1 rounded-md border border-slate-200 dark:border-slate-700 @(!isRosterGridView ? "bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400")"
                                title="List View"
                                @onclick="() => isRosterGridView = false">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                    </div>
                }
            </div>

            <!-- Tab Content 1: Team Staff Roster -->
            @if (activeMainTab == "roster")
            {
                @if (loading)
                {
                    <div class="flex items-center justify-center py-12">
                        <div class="text-center">
                            <div class="w-8 h-8 border-3 border-blue-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
                            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Loading team members…</p>
                        </div>
                    </div>
                }
                else if (FilteredStaffList.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/50 p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                        <p class="text-base mb-1">🔍</p>
                        <p class="font-medium text-slate-700 dark:text-slate-300">No staff members match the selected criteria.</p>
                        <p class="mt-1 text-slate-400">Try adjusting your search query, team filter, or attendance status.</p>
                    </div>
                }
                else if (isRosterGridView)
                {
                    <!-- Grid View of Staff Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        @foreach (var staff in FilteredStaffList)
                        {
                            var att = GetTodayAttendance(staff.StaffId);
                            <div @key="staff.StaffId"
                                 class="group relative rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800/70 p-3 shadow-xs hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition-all flex flex-col justify-between gap-2.5">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-center gap-2.5">
                                        <!-- Avatar with status ring -->
                                        <div class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-bold text-xs @GetAvatarColor(staff.StaffId)">
                                            @GetInitials(staff.FullName)
                                            <span class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-white dark:border-slate-800 @GetStatusDot(att?.Status)"></span>
                                        </div>
                                        <div class="min-w-0">
                                            <h4 class="truncate text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                                @staff.FullName
                                            </h4>
                                            <p class="truncate text-[11px] text-slate-500 dark:text-slate-400">
                                                ID: @staff.StaffId · @staff.TeamName
                                            </p>
                                        </div>
                                    </div>
                                    @if (staff.IsSuperVisor)
                                    {
                                        <span class="rounded bg-indigo-50 dark:bg-indigo-950/60 px-1.5 py-0.5 text-[10px] font-semibold text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/40 shrink-0">
                                            Supervisor
                                        </span>
                                    }
                                </div>

                                <!-- Today Attendance Snippet -->
                                <div class="rounded-lg bg-slate-50 dark:bg-slate-800/90 p-2 text-[11px] flex items-center justify-between border border-slate-100 dark:border-slate-700/60">
