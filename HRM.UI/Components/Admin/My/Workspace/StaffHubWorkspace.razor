                                        }

                                        <div class="rounded-xl border border-teal-200 dark:border-teal-800/60 bg-teal-50/40 dark:bg-teal-950/20 p-3 flex flex-col gap-2">
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-800 dark:text-teal-300">Verified Employment Record</span>
                                            <div class="text-xs text-slate-700 dark:text-slate-300 space-y-1">
                                                <div><strong>Service Duration:</strong> @selectedCertificateDetail.EmploymentHistory.FormattedServiceDuration</div>
                                                <div><strong>Positions Found:</strong> @selectedCertificateDetail.EmploymentHistory.Positions.Count · <strong>Projects:</strong> @selectedCertificateDetail.EmploymentHistory.Projects.Count</div>
                                            </div>
                                        </div>

                                        @if (selectedCertificateRequest.Status is "Submitted" or "UnderReview")
                                        {
                                            <div class="flex flex-col gap-2 pt-1">
                                                <div>
                                                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">Addressed To</label>
                                                    <input type="text" @bind="certAddressedTo"
                                                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100" />
                                                </div>
                                                <div class="grid grid-cols-2 gap-2">
                                                    <div>
                                                        <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">Signatory Name</label>
                                                        <input type="text" @bind="certSignatoryName"
                                                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">Signatory Title</label>
                                                        <input type="text" @bind="certSignatoryTitle"
                                                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100" />
                                                    </div>
                                                </div>
                                                <div class="flex flex-wrap gap-2 text-xs pt-1">
                                                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                                        <input type="checkbox" @bind="certIncludeResp" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                                        <span>Include Responsibilities</span>
                                                    </label>
                                                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                                        <input type="checkbox" @bind="certIncludeProj" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                                        <span>Include Projects</span>
                                                    </label>
                                                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                                        <input type="checkbox" @bind="certIncludeSalary" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                                        <span>Include Salary</span>
                                                    </label>
                                                </div>
                                                <div>
                                                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">HR Remarks / Decision Note</label>
                                                    <textarea @bind="certActionComment" rows="2" placeholder="Optional remarks or clarification reason..."
                                                              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none"></textarea>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (!string.IsNullOrWhiteSpace(certActionError))
                                    {
                                        <div class="rounded-lg bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 p-2 text-xs text-rose-700 dark:text-rose-300">
                                            @certActionError
                                        </div>
                                    }

                                    <div class="flex flex-wrap items-center gap-2 pt-1">
                                        @if (selectedCertificateRequest.Status is "Submitted" or "UnderReview")
                                        {
                                            <button type="button" disabled="@certActing"
                                                    @onclick='() => ActCertificateRequestAsync("Issue")'
                                                    class="flex-1 rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs py-2 px-3 shadow-xs transition cursor-pointer disabled:opacity-50">
                                                ✓ Approve &amp; Issue Certificate
                                            </button>
                                            <button type="button" disabled="@certActing"
                                                    @onclick='() => ActCertificateRequestAsync("Return")'
                                                    class="rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800 font-bold text-xs py-2 px-3 transition cursor-pointer disabled:opacity-50">
                                                ↩ Return
                                            </button>
                                            <button type="button" disabled="@certActing"
                                                    @onclick='() => ActCertificateRequestAsync("Reject")'
                                                    class="rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800 font-bold text-xs py-2 px-3 transition cursor-pointer disabled:opacity-50">
                                                ✕ Reject
                                            </button>
                                        }
                                        else if (selectedCertificateDetail?.IssuedCertificate != null)
                                        {
                                            <button type="button"
                                                    @onclick="() => DownloadIssuedCertPdfAsync(selectedCertificateDetail.IssuedCertificate.IssuedCertificateId, selectedCertificateDetail.IssuedCertificate.CertificateNumber)"
                                                    class="flex-1 text-center rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs py-2 px-3 shadow-xs transition cursor-pointer">
                                                📄 Download Issued Certificate (@selectedCertificateDetail.IssuedCertificate.CertificateNumber)
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center shadow-xs">
                                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 mb-3 border border-teal-200 dark:border-teal-800/40">
                                        <AppIcon Name="description" Class="h-6 w-6 text-2xl" />
                                    </div>
                                    <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">No Certificate Request Selected</h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs mx-auto">
                                        Select a certificate request from the queue on the right to verify employment records, customize signatory details, and issue the official PDF certificate.
                                    </p>
                                </div>
                            }
                        }
                    </aside>

                    <!-- ======================================================== -->
                    <!-- RIGHT PANEL (7 cols): ALL THE REQUESTS                   -->
                    <!-- ======================================================== -->
                    <main class="col-span-12 xl:col-span-7 flex flex-col gap-2 min-w-0">
                        @if (activeReqSubTab == "leave")
                        {
                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 shadow-xs flex flex-col gap-2">
                                <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Pending Leave Requests</h3>
                                        <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-xs font-bold">
                                            @pendingLeaves.Count
                                        </span>
                                    </div>
                                    <button type="button" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline cursor-pointer" @onclick="RefreshRequestsAsync">
                                        ↻ Refresh
                                    </button>
                                </div>

                                @if (loading)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 animate-pulse">Loading leave requests...</div>
                                }
                                else if (pendingLeaves.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                        All caught up! No pending leave requests awaiting approval.
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var item in pendingLeaves)
                                        {
                                            var isSelected = selectedLeave?.RequestId == item.RequestId;
                                            <button type="button"
                                                    class="w-full text-left rounded-xl p-3 border transition-all cursor-pointer @(isSelected ? "bg-teal-50/80 dark:bg-teal-950/40 border-teal-500 ring-1 ring-teal-500 shadow-xs" : "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50/50")"
                                                    @onclick="() => selectedLeave = item">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-xs shrink-0">
                                                            @GetInitials(item.Applicant)
                                                        </div>
                                                        <div>
                                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">@item.Applicant</h4>
                                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5 flex-wrap">
                                                                <span class="font-medium text-teal-700 dark:text-teal-400">@item.LeaveType</span>
                                                                <span>•</span>
                                                                <span>@item.FromDate.ToString("dd MMM yyyy") – @item.ToDate.ToString("dd MMM yyyy")</span>
                                                                <span>(@item.Duration @(item.Duration == 1 ? "day" : "days"))</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold @(item.IsProcessing ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                                                            @item.Status
                                                        </span>
                                                        <span class="text-[10px] text-slate-400 font-mono">@item.Reference</span>
                                                    </div>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (activeReqSubTab is "attendance" or "uneven-log")
                        {
                            var reqs = attendanceRequestsList.Where(r => activeReqSubTab == "uneven-log" ? r.Kind == "Uneven-log correction" : r.Kind == "Attendance").ToList();
                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 shadow-xs flex flex-col gap-2">
                                <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">
                                            @(activeReqSubTab == "uneven-log" ? "Uneven Log Correction Requests" : "Attendance Requests")
                                        </h3>
                                        <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-xs font-bold">
                                            @reqs.Count
                                        </span>
                                    </div>
                                    <button type="button" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline cursor-pointer" @onclick="RefreshRequestsAsync">
                                        ↻ Refresh
                                    </button>
                                </div>

                                @if (attendanceLoading)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 animate-pulse">Loading requests...</div>
                                }
                                else if (reqs.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                        No @(activeReqSubTab == "uneven-log" ? "uneven log correction" : "attendance") requests found.
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var row in reqs)
                                        {
                                            var isSelected = selectedAttendanceRequest?.RequestId == row.RequestId;
                                            <button type="button"
                                                    class="w-full text-left rounded-xl p-3 border transition-all cursor-pointer @(isSelected ? "bg-teal-50/80 dark:bg-teal-950/40 border-teal-500 ring-1 ring-teal-500 shadow-xs" : "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50/50")"
                                                    @onclick="() => SelectAttendanceRequest(row)">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-xs shrink-0">
                                                            @GetInitials(row.StaffName)
                                                        </div>
                                                        <div>
                                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">@row.StaffName</h4>
                                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5 flex-wrap">
                                                                <span class="font-bold text-slate-700 dark:text-slate-300">@row.ClockTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                                <span>•</span>
                                                                <span class="inline-block bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 px-1.5 py-0.2 rounded font-semibold text-[10px]">@row.Mode</span>
                                                                @if (!string.IsNullOrWhiteSpace(row.Comments))
                                                                {
                                                                    <span>•</span>
                                                                    <span class="italic truncate max-w-xs text-slate-400">@row.Comments</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold @(row.Status.Contains("Approve", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : row.Status.Contains("Reject", StringComparison.OrdinalIgnoreCase) ? "bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300" : "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300")">
                                                            @row.Status
                                                        </span>
                                                        <span class="text-[10px] text-slate-400 font-mono">@row.Reference</span>
                                                    </div>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (activeReqSubTab == "duty")
                        {
                            <PendingDutyRequestsCard />
                        }
                        else if (activeReqSubTab is "job-items" or "personal-items")
                        {
                            var isJob = activeReqSubTab == "job-items";
                            var filtered = itemRequestsList.Where(r => isJob ? r.Purpose == "Job related" : r.Purpose != "Job related").ToList();
                            if (!showAllItemHistory)
                            {
                                filtered = filtered.Where(r => r.Status is "Submitted" or "ReturnRequested").ToList();
                            }

                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 shadow-xs flex flex-col gap-2">
                                <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">
                                            @(isJob ? "Job-Related Equipment Queue" : "Personal Consumables Queue")
                                        </h3>
                                        <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-xs font-bold">
                                            @(isJob ? JobItemsPendingCount : PersonalItemsPendingCount) Pending
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <label class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400 cursor-pointer select-none">
                                            <input type="checkbox" @bind="showAllItemHistory" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                            <span>Show All / History</span>
                                        </label>
                                        <button type="button" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline cursor-pointer" @onclick="RefreshRequestsAsync">
                                            ↻ Refresh
                                        </button>
                                    </div>
                                </div>

                                @if (itemLoading)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 animate-pulse">Loading item requests...</div>
                                }
                                else if (filtered.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                        All caught up! No requests found in this queue.
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var row in filtered)
                                        {
                                            var isSelected = selectedItemRequest?.RequestId == row.RequestId;
                                            <button type="button"
                                                    class="w-full text-left rounded-xl p-3 border transition flex flex-col gap-2 cursor-pointer @(isSelected ? "border-teal-500 dark:border-teal-400 bg-teal-50/50 dark:bg-teal-950/30 shadow-xs" : "border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white dark:bg-slate-900")"
                                                    @onclick="() => selectedItemRequest = row">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-950 text-teal-700 dark:text-teal-300 font-bold text-xs flex items-center justify-center shrink-0">
                                                            @(string.IsNullOrWhiteSpace(row.StaffName) ? "S" : row.StaffName.Substring(0, 1).ToUpperInvariant())
                                                        </div>
                                                        <div class="min-w-0">
                                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">@row.StaffName</h4>
                                                            <span class="text-[10px] text-slate-400">Submitted @row.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold @(row.Status is "Submitted" or "ReturnRequested" ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : row.Status is "InUse" or "Received" or "Approved" ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">
                                                            @row.Status
                                                        </span>
                                                        <span class="text-[10px] text-slate-400 font-mono">@row.Reference</span>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-2 flex-wrap text-xs">
                                                    <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-bold bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
                                                        @row.Kind
                                                    </span>
                                                    <span class="text-slate-700 dark:text-slate-300 font-medium">
                                                        @string.Join(", ", row.Lines.Select(l => $"{l.Quantity}x {l.ItemName}"))
                                                    </span>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(row.Reason))
                                                {
                                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 italic">
                                                        “@row.Reason”
                                                    </p>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (activeReqSubTab == "certificates")
                        {
                            var filteredCerts = showAllCertHistory
                                ? certificateRequestsList
                                : certificateRequestsList.Where(r => r.Status is "Submitted" or "UnderReview").ToList();

                            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 shadow-xs flex flex-col gap-2">
                                <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">
                                            Employment &amp; Work Experience Certificate Requests
                                        </h3>
                                        <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-xs font-bold">
                                            @CertificatesPendingCount Pending
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <label class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400 cursor-pointer select-none">
                                            <input type="checkbox" @bind="showAllCertHistory" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                            <span>Show All / History</span>
                                        </label>
                                        <button type="button" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline cursor-pointer" @onclick="RefreshRequestsAsync">
                                            ↻ Refresh
                                        </button>
                                    </div>
                                </div>

                                @if (certLoading)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 animate-pulse">Loading certificate requests...</div>
                                }
                                else if (filteredCerts.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-500 dark:text-slate-400">
                                        All caught up! No pending certificate requests found.
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var cert in filteredCerts)
                                        {
                                            var isSelected = selectedCertificateRequest?.CertificateRequestId == cert.CertificateRequestId;
                                            <button type="button"
                                                    class="w-full text-left rounded-xl p-3 border transition flex flex-col gap-2 cursor-pointer @(isSelected ? "border-teal-500 dark:border-teal-400 bg-teal-50/50 dark:bg-teal-950/30 shadow-xs" : "border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white dark:bg-slate-900")"
                                                    @onclick="() => SelectCertificateRequestAsync(cert)">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                        <div class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-950 text-teal-700 dark:text-teal-300 font-bold text-xs flex items-center justify-center shrink-0">
                                                            @GetInitials(cert.EmployeeName)
                                                        </div>
                                                        <div class="min-w-0">
                                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">@cert.EmployeeName</h4>
                                                            <span class="text-[10px] text-slate-400">
                                                                @(string.IsNullOrWhiteSpace(cert.CurrentDesignation) ? "Staff" : cert.CurrentDesignation)
                                                                @(string.IsNullOrWhiteSpace(cert.DepartmentName) ? "" : $" · {cert.DepartmentName}")
                                                                · Submitted @cert.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold @(cert.Status is "Submitted" or "UnderReview" ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : cert.Status is "Issued" or "Approved" ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">
