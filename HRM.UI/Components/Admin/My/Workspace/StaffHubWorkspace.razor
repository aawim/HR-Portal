    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUserContext = await UserAccess.GetContextAsync();
        }
        catch { }
        SyncTabsFromRouteAndQuery();
        await LoadAllDataAsync();
        if (inspectedStaffId.HasValue)
        {
            var match = allTeamStaff.FirstOrDefault(s => s.StaffId == inspectedStaffId.Value);
            if (match != null && !string.IsNullOrWhiteSpace(match.FullName))
            {
                inspectedStaffName = match.FullName;
            }
            else if (string.IsNullOrWhiteSpace(inspectedStaffName) || inspectedStaffName.StartsWith("Staff #"))
            {
                try
                {
                    var identity = await Directory.GetStaffIdentityAsync(inspectedStaffId.Value);
                    if (identity != null && !string.IsNullOrWhiteSpace(identity.Name))
                    {
                        inspectedStaffName = identity.Name;
                    }
                }
                catch { }
            }
            await EnsureInspectedStaffProfileLoadedAsync();
        }
        if (NotificationRequestId.HasValue && selectedLeave == null && selectedItemRequest == null && selectedCertificateRequest == null)
        {
            var certReq = certificateRequestsList.FirstOrDefault(r => r.RequestId == NotificationRequestId.Value || r.CertificateRequestId == NotificationRequestId.Value);
            if (certReq != null)
            {
                activeReqSubTab = "certificates";
                await SelectCertificateRequestAsync(certReq);
            }
            else
            {
                var itemReq = itemRequestsList.FirstOrDefault(r => r.RequestId == NotificationRequestId.Value);
                if (itemReq != null)
                {
                    activeReqSubTab = itemReq.Purpose == "Job related" ? "job-items" : "personal-items";
                    selectedItemRequest = itemReq;
                }
                else
                {
                    selectedLeave = pendingLeaves.FirstOrDefault(l => l.RequestId == NotificationRequestId.Value);
                }
            }
        }
        if (selectedEntityItem != null && (selectedEntityItem.Name?.StartsWith(selectedEntityItem.EntityType.ToString()) ?? true))
        {
            try
            {
                var resolved = await RecentSearches.ResolveAsync(selectedEntityItem.EntityType, selectedEntityItem.Id);
                if (resolved != null) selectedEntityItem = resolved;
            }
            catch { }
        }
        if (inspectedOrgId.HasValue && (string.IsNullOrWhiteSpace(inspectedOrgName) || inspectedOrgName.StartsWith("Organisation #")))
        {
            try
            {
                var resolved = await RecentSearches.ResolveAsync(WorkspaceEntityType.Organisation, inspectedOrgId.Value);
                if (resolved != null && !string.IsNullOrWhiteSpace(resolved.Name))
                {
                    inspectedOrgName = resolved.Name;
                }
            }
            catch { }
        }
    }

