                                        <span>👤 360° View</span>
                                    </button>
                                    <div class="flex items-center gap-1">
                                        <a href="@($"/admin/my/workspace/staff/{staff.StaffId}/staff-transfer")"
                                           class="rounded px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 text-[10px] font-medium transition"
                                           title="Manage Transfer">
                                            Transfer
                                        </a>
                                        <a href="@($"/admin/my/workspace/staff/{staff.StaffId}/leave")"
                                           class="rounded px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 text-[10px] font-medium transition"
                                           title="Leave History">
                                            Leave
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Table View of Staff -->
                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                <tr>
                                    <th class="p-2.5">Staff Member</th>
                                    <th class="p-2.5">Team &amp; Role</th>
                                    <th class="p-2.5">Today Status</th>
                                    <th class="p-2.5">Punch Timeline</th>
                                    <th class="p-2.5 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @foreach (var staff in FilteredStaffList)
                                {
                                    var att = GetTodayAttendance(staff.StaffId);
                                    <tr @key="staff.StaffId" class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                                        <td class="p-2.5">
                                            <div class="flex items-center gap-2">
                                                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[11px] font-bold @GetAvatarColor(staff.StaffId)">
                                                    @GetInitials(staff.FullName)
                                                </div>
                                                <div>
                                                    <span class="font-bold text-slate-900 dark:text-slate-100 block">@staff.FullName</span>
                                                    <span class="text-[10px] text-slate-500 dark:text-slate-400">ID: #@staff.StaffId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-2.5">
                                            <span class="block text-slate-800 dark:text-slate-200 font-medium">@staff.TeamName</span>
                                            <span class="text-[11px] text-slate-500 dark:text-slate-400">
                                                @(staff.IsSuperVisor ? "Supervisor" : "Member")
                                            </span>
                                        </td>
                                        <td class="p-2.5">
                                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @GetAttendanceBadgeClass(att?.Status)">
                                                @(att?.Status != null ? att.Status.ToString() : "Not Punched")
                                            </span>
                                        </td>
                                        <td class="p-2.5 text-[11px] text-slate-600 dark:text-slate-300">
                                            @if (att?.CheckIn != null)
                                            {
                                                <span>In: @att.CheckIn.Value.ToString("HH:mm")</span>
                                                @if (att?.CheckOut != null)
                                                {
                                                    <span> · Out: @att.CheckOut.Value.ToString("HH:mm")</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-slate-400 dark:text-slate-500">—</span>
                                            }
                                        </td>
                                        <td class="p-2.5 text-right">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button"
                                                        class="rounded px-2 py-1 bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 hover:bg-blue-100 text-[11px] font-semibold transition"
                                                        @onclick="() => InspectStaff(staff.StaffId)">
                                                    360° Profile
                                                </button>
                                                <a href="@($"/admin/my/workspace/staff/{staff.StaffId}/staff-transfer")"
                                                   class="rounded px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 text-[11px] font-medium transition">
                                                    Transfer
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <!-- Tab Content 2: Today's Team Attendance Timeline & Metrics -->
            @if (activeMainTab == "attendance")
            {
                <div class="space-y-4">
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 text-xs flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-slate-800 dark:text-slate-200">Daily Attendance Roll:</span>
                            <span class="text-slate-500 dark:text-slate-400">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="rounded-full bg-emerald-100 text-emerald-800 px-2 py-0.5 font-semibold text-[11px]">@PresentCount Present</span>
                            <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 font-semibold text-[11px]">@LateCount Late</span>
                            <span class="rounded-full bg-rose-100 text-rose-800 px-2 py-0.5 font-semibold text-[11px]">@AbsentCount Absent</span>
                        </div>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                                <tr>
                                    <th class="p-2.5">Staff Name</th>
                                    <th class="p-2.5">Team</th>
                                    <th class="p-2.5">First Check-In</th>
                                    <th class="p-2.5">Latest Check-Out</th>
                                    <th class="p-2.5">Status</th>
                                    <th class="p-2.5">Note</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @if (todayAttendance.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="p-6 text-center text-slate-500 dark:text-slate-400">
                                            No attendance records recorded for today yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var record in todayAttendance.Where(a => selectedTeamId == null || a.TeamID == selectedTeamId))
                                    {
                                        <tr @key="record.StaffID" class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                            <td class="p-2.5 font-semibold text-slate-900 dark:text-slate-100">
                                                @record.Name
                                            </td>
                                            <td class="p-2.5 text-slate-600 dark:text-slate-400">
                                                @record.TeamName
                                            </td>
                                            <td class="p-2.5 text-slate-700 dark:text-slate-300">
                                                @(record.CheckIn?.ToString("HH:mm:ss") ?? "—")
                                            </td>
                                            <td class="p-2.5 text-slate-700 dark:text-slate-300">
                                                @(record.CheckOut?.ToString("HH:mm:ss") ?? "—")
                                            </td>
                                            <td class="p-2.5">
                                                <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold @GetAttendanceBadgeClass(record.Status)">
                                                    @record.Status
                                                </span>
                                            </td>
                                            <td class="p-2.5 text-[11px] text-slate-500 dark:text-slate-400">
                                                @(record.StatusMessage ?? "—")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Tab Content 3: Staff 360° Embedded Management Detail -->
            @if (activeMainTab == "staff-360" && inspectedStaffId.HasValue)
            {
                <div class="rounded-xl border border-blue-200 dark:border-blue-900/50 bg-blue-50/20 dark:bg-blue-950/20 p-4 space-y-4">
                    <div class="flex items-center justify-between border-b border-blue-100 dark:border-blue-900/40 pb-3 flex-wrap gap-2">
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50"
                                    @onclick='() => SwitchMainTab("roster")'>
                                ← Back to Roster
                            </button>
                            <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">Staff Management 360°</span>
                            <span class="rounded-md bg-blue-100 dark:bg-blue-900/60 px-2 py-0.5 font-mono text-xs font-bold text-blue-800 dark:text-blue-200">
                                ID: #@inspectedStaffId
                            </span>
                        </div>

                        <!-- Embedded Staff Tab Bar -->
                        <div class="flex items-center gap-1 flex-wrap text-xs">
                            <button type="button"
                                    class="rounded-md px-2.5 py-1 font-semibold transition @(inspectedStaffTab == WorkspaceTab.Overview ? "bg-blue-600 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")"
                                    @onclick="() => inspectedStaffTab = WorkspaceTab.Overview">
                                Overview
                            </button>
                            <button type="button"
                                    class="rounded-md px-2.5 py-1 font-semibold transition @(inspectedStaffTab == WorkspaceTab.Leave ? "bg-blue-600 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")"
                                    @onclick="() => inspectedStaffTab = WorkspaceTab.Leave">
                                Leave Balances
                            </button>
                            <button type="button"
                                    class="rounded-md px-2.5 py-1 font-semibold transition @(inspectedStaffTab == WorkspaceTab.Attendance ? "bg-blue-600 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")"
                                    @onclick="() => inspectedStaffTab = WorkspaceTab.Attendance">
                                Attendance Log
                            </button>
                            <button type="button"
                                    class="rounded-md px-2.5 py-1 font-semibold transition @(inspectedStaffTab == WorkspaceTab.Position ? "bg-blue-600 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")"
                                    @onclick="() => inspectedStaffTab = WorkspaceTab.Position">
                                Positions &amp; Job
                            </button>
                            <button type="button"
                                    class="rounded-md px-2.5 py-1 font-semibold transition @(inspectedStaffTab == WorkspaceTab.StaffTransfer ? "bg-blue-600 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")"
                                    @onclick="() => inspectedStaffTab = WorkspaceTab.StaffTransfer">
                                Transfer
                            </button>
                            <button type="button"
                                    class="rounded-md px-2.5 py-1 font-semibold transition @(inspectedStaffTab == WorkspaceTab.Finance ? "bg-blue-600 text-white shadow-xs" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")"
                                    @onclick="() => inspectedStaffTab = WorkspaceTab.Finance">
                                Finance
                            </button>
                        </div>
                    </div>

                    <!-- Host the actual Staff Workspace components cleanly -->
                    <div class="bg-white dark:bg-slate-900 rounded-xl p-3 border border-slate-200 dark:border-slate-800 shadow-xs">
                        <StaffWorkspace StaffId="inspectedStaffId.Value" ActiveTab="inspectedStaffTab" />
                    </div>
                </div>
            }

        </div>

        <!-- ========================================== -->
        <!-- RIGHT PANEL: Team Requests & Inbox (5fr)   -->
        <!-- ========================================== -->
        <aside class="page-panel-right min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-4">
            
            <!-- Right Panel Header -->
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3 flex-wrap gap-2">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Team Requests &amp; Approvals</h3>
                        <span class="rounded-full bg-amber-100 dark:bg-amber-950/60 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:text-amber-300">
                            @TotalPendingRequestsCount Action Needed
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Supervisor review queue for leave, roster duties, overtime, and transfers.</p>
                </div>
                <button type="button"
                        class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
                        @onclick="RefreshRequestsAsync">
                    Refresh Queue
                </button>
            </div>

            <!-- Request Categories Sub-Navigation -->
            <div class="flex flex-wrap gap-1 border-b border-slate-100 dark:border-slate-800 pb-2 text-xs">
                <button type="button"
                        class="rounded-lg px-2.5 py-1 font-semibold transition @(activeRequestTab == "leave" ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                        @onclick='() => activeRequestTab = "leave"'>
                    Leave (@pendingLeaves.Count)
                </button>
                <button type="button"
                        class="rounded-lg px-2.5 py-1 font-semibold transition @(activeRequestTab == "duty" ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                        @onclick='() => activeRequestTab = "duty"'>
                    Duty &amp; Roster (@pendingDutyRequests.Count)
                </button>
                <button type="button"
                        class="rounded-lg px-2.5 py-1 font-semibold transition @(activeRequestTab == "overtime" ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                        @onclick='() => activeRequestTab = "overtime"'>
                    Overtime
                </button>
                <button type="button"
                        class="rounded-lg px-2.5 py-1 font-semibold transition @(activeRequestTab == "late" ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                        @onclick='() => activeRequestTab = "late"'>
                    Late Check-In
                </button>
                <button type="button"
                        class="rounded-lg px-2.5 py-1 font-semibold transition @(activeRequestTab == "position" ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                        @onclick='() => activeRequestTab = "position"'>
                    Positions
                </button>
                <button type="button"
                        class="rounded-lg px-2.5 py-1 font-semibold transition @(activeRequestTab == "onboarding" ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200")"
                        @onclick='() => activeRequestTab = "onboarding"'>
                    Onboarding
                </button>
            </div>

            <!-- Queue View: Leave Requests -->
            @if (activeRequestTab == "leave")
            {
                @if (selectedLeave != null)
                {
                    <div class="rounded-xl border border-blue-200 dark:border-blue-800 bg-blue-50/30 dark:bg-slate-800 p-3 space-y-3">
                        <div class="flex items-center justify-between border-b border-blue-100 dark:border-slate-700 pb-2">
                            <span class="text-xs font-bold text-slate-900 dark:text-slate-100">Reviewing Request #@selectedLeave.RequestId</span>
                            <button type="button"
                                    class="text-xs font-semibold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200"
                                    @onclick="() => selectedLeave = null">
                                ✕ Close
                            </button>
                        </div>
                        <LeaveRequestDetails @key="selectedLeave.RequestId"
                                             Item="selectedLeave"
                                             Busy="@(loading || executingAction)"
                                             Message="@leaveActionMessage"
                                             OnClose="() => selectedLeave = null"
                                             OnExecute="ExecuteLeaveActionAsync"
                                             OnChanged="RefreshRequestsAsync" />
                    </div>
                }
                else if (pendingLeaves.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/40 p-6 text-center text-xs text-slate-500 dark:text-slate-400">
                        <p class="text-lg mb-1">🎉</p>
                        <p class="font-medium text-slate-700 dark:text-slate-300">All caught up!</p>
                        <p class="mt-0.5">No pending leave requests from your team members.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2 max-h-[38rem] overflow-y-auto pr-1">
                        @foreach (var req in pendingLeaves)
                        {
                            <div @key="req.RequestId"
                                 class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/80 p-3 text-xs shadow-xs hover:border-blue-400 dark:hover:border-blue-500 transition cursor-pointer flex flex-col gap-1.5"
                                 @onclick="() => selectedLeave = req">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="font-bold text-slate-900 dark:text-slate-100">@req.Applicant</span>
                                    <span class="rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 px-2 py-0.5 text-[10px] font-semibold">
                                        @(req.IsProcessing ? "Processing" : req.Status)
                                    </span>
                                </div>
                                <div class="text-[11px] text-slate-600 dark:text-slate-300">
                                    <span class="font-semibold text-blue-600 dark:text-blue-400">@req.LeaveType</span> · @req.Duration days
                                </div>
                                <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                    @req.FromDate.ToString("dd MMM yyyy") – @req.ToDate.ToString("dd MMM yyyy")
                                </div>
                                <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-700/60 text-[10px] text-slate-400">
                                    <span class="font-mono">@req.Reference</span>
                                    <span class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Review &amp; Decide →</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            <!-- Queue View: Duty & Roster Requests -->
            @if (activeRequestTab == "duty")
            {
                @if (pendingDutyRequests.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/40 p-6 text-center text-xs text-slate-500 dark:text-slate-400">
                        <p class="text-lg mb-1">📅</p>
                        <p class="font-medium text-slate-700 dark:text-slate-300">No duty swaps or coverage requests pending.</p>
                        <a href="/online/duty-roster" class="mt-2 inline-block text-blue-600 dark:text-blue-400 font-semibold hover:underline">
                            Open Duty Roster Schedule →
                        </a>
                    </div>
                }
                else
                {
                    <div class="space-y-2 max-h-[38rem] overflow-y-auto pr-1">
                        @foreach (var row in pendingDutyRequests)
                        {
                            <div @key="row.Reference"
                                 class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/80 p-3 text-xs shadow-xs flex flex-col gap-1.5">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="font-bold text-slate-900 dark:text-slate-100">@row.Kind</span>
                                    <span class="rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300 px-2 py-0.5 text-[10px] font-semibold">
                                        @row.Status
                                    </span>
                                </div>
                                <div class="text-[11px] text-slate-600 dark:text-slate-300">
                                    @row.Source → @row.Target
                                </div>
                                <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-700/60 text-[10px]">
                                    <span class="font-mono text-slate-400">@row.Reference</span>
                                    <a href="/online/duty-roster#requests" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
                                        Action in Roster →
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            <!-- Queue View: Overtime Requests -->
            @if (activeRequestTab == "overtime")
            {
                <div class="text-xs">
                    <HRM.Components.Shared.OvertimeRequests PendingOnly="true" />
                </div>
            }

            <!-- Queue View: Late Check-In Requests -->
            @if (activeRequestTab == "late")
            {
                <div class="text-xs">
                    <HRM.Components.Shared.LateCheckInRequests PendingOnly="true" />
                </div>
            }

            <!-- Queue View: Staff Position Requests -->
            @if (activeRequestTab == "position")
            {
                <div class="text-xs">
                    <HRM.Components.Shared.StaffPositionRequests PendingOnly="true" />
                </div>
            }

            <!-- Queue View: Staff Onboarding Queue -->
            @if (activeRequestTab == "onboarding")
            {
                <div class="text-xs">
                    <PendingOnboardingCard />
                </div>
            }

        </aside>

    </div>
</section>

@code {
    [Parameter] public string? ActiveSection { get; set; }

    // Teams & Members
    private List<TeamDto> myTeams = new();
    private int? selectedTeamId;
    private TeamDto? selectedTeam => myTeams.FirstOrDefault(t => t.TeamId == selectedTeamId);

    // Attendance
    private List<TeamAttendanceDto> todayAttendance = new();
    private string selectedAttendanceFilter = "";

    // Requests
    private List<PendingLeaveRequestDto> pendingLeaves = new();
    private PendingLeaveRequestDto? selectedLeave;
    private List<DutyRequestRow> pendingDutyRequests = new();
    private string activeRequestTab = "leave";
    private string? leaveActionMessage;
    private bool executingAction;

    // View States
    private bool loading = true;
    private string? errorMessage;
    private string searchTerm = "";
    private string activeMainTab = "roster"; // roster, attendance, staff-360
    private bool isRosterGridView = true;
    private bool isFullWidth;
    private int? inspectedStaffId;
    private WorkspaceTab inspectedStaffTab = WorkspaceTab.Overview;

    // Flattened Staff representation for filtering
    public sealed record TeamStaffFlattened(int StaffId, string FullName, bool IsSuperVisor, int TeamId, string TeamName);

    private List<TeamStaffFlattened> allTeamStaff = new();

    private List<TeamStaffFlattened> FilteredStaffList
    {
        get
        {
            var query = allTeamStaff.AsEnumerable();

            if (selectedTeamId.HasValue)
            {
                query = query.Where(s => s.TeamId == selectedTeamId.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(s =>
                    s.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    s.StaffId.ToString().Contains(term));
            }

            if (!string.IsNullOrWhiteSpace(selectedAttendanceFilter))
            {
                query = query.Where(s =>
                {
                    var att = GetTodayAttendance(s.StaffId);
                    return att != null && att.Status.ToString().Equals(selectedAttendanceFilter, StringComparison.OrdinalIgnoreCase);
                });
            }

            return query.OrderBy(s => !s.IsSuperVisor).ThenBy(s => s.FullName).ToList();
        }
    }

    // Counts & KPIs
    private int TotalStaffCount => allTeamStaff.Select(s => s.StaffId).Distinct().Count();
    private int TotalSupervisorsCount => allTeamStaff.Where(s => s.IsSuperVisor).Select(s => s.StaffId).Distinct().Count();

    private int PresentCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Present);
    private int LateCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Late);
    private int AbsentCount => todayAttendance.Count(a => a.Status == AttendanceStatus.Absent);
    private int LeaveCount => todayAttendance.Count(a => a.Status is AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave);

    private int TotalPendingRequestsCount => pendingLeaves.Count + pendingDutyRequests.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.staff-hub.full-width");
                if (bool.TryParse(saved, out var val) && val != isFullWidth)
                {
                    isFullWidth = val;
                    StateHasChanged();
                }
            }
            catch
            {
                // Storage may be disabled or restricted in certain browsing contexts
            }
        }
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "hrm.staff-hub.full-width", isFullWidth.ToString().ToLowerInvariant());
        }
        catch { }
    }

    private async Task LoadAllDataAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            // 1. Load Teams
            myTeams = await TeamService.GetMyTeamsAsync() ?? new();

            // Flatten staff entries
            allTeamStaff = myTeams
                .SelectMany(t => t.Staffs.Select(s => new TeamStaffFlattened(s.StaffId, s.FullName, s.IsSuperVisor, t.TeamId, t.Name)))
                .GroupBy(s => s.StaffId)
                .Select(g => g.First())
                .ToList();

            // 2. Load Today's Attendance
            try
            {
                todayAttendance = await AttendanceLogService.GetMyTeamAttendanceTodayAsync() ?? new();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load team attendance for staff hub.");
            }

            // 3. Load Pending Leave Requests
            await RefreshRequestsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load staff hub workspace data.");
            errorMessage = "Failed to load complete workspace data. Please refresh.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        await LoadAllDataAsync();
        ToastService.Success("Workspace hub refreshed.");
    }

    private async Task RefreshRequestsAsync()
    {
        try
        {
            pendingLeaves = await Leaves.GetPendingLeaveRequestsAsync() ?? new();
            if (selectedLeave != null)
            {
                selectedLeave = pendingLeaves.FirstOrDefault(r => r.RequestId == selectedLeave.RequestId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load pending leaves for hub.");
        }

        try
        {
            var dutyRows = await Duties.GetRequestsAsync() ?? new();
            pendingDutyRequests = dutyRows.Where(r => r.CanAccept || r.CanApprove).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load duty requests for hub.");
        }
    }

    private async Task ExecuteLeaveActionAsync(RequestActionSubmissionDto action)
    {
        if (selectedLeave == null || executingAction) return;
        executingAction = true;
        leaveActionMessage = null;
        var reqId = selectedLeave.RequestId;
        try
        {
            var result = await Leaves.ExecuteLeaveActionAsync(reqId, action);
            leaveActionMessage = result.Message;
            if (result.Success)
            {
                ToastService.Success(result.Message);
                selectedLeave = null;
                await RefreshRequestsAsync();
            }
            else
            {
                ToastService.Error(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to execute action on leave request {RequestId}", reqId);
            leaveActionMessage = "Action execution failed. Check server logs.";
            ToastService.Error(leaveActionMessage);
        }
        finally
        {
            executingAction = false;
        }
    }

    private void FilterTeam(int? teamId)
    {
        selectedTeamId = teamId;
    }

    private void FilterAttendanceStatus(AttendanceStatus status)
    {
        selectedAttendanceFilter = status.ToString();
        activeMainTab = "roster";
    }

    private void SwitchMainTab(string tab)
    {
        activeMainTab = tab;
    }

    private void InspectStaff(int staffId)
    {
        inspectedStaffId = staffId;
        inspectedStaffTab = WorkspaceTab.Overview;
        activeMainTab = "staff-360";
    }

    private TeamAttendanceDto? GetTodayAttendance(int staffId)
    {
        return todayAttendance.FirstOrDefault(a => a.StaffID == staffId);
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "S";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetAvatarColor(int id)
    {
        var palettes = new[]
        {
            "bg-blue-100 text-blue-700 dark:bg-blue-900/60 dark:text-blue-300",
            "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/60 dark:text-emerald-300",
            "bg-purple-100 text-purple-700 dark:bg-purple-900/60 dark:text-purple-300",
            "bg-amber-100 text-amber-700 dark:bg-amber-900/60 dark:text-amber-300",
            "bg-rose-100 text-rose-700 dark:bg-rose-900/60 dark:text-rose-300",
            "bg-cyan-100 text-cyan-700 dark:bg-cyan-900/60 dark:text-cyan-300",
        };
        return palettes[Math.Abs(id) % palettes.Length];
    }

    private static string GetStatusDot(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "bg-emerald-500",
        AttendanceStatus.Late => "bg-amber-500",
        AttendanceStatus.Absent => "bg-rose-500",
        AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave => "bg-indigo-500",
        AttendanceStatus.MissingCheckout => "bg-sky-500",
        _ => "bg-slate-300 dark:bg-slate-600"
    };

    private static string GetStatusEmoji(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "🟢",
        AttendanceStatus.Late => "🟡",
        AttendanceStatus.Absent => "🔴",
        AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave => "🟣",
        AttendanceStatus.MissingCheckout => "🔵",
        _ => "⚪"
    };

    private static string GetAttendanceBadgeClass(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40",
        AttendanceStatus.Late => "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40",
        AttendanceStatus.Absent => "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800/40",
        AttendanceStatus.Leave or AttendanceStatus.SickLeave or AttendanceStatus.FamilyLeave => "bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40",
        AttendanceStatus.MissingCheckout => "bg-sky-100 text-sky-800 dark:bg-sky-950/60 dark:text-sky-300 border border-sky-200 dark:border-sky-800/40",
        _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
    };
}
