    private void SyncTabsFromRouteAndQuery()
    {
        if (string.Equals(QueryTab, "home", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(EntityRoute) && string.IsNullOrWhiteSpace(EntityTypeQuery))
        {
            activeWorkspaceTab = "Home";
            inspectedStaffId = null;
            inspectedOrgId = null;
            selectedEntityItem = null;
            return;
        }
        var entity = EntityRoute ?? EntityTypeQuery;
        var id = EntityId ?? EntityIdQuery;
        if (id.HasValue && id.Value > 0)
        {
            if (string.Equals(entity, "staff", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(entity, WorkspaceEntityType.Staff.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                inspectedStaffId = id.Value;
                inspectedStaffName = allTeamStaff.FirstOrDefault(s => s.StaffId == id.Value)?.FullName ?? $"Staff #{id.Value}";
                inspectedStaffTab = (ActiveSection?.ToLowerInvariant()) switch
                {
                    "leave" => WorkspaceTab.Leave,
                    "attendance" => WorkspaceTab.Attendance,
                    "position" => WorkspaceTab.Position,
                    "finance" or "allowances-deductions" or "allowance-deduction" or "allowance-deductions" or "allowances" or "deductions" => WorkspaceTab.Finance,
                    "performance" => WorkspaceTab.Performance,
                    "ot" or "overtime" => WorkspaceTab.OT,
                    "job-related" or "job-related-items" or "jobrelateditems" or "job-items" or "jobitems" or "jobitem" => WorkspaceTab.JobRelatedItems,
                    "personal-items" or "personalitems" or "personal-item" or "personal" => WorkspaceTab.PersonalItems,
                    "documents" => WorkspaceTab.Documents,
                    "leave-type" or "leavetype" => WorkspaceTab.LeaveType,
                    "schedule" => WorkspaceTab.Schedule,
                    "work-types" or "worktypes" => WorkspaceTab.WorkTypes,
                    "staff-transfer" or "stafftransfer" => WorkspaceTab.StaffTransfer,
                    "certificates" or "certificate" => WorkspaceTab.Certificates,
                    "goods-loans" or "goodsloans" or "goods-loan" or "loans" => WorkspaceTab.GoodsLoans,
                    "bank" or "bank-details" or "banking" => WorkspaceTab.Bank,
                    "emergency" or "emergency-contact" or "emergency-contacts" or "emergencycontact" => WorkspaceTab.EmergencyContact,
                    _ => WorkspaceTab.Overview
                };
                activeWorkspaceTab = "Staff";
                return;
            }
            else if (string.Equals(entity, "organisation", StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(entity, "organization", StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(entity, "org", StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(entity, WorkspaceEntityType.Organisation.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                inspectedOrgId = id.Value;
                if (string.IsNullOrWhiteSpace(inspectedOrgName) || inspectedOrgName.StartsWith("Organisation #"))
                {
                    inspectedOrgName = $"Organisation #{id.Value}";
                }
                inspectedOrgTab = (ActiveSection?.ToLowerInvariant()) switch
                {
                    "staff" => WorkspaceTab.Staff,
                    "teams" or "team" => WorkspaceTab.Teams,
                    "assigned-roles" or "assignedroles" or "roles" or "role" => WorkspaceTab.AssignedRoles,
                    "permissions" or "permission" => WorkspaceTab.Permissions,
                    "leave-type" or "leavetype" or "leave-types" or "leavetypes" => WorkspaceTab.LeaveType,
                    "documents" or "document" => WorkspaceTab.Documents,
                    _ => WorkspaceTab.Overview
                };
                activeWorkspaceTab = "Organisation";
                return;
            }
            else if (Enum.TryParse<WorkspaceEntityType>(entity, true, out var parsedType) && Enum.IsDefined(parsedType))
            {
                selectedEntityItem = new WorkspaceSearchResult
                {
                    Id = id.Value,
                    EntityType = parsedType,
                    Name = $"{parsedType} #{id.Value}"
                };
                activeWorkspaceTab = "Home";
            }
        }

        if (NotificationRequestId.HasValue && NotificationRequestId.Value > 0)
        {
            activeWorkspaceTab = "Request";
            var certReq = certificateRequestsList.FirstOrDefault(r => r.RequestId == NotificationRequestId.Value || r.CertificateRequestId == NotificationRequestId.Value);
            if (certReq != null)
            {
                activeReqSubTab = "certificates";
                selectedCertificateRequest = certReq;
            }
            else
            {
                var itemReq = itemRequestsList.FirstOrDefault(r => r.RequestId == NotificationRequestId.Value);
                if (itemReq != null)
                {
                    activeReqSubTab = itemReq.Purpose == "Job related" ? "job-items" : "personal-items";
                    selectedItemRequest = itemReq;
                }
                else
                {
                    activeReqSubTab = "leave";
                    selectedLeave = pendingLeaves.FirstOrDefault(l => l.RequestId == NotificationRequestId.Value);
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(ActiveSection) && ActiveSection.ToLowerInvariant() is "team" or "teams" or "my-teams" or "projects" or "project" or "tasks" or "task" or "calendar" or "calendars" or "request" or "requests" or "onboarding" or "leave" or "leave-log" or "attendance" or "time-change" or "shift" or "org-daily" or "daily")
        {
            activeWorkspaceTab = ActiveSection.ToLowerInvariant() switch
            {
                "team" or "teams" or "my-teams" => "MyTeam",
                "projects" or "project" or "tasks" or "task" => "MyTeam",
                "calendar" or "calendars" => "Calendar",
                "request" or "requests" => "Request",
                "onboarding" => "Onboarding",
                "leave" or "leave-log" => "LeaveLog",
                "attendance" => "Attendance",
                "time-change" or "shift" => "TimeChange",
                "org-daily" or "daily" => "OrgDaily",
                _ => "Home"
            };
            if (ActiveSection.ToLowerInvariant() is "projects" or "project" or "tasks" or "task")
            {
                teamCenterSubTab = "projects";
            }
        }
        else if (!string.IsNullOrWhiteSpace(QueryTab))
        {
            activeWorkspaceTab = QueryTab.ToLowerInvariant() switch
            {
                "my-teams" or "myteam" or "teams" or "team" => "MyTeam",
                "projects" or "project" or "tasks" or "task" => "MyTeam",
                "calendar" or "calendars" => "Calendar",
                "requests" or "request" => "Request",
                "onboarding" => "Onboarding",
                "leave-log" or "leave" => "LeaveLog",
                "attendance" => "Attendance",
                "time-change" or "timechange" or "shift" => "TimeChange",
                "org-daily" or "orgdaily" or "daily" => "OrgDaily",
                _ => "Home"
            };
            if (QueryTab.ToLowerInvariant() is "projects" or "project" or "tasks" or "task")
            {
                teamCenterSubTab = "projects";
            }
        }
        else if (!string.IsNullOrWhiteSpace(ActiveSection))
        {
            activeWorkspaceTab = ActiveSection.ToLowerInvariant() switch
            {
                "team" or "teams" or "my-teams" => "MyTeam",
                "projects" or "project" or "tasks" or "task" => "MyTeam",
                "calendar" or "calendars" => "Calendar",
                "request" or "requests" => "Request",
                "onboarding" => "Onboarding",
                "leave" or "leave-log" => "LeaveLog",
                "attendance" => "Attendance",
                "time-change" or "shift" => "TimeChange",
                "org-daily" or "daily" => "OrgDaily",
                _ => "Home"
            };
            if (ActiveSection.ToLowerInvariant() is "projects" or "project" or "tasks" or "task")
            {
                teamCenterSubTab = "projects";
            }
        }

        if (QueryTeamId.HasValue && QueryTeamId.Value > 0)
        {
            selectedTeamId = QueryTeamId.Value;
        }

        var requestedSubTab = (QueryTeamTab ?? QuerySubTab)?.ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(requestedSubTab))
        {
            teamCenterSubTab = requestedSubTab switch
            {
                "attendance" or "attendace" => "attendance",
                "request" or "requests" => "requests",
                "schedule" or "schedules" => "schedule",
                "leave" or "leaves" => "leaves",
                "project" or "projects" => "projects",
                "subteams" or "subteam" or "sub-teams" or "sub-team" => "subteams",
                _ => "members"
            };
        }

        if (QueryProjectId.HasValue && QueryProjectId.Value > 0)
        {
            selectedProjectId = QueryProjectId.Value;
            activeRightPanel = RightPanelType.ProjectDetails;
        }
    }

    private void UpdateUrl()
    {
        if (activeWorkspaceTab == "Staff" && inspectedStaffId.HasValue)
        {
            var sectionSlug = HRM.Helpers.SectionRoutes.Slug(inspectedStaffTab.ToString());
            var staffUri = $"/admin/my/workspace/staff/{inspectedStaffId.Value}/{sectionSlug}";
            NavigateIfChanged(staffUri);
            return;
        }

        if (activeWorkspaceTab == "Organisation" && inspectedOrgId.HasValue)
        {
            var sectionSlug = HRM.Helpers.SectionRoutes.Slug(inspectedOrgTab.ToString());
            var orgUri = $"/admin/my/workspace/organisation/{inspectedOrgId.Value}/{sectionSlug}";
            NavigateIfChanged(orgUri);
            return;
        }

        var tabKey = activeWorkspaceTab switch
        {
            "MyTeam" when teamCenterSubTab == "projects" => "projects",
            "MyTeam" => "my-teams",
            "Calendar" => "calendar",
            "Request" => "requests",
            "Onboarding" => "onboarding",
            "LeaveLog" => "leave-log",
            "Attendance" => "attendance",
            "TimeChange" => "time-change",
            "OrgDaily" => "org-daily",
            _ => "home"
        };

        var uri = activeWorkspaceTab == "Onboarding" ? "/admin/my/workspace/onboarding" : $"/admin/my/workspace?tab={tabKey}";
        if (activeWorkspaceTab == "MyTeam" && selectedTeamId.HasValue)
        {
            uri += $"&teamId={selectedTeamId.Value}";
            if (!string.IsNullOrWhiteSpace(teamCenterSubTab) && teamCenterSubTab != "members")
            {
                uri += $"&teamTab={teamCenterSubTab}";
            }
        }
        if (activeWorkspaceTab == "MyTeam" && selectedProjectId.HasValue && activeRightPanel == RightPanelType.ProjectDetails)
        {
            uri += $"&projectId={selectedProjectId.Value}";
        }
        if (activeWorkspaceTab == "Home")
        {
            if (false && inspectedStaffId.HasValue)
            {
                uri += $"&entityType=Staff&entityId={inspectedStaffId.Value}";
            }
            else if (selectedEntityItem != null)
            {
                uri += $"&entityType={selectedEntityItem.EntityType}&entityId={selectedEntityItem.Id}";
            }
        }

        NavigateIfChanged(uri);
    }

    private void NavigateIfChanged(string targetUri)
    {
        var currentRelative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var normCurrent = currentRelative.Split('#')[0];
        var normTarget = targetUri.Split('#')[0];
        if (!string.Equals(normCurrent, normTarget, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(targetUri, replace: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.workspace.full-width");
                if (bool.TryParse(saved, out var val) && val != isFullWidth)
                {
                    isFullWidth = val;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "hrm.workspace.full-width", isFullWidth.ToString().ToLowerInvariant());
        }
        catch { }
    }

    private async Task LoadAllDataAsync()
    {
        loading = true;
        try
        {
            // 1. Teams & Staff
            myTeams = await TeamService.GetMyTeamsAsync() ?? new();
            if (selectedTeamId.HasValue && !myTeams.Any(t => t.TeamId == selectedTeamId.Value))
            {
                var discovered = await TeamService.GetTeamByIdAsync(selectedTeamId.Value);
                if (discovered != null)
                {
                    myTeams.Insert(0, discovered);
                }
            }
            allTeamStaff = myTeams
                .SelectMany(t => t.Staffs.Select(s => new TeamStaffFlattened(s.StaffId, s.FullName, s.IsSuperVisor, t.TeamId, t.Name)))
                .ToList();

            if (selectedTeamId == null && myTeams.Count > 0)
            {
                selectedTeamId = myTeams[0].TeamId;
            }

            // 2. Help Desk Team
            try
            {
                helpDeskTeam = await TeamService.GetHelpDeskTeamAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load Help Desk team for workspace.");
            }

            // 3. Sub-Teams & Team Projects
            if (selectedTeamId.HasValue)
            {
                await LoadSubTeamsForCurrentTeamAsync();
                await LoadTeamProjectsAsync(selectedTeamId.Value);
            }

            // 4. Attendance
            try
            {
                todayAttendance = await AttendanceLogService.GetMyTeamAttendanceTodayAsync() ?? new();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load today's attendance for workspace.");
            }

            // 5. Requests
            await RefreshRequestsAsync();

            // 6. Recent Searches
            try
            {
                recentSearchItems = await RecentSearches.GetAsync() ?? new();
            }
            catch { }

            // 7. To Do Items
            try
            {
                var todoPage = await Todos.GetMyTodosAsync(includeCompleted: false, page: 1);
                todoItems = todoPage?.Items?.ToList() ?? new();
            }
            catch { }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load complete workspace data.");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadTeamProjectsAsync(int teamId)
    {
        if (!IsSupervisorOfCurrentTeam)
        {
            currentTeamProjects.Clear();
            return;
        }
        loadingProjects = true;
        try
        {
            currentTeamProjects = await TeamService.GetTeamProjectsAsync(teamId) ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load team projects for team {TeamId}", teamId);
            currentTeamProjects.Clear();
        }
        finally
        {
            loadingProjects = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        await LoadAllDataAsync();
        ToastService.Success("Workspace refreshed.");
    }

    private async Task RefreshRequestsAsync()
    {
        try
        {
            pendingLeaves = await Leaves.GetPendingLeaveRequestsAsync() ?? new();
            if (selectedLeave != null)
            {
                selectedLeave = pendingLeaves.FirstOrDefault(r => r.RequestId == selectedLeave.RequestId);
            }
        }
        catch { }

        try
        {
            var dutyRows = await Duties.GetRequestsAsync() ?? new();
            pendingDutyRequests = dutyRows.Where(r => r.CanAccept || r.CanApprove).ToList();
        }
        catch { }

        try
        {
            attendanceLoading = true;
            var filter = new AttendanceRequestFilter(DateOnly.FromDateTime(DateTime.Today.AddDays(-60)), DateOnly.FromDateTime(DateTime.Today.AddDays(30)));
            var page = await AttendanceQueries.GetReceivedAsync(filter);
            attendanceRequestsList = page?.Requests ?? new();
            if (selectedAttendanceRequest != null)
            {
                selectedAttendanceRequest = attendanceRequestsList.FirstOrDefault(r => r.RequestId == selectedAttendanceRequest.RequestId);
                if (selectedAttendanceRequest != null)
                {
                    attendanceReview = await AttendanceReviewService.GetAsync(selectedAttendanceRequest.RequestId);
                }
                else
                {
                    attendanceReview = null;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed loading attendance requests for workspace");
        }
        finally
        {
            attendanceLoading = false;
        }

        try
        {
            itemLoading = true;
            itemRequestsList = await ItemService.GetStaffRequestsAsync() ?? new();
            if (selectedItemRequest != null)
            {
                selectedItemRequest = itemRequestsList.FirstOrDefault(r => r.RequestId == selectedItemRequest.RequestId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed loading item requests for workspace");
        }
        finally
        {
            itemLoading = false;
        }

        try
        {
            certLoading = true;
            certificateRequestsList = await CertificateService.GetAdminPendingRequestsAsync(statusFilter: "All") ?? new();
            if (selectedCertificateRequest != null)
            {
                var updatedCert = certificateRequestsList.FirstOrDefault(r => r.CertificateRequestId == selectedCertificateRequest.CertificateRequestId);
                if (updatedCert != null)
                {
                    await SelectCertificateRequestAsync(updatedCert);
                }
                else
                {
                    selectedCertificateRequest = null;
                    selectedCertificateDetail = null;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed loading certificate requests for workspace");
        }
        finally
        {
            certLoading = false;
        }
    }

    private async Task SelectCertificateRequestAsync(CertificateRequestSummaryDto summary)
    {
        selectedCertificateRequest = summary;
        certActionError = null;
        certActionComment = "";
        try
        {
            selectedCertificateDetail = await CertificateService.GetRequestDetailAsync(summary.CertificateRequestId);
            if (selectedCertificateDetail != null)
            {
                certAddressedTo = string.IsNullOrWhiteSpace(selectedCertificateDetail.Summary.AddressedTo)
                    ? "TO WHOM IT MAY CONCERN"
                    : selectedCertificateDetail.Summary.AddressedTo;
                if (selectedCertificateDetail.CurrentDraftSnapshot != null)
                {
                    certSignatoryName = selectedCertificateDetail.CurrentDraftSnapshot.SignatoryName;
                    certSignatoryTitle = selectedCertificateDetail.CurrentDraftSnapshot.SignatoryTitle;
                    certIncludeResp = selectedCertificateDetail.CurrentDraftSnapshot.Positions.Any(p => p.Responsibilities.Count > 0);
                    certIncludeProj = selectedCertificateDetail.CurrentDraftSnapshot.Projects.Count > 0;
                    certIncludeSalary = selectedCertificateDetail.CurrentDraftSnapshot.BasicSalary.HasValue;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load certificate detail {Id}", summary.CertificateRequestId);
        }
    }

    private async Task ActCertificateRequestAsync(string action)
    {
        if (selectedCertificateRequest == null) return;
        if ((action == "Reject" || action == "Return") && string.IsNullOrWhiteSpace(certActionComment))
        {
            certActionError = "Please enter remarks explaining the reason.";
            return;
        }

        certActing = true;
        certActionError = null;
        try
        {
            var reqId = selectedCertificateRequest.CertificateRequestId;
            var res = await CertificateService.ReviewActionAsync(new CertificateReviewActionInput
            {
                CertificateRequestId = reqId,
                Action = action,
                Reason = certActionComment,
                Comments = certActionComment,
                CorrectedAddressedTo = certAddressedTo,
                CorrectedSignatoryName = certSignatoryName,
                CorrectedSignatoryTitle = certSignatoryTitle,
                IncludeResponsibilities = certIncludeResp,
                IncludeProjects = certIncludeProj,
                IncludeSalary = certIncludeSalary
            });

            if (!res.Success)
            {
                certActionError = res.Message;
                return;
            }

            if (action == "Issue")
            {
                var detail = await CertificateService.GetRequestDetailAsync(reqId);
                if (detail.IssuedCertificate != null)
                {
                    var fontPath = Path.Combine(Environment.WebRootPath, "fonts", "Faruma.ttf");
                    var pdfBytes = HRM.Services.CertificatePdfGenerator.Generate(detail.IssuedCertificate.Snapshot, fontPath);
                    await CertificateService.SaveIssuedCertificatePdfAsync(detail.IssuedCertificate.IssuedCertificateId, pdfBytes);
                }
            }

            ToastService.Success(res.Message);
            certActionComment = "";
            await RefreshRequestsAsync();
        }
        catch (Exception ex)
        {
            certActionError = ex.Message;
        }
        finally
        {
            certActing = false;
        }
    }

    private async Task DownloadIssuedCertPdfAsync(int issuedCertificateId, string certificateNumber)
    {
        try
        {
            var pdfBytes = await CertificateService.GetIssuedCertificatePdfAsync(issuedCertificateId);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                var snap = await CertificateService.GetCertificateSnapshotAsync(issuedCertificateId);
                var fontPath = Path.Combine(Environment.WebRootPath, "fonts", "Faruma.ttf");
                pdfBytes = HRM.Services.CertificatePdfGenerator.Generate(snap, fontPath);
                await CertificateService.SaveIssuedCertificatePdfAsync(issuedCertificateId, pdfBytes);
            }

            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            using var stream = new MemoryStream(pdfBytes);
            using var reference = new DotNetStreamReference(stream);
            await module.InvokeVoidAsync("download", $"{certificateNumber}.pdf", "application/pdf", reference);
            ToastService.Success("Certificate downloaded.");
        }
        catch (Exception ex)
        {
            ToastService.Error("Failed downloading certificate: " + ex.Message);
        }
    }

