@page "/admin/my/workspace"
@page "/admin/my/workspace/{ActiveSection}"
@page "/admin/my/workspace/{EntityRoute}/{EntityId:int}/{ActiveSection}"
@page "/admin/my/workspace/hub"
@page "/admin/my/workspace/team-hub"
@page "/admin/my/workspace-hub"
@page "/admin/my/workspace/v2"
@page "/admin/my/workspace/hub/{ActiveSection}"
@using HRM.DTOs
@using HRM.DTOs.Leave
@using HRM.DTOs.WorkPlanning
@using HRM.Enum
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Components.Admin.My.Workspace.Cards
@using HRM.Components.Admin.My.Workspace.Staff
@using HRM.Components.Admin.My.Workspace.Staff.Tabs
@using HRM.Components.Admin.My.Workspace.Teams
@using HRM.Components.Admin.My.Workspace.Organisation
@using static HRM.Services.Contracts.StaffPositionManagementServiceContracts
@using HRM.DTOs.Items
@using HRM.DTOs.Certificates
@using HRM.DTOs.Profile
@using HRM.Application.Contracts.Pages
@inject ITeam TeamService
@inject HRM.Application.Contracts.Pages.IAttendanceRequestQueries AttendanceQueries
@inject HRM.Application.Contracts.Pages.IAttendanceRequestReview AttendanceReviewService
@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService
@inject ILeaveChangeService Leaves
@inject HRM.WorkPlanning.Services.Contracts.DutyRosterServiceContracts.IOperations Duties
@inject HRM.Services.Contracts.StaffPositionManagementServiceContracts.IOperations PositionService
@inject HRM.Services.Contracts.ItemCatalogueServiceContracts.IOperations ItemService
@inject HRM.Services.Contracts.CertificateServiceContracts.IOperations CertificateService
@inject IWebHostEnvironment Environment
@inject IWorkspaceDirectoryService Directory
@inject HRM.Services.Interfaces.Profile.IProfileService ProfileService
@inject HRM.Services.Contracts.WorkspaceRecentSearchServiceContracts.IOperations RecentSearches
@inject IUserTodoService Todos
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<StaffHubWorkspace> Logger
@inject HRM.Services.ToastService ToastService
@inject IUserAccessService UserAccess
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer

<PageTitle>Admin Workspace - HR Portal</PageTitle>

<section class="my-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-all duration-300 @(isFullWidth ? "max-w-none" : "max-w-7xl mx-auto")">
    
    <!-- Top Header Area Matching HRM.UI Standard -->
    <div class="my-workspace-header staff-overview-no-print flex flex-col gap-2 p-2">
        <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Admin Workspace</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Management dashboard for supervised teams, employee evaluations, projects, and workforce requests.</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        @onclick="ToggleFullWidthAsync">
                    <span>@(isFullWidth ? "⤢ Shrink View" : "⤡ Full Width")</span>
                </button>
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        disabled="@loading"
                        @onclick="RefreshAllAsync">
                    <span class="@(loading ? "animate-spin" : "")">↻</span>
                    <span>Refresh</span>
                </button>

            </div>
        </div>

        <!-- Workspace Directory Search (Using Standard Workspace Directory Search Component) -->
        <div class="relative w-full max-w-xl">
            <WorkspaceSearch OnSelected="SelectSearchResult" />
        </div>
    </div>

    <!-- Solid Folder Navigation Tabs -->
    <div class="my-workspace-tabs staff-overview-no-print w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
        <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Workspace Tabs">
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Home" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("Home")'>
                Home
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "MyTeam" && teamCenterSubTab != "projects" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick="NavigateToTeamsTab">
                Teams (@myTeams.Count)
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "MyTeam" && teamCenterSubTab == "projects" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick="NavigateToProjectsTab">
                Projects & Tasks
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Calendar" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("Calendar")'>
                Calendars
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Request" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("Request")'>
                Requests
                @if (TotalPendingRequestsCount > 0)
                {
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeWorkspaceTab == "Request" ? "bg-white/20 text-white" : "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300")">
                        @TotalPendingRequestsCount
                    </span>
                }
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Onboarding" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("Onboarding")'>
                Onboarding
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "LeaveLog" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("LeaveLog")'>
                Leave Log
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Attendance" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("Attendance")'>
                Attendance
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "TimeChange" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("TimeChange")'>
                Time Change
            </button>
            <button type="button"
                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "OrgDaily" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                    @onclick='() => SetActiveTab("OrgDaily")'>
                Org Daily
            </button>
            @if (inspectedStaffId.HasValue)
            {
                var staffTotalPending = GetStaffTotalPendingCount(inspectedStaffId.Value, inspectedStaffName);
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r flex items-center gap-1.5 @(activeWorkspaceTab == "Staff" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SetActiveTab("Staff")'>
                    <span>👤 @inspectedStaffName</span>
                    @if (staffTotalPending > 0)
                    {
                        <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(activeWorkspaceTab == "Staff" ? "bg-white/25 text-white" : "bg-amber-500 text-white")">
                            @staffTotalPending
                        </span>
                    }
                </button>
            }
            @if (inspectedOrgId.HasValue)
            {
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeWorkspaceTab == "Organisation" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SetActiveTab("Organisation")'>
                    🏛️ @inspectedOrgName
                </button>
            }
        </nav>
    </div>

    <!-- ======================================================== -->
    <!-- TAB: STAFF WORKSPACE (Full Width Dedicated Employee Workspace) -->
    <!-- ======================================================== -->
    @if (activeWorkspaceTab == "Staff" && inspectedStaffId.HasValue)
    {
        <div class="flex flex-col gap-2 p-2">
            <!-- Staff Workspace Header Bar -->
            <div class="staff-workspace-header staff-overview-no-print rounded-2xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-2 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-2">
                <div class="flex items-start sm:items-center gap-2 min-w-0 flex-1">
                    @if (!string.IsNullOrWhiteSpace(inspectedStaffProfile?.ImageUrl))
                    {
                        <img src="@inspectedStaffProfile.ImageUrl"
                             alt="@(inspectedStaffProfile?.FullName ?? inspectedStaffName)"
                             class="w-16 h-16 rounded-full object-cover border-2 border-teal-500/40 shrink-0 shadow-xs" />
                    }
                    else
                    {
                        <div class="w-16 h-16 rounded-full bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-bold flex items-center justify-center text-lg shadow-xs shrink-0 border-2 border-teal-300 dark:border-teal-700">
                            @GetInitials(inspectedStaffProfile?.FullName ?? inspectedStaffName)
                        </div>
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-base md:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">
                                @(inspectedStaffProfile?.FullName ?? inspectedStaffName)
                            </h2>
                            <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800/40 px-2.5 py-0.5 text-[10px] font-semibold">
                                Staff Workspace
                            </span>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-1.5 mt-2 text-xs">
                            <div class="min-w-0">
                                <span class="text-slate-400 dark:text-slate-500 font-medium block text-[10px]">Department</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block" title="@(inspectedStaffProfile?.ActiveJob?.DepartmentName ?? inspectedStaffProfile?.ActiveJob?.OrganisationStructureName ?? "Not Assigned")">
                                    @(inspectedStaffProfile?.ActiveJob?.DepartmentName ?? inspectedStaffProfile?.ActiveJob?.OrganisationStructureName ?? "Not Assigned")
                                </span>
                            </div>
                            <div class="min-w-0">
                                <span class="text-slate-400 dark:text-slate-500 font-medium block text-[10px]">Position</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block" title="@(inspectedStaffProfile?.ActiveJob?.PositionName ?? inspectedStaffProfile?.ActivePositions?.FirstOrDefault(p => p.IsCurrent)?.PositionName ?? "Not Assigned")">
                                    @(inspectedStaffProfile?.ActiveJob?.PositionName ?? inspectedStaffProfile?.ActivePositions?.FirstOrDefault(p => p.IsCurrent)?.PositionName ?? "Not Assigned")
                                </span>
                            </div>
                            <div class="min-w-0">
                                <span class="text-slate-400 dark:text-slate-500 font-medium block text-[10px]">Employee ID</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block">
                                    @(!string.IsNullOrWhiteSpace(inspectedStaffProfile?.ActiveJob?.EmployeeNumber) ? inspectedStaffProfile.ActiveJob.EmployeeNumber : (!string.IsNullOrWhiteSpace(inspectedStaffProfile?.StaffNo) ? inspectedStaffProfile.StaffNo : $"#{inspectedStaffId}"))
                                </span>
                            </div>
                            <div class="min-w-0">
                                <span class="text-slate-400 dark:text-slate-500 font-medium block text-[10px]">Supervisor</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block" title="@(inspectedStaffProfile?.ActiveJob?.SupervisorName ?? "Not Assigned")">
                                    @(string.IsNullOrWhiteSpace(inspectedStaffProfile?.ActiveJob?.SupervisorName) ? "Not Assigned" : inspectedStaffProfile.ActiveJob.SupervisorName)
                                </span>
                            </div>
                            <div class="min-w-0">
                                <span class="text-slate-400 dark:text-slate-500 font-medium block text-[10px]">Joined Date</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block">
                                    @(inspectedStaffProfile?.ActiveJob != null && inspectedStaffProfile.ActiveJob.JoinedDate != default ? inspectedStaffProfile.ActiveJob.JoinedDate.ToString("dd MMM yyyy") : "N/A")
                                </span>
                            </div>
                            <div class="min-w-0">
                                <span class="text-slate-400 dark:text-slate-500 font-medium block text-[10px]">Position Date</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block">
                                    @{
                                        var pDate = inspectedStaffProfile?.ActivePositions?.FirstOrDefault(p => p.IsCurrent)?.FromDate ?? inspectedStaffProfile?.ActivePositions?.FirstOrDefault()?.FromDate ?? inspectedStaffProfile?.ActiveJob?.JoinedDate;
                                    }
                                    @(pDate.HasValue && pDate.Value != default ? pDate.Value.ToString("dd MMM yyyy") : "N/A")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-2 self-start md:self-center shrink-0">
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                            @onclick="CloseStaffWorkspace">
                        ✕ Close Staff View
                    </button>
                </div>
            </div>

            <!-- Full Staff Sub-Tabs Bar (Folder Tabs with Lighter Green) -->
            <div class="staff-workspace-tabs staff-overview-no-print w-full border-b-2 border-emerald-600 dark:border-emerald-500 overflow-x-auto">
                <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Staff Workspace Tabs">
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Overview ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Overview)">
                        Overview
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Performance ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Performance)">
                        Performance
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r flex items-center gap-1.5 @(inspectedStaffTab == WorkspaceTab.Leave ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Leave)">
                        <span>Leave</span>
                        @if (GetStaffPendingLeaveCount(inspectedStaffId.Value, inspectedStaffName) > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(inspectedStaffTab == WorkspaceTab.Leave ? "bg-white/25 text-white" : "bg-amber-500 text-white")">
                                @GetStaffPendingLeaveCount(inspectedStaffId.Value, inspectedStaffName)
                            </span>
                        }
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r flex items-center gap-1.5 @(inspectedStaffTab == WorkspaceTab.Attendance ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Attendance)">
                        <span>Attendance</span>
                        @if (GetStaffPendingAttendanceCount(inspectedStaffId.Value, inspectedStaffName) > 0)
                        {
                            <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(inspectedStaffTab == WorkspaceTab.Attendance ? "bg-white/25 text-white" : "bg-amber-500 text-white")">
                                @GetStaffPendingAttendanceCount(inspectedStaffId.Value, inspectedStaffName)
                            </span>
                        }
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Position ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Position)">
                        Positions
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.Finance ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.Finance)">
                        Allowances & deductions
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r @(inspectedStaffTab == WorkspaceTab.OT ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.OT)">
                        Overtime
                    </button>
                    <button type="button"
                            class="rounded-t-xl px-3.5 py-1.5 font-bold text-xs transition-all border-t border-l border-r flex items-center gap-1.5 @(inspectedStaffTab == WorkspaceTab.JobRelatedItems ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700")"
                            @onclick="() => SetStaffTab(WorkspaceTab.JobRelatedItems)">
                        <span>Job Items</span>
