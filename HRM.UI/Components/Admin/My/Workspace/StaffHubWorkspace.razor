        UpdateUrl();
        await LoadTeamProjectsAsync(teamId);
    }

    private async Task HandleSearchTeamSelected(int teamId)
    {
        showSearchTeamsModal = false;
        activeWorkspaceTab = "MyTeam";
        selectedTeamId = teamId;

        if (!myTeams.Any(t => t.TeamId == teamId))
        {
            var discovered = await TeamService.GetTeamByIdAsync(teamId);
            if (discovered != null)
            {
                myTeams.Insert(0, discovered);
                var flattened = discovered.Staffs.Select(s => new TeamStaffFlattened(s.StaffId, s.FullName, s.IsSuperVisor, discovered.TeamId, discovered.Name));
                allTeamStaff.AddRange(flattened);
            }
        }

        UpdateUrl();
        await LoadTeamProjectsAsync(teamId);
    }

