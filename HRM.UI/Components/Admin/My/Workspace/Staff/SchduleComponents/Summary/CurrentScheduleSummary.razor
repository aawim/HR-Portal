@using HRM.DTOs.StaffSchedule
<header class="space-y-2 rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
        <div>
            <h3 class="text-base font-bold text-slate-800">Work Schedules &amp; Shifts</h3>
            <p class="text-xs text-slate-500 mt-0.5">@Schedule.PositionName · @Schedule.OrganisationName</p>
        </div>
        @if (Schedule.HourCoverage.HasOfficialSchedule)
        {
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                Official schedule active
            </span>
        }
        else
        {
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                No official schedule
            </span>
        }
    </div>
    @if (Schedule.HourCoverage.HasOfficialSchedule)
    {
        <div class="flex flex-wrap items-center gap-4 text-xs pt-1">
            <p class="text-slate-700">Regular working day: <strong class="text-slate-900 font-bold">@Minutes(Schedule.HourCoverage.OfficialMinutes)</strong></p>
            @if (Schedule.HourCoverage.PotentialOvertimeMinutes > 0)
            {
                <p class="text-amber-700 font-medium bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
                    Duty outside official hours: @Minutes(Schedule.HourCoverage.PotentialOvertimeMinutes) (requires separate OT approval)
                </p>
            }
            else if (Schedule.HourCoverage.DutyMinutes > 0)
            {
                <p class="text-slate-500">Duty is within official hours and does not add extra working hours.</p>
            }
        </div>
    }
    else
    {
        <p class="text-xs text-slate-500 pt-1">Start by setting official working hours, then add duty as needed.</p>
    }
</header>
@code {
    [Parameter, EditorRequired] public StaffScheduleDto Schedule { get; set; } = null!;
    private static string Minutes(int value) => $"{value / 60}h {value % 60:00}m";
}
