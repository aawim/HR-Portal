@using HRM.DTOs.StaffSchedule
<header class="space-y-2 rounded-xl border bg-white p-5 shadow-sm">
    <h2 class="text-xl font-semibold">Schedules · @Schedule.EmployeeName</h2>
    <p class="text-sm text-slate-500">@Schedule.PositionName · @Schedule.OrganisationName</p>
    @if (Schedule.HourCoverage.HasOfficialSchedule)
    {
        <p class="text-sm">Regular working day: <strong>@Minutes(Schedule.HourCoverage.OfficialMinutes)</strong>.</p>
        @if (Schedule.HourCoverage.PotentialOvertimeMinutes > 0)
        { <p class="text-sm text-amber-700">Duty outside official hours: @Minutes(Schedule.HourCoverage.PotentialOvertimeMinutes). This needs a separate OT request and approval.</p> }
        else if (Schedule.HourCoverage.DutyMinutes > 0)
        { <p class="text-sm text-slate-500">Duty is within official hours and does not add extra working hours.</p> }
    }
    else { <p class="text-sm text-slate-500">Start by setting official working hours, then add duty as needed.</p> }
</header>
@code {
    [Parameter, EditorRequired] public StaffScheduleDto Schedule { get; set; } = null!;
    private static string Minutes(int value) => $"{value / 60}h {value % 60:00}m";
}
