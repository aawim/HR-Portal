@*
@page "/admin/my/workspace/staff" *@
@using HRM.Components.Admin.My.Workspace.Staff.Tabs
@using HRM.Enum
@using HRM.Models

@using HRM.DTOs
@inject HRM.Services.Interfaces.IWorkspaceDirectoryService Directory
@inject HRM.Services.Interfaces.IUserAccessService Access

<div class="mt-6 bg-white rounded-xl border border-slate-200 shadow-sm">

    @if (Loading)
    {
        <div class="p-6">
            Loading staff information...
        </div>
    }
    else if (Staff == null)
    {
        <div class="p-6 text-red-500">
            Staff not found.
        </div>
    }
    else if(former)
    {
        <HRM.Components.Admin.Hr.Staff.FormerStaffRecord StaffId="StaffId" />
    }
    else
    {
        <div class="p-6">

            <div class="flex justify-between">

                <div>
                    <h2 class="text-xl font-semibold text-slate-800">
                        @Staff.Name
                    </h2>

                    <p class="text-sm text-slate-500">
                        @Staff.Position
                    </p>
                </div>


                <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-sm">
                    @Staff.Status
                </span>

            </div>


            <div class="">

                    @if (ActiveTab == WorkspaceTab.Overview)
                    {
                       <StaffOverview StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.Leave)
                    {
                    <StaffLeave @key="StaffId" StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.OT)
                    {
                    <p>OT</p> <StaffOvertime StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.Attendance)
                    {
                    <StaffAttendance @key="StaffId" StaffId="StaffId" StaffName="@Staff.Name" ShowOverview="false" />
                    }
                    else if (ActiveTab == WorkspaceTab.Position)
                    {
                        <StaffPositions @key="StaffId" StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.Documents)
                    {
                    <p>Documents</p> <StaffDocuments StaffId="StaffId" />
                    }

                    else if (ActiveTab == WorkspaceTab.LeaveType)
                    {
                    <p>Manage Staff Leave Assignments </p> <LeaveAssignmentManager @key="StaffId" StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.Schedule)
                    {
                        <p>Manage Scheduling for the Staff </p> <Schedule StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.WorkTypes)
                    {
                        <HRM.Components.Admin.Settings.WorkTypeManagement @key="StaffId" StaffId="StaffId" />
                    }
                    else if (ActiveTab == WorkspaceTab.Finance)
                    {
                        <HRM.Components.Shared.StaffFinancePanel @key="StaffId" StaffId="StaffId" AdminMode="true" />
                    }
                   

            </div>

        </div>
 
    }

</div>


@code {
    private bool Loading;
    private bool former;

    private StaffWorkspaceIdentity? Staff;
     
    [Parameter]
    public int StaffId { get; set; }

    [Parameter]
    public WorkspaceTab ActiveTab { get; set; }

    private int? loadedStaffId;
    private int? loadedOrganisationId;
    protected override async Task OnParametersSetAsync()
    {
        var org=await Access.GetCurrentOrganisationIdAsync();
        if (loadedStaffId == StaffId && loadedOrganisationId==org) return;
        loadedOrganisationId=org;
        var staffId = StaffId;
        loadedStaffId = staffId;
        Loading = true;
        var staff = await Directory.GetStaffIdentityAsync(staffId);
        if (loadedStaffId != staffId || loadedOrganisationId!=org) return;
        Staff = staff;
        former = staff?.IsFormer == true;
        Loading = false;
    }

}
