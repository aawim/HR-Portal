@using HRM.DTOs.LeaveTypes

<div class="bg-white rounded-xl border border-slate-200 shadow-sm h-full flex flex-col">

    <!-- Header -->
    <div class="px-4 py-3 border-b border-slate-100 min-h-[4.5rem] flex flex-col justify-center">
        <h3 class="font-semibold text-slate-800">
            Available Leave Types
        </h3>

        <p class="text-xs text-slate-500 mt-1">
            @FilteredTypes.Count available
        </p>
    </div>

    <!-- Search -->
    <div class="p-2 border-b border-slate-100">
        <div class="relative">
            <input class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5 pr-8 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="Search leave types..."
                   disabled="@IsProcessing"
                   @bind="_search"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button type="button"
                        class="absolute inset-y-0 right-0 flex items-center px-2 text-xs text-slate-400 hover:text-slate-700"
                        title="Clear search"
                        @onclick="ClearSearch">
                    ✕
                </button>
            }
        </div>
    </div>

    <!-- List -->
    <div class="max-h-[550px] overflow-y-auto divide-y divide-slate-100 flex-1">
        @if (Types.Count == 0)
        {
            <div class="py-8 text-center text-xs text-slate-500">
                No leave types are available.
            </div>
        }
        else if (FilteredTypes.Count == 0)
        {
            <div class="py-8 text-center text-xs text-slate-500">
                No leave types match your search.
            </div>
        }
        else
        {
            @foreach (var type in FilteredTypes)
            {
                <div @key="type.LeaveTypeId"
                     class="p-2.5 cursor-pointer transition text-left w-full @(IsSelected(type) ? "bg-blue-50 border-l-4 border-blue-600" : "hover:bg-slate-50")"
                     @onclick="() => SelectType(type)">

                    <div class="flex items-center justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-xs text-slate-800 truncate">
                                🌴 @(string.IsNullOrWhiteSpace(type.Name)
                                    ? "Unnamed leave type"
                                    : type.Name)
                            </div>

                            @if (!string.IsNullOrWhiteSpace(type.NameDhivehi))
                            {
                                <div class="text-[11px] text-slate-500 mt-0.5 truncate" lang="dv" dir="rtl">
                                    @type.NameDhivehi
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(type.Code))
                            {
                                <div class="text-[10px] text-slate-400 mt-0.5 font-mono">
                                    Code: @type.Code
                                </div>
                            }
                        </div>

                        @if (IsSelected(type))
                        {
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-100 text-blue-700 shrink-0">
                                Selected
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Footer -->
    <div class="border-t border-slate-100 p-2 mt-auto">
        @if (_selectedType is not null)
        {
            <div class="mb-2 rounded-lg bg-blue-50 p-1.5 text-xs text-blue-700 flex items-center justify-between">
                <span class="truncate">Selected: <strong>@_selectedType.Name</strong></span>
                @if (!string.IsNullOrWhiteSpace(_selectedType.Code))
                {
                    <span class="font-mono text-[10px] text-blue-500 shrink-0 ml-1">@_selectedType.Code</span>
                }
            </div>
        }

        <button type="button"
                class="w-full rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-slate-300"
                disabled="@CannotAssign"
                @onclick="AssignTypeAsync">
            @if (IsProcessing)
            {
                <span>Assigning...</span>
            }
            else
            {
                <span>+ Assign Selected Leave Type</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LeaveTypeCatalogueDto> Types { get; set; }
        = Array.Empty<LeaveTypeCatalogueDto>();

    [Parameter]
    public EventCallback<LeaveTypeCatalogueDto> OnAssign { get; set; }

    [Parameter]
    public bool IsProcessing { get; set; }

    private string _search = string.Empty;

    private LeaveTypeCatalogueDto? _selectedType;

    private List<LeaveTypeCatalogueDto> FilteredTypes
    {
        get
        {
            IEnumerable<LeaveTypeCatalogueDto> query =
                Types ?? Array.Empty<LeaveTypeCatalogueDto>();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var search = _search.Trim();

                query = query.Where(x =>
                    (
                        !string.IsNullOrWhiteSpace(x.Name) &&
                        x.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                    ||
                    (
                        !string.IsNullOrWhiteSpace(x.NameDhivehi) &&
                        x.NameDhivehi.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                    ||
                    (
                        !string.IsNullOrWhiteSpace(x.Code) &&
                        x.Code.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    ));
            }

            return query
                .OrderBy(x => x.Name)
                .ToList();
        }
    }

    private bool CannotAssign =>
        _selectedType is null ||
        IsProcessing ||
        !OnAssign.HasDelegate;

    protected override void OnParametersSet()
    {
        if (_selectedType is null)
        {
            return;
        }

        // Clear the selection if the parent reloads the list
        // and the selected type is no longer available.
        var selectionStillAvailable =
            Types.Any(x =>
                x.LeaveTypeId ==
                _selectedType.LeaveTypeId);

        if (!selectionStillAvailable)
        {
            _selectedType = null;
        }
    }

    private void SelectType(
        LeaveTypeCatalogueDto type)
    {
        if (IsProcessing)
        {
            return;
        }

        _selectedType = type;
    }

    private async Task AssignTypeAsync()
    {
        if (CannotAssign ||
            _selectedType is null)
        {
            return;
        }

        await OnAssign.InvokeAsync(
            _selectedType);
    }

    private void ClearSearch()
    {
        _search = string.Empty;
    }

    private bool IsSelected(
        LeaveTypeCatalogueDto type)
    {
        return _selectedType?.LeaveTypeId ==
            type.LeaveTypeId;
    }

    private string GetButtonClass(
        LeaveTypeCatalogueDto type)
    {
        return IsSelected(type)
            ? "border-blue-500 bg-blue-50 ring-1 ring-blue-400"
            : "border-slate-200 bg-white hover:bg-slate-50";
    }
}
