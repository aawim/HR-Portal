@namespace HRM.Components.Admin.My.Workspace.Staff.Tabs
@using HRM.DTOs.Staff
@using HRM.Services.Contracts
@inject StaffEmergencyContactServiceContracts.IOperations ContactService
@inject HRM.Services.ToastService Toasts
@inject ILogger<StaffEmergencyContacts> Logger

<div class="staff-emergency-contacts w-full min-w-0 p-2 space-y-4">
    <!-- Header Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 rounded-2xl shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-xl">🚨</span>
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Emergency Contact Directory
                </h2>
                <span class="rounded-full bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 px-2.5 py-0.5 text-xs font-semibold">
                    @contacts.Count Contact@(contacts.Count == 1 ? "" : "s")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Designated individuals to notify in case of medical crises, sudden workplace accidents, or urgent personal incidents.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                    disabled="@busy"
                    @onclick="LoadContactsAsync">
                <span>↻</span>
                <span>Refresh</span>
            </button>

            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs transition"
                    disabled="@busy"
                    @onclick="OpenAddModal">
                <span>+</span>
                <span>Add Emergency Contact</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(globalError))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 flex items-center justify-between">
            <span>⚠️ @globalError</span>
            <button type="button" class="text-rose-700 font-bold hover:underline" @onclick="() => globalError = null">Dismiss</button>
        </div>
    }

    <!-- Content Area -->
    @if (busy && contacts.Count == 0)
    {
        <div class="py-12 text-center text-xs text-slate-400 animate-pulse">
            Loading emergency contacts…
        </div>
    }
    else if (contacts.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center text-xs text-slate-500 dark:text-slate-400 flex flex-col items-center gap-2">
            <span class="text-3xl">🚨</span>
            <p class="font-bold text-slate-800 dark:text-slate-200 text-sm">No Emergency Contacts Registered</p>
            <p class="text-xs max-w-md">No next-of-kin or emergency points of contact are on file for this staff member. Having at least one primary emergency contact is crucial for workplace safety and crisis protocols.</p>
            <button type="button"
                    class="mt-2 inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs transition"
                    @onclick="OpenAddModal">
                <span>+ Add Primary Contact</span>
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @foreach (var c in contacts)
            {
                <div @key="c.Id"
                     class="rounded-2xl border p-4 shadow-xs flex flex-col justify-between gap-3 transition @(c.IsPrimary ? "border-rose-400 dark:border-rose-600 bg-rose-50/20 dark:bg-rose-950/20 ring-1 ring-rose-400/50" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300")">

                    <!-- Top Bar: Contact Name, Relationship, Badges -->
                    <div class="flex items-start justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-xl shrink-0">👤</span>
                            <div>
                                <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm leading-tight">
                                    @c.ContactName
                                </h3>
                                <span class="inline-block mt-0.5 rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                    @c.Relationship
                                </span>
                            </div>
                        </div>

                        <div>
                            @if (c.IsPrimary)
                            {
                                <span class="rounded-full bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 border border-rose-200 dark:border-rose-900 px-2 py-0.5 text-[10px] font-bold tracking-wide flex items-center gap-1 shadow-2xs">
                                    <span>⭐</span> Primary
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Details Body -->
                    <div class="space-y-2 text-xs">
                        <div class="flex items-center justify-between bg-slate-50 dark:bg-slate-800/60 rounded-lg px-2.5 py-1.5 border border-slate-200/60 dark:border-slate-700/60">
                            <span class="text-slate-500 dark:text-slate-400 font-medium flex items-center gap-1">
                                <span>📞</span> Primary Phone:
                            </span>
                            <a href="tel:@c.PrimaryPhone" class="font-semibold text-teal-700 dark:text-teal-400 hover:underline">
                                @c.PrimaryPhone
                            </a>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(c.SecondaryPhone))
                        {
                            <div class="flex items-center justify-between bg-slate-50 dark:bg-slate-800/60 rounded-lg px-2.5 py-1.5 border border-slate-200/60 dark:border-slate-700/60">
                                <span class="text-slate-500 dark:text-slate-400 font-medium flex items-center gap-1">
                                    <span>📱</span> Secondary Phone:
                                </span>
                                <a href="tel:@c.SecondaryPhone" class="font-medium text-slate-700 dark:text-slate-300 hover:underline">
                                    @c.SecondaryPhone
                                </a>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(c.Email))
                        {
                            <div class="flex items-center justify-between bg-slate-50 dark:bg-slate-800/60 rounded-lg px-2.5 py-1.5 border border-slate-200/60 dark:border-slate-700/60">
                                <span class="text-slate-500 dark:text-slate-400 font-medium flex items-center gap-1">
                                    <span>✉️</span> Email:
                                </span>
                                <a href="mailto:@c.Email" class="font-medium text-teal-700 dark:text-teal-400 hover:underline truncate max-w-[180px]">
                                    @c.Email
                                </a>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(c.Address))
                        {
                            <div class="bg-slate-50 dark:bg-slate-800/60 rounded-lg px-2.5 py-1.5 border border-slate-200/60 dark:border-slate-700/60">
                                <span class="text-slate-500 dark:text-slate-400 font-medium block text-[11px]">🏠 Address:</span>
                                <p class="text-slate-700 dark:text-slate-300 text-xs mt-0.5 leading-snug">@c.Address</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(c.Notes))
                        {
                            <div class="rounded-lg bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40 p-2 text-[11px] text-amber-900 dark:text-amber-200">
                                <span class="font-semibold block text-[10px] text-amber-700 dark:text-amber-400 uppercase tracking-wide">Notes:</span>
                                @c.Notes
                            </div>
                        }
                    </div>

                    <!-- Bottom Actions -->
                    <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                        @if (!c.IsPrimary)
                        {
                            <button type="button"
                                    class="inline-flex items-center gap-1 text-[11px] font-semibold text-rose-700 dark:text-rose-400 hover:text-rose-900 transition hover:underline"
                                    disabled="@busy"
                                    @onclick="() => SetPrimaryAsync(c.Id)">
                                <span>★</span>
                                <span>Set as Primary</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1">
                                <span>✓</span> Default contact
                            </span>
                        }

                        <div class="flex items-center gap-1">
                            <button type="button"
                                    class="inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    title="Edit contact details"
                                    disabled="@busy"
                                    @onclick="() => OpenEditModal(c)">
                                <span>✏️</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center justify-center rounded-lg border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/50 p-1.5 text-xs text-rose-600 dark:text-rose-400 hover:bg-rose-100 transition"
                                    title="Delete contact"
                                    disabled="@busy"
                                    @onclick="() => ConfirmDeleteAsync(c)">
                                <span>✕</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Add/Edit Contact Modal *@
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4 animate-fade-in"
         tabindex="-1"
         @onkeydown="HandleModalKeyDown">
        <div class="w-full max-w-lg rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-5 py-4 bg-slate-50 dark:bg-slate-800/50">
                <div class="flex items-center gap-2">
                    <span class="text-xl">@(isEditing ? "✏️" : "➕")</span>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                        @(isEditing ? "Edit Emergency Contact" : "Add Emergency Contact")
                    </h3>
                </div>
                <button type="button"
                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg leading-none p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                        @onclick="CloseModal">
                    ✕
                </button>
            </div>

            <!-- Modal Body Form -->
            <div class="p-5 overflow-y-auto space-y-4 text-xs">
                @if (!string.IsNullOrWhiteSpace(modalError))
                {
                    <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">
                        ⚠️ @modalError
                    </div>
                }

                <!-- Contact Name -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                        Full Name <span class="text-rose-500">*</span>
                    </label>
                    <input type="text"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                           placeholder="e.g. Aminath Shiuna"
                           @bind="model.ContactName" />
                </div>

                <!-- Relationship -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                        Relationship <span class="text-rose-500">*</span>
                    </label>
                    <div class="grid grid-cols-3 gap-1.5 mb-2">
                        @foreach (var rel in relationshipOptions)
                        {
                            <button type="button"
                                    class="rounded-lg border px-2 py-1.5 text-xs font-semibold text-center transition @(model.Relationship == rel ? "border-teal-600 bg-teal-50 text-teal-800 dark:border-teal-500 dark:bg-teal-950 dark:text-teal-200" : "border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-300")"
                                    @onclick="() => model.Relationship = rel">
                                @rel
                            </button>
                        }
                    </div>
                    @if (!relationshipOptions.Contains(model.Relationship) || model.Relationship == "Other")
                    {
                        <input type="text"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                               placeholder="Specify relationship (e.g. Cousin, Lawyer)"
                               @bind="customRelationship"
                               @oninput="(e) => model.Relationship = e.Value?.ToString() ?? string.Empty" />
                    }
                </div>

                <!-- Phones -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                            Primary Phone <span class="text-rose-500">*</span>
                        </label>
                        <input type="tel"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                               placeholder="e.g. 7771234 or +960 7771234"
                               @bind="model.PrimaryPhone" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                            Secondary Phone <span class="text-slate-400 font-normal">(Optional)</span>
                        </label>
                        <input type="tel"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                               placeholder="e.g. 3310000"
                               @bind="model.SecondaryPhone" />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                        Email Address <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <input type="email"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                           placeholder="e.g. contact@example.com"
                           @bind="model.Email" />
                </div>

                <!-- Address -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                        Residential Address / Island <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <input type="text"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                           placeholder="e.g. Ma. Orchid House, 2nd Floor, Malé"
                           @bind="model.Address" />
                </div>

                <!-- Notes -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">
                        Special Instructions / Notes <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <textarea rows="2"
                              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-teal-500"
                              placeholder="e.g. Available only after 5:00 PM, speaks English & Dhivehi"
                              @bind="model.Notes"></textarea>
                </div>

                <!-- Is Primary Checkbox -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox"
                               class="rounded border-slate-300 text-teal-600 focus:ring-teal-500 h-4 w-4"
                               @bind="model.IsPrimary" />
                        <div>
                            <span class="font-bold text-xs text-slate-800 dark:text-slate-200">Set as Primary Emergency Contact</span>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">First person to call in any urgent situation.</p>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-2 border-t border-slate-200 dark:border-slate-800 px-5 py-3 bg-slate-50 dark:bg-slate-800/50">
                <button type="button"
                        class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition"
                        disabled="@saving"
                        @onclick="CloseModal">
                    Cancel
                </button>
                <button type="button"
                        class="rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-4 py-1.5 text-xs font-semibold shadow-2xs transition inline-flex items-center gap-1.5"
                        disabled="@saving"
                        @onclick="SaveContactAsync">
                    @if (saving)
                    {
                        <span class="animate-spin text-xs">⟳</span>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>@(isEditing ? "Save Changes" : "Save Contact")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Confirm Delete Modal *@
@if (contactToDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4 animate-fade-in">
        <div class="w-full max-w-sm rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl p-5 space-y-4 text-xs">
            <div class="flex items-center gap-2 text-rose-600 dark:text-rose-400 font-bold text-sm">
                <span>⚠️</span>
                <span>Remove Emergency Contact?</span>
            </div>
            <p class="text-slate-600 dark:text-slate-300">
                Are you sure you want to remove <strong class="text-slate-900 dark:text-slate-100">@contactToDelete.ContactName</strong> (@contactToDelete.Relationship)?
            </p>
            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button"
                        class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 transition"
                        disabled="@busy"
                        @onclick="() => contactToDelete = null">
                    Cancel
                </button>
                <button type="button"
                        class="rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs transition"
                        disabled="@busy"
                        @onclick="ExecuteDeleteAsync">
                    Remove Contact
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int IndividualId { get; set; }

    private List<StaffEmergencyContactDto> contacts = new();
    private bool busy;
    private bool saving;
    private string? globalError;
    private string? modalError;

    private bool showModal;
    private bool isEditing;
    private int editingContactId;
    private StaffEmergencyContactInputDto model = new();
    private string customRelationship = string.Empty;
    private StaffEmergencyContactDto? contactToDelete;

    private readonly string[] relationshipOptions = new[]
    {
        "Spouse",
        "Parent",
        "Sibling",
        "Child",
        "Relative",
        "Friend",
        "Colleague",
        "Guardian",
        "Other"
    };

    protected override async Task OnParametersSetAsync()
    {
        await LoadContactsAsync();
    }

    private async Task LoadContactsAsync()
    {
        if (IndividualId <= 0) return;
        busy = true;
        globalError = null;
        try
        {
            var res = await ContactService.GetContactsAsync(IndividualId);
            contacts = res ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load emergency contacts for individual {Id}", IndividualId);
            globalError = "Unable to load emergency contacts: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        editingContactId = 0;
        model = new StaffEmergencyContactInputDto
        {
            IndividualId = IndividualId,
            Relationship = "Spouse",
            IsPrimary = contacts.Count == 0
        };
        customRelationship = string.Empty;
        modalError = null;
        showModal = true;
    }

    private void OpenEditModal(StaffEmergencyContactDto contact)
    {
        isEditing = true;
        editingContactId = contact.Id;
        model = new StaffEmergencyContactInputDto
        {
            Id = contact.Id,
            IndividualId = contact.IndividualId,
            ContactName = contact.ContactName,
            Relationship = contact.Relationship,
            PrimaryPhone = contact.PrimaryPhone,
            SecondaryPhone = contact.SecondaryPhone,
            Email = contact.Email,
            Address = contact.Address,
            IsPrimary = contact.IsPrimary,
            Notes = contact.Notes
        };
        customRelationship = relationshipOptions.Contains(contact.Relationship) ? string.Empty : contact.Relationship;
        modalError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        modalError = null;
    }

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseModal();
        }
    }

    private async Task SaveContactAsync()
    {
        if (string.IsNullOrWhiteSpace(model.ContactName))
        {
            modalError = "Contact Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Relationship))
        {
            modalError = "Relationship is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.PrimaryPhone))
        {
            modalError = "Primary phone number is required.";
            return;
        }

        saving = true;
        modalError = null;
        try
        {
            model.IndividualId = IndividualId;
            model.Id = isEditing ? editingContactId : 0;

            var res = await ContactService.SaveContactAsync(model);
            if (res.Success)
            {
                Toasts.Success(res.Message);
                CloseModal();
                await LoadContactsAsync();
            }
            else
            {
                modalError = res.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save emergency contact");
            modalError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SetPrimaryAsync(int contactId)
    {
        busy = true;
        try
        {
            var res = await ContactService.SetPrimaryAsync(contactId, IndividualId);
            if (res.Success)
            {
                Toasts.Success("Primary emergency contact updated.");
                await LoadContactsAsync();
            }
            else
            {
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed setting primary emergency contact {ContactId}", contactId);
            Toasts.Error("Error: " + ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private void ConfirmDeleteAsync(StaffEmergencyContactDto contact)
    {
        contactToDelete = contact;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (contactToDelete == null) return;
        var toDeleteId = contactToDelete.Id;
        busy = true;
        try
        {
            var res = await ContactService.DeleteContactAsync(toDeleteId);
            if (res.Success)
            {
                Toasts.Success("Contact removed successfully.");
                contactToDelete = null;
                await LoadContactsAsync();
            }
            else
            {
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete contact {ContactId}", toDeleteId);
            Toasts.Error("Error: " + ex.Message);
        }
        finally
        {
            busy = false;
        }
    }
}
