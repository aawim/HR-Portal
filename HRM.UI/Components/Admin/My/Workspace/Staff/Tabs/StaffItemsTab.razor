@namespace HRM.Components.Admin.My.Workspace.Staff.Tabs

<section class="w-full min-w-0 flex flex-col gap-3">
    <div class="w-full border-b border-slate-200 dark:border-slate-800 overflow-x-auto">
        <nav class="flex items-end gap-1.5 min-w-max" aria-label="Staff Items Tabs">
            <button type="button"
                    class="rounded-t-lg px-3.5 py-1.5 font-semibold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(!showPersonal ? "bg-blue-600 text-white border-blue-600 shadow-2xs" : "bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700")"
                    @onclick="() => showPersonal = false">
                <i class="bi bi-box-seam text-[11px]" aria-hidden="true"></i>
                <span>Job Items</span>
            </button>
            <button type="button"
                    class="rounded-t-lg px-3.5 py-1.5 font-semibold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(showPersonal ? "bg-blue-600 text-white border-blue-600 shadow-2xs" : "bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700")"
                    @onclick="() => showPersonal = true">
                <i class="bi bi-bag text-[11px]" aria-hidden="true"></i>
                <span>Personal Items</span>
            </button>
        </nav>
    </div>

    @if (!showPersonal)
    {
        <HRM.Components.Admin.Hr.Items.StaffItemRequestPanel @key="@($"job-{IndividualId}")" IndividualId="IndividualId" JobRelatedOnly="true" />
    }
    else
    {
        <HRM.Components.Admin.Hr.Items.StaffItemRequestPanel @key="@($"personal-{IndividualId}")" IndividualId="IndividualId" PersonalItemsOnly="true" />
    }
</section>

@code {
    [Parameter] public int IndividualId { get; set; }
    [Parameter] public bool InitialPersonal { get; set; }

    private bool showPersonal;
    private bool initialized;

    protected override void OnParametersSet()
    {
        if (!initialized)
        {
            showPersonal = InitialPersonal;
            initialized = true;
        }
    }
}
