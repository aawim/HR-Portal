@using HRM.Components.Admin.My.Workspace.Staff.Tabs.LeaveAssignmentManagerComponent
@using HRM.DTOs
@using HRM.DTOs.Leave
@using HRM.DTOs.LeaveTypes
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.JobLeaveTypes
@using HRM.Services.Interfaces.LeaveType
@using HRM.Services.Interfaces.Leave

@inject HRM.Application.Contracts.Pages.ILeaveApplications LeaveService
@inject IJobLeaveTypeService JobLeaveTypeService
@inject ToastService ToastService
@inject ILeaveTypeCatalogueService Catalogue;
@if (loadError != null)
{
    <div role="alert" class="mb-3 rounded-lg border p-3 text-sm">@loadError <button type="button" class="inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" disabled="@isLoading" @onclick="LoadAsync">Retry</button></div>
}
<div class="grid grid-cols-12 gap-2 p-2">

    <!-- Assigned -->
    <!-- Assigned Leave Types -->
    <div class="col-span-12 lg:col-span-3">

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm h-full flex flex-col">

            <!-- Header -->
            <div class="px-4 py-3 border-b border-slate-100 min-h-[4.5rem] flex flex-col justify-center">

                <h3 class="font-semibold text-slate-800">
                    Assigned Leave Types
                </h3>

                <p class="text-xs text-slate-500 mt-1">
                    @assigned.Count assigned
                </p>

            </div>

            <!-- Search -->
            <div class="p-2 border-b border-slate-100">

                <input class="w-full rounded-lg border border-slate-300
                           px-2.5 py-1.5 text-xs
                           focus:outline-none
                           focus:ring-2
                           focus:ring-blue-500"
                placeholder="Search..."
                @bind="assignedSearch"
                @bind:event="oninput" />

            </div>

            <!-- List -->
            <div class="max-h-[550px] overflow-y-auto divide-y divide-slate-100 flex-1">

                @if (assigned.Count == 0)
                {
                    <div class="py-8 text-center text-xs text-slate-500">
                        No assigned leave types.
                    </div>
                }
                else
                {
                    @foreach (var item in assigned
                    .Where(x => string.IsNullOrWhiteSpace(assignedSearch)
                    || x.LeaveTypeName.Contains(assignedSearch,
                    StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="p-2.5 cursor-pointer transition
                                @(selectedAssigned?.JobLeaveTypeId == item.JobLeaveTypeId
                                    ? "bg-blue-50 border-l-4 border-blue-600"
                                    : "hover:bg-slate-50")"
                        @onclick="() => SelectAssigned(item)">

                            <div class="flex justify-between items-center gap-2">

                                <div class="min-w-0 flex-1">

                                    <div class="font-medium text-xs text-slate-800 truncate">
                                        🌴 @item.LeaveTypeName
                                    </div>

                                    <div class="text-[11px] text-slate-500 mt-0.5">

                                        Remaining
                                        <span class="font-semibold text-emerald-600">
                                            @item.RemainingDays
                                        </span>

                                        days

                                    </div>

                                    <div class="text-[10px] text-slate-400 mt-0.5">
                                        @(item.EffectiveFromDate?.ToString("yyyy-MM-dd") ?? "—") - @(item.EffectiveToDate?.ToString("yyyy-MM-dd") ?? "—")
                                    </div>

                                </div>

                                <div class="flex flex-col items-end gap-1 shrink-0">
                                    @if (item.IsValid)
                                    {
                                        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-700">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-700">
                                            Inactive
                                        </span>
                                    }

                                    @if (item.IsLeaveInfoUpdated)
                                    {
                                        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200">
                                            Updated
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                            Expired
                                        </span>
                                    }
                                </div>

                            </div>

                        </div>
                    }
                }

            </div>

        </div>

    </div>
    <!-------------------------------------Assigned Leave Types-------------------------------- >


    <!-- Details -->
    <div class="col-span-12 lg:col-span-6">

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm h-full flex flex-col">

            <!-- Header -->
            <div class="px-4 py-3 border-b border-slate-100 min-h-[4.5rem] flex flex-col justify-center">

                <h3 class="font-semibold text-slate-800">
                    Leave Type Details
                </h3>

                <p class="text-xs text-slate-500 mt-1">
                    Update the selected leave assignment.
                </p>

            </div>

            @if (selectedAssigned == null)
            {
                <div class="h-[550px] flex flex-col items-center justify-center text-slate-400 p-4 text-center">

                    <div class="text-4xl mb-2">
                        👈
                    </div>

                    <div class="text-sm font-semibold text-slate-700">
                        Select a leave type
                    </div>

                    <div class="text-xs text-slate-500 mt-1">
                        Choose one from the Assigned list to inspect or modify.
                    </div>

                </div>
            }
            else
            {
                <div class="p-2 space-y-2">

                    <!-- Leave Type -->
                    <div>

                        <label class="block text-xs font-semibold text-slate-600 mb-1">
                            Leave Type
                        </label>

                        <input class="w-full rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1.5 text-xs text-slate-800"
                               value="@selectedAssigned.LeaveTypeName"
                               readonly />

                    </div>

                    <!-- Dates -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">

                        <div>

                            <label class="block text-xs font-semibold text-slate-600 mb-1">
                                Effective From
                            </label>

                            <InputDate class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs text-slate-800"
                                       @bind-Value="selectedAssigned.EffectiveFromDate" />

                        </div>

                        <div>

                            <label class="block text-xs font-semibold text-slate-600 mb-1">
                                Effective To
                            </label>

                            <InputDate class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs text-slate-800"
                                       @bind-Value="selectedAssigned.EffectiveToDate" />

                        </div>

                    </div>

                    <!-- Balances -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">

                        <div>

                            <label class="block text-xs font-semibold text-slate-600 mb-1">
                                Remaining Days
                            </label>

                            <InputNumber class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs text-slate-800"
                                         @bind-Value="selectedAssigned.RemainingDays" />

                        </div>

                    </div>

                    <!-- Status -->
                    <div class="flex items-center gap-2 pt-1">

                        <InputCheckbox class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind-Value="selectedAssigned.IsValid" />

                        <span class="text-xs font-medium text-slate-700">
                            Active Leave Type
                        </span>

                    </div>

                    <!-- Buttons -->
                    <div class="border-t border-slate-100 pt-2 flex justify-end gap-2">

                        <button type="button"
                                class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 transition"
                                @onclick="RemoveSelected">
                            Remove
                        </button>

                        <button type="button"
                                class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700 transition"
                                @onclick="SaveSelected">
                            Save Changes
                        </button>

                    </div>

                </div>
            }

        </div>

    </div>

    <!-- Available Leave Types -->
    <div class="col-span-12 lg:col-span-3">

        <AvailableLeaveTypes Types="@availableTypes"
                            IsProcessing="@assigningDefinition"
                            OnAssign="AssignLeaveTypeAsync" />

    </div>
    <!-------------------------------------Available Leave Types-------------------------------------------- -->
</div>




@code {

    private List<LeaveTypeCatalogueDto> availableTypes = new();


    private bool assigningDefinition;
    [Parameter]
    public int StaffId { get; set; }

    public int JobId;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool isLoading;
    private string? loadError;

    private List<JobLeaveTypeDto> assigned = new();



    private JobLeaveTypeDto? selectedAssigned;



    private string assignedSearch = "";





    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private void SelectAssigned(JobLeaveTypeDto item)
    {
        selectedAssigned = item;

    }



    private async Task SaveSelected()
    {
        if (selectedAssigned == null)
            return;

        var dto = new JobLeaveTypeEditDto
            {
                JobLeaveTypeId = selectedAssigned.JobLeaveTypeId,

                RemainingDays = selectedAssigned.RemainingDays,

                EffectiveFromDate =
                selectedAssigned.EffectiveFromDate,

                EffectiveToDate =
                selectedAssigned.EffectiveToDate,

                IsValid =
                selectedAssigned.IsValid,

                IsLeaveInfoUpdated = selectedAssigned.IsLeaveInfoUpdated
            };


        var result =
            await JobLeaveTypeService.UpdateAsync(dto);


        if (!result.Success)
        {
            ToastService.Error("Leave Type Not Updated!.");
            return;
        }
        ToastService.Success("Leave Type Updated!.");

        await LoadAsync();

        // optional:
        selectedAssigned =
            assigned.FirstOrDefault(x =>
                x.JobLeaveTypeId == dto.JobLeaveTypeId);
    }





    private void RemoveSelected()
    {
        if (selectedAssigned == null)
            return;

        // TODO
    }



    private async Task AssignLeaveTypeAsync(
       LeaveTypeCatalogueDto definition)
    {
        if (assigningDefinition)
            return;

        try
        {
            assigningDefinition = true;

            var dto = new AssignLeaveTypeCatalogueDto
                {
                    JobId = JobId,
                    LeaveTypeId =
                            definition.LeaveTypeId,

                    EffectiveFromDate = DateTime.Today,
                    EffectiveToDate = null
                };

            var result =
                await JobLeaveTypeService.AssignAsync(dto);

            if (!result.Success)
            {
                ToastService.Error(
                    result.Message ??
                    "Unable to assign leave definition.");

                return;
            }

            ToastService.Success(
                "Leave definition assigned successfully.");

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(
                "An unexpected error occurred while assigning " +
                "the leave definition.");

            Console.Error.WriteLine(ex);
        }
        finally
        {
            assigningDefinition = false;
        }
    }



    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        assigned = []; availableTypes = [];

        try
        {

  

        JobId = await LeaveService.GetJobIdByStaffId(StaffId);
        if(JobId <= 0) throw new InvalidOperationException("This staff member has no active approved job in the current organisation.");
        assigned = await JobLeaveTypeService.GetEntitlementsAsync(JobId);


 
        availableTypes = (await Catalogue.GetAvailableAsync()).Where(t => !assigned.Any(a => a.LeaveTypeId == t.LeaveTypeId)).ToList();

            
             

        isLoading = false;

        }
        catch (Exception ex)
        {
            loadError = ex is UnauthorizedAccessException ? "You do not have access to this staff member's leave assignments in the current organisation."
                : ex is InvalidOperationException ? ex.Message : "Unable to load staff leave information. Please try Retry.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }

    }



    private string GetLeaveIcon(string name)
    {
        name = name.ToLower();

        if (name.Contains("annual")) return "🌴";
        if (name.Contains("medical")) return "🏥";
        if (name.Contains("maternity")) return "👶";
        if (name.Contains("study")) return "🎓";
        if (name.Contains("marriage")) return "💍";
        if (name.Contains("pilgrimage")) return "🕌";

        return "📄";
    }

}
