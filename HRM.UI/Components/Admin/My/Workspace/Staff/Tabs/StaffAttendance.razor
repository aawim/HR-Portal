@using HRM.DTOs.Attendance
@using HRM.Components.Pages.Online.Dashboard
@inject HRM.Services.Interfaces.IAttendanceService Attendance

<section class="w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100" aria-label="Selected employee attendance">
    @if (!ReadOnly)
    {
        <HRM.Components.Shared.WeeklyHoursReview StaffId="StaffId" />
    }

    <!-- Compact Section Header (no background/border) -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 pt-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Attendance Records</h3>
                @if (!loading && error == null)
                {
                    <span class="inline-flex items-center rounded-full border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/50 px-2 py-0.5 text-[10px] font-semibold text-teal-800 dark:text-teal-300">
                        @periodFrom.ToString("dd MMM yyyy") – @periodTo.ToString("dd MMM yyyy")
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Attendance records, daily hours, shift duty, and raw clock events.</p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            @if (!loading && error == null)
            {
                <HRM.Components.Shared.AttendanceExportButtons CreateReport="BuildExport" Disabled="@loading" />
            }
            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    disabled="@loading"
                    @onclick="LoadAsync">
                <AppIcon Name="refresh" Class="@(loading ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
        </div>
    </header>

    <!-- Enterprise Filter & Inline KPI Bar -->
    @if (!ExternalDateFilters || (!loading && error == null))
    {
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-2.5 flex flex-wrap items-end justify-between gap-3">
            @if (!ExternalDateFilters)
            {
                <div class="flex flex-wrap items-end gap-2.5">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">From</label>
                        <InputDate @bind-Value="from" class="block h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">To</label>
                        <InputDate @bind-Value="to" class="block h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none" />
                    </div>
                    <button type="button"
                            class="app-button app-button-primary app-button-sm"
                            disabled="@loading"
                            @onclick="ApplyAsync">
                        Show records
                    </button>
                </div>
            }

            @if (!loading && error == null)
            {
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500 dark:text-slate-400">
                    @foreach (var stat in Stats)
                    {
                        <span class="inline-flex items-center gap-1.5">
                            <span class="h-1.5 w-1.5 rounded-full @GetStatDotClass(stat.Label)"></span>
                            <span>@stat.Label:</span>
                            <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@stat.Value</strong>
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (error != null)
    {
        <div role="alert" class="rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 px-3.5 py-2.5 text-xs text-rose-800 dark:text-rose-200">
            @error
        </div>
    }

    @if (loading)
    {
        <div role="status" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-xs text-slate-500 dark:text-slate-400">
            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
            <span>Loading attendance…</span>
        </div>
    }

    @if (ShowOverview)
    {
        <YearlyAttendanceGridCard Days="days" SelectedYear="year" YearChanged="ChangeYearAsync" IsLoading="loading" AllowYearChange="@(!ExternalDateFilters)" ShowExports="false" />
    }

    @if (!loading && error == null)
    {
        <!-- Explicit Responsive Two-Column Grid: Daily Attendance (Left) and Clock Events/Duty (Right) -->
        <div class="staff-att-grid">
            <!-- Left Column: Daily Attendance Table -->
            <div class="min-w-0 flex flex-col gap-3">
                <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
                            Daily Attendance
                        </h4>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                            @PeriodDays.Count() days
                        </span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-50/60 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider">
                                    <th class="px-3 py-2">Date</th>
                                    <th class="px-3 py-2">Status</th>
                                    <th class="px-3 py-2">Check In</th>
                                    <th class="px-3 py-2">Check Out</th>
                                    <th class="px-3 py-2 text-right">Worked</th>
                                    <th class="px-3 py-2 text-right">Duty</th>
                                    <th class="px-3 py-2 text-right">Events</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                @foreach (var day in PeriodDays.OrderByDescending(x => x.Date))
                                {
                                    <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                        <td class="whitespace-nowrap px-3 py-2 font-semibold text-slate-800 dark:text-slate-100">@day.Date.ToString("dd MMM · ddd")</td>
                                        <td class="px-3 py-2">
                                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @GetAttendanceBadgeClass(day)">@Status(day)</span>
                                        </td>
                                        <td class="whitespace-nowrap px-3 py-2 font-mono text-[11px] text-slate-700 dark:text-slate-300">@(day.FirstCheckIn?.ToString("HH:mm") ?? "—")</td>
                                        <td class="whitespace-nowrap px-3 py-2 font-mono text-[11px] text-slate-700 dark:text-slate-300">@(day.LastCheckOut?.ToString("HH:mm") ?? "—")</td>
                                        <td class="whitespace-nowrap px-3 py-2 text-right font-semibold text-slate-900 dark:text-slate-100 tabular-nums">@day.WorkedHours.ToString("0.##")h</td>
                                        <td class="whitespace-nowrap px-3 py-2 text-right text-slate-600 dark:text-slate-400 tabular-nums">@day.DutyWorkedHours.ToString("0.##")h</td>
                                        <td class="whitespace-nowrap px-3 py-2 text-right font-mono text-[11px] text-slate-600 dark:text-slate-400">@day.ClockEventCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!PeriodDays.Any())
                    {
                        <p class="p-6 text-center text-xs text-slate-500 dark:text-slate-400">No attendance days in this employment period.</p>
                    }
                </div>
            </div>

            <!-- Right Column: Required Shift/Duty & Clock Events Log -->
            <div class="min-w-0 flex flex-col gap-3">
                @if (ShowDutyAttendance)
                {
                    var requiredDuties = dutyAttendance.Where(d => d.IsShiftOrDuty && d.RequiresAttendance).ToList();
                    <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                        <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                            <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Required Shift / Duty</h4>
                            <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@requiredDuties.Count</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full whitespace-nowrap text-left text-xs">
                                <thead>
                                    <tr class="bg-slate-50/60 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider">
                                        <th class="px-3 py-2">Date</th>
                                        <th class="px-3 py-2">Schedule</th>
                                        <th class="px-3 py-2">Status</th>
                                        <th class="px-3 py-2 text-right">Credited</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                    @foreach (var duty in requiredDuties)
                                    {
                                        <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="px-3 py-2 font-semibold text-slate-800 dark:text-slate-100">@duty.Date.ToString("dd MMM")</td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300 truncate max-w-[140px]" title="@duty.Purpose · @duty.Name">@duty.Purpose · @duty.Name</td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@DutyStatus(duty)</td>
                                            <td class="px-3 py-2 text-right font-semibold tabular-nums">@duty.CreditedMinutes m</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (requiredDuties.Count == 0)
                        {
                            <p class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">No required shift/duty assignments for this period.</p>
                        }
                    </div>
                }

                <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Clock Events Log</h4>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                            @events.Count events
                        </span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-50/60 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider">
                                    <th class="px-3 py-2">Time</th>
                                    <th class="px-3 py-2">Event</th>
                                    <th class="px-3 py-2">Schedule / Method</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                @foreach (var entry in events.Take(100))
                                {
                                    <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                        <td class="whitespace-nowrap px-3 py-2 font-mono text-[11px] text-slate-800 dark:text-slate-200">@entry.Time.ToString("dd MMM HH:mm:ss")</td>
                                        <td class="px-3 py-2">
                                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @(entry.Event.Contains("In", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")">
                                                @entry.Event
                                            </span>
                                        </td>
                                        <td class="px-3 py-2 text-xs text-slate-600 dark:text-slate-300 truncate max-w-[180px]" title="@(entry.SharedScheduleSummary ?? entry.Schedule)">
                                            @(entry.SharedScheduleSummary ?? entry.Schedule)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (events.Count == 0)
                    {
                        <p class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">No clock events for this date range.</p>
                    }
                    @if (events.Count > 100)
                    {
                        <p class="p-2.5 text-center text-[11px] text-slate-400 border-t border-slate-100 dark:border-slate-800">Showing first 100 of @events.Count events</p>
                    }
                </div>
            </div>
        </div>
    }
</section>

<style>
    .staff-att-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
    }

    @@media (min-width: 1024px) {
        .staff-att-grid {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        }
    }
</style>

@code {
    private AttendanceExportReport BuildExport()
    {
        var tables = new List<AttendanceExportTable> { AttendanceReportExport.Daily(PeriodDays),
            new("Clock events", ["Date and time", "Event", "Schedule"], events.Select(e => new object?[] { e.Time.ToString("yyyy-MM-dd HH:mm:ss"), e.Event, e.Schedule }).ToList()) };
        if (ShowDutyAttendance) tables.Add(new("Required shift duty", ["Date", "Schedule", "Scheduled in", "Scheduled out", "Status", "Check in", "Check out"],
            dutyAttendance.Where(d => d.IsShiftOrDuty && d.RequiresAttendance).Select(d => new object?[] { d.Date.ToString("yyyy-MM-dd"), $"{d.Purpose} · {d.Name}",
                d.ScheduledStart.ToString("yyyy-MM-dd HH:mm"), d.ScheduledEnd.ToString("yyyy-MM-dd HH:mm"), DutyStatus(d), d.CheckIn?.ToString("HH:mm"), d.CheckOut?.ToString("HH:mm") }).ToList()));
        return new("Employee attendance", $"{(StaffName ?? $"Employee ID {StaffId}")} · {periodFrom:dd MMM yyyy} – {periodTo:dd MMM yyyy}" +
            (events.Count == 1000 ? " · Clock events limited to latest 1,000; narrow the period for other events." : ""), tables);
    }
    [Parameter] public bool ReadOnly {get;set;}
    [Parameter] public string? StaffName { get; set; }
    [Parameter] public int StaffId { get; set; }
    [Parameter] public DateTime? InitialFrom { get; set; }
    [Parameter] public DateTime? InitialTo { get; set; }
    [Parameter] public bool ExternalDateFilters { get; set; }
    [Parameter] public bool ShowOverview { get; set; } = true;
    [Parameter] public bool ShowDutyAttendance { get; set; }
    private (int Staff, DateTime? From, DateTime? To, bool Duty)? loadedSelection;
    private List<StaffScheduleAttendanceDto> dutyAttendance = [];
    static DateTime Today => DateTime.UtcNow.AddHours(5).Date;
    int loadedStaff, year = Today.Year, version; bool loading; string? error;
    DateTime from = new(Today.Year, Today.Month, 1), to = Today, periodFrom, periodTo;
    List<YearlyAttendanceDayDto> days = []; List<StaffAttendanceClockEventDto> events = [];
    IEnumerable<YearlyAttendanceDayDto> PeriodDays => days.Where(x => x.Date >= periodFrom && x.Date <= periodTo);
    IEnumerable<(string Label, string Value)> Stats => new[] { ("Present", PeriodDays.Count(x => x.IsPresent).ToString()), ("Absent", PeriodDays.Count(x => x.IsAbsent).ToString()), ("Leave", PeriodDays.Count(x => x.IsOnLeave).ToString()), ("Rest days", PeriodDays.Count(x => x.IsRestDay).ToString()), ("Worked hours", PeriodDays.Sum(x => x.WorkedHours).ToString("0.##")) };
    protected override async Task OnParametersSetAsync()
    {
        var selection = (StaffId, InitialFrom, InitialTo, ShowDutyAttendance);
        if (loadedSelection == selection) return;
        loadedSelection = selection;
        loadedStaff = StaffId;
        from = InitialFrom?.Date ?? new(Today.Year, Today.Month, 1);
        to = InitialTo?.Date ?? Today;
        year = from.Year;
        await LoadAsync();
    }
    async Task ChangeYearAsync(int value) { year = value; from = new(value, 1, 1); to = value == Today.Year ? Today : new(value, 12, 31); await LoadAsync(); }
    async Task ApplyAsync() { if(from > to || from.Year != to.Year || from.Year < 2000 || to > Today) { error = "Choose dates in the same year, from 2000 through today."; return; } year = from.Year; await LoadAsync(); }
    async Task LoadAsync() {
        var request = ++version; var staff = StaffId; var selectedFrom = from; var selectedTo = to; loading = true; error = null; days = []; events = [];
        try {
            if(selectedFrom > selectedTo || selectedFrom.Year != selectedTo.Year || selectedFrom.Year != year || selectedTo > Today) throw new InvalidOperationException("Choose a valid date range within the selected year, through today.");
            var result = await Attendance.GetStaffYearlyAttendanceAsync(staff, year);
            var clock = await Attendance.GetStaffClockEventsAsync(staff, selectedFrom, selectedTo);
            var duties = ShowDutyAttendance ? await Attendance.GetStaffScheduleAttendanceAsync(staff, selectedFrom, selectedTo) : new List<StaffScheduleAttendanceDto>();
            if(request == version) { days = result; events = clock; dutyAttendance = duties; periodFrom = selectedFrom.Date; periodTo = selectedTo.Date; }
        }
        catch(UnauthorizedAccessException) { if(request == version) error = "You do not have access to this employee's attendance in the current organisation."; }
        catch(InvalidOperationException ex) { if(request == version) error = ex.Message; }
        catch(Exception) { if(request == version) error = "Attendance could not be loaded. Please try Refresh."; }
        finally { if(request == version) loading = false; }
    }
    static string Status(YearlyAttendanceDayDto day) => HRM.Helpers.AttendancePresentation.Status(day);
    private string DutyStatus(StaffScheduleAttendanceDto duty)
    {
        var day = days.FirstOrDefault(d => d.Date.Date == duty.Date.Date);
        if (day?.IsOnLeave == true) return $"Leave · {day.LeaveTypeName}";
        if (day?.HasApprovedPosition != true || !day.HasActiveSchedule) return day?.EligibilityMessage ?? "Attendance not required";
        if (duty.CheckIn.HasValue)
        {
            var minutes = HRM.Helpers.AttendanceTiming.LateMinutes(duty.CheckIn.Value, duty.ScheduledStart);
            return HRM.Helpers.AttendancePresentation.Attended(minutes > 0, minutes, duty.CheckOut >= duty.CheckIn && duty.CheckOut >= duty.ScheduledEnd);
        }
        return DateTime.UtcNow.AddHours(5) > duty.ScheduledStart ? "Missing check in" : "Upcoming";
    }

    private static string GetStatDotClass(string label) => label switch
    {
        "Present" => "bg-teal-500",
        "Absent" => "bg-rose-500",
        "Leave" => "bg-emerald-500",
        "Rest days" => "bg-slate-400",
        _ => "bg-blue-500"
    };

    private static string GetAttendanceBadgeClass(YearlyAttendanceDayDto day)
    {
        if (day.IsOnLeave) return "bg-emerald-50 text-emerald-800 border border-emerald-200";
        if (day.IsLate) return "bg-amber-50 text-amber-800 border border-amber-200";
        if (day.IsPresent) return "bg-teal-50 text-teal-800 border border-teal-200";
        if (day.IsRestDay) return "bg-slate-100 text-slate-600 border border-slate-200";
        if (day.IsAbsent) return "bg-rose-50 text-rose-800 border border-rose-200";
        return "bg-slate-100 text-slate-600 border border-slate-200";
    }
}
