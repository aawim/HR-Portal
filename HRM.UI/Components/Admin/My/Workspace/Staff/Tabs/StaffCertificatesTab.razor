@namespace HRM.Components.Admin.My.Workspace.Staff.Tabs
@using HRM.DTOs.Certificates
@using HRM.Helpers
@using HRM.Services
@using HRM.Services.Contracts
@using Microsoft.JSInterop
@rendermode RenderMode.InteractiveServer

@inject CertificateServiceContracts.IOperations CertificateService
@inject ToastService Toasts
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@inject ILogger<StaffCertificatesTab> Logger

<div class="w-full p-2 flex flex-col gap-3">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 flex-wrap gap-2">
        <div>
            <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Employment &amp; Work Experience Certificates</h3>
                @if (pendingRequests.Count > 0)
                {
                    <span class="rounded-full bg-amber-100 text-amber-800 border border-amber-300 px-2 py-0.5 text-[10px] font-bold">
                        @pendingRequests.Count Pending Action
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Manage officially issued service certificates, experience credentials, and pending requests for this staff member.</p>
        </div>

        <div class="flex items-center gap-2">
            <span class="rounded bg-teal-50 dark:bg-teal-950 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800 px-2 py-0.5 text-xs font-semibold">
                Staff #@StaffId
            </span>
            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition"
                    disabled="@isLoading"
                    @onclick="LoadStaffCertificatesAsync">
                <span>↻ Refresh</span>
            </button>
            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-teal-800 transition"
                    @onclick="() => showIssueModal = true">
                + Issue Certificate On-Demand
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-8 text-center text-xs text-slate-500">
            Loading employee certificate records...
        </div>
    }
    else
    {
        <!-- PENDING REQUESTS FOR THIS EMPLOYEE -->
        @if (pendingRequests.Count > 0)
        {
            <div class="rounded-2xl border border-amber-300 bg-amber-50/70 dark:bg-amber-950/30 dark:border-amber-800 p-4 flex flex-col gap-3 shadow-xs">
                <div class="flex items-center justify-between flex-wrap gap-2 border-b border-amber-200/80 dark:border-amber-800/60 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        <span class="font-bold text-xs text-amber-950 dark:text-amber-200">Pending Certificate Requests (@pendingRequests.Count)</span>
                    </div>
                    <span class="rounded-full bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200 px-2.5 py-0.5 text-[10px] font-bold">
                        Awaiting HR Verification &amp; Approval
                    </span>
                </div>

                <div class="divide-y divide-amber-200/60 dark:divide-amber-800/60">
                    @foreach (var req in pendingRequests)
                    {
                        var isInspecting = selectedReviewDetail?.Summary.CertificateRequestId == req.CertificateRequestId;
                        <div class="py-3 flex flex-col gap-3 text-xs">
                            <div class="flex items-start justify-between flex-wrap gap-2">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="font-mono font-bold text-blue-700 dark:text-blue-400">@req.ReferenceNumber</span>
                                        <span class="rounded-md bg-white dark:bg-slate-800 border border-amber-200 dark:border-slate-700 px-2 py-0.5 font-bold text-slate-900 dark:text-slate-100">
                                            @(req.CertificateType == "DetailedExperience" ? "Detailed Work Experience Certificate" : "Standard Service Certificate")
                                        </span>
                                        <span class="rounded-full bg-amber-200/80 text-amber-900 px-2 py-0.5 font-bold text-[10px]">
                                            @req.Status
                                        </span>
                                        <span class="text-[11px] text-slate-500">
                                            Submitted @req.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        </span>
                                    </div>
                                    <div class="text-slate-700 dark:text-slate-300 flex flex-wrap gap-x-4 gap-y-1">
                                        <span><strong>Purpose:</strong> @req.Purpose</span>
                                        <span><strong>Scope:</strong> @req.RequestScope</span>
                                        <span><strong>Addressed To:</strong> @(string.IsNullOrWhiteSpace(req.AddressedTo) ? "To Whom It May Concern" : req.AddressedTo)</span>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2 flex-wrap">
                                    <button type="button"
                                            class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 transition"
                                            @onclick="() => ToggleInspectRequestAsync(req.CertificateRequestId)">
                                        @(isInspecting ? "Hide Review Panel" : "🔍 Review & Preview")
                                    </button>
                                    <button type="button"
                                            class="rounded-lg bg-teal-700 hover:bg-teal-800 px-3 py-1.5 text-xs font-bold text-white shadow-xs transition disabled:opacity-50"
                                            disabled="@isSubmitting"
                                            @onclick="() => QuickApproveAsync(req.CertificateRequestId)">
                                        ✓ Approve &amp; Issue
                                    </button>
                                </div>
                            </div>

                            @if (isInspecting && selectedReviewDetail != null)
                            {
                                <div class="rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 p-4 space-y-3 shadow-xs">
                                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
                                        <div>
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400 block">HR Verification &amp; Approval Review</span>
                                            <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                                                @selectedReviewDetail.EmploymentHistory.FullName (#@selectedReviewDetail.EmploymentHistory.EmployeeNumber) — @selectedReviewDetail.EmploymentHistory.CurrentJobTitle
                                            </h4>
                                        </div>
                                        <span class="text-[11px] text-slate-500">
                                            Service Duration: <strong>@selectedReviewDetail.EmploymentHistory.FormattedServiceDuration</strong>
                                        </span>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                        <div>
                                            <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Addressed To</label>
                                            <input type="text" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs" @bind="reviewAddressedTo" />
                                        </div>
                                        <div>
                                            <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Authorised Signatory Name</label>
                                            <input type="text" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs" @bind="reviewSignatoryName" placeholder="e.g. Director of Human Resources" />
                                        </div>
                                        <div>
                                            <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Signatory Title</label>
                                            <input type="text" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs" @bind="reviewSignatoryTitle" placeholder="Human Resources Department" />
                                        </div>
                                    </div>

                                    <div class="flex flex-wrap items-center gap-4 pt-1">
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                            <input type="checkbox" @bind="reviewIncludeResp" class="rounded text-teal-600" />
                                            <span>Include verified responsibilities (@selectedReviewDetail.EmploymentHistory.Positions.Count positions)</span>
                                        </label>
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                            <input type="checkbox" @bind="reviewIncludeProj" class="rounded text-teal-600" />
                                            <span>Include project experience (@selectedReviewDetail.EmploymentHistory.Projects.Count projects)</span>
                                        </label>
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                            <input type="checkbox" @bind="reviewIncludeSalary" class="rounded text-teal-600" />
                                            <span>Include basic salary</span>
                                        </label>
                                    </div>

                                    <!-- Draft Certificate Statement Preview -->
                                    <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 p-3 space-y-1.5 text-[11px] text-slate-700 dark:text-slate-300">
                                        <div class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">
                                            Draft Preview — @selectedReviewDetail.CurrentDraftSnapshot.CertificateTitle
                                        </div>
                                        <p>@selectedReviewDetail.CurrentDraftSnapshot.IntroductoryText</p>
                                        <p>@selectedReviewDetail.CurrentDraftSnapshot.ServiceStatement</p>
                                        <p>@selectedReviewDetail.CurrentDraftSnapshot.ConcludingText</p>
                                    </div>

                                    <div>
                                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">HR Review Remarks / Clarification or Rejection Reason</label>
                                        <textarea rows="2" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs" placeholder="Required if returning for clarification or rejecting..." @bind="reviewReason"></textarea>
                                    </div>

                                    <div class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 dark:border-slate-800 pt-2">
                                        <button type="button"
                                                class="rounded-lg border border-purple-300 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 text-xs font-semibold text-purple-800 transition disabled:opacity-50"
                                                disabled="@isSubmitting"
                                                @onclick='() => SubmitReviewDecisionAsync(req.CertificateRequestId, "Return")'>
                                            ↩ Return for Clarification
                                        </button>
                                        <button type="button"
                                                class="rounded-lg border border-rose-300 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-800 transition disabled:opacity-50"
                                                disabled="@isSubmitting"
                                                @onclick='() => SubmitReviewDecisionAsync(req.CertificateRequestId, "Reject")'>
                                            ✕ Reject Request
                                        </button>
                                        <button type="button"
                                                class="rounded-lg bg-emerald-600 hover:bg-emerald-700 px-4 py-1.5 text-xs font-bold text-white shadow-xs transition disabled:opacity-50"
                                                disabled="@isSubmitting"
                                                @onclick='() => SubmitReviewDecisionAsync(req.CertificateRequestId, "Issue")'>
                                            ✓ Verify, Approve &amp; Issue Official PDF
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ISSUED CERTIFICATES ARCHIVE -->
        @if (issuedCertificates.Count == 0 && allStaffRequests.Count == 0)
        {
            <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/40 p-8 text-center text-xs text-slate-500 dark:text-slate-400 space-y-3">
                <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                    <AppIcon Name="description" Class="h-6 w-6 text-2xl" />
                </div>
                <div>
                    <p class="font-semibold text-slate-800 dark:text-slate-200 text-sm">No Issued Certificates</p>
                    <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
                        No official service or experience certificates have been issued yet for this staff member. You can issue one on-demand using verified HRM records.
                    </p>
                </div>
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-teal-800 transition"
                        @onclick="() => showIssueModal = true">
                    + Issue Certificate
                </button>
            </div>
        }

        @if (issuedCertificates.Count > 0)
        {
            <div class="space-y-2">
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider block">Issued Official Certificates (@issuedCertificates.Count)</span>

                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-2.5">Certificate Ref</th>
                                <th class="p-2.5">Classification</th>
                                <th class="p-2.5">Issue Date</th>
                                <th class="p-2.5">Authorised Signatory</th>
                                <th class="p-2.5">Status</th>
                                <th class="p-2.5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var cert in issuedCertificates)
                            {
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                                    <td class="p-2.5 font-mono font-bold text-blue-700 dark:text-blue-400">@cert.CertificateNumber</td>
                                    <td class="p-2.5 font-medium text-slate-900 dark:text-slate-100">@cert.CertificateType</td>
                                    <td class="p-2.5 text-slate-600 dark:text-slate-400">@cert.IssueDate.ToString("dd MMM yyyy")</td>
                                    <td class="p-2.5 text-slate-600 dark:text-slate-400">@cert.SignatoryName</td>
                                    <td class="p-2.5">
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(cert.Status == "Active" ? "bg-emerald-100 text-emerald-800" : cert.Status == "Revoked" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                            @cert.Status
                                        </span>
                                    </td>
                                    <td class="p-2.5 text-right">
                                        <div class="inline-flex items-center gap-1.5">
                                            <a href="/verify/certificate/@cert.VerificationToken"
                                               target="_blank"
                                               class="rounded border border-slate-200 dark:border-slate-700 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50">
                                                Verify ↗
                                            </a>
                                            <button type="button"
                                                    class="rounded bg-teal-700 hover:bg-teal-800 px-2.5 py-1 text-[11px] font-semibold text-white transition flex items-center gap-1"
                                                    @onclick="() => DownloadPdfAsync(cert.IssuedCertificateId, cert.CertificateNumber)">
                                                <AppIcon Name="download" Class="w-3.5 h-3.5 text-sm" />
                                                <span>PDF</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (allStaffRequests.Count > 0)
        {
            <div class="space-y-2">
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider block">Certificate Request History (@allStaffRequests.Count)</span>

                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-2.5">Request Ref</th>
                                <th class="p-2.5">Certificate Type</th>
                                <th class="p-2.5">Purpose</th>
                                <th class="p-2.5">Submitted</th>
                                <th class="p-2.5">Status</th>
                                <th class="p-2.5">Issued Certificate #</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var req in allStaffRequests)
                            {
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                                    <td class="p-2.5 font-mono font-bold text-blue-700 dark:text-blue-400">@req.ReferenceNumber</td>
                                    <td class="p-2.5 font-medium text-slate-900 dark:text-slate-100">@req.CertificateType</td>
                                    <td class="p-2.5 text-slate-600 dark:text-slate-400">@req.Purpose</td>
                                    <td class="p-2.5 text-slate-600 dark:text-slate-400">@req.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="p-2.5">
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(req.Status == "Issued" ? "bg-emerald-100 text-emerald-800" : req.Status is "Submitted" or "UnderReview" ? "bg-amber-100 text-amber-800" : req.Status == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-slate-100 text-slate-700")">
                                            @req.Status
                                        </span>
                                    </td>
                                    <td class="p-2.5 font-mono text-slate-600 dark:text-slate-400">@(req.CertificateNumber ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- ISSUE CERTIFICATE MODAL -->
@if (showIssueModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4 backdrop-blur-xs">
        <div class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-5 shadow-xl flex flex-col gap-4 text-xs">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900">Issue Certificate for Staff #@StaffId</h3>
                <button type="button" class="text-slate-400 hover:text-slate-700 p-1" @onclick="() => showIssueModal = false">✕</button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Certificate Type *</label>
                    <select class="w-full rounded-lg border border-slate-300 p-2" @bind="newCertType">
                        <option value="StandardService">Standard Service Certificate</option>
                        <option value="DetailedExperience">Detailed Work Experience Certificate</option>
                    </select>
                </div>

                <div>
                    <label class="block font-semibold text-slate-800 p-1">Official Purpose *</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2" placeholder="e.g. Official Employment Verification" @bind="newPurpose" />
                </div>

                <div>
                    <label class="block font-semibold text-slate-800 p-1">Addressed To</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2" placeholder="TO WHOM IT MAY CONCERN" @bind="newAddressedTo" />
                </div>

                <div class="flex flex-wrap gap-3 pt-1">
                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" @bind="includeResp" class="rounded text-teal-600" />
                        <span>Include verified responsibilities</span>
                    </label>
                    <label class="inline-flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" @bind="includeProj" class="rounded text-teal-600" />
                        <span>Include project experience</span>
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                <button type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 font-semibold text-slate-700" @onclick="() => showIssueModal = false">
                    Cancel
                </button>
                <button type="button" class="rounded-lg bg-teal-700 hover:bg-teal-800 px-4 py-1.5 font-semibold text-white shadow-xs" disabled="@isSubmitting" @onclick="IssueOnDemandAsync">
                    @(isSubmitting ? "Generating..." : "Generate & Issue Certificate")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int StaffId { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool isLoading;
    private bool isSubmitting;
    private bool showIssueModal;

    private string newCertType = "StandardService";
    private string newPurpose = "Official Employment Verification";
    private string newAddressedTo = "TO WHOM IT MAY CONCERN";
    private bool includeResp = true;
    private bool includeProj = true;

    private List<CertificateRequestSummaryDto> allStaffRequests = [];
    private List<CertificateRequestSummaryDto> pendingRequests = [];
    private List<IssuedCertificateDetailDto> issuedCertificates = [];

    private CertificateRequestDetailDto? selectedReviewDetail;
    private string reviewAddressedTo = "TO WHOM IT MAY CONCERN";
    private string reviewSignatoryName = "";
    private string reviewSignatoryTitle = "Human Resources Department";
    private bool reviewIncludeResp = true;
    private bool reviewIncludeProj = true;
    private bool reviewIncludeSalary;
    private string reviewReason = "";

    protected override async Task OnParametersSetAsync()
    {
        await LoadStaffCertificatesAsync();
    }

    private async Task LoadStaffCertificatesAsync()
    {
        if (StaffId <= 0) return;
        isLoading = true;
        try
        {
            var allReqs = await CertificateService.GetAdminPendingRequestsAsync(statusFilter: "All");
            allStaffRequests = allReqs.Where(r => r.IndividualId == StaffId).ToList();
            pendingRequests = allStaffRequests.Where(r => r.Status == "Submitted" || r.Status == "UnderReview").ToList();

            var myIssued = await CertificateService.GetMyIssuedCertificatesAsync();
            issuedCertificates = myIssued.Where(c => c.IndividualId == StaffId).ToList();

            if (selectedReviewDetail != null && !pendingRequests.Any(r => r.CertificateRequestId == selectedReviewDetail.Summary.CertificateRequestId))
            {
                selectedReviewDetail = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed loading certificates for staff {StaffId}", StaffId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleInspectRequestAsync(int certificateRequestId)
    {
        if (selectedReviewDetail?.Summary.CertificateRequestId == certificateRequestId)
        {
            selectedReviewDetail = null;
            return;
        }

        try
        {
            var detail = await CertificateService.GetRequestDetailAsync(certificateRequestId);
            selectedReviewDetail = detail;
            reviewAddressedTo = detail.Summary.AddressedTo ?? "TO WHOM IT MAY CONCERN";
            reviewSignatoryName = detail.CurrentDraftSnapshot.SignatoryName;
            reviewSignatoryTitle = detail.CurrentDraftSnapshot.SignatoryTitle;
            reviewIncludeResp = detail.CurrentDraftSnapshot.Positions.Any(p => p.Responsibilities.Count > 0);
            reviewIncludeProj = detail.CurrentDraftSnapshot.Projects.Count > 0;
            reviewIncludeSalary = detail.CurrentDraftSnapshot.BasicSalary.HasValue;
            reviewReason = "";
        }
        catch (Exception ex)
        {
            Toasts.Error("Unable to load certificate request details: " + ex.Message);
        }
    }

    private async Task SubmitReviewDecisionAsync(int requestId, string action)
    {
        if (action is "Return" or "Reject" && string.IsNullOrWhiteSpace(reviewReason))
        {
            Toasts.Error($"Please provide a reason before selecting '{action}'.");
            return;
        }

        isSubmitting = true;
        try
        {
            var res = await CertificateService.ReviewActionAsync(new CertificateReviewActionInput
            {
                CertificateRequestId = requestId,
                Action = action,
                Reason = reviewReason,
                CorrectedAddressedTo = reviewAddressedTo,
                IncludeResponsibilities = reviewIncludeResp,
                IncludeProjects = reviewIncludeProj,
                IncludeSalary = reviewIncludeSalary,
                CorrectedSignatoryName = reviewSignatoryName,
                CorrectedSignatoryTitle = reviewSignatoryTitle
            });

            if (res.Success)
            {
                if (action == "Issue")
                {
                    await GenerateAndPersistPdfForRequestAsync(requestId);
                }
                Toasts.Success(res.Message);
                selectedReviewDetail = null;
                await LoadStaffCertificatesAsync();
                if (OnChanged.HasDelegate)
                {
                    await OnChanged.InvokeAsync();
                }
            }
            else
            {
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task QuickApproveAsync(int requestId)
    {
        isSubmitting = true;
        try
        {
            var res = await CertificateService.ReviewActionAsync(new CertificateReviewActionInput
            {
                CertificateRequestId = requestId,
                Action = "Issue"
            });
            if (res.Success)
            {
                await GenerateAndPersistPdfForRequestAsync(requestId);
                Toasts.Success("Certificate approved and issued.");
                await LoadStaffCertificatesAsync();
                if (OnChanged.HasDelegate)
                {
                    await OnChanged.InvokeAsync();
                }
            }
            else Toasts.Error(res.Message);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task GenerateAndPersistPdfForRequestAsync(int certificateRequestId)
    {
        try
        {
            var detail = await CertificateService.GetRequestDetailAsync(certificateRequestId);
            if (detail.IssuedCertificate != null)
            {
                var fontPath = Path.Combine(Environment.WebRootPath, "fonts", "Faruma.ttf");
                var pdfBytes = CertificatePdfGenerator.Generate(detail.IssuedCertificate.Snapshot, fontPath);
                await CertificateService.SaveIssuedCertificatePdfAsync(detail.IssuedCertificate.IssuedCertificateId, pdfBytes);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Deferred PDF generation for certificate request {RequestId}", certificateRequestId);
        }
    }

    private async Task IssueOnDemandAsync()
    {
        isSubmitting = true;
        try
        {
            var reqRes = await CertificateService.SubmitCertificateRequestAsync(new CertificateRequestInput
            {
                IndividualId = StaffId,
                CertificateType = newCertType,
                Purpose = newPurpose,
                AddressedTo = newAddressedTo,
                IncludeResponsibilities = includeResp,
                IncludeProjects = includeProj
            });

            if (reqRes.Success)
            {
                var allReqs = await CertificateService.GetAdminPendingRequestsAsync(statusFilter: "Pending");
                var latest = allReqs.FirstOrDefault(r => r.IndividualId == StaffId);
                if (latest != null)
                {
                    await CertificateService.ReviewActionAsync(new CertificateReviewActionInput
                    {
                        CertificateRequestId = latest.CertificateRequestId,
                        Action = "Issue"
                    });
                    await GenerateAndPersistPdfForRequestAsync(latest.CertificateRequestId);
                }
                Toasts.Success("Official certificate generated and issued.");
                showIssueModal = false;
                await LoadStaffCertificatesAsync();
                if (OnChanged.HasDelegate)
                {
                    await OnChanged.InvokeAsync();
                }
            }
            else
            {
                Toasts.Error(reqRes.Message);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error("Issuance failed: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DownloadPdfAsync(int issuedCertificateId, string certificateNumber)
    {
        try
        {
            var pdfBytes = await CertificateService.GetIssuedCertificatePdfAsync(issuedCertificateId);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                var snap = await CertificateService.GetCertificateSnapshotAsync(issuedCertificateId);
                var fontPath = Path.Combine(Environment.WebRootPath, "fonts", "Faruma.ttf");
                pdfBytes = CertificatePdfGenerator.Generate(snap, fontPath);
                await CertificateService.SaveIssuedCertificatePdfAsync(issuedCertificateId, pdfBytes);
            }

            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            using var stream = new MemoryStream(pdfBytes);
            using var reference = new DotNetStreamReference(stream);
            await module.InvokeVoidAsync("download", $"{certificateNumber}.pdf", "application/pdf", reference);
            Toasts.Success("Certificate downloaded.");
        }
        catch (Exception ex)
        {
            Toasts.Error("Failed downloading certificate: " + ex.Message);
        }
    }
}
