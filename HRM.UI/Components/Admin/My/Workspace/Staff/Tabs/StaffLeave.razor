@inject HRM.Application.Contracts.Pages.ILeaveApplications Leaves
@inject NavigationManager Navigation
@inject ILogger<StaffLeave> Logger

<section class="w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100" aria-label="Leave">
    <!-- Compact Header (no background/border) -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">@selected</h3>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Leave
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">@Actions.First(a => a.Title == selected).Description</p>
        </div>
    </header>

    <!-- Narrow Sub-Navigation Bar -->
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-1" role="tablist" aria-label="Leave actions">
            @foreach (var action in Actions)
            {
                var isSelected = selected == action.Title;
                <button type="button" role="tab" aria-selected="@isSelected"
                        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(isSelected ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                        @onclick="() => selected = action.Title">@action.Title</button>
            }
        </div>
        @if (selected == "New Leave Application" && jobs.Count > 1)
        {
            <div class="flex items-center gap-2 text-xs">
                <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-300">Employment:</span>
                <select class="h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none" @bind="jobId" @bind:after="ChooseJob" disabled="@state.IsSubmitting">
                    @foreach (var job in jobs) { <option value="@job.JobId">@job.Department · @job.JobType · Job @job.JobId</option> }
                </select>
            </div>
        }
    </div>

    @if (selected == "New Leave Application")
    {
        @if (!StaffId.HasValue)
        {
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 space-y-2">
                <p class="text-xs text-slate-500 dark:text-slate-400">Select the staff member you are applying for.</p>
                <HRM.Components.Admin.My.Workspace.WorkspaceSearch StaffOnly="true" OnSelected="SelectStaff" />
            </div>
        }
        else if (loading)
        {
            <div role="status" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-xs text-slate-500">
                <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
                <span>Loading staff leave information…</span>
            </div>
        }
        else if (error != null)
        {
            <div role="alert" class="rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 p-3 flex flex-wrap items-center justify-between gap-2 text-xs text-rose-800 dark:text-rose-200">
                <span>@error</span>
                <button type="button" class="app-button app-button-primary app-button-sm" @onclick="LoadAsync">Retry</button>
            </div>
        }
        else if (jobs.Count == 0)
        {
            <div role="status" class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center text-xs text-slate-500">
                No active employment record is available for this staff member in the current organisation.
            </div>
        }
        else
        {
            <HRM.Components.Pages.Online.Leave.NewLeave @key="jobId" LeaveState="state" HideHeader="true" />
        }
    }
    else if (selected == "Assign Leave Type")
    {
        @if (!StaffId.HasValue)
        {
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 space-y-2">
                <p class="text-xs text-slate-500 dark:text-slate-400">Select the staff member you are assigning leave types for.</p>
                <HRM.Components.Admin.My.Workspace.WorkspaceSearch StaffOnly="true" OnSelected="SelectStaff" />
            </div>
        }
        else
        {
            <LeaveAssignmentManager @key="StaffId.Value" StaffId="StaffId.Value" />
        }
    }
    else
    {
        <div role="status" class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center text-xs text-slate-500">
            This administration form is not available yet.
        </div>
    }
</section>

@code {
    [Parameter] public int? StaffId { get; set; }
    [Parameter] public string? Action { get; set; }
    private List<HRM.DTOs.Leave.LeaveApplicantJob> jobs = [];
    private HRM.Services.State.LeaveApplicationState state = new();
    private int jobId;
    private int? loadedStaffId;
    private bool loading;
    private string? error;

    protected override void OnInitialized()
    {
        ResolveActionFromUri();
    }

    protected override async Task OnParametersSetAsync()
    {
        ResolveActionFromUri();
        if (StaffId == loadedStaffId) return;
        loadedStaffId = StaffId;
        await LoadAsync();
    }

    private void ResolveActionFromUri()
    {
        if (!string.IsNullOrWhiteSpace(Action))
        {
            var matchedParam = Actions.FirstOrDefault(a => string.Equals(a.Title, Action, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(matchedParam.Title))
            {
                selected = matchedParam.Title;
                return;
            }
        }

        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("action", out var actionVal))
            {
                var match = Actions.FirstOrDefault(a =>
                    string.Equals(a.Title, actionVal, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a.Title.Replace(" ", "-"), actionVal, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a.Title.Replace(" ", ""), actionVal, StringComparison.OrdinalIgnoreCase));
                if (!string.IsNullOrEmpty(match.Title))
                {
                    selected = match.Title;
                }
            }
        }
        catch
        {
            // Ignore in test or non-standard URI contexts
        }
    }

    private async Task LoadAsync()
    {
        jobs = []; error = null;
        if (!StaffId.HasValue) return;
        loading = true;
        try
        {
            jobs = await Leaves.GetLeaveApplicantJobsAsync(StaffId.Value);
            jobId = jobs.FirstOrDefault()?.JobId ?? 0;
            ChooseJob();
        }
        catch (UnauthorizedAccessException ex) { error = ex.Message; }
        catch (Exception ex) { error = "Staff leave information could not be loaded. Please try again."; Logger.LogError(ex, "Loading delegated leave applicant {StaffId}", StaffId); }
        finally { loading = false; }
    }
    private void ChooseJob() => state = new HRM.Services.State.LeaveApplicationState
    {
        ApplicantJobId = jobId,
        Model = new HRM.DTOs.Leave.LeaveApplicationDto { JobId = jobId, FromDate = DateTime.UtcNow.AddHours(5).Date, Duration = 1 }
    };
    private void SelectStaff(HRM.DTOs.WorkspaceSearchResult staff)
    {
        var targetUrl = $"/admin/my/workspace/staff/{staff.Id}/leave";
        if (selected == "Assign Leave Type")
        {
            targetUrl += "?action=assign-leave-type";
        }
        Navigation.NavigateTo(targetUrl);
    }
    private string selected = "New Leave Application";
    private static readonly (string Title, string Description)[] Actions =
    [
        ("New Leave Application", "Apply for standard annual, casual, or special leave."),
        ("Assign Leave Type", "Assign and manage leave entitlements for this staff member."),
        ("Sick Leave Lodge", "Submit medical certificates and lodge sick leave."),
        ("Family Leave Lodge", "Apply for maternity, paternity, or family responsibility leave.")
    ];

}
