<div class="w-full p-2 flex flex-col gap-2">
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 flex-wrap gap-2">
        <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Employee Documents &amp; Files</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">View and manage uploaded credentials, contracts, certificates, and identity documents.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1 text-[10px] font-semibold text-slate-600 dark:text-slate-400">
                Staff #@StaffId
            </span>
        </div>
    </div>

    <!-- Empty State / Documents Registry -->
    <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/40 p-8 text-center text-xs text-slate-500 dark:text-slate-400 space-y-3">
        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 dark:text-slate-500">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
        </div>
        <div>
            <p class="font-semibold text-slate-800 dark:text-slate-200 text-sm">No Attached Documents</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md mx-auto">
                No identity records, certificates, or uploaded contract files are currently attached to this staff record.
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int StaffId { get; set; }
}
