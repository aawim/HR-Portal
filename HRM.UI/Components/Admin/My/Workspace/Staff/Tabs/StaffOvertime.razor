@using HRM.Services
@using HRM.Services.Contracts
@inject HRM.Services.Contracts.OvertimeRequestServiceContracts.IOperations OvertimeService
@inject ToastService Toasts
@inject ILogger<StaffOvertime> Logger

<section class="w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100" aria-label="Staff Overtime">
    <!-- Compact Header (no background/border) -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Staff Overtime &amp; Claims</h3>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Overtime
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Overtime preapproval requests, clock claim submissions, worked hours, and approval history.</p>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    disabled="@loading"
                    @onclick="LoadAsync">
                <AppIcon Name="refresh" Class="@(loading ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
        </div>
    </header>

    <!-- Error message -->
    @if (error != null)
    {
        <div role="alert" class="rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 px-3.5 py-2.5 text-xs text-rose-800 dark:text-rose-200 flex items-center justify-between">
            <span>@error</span>
            <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 hover:text-rose-800">✕</button>
        </div>
    }

    <!-- Narrow Filter & Inline KPI Bar -->
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-2 flex flex-wrap items-center justify-between gap-2.5 text-xs">
        <div class="flex flex-wrap items-center gap-2">
            <label class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                <span>Claims</span>
                <select class="h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-600 focus:outline-none" @bind="claimFilter">
                    <option value="all">All statuses (@StaffClaims.Count())</option>
                    <option value="approved">Approved only (@StaffClaims.Count(c => c.StateId == 4))</option>
                    <option value="pending">Pending review (@StaffClaims.Count(c => c.StateId != 4 && c.StateId != 5 && c.StateId != 6))</option>
                </select>
            </label>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500 dark:text-slate-400">
            <span class="inline-flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Approved OT: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@FormatMinutes(StaffClaims.Where(c => c.StateId == 4).Sum(c => c.Minutes))</strong>
            </span>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
            <span class="inline-flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                Pending: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@StaffClaims.Count(c => c.StateId != 4 && c.StateId != 5 && c.StateId != 6)</strong>
            </span>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
            <span class="inline-flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                Claims: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@StaffClaims.Count()</strong>
            </span>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
            <span class="inline-flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                Preapprovals: <strong class="text-slate-900 dark:text-slate-100 tabular-nums">@StaffWorkRequests.Count()</strong>
            </span>
        </div>
    </div>

    @if (loading)
    {
        <div role="status" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-xs text-slate-500">
            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
            <span>Loading overtime records…</span>
        </div>
    }
    else
    {
        <!-- Explicit Two-Column CSS Grid -->
        <div class="ot-workspace-grid">
            <!-- Left Column: Overtime Claims -->
            <div class="min-w-0 flex flex-col gap-3">
                <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Overtime Claims &amp; Logs</h4>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@FilteredClaims.Count()</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-50/60 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider">
                                    <th class="px-3 py-2">Date</th>
                                    <th class="px-3 py-2">Reference</th>
                                    <th class="px-3 py-2 text-right">Duration</th>
                                    <th class="px-3 py-2">Time Logged</th>
                                    <th class="px-3 py-2">Reason / Task</th>
                                    <th class="px-3 py-2">Status</th>
                                    <th class="px-3 py-2">Payroll</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                @if (FilteredClaims.Any())
                                {
                                    @foreach (var claim in FilteredClaims)
                                    {
                                        <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="whitespace-nowrap px-3 py-2 font-semibold text-slate-800 dark:text-slate-100">@claim.Date.ToString("dd MMM yyyy")</td>
                                            <td class="px-3 py-2 font-mono text-[11px] font-semibold text-slate-700 dark:text-slate-300">@claim.Reference</td>
                                            <td class="px-3 py-2 text-right font-semibold text-slate-900 dark:text-slate-100 tabular-nums">@FormatMinutes(claim.Minutes)</td>
                                            <td class="px-3 py-2 font-mono text-[11px] text-slate-600 dark:text-slate-400 whitespace-nowrap">
                                                @if (claim.Start.HasValue && claim.End.HasValue)
                                                {
                                                    <span>@claim.Start.Value.ToString("HH:mm") – @claim.End.Value.ToString("HH:mm")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">—</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300 max-w-[180px] truncate" title="@(claim.Task ?? claim.Reason)">@(claim.Task ?? claim.Reason)</td>
                                            <td class="px-3 py-2">
                                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @GetStatusBadgeClass(claim.StateId)">@claim.Status</span>
                                            </td>
                                            <td class="px-3 py-2 text-[11px] whitespace-nowrap">
                                                @if (claim.PayrollProcessed)
                                                {
                                                    <span class="text-emerald-700 dark:text-emerald-400 font-semibold">Processed</span>
                                                }
                                                else if (!string.IsNullOrEmpty(claim.PaymentReference))
                                                {
                                                    <span class="text-emerald-600 dark:text-emerald-400 font-medium">@claim.PaymentReference</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">Unprocessed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="p-6 text-center text-xs text-slate-500">No overtime claims found for this staff member.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Preapprovals & Policy Overview -->
            <div class="min-w-0 flex flex-col gap-3">
                <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex items-center justify-between gap-2">
                        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Preapprovals &amp; Work Authorizations</h4>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@StaffWorkRequests.Count()</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-50/60 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider">
                                    <th class="px-3 py-2">Ref / Type</th>
                                    <th class="px-3 py-2">Period</th>
                                    <th class="px-3 py-2">Tasks</th>
                                    <th class="px-3 py-2">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                @if (StaffWorkRequests.Any())
                                {
                                    @foreach (var work in StaffWorkRequests)
                                    {
                                        <tr class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="whitespace-nowrap px-3 py-2 font-mono text-[11px]">
                                                <span class="font-semibold text-slate-800 dark:text-slate-100 block">@work.Reference</span>
                                                <span class="text-[10px] text-teal-700 dark:text-teal-300 font-medium">@work.Kind</span>
                                            </td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300 text-[11px] whitespace-nowrap">
                                                <span>@work.From.ToString("dd MMM")</span>
                                                @if (work.From.Date != work.To.Date)
                                                {
                                                    <span> – @work.To.ToString("dd MMM")</span>
                                                }
                                                @if (work.Start.HasValue && work.End.HasValue)
                                                {
                                                    <span class="block font-mono text-slate-400 text-[10px]">@work.Start.Value.ToString("HH:mm")–@work.End.Value.ToString("HH:mm")</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300 max-w-[140px] truncate" title="@string.Join(", ", work.Tasks)">
                                                @(work.Tasks.Count > 0 ? string.Join(", ", work.Tasks) : work.Reason)
                                            </td>
                                            <td class="px-3 py-2">
                                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @GetStatusBadgeClass(work.StateId)">@work.Status</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="p-6 text-center text-xs text-slate-500">No preapproval requests found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900 p-3.5 space-y-1">
                    <h5 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Overtime Guidelines &amp; Reconciliation</h5>
                    <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
                        Claims must be supported by valid check-in and check-out clock pairs recorded outside official working hours.
                        Preapproved tasks expedite supervisory approval and ensure prompt payroll inclusion.
                    </p>
                </div>
            </div>
        </div>
    }
</section>

<style>
    .ot-workspace-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
    }

    @@media (min-width: 1024px) {
        .ot-workspace-grid {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        }
    }
</style>

@code {
    [Parameter] public int? StaffId { get; set; }
    [Parameter] public string? StaffName { get; set; }

    private bool loading = true;
    private string? error;
    private string claimFilter = "all";

    private List<OvertimeRow> allClaims = [];
    private List<OvertimeWorkRow> allWork = [];

    private int? loadedStaffId;

    protected override async Task OnParametersSetAsync()
    {
        if (StaffId == loadedStaffId && loadedStaffId != null) return;
        loadedStaffId = StaffId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            allClaims = await OvertimeService.LoadAsync(pendingOnly: false);
            allWork = await OvertimeService.LoadWorkAsync(pendingOnly: false);
        }
        catch (Exception ex)
        {
            error = "Could not load overtime records. Please try again.";
            Logger.LogError(ex, "Failed to load overtime for staff {StaffId}", StaffId);
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<OvertimeRow> StaffClaims =>
        allClaims.Where(MatchesStaff);

    private IEnumerable<OvertimeWorkRow> StaffWorkRequests =>
        allWork.Where(MatchesStaffWork);

    private IEnumerable<OvertimeRow> FilteredClaims
    {
        get
        {
            var baseItems = StaffClaims;
            return claimFilter switch
            {
                "approved" => baseItems.Where(c => c.StateId == 4),
                "pending" => baseItems.Where(c => c.StateId != 4 && c.StateId != 5 && c.StateId != 6),
                _ => baseItems
            };
        }
    }

    private bool MatchesStaff(OvertimeRow row)
    {
        if (StaffId.HasValue && row.StaffId.HasValue)
        {
            return row.StaffId.Value == StaffId.Value;
        }
        if (!string.IsNullOrWhiteSpace(StaffName))
        {
            return row.Staff.Contains(StaffName, StringComparison.OrdinalIgnoreCase) ||
                   StaffName.Contains(row.Staff, StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private bool MatchesStaffWork(OvertimeWorkRow row)
    {
        if (StaffId.HasValue && row.StaffId.HasValue)
        {
            return row.StaffId.Value == StaffId.Value;
        }
        if (!string.IsNullOrWhiteSpace(StaffName))
        {
            return row.Staff.Contains(StaffName, StringComparison.OrdinalIgnoreCase) ||
                   StaffName.Contains(row.Staff, StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private static string FormatMinutes(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    private static string GetStatusBadgeClass(int stateId) => stateId switch
    {
        4 => "bg-emerald-50 text-emerald-800 border border-emerald-200",
        5 or 6 => "bg-rose-50 text-rose-800 border border-rose-200",
        _ => "bg-amber-50 text-amber-800 border border-amber-200"
    };
}
