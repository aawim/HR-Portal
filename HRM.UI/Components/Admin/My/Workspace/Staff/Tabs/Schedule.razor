@using HRM.DTOs.StaffSchedule
@using HRM.Enum
@using HRM.WorkPlanning.Abstractions.Schedules
@using HRM.Services
@using HRM.Components.Admin.My.Workspace.Staff.SchduleComponents
@using HRM.Components.Admin.My.Workspace.Staff.SchduleComponents.Summary
@using HRM.Components.Admin.My.Workspace.Staff.SchduleComponents.Summary.ItemComponents
@inject IStaffScheduleService StaffScheduleService
@inject ToastService ToastService
@inject HRM.Services.Interfaces.IUserAccessService UserAccess
@inject HRM.WorkPlanning.Abstractions.IManualWorkAssignmentService ManualAssignments


<section class="w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100" aria-label="Staff schedule">
    <!-- Compact Header (no background/border) -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Work Schedule &amp; Duty Assignments</h3>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Schedule
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Official working schedule, duty templates, and one-off manual duty assignments.</p>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@isLoading" @onclick="LoadScheduleAsync">
                <AppIcon Name="refresh" Class="@(isLoading ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
        </div>
    </header>

    @if (isLoading)
    {
        <div role="status" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-xs text-slate-500">
            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
            <span>Loading staff schedule…</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div role="alert" class="rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50/80 dark:bg-amber-950/40 px-3.5 py-3 text-xs text-amber-800 dark:text-amber-200">
            <h4 class="font-bold">Schedule unavailable</h4>
            <p class="mt-0.5">@errorMessage</p>
        </div>
    }
    else if (schedule is not null)
    {
        <CurrentScheduleSummary Schedule="@schedule" />

        @if ((IsManualAssignmentDetailsOpen || IsManualAssignmentRemovalOpen) && selectedManualAssignment is { } selected)
        {
            <section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
                <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">@(IsManualAssignmentRemovalOpen ? "Remove Duty Assignment" : "Duty Assignment Details")</h3>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">@selected.AssignmentName · @selected.WorkTemplateName</p>
                    </div>
                    <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@cancelling" @onclick="ClosePanel">Close</button>
                </div>
                <div class="grid gap-2 p-3.5 text-xs sm:grid-cols-2">
                    <p><span class="font-semibold text-slate-700 dark:text-slate-300">Period:</span> <span class="font-mono">@selected.StartDateTime.ToString("dd MMM yyyy HH:mm") – @selected.EndDateTime.ToString("dd MMM yyyy HH:mm")</span></p>
                    <p><span class="font-semibold text-slate-700 dark:text-slate-300">Attendance:</span> @(selected.RequiresAttendance ? "Required" : "Optional") · @(selected.RequiresCheckout ? "Checkout required" : "No checkout")</p>
                    @if (!string.IsNullOrWhiteSpace(selected.Description)) { <p class="sm:col-span-2 text-slate-600 dark:text-slate-300">@selected.Description</p> }
                </div>
                @if (IsManualAssignmentRemovalOpen)
                {
                    <div class="flex flex-col gap-2.5 border-t border-slate-200 dark:border-slate-800 bg-rose-50/40 dark:bg-rose-950/20 p-3.5">
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300">Reason for removing this duty
                            <textarea class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-2 text-xs focus:border-teal-600 focus:outline-none" maxlength="500" rows="2" disabled="@cancelling" @bind="cancelReason"></textarea>
                        </label>
                        <div>
                            <button type="button" class="inline-flex items-center rounded-lg border border-rose-300 dark:border-rose-700 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 dark:text-rose-300 disabled:opacity-50 transition-colors" disabled="@(cancelling || !canManageSchedules || string.IsNullOrWhiteSpace(cancelReason))" @onclick="CancelManualAsync">@(cancelling ? "Removing…" : "Remove Duty")</button>
                        </div>
                    </div>
                }
            </section>
        }

        @if (!canManageSchedules)
        {
            <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900 px-3.5 py-2 text-xs text-slate-600 dark:text-slate-300">Viewing only. Contact HR to change schedules.</p>
        }

        <div class="schedule-cards-grid">
            <AssignTemplateDrawer IsOpen="@IsTemplateDrawerOpen"
                                  IsOpenChanged="@HandleTemplateDrawerVisibilityChanged"
                                  StaffId="@schedule.IndividualId"
                                  JobId="@schedule.JobId"
                                  OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                  StaffName="@schedule.EmployeeName"
                                  OfficialSchedule="@schedule.CurrentTemplates.FirstOrDefault(x => x.SchedulePurpose == "Official")"
                                  SchedulePurpose="@selectedSchedulePurpose"
                                  CurrentAssignment="@selectedTemplateAssignment"
                                  OnSaved="@HandleTemplateAssignmentSavedAsync" />

            <ManualAssignmentDrawer IsOpen="@IsManualAssignmentDrawerOpen"
                                    IsOpenChanged="@HandleManualDrawerVisibilityChanged"
                                    StaffId="@schedule.IndividualId"
                                    JobId="@schedule.JobId"
                                    OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                    Assignment="@selectedManualAssignment"
                                    IsEditing="@(activePanel == SchedulePanel.EditManualAssignment)"
                                    OnSaved="@HandleManualAssignmentSavedAsync" />
        </div>

        <div class="schedule-cards-grid">
            @foreach (var purpose in new[] { "Official", "Duty" })
            {
                <TemplateAssignmentCard StaffId="@schedule.IndividualId"
                                        SchedulePurpose="@purpose"
                                        JobId="@schedule.JobId"
                                        OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                        CurrentAssignment="@schedule.CurrentTemplates.FirstOrDefault(x => x.SchedulePurpose == purpose)"
                                        CurrentAssignments="@schedule.CurrentTemplates.Where(x => x.SchedulePurpose == purpose).ToList()"
                                        HasDefaultOfficialSchedule="@(schedule.CurrentTemplates.Any(x => x.SchedulePurpose == "Official") || schedule.TemplateHistory.Any(x => x.SchedulePurpose == "Official" && x.IsActive && (!x.EffectiveTo.HasValue || x.EffectiveTo.Value.Date >= DateTime.UtcNow.AddHours(5).Date)))"
                                        History="@schedule.TemplateHistory.Where(x => x.SchedulePurpose == purpose).ToList()"
                                        IsDisabled="@(!schedule.HasActiveJob || !canManageSchedules)"
                                        OnAssignRequested="@(() => OpenTemplateAssignmentForPurposeAsync(purpose))"
                                        OnChanged="@HandleScheduleChangedAsync" />
            }
        </div>

        <details class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
            <summary class="cursor-pointer bg-slate-50/80 dark:bg-slate-800/60 px-3.5 py-2.5 text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 select-none">
                Duty Exceptions &amp; One-Off Assignments (@schedule.ManualAssignments.Count)
            </summary>
            <div class="p-3 border-t border-slate-200 dark:border-slate-800">
                <ManualAssignmentCard StaffId="@schedule.IndividualId"
                                      JobId="@schedule.JobId"
                                      OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                      Assignments="@schedule.ManualAssignments"
                                      CurrentTemplate="@schedule.CurrentTemplate"
                                      IsDisabled="@(!schedule.HasActiveJob || !canManageSchedules)"
                                      OnAssignTemplateRequested="@OpenTemplateAssignmentDrawerAsync"
                                      OnAssignRequested="@OpenManualAssignmentDrawerAsync"
                                      OnViewRequested="@OpenManualAssignmentDetailsAsync"
                                      OnEditRequested="@OpenManualAssignmentEditAsync"
                                      OnRemoveRequested="@OpenManualAssignmentRemovalAsync"
                                      OnChanged="@HandleScheduleChangedAsync" />
            </div>
        </details>
    }
</section>

<style>
    .schedule-cards-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
    }

    @@media (min-width: 1024px) {
        .schedule-cards-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

@code {
    [Parameter]
    public int StaffId { get; set; }

    private StaffScheduleDto? schedule;

    private bool isLoading;
    private bool canManageSchedules;

    private string? errorMessage;

    private int loadedStaffId;
    private string selectedSchedulePurpose = "Official";

    private SchedulePanel activePanel =
        SchedulePanel.None;

    private CurrentWorkTemplateAssignmentDto?
        selectedTemplateAssignment;

    private ManualWorkAssignmentListDto?
        selectedManualAssignment;
    private bool cancelling;
    private string cancelReason = "";
    private async Task CancelManualAsync()
    {
        if (selectedManualAssignment == null || cancelling || !canManageSchedules) return;
        try
        {
            cancelling = true;
            var result = await ManualAssignments.CancelAsync(selectedManualAssignment.WorkAssignmentId, cancelReason);
            if (!result.Success) { ToastService.Error(result.Message); return; }
            ToastService.Success(result.Message);
            await HandleManualAssignmentRemovedAsync();
        }
        catch (Exception ex) { Console.Error.WriteLine(ex); ToastService.Error("The assignment could not be cancelled. Please refresh and try again."); }
        finally { cancelling = false; }
    }

    private bool IsTemplateDrawerOpen =>
        activePanel ==
        SchedulePanel.AssignTemplate;

    private bool IsManualAssignmentDrawerOpen =>
        activePanel ==
            SchedulePanel.CreateManualAssignment ||
        activePanel ==
            SchedulePanel.EditManualAssignment;

    private bool IsManualAssignmentDetailsOpen =>
        activePanel ==
        SchedulePanel.ViewManualAssignment;

    private bool IsManualAssignmentRemovalOpen =>
        activePanel ==
        SchedulePanel.RemoveManualAssignment;

    protected override async Task OnParametersSetAsync()
    {
        if (StaffId <= 0)
        {
            schedule = null;

            errorMessage =
                "A valid staff ID is required.";

            return;
        }

        if (loadedStaffId == StaffId &&
            schedule is not null)
        {
            return;
        }

        loadedStaffId = StaffId;

        ClosePanel();

        await LoadScheduleAsync();
    }

    private async Task LoadScheduleAsync()
    {
        if (StaffId <= 0)
        {
            schedule = null;

            errorMessage =
                "A valid staff ID is required.";

            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            schedule = null;

            var result =
                await StaffScheduleService.GetScheduleAsync(
                    StaffId);

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            if (result.Schedule is null)
            {
                errorMessage =
                    "The staff schedule could not be loaded.";

                return;
            }

            schedule = result.Schedule;
            canManageSchedules = await UserAccess.HasPermissionAsync("Schedule.Attach");
        }
        catch (Exception exception)
        {
            schedule = null;

            errorMessage =
                "An unexpected error occurred while loading " +
                "the staff schedule.";

            Console.Error.WriteLine(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenPanel(
        SchedulePanel panel)
    {
        activePanel = panel;
    }

    private void ClosePanel()
    {
        activePanel = SchedulePanel.None;
    }

        /*
         * Template assignment
         */

    private Task OpenTemplateAssignmentDrawerAsync()
        => OpenTemplateAssignmentForPurposeAsync("Official");

    private Task OpenTemplateAssignmentForPurposeAsync(string purpose)
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedSchedulePurpose = purpose;
        selectedTemplateAssignment = purpose == "Duty" ? null : schedule.CurrentTemplates.FirstOrDefault(x => x.SchedulePurpose == purpose);

        selectedManualAssignment =
            null;

        OpenPanel(
            SchedulePanel.AssignTemplate);

        return Task.CompletedTask;
    }

    private void HandleTemplateDrawerVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.AssignTemplate)
        {
            selectedTemplateAssignment =
                null;

            ClosePanel();
        }
    }

    private async Task HandleTemplateAssignmentSavedAsync()
    {
        ToastService.Success("Schedule saved.");
        selectedTemplateAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

        /*
         * Manual assignment
         */

    private Task OpenManualAssignmentDrawerAsync()
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }


        selectedManualAssignment =
            null;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.CreateManualAssignment);

        return Task.CompletedTask;
    }

    private Task OpenManualAssignmentDetailsAsync(
        ManualWorkAssignmentListDto assignment)
    {
        selectedManualAssignment =
            assignment;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.ViewManualAssignment);

        return Task.CompletedTask;
    }

    private Task OpenManualAssignmentEditAsync(
        ManualWorkAssignmentListDto assignment)
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedManualAssignment =
            assignment;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.EditManualAssignment);

        return Task.CompletedTask;
    }

    private Task OpenManualAssignmentRemovalAsync(
        ManualWorkAssignmentListDto assignment)
    {
        cancelReason = "";
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedManualAssignment =
            assignment;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.RemoveManualAssignment);

        return Task.CompletedTask;
    }

    private void HandleManualDrawerVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            (
                activePanel ==
                    SchedulePanel.CreateManualAssignment ||
                activePanel ==
                    SchedulePanel.EditManualAssignment
            ))
        {
            selectedManualAssignment =
                null;

            ClosePanel();
        }
    }

    private void HandleManualDetailsVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.ViewManualAssignment)
        {
            selectedManualAssignment =
                null;

            ClosePanel();
        }
    }

    private void HandleManualRemovalVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.RemoveManualAssignment)
        {
            selectedManualAssignment =
                null;

            ClosePanel();
        }
    }

    private async Task HandleManualAssignmentSavedAsync()
    {
        selectedManualAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

    private async Task HandleManualAssignmentRemovedAsync()
    {
        selectedManualAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

        /*
         * Shared refresh callback used by child cards.
         */

    private async Task HandleScheduleChangedAsync()
    {
        await LoadScheduleAsync();
    }
}
