@using HRM.DTOs.StaffSchedule
@using HRM.Enum
@using HRM.WorkPlanning.Abstractions.Schedules
@using HRM.Services
@using HRM.Components.Admin.My.Workspace.Staff.SchduleComponents
@using HRM.Components.Admin.My.Workspace.Staff.SchduleComponents.Summary
@using HRM.Components.Admin.My.Workspace.Staff.SchduleComponents.Summary.ItemComponents
@inject IStaffScheduleService StaffScheduleService
@inject ToastService ToastService
@inject HRM.Services.Interfaces.IUserAccessService UserAccess
@inject HRM.WorkPlanning.Abstractions.IManualWorkAssignmentService ManualAssignments


<div class="w-full p-2 flex flex-col gap-2">

    @if (isLoading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
            <p class="text-sm text-slate-500">
                Loading staff schedule...
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">

            <h3 class="font-semibold text-amber-800">
                Schedule unavailable
            </h3>

            <p class="mt-1 text-sm text-amber-700">
                @errorMessage
            </p>

        </div>
    }
    else if (schedule is not null)
    {
        <CurrentScheduleSummary Schedule="@schedule" />
        @if ((IsManualAssignmentDetailsOpen || IsManualAssignmentRemovalOpen) && selectedManualAssignment is { } selected)
        {
            <section class="rounded-2xl border border-slate-200 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 p-2 dark:border-slate-800"><div><h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@(IsManualAssignmentRemovalOpen ? "Remove duty assignment" : "Duty assignment details")</h3><p class="text-[11px] text-slate-500">@selected.AssignmentName · @selected.WorkTemplateName</p></div><button class="app-button app-button-ghost app-button-sm" disabled="@cancelling" @onclick="ClosePanel">Close</button></div>
                <div class="grid gap-2 p-2 text-xs sm:grid-cols-2"><p><span class="font-semibold">Period:</span> @selected.StartDateTime.ToString("dd MMM yyyy HH:mm")–@selected.EndDateTime.ToString("dd MMM yyyy HH:mm")</p><p><span class="font-semibold">Attendance:</span> @(selected.RequiresAttendance ? "Required" : "Optional") · @(selected.RequiresCheckout ? "Checkout required" : "No checkout")</p>@if (!string.IsNullOrWhiteSpace(selected.Description)) { <p class="sm:col-span-2 text-slate-600 dark:text-slate-300">@selected.Description</p> }</div>
                @if (IsManualAssignmentRemovalOpen)
                {
                    <div class="flex flex-col gap-2 border-t border-slate-100 p-2 dark:border-slate-800"><label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Reason for removing this duty<textarea class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs dark:border-slate-700 dark:bg-slate-800" maxlength="500" disabled="@cancelling" @bind="cancelReason"></textarea></label><div><button class="app-button app-button-danger app-button-sm" disabled="@(cancelling || !canManageSchedules || string.IsNullOrWhiteSpace(cancelReason))" @onclick="CancelManualAsync">@(cancelling ? "Removing..." : "Remove duty")</button></div></div>
                }
            </section>
        }
        @if (!canManageSchedules) { <p class="rounded-xl border border-slate-200 bg-slate-50 p-2 text-xs text-slate-600 dark:border-slate-800 dark:bg-slate-800/40 dark:text-slate-300">Viewing only. Contact HR to change schedules.</p> }

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">

            <AssignTemplateDrawer IsOpen="@IsTemplateDrawerOpen"
                                  IsOpenChanged="@HandleTemplateDrawerVisibilityChanged"
                                  StaffId="@schedule.IndividualId"
                                  JobId="@schedule.JobId"
                                  OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                  StaffName="@schedule.EmployeeName"
                                  OfficialSchedule="@schedule.CurrentTemplates.FirstOrDefault(x => x.SchedulePurpose == "Official")"
                                  SchedulePurpose="@selectedSchedulePurpose"
                                  CurrentAssignment="@selectedTemplateAssignment"
                                  OnSaved="@HandleTemplateAssignmentSavedAsync" />

            <RemoveTemplateAssignmentDialog IsOpen="@IsTemplateRemovalOpen"
                                            IsOpenChanged="@HandleTemplateRemovalVisibilityChanged"
                                            JobId="@schedule.JobId"
                                            Assignment="@selectedTemplateAssignment"
                                            OnRemoved="@HandleTemplateRemovedAsync" />

            <ManualAssignmentDrawer IsOpen="@IsManualAssignmentDrawerOpen"
                                    IsOpenChanged="@HandleManualDrawerVisibilityChanged"
                                    StaffId="@schedule.IndividualId"
                                    JobId="@schedule.JobId"
                                    OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                    Assignment="@selectedManualAssignment"
                                    IsEditing="@(activePanel == SchedulePanel.EditManualAssignment)"
                                    OnSaved="@HandleManualAssignmentSavedAsync" />

        </div>


        <div class="grid grid-cols-1 gap-2 xl:grid-cols-2">
        @foreach (var purpose in new[] { "Official", "Duty" })
        {
        <TemplateAssignmentCard StaffId="@schedule.IndividualId"
                                SchedulePurpose="@purpose"
                                JobId="@schedule.JobId"
                                OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                                CurrentAssignment="@schedule.CurrentTemplates.FirstOrDefault(x => x.SchedulePurpose == purpose)"
                                CurrentAssignments="@schedule.CurrentTemplates.Where(x => x.SchedulePurpose == purpose).ToList()"
                                HasDefaultOfficialSchedule="@(schedule.CurrentTemplates.Any(x=>x.SchedulePurpose=="Official") || schedule.TemplateHistory.Any(x => x.SchedulePurpose == "Official" && x.IsActive && (!x.EffectiveTo.HasValue || x.EffectiveTo.Value.Date >= DateTime.UtcNow.AddHours(5).Date)))"
                                History="@schedule.TemplateHistory.Where(x => x.SchedulePurpose == purpose).ToList()"
                                IsDisabled="@(!schedule.HasActiveJob || !canManageSchedules)"
                                OnAssignRequested="@(() => OpenTemplateAssignmentForPurposeAsync(purpose))"
                                OnRemoveRequested="@OpenTemplateRemovalAsync"
                                OnChanged="@HandleScheduleChangedAsync" />
        }
        </div>

        <details class="rounded-2xl border border-slate-200 bg-white p-2 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer p-2 text-sm font-semibold text-slate-800 dark:text-slate-100">Duty exceptions and one-off assignments</summary>
        <div class="p-2">
        <ManualAssignmentCard StaffId="@schedule.IndividualId"
                              JobId="@schedule.JobId"
                              OrganisationBusinessEntityId="@schedule.OrganisationBusinessEntityId"
                              Assignments="@schedule.ManualAssignments"
                              CurrentTemplate="@schedule.CurrentTemplate"
                              IsDisabled="@(!schedule.HasActiveJob || !canManageSchedules)"
                              OnAssignTemplateRequested="@OpenTemplateAssignmentDrawerAsync"
                              OnAssignRequested="@OpenManualAssignmentDrawerAsync"
                              OnViewRequested="@OpenManualAssignmentDetailsAsync"
                              OnEditRequested="@OpenManualAssignmentEditAsync"
                              OnRemoveRequested="@OpenManualAssignmentRemovalAsync"
                              OnChanged="@HandleScheduleChangedAsync" />
        </div>
        </details>




    }

</div>

@code {
    [Parameter]
    public int StaffId { get; set; }

    private StaffScheduleDto? schedule;

    private bool isLoading;
    private bool canManageSchedules;

    private string? errorMessage;

    private int loadedStaffId;
    private string selectedSchedulePurpose = "Official";

    private SchedulePanel activePanel =
        SchedulePanel.None;

    private CurrentWorkTemplateAssignmentDto?
        selectedTemplateAssignment;

    private ManualWorkAssignmentListDto?
        selectedManualAssignment;
    private bool cancelling;
    private string cancelReason = "";
    private async Task CancelManualAsync()
    {
        if (selectedManualAssignment == null || cancelling || !canManageSchedules) return;
        try
        {
            cancelling = true;
            var result = await ManualAssignments.CancelAsync(selectedManualAssignment.WorkAssignmentId, cancelReason);
            if (!result.Success) { ToastService.Error(result.Message); return; }
            ToastService.Success(result.Message);
            await HandleManualAssignmentRemovedAsync();
        }
        catch (Exception ex) { Console.Error.WriteLine(ex); ToastService.Error("The assignment could not be cancelled. Please refresh and try again."); }
        finally { cancelling = false; }
    }

    private bool IsTemplateDrawerOpen =>
        activePanel ==
        SchedulePanel.AssignTemplate;

    private bool IsTemplateRemovalOpen =>
        activePanel ==
        SchedulePanel.RemoveTemplate;

    private bool IsManualAssignmentDrawerOpen =>
        activePanel ==
            SchedulePanel.CreateManualAssignment ||
        activePanel ==
            SchedulePanel.EditManualAssignment;

    private bool IsManualAssignmentDetailsOpen =>
        activePanel ==
        SchedulePanel.ViewManualAssignment;

    private bool IsManualAssignmentRemovalOpen =>
        activePanel ==
        SchedulePanel.RemoveManualAssignment;

    protected override async Task OnParametersSetAsync()
    {
        if (StaffId <= 0)
        {
            schedule = null;

            errorMessage =
                "A valid staff ID is required.";

            return;
        }

        if (loadedStaffId == StaffId &&
            schedule is not null)
        {
            return;
        }

        loadedStaffId = StaffId;

        ClosePanel();

        await LoadScheduleAsync();
    }

    private async Task LoadScheduleAsync()
    {
        if (StaffId <= 0)
        {
            schedule = null;

            errorMessage =
                "A valid staff ID is required.";

            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            schedule = null;

            var result =
                await StaffScheduleService.GetScheduleAsync(
                    StaffId);

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            if (result.Schedule is null)
            {
                errorMessage =
                    "The staff schedule could not be loaded.";

                return;
            }

            schedule = result.Schedule;
            canManageSchedules = await UserAccess.HasPermissionAsync("Schedule.Attach");
        }
        catch (Exception exception)
        {
            schedule = null;

            errorMessage =
                "An unexpected error occurred while loading " +
                "the staff schedule.";

            Console.Error.WriteLine(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenPanel(
        SchedulePanel panel)
    {
        activePanel = panel;
    }

    private void ClosePanel()
    {
        activePanel = SchedulePanel.None;
    }

        /*
         * Template assignment
         */

    private Task OpenTemplateAssignmentDrawerAsync()
        => OpenTemplateAssignmentForPurposeAsync("Official");

    private Task OpenTemplateAssignmentForPurposeAsync(string purpose)
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedSchedulePurpose = purpose;
        selectedTemplateAssignment = purpose == "Duty" ? null : schedule.CurrentTemplates.FirstOrDefault(x => x.SchedulePurpose == purpose);

        selectedManualAssignment =
            null;

        OpenPanel(
            SchedulePanel.AssignTemplate);

        return Task.CompletedTask;
    }

    private Task OpenTemplateRemovalAsync(
        CurrentWorkTemplateAssignmentDto assignment)
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedTemplateAssignment =
            assignment;

        selectedManualAssignment =
            null;

        OpenPanel(
            SchedulePanel.RemoveTemplate);

        return Task.CompletedTask;
    }

    private void HandleTemplateDrawerVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.AssignTemplate)
        {
            selectedTemplateAssignment =
                null;

            ClosePanel();
        }
    }

    private void HandleTemplateRemovalVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.RemoveTemplate)
        {
            selectedTemplateAssignment =
                null;

            ClosePanel();
        }
    }

    private async Task HandleTemplateAssignmentSavedAsync()
    {
        ToastService.Success("Schedule saved.");
        selectedTemplateAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

    private async Task HandleTemplateRemovedAsync()
    {
        ToastService.Success("Schedule end date saved.");
        selectedTemplateAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

        /*
         * Manual assignment
         */

    private Task OpenManualAssignmentDrawerAsync()
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }


        selectedManualAssignment =
            null;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.CreateManualAssignment);

        return Task.CompletedTask;
    }

    private Task OpenManualAssignmentDetailsAsync(
        ManualWorkAssignmentListDto assignment)
    {
        selectedManualAssignment =
            assignment;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.ViewManualAssignment);

        return Task.CompletedTask;
    }

    private Task OpenManualAssignmentEditAsync(
        ManualWorkAssignmentListDto assignment)
    {
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedManualAssignment =
            assignment;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.EditManualAssignment);

        return Task.CompletedTask;
    }

    private Task OpenManualAssignmentRemovalAsync(
        ManualWorkAssignmentListDto assignment)
    {
        cancelReason = "";
        if (schedule is null ||
            !schedule.HasActiveJob)
        {
            return Task.CompletedTask;
        }

        selectedManualAssignment =
            assignment;

        selectedTemplateAssignment =
            null;

        OpenPanel(
            SchedulePanel.RemoveManualAssignment);

        return Task.CompletedTask;
    }

    private void HandleManualDrawerVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            (
                activePanel ==
                    SchedulePanel.CreateManualAssignment ||
                activePanel ==
                    SchedulePanel.EditManualAssignment
            ))
        {
            selectedManualAssignment =
                null;

            ClosePanel();
        }
    }

    private void HandleManualDetailsVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.ViewManualAssignment)
        {
            selectedManualAssignment =
                null;

            ClosePanel();
        }
    }

    private void HandleManualRemovalVisibilityChanged(
        bool isOpen)
    {
        if (!isOpen &&
            activePanel ==
                SchedulePanel.RemoveManualAssignment)
        {
            selectedManualAssignment =
                null;

            ClosePanel();
        }
    }

    private async Task HandleManualAssignmentSavedAsync()
    {
        selectedManualAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

    private async Task HandleManualAssignmentRemovedAsync()
    {
        selectedManualAssignment =
            null;

        ClosePanel();

        await LoadScheduleAsync();
    }

        /*
         * Shared refresh callback used by child cards.
         */

    private async Task HandleScheduleChangedAsync()
    {
        await LoadScheduleAsync();
    }
}
