                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Endorsed By Supervisor</span>
                            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate block">@GetSupervisorDisplay()</span>
                        </div>
                        <div class="border-t border-slate-300 dark:border-slate-700 pt-1.5 flex justify-between text-[10px] text-slate-500">
                            <span>Supervisor Signature</span>
                            <span>Date: _______________</span>
                        </div>
                    </div>

                    <!-- Block 3: Staff Member Acknowledgment -->
                    <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between h-36">
                        <div class="space-y-0.5">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Staff Acknowledgment</span>
                            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate block">@_profile.FullName</span>
                        </div>
                        <div class="border-t border-slate-300 dark:border-slate-700 pt-1.5 flex justify-between text-[10px] text-slate-500">
                            <span>Employee Signature</span>
                            <span>Date: _______________</span>
                        </div>
                    </div>

                </div>

                <!-- Footer System ID Stamp -->
                <div class="pt-2 flex flex-wrap items-center justify-between text-[10px] text-slate-400 border-t border-slate-100 dark:border-slate-800">
                    <span>Generated from HRM Official Information System · Document Hash: @(EffectiveStaffId.GetHashCode().ToString("X8"))</span>
                    <span>Page 1 of 1 · Official Document</span>
                </div>
            </footer>

        </article>
    }

</div>

@code {
    [Parameter] public int IndividualId { get; set; }
    [Parameter] public int StaffId { get; set; }

    private int EffectiveStaffId => StaffId > 0 ? StaffId : IndividualId;

    private ProfileOverviewDto? _profile;
    private bool _loading = true;
    private string? _errorMessage;
    private int _loadedStaffId;

    private string? _supervisorName;
    private string? _hodName;

    protected override async Task OnParametersSetAsync()
    {
        var targetId = EffectiveStaffId;
        if (targetId <= 0)
        {
            _profile = null;
            _loading = false;
            _errorMessage = "A valid staff or individual ID is required.";
            return;
        }

        if (_loadedStaffId == targetId && _profile is not null)
            return;

        _loadedStaffId = targetId;
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            _profile = null;
            _supervisorName = null;
            _hodName = null;

            var profileTask = ProfileService.GetProfileAsync(EffectiveStaffId);

            Task<StaffTransferDetailDto>? transferTask = null;
            try
            {
                transferTask = Transfers.LoadDetailAsync(null, EffectiveStaffId, null);
            }
            catch
            {
                // Non-blocking if transfers service is unavailable for this individual
            }

            _profile = await profileTask;

            if (transferTask is not null)
            {
                try
                {
                    var detail = await transferTask;
                    if (detail?.Staff is not null)
                    {
                        if (!string.IsNullOrWhiteSpace(detail.Staff.CurrentSupervisorName))
                        {
                            _supervisorName = detail.Staff.CurrentSupervisorName;
                        }
                        if (!string.IsNullOrWhiteSpace(detail.Staff.CurrentHodName))
                        {
                            _hodName = detail.Staff.CurrentHodName;
                        }
                    }
                }
                catch
                {
                    // Non-blocking fallback
                }
            }

            if (string.IsNullOrWhiteSpace(_supervisorName) && !string.IsNullOrWhiteSpace(_profile?.ActiveJob?.SupervisorName))
            {
                _supervisorName = _profile.ActiveJob.SupervisorName;
            }
        }
        catch (Exception ex)
        {
            _profile = null;
            _errorMessage = "An unexpected error occurred while loading the employee profile.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetSupervisorDisplay()
    {
        if (!string.IsNullOrWhiteSpace(_supervisorName))
            return _supervisorName;
        if (!string.IsNullOrWhiteSpace(_profile?.ActiveJob?.SupervisorName))
            return _profile.ActiveJob.SupervisorName;
        return "Not Assigned";
    }

    private string GetHodDisplay()
    {
        if (!string.IsNullOrWhiteSpace(_hodName))
            return _hodName;
        return "General Administration";
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "ST";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetDateOfBirthText(DateTime dob)
    {
        if (dob == default || dob.Year < 1900) return "Not recorded";
        var today = DateTime.Today;
        var age = today.Year - dob.Year;
        if (dob.Date > today.AddYears(-age)) age--;
        return $"{dob:dd MMM yyyy} ({age} years)";
    }

    private static string GetGenderText(int genderId) => genderId switch
    {
        1 => "Male",
        2 => "Female",
        _ => "Not specified"
    };

    private async Task PrintProfile()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch { }
    }
}
