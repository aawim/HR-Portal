@page "/admin/my/workspace/profile/{IndividualId:int}"

@using HRM.DTOs.JobPosition
@using HRM.DTOs.Profile
@using HRM.DTOs.Profile.ProfileAccess
@using HRM.DTOs.StaffTransfer
@using HRM.DTOs.UserContext
@using HRM.Enum
@using Services.Interfaces.Profile
@using HRM.Components.Admin.Hr.Individual
@using HRM.DTOs.Staff
@using HRM.Services.Contracts

@inject NavigationManager NavigationManager
@inject IProfileService ProfileService
@inject HRM.Services.Contracts.StaffTransferServiceContracts.IOperations Transfers
@inject IJSRuntime JS
@inject StaffIdentityDocumentServiceContracts.IOperations IdentityDocumentService
@inject HRM.Services.ToastService Toasts

<PageTitle>@(_profile?.FullName ?? "Staff Profile") · Official Personnel Dossier</PageTitle>

<style>
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm 10mm 12mm;
        }

        /* Strict Removals: Completely strip out all web application chrome */
        html, body {
            background: #ffffff !important;
            color: #000000 !important;
            font-size: 10pt !important;
            line-height: 1.35 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
        }

        /* Hide all outer layout chrome, headers, tabs, navigation and buttons */
        .app-shell > aside,
        .app-shell-sidebar,
        .app-shell-content > header,
        .app-shell-footer,
        .topbar,
        .sidebar,
        nav,
        .my-workspace-header,
        .my-workspace-tabs,
        .staff-workspace-header,
        .staff-workspace-tabs,
        .staff-overview-no-print,
        button,
        a[href] {
            display: none !important;
        }

        .app-shell,
        .app-shell-content,
        .app-shell-main,
        .my-workspace-page,
        .staff-overview-container {
            overflow: visible !important;
            height: auto !important;
            display: block !important;
            background: #ffffff !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .staff-overview-doc {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
            background: #ffffff !important;
            color: #000000 !important;
        }

        .print-break-avoid {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }
    }
</style>

<div class="staff-overview-container w-full flex flex-col gap-3">

    @if (_loading)
    {
        <div class="max-w-4xl mx-auto w-full p-8 bg-white border border-slate-200 shadow-sm animate-pulse space-y-4">
            <div class="h-8 bg-slate-200 w-3/4"></div>
            <div class="h-4 bg-slate-100 w-1/2"></div>
            <div class="h-32 bg-slate-100 w-full mt-4"></div>
            <div class="h-48 bg-slate-100 w-full"></div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="max-w-4xl mx-auto w-full p-6 bg-white border border-rose-300 shadow-sm text-xs text-rose-800 space-y-3">
            <h3 class="font-bold text-sm">Unable to load employee profile</h3>
            <p>@_errorMessage</p>
            <button type="button" class="px-3 py-1.5 bg-rose-700 text-white font-semibold rounded-none cursor-pointer" @onclick="LoadProfileAsync">
                ↻ Try Again
            </button>
        </div>
    }
    else if (_profile is null)
    {
        <div class="max-w-4xl mx-auto w-full p-8 bg-white border border-dashed border-slate-300 text-center text-xs text-slate-500">
            Personnel record not found.
        </div>
    }
    else
    {
        <!-- Action Toolbar: Web UI helper to trigger PDF Export (Hidden on Print) -->
        <header class="staff-overview-no-print max-w-4xl mx-auto w-full flex flex-wrap items-center justify-between gap-2 p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 px-3 py-1 text-xs font-semibold">
                    <span>📄</span>
                    <span>Staff Personnel Dossier</span>
                </span>
                <span class="text-xs font-mono text-slate-500">
                    REF: DOC-EMP-@EffectiveStaffId.ToString("D5")
                </span>
            </div>

            <div class="flex items-center gap-2">
                <button type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 px-4 py-2 text-xs font-bold text-white shadow-xs transition cursor-pointer"
                        title="Export this dossier to PDF or print"
                        @onclick="PrintProfile">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Export to PDF</span>
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition cursor-pointer"
                        title="Reload latest staff data"
                        @onclick="LoadProfileAsync">
                    <span>↻ Refresh</span>
                </button>
            </div>
        </header>

        <!-- ======================================================== -->
        <!-- STATIC A4 PRINT-READY DOCUMENT: STAFF PERSONNEL DOSSIER  -->
        <!-- Formal paper layout matching a Microsoft Word document   -->
        <!-- ======================================================== -->
        <article class="staff-overview-doc max-w-4xl mx-auto w-full bg-white text-slate-900 border border-slate-300 p-8 sm:p-12 shadow-md rounded-none print:shadow-none print:border-none print:p-0 print:m-0 print:max-w-none">

            <!-- ---------------------------------------------------- -->
            <!-- 1. OFFICIAL HEADER BOX                               -->
            <!-- ---------------------------------------------------- -->
            <header class="border-b-2 border-black pb-4 mb-5">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <!-- Title & Subtitle -->
                    <div class="space-y-1">
                        <h2 class="text-xs font-bold uppercase tracking-widest text-slate-700 font-mono">
                            @(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.OrganisationName) ? _profile.ActiveJob.OrganisationName : "NATIONAL CENTRE FOR INFORMATION TECHNOLOGY")
                        </h2>
                        <h1 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-black">
                            STAFF PERSONNEL DOSSIER &amp; EMPLOYMENT RECORD
                        </h1>
                        <p class="text-[11px] text-slate-600">
                            Official personnel record extract issued under Government Human Resource governance.
                        </p>
                    </div>

                    <!-- Meta Details (Boxed / Right-Aligned) -->
                    <div class="border border-black p-2.5 text-xs font-mono shrink-0 bg-slate-50/60 sm:min-w-[250px]">
                        <div class="flex justify-between gap-2 border-b border-slate-300 pb-0.5">
                            <span class="text-slate-600 font-bold text-[10px]">DOCUMENT NO:</span>
                            <span class="font-bold text-black">DOC-EMP-@EffectiveStaffId.ToString("D5")</span>
                        </div>
                        <div class="flex justify-between gap-2 border-b border-slate-300 py-0.5 text-[11px]">
                            <span class="text-slate-600 text-[10px]">RECORD DATE:</span>
                            <span class="text-black">@DateTime.Today.ToString("dd MMMM yyyy")</span>
                        </div>
                        <div class="flex justify-between gap-2 border-b border-slate-300 py-0.5 text-[10px] font-bold text-red-800">
                            <span>CLASSIFICATION:</span>
                            <span>OFFICIAL &amp; CONFIDENTIAL</span>
                        </div>
                        <div class="flex justify-between gap-2 border-b border-slate-300 py-0.5 text-[11px]">
                            <span class="text-slate-600 text-[10px]">RECORD STATUS:</span>
                            <span class="font-bold text-black uppercase">@(_profile.ActiveJob?.JobStateName ?? "ACTIVE")</span>
                        </div>
                        <div class="flex justify-between gap-2 border-b border-slate-300 py-0.5 text-[11px]">
                            <span class="text-slate-600 text-[10px]">EMPLOYEE NO:</span>
                            <span class="font-bold text-black">#@(!string.IsNullOrEmpty(_profile.ActiveJob?.EmployeeNumber) ? _profile.ActiveJob.EmployeeNumber : EffectiveStaffId.ToString())</span>
                        </div>
                        <div class="flex justify-between gap-2 border-b border-slate-300 py-0.5 text-[11px]">
                            <span class="text-slate-600 text-[10px]">SYSTEM ID:</span>
                            <span class="font-bold text-black">#@EffectiveStaffId</span>
                        </div>
                        <div class="flex justify-between gap-2 pt-0.5 text-[11px]">
                            <span class="text-slate-600 text-[10px]">SERVICE LENGTH:</span>
                            <span class="font-bold text-black">@(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.ServiceDurationText) ? _profile.ActiveJob.ServiceDurationText : "—")</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- ---------------------------------------------------- -->
            <!-- 2. EMPLOYEE IDENTITY BLOCK                           -->
            <!-- ---------------------------------------------------- -->
            <section class="border border-black p-4 mb-5 flex flex-col sm:flex-row items-start gap-5 print-break-avoid bg-slate-50/30">
                <!-- Formal Passport-Sized Photo Placeholder (Left) -->
                <div class="flex flex-col items-center shrink-0">
                    <div class="w-28 h-36 border-2 border-black bg-slate-100 flex flex-col items-center justify-center shrink-0 rounded-none overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(_profile.ImageUrl))
                        {
                            <img src="@_profile.ImageUrl" alt="@_profile.FullName" class="w-full h-full object-cover rounded-none" />
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center text-center p-2 text-slate-500 font-mono text-[10px]">
                                <span class="text-2xl mb-1 text-slate-400">👤</span>
                                <span class="font-bold uppercase tracking-wider text-[9px]">PASSPORT</span>
                                <span class="font-bold uppercase tracking-wider text-[9px]">PHOTO</span>
                            </div>
                        }
                    </div>
                    <button type="button"
                            @onclick="() => isPhotoModalOpen = true"
                            class="staff-overview-no-print mt-1.5 text-[11px] font-semibold text-blue-600 hover:text-blue-800 underline transition">
                        @(string.IsNullOrWhiteSpace(_profile.ImageUrl) ? "Add photo" : "Change photo")
                    </button>
                </div>

                <!-- Identity Details (Right) -->
                <div class="flex-1 space-y-2 min-w-0">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 font-mono block">EMPLOYEE IDENTITY</span>
                        <h2 class="text-xl sm:text-2xl font-black text-black uppercase tracking-tight">
                            @_profile.FullName
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(_profile.FullNameDhivehi))
                        {
                            <p class="text-base text-slate-800 font-dhivehi pt-0.5" dir="rtl">
                                @_profile.FullNameDhivehi
                            </p>
                        }
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 text-xs pt-1 border-t border-slate-300">
                        <div>
                            <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">National Identity Card (NID)</span>
                            <span class="font-bold text-black font-mono text-sm">@(!string.IsNullOrWhiteSpace(_profile.IdentityCardNumber) ? _profile.IdentityCardNumber : "—")</span>
                        </div>
                        <div>
                            <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Primary Designation</span>
                            <span class="font-bold text-black">@(_profile.ActiveJob?.PositionName ?? "No Position Assigned")</span>
                        </div>
                        <div>
                            <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Employing Organisation</span>
                            <span class="font-bold text-black">@(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.OrganisationName) ? _profile.ActiveJob.OrganisationName : "NATIONAL CENTRE FOR INFORMATION TECHNOLOGY")</span>
                        </div>
                        <div>
                            <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Department / Structure</span>
                            <span class="font-semibold text-slate-800">@(!string.IsNullOrEmpty(_profile.ActiveJob?.OrganisationStructureName) ? _profile.ActiveJob.OrganisationStructureName : (!string.IsNullOrEmpty(_profile.ActiveJob?.DepartmentName) ? _profile.ActiveJob.DepartmentName : "—"))</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ---------------------------------------------------- -->
            <!-- 01 EMPLOYMENT SPECIFICATION & ASSIGNMENT             -->
            <!-- ---------------------------------------------------- -->
            <section class="mb-5 print-break-avoid">
                <div class="border-b-2 border-black pb-1 mb-2 flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-black">
                        01 EMPLOYMENT SPECIFICATION &amp; ASSIGNMENT
                    </h3>
                    <span class="text-[10px] font-mono text-slate-500 uppercase">Official Terms</span>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 border-t border-l border-slate-400 text-xs">
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Employing Organisation</span>
                        <span class="font-bold text-black block truncate">@(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.OrganisationName) ? _profile.ActiveJob.OrganisationName : "NATIONAL CENTRE FOR INFORMATION TECHNOLOGY")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Department / Division</span>
                        <span class="font-semibold text-black block truncate">@(!string.IsNullOrEmpty(_profile.ActiveJob?.OrganisationStructureName) ? _profile.ActiveJob.OrganisationStructureName : (!string.IsNullOrEmpty(_profile.ActiveJob?.DepartmentName) ? _profile.ActiveJob.DepartmentName : "—"))</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Designation</span>
                        <span class="font-bold text-black block truncate">@(_profile.ActiveJob?.PositionName ?? "—")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Terms of Employment</span>
                        <span class="font-semibold text-black block truncate">@(_profile.ActiveJob?.JobTypeName ?? _profile.ActiveJob?.EmploymentType ?? "Permanent Staff")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Date Joined</span>
                        <span class="font-mono font-bold text-black block">@(_profile.ActiveJob is { JoinedDate: var jd } && jd != default ? jd.ToString("dd MMM yyyy") : "—")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Total Service Tenure</span>
                        <span class="font-semibold text-black block">@(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.ServiceDurationText) ? _profile.ActiveJob.ServiceDurationText : "—")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Confirmation Status</span>
                        <span class="font-semibold text-black block">@(_profile.ActiveJob?.ConfirmedDate.HasValue == true ? $"Confirmed on {_profile.ActiveJob.ConfirmedDate.Value:dd MMM yyyy}" : "Probation / Active")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Contract Status</span>
                        <span class="font-bold text-black block">@(_profile.ActiveJob?.IsActive == true ? "ACTIVE CONTRACT" : "INACTIVE")</span>
                    </div>
                </div>
            </section>

            <!-- ---------------------------------------------------- -->
            <!-- 02 REPORTING HIERARCHY & STAFF SUPERVISION           -->
            <!-- ---------------------------------------------------- -->
            <section class="mb-5 print-break-avoid">
                <div class="border-b-2 border-black pb-1 mb-2 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-black">
                            03 PERSONAL &amp; DEMOGRAPHIC IDENTITY
                        </h3>
                        <span class="text-[10px] font-mono text-slate-500 uppercase">Civil Registry</span>
                    </div>
                    <button type="button"
                            class="staff-overview-no-print inline-flex items-center gap-1 rounded border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-400 shadow-2xs transition"
                            @onclick="OpenIdentityModal">
                        <span>âœï¸</span>
                        <span>Update ID / Passport</span>
                    </button>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 border-t border-l border-slate-400 text-xs">
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Legal Name (English)</span>
                        <span class="font-bold text-black block">@_profile.FullName</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Name in Dhivehi</span>
                        <span class="font-semibold text-black font-dhivehi block" dir="rtl">@(!string.IsNullOrWhiteSpace(_profile.FullNameDhivehi) ? _profile.FullNameDhivehi : "â€”")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">National Identity Card (NID)</span>
                        <div class="flex items-center justify-between gap-1 flex-wrap">
                            <span class="font-mono font-bold text-black">@(!string.IsNullOrWhiteSpace(_profile.IdentityCardNumber) ? _profile.IdentityCardNumber : "â€”")</span>
                            @{
                                var nidStatus = GetExpiryStatus(_profile.IdentityCardExpiryDate);
                            }
                            @if (_profile.IdentityCardExpiryDate.HasValue)
                            {
                                <span class="rounded px-1.5 py-0.5 text-[9px] font-bold border @nidStatus.badgeClass">
                                    @nidStatus.text
                                </span>
                            }
                        </div>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Date of Birth &amp; Age</span>
                        <span class="font-semibold text-black block">@GetDateOfBirthText(_profile.DateOfBirth)</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Gender</span>
                        <span class="font-semibold text-black block">@GetGenderText(_profile.GenderId)</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2">
                        <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Nationality</span>
                        <span class="font-semibold text-black block">@(!string.IsNullOrWhiteSpace(_profile.NationalityName) ? _profile.NationalityName : "Maldivian")</span>
                    </div>
                    <div class="border-b border-r border-slate-400 p-2 col-span-2 md:col-span-3 bg-slate-50/50">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div>
                                <span class="text-[10px] font-bold text-slate-500 uppercase font-mono block">Passport Details</span>
                                <span class="font-mono font-bold text-black">
                                    @(!string.IsNullOrWhiteSpace(_profile.PassportNumber) ? _profile.PassportNumber : "No passport on record")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(_profile.PassportCountryName))
                                {
                                    <span class="text-[11px] text-slate-600">(@_profile.PassportCountryName)</span>
                                }
                            </div>
                            @if (_profile.PassportExpiryDate.HasValue)
                            {
                                var passStatus = GetExpiryStatus(_profile.PassportExpiryDate);
                                <div class="text-right">
                                    <span class="text-[10px] text-slate-500 block font-mono">Passport Expiry:</span>
                                    <span class="rounded px-1.5 py-0.5 text-[10px] font-bold border @passStatus.badgeClass">
                                        @passStatus.text
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- ---------------------------------------------------- -->
            <!-- 04 APPOINTED POSITIONS & RESPONSIBILITIES            -->
            <!-- ---------------------------------------------------- -->
            <section class="mb-5 print-break-avoid">
                <div class="border-b-2 border-black pb-1 mb-2 flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-black">
                        04 APPOINTED POSITIONS &amp; RESPONSIBILITIES
                    </h3>
                    <span class="text-[10px] font-mono text-slate-500 uppercase">Active Designations (@_profile.ActivePositions.Count)</span>
                </div>

                @if (_profile.ActivePositions.Count > 0)
                {
                    <table class="w-full border-collapse border border-black text-xs">
                        <thead>
                            <tr class="bg-slate-100 border-b border-black text-slate-900 font-bold text-left text-[11px]">
                                <th class="border border-black p-2">Designation</th>
                                <th class="border border-black p-2">Organisation</th>
                                <th class="border border-black p-2">Effective Period</th>
                                <th class="border border-black p-2 text-center">Nature</th>
                                <th class="border border-black p-2 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pos in _profile.ActivePositions)
                            {
                                <tr class="border-b border-slate-400">
                                    <td class="border border-slate-400 p-2 font-bold text-black">@pos.PositionName</td>
                                    <td class="border border-slate-400 p-2 text-slate-800">@pos.OrganisationStructureName</td>
                                    <td class="border border-slate-400 p-2 font-mono text-[11px] text-black">
                                        @pos.FromDate.ToString("dd MMM yyyy") – @(pos.ToDate?.ToString("dd MMM yyyy") ?? "Present")
                                    </td>
                                    <td class="border border-slate-400 p-2 text-center font-bold text-[11px]">
                                        @(pos.IsCurrent ? "PRIMARY" : "SECONDARY")
                                    </td>
                                    <td class="border border-slate-400 p-2 text-center font-bold text-[11px] text-black">
                                        ACTIVE
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="border border-slate-400 p-3 text-center text-xs text-slate-500 italic">
                        No secondary positions registered. Standard primary assignment applies.
                    </div>
                }
            </section>

            <!-- ---------------------------------------------------- -->
            <!-- 05 CONTACT & RESIDENCY DIRECTORY                     -->
            <!-- ---------------------------------------------------- -->
            <section class="mb-5 print-break-avoid">
                <div class="border-b-2 border-black pb-1 mb-2 flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-black">
                        05 CONTACT &amp; RESIDENCY DIRECTORY
                    </h3>
                    <span class="text-[10px] font-mono text-slate-500 uppercase">Communications</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 border border-slate-400 divide-y md:divide-y-0 md:divide-x divide-slate-400 text-xs">
                    <!-- Direct Contact Numbers & Email -->
