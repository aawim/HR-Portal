@page "/admin/my/workspace/profile/{IndividualId:int}"

@using HRM.DTOs.JobPosition
@using HRM.DTOs.Profile
@using HRM.DTOs.Profile.ProfileAccess
@using HRM.DTOs.StaffTransfer
@using HRM.DTOs.UserContext
@using HRM.Enum
@using Services.Interfaces.Profile

@inject NavigationManager NavigationManager
@inject IProfileService ProfileService
@inject HRM.Services.Contracts.StaffTransferServiceContracts.IOperations Transfers
@inject IJSRuntime JS

<PageTitle>@(_profile?.FullName ?? "Staff Profile") · Official Personnel Dossier</PageTitle>

<style>
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm 10mm 12mm;
        }
        body {
            background: #ffffff !important;
            color: #0f172a !important;
            font-size: 10.5pt !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .staff-overview-no-print {
            display: none !important;
        }
        .staff-overview-container {
            padding: 0 !important;
            gap: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
        }
        .staff-overview-doc {
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            padding: 16px !important;
            background: #ffffff !important;
            color: #0f172a !important;
            border-radius: 0 !important;
        }
        .print-break-avoid {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }
    }
</style>

<div class="staff-overview-container w-full p-2 flex flex-col gap-2">

    @if (_loading)
    {
        <!-- Professional Loading Skeleton -->
        <div class="w-full p-2 flex flex-col gap-2 animate-pulse">
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 flex flex-col gap-4 shadow-xs">
                <div class="flex items-center gap-4">
                    <div class="w-20 h-20 rounded-2xl bg-slate-200 dark:bg-slate-800 shrink-0"></div>
                    <div class="space-y-2 flex-1">
                        <div class="h-6 w-56 rounded bg-slate-200 dark:bg-slate-800"></div>
                        <div class="h-4 w-72 rounded bg-slate-100 dark:bg-slate-800/60"></div>
                        <div class="h-4 w-40 rounded bg-slate-100 dark:bg-slate-800/60"></div>
                    </div>
                </div>
                <div class="h-28 rounded-xl bg-slate-100 dark:bg-slate-800/40"></div>
                <div class="h-48 rounded-xl bg-slate-100 dark:bg-slate-800/40"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="w-full p-2 flex flex-col gap-2">
            <div class="rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/40 dark:border-rose-900 p-6 text-xs text-rose-800 dark:text-rose-200 shadow-xs">
                <div class="flex items-start gap-3">
                    <span class="text-rose-600 text-xl font-bold">⚠️</span>
                    <div class="space-y-2 flex-1">
                        <h3 class="font-bold text-rose-900 dark:text-rose-100 text-sm">Unable to load employee profile</h3>
                        <p class="text-rose-700 dark:text-rose-300">@_errorMessage</p>
                        <div class="pt-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-xl bg-rose-700 hover:bg-rose-800 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs transition"
                                    @onclick="LoadProfileAsync">
                                ↻ Try Again
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_profile is null)
    {
        <div class="w-full p-2 flex flex-col gap-2">
            <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 p-10 text-center text-xs text-slate-500 shadow-xs">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 mb-2">
                    👤
                </div>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Personnel Dossier Not Found</h3>
                <p class="mt-1">The requested staff record could not be loaded or does not exist in the institutional registry.</p>
            </div>
        </div>
    }
    else
    {
        <!-- ======================================================== -->
        <!-- ACTION TOOLBAR: EXPORT TO PDF & CONTROLS (HIDDEN ON PRINT) -->
        <!-- ======================================================== -->
        <header class="staff-overview-no-print w-full p-2 flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs shadow-2xs">
            <div class="p-2 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 px-2.5 py-0.5 text-[11px] font-semibold">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Official Personnel Dossier
                </span>
                <span class="text-slate-300 dark:text-slate-700">·</span>
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                    REF: DOC-EMP-@EffectiveStaffId.ToString("D5")
                </span>
                <span class="text-slate-300 dark:text-slate-700">·</span>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                    Last sync: @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
                </span>
            </div>

            <div class="p-2 flex flex-wrap items-center gap-2">
                <!-- EXPORT TO PDF BUTTON -->
                <button type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 px-4 py-2 text-xs font-semibold text-white shadow-xs transition cursor-pointer"
                        title="Export this official dossier to PDF or print"
                        @onclick="PrintProfile">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Export to PDF</span>
                </button>

                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer"
                        title="Reload latest staff data"
                        @onclick="LoadProfileAsync">
                    <span>↻ Refresh</span>
                </button>
            </div>
        </header>

        <!-- ======================================================== -->
        <!-- THE PLAN DOCUMENT / OFFICIAL PERSONNEL DOSSIER           -->
        <!-- Single unified document format (no separate card panels) -->
        <!-- ======================================================== -->
        <article class="staff-overview-doc w-full rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs p-6 sm:p-8 flex flex-col gap-6 text-slate-800 dark:text-slate-200">

            <!-- ---------------------------------------------------- -->
            <!-- LETTERHEAD & OFFICIAL DOCUMENT HEADER                -->
            <!-- ---------------------------------------------------- -->
            <header class="p-2 flex flex-col gap-4 border-b-2 border-slate-200 dark:border-slate-800 pb-5">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold text-sm shadow-xs">
                                🏛️
                            </span>
                            <div>
                                <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-700 dark:text-emerald-400">
                                    @(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.OrganisationName) ? _profile.ActiveJob.OrganisationName : "Republic of Maldives · Human Resources")
                                </h2>
                                <h1 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
                                    STAFF PERSONNEL DOSSIER &amp; EMPLOYMENT RECORD
                                </h1>
                            </div>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 pl-11">
                            Official personnel record extract, employment terms, reporting hierarchy, and institutional credentials.
                        </p>
                    </div>

                    <div class="flex flex-col items-start sm:items-end text-xs space-y-1 shrink-0 font-mono">
                        <div class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                            <span>DOCUMENT NO:</span>
                            <span class="font-bold text-emerald-700 dark:text-emerald-400">DOC-EMP-@EffectiveStaffId.ToString("D5")</span>
                        </div>
                        <span class="text-[10px] text-slate-500">Record Date: @DateTime.Today.ToString("dd MMMM yyyy")</span>
                        <span class="text-[10px] uppercase font-bold text-amber-700 dark:text-amber-400">Classification: Official &amp; Confidential</span>
                    </div>
                </div>

                <!-- Document Metadata Summary Strip -->
                <div class="grid grid-cols-2 sm:grid-cols-4 p-2 gap-2 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200/80 dark:border-slate-800 text-xs">
                    <div class="p-1">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Record Status</span>
                        <span class="font-bold text-emerald-700 dark:text-emerald-400">
                            @(_profile.ActiveJob?.JobStateName ?? "Active Staff")
                        </span>
                    </div>
                    <div class="p-1">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Employee Number</span>
                        <span class="font-bold font-mono text-slate-800 dark:text-slate-200">
                            #@(!string.IsNullOrEmpty(_profile.ActiveJob?.EmployeeNumber) ? _profile.ActiveJob.EmployeeNumber : EffectiveStaffId.ToString())
                        </span>
                    </div>
                    <div class="p-1">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Staff System ID</span>
                        <span class="font-bold font-mono text-slate-800 dark:text-slate-200">
                            #@EffectiveStaffId
                        </span>
                    </div>
                    <div class="p-1">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Service Length</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">
                            @(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.ServiceDurationText) ? _profile.ActiveJob.ServiceDurationText : "Recent appointment")
                        </span>
                    </div>
                </div>
            </header>

            <!-- ---------------------------------------------------- -->
            <!-- STAFF EXECUTIVE IDENTITY PROFILE                     -->
            <!-- ---------------------------------------------------- -->
            <section class="p-2 flex flex-col sm:flex-row items-center sm:items-start gap-5 border-b border-slate-200 dark:border-slate-800 pb-6 print-break-avoid">
                <div class="relative shrink-0">
                    @if (!string.IsNullOrWhiteSpace(_profile.ImageUrl))
                    {
                        <img src="@_profile.ImageUrl"
                             alt="@_profile.FullName"
                             class="h-24 w-24 sm:h-28 sm:w-28 rounded-2xl object-cover ring-2 ring-emerald-500/30 shadow-xs" />
                    }
                    else
                    {
                        <div class="flex h-24 w-24 sm:h-28 sm:w-28 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-3xl font-bold text-white shadow-xs">
                            @GetInitials(_profile.FullName)
                        </div>
                    }
                    <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-white dark:bg-slate-900 ring-2 ring-white dark:ring-slate-900" title="Active">
                        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                    </span>
                </div>

                <div class="flex-1 space-y-2 text-center sm:text-left min-w-0">
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                            @_profile.FullName
                        </h2>
                        <span class="rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 px-2.5 py-0.5 text-xs font-semibold">
                            @(_profile.ActiveJob?.JobStateName ?? "Active")
                        </span>
                        <span class="rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 px-2.5 py-0.5 text-xs font-semibold">
                            @(_profile.ActiveJob?.JobTypeName ?? _profile.ActiveJob?.EmploymentType ?? "Permanent Staff")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_profile.FullNameDhivehi))
                    {
                        <p class="text-base font-semibold text-slate-600 dark:text-slate-400 font-dhivehi" dir="rtl">
                            @_profile.FullNameDhivehi
                        </p>
                    }

                    <div class="p-2 flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                        <div class="flex items-center gap-1.5 font-bold text-emerald-700 dark:text-emerald-400">
                            <span>💼</span>
                            <span>@(_profile.ActiveJob?.PositionName ?? "Position Not Assigned")</span>
                        </div>
                        <span class="text-slate-300 dark:text-slate-700">·</span>
                        <div class="flex items-center gap-1.5 font-medium">
                            <span>🏛️</span>
                            <span>@(_profile.ActiveJob?.OrganisationName ?? "Organisation")</span>
                            @if (!string.IsNullOrWhiteSpace(_profile.ActiveJob?.OrganisationStructureName))
                            {
                                <span>(@_profile.ActiveJob.OrganisationStructureName)</span>
                            }
                        </div>
                        <span class="text-slate-300 dark:text-slate-700">·</span>
                        <div class="flex items-center gap-1.5 font-mono text-[11px]">
                            <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700">
                                NID: @(!string.IsNullOrWhiteSpace(_profile.IdentityCardNumber) ? _profile.IdentityCardNumber : "—")
                            </span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ---------------------------------------------------- -->
            <!-- SECTION 01: EMPLOYMENT SPECIFICATION & TERMS         -->
            <!-- ---------------------------------------------------- -->
            <section class="p-2 flex flex-col gap-3 border-b border-slate-200 dark:border-slate-800 pb-6 print-break-avoid">
                <div class="p-2 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="flex h-6 w-6 items-center justify-center rounded-md bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 font-bold text-xs">
                            01
                        </span>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
                            Employment Specification &amp; Assignment
                        </h3>
                    </div>
                    <span class="text-[11px] text-slate-500">Official Terms &amp; Conditions</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 p-2 gap-2">
                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Employing Organisation</span>
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 block truncate">
                            @(_profile.ActiveJob?.OrganisationName ?? "—")
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Department / Division</span>
                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block truncate">
                            @(!string.IsNullOrEmpty(_profile.ActiveJob?.OrganisationStructureName) ? _profile.ActiveJob.OrganisationStructureName : (!string.IsNullOrEmpty(_profile.ActiveJob?.DepartmentName) ? _profile.ActiveJob.DepartmentName : "—"))
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Primary Designation</span>
                        <span class="text-xs font-bold text-emerald-800 dark:text-emerald-300 block truncate">
                            @(_profile.ActiveJob?.PositionName ?? "No Position Assigned")
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Terms of Employment</span>
                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block truncate">
                            @(_profile.ActiveJob?.JobTypeName ?? _profile.ActiveJob?.EmploymentType ?? "Permanent Staff")
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Date Joined</span>
                        <span class="text-xs font-semibold font-mono text-slate-800 dark:text-slate-200 block">
                            @(_profile.ActiveJob is { JoinedDate: var jd2 } && jd2 != default ? jd2.ToString("dd MMM yyyy") : "—")
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Total Service Tenure</span>
                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block">
                            @(!string.IsNullOrWhiteSpace(_profile.ActiveJob?.ServiceDurationText) ? _profile.ActiveJob.ServiceDurationText : "—")
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Confirmation Status</span>
                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block">
                            @(_profile.ActiveJob?.ConfirmedDate.HasValue == true ? $"Confirmed on {_profile.ActiveJob.ConfirmedDate.Value:dd MMM yyyy}" : "Probation / In Service")
                        </span>
                    </div>

                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Contract Nature</span>
                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block">
                            @(_profile.ActiveJob?.IsActive == true ? "Active Contract" : "Inactive")
                        </span>
                    </div>
                </div>
            </section>

            <!-- ---------------------------------------------------- -->
            <!-- SECTION 02: REPORTING HIERARCHY & STAFF SUPERVISOR   -->
            <!-- (Prominently featured per user requirement)          -->
            <!-- ---------------------------------------------------- -->
            <section class="p-2 flex flex-col gap-3 border-b border-slate-200 dark:border-slate-800 pb-6 print-break-avoid">
                <div class="p-2 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="flex h-6 w-6 items-center justify-center rounded-md bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 font-bold text-xs">
                            02
                        </span>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
                            Reporting Hierarchy &amp; Staff Supervision
                        </h3>
                    </div>
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 px-2 py-0.5 text-[10px] font-bold">
                        Direct Reporting Line
                    </span>
                </div>

                <!-- Highlighted Supervisor Panel -->
                <div class="grid grid-cols-1 md:grid-cols-2 p-2 gap-2">

                    <!-- Direct Supervisor Card -->
                    <div class="rounded-xl border-2 border-emerald-300 dark:border-emerald-700 bg-emerald-50/40 dark:bg-emerald-950/20 p-4 flex items-start gap-4 shadow-2xs">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold text-lg shadow-xs">
                            👨‍💼
                        </div>
                        <div class="space-y-1 min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-800 dark:text-emerald-400">
                                    Direct Reporting Supervisor
                                </span>
                                <span class="rounded-md bg-emerald-200/80 dark:bg-emerald-900 px-1.5 py-0.5 text-[9px] font-bold text-emerald-900 dark:text-emerald-200">
                                    Primary Evaluator
                                </span>
                            </div>
                            <h4 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-slate-100">
                                @GetSupervisorDisplay()
                            </h4>
                            <p class="text-[11px] text-slate-600 dark:text-slate-400">
                                Responsible for work assignment, attendance certification, performance appraisal, and leave verification.
                            </p>
                        </div>
                    </div>

                    <!-- Department Head / Divisional HOD Card -->
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-4 flex items-start gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-600 text-white font-bold text-lg shadow-xs">
                            🏛️
                        </div>
                        <div class="space-y-1 min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                    Head of Department (HOD)
                                </span>
                                <span class="rounded-md bg-slate-200 dark:bg-slate-700 px-1.5 py-0.5 text-[9px] font-bold text-slate-700 dark:text-slate-300">
                                    Departmental Head
                                </span>
                            </div>
                            <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100">
                                @GetHodDisplay()
                            </h4>
                            <p class="text-[11px] text-slate-600 dark:text-slate-400">
                                Departmental governance, policy administration, and escalation channel for administrative decisions.
                            </p>
                        </div>
                    </div>

                </div>

                <!-- Supervisory Teams (if staff is a supervisor) -->
                @if (_profile.SupervisingTeams.Count > 0)
                {
                    <div class="p-2 flex flex-col gap-2 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50/30 dark:bg-emerald-950/20">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 block">
                            Subordinate Teams &amp; Supervisory Responsibilities (@_profile.SupervisingTeams.Count)
                        </span>
