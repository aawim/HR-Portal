@code {
    private bool isPhotoModalOpen;
    private void HandlePhotoUpdated(string? newUrl) { if (_profile != null) _profile.ImageUrl = newUrl; }
    [Parameter] public int IndividualId { get; set; }
    [Parameter] public int StaffId { get; set; }

    private int EffectiveStaffId => StaffId > 0 ? StaffId : IndividualId;

    private ProfileOverviewDto? _profile;
    private bool _loading = true;
    private string? _errorMessage;
    private int _loadedStaffId;

    private string? _supervisorName;
    private string? _hodName;

    protected override async Task OnParametersSetAsync()
    {
        var targetId = EffectiveStaffId;
        if (targetId <= 0)
        {
            _profile = null;
            _loading = false;
            _errorMessage = "A valid staff or individual ID is required.";
            return;
        }

        if (_loadedStaffId == targetId && _profile is not null)
            return;

        _loadedStaffId = targetId;
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            _profile = null;
            _supervisorName = null;
            _hodName = null;

            var profileTask = ProfileService.GetProfileAsync(EffectiveStaffId);

            Task<StaffTransferDetailDto>? transferTask = null;
            try
            {
                transferTask = Transfers.LoadDetailAsync(null, EffectiveStaffId, null);
            }
            catch
            {
                // Non-blocking if transfers service is unavailable for this individual
            }

            _profile = await profileTask;

            if (transferTask is not null)
            {
                try
                {
                    var detail = await transferTask;
                    if (detail?.Staff is not null)
                    {
                        if (!string.IsNullOrWhiteSpace(detail.Staff.CurrentSupervisorName))
                        {
                            _supervisorName = detail.Staff.CurrentSupervisorName;
                        }
                        if (!string.IsNullOrWhiteSpace(detail.Staff.CurrentHodName))
                        {
                            _hodName = detail.Staff.CurrentHodName;
                        }
                    }
                }
                catch
                {
                    // Non-blocking fallback
                }
            }

            if (string.IsNullOrWhiteSpace(_supervisorName) && !string.IsNullOrWhiteSpace(_profile?.ActiveJob?.SupervisorName))
            {
                _supervisorName = _profile.ActiveJob.SupervisorName;
            }
        }
        catch (Exception ex)
        {
            _profile = null;
            _errorMessage = "An unexpected error occurred while loading the employee profile.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetSupervisorDisplay()
    {
        if (!string.IsNullOrWhiteSpace(_supervisorName))
            return _supervisorName;
        if (!string.IsNullOrWhiteSpace(_profile?.ActiveJob?.SupervisorName))
            return _profile.ActiveJob.SupervisorName;
        return "Not Assigned";
    }

    private string GetHodDisplay()
    {
        if (!string.IsNullOrWhiteSpace(_hodName))
            return _hodName;
        return "General Administration";
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "ST";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetDateOfBirthText(DateTime dob)
    {
        if (dob == default || dob.Year < 1900) return "Not recorded";
        var today = DateTime.Today;
        var age = today.Year - dob.Year;
        if (dob.Date > today.AddYears(-age)) age--;
        return $"{dob:dd MMM yyyy} ({age} years)";
    }

    private static string GetGenderText(int genderId) => genderId switch
    {
        1 => "Male",
        2 => "Female",
        _ => "Not specified"
    };

    private async Task PrintProfile()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch { }
    }

    private bool isIdentityModalOpen;
    private bool identitySaving;
    private string? identityModalError;
    private StaffIdentityDocumentUpdateInput identityModel = new();

    private void OpenIdentityModal()
    {
        if (_profile == null) return;
        identityModel = new StaffIdentityDocumentUpdateInput
        {
            IdentityCardNumber = _profile.IdentityCardNumber,
            IdentityCardExpiryDate = _profile.IdentityCardExpiryDate,
            PassportNumber = _profile.PassportNumber,
            PassportCountryName = _profile.PassportCountryName,
            PassportIssuedDate = _profile.PassportIssuedDate,
            PassportExpiryDate = _profile.PassportExpiryDate
        };
        identityModalError = null;
        isIdentityModalOpen = true;
    }

    private async Task SaveIdentityAsync()
    {
        identitySaving = true;
        identityModalError = null;
        try
        {
            identityModel.IndividualId = EffectiveStaffId;
            var res = await IdentityDocumentService.UpdateIdentityDocumentsAsync(identityModel);
            if (res.Success)
            {
                if (_profile != null)
                {
                    _profile.IdentityCardNumber = identityModel.IdentityCardNumber;
                    _profile.IdentityCardExpiryDate = identityModel.IdentityCardExpiryDate;
                    _profile.PassportNumber = identityModel.PassportNumber;
                    _profile.PassportCountryName = identityModel.PassportCountryName;
                    _profile.PassportIssuedDate = identityModel.PassportIssuedDate;
                    _profile.PassportExpiryDate = identityModel.PassportExpiryDate;
                }
                Toasts.Success("Identity documents updated successfully.");
                isIdentityModalOpen = false;
            }
            else
            {
                identityModalError = res.Message;
            }
        }
        catch (Exception ex)
        {
            identityModalError = ex.Message;
        }
        finally
        {
            identitySaving = false;
        }
    }

    private static (string text, string badgeClass) GetExpiryStatus(DateTime? expiryDate)
    {
        if (!expiryDate.HasValue) return ("No Expiry Recorded", "bg-slate-100 text-slate-600 border-slate-200");
        var days = (expiryDate.Value.Date - DateTime.Today).Days;
        if (days < 0) return ($"EXPIRED ({Math.Abs(days)}d ago)", "bg-rose-100 text-rose-800 border-rose-300 font-bold");
        if (days <= 60) return ($"EXPIRES IN {days} DAYS", "bg-amber-100 text-amber-900 border-amber-300 font-bold");
        return ($"Valid until {expiryDate.Value:dd MMM yyyy}", "bg-emerald-50 text-emerald-800 border-emerald-300");
    }
}
