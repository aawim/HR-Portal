                                        <td class="p-3 font-mono text-[11px] text-slate-600 dark:text-slate-400">
                                            @hist.FromDate.ToString("MMM yyyy") – @(hist.ToDate.HasValue ? hist.ToDate.Value.ToString("MMM yyyy") : "Present")
                                        </td>
                                        <td class="p-3 text-center">
                                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-0.5 text-[10px] font-medium">
                                                @(!string.IsNullOrWhiteSpace(hist.JobPositionStateName) ? hist.JobPositionStateName : "Completed")
