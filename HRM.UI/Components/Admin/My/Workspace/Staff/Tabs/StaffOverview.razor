            <footer class="p-2 flex flex-col gap-4 pt-2 print-break-avoid">
                <div class="p-2 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="flex h-6 w-6 items-center justify-center rounded-md bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 font-bold text-xs">
                            08
                        </span>
