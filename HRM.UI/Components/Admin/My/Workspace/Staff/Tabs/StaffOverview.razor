                        REF: #DOC-EMP-@EffectiveStaffId.ToString("D5")
                    </span>
                </div>

                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
                    <p>
                        This document constitutes an official certified personnel dossier extract issued under institutional governance authority.
                        All records, employment details, and supervisory assignments contained herein reflect the active verified state in the Human Resource Management Information System.
                    </p>
                </div>

                <!-- 3 Formal Signatures Blocks -->
                <div class="grid grid-cols-1 sm:grid-cols-3 p-2 gap-4 pt-3">

                    <!-- Block 1: Prepared & Verified by HR Officer -->
