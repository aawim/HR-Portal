@namespace HRM.Components.Admin.My.Workspace.Staff.Tabs
@using HRM.DTOs.Staff
@using HRM.Services.Contracts
@inject StaffBankServiceContracts.IOperations BankService
@inject HRM.Services.ToastService Toasts
@inject ILogger<StaffBankAccounts> Logger

<div class="staff-bank-accounts w-full min-w-0 p-2 space-y-4">
    <!-- Header Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 rounded-2xl shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-xl">🏦</span>
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Bank Accounts &amp; Remittance Information
                </h2>
                <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2.5 py-0.5 text-xs font-semibold">
                    @accounts.Count Account@(accounts.Count == 1 ? "" : "s")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Manage bank accounts for salary remittances, payroll processing, and official disbursements.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                    disabled="@busy"
                    @onclick="LoadAccountsAsync">
                <span>↻</span>
                <span>Refresh</span>
            </button>

            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs transition"
                    disabled="@busy"
                    @onclick="OpenAddModal">
                <span>+</span>
                <span>Add Bank Account</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(globalError))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 flex items-center justify-between">
            <span>⚠️ @globalError</span>
            <button type="button" class="text-rose-700 font-bold hover:underline" @onclick="() => globalError = null">Dismiss</button>
        </div>
    }

    <!-- Content Area -->
    @if (busy && accounts.Count == 0)
    {
        <div class="py-12 text-center text-xs text-slate-400 animate-pulse">
            Loading bank accounts…
        </div>
    }
    else if (accounts.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center text-xs text-slate-500 dark:text-slate-400 flex flex-col items-center gap-2">
            <span class="text-3xl">🏦</span>
            <p class="font-bold text-slate-800 dark:text-slate-200 text-sm">No Bank Accounts Registered</p>
            <p class="text-xs max-w-md">No banking details are currently on file for this staff member. Add a bank account to enable direct salary deposits and electronic bank batch transfers.</p>
            <button type="button"
                    class="mt-2 inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs transition"
                    @onclick="OpenAddModal">
                <span>+ Add Primary Bank Account</span>
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @foreach (var acc in accounts)
            {
                <div @key="acc.Id"
                     class="rounded-2xl border p-4 shadow-xs flex flex-col justify-between gap-3 transition @(acc.IsPrimary ? "border-emerald-500 dark:border-emerald-500/80 bg-emerald-50/20 dark:bg-emerald-950/20 ring-1 ring-emerald-400/50" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300")">
                    
                    <!-- Top Bar: Bank Name, Badges -->
                    <div class="flex items-start justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-xl shrink-0">🏛️</span>
                            <div>
                                <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm leading-tight">
                                    @acc.BankName
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(acc.BranchName))
                                {
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400">
                                        @acc.BranchName Branch
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="flex flex-col items-end gap-1">
                            @if (acc.IsPrimary)
                            {
                                <span class="rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2.5 py-0.5 text-[10px] font-bold border border-emerald-300 dark:border-emerald-800 flex items-center gap-1">
                                    <span>★</span>
                                    <span>Primary Account</span>
                                </span>
                            }
                            <span class="rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-0.5 text-[10px] font-mono font-bold">
                                @acc.Currency
                            </span>
                        </div>
                    </div>

                    <!-- Details Body -->
                    <div class="space-y-2 text-xs">
                        <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-2.5 border border-slate-100 dark:border-slate-800 flex flex-col gap-1">
                            <div class="flex justify-between items-center">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Account Number</span>
                                <span class="font-mono text-sm font-bold text-slate-900 dark:text-slate-100 tracking-wider">
                                    @acc.AccountNumber
                                </span>
                            </div>
                            <div class="flex justify-between items-center text-[11px] pt-1 border-t border-slate-200/60 dark:border-slate-700/60">
                                <span class="text-slate-500 dark:text-slate-400">Account Holder:</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate max-w-[200px]">
                                    @acc.AccountHolderName
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(acc.Remarks))
                        {
                            <p class="text-[11px] text-slate-600 dark:text-slate-400 italic bg-white dark:bg-slate-900 p-2 rounded-lg border border-slate-100 dark:border-slate-800">
                                “@acc.Remarks”
                            </p>
                        }
                    </div>

                    <!-- Footer Action Bar -->
                    <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                        <div>
                            @if (!acc.IsPrimary)
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400 hover:underline"
                                        disabled="@busy"
                                        @onclick="() => SetPrimaryAsync(acc.Id)">
                                    <span>★ Make Primary</span>
                                </button>
                            }
                            else
                            {
                                <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-semibold italic">Default for payroll</span>
                            }
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="text-xs text-slate-600 dark:text-slate-300 hover:text-slate-900 font-semibold px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                                    @onclick="() => OpenEditModal(acc)">
                                ✏️ Edit
                            </button>
                            <button type="button"
                                    class="text-xs text-rose-600 dark:text-rose-400 hover:text-rose-800 font-semibold px-2 py-1 rounded hover:bg-rose-50 dark:hover:bg-rose-950/40 transition"
                                    disabled="@busy"
                                    @onclick="() => DeleteAccountAsync(acc.Id)">
                                ✕ Remove
                            </button>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

    <!-- Add / Edit Modal -->
    @if (showModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-slate-900/60 p-4 backdrop-blur-xs">
            <div class="relative w-full max-w-lg rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 shadow-2xl flex flex-col gap-4">
                
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🏛️</span>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                            @(editingModel.Id > 0 ? "Edit Bank Account" : "Add Bank Account")
                        </h3>
                    </div>
                    <button type="button" class="text-slate-400 hover:text-slate-600 text-lg font-bold" @onclick="CloseModal">✕</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(modalError))
                {
                    <div class="rounded-xl border border-rose-200 bg-rose-50 p-2.5 text-xs text-rose-800">
                        @modalError
                    </div>
                }

                <div class="flex flex-col gap-3 text-xs">
                    <!-- Bank Name Selection / Input -->
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 p-1">Bank Name *</label>
                        <select @bind="selectedPresetBank" @bind:after="OnPresetBankChanged"
                                class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 mb-1">
                            <option value="Bank of Maldives (BML)">Bank of Maldives (BML)</option>
                            <option value="Maldives Islamic Bank (MIB)">Maldives Islamic Bank (MIB)</option>
                            <option value="State Bank of India (SBI)">State Bank of India (SBI)</option>
                            <option value="Bank of Ceylon (BOC)">Bank of Ceylon (BOC)</option>
                            <option value="Habib Bank Limited (HBL)">Habib Bank Limited (HBL)</option>
                            <option value="Mauritius Commercial Bank (MCB)">Mauritius Commercial Bank (MCB)</option>
                            <option value="Other">Other / Custom Bank</option>
                        </select>

                        @if (selectedPresetBank == "Other")
                        {
                            <input type="text"
                                   placeholder="Enter official bank name..."
                                   @bind="editingModel.BankName"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 mt-1" />
                        }
                    </div>

                    <!-- Branch and Currency -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 dark:text-slate-300 p-1">Branch Name</label>
                            <input type="text"
                                   placeholder="e.g. Male' Branch, Hulhumale'..."
                                   @bind="editingModel.BranchName"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100" />
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 dark:text-slate-300 p-1">Currency *</label>
                            <select @bind="editingModel.Currency"
                                    class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100">
                                <option value="MVR">MVR (Maldivian Rufiyaa)</option>
                                <option value="USD">USD (US Dollar)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Account Number -->
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 p-1">Account Number *</label>
                        <input type="text"
                               placeholder="e.g. 7701123456789 or 9901..."
                               @bind="editingModel.AccountNumber"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs font-mono font-bold text-slate-900 dark:text-slate-100" />
                    </div>

                    <!-- Account Holder Name -->
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 p-1">Account Holder Full Name *</label>
                        <input type="text"
                               placeholder="Full name as registered with the bank..."
                               @bind="editingModel.AccountHolderName"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100" />
                    </div>

                    <!-- Primary Checkbox -->
                    <div class="flex items-center gap-2 pt-1">
                        <input type="checkbox"
                               id="isPrimaryCheck"
                               @bind="editingModel.IsPrimary"
                               class="rounded border-slate-300 text-teal-600 focus:ring-teal-500 h-4 w-4" />
                        <label for="isPrimaryCheck" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
                            Set as Primary Remittance Account (Default for Payroll)
                        </label>
                    </div>

                    <!-- Remarks -->
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 p-1">Notes / Remarks</label>
                        <input type="text"
                               placeholder="Optional notes or remittance instructions..."
                               @bind="editingModel.Remarks"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100" />
                    </div>
                </div>

                <!-- Modal Actions -->
                <div class="flex items-center justify-end gap-2 border-t border-slate-100 dark:border-slate-800 pt-3">
                    <button type="button"
                            class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition"
                            @onclick="CloseModal">
                        Cancel
                    </button>
                    <button type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-4 py-1.5 text-xs font-semibold shadow-2xs disabled:opacity-50 transition"
                            disabled="@busy"
                            @onclick="SaveAccountAsync">
                        <span>💾 Save Account</span>
                    </button>
                </div>

            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int IndividualId { get; set; }

    private List<StaffBankAccountDto> accounts = [];
    private bool busy = false;
    private string? globalError;
    private string? modalError;

    private bool showModal = false;
    private StaffBankAccountInputDto editingModel = new();
    private string selectedPresetBank = "Bank of Maldives (BML)";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        if (IndividualId <= 0) return;
        busy = true;
        globalError = null;
        try
        {
            accounts = await BankService.GetAccountsAsync(IndividualId) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed loading bank accounts for individual {IndividualId}", IndividualId);
            globalError = "Could not load bank accounts. Please click Refresh.";
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenAddModal()
    {
        selectedPresetBank = "Bank of Maldives (BML)";
        editingModel = new StaffBankAccountInputDto
        {
            IndividualId = IndividualId,
            BankName = selectedPresetBank,
            BankCode = "BML",
            BranchName = "Main Branch",
            Currency = "MVR",
            IsPrimary = accounts.Count == 0
        };
        modalError = null;
        showModal = true;
    }

    private void OpenEditModal(StaffBankAccountDto acc)
    {
        var presets = new[]
        {
            "Bank of Maldives (BML)",
            "Maldives Islamic Bank (MIB)",
            "State Bank of India (SBI)",
            "Bank of Ceylon (BOC)",
            "Habib Bank Limited (HBL)",
            "Mauritius Commercial Bank (MCB)"
        };

        if (presets.Contains(acc.BankName))
        {
            selectedPresetBank = acc.BankName;
        }
        else
        {
            selectedPresetBank = "Other";
        }

        editingModel = new StaffBankAccountInputDto
        {
            Id = acc.Id,
            IndividualId = acc.IndividualId,
            BankName = acc.BankName,
            BankCode = acc.BankCode,
            BranchName = acc.BranchName,
            AccountHolderName = acc.AccountHolderName,
            AccountNumber = acc.AccountNumber,
            Currency = acc.Currency,
            IsPrimary = acc.IsPrimary,
            Remarks = acc.Remarks
        };
        modalError = null;
        showModal = true;
    }

    private void OnPresetBankChanged()
    {
        if (selectedPresetBank != "Other")
        {
            editingModel.BankName = selectedPresetBank;
            editingModel.BankCode = selectedPresetBank switch
            {
                "Bank of Maldives (BML)" => "BML",
                "Maldives Islamic Bank (MIB)" => "MIB",
                "State Bank of India (SBI)" => "SBI",
                "Bank of Ceylon (BOC)" => "BOC",
                "Habib Bank Limited (HBL)" => "HBL",
                "Mauritius Commercial Bank (MCB)" => "MCB",
                _ => null
            };
        }
    }

    private void CloseModal()
    {
        showModal = false;
        modalError = null;
    }

    private async Task SaveAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(editingModel.BankName))
        {
            modalError = "Please select or enter the bank name.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingModel.AccountNumber))
        {
            modalError = "Please enter the account number.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingModel.AccountHolderName))
        {
            modalError = "Please enter the account holder name.";
            return;
        }

        busy = true;
        modalError = null;
        try
        {
            var res = await BankService.SaveAccountAsync(editingModel);
            if (res.Success)
            {
                Toasts.Success(res.Message);
                CloseModal();
                await LoadAccountsAsync();
            }
            else
            {
                modalError = res.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed saving bank account");
            modalError = "An error occurred while saving the bank account.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetPrimaryAsync(int accountId)
    {
        if (busy) return;
        busy = true;
        try
        {
            var res = await BankService.SetPrimaryAsync(accountId, IndividualId);
            if (res.Success)
            {
                Toasts.Success("Primary bank account updated.");
                await LoadAccountsAsync();
            }
            else
            {
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed setting primary bank account");
            Toasts.Error("Failed setting primary bank account.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAccountAsync(int accountId)
    {
        if (busy) return;
        busy = true;
        try
        {
            var res = await BankService.DeleteAccountAsync(accountId);
            if (res.Success)
            {
                Toasts.Success("Bank account removed.");
                await LoadAccountsAsync();
            }
            else
            {
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed deleting bank account");
            Toasts.Error("Failed deleting bank account.");
        }
        finally
        {
            busy = false;
        }
    }
}
