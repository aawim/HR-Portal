@using HRM.Services
@using static HRM.Services.Contracts.StaffPositionManagementServiceContracts
@inject HRM.Services.Contracts.StaffPositionManagementServiceContracts.IOperations Positions
@inject ToastService Toasts
@inject ILogger<StaffPositions> Logger

<section class="w-full p-2 flex flex-col gap-2" aria-label="Staff positions">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100">
        <div>
            <h3 class="text-base font-bold text-slate-800">Staff Positions & Appointments</h3>
            <p class="text-xs text-slate-500 mt-0.5">Manage assignments, effective dates, pay steps, and termination requests.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (CanAssign)
            {
                <button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-2xs hover:bg-emerald-700 disabled:opacity-50 transition-colors" disabled="@busy" @onclick="New">
                    <span>+</span>
                    <span>Assign Position</span>
                </button>
            }
            <button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 disabled:opacity-50 transition-colors" disabled="@busy" @onclick="LoadAsync">
                <span class="@(loading ? "animate-spin" : "")">↻</span>
                <span>Refresh</span>
            </button>
        </div>
    </div>
    @if (message != null)
    {
        <p role="alert" class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800 shadow-2xs">@message</p>
    }
    @if (loading)
    {
        <p role="status" class="text-xs text-slate-500">Loading positions…</p>
    }
    else if (data != null)
    {
        <div class="staff-position-layout">
            <div class="position-editor min-w-0">
                @if (editing)
                {
                    <form @onsubmit="SaveAsync" @onsubmit:preventDefault class="space-y-3 rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
                        <h4 class="font-bold text-sm text-slate-800">@(ending ? "Job termination request" : changing ? "Change position" : original != null ? "Edit position dates" : "Assign position")</h4>
                        @if (changing)
                        {
                            <p class="text-xs text-slate-500">@original!.Name will end the day before the new position starts.</p>
                        }
                        <fieldset disabled="@busy" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <label class="block text-xs font-semibold text-slate-600">Employment
                                <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="jobId" disabled="@(original != null)" required>
                                    <option value="0">Select employment</option>
                                    @foreach (var job in data.Jobs) { <option value="@job.Id">@job.Name</option> }
                                    @if (original != null && !data.Jobs.Any(j => j.Id == original.JobId))
                                    { <option value="@original.JobId">Job @original.JobId</option> }
                                </select>
                            </label>
                            @if(SelectingPosition)
                            {
                                <label class="block text-xs font-semibold text-slate-600">Framework<select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="selectedFrameworkId" @bind:after="FrameworkChanged" required><option value="0">Select framework</option>@foreach(var framework in data.Frameworks){<option value="@framework.Id">@framework.Name</option>}</select></label>
                                <label class="block text-xs font-semibold text-slate-600">Position matrix<select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="selectedMatrixId" @bind:after="MatrixChanged" disabled="@(selectedFrameworkId==0)" required><option value="0">Select position matrix</option>@foreach(var matrix in data.PositionMatrices.Where(x=>x.FrameworkId==selectedFrameworkId)){<option value="@matrix.Id" disabled="@(matrix.AvailableSlots==0)">@matrix.Name · @matrix.AvailableSlots / @matrix.ApprovedSlots slots available@(matrix.AvailableSlots==0?" · Full":"")</option>}</select></label>
                            }
                            <label class="block text-xs font-semibold text-slate-600">@(SelectingPosition?"Vacant position slot":"Position")
                                <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="positionId" @bind:after="()=>jobMatrixStepId=null" disabled="@(!SelectingPosition||(SelectingPosition&&selectedMatrixId==0))" required>
                                    <option value="0">Select position</option>
                                    @foreach (var position in data.Positions.Where(p=>!SelectingPosition||p.FrameworkId==selectedFrameworkId&&p.MatrixId==selectedMatrixId)) { <option value="@position.Id">@position.Name · #@position.Id</option> }
                                    @if (!SelectingPosition && original != null && !data.Positions.Any(p => p.Id == original.PositionId))
                                    { <option value="@original.PositionId">@original.Name</option> }
                                </select>
                            </label>
                            @if(ending)
                            {
                                <label class="block text-xs font-semibold text-slate-600">Job termination request type<select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="terminationRequestTypeId" required><option value="">Select request type</option>@foreach(var type in data.TerminationRequestTypes){<option value="@type.Id">@type.Name</option>}</select></label>
                                @if(data.TerminationRequestTypes.Count==0){<p role="status" class="text-xs text-amber-700">Job termination requests are unavailable. Please contact HR.</p>}
                            }
                            else
                            {
                            <label class="block text-xs font-semibold text-slate-600">From date
                                <InputDate class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind-Value="from" disabled="@ending" />
                            </label>
                            }
                            @if(data.Positions.FirstOrDefault(x=>x.Id==positionId)?.Pay is {} payDefinition && (original==null||changing))
                            {
                                <label class="block text-xs font-semibold text-slate-600">Employee Job pay step<select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="jobMatrixStepId"><option value="">Select pay step</option>@foreach(var s in payDefinition.Steps){<option value="@s.Id">Step @s.Number · @s.JobAllowance.ToString("N2") @payDefinition.Currency</option>}</select></label>
                            }
                            <label class="block text-xs font-semibold text-slate-600">@(ending ? "Termination effective date (first day no longer employed)" : "To date (optional)")
                                <InputDate class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind-Value="to" />
                            </label>
                            <label class="block text-xs font-semibold text-slate-600 sm:col-span-2">Reason
                                <textarea class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" @bind="reason" maxlength="500" required rows="2"></textarea>
                            </label>
                        </fieldset>
                        @if(data.Positions.FirstOrDefault(x=>x.Id==positionId)?.Pay is {} selectedPay)
                        {
                            <div class="text-xs bg-slate-50 p-2.5 rounded-lg border border-slate-200 text-slate-700"><p class="font-medium">Basic salary: @selectedPay.BasicSalary.ToString("N2") @selectedPay.Currency · Job allowance: @selectedPay.JobAllowance.ToString("N2")</p>@foreach(var b in selectedPay.Benefits){<p class="text-slate-500">@b.Name · @(b.Amount?.ToString("N2")??"Non-cash") · @b.Frequency</p>}</div>
                        }
                        <div class="flex flex-wrap gap-2 pt-2">
                            <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-2xs hover:bg-emerald-700 disabled:opacity-50 transition-colors" disabled="@busy">@(busy ? "Submitting…" : "Submit for approval")</button>
                            <button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 disabled:opacity-50 transition-colors" disabled="@busy" @onclick="() => editing = false">Cancel</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="rounded-xl border border-slate-200 bg-white p-4 text-xs text-slate-500 shadow-2xs">
                        @(data.Jobs.Count==0?"No active employment is available. A new employment appointment must be approved before a position can be assigned.":"Select a position action to start.")
                    </div>
                }
            </div>
            <div class="position-list-panel min-w-0 space-y-4">
                <div class="position-list rounded-xl border border-slate-200 bg-white p-4 shadow-2xs space-y-3" aria-label="Position assignments">
                    <h4 class="font-bold text-sm text-slate-800 pb-2 border-b border-slate-100 flex items-center justify-between">
                        <span>Positions</span>
                        <span class="text-xs font-normal text-slate-500">(@data.Assignments.Count assignments)</span>
                    </h4>
                    @if (data.Assignments.Count == 0)
                    {
                        <p class="py-2 text-xs text-slate-500">No position assignments found in this organisation.</p>
                    }
                    else
                    {
                        @foreach (var assignment in data.Assignments)
                        {
                            <article class="p-3 rounded-lg border border-slate-100 bg-slate-50/50 text-xs space-y-2 hover:bg-slate-50 transition-colors" @key="assignment.Id">
                                <div class="flex items-start justify-between gap-2 flex-wrap">
                                    <h5 class="font-bold text-slate-800">@assignment.Name <span class="font-normal text-slate-400">· #@assignment.PositionId</span></h5>
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">@Status(assignment)</span>
                                </div>
                                <p class="text-slate-500">Job @assignment.JobId · @assignment.From.ToString("dd MMM yyyy") – @(assignment.To?.ToString("dd MMM yyyy") ?? "Ongoing")</p>
                                @if(assignment.Pay is {} pay){<details class="text-[11px] text-slate-600"><summary class="cursor-pointer font-medium text-emerald-700">Framework pay details</summary><p class="mt-1">Basic salary: @pay.BasicSalary.ToString("N2") @pay.Currency · Job allowance: @pay.JobAllowance.ToString("N2")</p>@foreach(var b in pay.Benefits){<p>@b.Name · @(b.Amount?.ToString("N2")??"Non-cash") · @b.Frequency</p>}</details>}
                                @if (data.CanManage && assignment.StateId == 4 && (!assignment.To.HasValue || assignment.To.Value.Date > Today))
                                {
                                    <div class="flex flex-wrap gap-1.5 pt-1">
                                        <button type="button" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs hover:bg-slate-50 disabled:opacity-50 transition-colors" disabled="@busy" @onclick="() => Edit(assignment)">Edit dates</button>
                                        <button type="button" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs hover:bg-slate-50 disabled:opacity-50 transition-colors" disabled="@busy" @onclick="() => Edit(assignment, change: true)">Change position</button>
                                        <button type="button" class="inline-flex items-center rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700 shadow-2xs hover:bg-rose-100 disabled:opacity-50 transition-colors" disabled="@busy" @onclick="() => Edit(assignment, end: true)">Job termination</button>
                                    </div>
                                }
                            </article>
                        }
                    }
                </div>
                <HRM.Components.Shared.StaffPositionRequests StaffId="StaffId" RefreshVersion="requestVersion" OnChanged="LoadAsync" />
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public int StaffId { get; set; }
    private Data? data;
    private Assignment? original;
    private bool loading, busy, editing, changing, ending;
    private int jobId, positionId, requestVersion,selectedFrameworkId,selectedMatrixId;
    private int? jobMatrixStepId,terminationRequestTypeId;
    private DateTime from = Today;
    private DateTime? to;
    private string reason = "";
    private string? message;
    private static DateTime Today => DateTime.UtcNow.AddHours(5).Date;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; message = null; editing = false;
        try { data = await Positions.LoadAsync(StaffId);if(CanAssign)New(); }
        catch (UnauthorizedAccessException ex) { data = null; message = ex.Message; }
        catch (Exception ex) { data = null; message = "Positions could not be loaded. Please try again."; Logger.LogError(ex, "Loading positions for staff {StaffId}", StaffId); }
        finally { loading = false; }
    }
    private void New()
    {
        if(!CanAssign)return;
        selectedFrameworkId=selectedMatrixId=0;
        terminationRequestTypeId=null;jobMatrixStepId=null;original = null; changing = ending = false; editing = true; message = null;
        jobId = data!.Jobs.FirstOrDefault()?.Id ?? 0; positionId = 0; from = Today; to = null; reason = "";
    }
    private void Edit(Assignment item, bool change = false, bool end = false)
    {
        selectedFrameworkId=selectedMatrixId=0;
        terminationRequestTypeId=null;original = item; changing = change; ending = end; editing = true; message = null;
        jobMatrixStepId=null;jobId = item.JobId; positionId = change ? 0 : item.PositionId;
        from = change ? (Today > item.From.Date ? Today : item.From.Date.AddDays(1)) : item.From;
        to = end ? (Today >= item.From.Date ? Today : item.From.Date) : change ? null : item.To; reason = "";
    }
    private async Task SaveAsync()
    {
        if (busy) return;
        message = null;
        if(SelectingPosition&&(selectedFrameworkId==0||selectedMatrixId==0||!data!.PositionMatrices.Any(x=>x.Id==selectedMatrixId&&x.FrameworkId==selectedFrameworkId&&x.AvailableSlots>0)||!data.Positions.Any(x=>x.Id==positionId&&x.FrameworkId==selectedFrameworkId&&x.MatrixId==selectedMatrixId))){message="Select a framework, a position matrix with available slots and a vacant position.";return;}
        if (ending && (!to.HasValue||!terminationRequestTypeId.HasValue)) { message = "Select a job termination request type and effective date."; return; }
        busy = true;
        try
        {
            await Positions.SaveAsync(StaffId, jobId, positionId, from, to, reason, original, changing, ending,jobMatrixStepId,ending?terminationRequestTypeId:null);
            Toasts.Success(ending?"Job termination request submitted for approval.":"Position request submitted for approval.");
            requestVersion++;
            await LoadAsync();
        }
        catch (UnauthorizedAccessException ex) { message = ex.Message; Toasts.Error(message); }
        catch (InvalidOperationException ex) { message = ex.Message; }
        catch (Exception ex) { message = "The position could not be saved. Refresh and try again."; Logger.LogError(ex, "Saving position for staff {StaffId}", StaffId); Toasts.Error(message); }
        finally { busy = false; }
    }
    private bool SelectingPosition=>original==null||changing;
    private bool CanAssign=>data?.CanManage==true&&data.Jobs.Count>0&&!data.Assignments.Any(a=>a.StateId==4&&a.From.Date<=Today&&(!a.To.HasValue||a.To.Value.Date>Today)&&data.Jobs.Any(j=>j.Id==a.JobId));
    private void FrameworkChanged(){selectedMatrixId=positionId=0;jobMatrixStepId=null;}
    private void MatrixChanged(){positionId=0;jobMatrixStepId=null;}
    private static string Status(Assignment a)
    {
        var status = a.StateId != 4 ? a.State :
            a.HasApprovedTermination&&a.To.HasValue&&a.To.Value.Date<=Today?"Job terminated":
            a.To.HasValue && a.To.Value.Date < Today ? (a.HasApprovedTermination?"Job terminated":a.HasApprovedRemoval ? "Removed" : "Ended") :
            a.To.HasValue && a.To.Value.Date == Today ? "Ends today" :
            a.From.Date > Today ? "Scheduled" :
            a.HasApprovedTermination?"Job termination scheduled":a.HasApprovedRemoval ? "Removal scheduled" : "Current";
        return a.PendingAction == null ? status : status + " · " + (a.PendingAction switch
        {
            "Remove" => "Removal pending approval",
            "Terminate" => "Job termination pending approval",
            "Change" => "Position change pending approval",
            _ => "Date change pending approval"
        });
    }
}
