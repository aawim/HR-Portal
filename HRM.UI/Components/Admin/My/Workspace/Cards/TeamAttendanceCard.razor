@using HRM.Components.Cards
@using HRM.DTOs
@using HRM.Enum
@using HRM.Services

@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService
@inject ILogger<TeamAttendanceCard> Logger
 

<section class="w-full space-y-2 p-2">
    <header class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div><h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Attendance</h3><p class="text-xs text-slate-500">Fetch today’s attendance for your teams or the whole organisation.</p></div>
        <div class="flex flex-wrap items-center gap-2"><div class="inline-flex rounded-lg border border-slate-300 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-800"><button type="button" class="rounded-md px-2 py-1 text-xs font-semibold @(includeAllStaff ? "text-slate-600 dark:text-slate-300" : "bg-white text-blue-700 shadow-xs dark:bg-slate-700 dark:text-white")" @onclick="() => SelectScopeAsync(false)">My teams / groups</button><button type="button" class="rounded-md px-2 py-1 text-xs font-semibold @(includeAllStaff ? "bg-white text-blue-700 shadow-xs dark:bg-slate-700 dark:text-white" : "text-slate-600 dark:text-slate-300")" @onclick="() => SelectScopeAsync(true)">All staff</button></div><button type="button" class="app-button app-button-neutral app-button-sm" disabled="@loading" @onclick="LoadAttendanceAsync"><AppIcon Name="refresh" Class="@(loading ? "animate-spin text-sm" : "text-sm")" /> Fetch</button><HRM.Components.Shared.AttendanceExportButtons CreateReport="BuildExport" /></div>
    </header>

    <!-- Summary -->
    <!-- Summary Tabs -->
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">

        <button class="@TabClass(AttendanceFilter.Present)"
                @onclick="() => SelectedFilter = AttendanceFilter.Present">

            <div class="text-xl font-semibold text-green-600">
                @PresentCount
            </div>

            <div class="text-xs text-slate-500">
                Perfectly attended
            </div>

        </button>


        <button class="@TabClass(AttendanceFilter.Late)"
                @onclick="() => SelectedFilter = AttendanceFilter.Late">

            <div class="text-xl font-semibold text-amber-600">
                @LateCount
            </div>

            <div class="text-xs text-slate-500">
                Late
            </div>

        </button>


        <button class="@TabClass(AttendanceFilter.Absent)"
                @onclick="() => SelectedFilter = AttendanceFilter.Absent">

            <div class="text-xl font-semibold text-red-600">
                @AbsentCount
            </div>

            <div class="text-xs text-slate-500">
                Absent
            </div>

        </button>


        <button class="@TabClass(AttendanceFilter.NoCheckout)"
                @onclick="() => SelectedFilter = AttendanceFilter.NoCheckout">

            <div class="text-xl font-semibold text-blue-600">
                @NoCheckoutCount
            </div>

            <div class="text-xs text-slate-500">
                Attended
            </div>

        </button>


        <button class="@TabClass(AttendanceFilter.SickLeave)"
                @onclick="() => SelectedFilter = AttendanceFilter.SickLeave">

            <div class="text-xl font-semibold text-purple-600">
                @SickLeaveCount
            </div>

            <div class="text-xs text-slate-500">
                Sick Leave
            </div>

        </button>


        <button class="@TabClass(AttendanceFilter.FamilyLeave)"
                @onclick="() => SelectedFilter = AttendanceFilter.FamilyLeave">

            <div class="text-xl font-semibold text-pink-600">
                @FamilyLeaveCount
            </div>

            <div class="text-xs text-slate-500">
                Family Leave
            </div>

        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(loadError)) { <p class="rounded-xl border border-rose-200 bg-rose-50 p-2 text-xs text-rose-800">@loadError</p> }
    <!-- Staff List -->
    @if (Attendance.Any(x => x.StatusMessage != null))
    {
        <details class="border-b p-2 text-sm">
            <summary class="cursor-pointer">Staff awaiting an active schedule or position approval (@Attendance.Count(x => x.StatusMessage != null))</summary>
            <ul class="mt-2 space-y-2">@foreach (var staff in Attendance.Where(x => x.StatusMessage != null)) { <li><span class="font-medium">@staff.Name</span> · @staff.StatusMessage</li> }</ul>
        </details>
    }
    <div class="divide-y divide-slate-100">

        @if (!FilteredAttendance.Any())
        {
            <div class="p-2 text-center text-sm text-slate-500">
                No records found.
            </div>
        }
        else
        {
            @foreach (var staff in FilteredAttendance)
            {
                <button class="w-full text-left px-4 py-3 hover:bg-slate-50">

                    <div class="flex items-center gap-3">

                        <div class="@GetStatusColor(staff.Status) h-2.5 w-2.5 rounded-full">
                        </div>

                        <div class="flex-1">

                            <div class="flex justify-between">

                                <span class="text-sm font-medium text-slate-800">
                                    @staff.Name
                                </span>

                                <span class="text-xs text-slate-500">
                                    @(staff.StatusMessage ?? staff.Status.ToString())
                                </span>

                            </div>


                            <div class="text-xs text-slate-500 mt-1">

                                In:
                                @(staff.CheckIn?.ToString("hh:mm tt") ?? "--")

                                |

                                Out:
                                @(staff.CheckOut?.ToString("hh:mm tt") ?? "--")

                            </div>

                        </div>

                    </div>

                </button>
            }
        }

    </div>

</section>

@code {
    private AttendanceExportReport BuildExport() => new("Attendance", $"{DateTime.UtcNow.AddHours(5):dd MMM yyyy} · {(includeAllStaff ? "All staff" : "My teams / groups")} · Filter: {SelectedFilter}",
        [new("Attendance", ["Employee", "Team / Group", "Status", "Check in", "Check out"], FilteredAttendance.Select(s => new object?[] { s.Name, s.TeamName, s.StatusMessage ?? s.Status.ToString(), s.CheckIn?.ToString("HH:mm"), s.CheckOut?.ToString("HH:mm") }).ToList())]);

    private List<TeamAttendanceDto> Attendance = new();

    private int PresentCount =>
       Attendance.Count(x =>
           x.Status == AttendanceStatus.Present);


    private int LateCount =>
        Attendance.Count(x =>
            x.Status == AttendanceStatus.Late);


    private int AbsentCount =>
        Attendance.Count(x =>
            x.Status == AttendanceStatus.Absent);


    private int NoCheckoutCount =>
        Attendance.Count(x =>
            x.Status == AttendanceStatus.MissingCheckout);


    private int SickLeaveCount =>
        Attendance.Count(x =>
            x.Status == AttendanceStatus.SickLeave);


    private int FamilyLeaveCount =>
        Attendance.Count(x =>
            x.Status == AttendanceStatus.FamilyLeave);






    private AttendanceFilter SelectedFilter = AttendanceFilter.Present;
    private bool includeAllStaff;
    private bool loading;
    private string? loadError;


    private IEnumerable<TeamAttendanceDto> FilteredAttendance =>
        SelectedFilter switch
        {
            AttendanceFilter.Present =>
                Attendance.Where(x => x.Status == AttendanceStatus.Present),

            AttendanceFilter.Late =>
                Attendance.Where(x => x.Status == AttendanceStatus.Late),

            AttendanceFilter.Absent =>
                Attendance.Where(x => x.Status == AttendanceStatus.Absent),

            AttendanceFilter.NoCheckout =>
                Attendance.Where(x => x.Status == AttendanceStatus.MissingCheckout),

            AttendanceFilter.SickLeave =>
                Attendance.Where(x => x.Status == AttendanceStatus.SickLeave),

            AttendanceFilter.FamilyLeave =>
                Attendance.Where(x => x.Status == AttendanceStatus.FamilyLeave),

            _ => Attendance
        };

  
    private string TabClass(AttendanceFilter tab)
    {
        return SelectedFilter == tab
            ? "bg-slate-50 p-2 text-center"
            : "hover:bg-slate-50 p-2 text-center";
    }




    protected override Task OnInitializedAsync() => LoadAttendanceAsync();

    private async Task SelectScopeAsync(bool allStaff)
    {
        if (includeAllStaff == allStaff) return;
        includeAllStaff = allStaff;
        await LoadAttendanceAsync();
    }

    private async Task LoadAttendanceAsync()
    {
        loading = true;
        loadError = null;
        try { Attendance = await AttendanceLogService.GetMyTeamAttendanceTodayAsync(includeAllStaff); }
        catch (UnauthorizedAccessException) { Attendance = []; loadError = "You do not have organisation-wide attendance access. Choose My teams / groups or ask an administrator for Attendance.View access."; includeAllStaff = false; }
        catch (Exception ex) { Logger.LogError(ex, "Unable to load today's team attendance for {Scope}.", includeAllStaff ? "all staff" : "managed teams"); Attendance = []; loadError = "Attendance could not be loaded. Please try again."; }
        finally { loading = false; }
    }

    private string GetStatusColor(AttendanceStatus status)
    {
        return status switch
        {
            AttendanceStatus.Present => "bg-green-500",

            AttendanceStatus.Late => "bg-amber-500",

            AttendanceStatus.MissingCheckout => "bg-blue-500",

            AttendanceStatus.Absent => "bg-red-500",

            AttendanceStatus.SickLeave => "bg-purple-500",

            AttendanceStatus.FamilyLeave => "bg-pink-500",

            _ => "bg-slate-400"
        };
    }
}
