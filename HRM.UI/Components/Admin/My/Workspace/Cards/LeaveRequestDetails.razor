@using HRM.Components.Cards
@using HRM.Components.Pages.Online.Leave
@using HRM.DTOs.Leave

<BaseCard Title="Leave Request Details">
    <section aria-label="Leave request details" aria-busy="@Busy" class="p-2 space-y-2">
        <div class="flex flex-wrap justify-between items-start gap-2">
            <div>
                <h2 class="text-sm font-semibold text-slate-800">@Item.Applicant</h2>
                <p class="text-xs text-slate-500">@Item.Reference · @Item.LeaveType</p>
            </div>
            <button type="button" disabled="@Busy" class="border rounded px-2.5 py-1 text-xs disabled:opacity-50" @onclick="OnClose">Close details</button>
        </div>
        <div class="rounded-lg border bg-slate-50 p-2 space-y-1">
            <p class="font-medium text-xs">@Item.FromDate.ToString("dd MMM yyyy") – @Item.ToDate.ToString("dd MMM yyyy") · @Item.Duration days</p>
            <p class="text-xs text-amber-700">@(Item.IsProcessing ? "Processing · " : "")@Item.Status</p>
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            <div class="sm:col-span-2"><HRM.Components.Leave.LeaveSubtypeEvidence LeaveId="Item.LeaveId" /></div>
            <div><dt class="font-medium text-slate-500">Reason</dt><dd class="mt-0.5">@Display(Item.Reason)</dd></div>
            <div><dt class="font-medium text-slate-500">Contact</dt><dd class="mt-0.5">@Display(Item.Contact)</dd></div>
            <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Additional details</dt><dd class="mt-0.5 whitespace-pre-wrap break-words">@Display(Item.Explanation)</dd></div>
            <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Leave address</dt><dd class="mt-0.5 whitespace-pre-wrap break-words">@Display(Item.Address)</dd></div>
            <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Work handover</dt><dd class="mt-0.5">@Item.HandoverStatus
                @if (Item.HasHandover) { <span class="text-[10px] font-semibold text-slate-600 mt-0.5 block">Work handover assigned</span> }
            </dd></div>
        </dl>
        <div class="border-t pt-2 space-y-2">
            <h3 class="font-semibold">Request actions</h3>
            @if (Item.IsOwnLeave)
            {
                <p class="text-sm text-slate-500">You cannot verify or approve your own leave.</p>
            }
            @if (Item.CanEdit)
            {
                <MyLeaveApplications @key="Item.RequestId" EditorOnly="true" EditRequestId="Item.RequestId"
                                     OnSaved="OnChanged" OnClose="OnChanged" />
            }
            @if (Message != null) { <p role="status" class="text-sm">@Message</p> }
            @if (Busy) { <p role="status" class="text-sm text-slate-500">Saving status change…</p> }
            @if (Item.Actions.Count > 0 && Item.ActionsMessage != null) { <p role="status" class="text-sm text-amber-700">@Item.ActionsMessage</p> }
            <RequestActionButtons @key="Item.RequestId" Actions="Item.Actions" EmptyMessage="Item.ActionsMessage" Disabled="Busy" OnExecute="OnExecute" />
        </div>
    </section>
</BaseCard>

@code {
    [Parameter, EditorRequired] public PendingLeaveRequestDto Item { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RequestActionSubmissionDto> OnExecute { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
}
