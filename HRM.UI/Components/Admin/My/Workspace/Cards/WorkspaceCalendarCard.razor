@using HRM.DTOs.Leave
@using HRM.DTOs.Calendar
@inject HRM.Services.Leave.Contracts.LeaveCalendarServiceContracts.IOperations CalendarService
@inject HRM.Services.Calendar.Contracts.OrganisationEventServiceContracts.IOperations EventService
@inject ILogger<WorkspaceCalendarCard> Logger

<div class="space-y-4">
    <!-- Sub-tab switch: Supervisor vs Organisation Calendar -->
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
        <div class="flex items-center gap-1 rounded-xl bg-slate-100 dark:bg-slate-800 p-1">
            <button type="button"
                    class="rounded-lg px-3 py-1.5 text-xs font-bold transition @(activeSubTab == CalendarSubTab.Supervisor ? "bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                    @onclick="() => activeSubTab = CalendarSubTab.Supervisor">
                👥 Supervisor Calendar
            </button>
            <button type="button"
                    class="rounded-lg px-3 py-1.5 text-xs font-bold transition @(activeSubTab == CalendarSubTab.Organisation ? "bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                    @onclick="() => activeSubTab = CalendarSubTab.Organisation">
                🏢 Organisation Calendar
            </button>
            <button type="button"
                    class="rounded-lg px-3 py-1.5 text-xs font-bold transition @(activeSubTab == CalendarSubTab.Personal ? "bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                    @onclick="() => activeSubTab = CalendarSubTab.Personal">
                👤 My Leave Plans
            </button>
        </div>
        <div>
            <a href="/admin/hr/events" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">
                <span>Manage Organisation Events</span>
                <span>→</span>
            </a>
        </div>
    </div>

    @if (activeSubTab == CalendarSubTab.Supervisor)
    {
        <SupervisorCalendarCard />
    }
    else if (activeSubTab == CalendarSubTab.Organisation)
    {
        <OrganisationCalendarCard />
    }
    else
    {
        <!-- Legacy Personal / Team Leave Card Content -->
        <header class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Team &amp; Personal Calendar Command Center
                </h2>
                <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800 px-2.5 py-0.5 text-xs font-semibold">
                    @month.ToString("MMMM yyyy")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Review scheduled leaves, team absences, public events, and plan upcoming time off.
            </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <div class="inline-flex items-center rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-0.5">
                <button type="button"
                        class="rounded-md px-2.5 py-1 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 disabled:opacity-50 transition"
                        disabled="@busy"
                        @onclick="() => MoveMonthAsync(-1)"
                        title="Previous Month">
                    ‹ Prev
                </button>
                <span class="px-2.5 text-xs font-bold text-slate-800 dark:text-slate-100">
                    @month.ToString("MMM yyyy")
                </span>
                <button type="button"
                        class="rounded-md px-2.5 py-1 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 disabled:opacity-50 transition"
                        disabled="@busy"
                        @onclick="() => MoveMonthAsync(1)"
                        title="Next Month">
                    Next ›
                </button>
            </div>

            <button type="button"
                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                    disabled="@busy"
                    @onclick="GoToTodayAsync">
                Today
            </button>

            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                    disabled="@busy"
                    @onclick="LoadCalendarAsync">
                <span class="@(busy ? "animate-spin" : "")">↻</span>
                <span>Refresh</span>
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div role="status" class="flex items-center justify-between rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50 dark:bg-emerald-950/50 p-3 text-xs text-emerald-900 dark:text-emerald-200 shadow-2xs">
            <div class="flex items-center gap-2">
                <span>ℹ️</span>
                <span>@message</span>
            </div>
            <button type="button" class="font-bold text-emerald-700 dark:text-emerald-400 hover:text-emerald-900" @onclick="() => message = null">✕</button>
        </div>
    }

    <!-- TWO-COLUMN LAYOUT: Left (Calendar Grid & CRUD) and Right (List of Calendar Items) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
        
        <!-- LEFT COLUMN: Calendar Grid + CRUD (6 Cols) -->
        <div class="lg:col-span-6 min-w-0 space-y-4">
            
            <!-- CARD 1: Monthly Calendar Grid (Fully styled with high contrast dark mode) -->
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2.5">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                            Month View: @month.ToString("MMMM yyyy")
                        </h3>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            Click any date to view day items or prefill the plan form.
                        </p>
                    </div>
                    @if (selected.HasValue)
                    {
                        <span class="rounded-full bg-blue-100 dark:bg-blue-950/70 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 px-2.5 py-0.5 text-[11px] font-bold">
                            Selected: @selected.Value.ToString("dd MMM")
                        </span>
                    }
                </div>

                <!-- 7-Day Grid Container with explicit dark-mode borders -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-700/80 overflow-hidden shadow-2xs">
                    <!-- Weekday Header Row -->
                    <div class="grid grid-cols-7 bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700/80 text-center font-bold text-xs py-2 text-slate-700 dark:text-slate-200">
                        @foreach (var name in weekDays)
                        {
                            <span>@name</span>
                        }
                    </div>

                    <!-- Days Grid -->
                    <div class="grid grid-cols-7 divide-x divide-y divide-slate-200 dark:divide-slate-700/80 bg-white dark:bg-slate-900 text-xs">
                        @for (var i = 0; i < (int)month.DayOfWeek; i++)
                        {
                            <div class="min-h-12 bg-slate-50/60 dark:bg-slate-950/40"></div>
                        }

                        @for (var i = 1; i <= DateTime.DaysInMonth(month.Year, month.Month); i++)
                        {
                            var day = month.AddDays(i - 1);
                            var dayEvents = OnDay(day).ToList();
                            var dayOrgEvents = EventsOnDay(day).ToList();
                            var isSelected = selected == day;
                            var isToday = day == Today;
                            var isWeekend = day.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday;

                            <button type="button"
                                    disabled="@busy"
                                    aria-label="@(day.ToString("dd MMM yyyy") + ", " + dayEvents.Count + " entries, " + dayOrgEvents.Count + " organisation events")"
                                    aria-pressed="@isSelected"
                                    class="min-h-12 p-1.5 flex flex-col items-center justify-between transition-colors cursor-pointer text-left focus:outline-none focus:ring-1 focus:ring-blue-500
                                           @(isSelected ? "bg-blue-600 text-white dark:bg-blue-600 font-bold shadow-xs" :
                                             isToday ? "bg-blue-50/70 dark:bg-blue-950/40 ring-2 ring-inset ring-blue-500/80 text-blue-900 dark:text-blue-200 font-bold" :
                                             isWeekend ? "bg-slate-50/60 dark:bg-slate-800/40 text-slate-500 dark:text-slate-400" :
                                             "bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200")
                                           hover:bg-blue-50/80 dark:hover:bg-slate-800"
                                    @onclick="() => SelectDate(day)">
                                <div class="w-full flex items-center justify-between">
                                    <span class="text-xs font-semibold @(isSelected ? "text-white" : isToday ? "text-blue-700 dark:text-blue-400 font-bold" : "text-slate-700 dark:text-slate-300")">
                                        @i
                                    </span>
                                    @if (isToday && !isSelected)
                                    {
                                        <span class="text-[9px] font-bold text-blue-600 dark:text-blue-400">Today</span>
                                    }
                                </div>

                                <!-- Dots & event indicators -->
                                <div class="w-full flex flex-col gap-0.5 mt-1">
                                    <div class="flex items-center justify-center gap-1">
                                        @if (dayEvents.Any(x => x.IsPlan))
                                        {
                                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500 shadow-2xs" title="Planned leave"></span>
                                        }
                                        @if (dayEvents.Any(x => !x.IsPlan))
                                        {
                                            <span class="h-1.5 w-1.5 rounded-full bg-blue-500 shadow-2xs" title="Approved/Submitted leave"></span>
                                        }
                                        @if (dayOrgEvents.Count > 0)
                                        {
                                            <span class="h-1.5 w-1.5 rounded-full bg-purple-600 dark:bg-purple-400 shadow-2xs" title="Organisation event"></span>
                                        }
                                    </div>

                                    @foreach (var oev in dayOrgEvents.Take(1))
                                    {
                                        <div @onclick:stopPropagation="true"
                                             @onclick="() => selectedOrgEventModal = oev"
                                             class="w-full truncate rounded px-1 text-[9px] leading-tight font-semibold border cursor-pointer transition shadow-2xs
                                                    @(isSelected ? "bg-white text-purple-900 border-white hover:bg-purple-100" :
                                                      "bg-purple-100 text-purple-900 dark:bg-purple-950/80 dark:text-purple-200 border border-purple-200 dark:border-purple-800/60 hover:bg-purple-200 dark:hover:bg-purple-900")"
                                             title="@($"🏛️ {oev.Title} (Click to view details)")">
                                            🏛️ @oev.Title
                                        </div>
                                    }

                                    @foreach (var ev in dayEvents.Where(x => x.From.Date == day.Date).Take(1))
                                    {
                                        <div class="w-full truncate rounded px-1 text-[9px] leading-tight font-medium
                                                    @(isSelected ? "bg-white/20 text-white" :
                                                      ev.IsPlan ? "bg-amber-100 text-amber-900 dark:bg-amber-950/80 dark:text-amber-200 border border-amber-200 dark:border-amber-800/60" :
                                                      "bg-blue-100 text-blue-900 dark:bg-blue-950/80 dark:text-blue-200 border border-blue-200 dark:border-blue-800/60")"
                                             title="@($"{ev.Person} · {ev.Title}")">
                                            @GetFirstWord(ev.Person)
                                        </div>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                </div>

                <!-- Legend -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-600 dark:text-slate-400">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex items-center gap-1">
                            <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                            <span>Planned Leave</span>
                        </span>
                        <span class="inline-flex items-center gap-1">
                            <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                            <span>Approved / Official</span>
                        </span>
                        <span class="inline-flex items-center gap-1">
                            <span class="h-2 w-2 rounded-full bg-purple-600"></span>
                            <span>Organisation Event</span>
                        </span>
                    </div>
                    <span class="text-slate-400 dark:text-slate-500">Blue border: Today</span>
                </div>
            </div>

            <!-- CARD 2: The CRUD Form (Plan Leave / Calendar Entry) -->
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2.5">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                            <span>@(editingPlanId.HasValue ? "✏️ Update Leave Plan" : "📅 Plan Leave / Calendar Entry")</span>
                        </h3>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                            Schedule upcoming planned time off visible to supervisors without deducting leave balance.
                        </p>
                    </div>
                    @if (editingPlanId.HasValue)
                    {
                        <button type="button"
                                class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-semibold"
                                @onclick="ResetCrudForm">
                            Cancel Edit
                        </button>
                    }
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300">
                            Plan Title *
                        </label>
                        <input type="text"
                               class="mt-1 block w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                               maxlength="100"
                               placeholder="e.g. Annual Family Vacation, Study Leave, Rest & Recuperation"
                               disabled="@busy"
                               @bind="crudTitle" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 dark:text-slate-300">
                                From Date *
                            </label>
                            <input type="date"
                                   class="mt-1 block w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                   disabled="@busy"
                                   @bind="crudFrom" />
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 dark:text-slate-300">
                                To Date *
                            </label>
                            <input type="date"
                                   class="mt-1 block w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                   disabled="@busy"
                                   @bind="crudTo" />
                        </div>
                    </div>

                    <div class="rounded-xl border border-blue-100 dark:border-blue-900/40 bg-blue-50/60 dark:bg-blue-950/30 p-2.5 text-[11px] text-blue-800 dark:text-blue-300">
                        Planning leave notifies team supervisors in advance. It does not submit a final application or alter balances.
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 px-3.5 py-1.5 text-xs font-semibold text-white shadow-2xs disabled:opacity-50 transition"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(crudTitle))"
                                    @onclick="SaveCrudPlanAsync">
                                <span>✓</span>
                                <span>@(editingPlanId.HasValue ? "Update Plan" : "Save Leave Plan")</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    disabled="@busy"
                                    @onclick="ResetCrudForm">
                                Clear
                            </button>
                        </div>

                        @if (editingPlanId.HasValue)
                        {
                            <button type="button"
                                    class="inline-flex items-center justify-center gap-1 rounded-lg border border-rose-200 dark:border-rose-900/60 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition"
                                    disabled="@busy"
                                    @onclick="() => RemovePlanAsync(editingPlanId.Value)">
                                🗑 Delete Plan
                            </button>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: List of Calendar Items (6 Cols) -->
        <div class="lg:col-span-6 min-w-0 space-y-4">
            
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between flex-wrap gap-2 border-b border-slate-100 dark:border-slate-800 pb-2.5">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                            <span>📋 Calendar Items &amp; Team Absences</span>
                        </h3>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                            Comprehensive record of scheduled team leaves and planned employee absences.
                        </p>
                    </div>
                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs font-bold text-slate-700 dark:text-slate-300">
                        @FilteredEntries.Count() items
                    </span>
                </div>

                <!-- Scope Filter & Search Bar -->
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                    <div class="inline-flex items-center rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-slate-50 dark:bg-slate-800">
                        <button type="button"
                                class="rounded-md px-2.5 py-1 font-semibold transition @(filterScope == "month" ? "bg-white dark:bg-slate-700 text-blue-700 dark:text-blue-300 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                @onclick='() => filterScope = "month"'>
                            All Month (@entries.Count)
                        </button>
                        <button type="button"
                                class="rounded-md px-2.5 py-1 font-semibold transition @(filterScope == "selected" ? "bg-white dark:bg-slate-700 text-blue-700 dark:text-blue-300 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                @onclick='() => filterScope = "selected"'>
                            Selected Day (@(selected.HasValue ? OnDay(selected.Value).Count() : 0))
                        </button>
                        <button type="button"
                                class="rounded-md px-2.5 py-1 font-semibold transition @(filterScope == "mine" ? "bg-white dark:bg-slate-700 text-blue-700 dark:text-blue-300 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                @onclick='() => filterScope = "mine"'>
                            My Plans (@entries.Count(x => x.IsOwner))
                        </button>
                    </div>

                    <div class="w-full sm:w-auto flex-1 min-w-[10rem]">
                        <input type="text"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                               placeholder="Filter by name or title..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>
                </div>

                @if (selected.HasValue && EventsOnDay(selected.Value).Any())
                {
                    var dayOrgEvents = EventsOnDay(selected.Value).ToList();
                    <div class="rounded-xl border border-purple-200 dark:border-purple-800/60 bg-purple-50/50 dark:bg-purple-950/30 p-3 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-purple-900 dark:text-purple-200 flex items-center gap-1.5">
                                <span>🏛️ Organisation Events on @selected.Value.ToString("dd MMM")</span>
                            </span>
                            <span class="rounded-full bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 px-2 py-0.5 text-[10px] font-bold">
                                @dayOrgEvents.Count
                            </span>
                        </div>
                        <div class="space-y-1.5">
                            @foreach (var oev in dayOrgEvents)
                            {
                                <div class="flex items-center justify-between p-2 rounded-lg bg-white dark:bg-slate-900 border border-purple-100 dark:border-purple-800/40 text-xs">
                                    <div class="min-w-0 pr-2">
                                        <div class="font-bold text-slate-900 dark:text-slate-100 truncate">@oev.Title</div>
                                        <div class="text-[11px] text-slate-500 flex items-center gap-2">
                                            <span>@oev.Category</span>
                                            <span>·</span>
                                            <span>@(oev.IsAllDay ? "All-day" : $"{oev.StartDateTime:HH:mm} – {oev.EndDateTime:HH:mm}")</span>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="shrink-0 rounded-md bg-purple-600 hover:bg-purple-700 text-white px-2.5 py-1 text-xs font-semibold shadow-2xs transition"
                                            @onclick="() => selectedOrgEventModal = oev">
                                        View
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Calendar Items List -->
                @if (!FilteredEntries.Any())
                {
                    <div class="rounded-xl border border-dashed border-slate-200 dark:border-slate-800 p-8 text-center text-xs text-slate-500 dark:text-slate-400 space-y-1">
                        <span class="text-2xl">📅</span>
                        <p class="font-semibold text-slate-700 dark:text-slate-300">No Calendar Entries Found</p>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px]">
                            @(filterScope == "selected" && selected.HasValue
                                ? $"No leave entries scheduled for {selected.Value:dd MMM yyyy}."
                                : "No leave or planning records match the active month or search filter.")
                        </p>
                    </div>
                }
                else
                {
                    <div class="space-y-2.5 max-h-[36rem] overflow-y-auto pr-1">
                        @foreach (var entry in FilteredEntries)
                        {
                            var isSelectedDay = selected.HasValue && entry.From.Date <= selected.Value.Date && entry.To.Date >= selected.Value.Date;
                            var durationDays = Math.Max(1, (int)(entry.To.Date - entry.From.Date).TotalDays + 1);

                            <div @key="@($"{entry.Id}-{entry.PersonId}-{entry.IsPlan}")"
                                 class="rounded-xl border p-3 text-xs transition-colors space-y-2 cursor-pointer
                                        @(isSelectedDay ? "border-blue-300 dark:border-blue-800 bg-blue-50/40 dark:bg-blue-950/20 shadow-2xs" :
                                          "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50/70 dark:hover:bg-slate-800/50 shadow-2xs")"
                                 @onclick="() => SelectDate(entry.From)">
                                
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="h-8 w-8 rounded-full flex items-center justify-center font-bold text-xs shrink-0
                                                    @(entry.IsOwner ? "bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300" :
                                                      "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">
                                            @GetInitials(entry.Person)
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <h4 class="font-bold text-slate-900 dark:text-slate-100 truncate">
                                                    @(entry.IsOwner ? "You" : entry.Person)
                                                </h4>
                                                @if (entry.IsOwner)
                                                {
                                                    <span class="rounded bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800 px-1.5 py-0.2 text-[9px] font-bold">
                                                        You
                                                    </span>
                                                }
                                            </div>
                                            <p class="text-[11px] font-medium text-slate-600 dark:text-slate-300 truncate mt-0.5">
                                                @entry.Title
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold border
                                                     @(entry.IsPlan ? "bg-amber-50 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300 border-amber-200 dark:border-amber-800/60" :
                                                       entry.Status == "Approved" ? "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/60" :
                                                       "bg-blue-50 text-blue-800 dark:bg-blue-950/70 dark:text-blue-300 border-blue-200 dark:border-blue-800/60")">
                                            @(entry.IsPlan ? "🟠 Planned" : $"🔵 {entry.Status}")
                                        </span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 pt-1 border-t border-slate-100 dark:border-slate-800">
                                    <div class="flex items-center gap-1.5">
                                        <span>📅 @entry.From.ToString("dd MMM yyyy")</span>
                                        <span>→</span>
                                        <span>@entry.To.ToString("dd MMM yyyy")</span>
                                        <span class="font-semibold text-slate-700 dark:text-slate-300">(@durationDays d)</span>
                                    </div>

                                    @if (entry.IsPlan && entry.IsOwner)
                                    {
                                        <div class="inline-flex items-center gap-1.5">
                                            <button type="button"
                                                    class="text-blue-600 dark:text-blue-400 hover:underline font-semibold text-[11px]"
                                                    @onclick:stopPropagation
                                                    @onclick="() => EditPlanInCrud(entry)">
                                                Edit
                                            </button>
                                            <span class="text-slate-300 dark:text-slate-700">·</span>
                                            <button type="button"
                                                    class="text-rose-600 dark:text-rose-400 hover:underline font-semibold text-[11px]"
                                                    @onclick:stopPropagation
                                                    @onclick="() => RemovePlanAsync(entry.Id)">
                                                Delete
                                            </button>
                                        </div>
                                    }
                                </div>

                            </div>
                        }
                    </div>
                }
            </div>

        </div>

    </div>
    }
</div>

@if (selectedOrgEventModal != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 overflow-y-auto"
         role="dialog"
         aria-modal="true"
         aria-labelledby="workspace-event-modal-title"
         @onclick="() => selectedOrgEventModal = null">
        <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl p-6 text-slate-800 dark:text-slate-100 max-h-[90vh] overflow-y-auto space-y-4"
             @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="flex items-start justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                <div class="space-y-1.5">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="rounded-full bg-purple-100 dark:bg-purple-950 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800 px-2.5 py-0.5 text-xs font-semibold">
                            🏛️ @selectedOrgEventModal.Category
                        </span>
                        @if (selectedOrgEventModal.CalendarImpactType != "None")
                        {
                            <span class="rounded-full bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 px-2.5 py-0.5 text-xs font-semibold">
                                ⚑ @selectedOrgEventModal.CalendarImpactType
                            </span>
                        }
                        <span class="rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-2.5 py-0.5 text-xs font-semibold">
                            @(selectedOrgEventModal.AttendanceRequirement == "Mandatory" ? "⚠️ Mandatory" : selectedOrgEventModal.AttendanceRequirement == "Optional" ? "Optional" : "Info Only")
                        </span>
                    </div>
                    <h3 id="workspace-event-modal-title" class="text-base font-bold text-slate-900 dark:text-slate-100">
                        @selectedOrgEventModal.Title
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.EventCode))
                    {
                        <p class="text-[11px] text-slate-400 font-mono">Code: @selectedOrgEventModal.EventCode</p>
                    }
                </div>
                <button type="button"
                        aria-label="Close modal"
                        class="rounded-lg p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                        @onclick="() => selectedOrgEventModal = null">
                    <span class="text-lg leading-none font-bold">✕</span>
                </button>
            </div>

            <!-- Modal Body Details -->
            <div class="space-y-3 text-xs">
                <!-- Date & Time Card -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 space-y-1">
                    <div class="flex items-center gap-1.5 font-bold text-slate-700 dark:text-slate-300">
                        <span>🗓 Date &amp; Time</span>
                    </div>
                    <div class="text-slate-900 dark:text-slate-100 font-medium">
                        @if (selectedOrgEventModal.StartDateTime.Date == selectedOrgEventModal.EndDateTime.Date)
                        {
                            <div>@selectedOrgEventModal.StartDateTime.ToString("dddd, dd MMMM yyyy")</div>
                            <div class="text-slate-500 dark:text-slate-400 text-[11px] mt-0.5">
                                @(selectedOrgEventModal.IsAllDay ? "All-Day Event" : $"{selectedOrgEventModal.StartDateTime:HH:mm} – {selectedOrgEventModal.EndDateTime:HH:mm} ({selectedOrgEventModal.TimeZoneId})")
                            </div>
                        }
                        else
                        {
                            <div>From: @selectedOrgEventModal.StartDateTime.ToString("dd MMM yyyy, HH:mm")</div>
                            <div>To: @selectedOrgEventModal.EndDateTime.ToString("dd MMM yyyy, HH:mm")</div>
                            <div class="text-slate-500 dark:text-slate-400 text-[11px] mt-0.5">(@selectedOrgEventModal.TimeZoneId)</div>
                        }
                    </div>
                </div>

                <!-- Location & Online Meeting -->
                @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.VenueName) || !string.IsNullOrWhiteSpace(selectedOrgEventModal.VenueAddress) || !string.IsNullOrWhiteSpace(selectedOrgEventModal.MeetingUrl))
                {
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 space-y-1">
                        <div class="flex items-center gap-1.5 font-bold text-slate-700 dark:text-slate-300">
                            <span>📍 Location &amp; Online Access</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.VenueName))
                        {
                            <div class="font-medium text-slate-900 dark:text-slate-100">
                                @selectedOrgEventModal.VenueName
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.VenueAddress))
                        {
                            <div class="text-slate-600 dark:text-slate-400 text-[11px]">
                                @selectedOrgEventModal.VenueAddress
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.MeetingUrl))
                        {
                            <div class="pt-1">
                                <a href="@selectedOrgEventModal.MeetingUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="inline-flex items-center gap-1 font-bold text-blue-600 dark:text-blue-400 hover:underline">
                                    <span>🔗 Join Online Meeting</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        }
                    </div>
                }

                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.Description))
                {
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-300 mb-1">Description</h4>
                        <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">
                            @selectedOrgEventModal.Description
                        </p>
                    </div>
                }

                <!-- Attendance Instructions / Dress Code / Required Items -->
                @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.DressCode) || !string.IsNullOrWhiteSpace(selectedOrgEventModal.RequiredItems))
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.DressCode))
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">👔 Dress Code</div>
                                <div class="font-medium text-slate-900 dark:text-slate-100 mt-0.5">@selectedOrgEventModal.DressCode</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.RequiredItems))
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">🎒 Required Items</div>
                                <div class="font-medium text-slate-900 dark:text-slate-100 mt-0.5">@selectedOrgEventModal.RequiredItems</div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.AttendanceInstructions))
                {
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-300 mb-1">Attendance Instructions</h4>
                        <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2.5 text-slate-700 dark:text-slate-300 whitespace-pre-wrap">
                            @selectedOrgEventModal.AttendanceInstructions
                        </p>
                    </div>
                }

                <!-- Contact & Notes -->
                @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.ContactInformation))
                {
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">📞 Contact &amp; Organizer</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100 mt-0.5">@selectedOrgEventModal.ContactInformation</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedOrgEventModal.AdditionalNotes))
                {
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-300 mb-1">Additional Notes</h4>
                        <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2.5 text-slate-700 dark:text-slate-300 whitespace-pre-wrap">
                            @selectedOrgEventModal.AdditionalNotes
                        </p>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end border-t border-slate-100 dark:border-slate-800 pt-3">
                <button type="button"
                        class="rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        @onclick="() => selectedOrgEventModal = null">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static DateTime Today => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Indian/Maldives").Date;
    private readonly string[] weekDays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private DateTime month = new(Today.Year, Today.Month, 1);
    private DateTime? selected = Today;
    private List<LeaveCalendarEntry> entries = [];
    private List<OrganisationEventDto> orgEvents = [];
    private OrganisationEventDto? selectedOrgEventModal;
    private bool busy;
    private string? message;
    private string filterScope = "month"; // "month", "selected", "mine"
    private string searchQuery = "";

    // CRUD Form state
    private int? editingPlanId;
    private string crudTitle = "";
    private DateTime crudFrom = Today;
    private DateTime crudTo = Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadCalendarAsync();
    }

    private IEnumerable<LeaveCalendarEntry> OnDay(DateTime day) =>
        entries.Where(x => x.From.Date <= day.Date && x.To.Date >= day.Date);

    private IEnumerable<OrganisationEventDto> EventsOnDay(DateTime day) =>
        orgEvents.Where(x => x.StartDateTime.Date <= day.Date && x.EndDateTime.Date >= day.Date);

    private IEnumerable<LeaveCalendarEntry> FilteredEntries
    {
        get
        {
            var query = entries.AsEnumerable();

            if (filterScope == "selected" && selected.HasValue)
            {
                query = query.Where(x => x.From.Date <= selected.Value.Date && x.To.Date >= selected.Value.Date);
            }
            else if (filterScope == "mine")
            {
                query = query.Where(x => x.IsOwner);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim().ToLowerInvariant();
                query = query.Where(x => (x.Person?.ToLowerInvariant().Contains(term) ?? false) ||
                                         (x.Title?.ToLowerInvariant().Contains(term) ?? false) ||
                                         (x.Status?.ToLowerInvariant().Contains(term) ?? false));
            }

            return query.OrderBy(x => x.From).ThenBy(x => x.Person);
        }
    }

    private async Task MoveMonthAsync(int direction)
    {
        month = month.AddMonths(direction);
        selected = null;
        ResetCrudForm();
        await LoadCalendarAsync();
    }

    private async Task GoToTodayAsync()
    {
        month = new DateTime(Today.Year, Today.Month, 1);
        selected = Today;
        crudFrom = Today;
        crudTo = Today;
        await LoadCalendarAsync();
    }

    private void SelectDate(DateTime day)
    {
        selected = day;
        if (!editingPlanId.HasValue)
        {
            crudFrom = day;
            crudTo = day;
        }
    }

    private void EditPlanInCrud(LeaveCalendarEntry plan)
    {
        editingPlanId = plan.Id;
        crudTitle = plan.Title;
        crudFrom = plan.From.Date;
        crudTo = plan.To.Date;
        selected = plan.From.Date;
    }

    private void ResetCrudForm()
    {
        editingPlanId = null;
        crudTitle = "";
        crudFrom = selected ?? Today;
        crudTo = selected ?? Today;
    }

    private async Task LoadCalendarAsync()
    {
        busy = true;
        try
        {
            entries = await CalendarService.LoadAsync(month, includeTeam: true);
        }
        catch (Exception ex)
        {
            entries = [];
            Logger.LogError(ex, "Could not load workspace leave calendar.");
            message = "Unable to load calendar data. Please retry.";
        }

        try
        {
            var startOfMonth = new DateTime(month.Year, month.Month, 1);
            var endOfMonth = startOfMonth.AddMonths(1).AddDays(1);
            orgEvents = await EventService.ListAsync(startOfMonth, endOfMonth, null, "Published", null, null, false);
        }
        catch (Exception ex)
        {
            orgEvents = [];
            Logger.LogWarning(ex, "Could not load organisation events for workspace leave calendar.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveCrudPlanAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(crudTitle)) return;
        busy = true;
        message = null;

        try
        {
            if (editingPlanId.HasValue)
            {
                // Remove previous plan, then save updated plan
                await CalendarService.RemovePlanAsync(editingPlanId.Value);
            }

            await CalendarService.SavePlanAsync(crudFrom, crudTo, crudTitle);
            message = editingPlanId.HasValue ? "Leave plan updated successfully." : "Leave plan saved successfully.";
            ResetCrudForm();
            await LoadCalendarAsync();
        }
        catch (InvalidOperationException ex)
        {
            message = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save leave plan.");
            message = "Could not save plan. Please check inputs and retry.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemovePlanAsync(int planId)
    {
        if (busy) return;
        busy = true;
        message = null;

        try
        {
            await CalendarService.RemovePlanAsync(planId);
            if (editingPlanId == planId)
            {
                ResetCrudForm();
            }
            message = "Leave plan removed.";
            await LoadCalendarAsync();
        }
        catch (InvalidOperationException ex)
        {
            message = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not remove leave plan {PlanId}", planId);
            message = "Unable to remove leave plan. Please retry.";
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetFirstWord(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var parts = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[0] : "";
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "E";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private enum CalendarSubTab
    {
        Supervisor,
        Organisation,
        Personal
    }

    private CalendarSubTab activeSubTab = CalendarSubTab.Supervisor;
}
