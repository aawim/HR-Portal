@using HRM.DTOs.Calendar
@inject HRM.Services.Calendar.Contracts.OrganisationCalendarServiceContracts.IOperations OrgCalendarService
@inject HRM.Services.ToastService Toasts

<div class="space-y-4">
    <!-- Header / Controls -->
    <header class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Organisation Calendar
                </h3>
                <span class="rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 px-2.5 py-0.5 text-xs font-semibold">
                    @month.ToString("MMMM yyyy")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Official organisation events, public holidays, working day exceptions, and approved staff leave overviews.
            </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <div class="inline-flex items-center rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-0.5">
                <button type="button"
                        class="rounded-md px-2.5 py-1 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 disabled:opacity-50 transition"
                        disabled="@busy"
                        @onclick="() => MoveMonthAsync(-1)"
                        title="Previous Month">
                    ‹ Prev
                </button>
                <span class="px-2.5 text-xs font-bold text-slate-800 dark:text-slate-100">
                    @month.ToString("MMM yyyy")
                </span>
                <button type="button"
                        class="rounded-md px-2.5 py-1 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 disabled:opacity-50 transition"
                        disabled="@busy"
                        @onclick="() => MoveMonthAsync(1)"
                        title="Next Month">
                    Next ›
                </button>
            </div>

            <button type="button"
                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                    disabled="@busy"
                    @onclick="GoToTodayAsync">
                Today
            </button>

            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                    disabled="@busy"
                    @onclick="LoadMonthAsync">
                <span class="@(busy ? "animate-spin" : "")">↻</span>
                <span>Refresh</span>
            </button>
        </div>
    </header>

    <!-- Main View: Grid & Selected Day Details -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
        <!-- Calendar Grid -->
        <div class="lg:col-span-8 min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
            <div class="grid grid-cols-7 gap-1 text-center font-bold text-xs text-slate-600 dark:text-slate-400 pb-2 border-b border-slate-100 dark:border-slate-800">
                <!-- Maldives Standard Week begins on Sunday -->
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div class="text-rose-500">Fri</div>
                <div class="text-rose-500">Sat</div>
            </div>

            <div class="grid grid-cols-7 gap-1">
                @for (int i = 0; i < leadingOffset; i++)
                {
                    <div class="h-24 p-1 rounded-lg bg-slate-50/50 dark:bg-slate-800/20 border border-transparent"></div>
                }

                @foreach (var day in days)
                {
                    var isSelected = selectedDate.HasValue && selectedDate.Value.Date == day.Date.Date;
                    var isToday = day.Date.Date == DateTime.Today;
                    var res = day.WorkdayResolution;

                    <div class="h-28 p-1.5 rounded-xl border flex flex-col justify-between transition cursor-pointer @(isSelected ? "border-blue-500 ring-2 ring-blue-500/20 bg-blue-50/30 dark:bg-blue-950/20" : isToday ? "border-amber-400 bg-amber-50/20 dark:bg-amber-950/10" : !res.IsWorkingDay ? "border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700")"
                         @onclick="() => SelectDayAsync(day.Date)">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold @(isToday ? "text-amber-600 dark:text-amber-400" : !res.IsWorkingDay ? "text-rose-600 dark:text-rose-400" : "text-slate-800 dark:text-slate-200")">
                                @day.Date.Day
                            </span>
                            @if (res.IsSpecialWorkingDay)
                            {
                                <span class="text-[10px] bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-semibold px-1 py-0.2 rounded" title="Special Working Day">
                                    Special Work
                                </span>
                            }
                            else if (res.IsHoliday && res.NormalWeekday is not (DayOfWeek.Friday or DayOfWeek.Saturday))
                            {
                                <span class="text-[10px] bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-300 font-semibold px-1 py-0.2 rounded" title="Holiday / Non-Working">
                                    Holiday
                                </span>
                            }
                        </div>

                        <!-- Micro Indicators -->
                        <div class="space-y-1 my-1 overflow-hidden">
                            @foreach (var ev in day.Events.Take(2))
                            {
                                <div @onclick:stopPropagation="true"
                                     @onclick="() => selectedEventModal = ev"
                                     class="text-[10px] truncate px-1 py-0.5 rounded font-medium cursor-pointer transition hover:opacity-80 @(ev.CalendarImpactType != "None" ? "bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200" : "bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-200")"
                                     title="@($"{ev.Title} (Click to view details)")">
                                    @ev.Title
                                </div>
                            }
                            @if (day.Events.Count > 2)
                            {
                                <div class="text-[9px] text-slate-500 font-medium pl-1">
                                    +@(day.Events.Count - 2) more events
                                </div>
                            }
                        </div>

                        <!-- Leaves Count summary -->
                        <div class="flex items-center gap-1.5 text-[10px] text-slate-500 dark:text-slate-400 pt-1 border-t border-slate-100 dark:border-slate-800">
                            @if (day.ApprovedLeavesCount > 0)
                            {
                                <span class="flex items-center gap-0.5 text-rose-600 dark:text-rose-400 font-semibold" title="Staff on approved leave">
                                    ● @day.ApprovedLeavesCount
                                </span>
                            }
                            @if (day.LeavePlansCount > 0)
                            {
                                <span class="flex items-center gap-0.5 text-indigo-600 dark:text-indigo-400 font-semibold" title="Staff with planned leave">
                                    ◖ @day.LeavePlansCount
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Legend -->
            <div class="flex flex-wrap items-center gap-4 pt-3 text-xs text-slate-500 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800">
                <span class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded bg-blue-100 dark:bg-blue-950 border border-blue-300"></span> Event (Informational)
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded bg-amber-100 dark:bg-amber-950 border border-amber-300"></span> Event with Calendar Impact
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded bg-rose-50 dark:bg-rose-950 border border-rose-300"></span> Non-Working Day / Holiday
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded bg-emerald-50 dark:bg-emerald-950 border border-emerald-300"></span> Special Working Day
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="text-rose-600 font-bold">●</span> Approved Leave
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="text-indigo-600 font-bold">◖</span> Planned Leave
                </span>
            </div>
        </div>

        <!-- Selected Day Details Sidebar -->
        <div class="lg:col-span-4 min-w-0 space-y-4">
            @if (selectedDayDetail != null)
            {
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                        <div>
                            <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                                @selectedDayDetail.Date.ToString("dddd, dd MMMM yyyy")
                            </h4>
                            <p class="text-xs text-slate-500">
                                @selectedDayDetail.WorkdayResolution.StatusDescription
                            </p>
                        </div>
                        @if (selectedDayDetail.WorkdayResolution.IsWorkingDay && selectedDayDetail.WorkdayResolution.EffectiveStartTime.HasValue && selectedDayDetail.WorkdayResolution.EffectiveEndTime.HasValue)
                        {
                            <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-xs font-mono font-semibold text-slate-700 dark:text-slate-300">
                                @selectedDayDetail.WorkdayResolution.EffectiveStartTime.Value.ToString(@"hh\:mm") – @selectedDayDetail.WorkdayResolution.EffectiveEndTime.Value.ToString(@"hh\:mm")
                            </span>
                        }
                    </div>

                    <!-- Events on Day -->
                    <div class="space-y-2">
                        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-500">Organisation Events</h5>
                        @if (selectedDayDetail.Events.Count == 0)
                        {
                            <p class="text-xs text-slate-400 italic">No organisation events on this day.</p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var ev in selectedDayDetail.Events)
                                {
                                    <div class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 text-xs space-y-1 cursor-pointer transition hover:border-purple-300 dark:hover:border-purple-700 hover:shadow-2xs"
                                         @onclick="() => selectedEventModal = ev">
                                        <div class="flex items-center justify-between font-bold text-slate-900 dark:text-slate-100">
                                            <span>@ev.Title</span>
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-[10px] px-1.5 py-0.5 rounded font-medium bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300">@ev.Category</span>
                                                <span class="text-[10px] text-purple-600 dark:text-purple-400 font-semibold">View →</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(ev.Description))
                                        {
                                            <p class="text-slate-600 dark:text-slate-300">@ev.Description</p>
                                        }
                                        <div class="flex flex-wrap gap-x-3 gap-y-1 text-slate-500 pt-1">
                                            @if (!string.IsNullOrWhiteSpace(ev.VenueName))
                                            {
                                                <span>📍 @ev.VenueName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ev.DressCode))
                                            {
                                                <span>👔 @ev.DressCode</span>
                                            }
                                            @if (ev.CalendarImpactType != "None")
                                            {
                                                <span class="text-amber-700 dark:text-amber-400 font-semibold">⚑ @ev.CalendarImpactType</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Leaves Summary / List -->
                    <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <div class="flex items-center justify-between">
                            <h5 class="text-xs font-bold uppercase tracking-wider text-slate-500">Staff On Leave (@selectedDayDetail.Leaves.Count)</h5>
                            <div class="flex gap-2 text-xs">
                                <span class="text-rose-600 font-medium">@selectedDayDetail.ApprovedLeavesCount Approved</span>
                                <span class="text-indigo-600 font-medium">@selectedDayDetail.LeavePlansCount Planned</span>
                            </div>
                        </div>

                        @if (selectedDayDetail.Leaves.Count == 0)
                        {
                            <p class="text-xs text-slate-400 italic">No staff on leave or leave plans for this date.</p>
                        }
                        else
                        {
                            <div class="max-h-64 overflow-y-auto space-y-1.5 pr-1">
                                @foreach (var lv in selectedDayDetail.Leaves)
                                {
                                    <div class="flex items-center justify-between p-2 rounded-lg border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs">
                                        <div>
                                            <div class="font-semibold text-slate-900 dark:text-slate-100">@lv.Person</div>
                                            <div class="text-[11px] text-slate-500">@lv.Title (@lv.From.ToString("dd MMM") – @lv.To.ToString("dd MMM"))</div>
                                        </div>
                                        <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold @(lv.Status == "Approved" ? "bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300" : lv.IsPlan ? "bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300" : "bg-amber-100 text-amber-800")">
                                            @lv.Status
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-center text-xs text-slate-400 shadow-xs">
                    Select a date on the calendar to inspect events and leave rosters.
                </div>
            }
        </div>
    </div>
</div>

@if (selectedEventModal != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 overflow-y-auto"
         role="dialog"
         aria-modal="true"
         aria-labelledby="org-event-modal-title"
         @onclick="() => selectedEventModal = null">
        <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl p-6 text-slate-800 dark:text-slate-100 max-h-[90vh] overflow-y-auto space-y-4"
             @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="flex items-start justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                <div class="space-y-1.5">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="rounded-full bg-purple-100 dark:bg-purple-950 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800 px-2.5 py-0.5 text-xs font-semibold">
                            🏛️ @selectedEventModal.Category
                        </span>
                        @if (selectedEventModal.CalendarImpactType != "None")
                        {
                            <span class="rounded-full bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 px-2.5 py-0.5 text-xs font-semibold">
                                ⚑ @selectedEventModal.CalendarImpactType
                            </span>
                        }
                        <span class="rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-2.5 py-0.5 text-xs font-semibold">
                            @(selectedEventModal.AttendanceRequirement == "Mandatory" ? "⚠️ Mandatory" : selectedEventModal.AttendanceRequirement == "Optional" ? "Optional" : "Info Only")
                        </span>
                    </div>
                    <h3 id="org-event-modal-title" class="text-base font-bold text-slate-900 dark:text-slate-100">
                        @selectedEventModal.Title
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(selectedEventModal.EventCode))
                    {
                        <p class="text-[11px] text-slate-400 font-mono">Code: @selectedEventModal.EventCode</p>
                    }
                </div>
                <button type="button"
                        aria-label="Close modal"
                        class="rounded-lg p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                        @onclick="() => selectedEventModal = null">
                    <span class="text-lg leading-none font-bold">✕</span>
                </button>
            </div>

            <!-- Modal Body Details -->
            <div class="space-y-3 text-xs">
                <!-- Date & Time Card -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 space-y-1">
                    <div class="flex items-center gap-1.5 font-bold text-slate-700 dark:text-slate-300">
                        <span>🗓 Date &amp; Time</span>
                    </div>
                    <div class="text-slate-900 dark:text-slate-100 font-medium">
                        @if (selectedEventModal.StartDateTime.Date == selectedEventModal.EndDateTime.Date)
                        {
                            <div>@selectedEventModal.StartDateTime.ToString("dddd, dd MMMM yyyy")</div>
                            <div class="text-slate-500 dark:text-slate-400 text-[11px] mt-0.5">
                                @(selectedEventModal.IsAllDay ? "All-Day Event" : $"{selectedEventModal.StartDateTime:HH:mm} – {selectedEventModal.EndDateTime:HH:mm} ({selectedEventModal.TimeZoneId})")
                            </div>
                        }
                        else
                        {
                            <div>From: @selectedEventModal.StartDateTime.ToString("dd MMM yyyy, HH:mm")</div>
                            <div>To: @selectedEventModal.EndDateTime.ToString("dd MMM yyyy, HH:mm")</div>
                            <div class="text-slate-500 dark:text-slate-400 text-[11px] mt-0.5">(@selectedEventModal.TimeZoneId)</div>
                        }
                    </div>
                </div>

                <!-- Location & Online Meeting -->
                @if (!string.IsNullOrWhiteSpace(selectedEventModal.VenueName) || !string.IsNullOrWhiteSpace(selectedEventModal.VenueAddress) || !string.IsNullOrWhiteSpace(selectedEventModal.MeetingUrl))
                {
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 space-y-1">
                        <div class="flex items-center gap-1.5 font-bold text-slate-700 dark:text-slate-300">
                            <span>📍 Location &amp; Online Access</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedEventModal.VenueName))
                        {
                            <div class="font-medium text-slate-900 dark:text-slate-100">
                                @selectedEventModal.VenueName
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedEventModal.VenueAddress))
                        {
                            <div class="text-slate-600 dark:text-slate-400 text-[11px]">
                                @selectedEventModal.VenueAddress
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedEventModal.MeetingUrl))
                        {
                            <div class="pt-1">
                                <a href="@selectedEventModal.MeetingUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="inline-flex items-center gap-1 font-bold text-blue-600 dark:text-blue-400 hover:underline">
                                    <span>🔗 Join Online Meeting</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        }
                    </div>
                }

                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(selectedEventModal.Description))
                {
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-300 mb-1">Description</h4>
                        <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">
                            @selectedEventModal.Description
                        </p>
                    </div>
                }

                <!-- Attendance Instructions / Dress Code / Required Items -->
                @if (!string.IsNullOrWhiteSpace(selectedEventModal.DressCode) || !string.IsNullOrWhiteSpace(selectedEventModal.RequiredItems))
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        @if (!string.IsNullOrWhiteSpace(selectedEventModal.DressCode))
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">👔 Dress Code</div>
                                <div class="font-medium text-slate-900 dark:text-slate-100 mt-0.5">@selectedEventModal.DressCode</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedEventModal.RequiredItems))
                        {
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">🎒 Required Items</div>
                                <div class="font-medium text-slate-900 dark:text-slate-100 mt-0.5">@selectedEventModal.RequiredItems</div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedEventModal.AttendanceInstructions))
                {
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-300 mb-1">Attendance Instructions</h4>
                        <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2.5 text-slate-700 dark:text-slate-300 whitespace-pre-wrap">
                            @selectedEventModal.AttendanceInstructions
                        </p>
                    </div>
                }

                <!-- Contact & Notes -->
                @if (!string.IsNullOrWhiteSpace(selectedEventModal.ContactInformation))
                {
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">📞 Contact &amp; Organizer</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100 mt-0.5">@selectedEventModal.ContactInformation</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedEventModal.AdditionalNotes))
                {
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-300 mb-1">Additional Notes</h4>
                        <p class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2.5 text-slate-700 dark:text-slate-300 whitespace-pre-wrap">
                            @selectedEventModal.AdditionalNotes
                        </p>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end border-t border-slate-100 dark:border-slate-800 pt-3">
                <button type="button"
                        class="rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                        @onclick="() => selectedEventModal = null">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<OrganisationCalendarDaySummaryDto> days = [];
    private OrganisationCalendarDaySummaryDto? selectedDayDetail;
    private OrganisationEventDto? selectedEventModal;
    private DateTime? selectedDate;
    private bool busy;
    private int leadingOffset;

    protected override async Task OnInitializedAsync()
    {
        await LoadMonthAsync();
        await SelectDayAsync(DateTime.Today);
    }

    private async Task MoveMonthAsync(int delta)
    {
        month = month.AddMonths(delta);
        await LoadMonthAsync();
    }

    private async Task GoToTodayAsync()
    {
        month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        await LoadMonthAsync();
        await SelectDayAsync(DateTime.Today);
    }

    private async Task LoadMonthAsync()
    {
        busy = true;
        try
        {
            days = await OrgCalendarService.GetOrganisationCalendarMonthAsync(month);
            // DayOfWeek.Sunday is 0
            leadingOffset = (int)month.DayOfWeek;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectDayAsync(DateTime date)
    {
        selectedDate = date;
        try
        {
            selectedDayDetail = await OrgCalendarService.GetCalendarDayDetailAsync(date);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }
}
