@inject HRM.WorkPlanning.Services.Contracts.DutyRosterServiceContracts.IOperations Duties
<section class="space-y-3 rounded-xl border p-4">
    <h3 class="font-semibold">Pending duty requests</h3>
    @if(error != null) { <p role="status" class="text-sm">@error</p> }
    @foreach(var row in rows.Where(x => x.CanAccept || x.CanApprove))
    { <a href="/online/duty-roster#requests" class="block rounded border p-2 text-sm">@row.Reference · @row.Kind<br />@row.Source → @row.Target<br />@row.Status</a> }
    @if(error == null && !rows.Any(x => x.CanAccept || x.CanApprove)) { <p class="text-sm">No duty requests need your action.</p> }
    <a class="app-button app-button-secondary" href="/online/duty-roster">View roster and requests</a>
</section>
@code {
    List<HRM.DTOs.WorkPlanning.DutyRequestRow> rows = []; string? error;
    protected override async Task OnInitializedAsync() { try { rows = await Duties.GetRequestsAsync(); } catch { error = "Duty requests could not be loaded."; } }
}
