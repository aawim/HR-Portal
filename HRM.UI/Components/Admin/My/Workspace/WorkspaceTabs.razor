@using HRM.Enum


<div class="workspace-tabs w-full border-b-2 border-emerald-600 dark:border-emerald-500 overflow-x-auto">

    <nav class="flex items-end gap-1 px-2 min-w-max pb-0">

        @foreach (var tab in AvailableTabs)
        {
            var badgeCount = GetTabBadgeCount(tab);
            <button type="button" class="@TabClass(tab)" aria-pressed="@(ActiveTab==tab?"true":"false")"
                    @onclick="() => ChangeTab(tab)">

                <span class="flex items-center gap-2 whitespace-nowrap">

                    @GetTabIcon(tab)

                    @GetTabText(tab)

                    @if (badgeCount > 0)
                    {
                        <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold leading-none @(ActiveTab == tab ? "bg-white text-emerald-700" : "bg-amber-500 text-white")">
                            @badgeCount
                        </span>
                    }

                </span>

            </button>
        }

    </nav>

</div>


@code {

    [Parameter]
    public WorkspaceEntityType EntityType { get; set; }

    [Parameter]
    public WorkspaceTab ActiveTab { get; set; }

    [Parameter]
    public EventCallback<WorkspaceTab> ActiveTabChanged { get; set; }

    [Parameter]
    public IReadOnlyDictionary<WorkspaceTab, int>? TabBadgeCounts { get; set; }

    private int GetTabBadgeCount(WorkspaceTab tab) =>
        TabBadgeCounts != null && TabBadgeCounts.TryGetValue(tab, out var count) ? count : 0;

    private IEnumerable<WorkspaceTab> AvailableTabs
    {
        get
        {
            switch (EntityType)
            {
                case WorkspaceEntityType.Workspace:

                    return new[]
                    {
 
                    WorkspaceTab.Calendar,
                    WorkspaceTab.Leave,
                    WorkspaceTab.OrgDaily,
                    WorkspaceTab.ShiftWork,
                    WorkspaceTab.Assignments,
                    WorkspaceTab.AssignmentCreate,
                    WorkspaceTab.Onboarding
 
                    };

                case WorkspaceEntityType.Staff:

                    return new[]
                    {
                        WorkspaceTab.Overview,
                        WorkspaceTab.Leave,
                        WorkspaceTab.OT,
                        WorkspaceTab.JobRelatedItems,
                        WorkspaceTab.PersonalItems,
                        WorkspaceTab.Attendance,
                        WorkspaceTab.Position,
                        WorkspaceTab.StaffTransfer,
                        WorkspaceTab.Certificates,
                        WorkspaceTab.LeaveType,
                        WorkspaceTab.Schedule,
                        WorkspaceTab.WorkTypes,
                        WorkspaceTab.Finance
                       
                    };

                case WorkspaceEntityType.Individual:

                    return new[]
                    {
                        WorkspaceTab.Overview,
                        WorkspaceTab.Documents
                    };


                case WorkspaceEntityType.Organisation:

                    return new[]
                    {
                        WorkspaceTab.Overview,
                        WorkspaceTab.Staff,
                        WorkspaceTab.Teams,
                        WorkspaceTab.AssignedRoles,
                        WorkspaceTab.Permissions,
                        WorkspaceTab.LeaveType,
                        WorkspaceTab.Documents,
                   
                    };
 
                    
                default:
                      return Array.Empty<WorkspaceTab>();

            }
        }
    }




    private async Task ChangeTab(WorkspaceTab tab)
    {
        await ActiveTabChanged.InvokeAsync(tab);
    }

    private string TabClass(WorkspaceTab tab)
    {
        var baseClass =
            "rounded-t-xl px-3.5 py-1.5 " +
            "font-bold text-xs " +
            "transition-all border-t border-l border-r ";

        if (ActiveTab == tab)
        {
            return baseClass +
                   "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm";
        }

        return baseClass +
               "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 border-emerald-200/90 dark:border-slate-700";
    }

     private string GetTabText(WorkspaceTab tab)
    {
        return tab switch
        {
            WorkspaceTab.Overview => "Overview",

            WorkspaceTab.Leave => "Leave",

            WorkspaceTab.OT => "OT",
            WorkspaceTab.JobRelatedItems => "Job related items",
            WorkspaceTab.PersonalItems => "Personal items",

            WorkspaceTab.Attendance => "Attendance",

            WorkspaceTab.Documents => "Documents",

            WorkspaceTab.Staff => "Staff",

            WorkspaceTab.Calendar => "Calendar",
            WorkspaceTab.Teams => "Teams",
            WorkspaceTab.AssignedRoles => "Assigned roles",
            WorkspaceTab.Permissions => "Permissions",
            WorkspaceTab.LeaveType => "Leave types",
            WorkspaceTab.WorkTypes => "Work types",
            WorkspaceTab.StaffTransfer => "Staff transfer",
            WorkspaceTab.Certificates => "Certificates",
            WorkspaceTab.Finance => "Allowances & deductions",
            WorkspaceTab.Onboarding => "Staff onboarding",

            _ => tab.ToString()
        };
    }




    private MarkupString GetTabIcon(WorkspaceTab tab)
    {
        if(EntityType==WorkspaceEntityType.Staff)
        {
            var path=tab switch
            {
                WorkspaceTab.Overview=>"M3 10 12 3l9 7M5 9v12h14V9M9 21v-8h6v8",
                WorkspaceTab.Leave=>"M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2m4 11 2 2 4-4",
                WorkspaceTab.OT=>"M9 2h6m-3 0v3m6-1 2 2M12 9v4l3 2M20 13a8 8 0 1 1-16 0 8 8 0 0 1 16 0",
                WorkspaceTab.JobRelatedItems=>"M3 7h18v13H3zM8 7V4h8v3M3 12h18",
                WorkspaceTab.PersonalItems=>"M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z",
                WorkspaceTab.Attendance=>"M9 3H5v18h14V3h-4M9 2h6v4H9zM8 13l3 3 5-6",
                WorkspaceTab.Position=>"M8 7V3h8v4M3 7h18v14H3zM3 11l9 4 9-4M10 13v4h4v-4",
                WorkspaceTab.LeaveType=>"M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v15H3V6a2 2 0 0 1 2-2m2 10h3m4 0h3M7 18h3m4 0h3",
                WorkspaceTab.Schedule=>"M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0M12 7v5l4 2",
                WorkspaceTab.WorkTypes=>"M3 4h18v12H3zM8 21h8m-4-5v5M7 8h4m-4 4h8",
                WorkspaceTab.StaffTransfer=>"M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
                WorkspaceTab.Certificates=>"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
                WorkspaceTab.Finance=>"M3 6h16V3H5a2 2 0 0 0-2 2v14h18V7H3m18 4h-6v4h6m-4-2h.01",
                _=>"M5 6h14M5 12h14M5 18h14"
            };
            return (MarkupString)$"<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"{path}\" /></svg>";
        }
        return tab switch
        {

            WorkspaceTab.Overview =>
                (MarkupString)"""<span>🏠</span>""",

            WorkspaceTab.Leave =>
                (MarkupString)"""<span>📅</span>""",

            WorkspaceTab.OT =>
                (MarkupString)"""<span>⏱</span>""",

            WorkspaceTab.Attendance =>
                (MarkupString)"""<span>✔</span>""",

            WorkspaceTab.Documents =>
                (MarkupString)"""<span>📄</span>""",

            WorkspaceTab.Staff =>
                (MarkupString)"""<span>👥</span>""",

            WorkspaceTab.Calendar =>
                (MarkupString)"""<span>🗓</span>""",

            WorkspaceTab.Position =>
                (MarkupString)"""<span>🗓</span>""",

            WorkspaceTab.Onboarding =>
                (MarkupString)"""<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 11h6m-3-3v6"/></svg>""",

            WorkspaceTab.LeaveType =>
                (MarkupString)"""<span>🗓</span>""",

            _ =>
                (MarkupString)"""<span aria-hidden="true">•</span>"""
        };

    }

}
