@using HRM.Application.Contracts.Pages
@using HRM.DTOs
@inject IOrganisationDirectoryQueries Directory

<section class="w-full min-w-0 p-2 space-y-2">
    <header class="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white/95 p-2 shadow-xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900/95">
        <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Organisation structures</h2>
            <p class="mt-0.5 text-xs text-slate-500">Organisation, divisions, departments, active teams and active sub-teams.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700 dark:text-slate-300"><input type="checkbox" class="rounded border-slate-300 text-blue-600" @bind="showStaff" @bind:after="LoadStaffAsync" /> Show staff names</label>
            <button type="button" class="app-button app-button-neutral app-button-sm" disabled="@loading" @onclick="LoadAsync"><AppIcon Name="refresh" Class="@(loading ? "animate-spin text-sm" : "text-sm")" /> Refresh</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-2 text-xs text-rose-800">@error</div>
    }
    else if (loading)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">Loading organisation structures…</div>
    }
    else
    {
        @foreach (var node in roots)
        {
            @StructureNode(node, 0)
        }
        @if (teams.Any(team => !team.OrganisationStructureId.HasValue))
        {
            <article class="rounded-2xl border border-slate-200 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900"><div class="flex items-center justify-between gap-2"><h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Organisation-wide teams</h3><span class="text-[11px] text-slate-500">No structure assigned</span></div>@foreach (var team in teams.Where(team => !team.OrganisationStructureId.HasValue && team.ParentTeamId == null).OrderBy(team => team.Name)) { @TeamRow(team, false) }</article>
        }
        @if (roots.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">No approved organisation structures are available.</div>
        }
    }
</section>

@code {
    private List<OrgNodeDto> roots = [];
    private List<OrganisationUnitSummary> teams = [];
    private readonly Dictionary<int, List<OrganisationMember>> staffByTeam = [];
    private bool loading;
    private bool showStaff;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            roots = await Directory.GetApprovedStructureAsync();
            var today = DateTime.UtcNow.AddHours(5).Date;
            teams = (await Directory.GetTeamsAsync()).Where(team => team.IsActive && (!team.StartsOn.HasValue || team.StartsOn.Value.Date <= today) && (!team.EndsOn.HasValue || team.EndsOn.Value.Date >= today)).ToList();
            staffByTeam.Clear();
            if (showStaff) await LoadStaffAsync();
        }
        catch
        {
            roots = [];
            teams = [];
            error = "Organisation structures could not be loaded. Please refresh and try again.";
        }
        finally { loading = false; }
    }

    private async Task LoadStaffAsync()
    {
        if (!showStaff || teams.Count == 0) return;
        try
        {
            var details = await Task.WhenAll(teams.Select(async team => (TeamId: team.Id, Details: await Directory.GetDetailsAsync(new OrganisationUnitKey(OrganisationUnitKind.Team, team.Id)))));
            foreach (var item in details)
                staffByTeam[item.TeamId] = item.Details?.CurrentStaff ?? [];
        }
        catch { error = "Some staff names could not be loaded."; }
    }

    private RenderFragment StructureNode(OrgNodeDto node, int level) => @<div class="space-y-2" style="margin-left:@(level * 16)px">
        <article class="rounded-2xl border border-slate-200 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="min-w-0"><div class="flex items-center gap-2"><AppIcon Name="diagram-3" Class="text-base text-blue-600" /><h3 class="truncate text-sm font-bold text-slate-900 dark:text-slate-100">@node.Name</h3><span class="rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-semibold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">@(string.IsNullOrWhiteSpace(node.TypeName) ? "Organisation" : node.TypeName)</span></div></div>
                <span class="text-[11px] text-slate-500">@TeamsFor(node.StructureId).Count active teams</span>
            </div>
            @foreach (var team in TeamsFor(node.StructureId).Where(team => team.ParentTeamId == null)) { @TeamRow(team, false) }
        </article>
        @foreach (var child in node.Children.OrderBy(child => child.Name)) { @StructureNode(child, level + 1) }
    </div>;

    private RenderFragment TeamRow(OrganisationUnitSummary team, bool isSubTeam) => @<div class="mt-2 rounded-xl border border-slate-200 bg-slate-50/70 p-2 text-xs dark:border-slate-800 dark:bg-slate-800/40">
        <div class="flex flex-wrap items-center justify-between gap-2"><div class="flex min-w-0 items-center gap-2"><AppIcon Name="@(isSubTeam ? "diagram-2" : "people")" Class="text-sm text-teal-600" /><span class="font-semibold text-slate-900 dark:text-slate-100">@team.Name</span>@if (isSubTeam) { <span class="rounded-full bg-teal-50 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:bg-teal-950/60 dark:text-teal-300">Sub-team</span> }</div><span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">Active</span></div>
        @if (showStaff && staffByTeam.TryGetValue(team.Id, out var staff)) { <div class="mt-2 flex flex-wrap gap-1">@if (staff.Count == 0) { <span class="text-[11px] text-slate-500">No active staff</span> } else { @foreach (var person in staff) { <span class="rounded-full bg-white px-2 py-0.5 text-[11px] text-slate-700 dark:bg-slate-900 dark:text-slate-200">@person.Name@(person.IsSupervisor ? " · Supervisor" : "")</span> } }</div> }
        @foreach (var subTeam in teams.Where(item => item.ParentTeamId == team.Id).OrderBy(item => item.Name)) { @TeamRow(subTeam, true) }
    </div>;

    private List<OrganisationUnitSummary> TeamsFor(int structureId) => teams.Where(team => team.OrganisationStructureId == structureId).ToList();
}
