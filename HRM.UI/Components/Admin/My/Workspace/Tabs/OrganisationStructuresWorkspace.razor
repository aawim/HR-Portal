@using HRM.Application.Contracts.Pages
@using HRM.DTOs
@inject IOrganisationDirectoryQueries Directory

<section class="organisation-structures-workspace w-full min-w-0 p-2 space-y-2">
    <header class="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white/95 p-2 shadow-xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900/95">
        <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Organisation structures</h2>
            <p class="mt-0.5 text-xs text-slate-500">Organisation, divisions, departments, active teams and active sub-teams.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700 dark:text-slate-300"><input type="checkbox" class="rounded border-slate-300 text-blue-600" @bind="showStaff" @bind:after="LoadStaffAsync" /> Show staff names</label>
            <button type="button" class="app-button app-button-neutral app-button-sm" disabled="@loading" @onclick="LoadAsync"><AppIcon Name="refresh" Class="@(loading ? "animate-spin text-sm" : "text-sm")" /> Refresh</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-2 text-xs text-rose-800">@error</div>
    }
    else if (loading)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">Loading organisation structures…</div>
    }
    else if (structureTypes.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900">No approved organisation structures are available.</div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Structure type
                    <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" value="@selectedTypeId" @onchange="OnTypeChanged">
                        @foreach (var type in structureTypes) { <option value="@type.Id">@type.Name</option> }
                    </select>
                </label>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Organisation structure
                    <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" @bind="selectedStructureId">
                        @foreach (var structure in StructuresForSelectedType) { <option value="@structure.StructureId">@structure.Name</option> }
                    </select>
                </label>
            </div>
        </div>

        @if (selectedStructure is not null)
        {
            <article class="rounded-2xl border border-slate-200 bg-slate-50/60 p-3 shadow-xs dark:border-slate-800 dark:bg-slate-950/30">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                    <div><h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@selectedStructure.Name hierarchy</h3><p class="mt-0.5 text-xs text-slate-500">Connected reporting structures below the selected @selectedStructure.TypeName.</p></div>
                    <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-semibold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">@DescendantCount(selectedStructure) related structures</span>
                </div>
                <div class="org-chart-scroll overflow-x-auto pb-2"><div class="org-chart min-w-max px-4 py-2"><ul>@ChartNode(selectedStructure, true)</ul></div></div>
            </article>
        }
    }
</section>

<style>
    .org-chart ul { display: flex; justify-content: center; margin: 0; padding: 1.5rem 0 0; position: relative; }
    .org-chart li { list-style: none; min-width: 11rem; padding: 1.5rem .35rem 0; position: relative; text-align: center; }
    .org-chart li::before, .org-chart li::after { border-top: 1px solid rgb(203 213 225); content: ""; height: 1.5rem; position: absolute; right: 50%; top: 0; width: 50%; }
    .org-chart li::after { border-left: 1px solid rgb(203 213 225); left: 50%; right: auto; }
    .org-chart li:only-child::before, .org-chart li:only-child::after { display: none; }
    .org-chart li:only-child { padding-top: 0; }
    .org-chart li:first-child::before, .org-chart li:last-child::after { border: 0 none; }
    .org-chart li:last-child::before { border-right: 1px solid rgb(203 213 225); border-radius: 0 .5rem 0 0; }
    .org-chart li:first-child::after { border-radius: .5rem 0 0 0; }
    .org-chart > ul > li { padding-top: 0; }
    .org-chart > ul > li::before, .org-chart > ul > li::after { display: none; }
    .org-chart-card { min-height: 7.5rem; width: 11rem; }
    .org-chart-card::after { border-left: 1px solid rgb(203 213 225); content: ""; height: 1.5rem; left: 50%; position: absolute; top: 100%; }
    .org-chart li:only-child > .org-chart-card::after, .org-chart-root::after { display: none; }
    .dark .org-chart li::before, .dark .org-chart li::after, .dark .org-chart-card::after { border-color: rgb(71 85 105); }
</style>

@code {
    private sealed record StructureTypeOption(int Id, string Name);

    private List<OrgNodeDto> roots = [];
    private List<OrgNodeDto> structures = [];
    private List<OrganisationUnitSummary> teams = [];
    private readonly Dictionary<int, List<OrganisationMember>> staffByTeam = [];
    private List<StructureTypeOption> structureTypes = [];
    private int? selectedTypeId;
    private int? selectedStructureId;
    private bool loading;
    private bool showStaff;
    private string? error;
    private IEnumerable<OrgNodeDto> StructuresForSelectedType => structures.Where(node => node.TypeId == selectedTypeId).OrderBy(node => node.Name);
    private OrgNodeDto? selectedStructure => selectedStructureId is int id ? structures.FirstOrDefault(node => node.StructureId == id) : null;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            roots = await Directory.GetApprovedStructureAsync();
            structures = Flatten(roots).ToList();
            structureTypes = structures.GroupBy(node => node.TypeId).Select(group => new StructureTypeOption(group.Key, group.First().TypeName)).OrderBy(type => type.Name).ToList();
            selectedTypeId = structureTypes.Any(type => type.Id == selectedTypeId) ? selectedTypeId : structureTypes.FirstOrDefault()?.Id;
            selectedStructureId = StructuresForSelectedType.Any(node => node.StructureId == selectedStructureId) ? selectedStructureId : StructuresForSelectedType.FirstOrDefault()?.StructureId;
            var today = DateTime.UtcNow.AddHours(5).Date;
            teams = (await Directory.GetTeamsAsync()).Where(team => team.IsActive && (!team.StartsOn.HasValue || team.StartsOn.Value.Date <= today) && (!team.EndsOn.HasValue || team.EndsOn.Value.Date >= today)).ToList();
            staffByTeam.Clear();
            if (showStaff) await LoadStaffAsync();
        }
        catch
        {
            roots = [];
            structures = [];
            teams = [];
            structureTypes = [];
            error = "Organisation structures could not be loaded. Please refresh and try again.";
        }
        finally { loading = false; }
    }

    private Task OnTypeChanged(ChangeEventArgs args)
    {
        selectedTypeId = int.TryParse(args.Value?.ToString(), out var typeId) ? typeId : null;
        selectedStructureId = StructuresForSelectedType.FirstOrDefault()?.StructureId;
        return Task.CompletedTask;
    }

    private async Task LoadStaffAsync()
    {
        if (!showStaff || teams.Count == 0) return;
        try
        {
            var details = await Task.WhenAll(teams.Select(async team => (TeamId: team.Id, Details: await Directory.GetDetailsAsync(new OrganisationUnitKey(OrganisationUnitKind.Team, team.Id)))));
            foreach (var item in details)
                staffByTeam[item.TeamId] = item.Details?.CurrentStaff ?? [];
        }
        catch { error = "Some staff names could not be loaded."; }
    }

    private RenderFragment ChartNode(OrgNodeDto node, bool isRoot) => @<li>
        <article class="org-chart-card relative rounded-xl border border-slate-200 bg-white p-3 text-left shadow-xs dark:border-slate-700 dark:bg-slate-900 @(isRoot ? "org-chart-root border-teal-300 bg-teal-50/70 dark:border-teal-800 dark:bg-teal-950/30" : "")">
            <div class="mb-2 h-1 w-5 rounded-full @(isRoot ? "bg-teal-400" : "bg-blue-400")"></div>
            <h4 class="line-clamp-2 text-xs font-bold text-slate-900 dark:text-slate-100" title="@node.Name">@node.Name</h4>
            <span class="mt-2 inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">@node.TypeName</span>
            @if (TeamsFor(node.StructureId).Count > 0) { <p class="mt-2 text-[10px] text-slate-500">@TeamsFor(node.StructureId).Count parent team@(TeamsFor(node.StructureId).Count == 1 ? "" : "s")</p> }
        </article>
        @if (node.Children.Count > 0) { <ul>@foreach (var child in node.Children.OrderBy(child => child.Name)) { @ChartNode(child, false) }</ul> }
    </li>;

    private static IEnumerable<OrgNodeDto> Flatten(IEnumerable<OrgNodeDto> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Flatten(node.Children)) yield return child;
        }
    }

    private int DescendantCount(OrgNodeDto node) => Flatten(node.Children).Count();
    private List<OrganisationUnitSummary> TeamsFor(int structureId) => teams.Where(team => team.OrganisationStructureId == structureId && team.ParentTeamId is null).ToList();
}
