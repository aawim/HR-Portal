@namespace HRM.Components.Admin.My.Workspace
@using HRM.DTOs.Attendance
@using HRM.Services
@using HRM.Helpers
@inject HRM.Services.Contracts.LateCheckInRequestServiceContracts.IOperations Requests
@inject ToastService Toasts
@inject ILogger<TimeChangeWorkspacePanel> Logger
@inject IJSRuntime JS

<section class="time-change-workspace w-full min-w-0 p-2 space-y-4">
    <!-- Header Bar -->
    <header class="sticky top-0 z-20 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 px-3 py-3 shadow-xs backdrop-blur-xs rounded-2xl">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">
                    Attendance Time Change Command
                </h1>
                <span class="rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2.5 py-0.5 text-xs font-semibold">
                    Schedule Shift
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Submit, modify, or cancel time change requests. Manage upcoming schedule adjustments and review history.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Full Width / Shrink Toggle Button -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
                    title="@(isFullWidth ? "Shrink to standard layout" : "Expand to full page width")"
                    @onclick="ToggleFullWidth">
                @if (isFullWidth)
                {
                    <AppIcon Name="fullscreen_exit" Class="h-4 w-4 text-slate-600 dark:text-slate-300 text-base" />
                    <span>Shrink View</span>
                }
                else
                {
                    <AppIcon Name="fullscreen" Class="h-4 w-4 text-slate-600 dark:text-slate-300 text-base" />
                    <span>Full Width</span>
                }
            </button>

            <!-- Refresh Button -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-teal-700 dark:text-teal-400 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition-colors"
                    disabled="@busy"
                    @onclick="LoadAsync">
                <AppIcon Name="refresh" Class="w-3.5 h-3.5 text-sm" />
                <span>@(busy ? "Loading…" : "Refresh")</span>
            </button>

            <!-- Quick New Request button if in edit/detail mode -->
            @if (editingRow != null)
            {
                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs transition"
                        @onclick="ClearForm">
                    <span>+ New Request</span>
                </button>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(globalError))
    {
        <div class="rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 p-3 text-xs text-rose-800 dark:text-rose-200 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span>⚠️</span>
                <span>@globalError</span>
            </div>
            <button type="button" class="text-rose-700 dark:text-rose-400 font-bold hover:underline" @onclick="() => globalError = null">Dismiss</button>
        </div>
    }

    <!-- 2-Panel Layout: Add/Edit & Detail Panel on the Left, History on the Right -->
    <div class="page-panels @(isFullWidth ? "page-panels-full" : "page-panels-standard")">

        <!-- ======================================================== -->
        <!-- LEFT PANEL: Add / Edit & Detail Operations Panel         -->
        <!-- ======================================================== -->
        <div class="page-panel-left min-w-0 rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-4">
            
            @if (editingRow != null)
            {
                <!-- ==================================================== -->
                <!-- SELECTED ROW DETAIL & EDIT / OPERATIONS VIEW         -->
                <!-- ==================================================== -->
                <div class="flex flex-col gap-4">
                    
                    <!-- Top Navigation & Badges Bar -->
                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition"
                                    @onclick="ClearForm">
                                <span>← Back to New Request</span>
                            </button>
                            <span class="text-slate-400">|</span>
                            <span class="font-mono text-xs font-bold text-teal-800 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 px-2.5 py-1 rounded-md">
                                @editingRow.Reference
                            </span>
                        </div>

                        <div class="flex flex-wrap items-center gap-1.5">
                            <span class="rounded px-2 py-0.5 text-[11px] font-bold @(editingRow.Kind == "EarlyCheckOut" ? "bg-amber-50 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200" : "bg-teal-50 text-teal-800 dark:bg-teal-950/50 dark:text-teal-300 border border-teal-200")">
                                @(editingRow.Kind == "EarlyCheckOut" ? "Early Check-Out" : "Late Check-In")
                            </span>

                            <span class="rounded-full px-2.5 py-0.5 text-[11px] font-bold @GetStatusBadgeClass(editingRow.Status)">
                                @editingRow.Status
                            </span>

                            @if (isViewingPastRecord)
                            {
                                <span class="rounded-full bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2.5 py-0.5 text-[11px] font-semibold border border-slate-200 dark:border-slate-700">
                                    🔒 Past Date (Locked)
                                </span>
                            }
                            else
                            {
                                <span class="rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2.5 py-0.5 text-[11px] font-semibold border border-emerald-200 dark:border-emerald-800">
                                    ✏️ Upcoming (Editable)
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Context Notice Banner -->
                    @if (isViewingPastRecord)
                    {
                        <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 p-3 text-xs text-slate-700 dark:text-slate-300 flex items-start gap-2.5">
                            <span class="text-base shrink-0">🔒</span>
                            <div class="flex-1">
                                <p class="font-bold text-slate-800 dark:text-slate-200">Historical Record — Read-Only Inspection</p>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                    This time-change request was for @editingRow.ScheduledStart.ToString("dd MMM yyyy"). Past date records cannot be edited, modified, or canceled.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-xl border border-teal-200 dark:border-teal-800 bg-teal-50/70 dark:bg-teal-950/40 p-3 text-xs text-teal-900 dark:text-teal-200 flex items-start justify-between gap-2">
                            <div class="flex items-start gap-2.5">
                                <span class="text-base shrink-0">✏️</span>
                                <div>
                                    <p class="font-bold">Editing Upcoming Request @editingRow.Reference</p>
                                    <p class="text-[11px] text-teal-700 dark:text-teal-300 mt-0.5">
                                        Scheduled for @editingRow.ScheduledStart.ToString("dd MMM yyyy"). You can adjust the timing, update justification, or cancel this request.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Detail & Metrics Grid Card -->
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/50 p-3 flex flex-col gap-2.5">
                        <h3 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                            Schedule &amp; Attendance Details
                        </h3>

                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 text-xs">
                            <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-slate-200 dark:border-slate-800 flex flex-col">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Original Schedule</span>
                                <span class="font-bold text-slate-800 dark:text-slate-200 mt-0.5">
                                    @editingRow.ScheduledStart.ToString("dd MMM yyyy")
                                </span>
                                <span class="font-mono text-[11px] text-slate-600 dark:text-slate-400">
                                    @editingRow.ScheduledStart.ToString("HH:mm") Start
                                </span>
                            </div>

                            <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-slate-200 dark:border-slate-800 flex flex-col">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Requested Shift Hours</span>
                                @if (editingRow.RequestedStart.HasValue && editingRow.RequestedEnd.HasValue)
                                {
                                    <span class="font-bold text-teal-700 dark:text-teal-400 font-mono mt-0.5">
                                        @editingRow.RequestedStart.Value.ToString("HH:mm") – @editingRow.RequestedEnd.Value.ToString("HH:mm")
                                    </span>
                                    <span class="text-[10px] text-slate-500">Check-out compulsory</span>
                                }
                                else
                                {
                                    <span class="text-slate-400 mt-0.5">—</span>
                                }
                            </div>

                            <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-slate-200 dark:border-slate-800 flex flex-col">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Time Difference</span>
                                <span class="font-bold text-slate-800 dark:text-slate-200 mt-0.5">
                                    @editingRow.LateMinutes minutes
                                </span>
                                <span class="text-[10px] text-slate-500">
                                    @(editingRow.Kind == "EarlyCheckOut" ? "Early Departure" : "Late Arrival")
                                </span>
                            </div>

                            <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-slate-200 dark:border-slate-800 flex flex-col">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Roster Plan</span>
                                <span class="font-medium text-slate-800 dark:text-slate-200 mt-0.5 truncate">
                                    @(string.IsNullOrWhiteSpace(editingRow.Schedule) ? "Standard Roster" : editingRow.Schedule)
                                </span>
                            </div>

                            <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-slate-200 dark:border-slate-800 flex flex-col">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Applicant Staff</span>
                                <span class="font-medium text-slate-800 dark:text-slate-200 mt-0.5 truncate">
                                    @(string.IsNullOrWhiteSpace(editingRow.Staff) ? "Self" : editingRow.Staff)
                                </span>
                            </div>

                            <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-slate-200 dark:border-slate-800 flex flex-col">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Workflow Stage</span>
                                <span class="font-medium text-slate-800 dark:text-slate-200 mt-0.5 truncate">
                                    @(string.IsNullOrWhiteSpace(editingRow.Stage) ? "Submitted" : editingRow.Stage)
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Mode Specific Section: Form Inputs for Future Records OR Read-only Reason for Past Records -->
                    @if (isViewingPastRecord)
                    {
                        <!-- Read-Only Reason Card -->
                        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 p-3 flex flex-col gap-1.5">
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                Business Justification / Reason
                            </label>
                            <div class="rounded-lg bg-white dark:bg-slate-900 p-3 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 italic whitespace-pre-wrap">
                                “@editingRow.Reason”
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Editable Form Inputs for Future Records -->
                        <div class="flex flex-col gap-3 rounded-xl border border-teal-200 dark:border-teal-800 bg-teal-50/30 dark:bg-teal-950/20 p-3.5">
                            <h4 class="text-xs font-bold text-teal-900 dark:text-teal-200 uppercase tracking-wider">
                                Modify Requested Timing
                            </h4>

                            <!-- Type Selector -->
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Request Type</label>
                                <div class="flex rounded-lg border border-slate-300 dark:border-slate-700 p-1 bg-white dark:bg-slate-800 gap-1">
                                    <button type="button"
                                            class="flex-1 py-1.5 text-xs font-bold rounded-md transition text-center @(kind == "LateCheckIn" ? "bg-teal-700 text-white shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                            disabled="@busy"
                                            @onclick='() => SetKind("LateCheckIn")'>
                                        Late Check-In
                                    </button>
                                    <button type="button"
                                            class="flex-1 py-1.5 text-xs font-bold rounded-md transition text-center @(kind == "EarlyCheckOut" ? "bg-teal-700 text-white shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                            disabled="@busy"
                                            @onclick='() => SetKind("EarlyCheckOut")'>
                                        Early Check-Out
                                    </button>
                                </div>
                            </div>

                            <!-- Date & Requested Time -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Target Date</label>
                                    <InputDate @bind-Value="requestDate"
                                               @bind-Value:after="DateChangedAsync"
                                               disabled="@busy"
                                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                </div>

                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                        @(kind == "EarlyCheckOut" ? "Requested Check-Out Time" : "Requested Check-In Time")
                                    </label>
                                    <input type="time"
                                           step="60"
                                           @bind="requestedTime"
                                           disabled="@busy"
                                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                </div>
                            </div>

                            <!-- Candidate Schedules & Working Hours Preview -->
                            @if (scheduleLoading)
                            {
                                <div class="py-2 text-center text-xs text-slate-400 animate-pulse">
                                    Checking working schedule for @requestDate.ToString("dd MMM yyyy")…
                                </div>
                            }
                            else if (selectedSchedule != null && calculatedPreview.HasValue)
                            {
                                <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-teal-200 dark:border-teal-800 text-xs flex flex-col gap-1">
                                    <div class="flex items-center justify-between font-bold text-slate-800 dark:text-slate-200">
                                        <span>After Approval Working Hours:</span>
                                        <span class="text-teal-700 dark:text-teal-400 font-mono">
                                            @calculatedPreview.Value.Start.ToString("HH:mm") – @calculatedPreview.Value.End.ToString("HH:mm")
                                        </span>
                                    </div>
                                    <p class="text-[10px] text-slate-500 dark:text-slate-400">
                                        Check-out at or after @calculatedPreview.Value.End.ToString("HH:mm") is compulsory once approved.
                                    </p>
                                </div>
                            }
                            else if (previewError != null && requestedTime.HasValue)
                            {
                                <p class="text-[11px] text-rose-600 dark:text-rose-400 font-medium">
                                    ⚠️ @previewError
                                </p>
                            }

                            <!-- Editable Reason -->
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                    Reason for Time Change <span class="text-rose-500">*</span>
                                </label>
                                <textarea rows="3"
                                          maxlength="1000"
                                          @bind="reason"
                                          disabled="@busy"
                                          placeholder="Provide justification for modifying this schedule adjustment..."
                                          class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"></textarea>
                                <div class="flex justify-between items-center text-[10px] text-slate-400 px-1 mt-0.5">
                                    <span>Min 5 characters</span>
                                    <span>@(reason?.Length ?? 0) / 1000</span>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Workflow History Log if present -->
                    @if (editingRow.History != null && editingRow.History.Count > 0)
                    {
                        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 p-3">
                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider mb-2">
                                Request History &amp; Workflow Log
                            </h4>
                            <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                                @foreach (var action in editingRow.History)
                                {
                                    <li class="flex items-start gap-2 bg-white dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-[11px]">
                                        <span class="text-teal-600">✓</span>
                                        <span class="whitespace-pre-wrap break-words">@action</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Supervisor Action Comment (if CanApprove) -->
                    @if (editingRow.CanApprove)
                    {
                        <div class="rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50/40 dark:bg-indigo-950/20 p-3 flex flex-col gap-1.5">
                            <label class="block text-xs font-semibold text-indigo-950 dark:text-indigo-200 p-1">
                                Approver Decision Comment (Optional)
                            </label>
                            <input type="text"
                                   placeholder="Enter comments or remarks for this approval decision..."
                                   @bind="actionComment"
                                   disabled="@busy"
                                   class="w-full rounded-lg border border-indigo-200 dark:border-indigo-800 bg-white dark:bg-slate-900 p-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="rounded-lg border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2.5 text-xs text-rose-700 dark:text-rose-300">
                            @formError
                        </div>
                    }

                    <!-- Footer Action Strip -->
                    <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-200 dark:border-slate-800">
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    @onclick="ClearForm">
                                <span>← Back to New Request</span>
                            </button>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            @if (!isViewingPastRecord)
                            {
                                <button type="button"
                                        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-1.5 text-xs font-semibold shadow-2xs disabled:opacity-50 transition"
                                        disabled="@(busy || !requestedTime.HasValue || string.IsNullOrWhiteSpace(reason) || previewError != null)"
                                        @onclick="UpdateFutureRequestAsync">
                                    <span>💾 Save Changes</span>
                                </button>

                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/60 px-3 py-1.5 text-xs font-semibold shadow-2xs disabled:opacity-50 transition"
                                        disabled="@busy"
                                        @onclick="() => CancelFutureRequestAsync(editingRow)">
                                    <span>✕ Cancel Request</span>
                                </button>
                            }

                            @if (editingRow.CanApprove)
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 text-xs font-semibold shadow-2xs disabled:opacity-50 transition"
                                        disabled="@busy"
                                        @onclick='() => ActAsync(editingRow, "Approve")'>
                                    <span>✓ Approve Stage</span>
                                </button>
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-rose-300 dark:border-rose-800 bg-white dark:bg-slate-800 text-rose-700 dark:text-rose-400 hover:bg-rose-50 px-3 py-1.5 text-xs font-semibold shadow-2xs disabled:opacity-50 transition"
                                        disabled="@busy"
                                        @onclick='() => ActAsync(editingRow, "Reject")'>
                                    <span>✕ Reject</span>
                                </button>
                            }
                        </div>
                    </div>

                </div>
            }
            else
            {
                <!-- ==================================================== -->
                <!-- NEW TIME CHANGE REQUEST FORM                         -->
                <!-- ==================================================== -->
                <div class="flex flex-col gap-4">
                    
                    <!-- Form Header -->
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 flex-wrap gap-2">
                        <div>
                            <h2 class="text-sm font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2">
                                <span>📝</span>
                                <span>New Time Change Request</span>
                            </h2>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                Adjust your scheduled check-in or check-out hours for a working day.
                            </p>
                        </div>
                    </div>

                    <!-- Request Type Selector -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Request Type</label>
                        <div class="flex rounded-lg border border-slate-300 dark:border-slate-700 p-1 bg-slate-50 dark:bg-slate-800 gap-1">
                            <button type="button"
                                    class="flex-1 py-1.5 text-xs font-bold rounded-md transition text-center @(kind == "LateCheckIn" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                    disabled="@busy"
                                    @onclick='() => SetKind("LateCheckIn")'>
                                Late Check-In
                            </button>
                            <button type="button"
                                    class="flex-1 py-1.5 text-xs font-bold rounded-md transition text-center @(kind == "EarlyCheckOut" ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-400 shadow-2xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                                    disabled="@busy"
                                    @onclick='() => SetKind("EarlyCheckOut")'>
                                Early Check-Out
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 px-1 mt-1">
                            @(kind == "LateCheckIn" 
                                ? "Request approval to arrive after the scheduled start time. Approved check-out time will be adjusted accordingly." 
                                : "Request approval to depart before the scheduled finish time. Missed hours must be reconciled.")
                        </p>
                    </div>

                    <!-- Date & Requested Time in 2 Columns -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                Target Date
                                @if (requestDate < Today)
                                {
                                    <span class="text-amber-600 dark:text-amber-400 text-[10px] ml-1 font-bold">(Past Date)</span>
                                }
                                else if (requestDate == Today)
                                {
                                    <span class="text-teal-600 dark:text-teal-400 text-[10px] ml-1 font-bold">(Today)</span>
                                }
                                else
                                {
                                    <span class="text-emerald-600 dark:text-emerald-400 text-[10px] ml-1 font-bold">(Upcoming)</span>
                                }
                            </label>
                            <InputDate @bind-Value="requestDate"
                                       @bind-Value:after="DateChangedAsync"
                                       disabled="@busy"
                                       class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500 disabled:bg-slate-100 dark:disabled:bg-slate-800/60 disabled:cursor-not-allowed" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                @(kind == "EarlyCheckOut" ? "Requested Check-Out Time" : "Requested Check-In Time")
                            </label>
                            <input type="time"
                                   step="60"
                                   @bind="requestedTime"
                                   disabled="@busy"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500 disabled:bg-slate-100 dark:disabled:bg-slate-800/60 disabled:cursor-not-allowed" />
                        </div>
                    </div>

                    <!-- Candidate Schedules & Working Hours Preview -->
                    @if (scheduleLoading)
                    {
                        <div class="py-3 text-center text-xs text-slate-400 animate-pulse">
                            Checking working schedule for @requestDate.ToString("dd MMM yyyy")…
                        </div>
                    }
                    else if (candidates.Count == 0)
                    {
                        <div class="rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50/50 dark:bg-amber-950/30 p-3 text-xs text-amber-800 dark:text-amber-200">
                            <p class="font-bold">No eligible schedule found</p>
                            <p class="text-[11px] mt-0.5">
                                No active scheduled working hours requiring attendance were found for @requestDate.ToString("dd MMM yyyy"). Ensure your duty roster or work plan is configured.
                            </p>
                        </div>
                    }
                    else if (selectedSchedule != null)
                    {
                        var schedStart = selectedSchedule.ScheduledStart;
                        var schedEnd = selectedSchedule.ScheduledEnd;

                        <div class="rounded-xl border border-teal-200 dark:border-teal-800 bg-teal-50/40 dark:bg-teal-950/20 p-3 flex flex-col gap-2">
                            <div class="flex items-center justify-between text-xs font-bold text-teal-900 dark:text-teal-200">
                                <span>📅 Scheduled Working Hours</span>
                                <span>@schedStart.ToString("HH:mm") – @schedEnd.ToString("HH:mm")</span>
                            </div>

                            @if (previewError != null && requestedTime.HasValue)
                            {
                                <p class="text-[11px] text-rose-600 dark:text-rose-400 font-medium">
                                    ⚠️ @previewError
                                </p>
                            }
                            else if (calculatedPreview.HasValue)
                            {
                                <div class="rounded-lg bg-white dark:bg-slate-900 p-2.5 border border-teal-100 dark:border-teal-800/60 text-xs flex flex-col gap-1">
                                    <div class="flex items-center justify-between font-bold text-slate-800 dark:text-slate-200">
                                        <span>After Approval Working Hours:</span>
                                        <span class="text-teal-700 dark:text-teal-400 font-mono">
                                            @calculatedPreview.Value.Start.ToString("HH:mm") – @calculatedPreview.Value.End.ToString("HH:mm")
                                        </span>
                                    </div>
                                    <p class="text-[10px] text-slate-500 dark:text-slate-400">
                                        Check-out at or after @calculatedPreview.Value.End.ToString("HH:mm") is compulsory once approved.
                                    </p>
                                </div>
                            }
                        </div>
                    }

                    <!-- Reason Field -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                            Reason for Time Change
                            <span class="text-rose-500">*</span>
                        </label>
                        <textarea rows="3"
                                  maxlength="1000"
                                  @bind="reason"
                                  disabled="@busy"
                                  placeholder="Provide detailed justification for the requested check-in or check-out schedule adjustment..."
                                  class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500 disabled:bg-slate-100 dark:disabled:bg-slate-800/60 disabled:cursor-not-allowed"></textarea>
                        <div class="flex justify-between items-center text-[10px] text-slate-400 px-1 mt-0.5">
                            <span>Min 5 characters</span>
                            <span>@(reason?.Length ?? 0) / 1000</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="rounded-lg border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2.5 text-xs text-rose-700 dark:text-rose-300">
                            @formError
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <button type="button"
                                class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-4 py-2 text-xs font-semibold shadow-2xs disabled:opacity-50 transition"
                                disabled="@(busy || !requestedTime.HasValue || string.IsNullOrWhiteSpace(reason) || previewError != null)"
                                @onclick="SubmitNewRequestAsync">
                            <span>Submit for Approval</span>
                        </button>

                        <button type="button"
                                class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                disabled="@busy"
                                @onclick="ClearForm">
                            <span>Clear</span>
                        </button>
                    </div>

                </div>
            }

        </div>

        <!-- ======================================================== -->
        <!-- RIGHT PANEL: Time Change History                         -->
        <!-- ======================================================== -->
        <aside class="page-panel-right min-w-0 rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-4">
            
            <!-- Panel Header -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 flex-wrap gap-2">
                <div>
                    <h2 class="text-sm font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2">
                        <span>📜</span>
                        <span>Time Change History &amp; Records</span>
                    </h2>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                        Select a record to inspect details or modify upcoming requests.
                    </p>
                </div>

                <!-- Stats summary chips -->
                <div class="flex items-center gap-1.5 text-[11px]">
                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-0.5 font-bold">
                        @allRows.Count Total
                    </span>
                    <span class="rounded-full bg-teal-100 dark:bg-teal-950 text-teal-800 dark:text-teal-300 px-2 py-0.5 font-bold">
                        @FutureCount Upcoming
                    </span>
                    <span class="rounded-full bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 px-2 py-0.5 font-bold">
                        @PendingCount Pending
                    </span>
                </div>
            </div>

            <!-- Search and Filter Pills -->
            <div class="flex flex-col gap-2">
                <!-- Search bar -->
                <div class="relative">
                    <input type="text"
                           placeholder="Search by reference, staff name, reason..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 pl-8 text-xs text-slate-800 dark:text-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                    <AppIcon Name="search" Class="w-4 h-4 text-slate-400 absolute left-2.5 top-2 text-base" />
                </div>

                <!-- Filter Pills -->
                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                    <button type="button"
                            class="rounded-lg px-2.5 py-1 font-bold transition @(historyFilter == "all" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                            @onclick='() => historyFilter = "all"'>
                        All (@FilteredRowsCount("all"))
                    </button>
                    <button type="button"
                            class="rounded-lg px-2.5 py-1 font-bold transition @(historyFilter == "future" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                            @onclick='() => historyFilter = "future"'>
                        Upcoming (@FilteredRowsCount("future"))
                    </button>
                    <button type="button"
                            class="rounded-lg px-2.5 py-1 font-bold transition @(historyFilter == "past" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                            @onclick='() => historyFilter = "past"'>
                        Past (Read-Only) (@FilteredRowsCount("past"))
                    </button>
                    <button type="button"
                            class="rounded-lg px-2.5 py-1 font-bold transition @(historyFilter == "pending" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                            @onclick='() => historyFilter = "pending"'>
                        Pending (@FilteredRowsCount("pending"))
                    </button>
                    <button type="button"
                            class="rounded-lg px-2.5 py-1 font-bold transition @(historyFilter == "late" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                            @onclick='() => historyFilter = "late"'>
                        Late Check-In
                    </button>
                    <button type="button"
                            class="rounded-lg px-2.5 py-1 font-bold transition @(historyFilter == "early" ? "bg-teal-700 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")"
                            @onclick='() => historyFilter = "early"'>
                        Early Check-Out
                    </button>
                </div>
            </div>

            <!-- History List -->
            @if (busy && allRows.Count == 0)
            {
                <div class="py-12 text-center text-xs text-slate-400 animate-pulse">
                    Loading time change history…
                </div>
            }
            else if (FilteredRows.Count == 0)
            {
                <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                    <p class="font-bold text-slate-700 dark:text-slate-300">No time change records found</p>
                    <p class="text-[11px] mt-1">There are no requests matching your active filter.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2.5 max-h-[720px] overflow-y-auto pr-1">
                    @foreach (var row in FilteredRows)
                    {
                        var isPast = row.ScheduledStart.Date < Today;
                        var isSelected = editingRow?.Id == row.Id;

                        <article @key="row.Id"
                                 class="rounded-xl border p-3 text-xs transition cursor-pointer hover:shadow-xs flex flex-col gap-2 @(isSelected ? "border-teal-500 dark:border-teal-400 bg-teal-50/70 dark:bg-teal-950/40 shadow-xs ring-1 ring-teal-500" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700 shadow-2xs")"
                                 @onclick="() => SelectRow(row)">
                            
                            <!-- Top row: Reference, Type, Status -->
                            <div class="flex items-center justify-between flex-wrap gap-2">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-mono text-[11px] font-semibold text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 px-2 py-0.5 rounded-md">
                                        #@row.Reference
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(row.Staff))
                                    {
                                        <span class="text-slate-400">·</span>
                                        <span class="font-medium text-slate-700 dark:text-slate-300">@row.Staff</span>
                                    }
                                    <span class="rounded px-1.5 py-0.2 text-[10px] font-bold @(row.Kind == "EarlyCheckOut" ? "bg-amber-50 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200" : "bg-teal-50 text-teal-800 dark:bg-teal-950/50 dark:text-teal-300 border border-teal-200")">
                                        @(row.Kind == "EarlyCheckOut" ? "Early Check-Out" : "Late Check-In")
                                    </span>
                                </div>

                                <div class="flex items-center gap-1.5">
                                    <!-- Past vs Upcoming Indicator -->
                                    @if (isPast)
                                    {
                                        <span class="rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 text-[10px] font-bold">
                                            Past Date (Locked)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 text-[10px] font-bold">
                                            Upcoming (Editable)
                                        </span>
                                    }

                                    <!-- Status Badge -->
                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-bold @GetStatusBadgeClass(row.Status)">
                                        @row.Status
                                    </span>
                                </div>
                            </div>

                            <!-- Details Row -->
                            <div class="bg-slate-50 dark:bg-slate-800/60 rounded-lg p-2 text-[11px] text-slate-600 dark:text-slate-300 flex flex-col gap-1">
                                <div class="flex items-center justify-between flex-wrap gap-1">
                                    <span>
                                        📅 <strong>Scheduled:</strong> @row.ScheduledStart.ToString("dd MMM yyyy, HH:mm")
                                    </span>
                                    @if (row.RequestedStart.HasValue && row.RequestedEnd.HasValue)
                                    {
                                        <span>
                                            ⏰ <strong>Requested:</strong> @row.RequestedStart.Value.ToString("HH:mm") – @row.RequestedEnd.Value.ToString("HH:mm")
                                        </span>
                                    }
                                </div>
                                <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
                                    <span>Plan: @(string.IsNullOrWhiteSpace(row.Schedule) ? "Standard Roster" : row.Schedule)</span>
                                    <span>Diff: @row.LateMinutes mins</span>
                                </div>
                            </div>

                            <!-- Reason text -->
                            @if (!string.IsNullOrWhiteSpace(row.Reason))
                            {
                                <p class="text-[11px] text-slate-700 dark:text-slate-300 line-clamp-2 italic">
                                    “@row.Reason”
                                </p>
                            }

                            <!-- Action Bar -->
                            <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800 flex-wrap gap-2 text-[11px]">
                                <div class="text-[10px] text-slate-400">
                                    @if (!string.IsNullOrWhiteSpace(row.Stage))
                                    {
                                        <span>Stage: @row.Stage</span>
                                    }
                                </div>

                                <div class="flex items-center gap-1.5">
                                    @if (isSelected)
                                    {
                                        <span class="text-teal-700 dark:text-teal-400 font-bold flex items-center gap-1">
                                            <span>●</span>
                                            <span>Active in Detail Panel</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-teal-600 dark:text-teal-400 font-semibold group-hover:underline">
                                            @(isPast ? "Inspect Details →" : "View & Edit →")
                                        </span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }

        </aside>

    </div>
</section>

<style>
    /* Explicit layout rules matching HRM.UI Design Standard */
    .page-panels {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 1rem;
        width: 100%;
        min-width: 0;
        padding: 0;
        margin-inline: auto;
        transition: max-width .3s ease;
        box-sizing: border-box;
    }

    .page-panels-standard {
        max-width: 80rem;
    }

    .page-panels-full {
        max-width: none;
    }

    .page-panel-left, .page-panel-right {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
    }

    @@media (min-width: 1024px) {
        .page-panels {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        }
    }
</style>

@code {
    private static DateTime Today => DateTime.UtcNow.AddHours(5).Date;

    // View state
    private bool isFullWidth = false;
    private bool busy = false;
    private bool scheduleLoading = false;
    private string? globalError;
    private string? formError;
    private string actionComment = "";

    // Left Form / Detail State
    private string kind = "LateCheckIn";
    private DateTime requestDate = Today;
    private TimeOnly? requestedTime;
    private string reason = "";
    private List<StaffScheduleAttendanceDto> candidates = [];
    private StaffScheduleAttendanceDto? selectedSchedule;
    private LateCheckInRow? editingRow;
    private bool isViewingPastRecord = false;
    private bool isEditingFutureRecord => editingRow != null && !isViewingPastRecord;

    // Right History State
    private List<LateCheckInRow> allRows = [];
    private string searchQuery = "";
    private string historyFilter = "all";

    private int FutureCount => allRows.Count(r => r.ScheduledStart.Date >= Today);
    private int PendingCount => allRows.Count(r => r.CanApprove || r.Status.Contains("Pending") || r.Status.Contains("Processing") || r.Status.Contains("Submitted"));

    private (DateTime Start, DateTime End)? calculatedPreview
    {
        get
        {
            if (isViewingPastRecord && editingRow?.RequestedStart != null && editingRow.RequestedEnd != null)
            {
                return (editingRow.RequestedStart.Value, editingRow.RequestedEnd.Value);
            }
            if (selectedSchedule == null || !requestedTime.HasValue) return null;
            try
            {
                var reqDt = AttendanceTimeChangeRules.RequestedDateTime(selectedSchedule, requestedTime.Value);
                return AttendanceTimeChangeRules.Calculate(selectedSchedule.ScheduledStart, selectedSchedule.ScheduledEnd, reqDt, kind);
            }
            catch
            {
                return null;
            }
        }
    }

    private string? previewError
    {
        get
        {
            if (isViewingPastRecord) return null;
            if (selectedSchedule == null) return "No scheduled working hours found.";
            if (!requestedTime.HasValue) return null;
            try
            {
                var reqDt = AttendanceTimeChangeRules.RequestedDateTime(selectedSchedule, requestedTime.Value);
                _ = AttendanceTimeChangeRules.Calculate(selectedSchedule.ScheduledStart, selectedSchedule.ScheduledEnd, reqDt, kind);
                return null;
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }

    private List<LateCheckInRow> FilteredRows
    {
        get
        {
            var query = allRows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim().ToLowerInvariant();
                query = query.Where(r => 
                    r.Reference.ToLowerInvariant().Contains(term) ||
                    (!string.IsNullOrWhiteSpace(r.Staff) && r.Staff.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrWhiteSpace(r.Reason) && r.Reason.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrWhiteSpace(r.Schedule) && r.Schedule.ToLowerInvariant().Contains(term)));
            }

            query = historyFilter switch
            {
                "future" => query.Where(r => r.ScheduledStart.Date >= Today),
                "past" => query.Where(r => r.ScheduledStart.Date < Today),
                "pending" => query.Where(r => r.CanApprove || r.Status.Contains("Pending") || r.Status.Contains("Processing") || r.Status.Contains("Submitted")),
                "late" => query.Where(r => r.Kind == "LateCheckIn"),
                "early" => query.Where(r => r.Kind == "EarlyCheckOut"),
                _ => query
            };

            return query.OrderByDescending(r => r.ScheduledStart).ToList();
        }
    }

    private int FilteredRowsCount(string filter)
    {
        var query = allRows.AsEnumerable();
        return filter switch
        {
            "future" => query.Count(r => r.ScheduledStart.Date >= Today),
            "past" => query.Count(r => r.ScheduledStart.Date < Today),
            "pending" => query.Count(r => r.CanApprove || r.Status.Contains("Pending") || r.Status.Contains("Processing") || r.Status.Contains("Submitted")),
            "late" => query.Count(r => r.Kind == "LateCheckIn"),
            "early" => query.Count(r => r.Kind == "EarlyCheckOut"),
            _ => query.Count()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadCandidatesForDateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.timechange.full-width");
                if (bool.TryParse(stored, out var val) && val != isFullWidth)
                {
                    isFullWidth = val;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "hrm.timechange.full-width", isFullWidth.ToString().ToLowerInvariant());
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        busy = true;
        globalError = null;
        try
        {
            // Load within valid 360-day window (past 180 days to future 180 days)
            var from = Today.AddDays(-180);
            var to = Today.AddDays(180);
            allRows = await Requests.LoadAsync(from, to, kind: null, pendingOnly: false) ?? new();
            if (editingRow != null)
            {
                var updated = allRows.FirstOrDefault(r => r.Id == editingRow.Id);
                if (updated != null)
                {
                    editingRow = updated;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load time change history");
            globalError = "Could not load time change history. Please click Refresh.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetKind(string newKind)
    {
        if (kind == newKind) return;
        kind = newKind;
        await LoadCandidatesForDateAsync();
    }

    private async Task DateChangedAsync()
    {
        requestedTime = null;
        formError = null;
        await LoadCandidatesForDateAsync();
    }

    private async Task LoadCandidatesForDateAsync()
    {
        scheduleLoading = true;
        formError = null;
        try
        {
            candidates = await Requests.GetCandidatesAsync(requestDate, requestDate, kind) ?? new();
            selectedSchedule = candidates.FirstOrDefault(s => s.Purpose.Equals("Official", StringComparison.OrdinalIgnoreCase))
                               ?? candidates.FirstOrDefault();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load candidates for date {Date}", requestDate);
            candidates = [];
            selectedSchedule = null;
        }
        finally
        {
            scheduleLoading = false;
        }
    }

    private void SelectRow(LateCheckInRow row)
    {
        var isPast = row.ScheduledStart.Date < Today;
        LoadIntoForm(row, isPast);
    }

    private void LoadIntoForm(LateCheckInRow row, bool isPast)
    {
        editingRow = row;
        isViewingPastRecord = isPast;
        kind = row.Kind;
        requestDate = row.ScheduledStart.Date;
        reason = row.Reason ?? "";
        formError = null;
        actionComment = "";

        if (row.Kind == "EarlyCheckOut" && row.RequestedEnd.HasValue)
        {
            requestedTime = TimeOnly.FromDateTime(row.RequestedEnd.Value);
        }
        else if (row.RequestedStart.HasValue)
        {
            requestedTime = TimeOnly.FromDateTime(row.RequestedStart.Value);
        }
        else
        {
            requestedTime = TimeOnly.FromDateTime(row.ScheduledStart);
        }

        _ = LoadCandidatesForDateAsync();
    }

    private void ClearForm()
    {
        editingRow = null;
        isViewingPastRecord = false;
        kind = "LateCheckIn";
        requestDate = Today;
        requestedTime = null;
        reason = "";
        formError = null;
        actionComment = "";
        _ = LoadCandidatesForDateAsync();
    }

    private async Task SubmitNewRequestAsync()
    {
        if (busy || !requestedTime.HasValue || string.IsNullOrWhiteSpace(reason) || previewError != null) return;
        if (requestDate < Today)
        {
            formError = "Past date time changes cannot be created. Choose today or a future date.";
            return;
        }

        busy = true;
        formError = null;
        try
        {
            var result = await Requests.SubmitForDateAsync(requestDate, requestedTime.Value, reason.Trim(), kind);
            if (result.Success)
            {
                Toasts.Success(result.Message);
                ClearForm();
                await LoadAsync();
            }
            else
            {
                formError = result.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed submitting time change request");
            formError = "Request could not be submitted. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UpdateFutureRequestAsync()
    {
        if (busy || editingRow == null || !requestedTime.HasValue || string.IsNullOrWhiteSpace(reason) || previewError != null) return;

        if (editingRow.ScheduledStart.Date < Today)
        {
            formError = "Past date change records cannot be edited.";
            return;
        }

        busy = true;
        formError = null;
        try
        {
            // 1. Cancel the existing future request
            var cancelResult = await Requests.ActAsync(editingRow.Id, editingRow.StateId, "Cancel", "Superseded by updated time-change request");
            if (!cancelResult.Success)
            {
                formError = $"Failed modifying existing request: {cancelResult.Message}";
                return;
            }

            // 2. Submit the new updated request
            var newResult = await Requests.SubmitForDateAsync(requestDate, requestedTime.Value, reason.Trim(), kind);
            if (newResult.Success)
            {
                Toasts.Success("Time-change request updated and resubmitted successfully.");
                ClearForm();
                await LoadAsync();
            }
            else
            {
                formError = $"Original request cancelled, but new submission failed: {newResult.Message}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed updating future time change request");
            formError = "Update could not be completed. Please refresh.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CancelFutureRequestAsync(LateCheckInRow row)
    {
        if (busy) return;
        if (row.ScheduledStart.Date < Today)
        {
            Toasts.Error("Past date records cannot be canceled.");
            return;
        }

        busy = true;
        try
        {
            var comment = !string.IsNullOrWhiteSpace(actionComment)
                ? actionComment.Trim()
                : "Cancelled by applicant.";
            var result = await Requests.ActAsync(row.Id, row.StateId, "Cancel", comment);
            if (result.Success)
            {
                Toasts.Success($"Request {row.Reference} cancelled successfully.");
                if (editingRow?.Id == row.Id) ClearForm();
                await LoadAsync();
            }
            else
            {
                Toasts.Error(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed cancelling request {Id}", row.Id);
            Toasts.Error("Failed cancelling request. Refresh and try again.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ActAsync(LateCheckInRow row, string action)
    {
        if (busy) return;
        busy = true;
        try
        {
            var comment = !string.IsNullOrWhiteSpace(actionComment) 
                ? actionComment.Trim() 
                : $"{action} executed from workspace command.";
            var result = await Requests.ActAsync(row.Id, row.StateId, action, comment);
            if (result.Success)
            {
                Toasts.Success(result.Message);
                actionComment = "";
                await LoadAsync();
                if (editingRow?.Id == row.Id)
                {
                    editingRow = allRows.FirstOrDefault(r => r.Id == row.Id);
                }
            }
            else
            {
                Toasts.Error(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to {Action} request {Id}", action, row.Id);
            Toasts.Error("Action could not be completed.");
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        var s when s.Contains("Approved", StringComparison.OrdinalIgnoreCase) => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300",
        var s when s.Contains("Rejected", StringComparison.OrdinalIgnoreCase) => "bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300",
        var s when s.Contains("Cancel", StringComparison.OrdinalIgnoreCase) => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300",
        _ => "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300"
    };
}
