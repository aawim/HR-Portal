            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isActionPending = false;
        }
    }

    private void OpenReviewModal(GoodsLoanDto loan)
    {
        loanUnderReview = loan;
        reviewRemarks = "";
        showReviewModal = true;
    }

    private async Task ApproveLoanAsync()
    {
        if (loanUnderReview == null) return;
        isActionPending = true;
        try
        {
            var res = await LoanService.ApproveLoanAsync(loanUnderReview.LoanID, 0, reviewRemarks);
            if (res.Success)
            {
                Toast.Success($"Loan #{loanUnderReview.LoanNumber} approved. Amortisation schedule activated.");
                showReviewModal = false;
                await ReloadAllDataAsync();
            }
            else
            {
                Toast.Error(res.Message, "Approval Failed");
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isActionPending = false;
        }
    }

    private async Task RejectLoanAsync()
    {
        if (loanUnderReview == null) return;
        if (string.IsNullOrWhiteSpace(reviewRemarks))
        {
            Toast.Error("Please provide a rejection reason.");
            return;
        }

        isActionPending = true;
        try
        {
            var res = await LoanService.RejectLoanAsync(loanUnderReview.LoanID, 0, reviewRemarks);
            if (res.Success)
            {
                Toast.Success($"Loan #{loanUnderReview.LoanNumber} rejected.");
                showReviewModal = false;
                await ReloadAllDataAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isActionPending = false;
        }
    }

    private async Task GenerateSettlementBatchAsync()
    {
        if (newSettlementStoreId <= 0) return;
        isActionPending = true;
        try
        {
            var res = await LoanService.CreateStoreSettlementBatchAsync(new CreateStoreSettlementBatchRequest
            {
                OrganisationBusinessEntityID = activeOrganisationId,
                StoreID = newSettlementStoreId,
                SettlementDate = newSettlementDate
            }, 0);

            if (res.Success)
            {
                Toast.Success("Store settlement batch created successfully.");
                showSettlementModal = false;
                await ReloadAllDataAsync();
            }
            else
            {
                Toast.Error(res.Message, "Settlement Batch Failed");
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isActionPending = false;
        }
    }

    private async Task ApproveSettlementAsync(int settlementId)
    {
        var res = await LoanService.ApproveStoreSettlementAsync(settlementId, 0);
        if (res.Success)
        {
            Toast.Success("Settlement batch approved for payment.");
            await ReloadAllDataAsync();
        }
        else
        {
            Toast.Error(res.Message);
        }
    }

    private async Task ConfirmSettlementPaidAsync(int settlementId)
    {
        var res = await LoanService.ConfirmStoreSettlementPaidAsync(settlementId, 0, "BML-TRF-" + Random.Shared.Next(100000, 999999));
        if (res.Success)
        {
            Toast.Success("Settlement confirmed paid to store.");
            await ReloadAllDataAsync();
        }
        else
        {
            Toast.Error(res.Message);
        }
    }

    private RenderFragment RenderStatusBadge(string status) => builder =>
    {
        var (cls, text) = status switch
        {
            GoodsLoanStatus.Active => ("bg-emerald-100 text-emerald-800", "ACTIVE"),
            GoodsLoanStatus.PendingApproval => ("bg-amber-100 text-amber-800", "PENDING"),
            GoodsLoanStatus.Completed => ("bg-blue-100 text-blue-800", "COMPLETED"),
            GoodsLoanStatus.Rejected => ("bg-rose-100 text-rose-800", "REJECTED"),
            GoodsLoanStatus.Cancelled => ("bg-slate-100 text-slate-700", "CANCELLED"),
            _ => ("bg-slate-100 text-slate-700", status)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"rounded-full px-2 py-0.5 text-[10px] font-bold {cls}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

