    protected override async Task OnInitializedAsync()
    {
        activeOrganisationId = await AccessService.GetCurrentOrganisationIdAsync();
        await ReloadAllDataAsync();
    }

    private void SetTab(AdminTab tab)
    {
        activeTab = tab;
    }

    private void ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
    }

    private async Task ReloadAllDataAsync()
    {
        isLoading = true;
        try
        {
            stores = await LoanService.GetStoresAsync(activeOrganisationId);
            agreements = await LoanService.GetAgreementsAsync(activeOrganisationId);
            currentPolicy = await LoanService.GetActivePolicyAsync(activeOrganisationId) ?? new GoodsLoanDeductionPolicyDto
            {
                OrganisationBusinessEntityID = activeOrganisationId,
                PolicyName = "Default Organization Loan Policy",
                MaximumSalaryPercentage = 20.0m,
                SalaryBasis = SalaryCalculationBasis.BasicSalary,
                EffectiveFrom = DateTime.Today,
                IsActive = true
            };
            allLoans = await LoanService.GetLoansAsync(new GoodsLoanFilterRequest
            {
                OrganisationBusinessEntityID = activeOrganisationId
            });
            settlements = await LoanService.GetStoreSettlementsAsync(activeOrganisationId);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, "Error Loading Admin Data");
        }
        finally
        {
            isLoading = false;
        }
    }

