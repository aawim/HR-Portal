    #region Action Handlers

    private void OpenAddStoreModal()
    {
        storeEditModel = new SaveGoodsLoanStoreRequest();
        showStoreModal = true;
    }

    private void OpenEditStoreModal(GoodsLoanStoreDto store)
    {
        storeEditModel = new SaveGoodsLoanStoreRequest
        {
            StoreID = store.StoreID,
            StoreCode = store.StoreCode,
            StoreName = store.StoreName,
            RegistrationNumber = store.RegistrationNumber,
            ContactPerson = store.ContactPerson,
            PhoneNumber = store.PhoneNumber,
            Email = store.Email,
            Address = store.Address
        };
        showStoreModal = true;
    }

    private async Task SaveStoreAsync()
    {
        if (string.IsNullOrWhiteSpace(storeEditModel.StoreCode) || string.IsNullOrWhiteSpace(storeEditModel.StoreName))
        {
            Toast.Error("Store code and store name are required.");
            return;
        }

        isActionPending = true;
        try
        {
            var res = await LoanService.SaveStoreAsync(storeEditModel);
            if (res.Success)
            {
                Toast.Success("Store registered/updated successfully.");
                showStoreModal = false;
                await ReloadAllDataAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isActionPending = false;
        }
    }

    private async Task ToggleStoreActiveAsync(int storeId, bool isActive)
    {
        var res = await LoanService.ToggleStoreActiveAsync(storeId, isActive);
        if (res.Success)
        {
            Toast.Success($"Store status updated to {(isActive ? "Active" : "Inactive")}.");
            await ReloadAllDataAsync();
        }
        else
        {
            Toast.Error(res.Message);
        }
    }

    private void OpenAddAgreementModal()
    {
        agreementEditModel = new SaveGoodsLoanStoreAgreementRequest
        {
            OrganisationBusinessEntityID = activeOrganisationId,
            MinimumMonths = 1,
            MaximumMonths = 36,
            MaximumLoanAmount = 25000m,
            SettlementMode = GoodsLoanSettlementMode.Monthly,
            EffectiveFrom = DateTime.Today
