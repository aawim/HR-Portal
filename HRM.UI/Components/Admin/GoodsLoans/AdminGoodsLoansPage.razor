@page "/admin/goods-loans"
@page "/admin/hr/goods-loans"
@namespace HRM.Components.Admin.GoodsLoans
@using HRM.Application.Contracts.Pages
@using HRM.DTOs
@using HRM.DTOs.GoodsLoans
@using HRM.Models.GoodsLoans
@using HRM.Services
@using HRM.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer
@inject IGoodsLoanService LoanService
@inject IUserAccessService AccessService
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>Staff Goods Loan Management - Admin Portal</PageTitle>

<div class="mx-auto min-w-7xl max-w-full p-2 flex flex-col gap-3">
    <!-- Header -->
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-4 py-3 shadow-xs rounded-xl flex items-center justify-between flex-wrap gap-2">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-lg font-bold text-slate-900">Staff Goods Loan Management</h1>
                <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                    HR & Finance Administration
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">
                Manage merchant stores, organisation agreements, salary deduction policies, loan approvals, payroll schedules, and store settlements.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
                    @onclick="ToggleFullWidth">
                @if (isFullWidth)
                {
                    <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                    <span>Shrink View</span>
                }
                else
                {
                    <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                    <span>Full Width</span>
                }
            </button>

            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
                    @onclick="ReloadAllDataAsync"
                    disabled="@isLoading">
                <svg class="h-3.5 w-3.5 text-slate-500 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Refresh</span>
            </button>
        </div>
    </header>

    <!-- Top Summary Metrics Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs">
            <div class="text-[11px] font-medium text-slate-500">Active Loans</div>
            <div class="text-lg font-bold text-slate-900 mt-1">@activeLoansCount</div>
            <div class="text-[10px] text-slate-400 mt-0.5">Across all staff</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs">
            <div class="text-[11px] font-medium text-slate-500">Pending Approvals</div>
            <div class="text-lg font-bold text-amber-600 mt-1">@pendingApprovalsCount</div>
            <div class="text-[10px] text-slate-400 mt-0.5">Awaiting HR action</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs">
            <div class="text-[11px] font-medium text-slate-500">Total Disbursed</div>
            <div class="text-lg font-bold text-blue-600 mt-1">MVR @totalDisbursed.ToString("N0")</div>
            <div class="text-[10px] text-slate-400 mt-0.5">Purchase value</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs">
            <div class="text-[11px] font-medium text-slate-500">Total Repaid</div>
            <div class="text-lg font-bold text-emerald-600 mt-1">MVR @totalRepaid.ToString("N0")</div>
            <div class="text-[10px] text-slate-400 mt-0.5">Collected deductions</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs">
            <div class="text-[11px] font-medium text-slate-500">Total Outstanding</div>
            <div class="text-lg font-bold text-amber-600 mt-1">MVR @totalOutstanding.ToString("N0")</div>
            <div class="text-[10px] text-slate-400 mt-0.5">Active portfolio</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-xs">
            <div class="text-[11px] font-medium text-slate-500">Store Settlements</div>
            <div class="text-lg font-bold text-slate-900 mt-1">@settlements.Count(s => s.Status == GoodsLoanSettlementStatus.Draft)</div>
            <div class="text-[10px] text-slate-400 mt-0.5">Batches pending pay</div>
        </div>
    </div>

    <!-- Admin Tabs -->
    <div class="flex border-b border-slate-200 gap-1 overflow-x-auto text-xs font-semibold">
        <button type="button"
                class="px-4 py-2 border-b-2 transition flex items-center gap-1.5 @(activeTab == AdminTab.Approvals ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Approvals)">
            <span>Loan Approvals</span>
            @if (pendingApprovalsCount > 0)
            {
                <span class="rounded-full bg-amber-500 text-white px-1.5 py-0.2 text-[10px] font-bold">
                    @pendingApprovalsCount
                </span>
            }
        </button>

        <button type="button"
                class="px-4 py-2 border-b-2 transition @(activeTab == AdminTab.Register ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Register)">
            Loan Register
        </button>

        <button type="button"
                class="px-4 py-2 border-b-2 transition @(activeTab == AdminTab.Stores ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Stores)">
            Merchant Stores (@stores.Count)
        </button>

        <button type="button"
                class="px-4 py-2 border-b-2 transition @(activeTab == AdminTab.Agreements ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Agreements)">
            Store Agreements (@agreements.Count)
        </button>

        <button type="button"
                class="px-4 py-2 border-b-2 transition @(activeTab == AdminTab.Policy ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Policy)">
            Deduction Policy
        </button>

        <button type="button"
                class="px-4 py-2 border-b-2 transition @(activeTab == AdminTab.Settlements ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Settlements)">
            Store Settlements
        </button>

        <button type="button"
                class="px-4 py-2 border-b-2 transition @(activeTab == AdminTab.Reports ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:text-slate-800")"
                @onclick="() => SetTab(AdminTab.Reports)">
            Reports & Statements
        </button>
    </div>

    <!-- TAB CONTENTS -->
    @switch (activeTab)
    {
        case AdminTab.Approvals:
            @RenderApprovalsTab()
            break;

        case AdminTab.Register:
            @RenderRegisterTab()
            break;

        case AdminTab.Stores:
            @RenderStoresTab()
            break;

        case AdminTab.Agreements:
            @RenderAgreementsTab()
            break;

        case AdminTab.Policy:
            @RenderPolicyTab()
            break;

        case AdminTab.Settlements:
            @RenderSettlementsTab()
            break;

        case AdminTab.Reports:
            @RenderReportsTab()
            break;
    }
</div>

<!-- MODAL: ADD / EDIT STORE -->
@if (showStoreModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
        <div class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-5 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900">@(storeEditModel.StoreID > 0 ? "Edit Store" : "Register New Merchant Store")</h3>
                <button type="button" class="text-slate-400 hover:text-slate-600 font-bold" @onclick="() => showStoreModal = false">✕</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Store Code *</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. SONEESTORE" @bind="storeEditModel.StoreCode" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Store Name *</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. Sonee Hardware" @bind="storeEditModel.StoreName" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Registration #</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. C-0123/2005" @bind="storeEditModel.RegistrationNumber" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Contact Person</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. Ahmed Ali" @bind="storeEditModel.ContactPerson" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Phone Number</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. 3330000" @bind="storeEditModel.PhoneNumber" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Email Address</label>
                    <input type="email" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. info@store.mv" @bind="storeEditModel.Email" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block font-semibold text-slate-800 p-1">Physical Address</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. Boduthakurufaanu Magu, Male'" @bind="storeEditModel.Address" />
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" @onclick="() => showStoreModal = false">Cancel</button>
                <button type="button" class="rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50" disabled="@isActionPending" @onclick="SaveStoreAsync">Save Store</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: ADD / EDIT STORE AGREEMENT -->
@if (showAgreementModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
        <div class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-5 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900">@(agreementEditModel.AgreementID > 0 ? "Edit Store Agreement" : "Create Store Agreement")</h3>
                <button type="button" class="text-slate-400 hover:text-slate-600 font-bold" @onclick="() => showAgreementModal = false">✕</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Store / Merchant *</label>
                    <select class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.StoreID">
                        <option value="0">-- Select Store --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.StoreID">@s.StoreName (@s.StoreCode)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Agreement Number *</label>
                    <input type="text" class="w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="e.g. AGR-2026-SONEE-01" @bind="agreementEditModel.AgreementNumber" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Minimum Repayment Months</label>
                    <input type="number" min="1" max="60" class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.MinimumMonths" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Maximum Repayment Months</label>
                    <input type="number" min="1" max="60" class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.MaximumMonths" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Maximum Loan Cap (MVR) *</label>
                    <input type="number" step="1000" min="0" class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.MaximumLoanAmount" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Settlement Mode *</label>
                    <select class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.SettlementMode">
                        <option value="@GoodsLoanSettlementMode.Monthly">MONTHLY (As Deducted From Staff)</option>
                        <option value="@GoodsLoanSettlementMode.Upfront">UPFRONT (Upon Loan Approval)</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Effective From Date *</label>
                    <input type="date" class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.EffectiveFrom" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Effective To Date (Optional)</label>
                    <input type="date" class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="agreementEditModel.EffectiveTo" />
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" @onclick="() => showAgreementModal = false">Cancel</button>
                <button type="button" class="rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50" disabled="@isActionPending" @onclick="SaveAgreementAsync">Save Agreement</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: REVIEW LOAN APPLICATION -->
@if (showReviewModal && loanUnderReview != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
        <div class="w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-5 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Review Goods Loan Application</h3>
                    <span class="font-mono text-xs text-blue-700 font-bold">@loanUnderReview.LoanNumber</span>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 font-bold" @onclick="() => showReviewModal = false">✕</button>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
                    <span class="text-slate-400 block text-[11px]">Employee</span>
                    <span class="font-bold text-slate-900 mt-0.5 block">@loanUnderReview.EmployeeName</span>
                    <span class="text-[10px] text-slate-500 font-mono">@loanUnderReview.EmployeeNumber</span>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
                    <span class="text-slate-400 block text-[11px]">Store</span>
                    <span class="font-bold text-slate-900 mt-0.5 block">@loanUnderReview.StoreName</span>
                    <span class="text-[10px] text-slate-500">Invoice: @loanUnderReview.InvoiceNumber</span>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
                    <span class="text-slate-400 block text-[11px]">Repayment Duration</span>
                    <span class="font-bold text-slate-900 mt-0.5 block">@loanUnderReview.RepaymentMonths Months</span>
                    <span class="text-[10px] text-slate-500">First: @loanUnderReview.FirstDeductionMonth.ToString("MMM yyyy")</span>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
                    <span class="text-slate-400 block text-[11px]">Principal Amount</span>
                    <span class="font-bold text-blue-700 mt-0.5 block text-sm">MVR @loanUnderReview.PrincipalAmount.ToString("N2")</span>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
                    <span class="text-slate-400 block text-[11px]">Monthly Deduction</span>
                    <span class="font-bold text-slate-900 mt-0.5 block text-sm">MVR @loanUnderReview.MonthlyDeductionAmount.ToString("N2")</span>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
                    <span class="text-slate-400 block text-[11px]">Interest Rate</span>
                    <span class="font-bold text-emerald-600 mt-0.5 block text-sm">0.00%</span>
                </div>
            </div>

            <!-- Goods Items Table -->
            <div class="space-y-1.5">
                <h4 class="text-xs font-bold text-slate-800">Items Purchased Under Loan</h4>
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-2">Description</th>
                                <th class="p-2 text-center w-16">Qty</th>
                                <th class="p-2 text-right w-28">Unit Price</th>
                                <th class="p-2 text-right w-28">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var itm in loanUnderReview.Items)
                            {
                                <tr>
                                    <td class="p-2 font-medium text-slate-900">@itm.ItemDescription</td>
                                    <td class="p-2 text-center text-slate-600">@itm.Quantity</td>
                                    <td class="p-2 text-right text-slate-600">MVR @itm.UnitPrice.ToString("N2")</td>
                                    <td class="p-2 text-right font-semibold text-slate-900">MVR @itm.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Review Actions & Remarks -->
            <div class="space-y-2 pt-2 border-t border-slate-100">
                <label class="block font-semibold text-slate-800 text-xs p-1">Approval / Rejection Remarks</label>
                <textarea class="w-full rounded-lg border border-slate-300 p-2 text-xs"
                          rows="2"
                          placeholder="Provide approval decision notes or rejection reason..."
                          @bind="reviewRemarks"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                <button type="button"
                        class="rounded-lg border border-rose-300 bg-white px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-50 disabled:opacity-50"
                        disabled="@isActionPending"
                        @onclick="RejectLoanAsync">
                    Reject Application
                </button>
                <button type="button"
                        class="rounded-lg bg-emerald-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"
                        disabled="@isActionPending"
                        @onclick="ApproveLoanAsync">
                    Approve Loan & Generate @loanUnderReview.RepaymentMonths Instalments
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL: SETTLEMENT BATCH GENERATION -->
@if (showSettlementModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-5 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900">Generate Store Settlement Batch</h3>
                <button type="button" class="text-slate-400 hover:text-slate-600 font-bold" @onclick="() => showSettlementModal = false">✕</button>
            </div>
            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Select Store *</label>
                    <select class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="newSettlementStoreId">
                        <option value="0">-- Select Merchant Store --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.StoreID">@s.StoreName (@s.StoreCode)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-slate-800 p-1">Settlement Period Up To *</label>
                    <input type="date" class="w-full rounded-lg border border-slate-300 p-2 text-xs" @bind="newSettlementDate" />
                    <span class="text-[11px] text-slate-400 mt-0.5 block">
                        Aggregates all unpaid deductions / approved upfront amounts up to this date.
                    </span>
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" @onclick="() => showSettlementModal = false">Cancel</button>
                <button type="button" class="rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50" disabled="@(newSettlementStoreId <= 0 || isActionPending)" @onclick="GenerateSettlementBatchAsync">Generate Batch</button>
            </div>
        </div>
    </div>
}

@code {
    private enum AdminTab { Approvals, Register, Stores, Agreements, Policy, Settlements, Reports }

    private AdminTab activeTab = AdminTab.Approvals;
