        try
        {
            var res = await LoanService.SaveAgreementAsync(agreementEditModel);
            if (res.Success)
            {
                Toast.Success("Agreement saved successfully.");
                showAgreementModal = false;
                await ReloadAllDataAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isActionPending = false;
        }
    }

