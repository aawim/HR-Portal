@using System.IO
@using HRM.Application.DTOs.Budget
@using HRM.Application.Interfaces.Budget
@using HRM.Services.Exports
@using Microsoft.JSInterop
@inject IBudgetService BudgetService
@inject IJSRuntime JS

<section class="budget-overview w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100">
    <!-- Compact Transparent Borderless Section Header -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">State Budget Execution &amp; Personal Emoluments</h2>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Law No. 3/2006 · MoF Bandeyri
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Appropriated budget, net virements, commitments, personal emoluments expenditure, and unencumbered balances.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            @if (fiscalYears.Count > 0)
            {
                <div class="inline-flex items-center gap-1.5">
                    <label for="overview-fy-select" class="text-[11px] font-semibold text-slate-600 dark:text-slate-300">Fiscal Year</label>
                    <select id="overview-fy-select"
                            class="h-8 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-2.5 text-xs font-semibold text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none"
                            @bind="selectedFiscalYear"
                            @bind:after="LoadSummaryAsync">
                        @foreach (var fy in fiscalYears)
                        {
                            <option value="@fy.YearNumber">FY @fy.YearNumber (@fy.Status)</option>
                        }
                    </select>
                </div>
            }

            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    @onclick="ExportCsvAsync"
                    disabled="@(isExporting || summary == null)">
                <i class="bi bi-file-earmark-spreadsheet text-xs text-emerald-600" aria-hidden="true"></i>
                <span>Export MoF CSV</span>
            </button>

            <button type="button"
                    class="app-button app-button-primary app-button-sm"
                    @onclick="ExportPdfAsync"
                    disabled="@(isExporting || summary == null)">
                <i class="bi bi-file-earmark-pdf text-xs" aria-hidden="true"></i>
                <span>Export Official PDF</span>
            </button>
        </div>
    </header>

    @if (isLoading)
    {
        <div role="status" class="flex items-center justify-center gap-2 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-10 text-xs text-slate-500">
            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
            <span>Loading budget ledger data…</span>
        </div>
    }
    else if (summary != null)
    {
        <!-- Executive KPI Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Approved Budget</span>
                <span class="text-lg font-bold text-slate-900 dark:text-slate-100 tabular-nums">MVR @summary.TotalApprovedBudget.ToString("N2")</span>
                <span class="text-[11px] text-slate-400 dark:text-slate-500">Appropriated via People's Majlis</span>
            </div>

            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Revised Budget (Net Virements)</span>
                <span class="text-lg font-bold text-blue-700 dark:text-blue-400 tabular-nums">MVR @summary.TotalRevisedBudget.ToString("N2")</span>
                <span class="text-[11px] text-blue-600 dark:text-blue-400 tabular-nums">
                    Net: @((summary.TotalVirementsIn - summary.TotalVirementsOut) >= 0 ? $"+{summary.TotalVirementsIn - summary.TotalVirementsOut:N2}" : $"{summary.TotalVirementsIn - summary.TotalVirementsOut:N2}") MVR
                </span>
            </div>

            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Expended (Personal Emoluments)</span>
                <span class="text-lg font-bold text-emerald-700 dark:text-emerald-400 tabular-nums">MVR @summary.TotalExpended.ToString("N2")</span>
                <div class="flex items-center gap-2 mt-1">
                    <div class="flex-grow bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
                        <div class="bg-emerald-500 h-1.5 rounded-full" style="width: @Math.Min(100, summary.OverallBurnRatePercentage)%"></div>
                    </div>
                    <span class="text-[11px] font-bold text-slate-600 dark:text-slate-300 tabular-nums">@summary.OverallBurnRatePercentage%</span>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs flex flex-col gap-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Available Unencumbered Balance</span>
                <span class="text-lg font-bold tabular-nums @(summary.TotalAvailableBalance < 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-900 dark:text-slate-100")">
                    MVR @summary.TotalAvailableBalance.ToString("N2")
                </span>
                <span class="text-[11px] text-slate-400 dark:text-slate-500 tabular-nums">Committed: MVR @summary.TotalCommitted.ToString("N2")</span>
            </div>
        </div>

        <!-- Breakdown Table Card -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
            <div class="bg-slate-50/80 dark:bg-slate-800/60 px-4 py-2.5 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
                    Ministry of Finance Economic Classification (Chapter 21 Emoluments)
                </h3>
                <span class="inline-flex items-center rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 px-2.5 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    Fiscal Year @summary.FiscalYear · @summary.Allocations.Count line@(summary.Allocations.Count == 1 ? "" : "s")
                </span>
            </div>

            @if (summary.Allocations.Count == 0)
            {
                <div class="p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                    No budget allocations recorded for Fiscal Year @summary.FiscalYear.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 font-bold uppercase tracking-wider text-[10px]">
                                <th class="px-3 py-2.5">MoF Code</th>
                                <th class="px-3 py-2.5">Economic Line Item</th>
                                <th class="px-3 py-2.5 text-right">Approved (MVR)</th>
                                <th class="px-3 py-2.5 text-right">Net Virement</th>
                                <th class="px-3 py-2.5 text-right">Revised (MVR)</th>
                                <th class="px-3 py-2.5 text-right">Committed</th>
                                <th class="px-3 py-2.5 text-right">Expended (MVR)</th>
                                <th class="px-3 py-2.5 text-right">Available (MVR)</th>
                                <th class="px-3 py-2.5 text-center">% Util</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var row in summary.Allocations)
                            {
                                <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="px-3 py-2.5 font-mono font-semibold text-slate-700 dark:text-slate-200">@row.EconomicCode</td>
                                    <td class="px-3 py-2.5">
                                        <div class="font-semibold text-slate-800 dark:text-slate-100">@row.DhivehiName</div>
                                        @if (!string.IsNullOrWhiteSpace(row.EnglishName))
                                        {
                                            <div class="text-[11px] text-slate-400 dark:text-slate-500">@row.EnglishName</div>
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 text-right font-mono tabular-nums text-slate-700 dark:text-slate-300">@row.ApprovedAmount.ToString("N2")</td>
                                    <td class="px-3 py-2.5 text-right font-mono tabular-nums @(row.NetVirement >= 0 ? "text-blue-600 dark:text-blue-400" : "text-amber-600 dark:text-amber-400")">
                                        @(row.NetVirement >= 0 ? $"+{row.NetVirement:N2}" : row.NetVirement.ToString("N2"))
                                    </td>
                                    <td class="px-3 py-2.5 text-right font-mono tabular-nums font-semibold text-slate-800 dark:text-slate-100">@row.CurrentBudget.ToString("N2")</td>
                                    <td class="px-3 py-2.5 text-right font-mono tabular-nums text-amber-700 dark:text-amber-400">@row.CommittedAmount.ToString("N2")</td>
                                    <td class="px-3 py-2.5 text-right font-mono tabular-nums text-emerald-700 dark:text-emerald-400 font-semibold">@row.ExpendedAmount.ToString("N2")</td>
                                    <td class="px-3 py-2.5 text-right font-mono tabular-nums font-bold @(row.AvailableBalance < 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-800 dark:text-slate-100")">
                                        @row.AvailableBalance.ToString("N2")
                                    </td>
                                    <td class="px-3 py-2.5 text-center">
                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold tabular-nums @(row.UtilizationPercentage >= 90 ? "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300" : "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">
                                            @row.UtilizationPercentage%
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="bg-slate-100/80 dark:bg-slate-800/70 font-bold border-t border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100">
                                <td class="px-3 py-2.5 text-center" colspan="2">TOTAL</td>
                                <td class="px-3 py-2.5 text-right font-mono tabular-nums">@summary.TotalApprovedBudget.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono tabular-nums">@((summary.TotalVirementsIn - summary.TotalVirementsOut) >= 0 ? $"+{summary.TotalVirementsIn - summary.TotalVirementsOut:N2}" : $"{summary.TotalVirementsIn - summary.TotalVirementsOut:N2}")</td>
                                <td class="px-3 py-2.5 text-right font-mono tabular-nums">@summary.TotalRevisedBudget.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono tabular-nums">@summary.TotalCommitted.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono tabular-nums text-emerald-800 dark:text-emerald-300">@summary.TotalExpended.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono tabular-nums text-blue-900 dark:text-blue-300">@summary.TotalAvailableBalance.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-center tabular-nums">@summary.OverallBurnRatePercentage%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center text-xs text-slate-500">
            No budget summary is available for the selected fiscal year.
        </div>
    }
</section>

@code {
    private List<FiscalYearDto> fiscalYears = new();
    private int selectedFiscalYear = DateTime.UtcNow.Year;
    private BudgetSummaryDto? summary;
    private bool isLoading = true;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            fiscalYears = await BudgetService.GetFiscalYearsAsync();
            var activeFy = fiscalYears.FirstOrDefault(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))
                ?? fiscalYears.FirstOrDefault();
            if (activeFy != null)
            {
                selectedFiscalYear = activeFy.YearNumber;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading fiscal years: {ex.Message}");
        }

        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        isLoading = true;
        try
        {
            summary = await BudgetService.GetBudgetSummaryAsync(selectedFiscalYear, 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading budget: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (summary == null || isExporting) return;
        isExporting = true;
        try
        {
            var bytes = await BudgetService.ExportBudgetCsvAsync(summary.FiscalYear, 0);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await module.InvokeVoidAsync("download", $"Maldives_Budget_Execution_{summary.FiscalYear}.csv", "text/csv;charset=utf-8", reference);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CSV export error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task ExportPdfAsync()
    {
        if (summary == null || isExporting) return;
        isExporting = true;
        try
        {
            var bytes = BudgetPdfGenerator.GenerateBudgetExecutionPdf(summary);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await module.InvokeVoidAsync("download", $"Maldives_State_Budget_Execution_{summary.FiscalYear}.pdf", "application/pdf", reference);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PDF export error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
}
