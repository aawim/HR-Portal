@using System.IO
@using HRM.Application.DTOs.Budget
@using HRM.Application.Interfaces.Budget
@inject IBudgetService BudgetService

<section class="budget-virements w-full min-w-0 p-2 space-y-4">
    <!-- Sticky Header -->
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-4 py-3 shadow-xs rounded-xl flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xl shadow-xs">
                🔄
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 leading-tight">Budget Virements &amp; Fund Re-appropriation</h1>
                <p class="text-xs text-slate-500">Public Finance Act (Law No. 3/2006) Section 5 &amp; MoF Approval Controls</p>
            </div>
        </div>

        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition"
                @onclick="OpenNewVirementModal">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>New Virement Request</span>
        </button>
    </header>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-rose-800 text-xs flex items-center justify-between">
            <span>@errorMessage</span>
            <button type="button" @onclick="() => errorMessage = null" class="text-rose-500 hover:text-rose-700 font-bold">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-xs flex items-center justify-between">
            <span>@successMessage</span>
            <button type="button" @onclick="() => successMessage = null" class="text-emerald-500 hover:text-emerald-700 font-bold">&times;</button>
        </div>
    }

    <!-- Virements Table -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-800">Approved Budget Transfers (Internal &amp; Inter-Vote)</h3>
            <span class="text-xs text-slate-400">Total: @(virements?.Count ?? 0) recorded</span>
        </div>

        @if (isLoading)
        {
            <div class="flex items-center justify-center p-8 text-slate-400">
                <span>Loading virement ledger...</span>
            </div>
        }
        else if (virements == null || virements.Count == 0)
        {
            <div class="p-8 text-center text-slate-400 text-sm">
                No budget virements recorded for this fiscal year.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                            <th class="px-3 py-2.5">Virement #</th>
                            <th class="px-3 py-2.5">Source Vote (From)</th>
                            <th class="px-3 py-2.5">Target Vote (To)</th>
                            <th class="px-3 py-2.5 text-right">Amount (MVR)</th>
                            <th class="px-3 py-2.5">Justification &amp; Legal Basis</th>
                            <th class="px-3 py-2.5">MoF Reference</th>
                            <th class="px-3 py-2.5 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var v in virements)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-3 py-2.5 font-mono font-semibold text-blue-700">@v.VirementNumber</td>
                                <td class="px-3 py-2.5">
                                    <span class="font-mono text-slate-500">[@v.FromEconomicCode]</span>
                                    <span class="font-medium text-slate-800">@v.FromItemName</span>
                                </td>
                                <td class="px-3 py-2.5">
                                    <span class="font-mono text-slate-500">[@v.ToEconomicCode]</span>
                                    <span class="font-medium text-slate-800">@v.ToItemName</span>
                                </td>
                                <td class="px-3 py-2.5 text-right font-mono font-bold text-slate-800">MVR @v.Amount.ToString("N2")</td>
                                <td class="px-3 py-2.5">
                                    <div class="text-slate-700">@v.Justification</div>
                                    <div class="text-[10px] text-slate-400">@v.LegalBasis</div>
                                </td>
                                <td class="px-3 py-2.5 font-mono text-slate-600">@(v.MoFReferenceNumber ?? "Internal Authorized")</td>
                                <td class="px-3 py-2.5 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                                        @v.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Modal for New Virement -->
    @if (showModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-lg w-full p-6 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="text-base font-bold text-slate-800">Request Budget Virement (Transfer)</h3>
                    <button type="button" @onclick="() => showModal = false" class="text-slate-400 hover:text-slate-600 text-lg font-bold">&times;</button>
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Source Budget Vote (From)</label>
                        <select @bind="fromItemId" class="w-full border border-slate-300 rounded-lg p-2 bg-white">
                            @foreach (var item in allocations)
                            {
                                <option value="@item.BudgetItemId">
                                    @item.EconomicCode - @item.DhivehiName (Avail: MVR @item.AvailableBalance.ToString("N2"))
                                </option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Target Budget Vote (To)</label>
                        <select @bind="toItemId" class="w-full border border-slate-300 rounded-lg p-2 bg-white">
                            @foreach (var item in allocations)
                            {
                                <option value="@item.BudgetItemId">
                                    @item.EconomicCode - @item.DhivehiName (Current: MVR @item.CurrentBudget.ToString("N2"))
                                </option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Transfer Amount (MVR)</label>
                        <input type="number" step="0.01" @bind="transferAmount" class="w-full border border-slate-300 rounded-lg p-2 font-mono" placeholder="0.00" />
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Statutory Justification</label>
                        <textarea @bind="justification" rows="2" class="w-full border border-slate-300 rounded-lg p-2" placeholder="Explain the operational necessity under Public Finance Regulations..."></textarea>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Legal Authority / MoF Ref #</label>
                        <input type="text" @bind="mofRef" class="w-full border border-slate-300 rounded-lg p-2" placeholder="e.g. MOF/VIR/2026/092" />
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                    <button type="button" @onclick="() => showModal = false" class="px-3.5 py-1.5 border border-slate-300 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-50">
                        Cancel
                    </button>
                    <button type="button" @onclick="SubmitVirementAsync" class="px-4 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700 shadow-xs">
                        Authorize &amp; Post Virement
                    </button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<BudgetVirementDto>? virements;
    private List<BudgetAllocationDto> allocations = new();
    private bool isLoading = true;
    private bool showModal = false;
    private string? errorMessage;
    private string? successMessage;

    private int fromItemId;
    private int toItemId;
    private decimal transferAmount = 100000;
    private string justification = "Virement to cover shift allowances and overtime requirements";
    private string mofRef = "MOF/VIR/2026/099";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            virements = await BudgetService.GetVirementsAsync(2026, 3);
            allocations = await BudgetService.GetAllocationsAsync(2026, 3);
            if (allocations.Count >= 2)
            {
                fromItemId = allocations[0].BudgetItemId;
                toItemId = allocations[1].BudgetItemId;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenNewVirementModal()
    {
        errorMessage = null;
        successMessage = null;
        showModal = true;
    }

    private async Task SubmitVirementAsync()
    {
        if (fromItemId == toItemId)
        {
            errorMessage = "Source and Target budget votes must be different.";
            return;
        }
        if (transferAmount <= 0)
        {
            errorMessage = "Transfer amount must be greater than zero.";
            return;
        }

        try
        {
            await BudgetService.RequestVirementAsync(new CreateBudgetVirementRequest
            {
                FiscalYearId = 1,
                OrganisationId = 3,
                FromBudgetItemId = fromItemId,
                ToBudgetItemId = toItemId,
                Amount = transferAmount,
                Justification = justification,
                LegalBasis = "Public Finance Act (Law 3/2006) Section 5",
                MoFReferenceNumber = mofRef
            });

            showModal = false;
            successMessage = "Budget virement authorized and ledger balances updated.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
