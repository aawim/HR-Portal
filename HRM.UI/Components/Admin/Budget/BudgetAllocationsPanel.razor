@using HRM.Application.DTOs.Budget
@using HRM.Application.Interfaces.Budget
@inject IBudgetService BudgetService

<section class="budget-allocations w-full min-w-0 p-2 space-y-4">
    <!-- Sticky Header -->
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-4 py-3 shadow-xs rounded-xl flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl shadow-xs">
                🏛️
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 leading-tight">Budget Allocation &amp; Appropriations Configurator</h1>
                <p class="text-xs text-slate-500">Authorized State Budget Line Ceilings &amp; Bandeyri Gazette Warrants</p>
            </div>
        </div>

        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition"
                @onclick="OpenAddModal">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Add Budget Allocation</span>
        </button>
    </header>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-rose-800 text-xs flex items-center justify-between">
            <span>@errorMessage</span>
            <button type="button" @onclick="() => errorMessage = null" class="text-rose-500 hover:text-rose-700 font-bold">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-xs flex items-center justify-between">
            <span>@successMessage</span>
            <button type="button" @onclick="() => successMessage = null" class="text-emerald-500 hover:text-emerald-700 font-bold">&times;</button>
        </div>
    }

    @if (isLoading)
    {
        <div class="p-8 text-center text-slate-400">Loading budget allocations...</div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
            <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-800">Organisation Budget Allocations — Fiscal Year 2026</h3>
                <span class="text-xs font-mono text-slate-500">Active Organisation: National Centre for Information Technology</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                            <th class="px-3 py-2.5">MoF Code</th>
                            <th class="px-3 py-2.5">Economic Classification</th>
                            <th class="px-3 py-2.5 text-right">Approved Amount (MVR)</th>
                            <th class="px-3 py-2.5 text-right">Revised Amount (MVR)</th>
                            <th class="px-3 py-2.5 text-right">Committed</th>
                            <th class="px-3 py-2.5 text-right">Expended</th>
                            <th class="px-3 py-2.5 text-right">Available</th>
                            <th class="px-3 py-2.5">MoF Approval Reference</th>
                            <th class="px-3 py-2.5 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var a in allocations)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-3 py-2.5 font-mono font-bold text-slate-700">@a.EconomicCode</td>
                                <td class="px-3 py-2.5">
                                    <div class="font-semibold text-slate-800">@a.DhivehiName</div>
                                    <div class="text-[10px] text-slate-400">@a.EnglishName</div>
                                </td>
                                <td class="px-3 py-2.5 text-right font-mono text-slate-800 font-semibold">@a.ApprovedAmount.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono text-blue-700 font-semibold">@a.CurrentBudget.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono text-amber-700">@a.CommittedAmount.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono text-emerald-700 font-semibold">@a.ExpendedAmount.ToString("N2")</td>
                                <td class="px-3 py-2.5 text-right font-mono font-bold @(a.AvailableBalance < 0 ? "text-rose-600" : "text-slate-800")">
                                    @a.AvailableBalance.ToString("N2")
                                </td>
                                <td class="px-3 py-2.5 font-mono text-slate-600">@(a.MoFApprovalReference ?? "MOF/2026/BUD-0042")</td>
                                <td class="px-3 py-2.5 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-100 text-blue-800">
                                        @a.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Add Budget Allocation Modal -->
    @if (showAddModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-lg w-full p-6 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="text-base font-bold text-slate-800">Add State Budget Allocation (Appropriation)</h3>
                    <button type="button" @onclick="() => showAddModal = false" class="text-slate-400 hover:text-slate-600 text-lg font-bold">&times;</button>
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Fiscal Year</label>
                        <input type="text" value="2026 (Active Fiscal Year)" disabled class="w-full border border-slate-200 bg-slate-50 rounded-lg p-2 text-slate-500 font-semibold" />
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">MoF Economic Classification Code</label>
                        <select @bind="selectedBudgetItemId" class="w-full border border-slate-300 rounded-lg p-2 bg-white">
                            @foreach (var item in availableBudgetItems)
                            {
                                <option value="@item.BudgetItemId">
                                    @item.EconomicCode - @item.DhivehiName @(!string.IsNullOrWhiteSpace(item.EnglishName) ? $"({item.EnglishName})" : "")
                                </option>
                            }
                        </select>
                        <p class="text-[11px] text-slate-400 mt-1">Classified according to Ministry of Finance Public Sector Chart of Accounts</p>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Approved Appropriation Amount (MVR)</label>
                        <input type="number" step="1000" @bind="newApprovedAmount" class="w-full border border-slate-300 rounded-lg p-2 font-mono" placeholder="0.00" />
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Ministry of Finance Bandeyri Reference</label>
                        <input type="text" @bind="newMofReference" class="w-full border border-slate-300 rounded-lg p-2 font-mono" placeholder="e.g. MOF/2026/BUD-0095" />
                        <p class="text-[11px] text-slate-400 mt-1">Official Gazette or Bandeyri Financial Warrant Number</p>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
                    <button type="button" @onclick="() => showAddModal = false" class="px-3.5 py-1.5 border border-slate-300 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-50">
                        Cancel
                    </button>
                    <button type="button" @onclick="SaveAllocationAsync" class="px-4 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700 shadow-xs" disabled="@isSubmitting">
                        @(isSubmitting ? "Saving..." : "Save & Appropriate Budget")
                    </button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<BudgetAllocationDto> allocations = new();
    private List<BudgetItemDto> availableBudgetItems = new();
    private bool isLoading = true;
    private bool showAddModal = false;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;

    private int selectedBudgetItemId;
    private decimal newApprovedAmount = 1000000;
    private string newMofReference = "MOF/2026/BUD-0095";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllocationsAsync();
    }

    private async Task LoadAllocationsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            allocations = await BudgetService.GetAllocationsAsync(2026, 3);
            availableBudgetItems = await BudgetService.GetBudgetItemsAsync();
            if (availableBudgetItems.Count > 0 && selectedBudgetItemId == 0)
            {
                selectedBudgetItemId = availableBudgetItems[0].BudgetItemId;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load allocations: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        errorMessage = null;
        successMessage = null;
        showAddModal = true;
    }

    private async Task SaveAllocationAsync()
    {
        if (selectedBudgetItemId == 0)
        {
            errorMessage = "Please select a valid MoF Economic Classification code.";
            return;
        }
        if (newApprovedAmount <= 0)
        {
            errorMessage = "Appropriation amount must be greater than zero.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        try
        {
            await BudgetService.SaveAllocationAsync(new CreateBudgetAllocationRequest
            {
                FiscalYearId = 1, // 2026
                OrganisationId = 3, // NCIT
                BudgetItemId = selectedBudgetItemId,
                ApprovedAmount = newApprovedAmount,
                MoFApprovalReference = newMofReference
            });

            showAddModal = false;
            successMessage = "Budget allocation successfully created and recorded under State Budget appropriations.";
            await LoadAllocationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Error saving allocation: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
