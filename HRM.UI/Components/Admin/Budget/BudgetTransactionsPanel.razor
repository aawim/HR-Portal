@using HRM.Application.DTOs.Budget
@using HRM.Application.Interfaces.Budget
@inject IBudgetService BudgetService

<section class="budget-transactions w-full min-w-0 p-2 space-y-4">
    <!-- Sticky Header -->
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-4 py-3 shadow-xs rounded-xl flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-xl shadow-xs">
                🧾
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 leading-tight">Financial Transactions &amp; Audit Ledger</h1>
                <p class="text-xs text-slate-500">Immutable Double-Entry Postings &amp; Bandeyri Authority References</p>
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="p-8 text-center text-slate-400">Loading transaction ledger...</div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
            <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-800">State Budget Ledger Transactions</h3>
                <span class="text-xs text-slate-400">Total: @(transactions?.Count ?? 0) Posted Entries</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                            <th class="px-3 py-2.5">Date</th>
                            <th class="px-3 py-2.5">Txn #</th>
                            <th class="px-3 py-2.5">Type</th>
                            <th class="px-3 py-2.5">MoF Code &amp; Item</th>
                            <th class="px-3 py-2.5">Transaction Details</th>
                            <th class="px-3 py-2.5 text-right">Amount (MVR)</th>
                            <th class="px-3 py-2.5">Bandeyri Authority #</th>
                            <th class="px-3 py-2.5 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var t in transactions)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-3 py-2.5 font-mono text-slate-600">@t.Date.ToString("yyyy-MM-dd")</td>
                                <td class="px-3 py-2.5 font-mono font-semibold text-blue-700">@t.ReferenceNumber</td>
                                <td class="px-3 py-2.5">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-800">
                                        @t.TransactionTypeName
                                    </span>
                                </td>
                                <td class="px-3 py-2.5">
                                    <span class="font-mono text-slate-500">[@t.EconomicCode]</span>
                                    <span class="font-medium text-slate-800">@t.ItemName</span>
                                </td>
                                <td class="px-3 py-2.5 text-slate-700">@t.Details</td>
                                <td class="px-3 py-2.5 text-right font-mono font-bold text-slate-800">MVR @t.Amount.ToString("N2")</td>
                                <td class="px-3 py-2.5 font-mono text-slate-600">@(t.BandeyriReferenceNumber ?? "BAND-SYS")</td>
                                <td class="px-3 py-2.5 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                                        @t.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@code {
    private List<BudgetTransactionDto> transactions = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            transactions = await BudgetService.GetTransactionsAsync(2026, 3);
        }
        finally
        {
            isLoading = false;
        }
    }
}
