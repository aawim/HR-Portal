@using HRM.DTOs
@using HRM.Models
@inject HRM.Application.Contracts.Pages.IOrganisationDirectoryQueries Directory

<div class="flex flex-col h-full animate-in fade-in duration-300 bg-slate-50 rounded-xl border border-slate-200 overflow-hidden relative">
    <div class="bg-white px-6 py-4 border-b border-slate-200 sticky top-0 z-20">
        <h4 class="text-lg font-bold text-slate-800">Organisation Architecture</h4>
        <p class="text-xs text-slate-500">Hierarchical structure mapped via relations.</p>
    </div>

    <div class="flex-1 overflow-auto p-8 custom-scrollbar">
        @if (isLoading)
        {
            <div class="flex flex-col items-center justify-center h-full text-slate-400 gap-3">
                <AppIcon Name="progress_activity" Class="w-8 h-8 animate-spin text-blue-500" />
                <span class="text-sm font-medium">Building architecture tree...</span>
            </div>
        }
        else if (!rootNodes.Any())
        {
            <div class="flex justify-center items-center h-full text-slate-400 text-sm">
                No structural data found.
            </div>
        }
        else
        {
            <div class="flex justify-center min-w-max pb-10">
                <div class="org-tree">
                    <ul>
                        @foreach (var root in rootNodes)
                        {
                            <OrgTreeNode Node="root" />
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int OrganisationId { get; set; }

    private List<OrgNodeDto> rootNodes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganisationTree();
    }

    private async Task LoadOrganisationTree()
    {
        isLoading = true;
        try { rootNodes = await Directory.GetApprovedStructureAsync(OrganisationId); }
        finally { isLoading = false; }
    }
}