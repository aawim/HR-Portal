<!-- PRINTABLE DOCUMENT VIEW MODAL -->
@if (showDocModal && viewingDoc is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4 backdrop-blur-xs">
        <div class="w-full max-w-3xl rounded-2xl bg-white p-5 shadow-xl flex flex-col gap-4 max-h-[90vh]">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">@viewingDoc.Title</h3>
                    <p class="text-xs text-slate-400 font-mono">Ref: @viewingDoc.DocumentNumber</p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="PrintDocument" class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700">
                        🖨 Print / Export PDF
                    </button>
                    <button type="button" @onclick="() => showDocModal = false" class="text-slate-400 hover:text-slate-600 text-sm">✕</button>
                </div>
            </div>

            <div class="overflow-y-auto p-4 border border-slate-200 rounded-xl bg-slate-50/50">
                @if (!string.IsNullOrWhiteSpace(viewingDoc.Base64Data))
                {
                    var decoded = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(viewingDoc.Base64Data));
                    <div>@((MarkupString)decoded)</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isFullWidth;
    private string selectedStatusFilter = "All";
    private string searchTerm = "";
    private string activeTab = "Overview";

    private StaffSeparationDashboardData? dashboard;
    private StaffSeparationDetailDto? activeDetail;
    private StaffSeparationFormLookupsDto? formLookups;

    // Modals & sub-forms
    private bool showInitiateModal;
    private StaffSeparationInitiateInput initiateInput = new();

    private bool showAddHandoverModal;
    private StaffSeparationHandoverItemInput handoverInput = new();
    private string supervisorReviewComment = "";

    private bool showInspectAssetModal;
    private AssetClearanceDto? inspectingAsset;
    private StaffSeparationAssetInspectionInput inspectAssetInput = new();

    private bool showAddFinanceModal;
    private StaffSeparationFinanceItemInput financeInput = new();

    private StaffSeparationFinalReviewInput finalReviewInput = new();

    private bool showDocModal;
    private SeparationDocumentDto? viewingDoc;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
        formLookups = await Separations.LoadFormLookupsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.staff-separation.full-width");
            if (bool.TryParse(saved, out var val))
            {
                isFullWidth = val;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
        await JS.InvokeVoidAsync("localStorage.setItem", "hrm.staff-separation.full-width", isFullWidth.ToString().ToLower());
    }

    private async Task LoadDashboardDataAsync()
    {
        dashboard = await Separations.LoadDashboardAsync(null, selectedStatusFilter, searchTerm);
        if (activeDetail == null && dashboard?.Separations.Any() == true)
        {
            await SelectSeparationAsync(dashboard.Separations.First().StaffSeparationId);
        }
    }

    private async Task FilterByStatusAsync(string status)
    {
        selectedStatusFilter = status;
        await LoadDashboardDataAsync();
    }

    private async Task OnSearchChangedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task SelectSeparationAsync(int id)
    {
        try
        {
            activeDetail = await Separations.LoadDetailAsync(id);
            finalReviewInput = new StaffSeparationFinalReviewInput
            {
                StaffSeparationId = activeDetail.StaffSeparationId,
                ExitInterviewCompleted = activeDetail.ExitInterviewCompleted,
                ExitInterviewDate = activeDetail.ExitInterviewDate,
                ExitInterviewNotes = activeDetail.ExitInterviewNotes,
                HrReviewRemarks = activeDetail.HrReviewRemarks
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load separation detail {Id}", id);
            Toasts.Error("Failed to load separation details.");
        }
    }

    private void OpenNewSeparationModal()
    {
        initiateInput = new StaffSeparationInitiateInput
        {
            RequestedNoticeDate = DateTime.Today,
            LastWorkingDate = DateTime.Today.AddDays(30),
            EffectiveSeparationDate = DateTime.Today.AddDays(30)
        };
        showInitiateModal = true;
    }

    private async Task SubmitInitiateSeparationAsync()
    {
        if (initiateInput.IndividualId <= 0 || initiateInput.SeparationTypeId <= 0)
        {
            Toasts.Error("Please select both an employee and a separation category.");
            return;
        }

        var result = await Separations.InitiateSeparationAsync(initiateInput);
        if (result.Success)
        {
            Toasts.Success(result.Message);
            showInitiateModal = false;
            await LoadDashboardDataAsync();
        }
        else
        {
            Toasts.Error(result.Message);
        }
    }

    private void OpenAddHandoverItemModal()
    {
        if (activeDetail == null) return;
        handoverInput = new StaffSeparationHandoverItemInput
        {
            StaffSeparationId = activeDetail.StaffSeparationId,
            TargetCompletionDate = activeDetail.LastWorkingDate
        };
        showAddHandoverModal = true;
    }

    private async Task SubmitSaveHandoverItemAsync()
    {
        if (string.IsNullOrWhiteSpace(handoverInput.ItemTitle) || handoverInput.RecipientIndividualId <= 0)
        {
            Toasts.Error("Please provide an item title and select a recipient colleague.");
            return;
        }

        var res = await Separations.SaveHandoverItemAsync(handoverInput);
        if (res.Success)
        {
            Toasts.Success(res.Message);
            showAddHandoverModal = false;
            await RefreshActiveDetailAsync();
        }
        else Toasts.Error(res.Message);
    }

    private async Task VerifyHandoverItemAsync(int itemId)
    {
        var existing = activeDetail?.WorkHandover?.Items.FirstOrDefault(i => i.WorkHandoverItemId == itemId);
        var input = new StaffSeparationHandoverItemInput
        {
            WorkHandoverItemId = itemId,
            StaffSeparationId = activeDetail!.StaffSeparationId,
            ItemType = existing?.ItemType ?? "ProjectAssignment",
            ItemTitle = existing?.ItemTitle ?? "",
            RecipientIndividualId = existing?.RecipientIndividualId ?? 0,
            TargetCompletionDate = existing?.TargetCompletionDate ?? DateTime.UtcNow.Date,
            Status = StaffSeparationWorkHandoverItemStatuses.Verified
        };
        var res = await Separations.SaveHandoverItemAsync(input);
        if (res.Success)
        {
            Toasts.Success("Handover item verified.");
            await RefreshActiveDetailAsync();
        }
        else
        {
            Toasts.Error(res.Message);
        }
    }

    private async Task DeleteHandoverItemAsync(int itemId)
    {
        var res = await Separations.DeleteHandoverItemAsync(itemId);
        if (res.Success) await RefreshActiveDetailAsync();
    }

    private async Task SubmitSupervisorReviewAsync(string decision)
    {
        if (activeDetail == null) return;
        var res = await Separations.ReviewHandoverAsync(new StaffSeparationHandoverReviewInput
        {
            StaffSeparationId = activeDetail.StaffSeparationId,
            IsSupervisor = true,
            Decision = decision,
            Comments = supervisorReviewComment
        });
        if (res.Success)
        {
            Toasts.Success(res.Message);
            await RefreshActiveDetailAsync();
        }
        else Toasts.Error(res.Message);
    }

    private void OpenInspectAssetModal(AssetClearanceDto asset)
    {
        inspectingAsset = asset;
        inspectAssetInput = new StaffSeparationAssetInspectionInput
        {
            SeparationAssetClearanceId = asset.SeparationAssetClearanceId,
            DisposalAction = asset.DisposalAction,
            AssessedDamageCost = asset.AssessedDamageCost,
            DeductionFromFinalSettlement = asset.DeductionFromFinalSettlement,
            Status = "Cleared",
            Remarks = asset.Remarks
        };
        showInspectAssetModal = true;
    }

    private async Task SubmitAssetInspectionAsync()
    {
        var res = await Separations.InspectAssetClearanceAsync(inspectAssetInput);
        if (res.Success)
        {
            Toasts.Success(res.Message);
            showInspectAssetModal = false;
            await RefreshActiveDetailAsync();
        }
        else Toasts.Error(res.Message);
    }

    private void OpenAddFinanceItemModal()
    {
        if (activeDetail == null) return;
        financeInput = new StaffSeparationFinanceItemInput
        {
            StaffSeparationId = activeDetail.StaffSeparationId,
            IsCredit = true,
            Amount = 0
        };
        showAddFinanceModal = true;
    }

    private async Task SubmitFinanceItemAsync()
    {
        if (string.IsNullOrWhiteSpace(financeInput.Description) || financeInput.Amount <= 0)
        {
            Toasts.Error("Please provide a description and positive amount.");
            return;
        }

        var res = await Separations.SaveFinanceItemAsync(financeInput);
        if (res.Success)
        {
            Toasts.Success(res.Message);
            showAddFinanceModal = false;
            await RefreshActiveDetailAsync();
        }
        else Toasts.Error(res.Message);
    }

    private async Task DeleteFinanceItemAsync(int finId)
    {
        var res = await Separations.DeleteFinanceItemAsync(finId);
        if (res.Success) await RefreshActiveDetailAsync();
    }

    private async Task ProcessRevocationAsync(int revId, string status)
    {
        var res = await Separations.ProcessAccessRevocationAsync(new StaffSeparationAccessRevocationActionInput
        {
            SeparationAccessRevocationId = revId,
            Status = status
        });
        if (res.Success) await RefreshActiveDetailAsync();
    }

    private async Task ClearTaskAsync(int taskId, string status)
    {
        var res = await Separations.ProcessClearanceTaskAsync(new StaffSeparationClearanceTaskActionInput
        {
            ClearanceTaskId = taskId,
            Status = status
        });
        if (res.Success) await RefreshActiveDetailAsync();
    }

    private async Task ExecuteFinalApprovalAsync(bool executeNow)
    {
        if (activeDetail == null) return;
        finalReviewInput.ExecuteTerminationNow = executeNow;

        var res = await Separations.FinalReviewAndExecuteAsync(finalReviewInput);
        if (res.Success)
        {
            Toasts.Success(res.Message);
            await LoadDashboardDataAsync();
            await SelectSeparationAsync(activeDetail.StaffSeparationId);
        }
        else Toasts.Error(res.Message);
    }

    private async Task GenerateDocAsync(string variant)
    {
        if (activeDetail == null) return;
        try
        {
            var doc = await Separations.GenerateDocumentAsync(activeDetail.StaffSeparationId, variant);
            OpenDocumentModal(doc);
            await RefreshActiveDetailAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate document {Variant}", variant);
            Toasts.Error("Failed to generate document.");
        }
    }

    private void OpenDocumentModal(SeparationDocumentDto doc)
    {
        viewingDoc = doc;
        showDocModal = true;
    }

    private async Task PrintDocument()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task RefreshActiveDetailAsync()
    {
        if (activeDetail != null)
        {
            await SelectSeparationAsync(activeDetail.StaffSeparationId);
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        StaffSeparationStatuses.Terminated => "bg-emerald-100 text-emerald-800",
        StaffSeparationStatuses.Approved => "bg-blue-100 text-blue-800",
        StaffSeparationStatuses.ClearanceInProgress => "bg-blue-50 text-blue-700",
        StaffSeparationStatuses.HandoverInProgress or StaffSeparationStatuses.Submitted => "bg-amber-100 text-amber-800",
        StaffSeparationStatuses.Cancelled or StaffSeparationStatuses.Rejected => "bg-rose-100 text-rose-800",
        _ => "bg-slate-100 text-slate-700"
    };
}
