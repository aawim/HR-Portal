@using HRM.Application.Contracts.Recruitment
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api

<section class="w-full min-w-0">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
                <h2 class="text-sm font-bold text-slate-900">Official Recruitment Templates</h2>
                <p class="text-xs text-slate-500">List and register CSC official templates linked to a recruitment policy version.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <label class="flex items-center gap-1.5 text-xs font-medium text-slate-700">
                    Policy Version ID
                    <input type="number" min="1" class="w-24 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="policyVersionId" />
                </label>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50" disabled="@(busy || policyVersionId <= 0)" @onclick="LoadAsync">Load Templates</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div role="status" class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-xs text-slate-800">@message</div>
        }

        <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full text-left text-xs">
                <thead class="border-b border-slate-200 bg-slate-50 font-semibold text-slate-700">
                    <tr>
                        <th class="p-2.5">Code</th>
                        <th class="p-2.5">Name</th>
                        <th class="p-2.5">Position Category</th>
                        <th class="p-2.5">Verification</th>
                        <th class="p-2.5">Active</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (templates.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="p-3 text-slate-500">No official templates loaded for this policy version.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in templates)
                        {
                            <tr class="hover:bg-slate-50/50">
                                <td class="p-2.5 font-mono text-[11px] text-blue-700">@row.TemplateCode</td>
                                <td class="p-2.5">@row.Name</td>
                                <td class="p-2.5">@row.PositionCategory</td>
                                <td class="p-2.5">
                                    <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-semibold text-amber-800">@row.VerificationStatus</span>
                                </td>
                                <td class="p-2.5">@(row.IsActive ? "Active" : "Inactive")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <details class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
            <summary class="cursor-pointer text-xs font-semibold text-slate-800">Register official template</summary>
            <div class="mt-3 grid gap-2 md:grid-cols-3">
                <label class="block text-xs text-slate-700">
                    Source Document ID
                    <input type="number" min="1" class="@InputClass" @bind="sourceDocumentId" />
                </label>
                <label class="block text-xs text-slate-700">
                    Template Code
                    <input class="@InputClass" maxlength="100" @bind="templateCode" />
                </label>
                <label class="block text-xs text-slate-700">
                    Name
                    <input class="@InputClass" maxlength="200" @bind="name" />
                </label>
                <label class="block text-xs text-slate-700">
                    Source URL
                    <input class="@InputClass" maxlength="500" @bind="sourceUrl" />
                </label>
                <label class="block text-xs text-slate-700">
                    Position Category
                    <input class="@InputClass" maxlength="150" @bind="positionCategory" />
                </label>
                <div class="grid grid-cols-2 gap-2">
                    <label class="block text-xs text-slate-700">
                        Language
                        <input class="@InputClass" maxlength="10" @bind="language" />
                    </label>
                    <label class="block text-xs text-slate-700">
                        Direction
                        <select class="@InputClass" @bind="direction">
                            <option value="rtl">rtl</option>
                            <option value="ltr">ltr</option>
                        </select>
                    </label>
                </div>
                <label class="block text-xs text-slate-700 md:col-span-3">
                    Template Definition JSON
                    <textarea rows="3" class="@InputClass font-mono" @bind="templateDefinitionJson"></textarea>
                </label>
            </div>
            <div class="mt-3 flex justify-end">
                <button class="app-button app-button-primary app-button-sm"
                        disabled="@(busy || policyVersionId <= 0 || sourceDocumentId <= 0 || string.IsNullOrWhiteSpace(templateCode) || string.IsNullOrWhiteSpace(name))"
                        @onclick="RegisterAsync">
                    Register template
                </button>
            </div>
        </details>
    </div>
</section>

@code {
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500";
    private IReadOnlyList<RecruitmentOfficialTemplateRow> templates = [];
    private int policyVersionId = 1;
    private long sourceDocumentId;
    private string templateCode = "";
    private string name = "";
    private string sourceUrl = "";
    private string positionCategory = "";
    private string templateDefinitionJson = "{}";
    private string language = "dv";
    private string direction = "rtl";
    private bool busy;
    private string? message;

    private async Task LoadAsync()
    {
        if (busy || policyVersionId <= 0) return;
        busy = true;
        message = null;
        try
        {
            templates = await Api.GetOfficialTemplatesAsync(policyVersionId);
        }
        catch (HttpRequestException)
        {
            message = "Official templates could not be loaded. Check your recruitment permissions and policy version ID.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            var input = new RegisterRecruitmentOfficialTemplateInput(
                policyVersionId,
                sourceDocumentId,
                templateCode.Trim(),
                name.Trim(),
                sourceUrl.Trim(),
                positionCategory.Trim(),
                templateDefinitionJson,
                language,
                direction);
            var result = await Api.RegisterOfficialTemplateAsync(input);
            message = result.Message;
            if (result.Success)
            {
                templateCode = "";
                name = "";
                sourceUrl = "";
                positionCategory = "";
                templateDefinitionJson = "{}";
                templates = await Api.GetOfficialTemplatesAsync(policyVersionId);
            }
        }
        catch (HttpRequestException)
        {
            message = "Official template could not be registered. Check the input values and permissions.";
        }
        finally
        {
            busy = false;
        }
    }
}
