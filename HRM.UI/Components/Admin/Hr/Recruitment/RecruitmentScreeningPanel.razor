@using HRM.Application.Contracts.Recruitment
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api

<div class="grid items-start gap-4 lg:grid-cols-12">
    <section class="lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-4">
        <div>
            <h2 class="text-sm font-bold text-slate-900">Screening &amp; Shortlisting</h2>
            <p class="mt-0.5 text-xs text-slate-500">Select a vacancy, review submitted applications, and lock screening decisions.</p>
        </div>

        <label class="block text-xs font-medium text-slate-700">
            Vacancy
            <select class="@InputClass" @bind="vacancyId" @bind:after="Load">
                <option value="0">-- Select vacancy --</option>
                @foreach (var v in vacancies)
                {
                    <option value="@v.Id">@v.Reference · @v.Status</option>
                }
            </select>
        </label>

        @if (vacancyId > 0)
        {
            <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-xs">
                    <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-semibold uppercase tracking-wide text-slate-600">
                        <tr>
                            <th class="p-2.5">Reference</th>
                            <th class="p-2.5">Applicant</th>
                            <th class="p-2.5">Status</th>
                            <th class="p-2.5 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (applications.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="p-6 text-center text-slate-500">No applications found for this vacancy.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in applications)
                            {
                                <tr class="hover:bg-slate-50/70 @(selected?.Id == row.Id ? "bg-blue-50/50" : "")">
                                    <td class="p-2.5 font-mono text-[11px] font-semibold text-blue-700">@row.Reference</td>
                                    <td class="p-2.5 font-medium text-slate-800">@row.ApplicantName</td>
                                    <td class="p-2.5">
                                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-700">@row.Status</span>
                                    </td>
                                    <td class="p-2.5 text-right">
                                        <button type="button"
                                                class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50"
                                                disabled="@busy"
                                                @onclick="() => Select(row)">
                                            Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (selected is not null)
        {
            <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-900">Screening Decision: @selected.ApplicantName (@selected.Reference)</h3>
                    <button type="button" class="text-xs font-semibold text-slate-500 hover:text-slate-800" @onclick="() => selected = null">Close</button>
                </div>

                <div class="flex flex-wrap gap-4">
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700">
                        <input type="checkbox" @bind="eligible" />
                        Meets advertised eligibility requirements
                    </label>
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700">
                        <input type="checkbox" disabled="@(!eligible)" @bind="shortlisted" />
                        Shortlist for assessment
                    </label>
                </div>

                <label class="block text-xs font-medium text-slate-700">
                    Decision Reason
                    <textarea rows="2" class="@InputClass" maxlength="2000" @bind="reason"></textarea>
                </label>
                <label class="block text-xs font-medium text-slate-700">
                    Evidence Reviewed
                    <textarea rows="3" class="@InputClass" maxlength="8000" @bind="evidence"></textarea>
                </label>

                <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[11px] text-slate-500">Submitting locks this decision. Verify evidence and eligibility before continuing.</p>
                    <button type="button"
                            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors"
                            disabled="@(busy || selected.Status != "Submitted" || string.IsNullOrWhiteSpace(reason) || string.IsNullOrWhiteSpace(evidence))"
                            @onclick="Save">
                        Submit &amp; Lock Screening
                    </button>
                </div>
            </div>
        }

        @if (message is not null)
        {
            <div role="status" class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800">
                <span>@message</span>
                <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
            </div>
        }
    </section>

    <aside class="lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
        <div>
            <h3 class="text-sm font-bold text-slate-900">Conflict of Interest Declaration</h3>
            <p class="mt-0.5 text-xs text-slate-500">Record your conflict declaration for the selected vacancy before scoring.</p>
        </div>

        <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700">
            <input type="checkbox" @bind="conflict" />
            I have a conflict of interest relating to this vacancy
        </label>

        <label class="block text-xs font-medium text-slate-700">
            Declaration Statement
            <textarea rows="4" class="@InputClass" maxlength="2000" @bind="declaration" placeholder="State either no conflict or describe any relationship/conflict..."></textarea>
        </label>

        <div class="flex justify-end">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                    disabled="@(busy || vacancyId <= 0 || string.IsNullOrWhiteSpace(declaration))"
                    @onclick="Declare">
                Record Declaration
            </button>
        </div>
    </aside>
</div>

@code {
    private IReadOnlyList<RecruitmentVacancyRow> vacancies = [];
    private IReadOnlyList<RecruitmentScreeningApplicationRow> applications = [];
    private RecruitmentScreeningApplicationRow? selected;
    private int vacancyId;
    private bool busy, eligible, shortlisted, conflict;
    private string reason = "", evidence = "", declaration = "";
    private string? message;
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500";

    protected override async Task OnInitializedAsync()
    {
        try { vacancies = await Api.GetVacanciesAsync(); }
        catch (HttpRequestException) { message = "Vacancies could not be loaded."; }
    }

    private async Task Load()
    {
        selected = null;
        applications = [];
        try
        {
            if (vacancyId > 0) applications = await Api.GetScreeningApplicationsAsync(vacancyId);
        }
        catch (HttpRequestException)
        {
            message = "Applications could not be loaded. Check your recruitment access.";
        }
    }

    private void Select(RecruitmentScreeningApplicationRow row)
    {
        selected = row;
        eligible = false;
        shortlisted = false;
        reason = "";
        evidence = "";
    }

    private Task Save() => Run(() => Api.RecordScreeningAsync(new(selected!.Id, eligible, eligible && shortlisted, reason, System.Text.Json.JsonSerializer.Serialize(new { EvidenceReviewed = evidence }))));
    private Task Declare() => Run(() => Api.DeclareConflictAsync(new(vacancyId, conflict, declaration, null)));

    private async Task Run(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await action();
            message = result.Message;
            if (result.Success) await Load();
        }
        catch (HttpRequestException)
        {
            message = "The action failed. Refresh and verify the application state and access.";
        }
        finally
        {
            busy = false;
        }
    }
}
