@page "/admin/hr/recruitment"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode RenderMode.InteractiveServer
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient RecruitmentApi
@inject ILogger<RecruitmentWorkspacePage> Logger
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Recruitment Workspace - HR Portal</PageTitle>

<section class="org-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 text-slate-900 transition-all duration-300">
    <!-- Top Header Area Matching Admin Workspace Standard -->
    <div class="org-workspace-header flex flex-col gap-2 p-2">
        <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-900">Recruitment Workspace</h1>
                    <span class="rounded-full bg-teal-100 px-2.5 py-0.5 text-xs font-semibold text-teal-800">CSC Recruitment</span>
                    <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">@(canManage ? "Manage Access" : "View Access")</span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">Manage requisitions, published vacancies, screening, panel assessments, merit results, offers, and official templates.</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
                        @onclick="ToggleWidthAsync">
                    <span>@(isFullWidth ? "Shrink View" : "Full Width")</span>
                </button>

                @if (canAdministerAccess)
                {
                    <a class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
                       href="/admin/settings/user/admin-portal-access">
                        <span>Manage Access</span>
                    </a>
                }

                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 px-3 py-1.5 text-xs font-semibold text-white shadow-xs transition"
                        @onclick="LoadAsync">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>
    </div>

    @if (accessDenied)
    {
        <div role="alert" class="rounded-lg border border-amber-200 bg-amber-50 p-2 text-xs text-amber-900">
            Ask your account administrator to assign <strong>Recruitment.View</strong> for this organisation. <strong>Recruitment.Manage</strong> is required for recruitment processing. After approval, sign out and sign in again, then refresh this page.
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div role="alert" class="flex items-center justify-between gap-2 rounded-lg border border-rose-200 bg-rose-50 p-2 text-xs text-rose-800">
            <span>@error</span>
            <button type="button" class="font-bold text-rose-600 hover:text-rose-900" @onclick="() => error = null">✕</button>
        </div>
    }

    <!-- KPI Summary Strip -->
    <div class="w-full grid grid-cols-1 gap-2 sm:grid-cols-3 @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl")">
        <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Total Requisitions</span>
            <span class="text-lg font-bold text-slate-900">@rows.Count</span>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Draft Requisitions</span>
            <span class="text-lg font-bold text-amber-600">@rows.Count(r => r.Status == "Draft")</span>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex items-center justify-between gap-2">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Approved Requisitions</span>
            <span class="text-lg font-bold text-emerald-600">@rows.Count(r => r.Status == "Approved")</span>
        </div>
    </div>

    <!-- Solid Folder Navigation Tabs Matching Admin Workspace -->
    @if (!accessDenied)
    {
        <div class="w-full @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl") flex flex-col">
            <div class="org-workspace-tabs my-workspace-tabs w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
                <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Recruitment Workspace Sections">
                    @foreach (var tab in Tabs)
                    {
                        if (tab.RequiresManage && !canManage) continue;
                        var isActive = activeTab == tab.Key;
                        <button type="button"
                                aria-current="@(isActive ? "page" : null)"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r flex items-center gap-2 @(isActive ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="() => activeTab = tab.Key">
                            <i class="bi @tab.Icon text-sm" aria-hidden="true"></i>
                            <span>@tab.Label</span>
                        </button>
                    }
                </nav>
            </div>

            <!-- Dynamic Content Panel -->
            <div class="w-full min-w-0 bg-white rounded-b-2xl rounded-tr-2xl border border-slate-200 p-2 shadow-xs flex flex-col gap-2">
                @if (activeTab == "requisitions")
                {
                    <div class="grid items-start gap-2 lg:grid-cols-12">
                        @if (canManage)
                        {
                            <div class="min-w-0 lg:col-span-5">
                                <RecruitmentRequisitionActions Rows="rows" Changed="LoadAsync" />
                            </div>
                        }
                        <div class="min-w-0 @(canManage ? "lg:col-span-7" : "lg:col-span-12") rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex flex-col gap-2">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2">
                                <div>
                                    <h2 class="text-xs font-bold text-slate-900 flex items-center gap-2">
                                        <span>Requisitions Register</span>
                                        <span class="rounded-full bg-teal-50 border border-teal-200 px-2 py-0.5 text-[10px] font-semibold text-teal-700">@rows.Count records</span>
                                    </h2>
                                    <p class="text-[11px] text-slate-500 mt-0.5">All recruitment requisitions for your current organisation.</p>
                                </div>
                            </div>
                            <div class="overflow-x-auto rounded-xl border border-slate-200">
                                <table class="w-full text-left text-xs">
                                    <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-semibold uppercase tracking-wide text-slate-600">
                                        <tr>
                                            <th class="p-2">Reference</th>
                                            <th class="p-2">Policy Version</th>
                                            <th class="p-2">Slots</th>
                                            <th class="p-2">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        @if (rows.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="4" class="p-4 text-center text-slate-500">No requisitions recorded yet.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in rows)
                                            {
                                                <tr class="hover:bg-slate-50/70 transition-colors">
                                                    <td class="p-2 font-mono text-[11px] font-semibold text-teal-700">@row.Reference</td>
                                                    <td class="p-2 text-slate-700">@row.PolicyVersion</td>
                                                    <td class="p-2 font-semibold text-slate-800">@row.RequestedSlots</td>
                                                    <td class="p-2">
                                                        <span class="@StatusBadge(row.Status)">@row.Status</span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (activeTab == "vacancies" && canManage)
                {
                    <RecruitmentVacancyActions Rows="rows" />
                }
                else if (activeTab == "screening" && canManage)
                {
                    <RecruitmentScreeningPanel />
                }
                else if (activeTab == "assessments" && canManage)
                {
                    <RecruitmentAssessmentPanel />
                }
                else if (activeTab == "results" && canManage)
                {
                    <RecruitmentResultsPanel />
                }
                else if (activeTab == "offers" && canManage)
                {
                    <RecruitmentOffersPanel />
                }
                else if (activeTab == "templates" && canManage)
                {
                    <RecruitmentOfficialTemplatesPanel />
                }
            </div>
        </div>
    }
</section>

@code {
    private sealed record TabItem(string Key, string Label, string Icon, bool RequiresManage);
    private static readonly TabItem[] Tabs =
    [
        new("requisitions", "Requisitions", "bi-file-earmark-text", false),
        new("vacancies", "Vacancies", "bi-megaphone", true),
        new("screening", "Screening", "bi-funnel", true),
        new("assessments", "Assessments", "bi-clipboard-check", true),
        new("results", "Results & Objections", "bi-trophy", true),
        new("offers", "Offers & Onboarding", "bi-envelope-check", true),
        new("templates", "Official Templates", "bi-file-earmark-ruled", true)
    ];

    private List<HRM.Application.Contracts.Recruitment.RecruitmentRequisitionRow> rows = [];
    private string activeTab = "requisitions";
    private string? error;
    private bool accessDenied;
    private bool canAdministerAccess;
    private bool canManage;
    private bool isFullWidth;

    protected override async Task OnInitializedAsync()
    {
        canAdministerAccess = await Access.HasPermissionAsync("Users.Roles.Edit") || await Access.HasPermissionAsync("Admin");
        canManage = await Access.HasPermissionAsync("Recruitment.Manage");
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isFullWidth = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.recruitment.full-width") == "true";
            StateHasChanged();
        }
    }

    private async Task ToggleWidthAsync()
    {
        isFullWidth = !isFullWidth;
        await JS.InvokeVoidAsync("localStorage.setItem", "hrm.recruitment.full-width", isFullWidth ? "true" : "false");
    }

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            accessDenied = false;
            rows = (await RecruitmentApi.GetRequisitionsAsync()).ToList();
        }
        catch (UnauthorizedAccessException ex)
        {
            accessDenied = true;
            rows.Clear();
            error = ex.Message;
            Logger.LogWarning(ex, "Recruitment workspace access failed");
        }
        catch (HttpRequestException ex)
        {
            error = ex.StatusCode.HasValue
                ? $"Recruitment API returned HTTP {(int)ex.StatusCode.Value}. Contact your administrator."
                : "The recruitment API could not be reached. Try again shortly.";
            Logger.LogError(ex, "Recruitment workspace request failed");
        }
        catch (Exception ex)
        {
            error = "Recruitment data could not be loaded. Contact your administrator.";
            Logger.LogError(ex, "Recruitment workspace load failed");
        }
    }

    private static string StatusBadge(string status) => status switch
    {
        "Approved" or "Published" or "Active" => "rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-800",
        "Draft" or "Pending" => "rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-semibold text-amber-800",
        "Rejected" or "Cancelled" => "rounded-full bg-rose-100 px-2.5 py-0.5 text-[11px] font-semibold text-rose-800",
        _ => "rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-700"
    };
}
