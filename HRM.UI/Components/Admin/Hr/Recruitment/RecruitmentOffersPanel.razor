@using System.Text.Json
@using HRM.Application.Contracts.Recruitment
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api

<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
            <h2 class="text-sm font-bold text-slate-900">Offers &amp; Onboarding</h2>
            <p class="mt-0.5 text-xs text-slate-500">Issue job offers to finalised merit candidates and hand off accepted offers into the staff onboarding workflow.</p>
        </div>
    </div>

    <label class="block text-xs font-medium text-slate-700 max-w-lg">
        Vacancy
        <select class="@InputClass" @bind="vacancy" @bind:after="Load">
            <option value="0">-- Select vacancy --</option>
            @foreach (var v in vacancies)
            {
                <option value="@v.Id">@(string.IsNullOrWhiteSpace(v.PositionName) ? v.Reference : $"{v.PositionName} — {v.Reference}") · @v.Status</option>
            }
        </select>
    </label>

    @if (SelectedVacancy is not null && workspace is not null)
    {
        var activeCount = workspace.Offers.Count(o => o.Status != "Declined");
        var remainingSlots = Math.Max(0, workspace.VacancySlots - activeCount);
        <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-blue-100 bg-blue-50/50 px-3.5 py-2.5 text-xs">
            <div class="flex flex-wrap items-center gap-2">
                <i class="bi bi-briefcase text-blue-600" aria-hidden="true"></i>
                <span class="font-bold text-slate-900">@(workspace.Context?.PositionName ?? SelectedVacancy.PositionName)</span>
                <span class="font-mono text-[11px] text-blue-700">@SelectedVacancy.Reference</span>
                @if (!string.IsNullOrWhiteSpace(workspace.Context?.EmploymentType))
                {
                    <span class="rounded-full bg-white border border-slate-200 px-2 py-0.5 text-[10px] font-semibold text-slate-700">@workspace.Context.EmploymentType</span>
                }
                @if (workspace.Context?.BasicSalary is > 0)
                {
                    <span class="rounded-full bg-white border border-slate-200 px-2 py-0.5 text-[10px] font-semibold text-slate-700">MVR @workspace.Context.BasicSalary.Value.ToString("N2")</span>
                }
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
                <span class="rounded-full bg-white border border-slate-200 px-2.5 py-0.5 text-[10px] font-semibold text-slate-700">
                    Slots: @activeCount / @workspace.VacancySlots filled (@remainingSlots open)
                </span>
                <span class="rounded-full px-2.5 py-0.5 text-[10px] font-semibold @(workspace.IsResultFinal ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                    @(workspace.IsResultFinal ? "Final Results Locked" : "Results Not Finalised")
                </span>
            </div>
        </div>
    }

    @if (workspace is not null)
    {
        <div class="grid items-start gap-4 lg:grid-cols-12">
            <!-- Left: Issue Offer -->
            <div class="lg:col-span-5 rounded-xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
                <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">Issue Job Offer</h3>

                @if (!workspace.IsResultFinal)
                {
                    <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">
                        Merit results must be published and <strong>finalised</strong> (under the <strong>Results &amp; Objections</strong> tab) before offers can be issued.
                    </div>
                }
                else if (workspace.Candidates.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-4 text-xs text-slate-500">
                        All available vacancy slots have active/accepted offers, or no unoffered merit candidates remain.
                    </div>
                }
                else
                {
                    <label class="block text-xs font-medium text-slate-700">
                        Selected Candidate <span class="text-rose-600">*</span>
                        <select class="@InputClass" @bind="candidate">
                            <option value="0">-- Select candidate from final results --</option>
                            @foreach (var c in workspace.Candidates)
                            {
                                <option value="@c.MeritResultId">Rank #@c.Rank · @c.ApplicantName (@c.ApplicationReference · @c.Score.ToString("0.##") pts)</option>
                            }
                        </select>
                    </label>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <label class="block text-xs font-medium text-slate-700">
                            Proposed Start Date
                            <input type="date" class="@InputClass" @bind="proposedStartDate" />
                        </label>
                        <label class="block text-xs font-medium text-slate-700">
                            Probation Period
                            <input class="@InputClass" maxlength="100" @bind="probationPeriod" @bind:event="oninput" placeholder="e.g. 3 months" />
                        </label>
                    </div>

                    <label class="block text-xs font-medium text-slate-700">
                        Offer Terms &amp; Conditions <span class="text-rose-600">*</span>
                        <textarea rows="4" class="@InputClass" maxlength="8000" @bind="terms" @bind:event="oninput" placeholder="Specify grade, remuneration, allowances, probation terms, and reporting details..."></textarea>
                    </label>

                    <div class="flex justify-end">
                        <button type="button"
                                class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors"
                                disabled="@(busy || candidate <= 0 || string.IsNullOrWhiteSpace(terms))"
                                @onclick="Issue">
                            <i class="bi bi-send-check" aria-hidden="true"></i>
                            <span>Issue Offer</span>
                        </button>
                    </div>
                }
            </div>

            <!-- Right: Issued Offers & Onboarding Handoff -->
            <div class="lg:col-span-7 space-y-3">
                <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">Issued Offers (@workspace.Offers.Count)</h3>
                @if (workspace.Offers.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-xs text-slate-500">
                        No offers issued for this vacancy yet.
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var o in workspace.Offers)
                        {
                            var isExpanded = expandedOfferId == o.Id;
                            <div class="rounded-xl border border-slate-200 bg-white p-3 text-xs space-y-2">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div class="space-y-0.5">
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <span class="font-semibold text-slate-900">@o.ApplicantName</span>
                                            <span class="text-slate-300">•</span>
                                            <span class="font-mono text-[11px] text-blue-700">@o.ApplicationReference</span>
                                            <span class="rounded-full px-2.5 py-0.5 text-[10px] font-semibold @OfferStatusBadge(o.Status)">@FormatOfferStatus(o.Status)</span>
                                        </div>
                                        <div class="text-[11px] text-slate-500 flex flex-wrap gap-x-3">
                                            @if (!string.IsNullOrWhiteSpace(o.EfaasIdNumber))
                                            {
                                                <span>eFaas: <strong class="font-mono text-slate-700">@o.EfaasIdNumber</strong></span>
                                            }
                                            @if (o.OfferedAtUtc.HasValue)
                                            {
                                                <span>Offered: @o.OfferedAtUtc.Value.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT</span>
                                            }
                                            @if (o.AcceptedAtUtc.HasValue)
                                            {
                                                <span class="text-emerald-700 font-medium">Accepted: @o.AcceptedAtUtc.Value.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-1.5">
                                        <button type="button"
                                                class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50"
                                                @onclick="() => expandedOfferId = isExpanded ? null : o.Id">
                                            @(isExpanded ? "Hide Terms" : "View Terms")
                                        </button>
                                        @if (o.OnboardingRequestId.HasValue)
                                        {
                                            <a class="inline-flex items-center gap-1 rounded-lg border border-blue-300 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-800 hover:bg-blue-100"
                                               href="@($"/admin/my/workspace/onboarding?requestId={o.OnboardingRequestId}")">
                                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                                <span>Onboarding #@o.OnboardingRequestId</span>
                                            </a>
                                        }
                                        @if (o.Status == "Accepted" && !o.OnboardingRequestId.HasValue)
                                        {
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-semibold text-white hover:bg-emerald-700"
                                                    @onclick="() => OpenOnboardingForm(o)">
                                                <i class="bi bi-person-check" aria-hidden="true"></i>
                                                <span>Prepare Onboarding</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (isExpanded && !string.IsNullOrWhiteSpace(o.TermsSnapshotJson))
                                {
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5 text-[11px] text-slate-700 whitespace-pre-wrap">
                                        @FormatOfferTerms(o.TermsSnapshotJson)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Smart Onboarding Handoff Panel -->
                @if (selectedOffer is not null && workspace.Context is not null)
                {
                    var selectedPos = workspace.Context.VacantPositions.FirstOrDefault(p => p.Id == positionId);
                    var requiresStep = selectedPos is not null && selectedPos.PaySteps.Count > 0;

                    <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-4 space-y-3">
                        <div class="flex items-center justify-between gap-2 border-b border-blue-200/70 pb-2">
                            <div>
                                <h4 class="text-xs font-bold text-slate-900">Initiate Staff Onboarding: @selectedOffer.ApplicantName</h4>
                                <p class="text-[11px] text-slate-600">Offer #@selectedOffer.Id · @selectedOffer.ApplicationReference</p>
                            </div>
                            <button type="button" class="text-xs font-semibold text-slate-500 hover:text-slate-800" @onclick="() => selectedOffer = null">Cancel</button>
                        </div>

                        <!-- Auto-matched Individual Identity -->
                        @if (selectedOffer.MatchedIndividualId is > 0)
                        {
                            <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-900">
                                <i class="bi bi-patch-check-fill text-emerald-600" aria-hidden="true"></i>
                                <span>Identity verified: <strong>@selectedOffer.ApplicantName</strong> (eFaas <span class="font-mono">@selectedOffer.EfaasIdNumber</span> · Individual #@selectedOffer.MatchedIndividualId)</span>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-950">
                                <i class="bi bi-exclamation-triangle-fill text-amber-600 mr-1" aria-hidden="true"></i>
                                <strong>No Individual registry record matched</strong> for eFaas ID <span class="font-mono">@(selectedOffer.EfaasIdNumber ?? "—")</span>. Ensure the applicant is registered in the Individual Registry before submitting onboarding.
                            </div>
                        }

                        <div class="grid gap-3 sm:grid-cols-2">
                            <label class="block text-xs font-medium text-slate-700">
                                Department / Unit <span class="text-rose-600">*</span>
                                <select class="@InputClass" @bind="structureId">
                                    <option value="0">-- Select approved unit --</option>
                                    @foreach (var s in workspace.Context.Structures)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                            </label>

                            <label class="block text-xs font-medium text-slate-700">
                                Job Type <span class="text-rose-600">*</span>
                                <select class="@InputClass" @bind="jobTypeId">
                                    <option value="0">-- Select job type --</option>
                                    @foreach (var jt in workspace.Context.JobTypes)
                                    {
                                        <option value="@jt.Id">@jt.Name</option>
                                    }
                                </select>
                            </label>

                            <label class="block text-xs font-medium text-slate-700">
                                Vacant Position
                                <select class="@InputClass" @bind="positionId" @bind:after="OnPositionChanged">
                                    <option value="0">-- Assign later / None --</option>
                                    @foreach (var p in workspace.Context.VacantPositions)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </label>

                            @if (requiresStep)
                            {
                                <label class="block text-xs font-medium text-slate-700">
                                    Job Pay Step <span class="text-rose-600">*</span>
                                    <select class="@InputClass" @bind="jobMatrixStepId">
                                        <option value="0">-- Select pay step --</option>
                                        @foreach (var st in selectedPos!.PaySteps)
                                        {
                                            <option value="@st.Id">@st.Label@(st.BasicSalary.HasValue ? $" (MVR {st.BasicSalary.Value:N2})" : "")</option>
                                        }
                                    </select>
                                </label>
                            }

                            <label class="block text-xs font-medium text-slate-700">
                                Joining Date <span class="text-rose-600">*</span>
                                <input type="date" class="@InputClass" @bind="joinedDate" />
                            </label>

                            <label class="block text-xs font-medium text-slate-700 @(requiresStep ? "" : "sm:col-span-2")">
                                Remarks
                                <input class="@InputClass" maxlength="500" @bind="onboardingRemarks" placeholder="Recruitment offer onboarding remarks..." />
                            </label>
                        </div>

                        <div class="flex justify-end pt-1">
                            <button type="button"
                                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors"
                                    disabled="@(busy || (selectedOffer.MatchedIndividualId ?? 0) <= 0 || structureId <= 0 || jobTypeId <= 0 || (requiresStep && jobMatrixStepId <= 0))"
                                    @onclick="SubmitOnboarding">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                <span>Submit Onboarding Request</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (message is not null)
    {
        <div role="status" class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800">
            <span>@message</span>
            <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
        </div>
    }
</section>

@code {
    private IReadOnlyList<RecruitmentVacancyRow> vacancies = [];
    private RecruitmentOfferWorkspace? workspace;
    private RecruitmentOfferRow? selectedOffer;
    private int? expandedOfferId;
    private int vacancy, candidate, structureId, jobTypeId, positionId, jobMatrixStepId;
    private RecruitmentVacancyRow? SelectedVacancy => vacancies.FirstOrDefault(x => x.Id == vacancy);
    private string terms = "", probationPeriod = "3 months", onboardingRemarks = "Recruitment offer onboarding";
    private DateTime proposedStartDate = DateTime.UtcNow.AddHours(5).Date.AddDays(14);
    private DateTime joinedDate = DateTime.UtcNow.AddHours(5).Date;
    private bool busy;
    private string? message;
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500";

    protected override async Task OnInitializedAsync()
    {
        try { vacancies = await Api.GetVacanciesAsync(); }
        catch (HttpRequestException) { message = "Vacancies could not be loaded."; }
    }

    private async Task Load()
    {
        workspace = null;
        selectedOffer = null;
        expandedOfferId = null;
        candidate = structureId = jobTypeId = positionId = jobMatrixStepId = 0;
        terms = "";
        try
        {
            if (vacancy > 0)
            {
                workspace = await Api.GetOfferWorkspaceAsync(vacancy);
                if (workspace?.Context is not null)
                {
                    var salaryLine = workspace.Context.BasicSalary.HasValue ? $"Basic Salary: MVR {workspace.Context.BasicSalary.Value:N2}" : "";
                    var typeLine = !string.IsNullOrWhiteSpace(workspace.Context.EmploymentType) ? $"Employment Type: {workspace.Context.EmploymentType}" : "";
                    terms = string.Join("\n", new[] { $"Position: {workspace.Context.PositionName}", salaryLine, typeLine }.Where(s => !string.IsNullOrWhiteSpace(s)));
                }
            }
        }
        catch (HttpRequestException)
        {
            message = "Offers could not be loaded.";
        }
    }

    private void OpenOnboardingForm(RecruitmentOfferRow offerRow)
    {
        selectedOffer = offerRow;
        structureId = workspace?.Context?.DefaultOrganisationStructureId ?? 0;
        positionId = workspace?.Context?.DefaultPositionId ?? 0;
        jobTypeId = workspace?.Context?.JobTypes.FirstOrDefault()?.Id ?? 0;
        joinedDate = proposedStartDate;
        onboardingRemarks = $"Recruitment offer #{offerRow.Id} ({offerRow.ApplicationReference})";
        OnPositionChanged();
    }

    private void OnPositionChanged()
    {
        jobMatrixStepId = 0;
        var pos = workspace?.Context?.VacantPositions.FirstOrDefault(p => p.Id == positionId);
        if (pos is not null && pos.PaySteps.Count > 0)
            jobMatrixStepId = pos.PaySteps[0].Id;
    }

    private Task Issue()
    {
        var payload = JsonSerializer.Serialize(new
        {
            Position = workspace?.Context?.PositionName ?? SelectedVacancy?.PositionName ?? "",
            BasicSalary = workspace?.Context?.BasicSalary,
            EmploymentType = workspace?.Context?.EmploymentType,
            ProbationPeriod = probationPeriod.Trim(),
            ProposedStartDate = proposedStartDate.ToString("yyyy-MM-dd"),
            Terms = terms.Trim()
        });
        return Run(() => Api.CreateOfferAsync(new(candidate, payload)));
    }

    private Task SubmitOnboarding() => Run(() => Api.SubmitOnboardingAsync(new(
        selectedOffer!.Id,
        selectedOffer.MatchedIndividualId ?? 0,
        structureId,
        jobTypeId,
        positionId > 0 ? positionId : null,
        joinedDate,
        onboardingRemarks,
        jobMatrixStepId > 0 ? jobMatrixStepId : null)));

    private async Task Run(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await action();
            message = result.Message;
            if (result.Success) await Load();
        }
        catch (HttpRequestException)
        {
            message = "The action failed. Verify recruitment permissions, final results, and onboarding requirements.";
        }
        finally
        {
            busy = false;
        }
    }

    private static string FormatOfferStatus(string status) => status switch
    {
        "OnboardingSubmitted" => "Onboarding Submitted",
        _ => status
    };

    private static string OfferStatusBadge(string status) => status switch
    {
        "Accepted" => "bg-emerald-100 text-emerald-800",
        "OnboardingSubmitted" => "bg-blue-100 text-blue-800",
        "Declined" => "bg-rose-100 text-rose-800",
        _ => "bg-amber-100 text-amber-800"
    };

    private static string FormatOfferTerms(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            var lines = new List<string>();
            if (root.TryGetProperty("ProbationPeriod", out var prob) && !string.IsNullOrWhiteSpace(prob.GetString()))
                lines.Add($"Probation Period: {prob.GetString()}");
            if (root.TryGetProperty("ProposedStartDate", out var start) && !string.IsNullOrWhiteSpace(start.GetString()))
                lines.Add($"Proposed Start Date: {start.GetString()}");
            if (root.TryGetProperty("Terms", out var t) && !string.IsNullOrWhiteSpace(t.GetString()))
                lines.Add(t.GetString()!);
            return lines.Count > 0 ? string.Join("\n", lines) : json;
        }
        catch
        {
            return json;
        }
    }
}
