@using HRM.Application.Contracts.Recruitment
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api

<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-4">
    <div>
        <h2 class="text-sm font-bold text-slate-900">Offers &amp; Onboarding</h2>
        <p class="mt-0.5 text-xs text-slate-500">Issue job offers to finalised merit candidates and initiate staff onboarding once accepted.</p>
    </div>

    <label class="block text-xs font-medium text-slate-700 max-w-md">
        Vacancy
        <select class="@InputClass" @bind="vacancy" @bind:after="Load">
            <option value="0">-- Select vacancy --</option>
            @foreach (var v in vacancies)
            {
                <option value="@v.Id">@v.Reference</option>
            }
        </select>
    </label>

    @if (workspace is not null)
    {
        <div class="grid items-start gap-4 lg:grid-cols-12">
            <!-- Left: Issue Offer -->
            <div class="lg:col-span-5 rounded-xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
                <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">Issue Offer</h3>

                @if (workspace.Candidates.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-4 text-xs text-slate-500">
                        No unoffered candidate within the available slots has finalised results.
                    </div>
                }
                else
                {
                    <label class="block text-xs font-medium text-slate-700">
                        Selected Candidate
                        <select class="@InputClass" @bind="candidate">
                            <option value="0">-- Select candidate from final results --</option>
                            @foreach (var c in workspace.Candidates)
                            {
                                <option value="@c.MeritResultId">@c.ApplicantName · @c.ApplicationReference · Rank #@c.Rank</option>
                            }
                        </select>
                    </label>
                    <label class="block text-xs font-medium text-slate-700">
                        Offer Terms
                        <textarea rows="4" class="@InputClass" maxlength="8000" @bind="terms" placeholder="Specify grade, remuneration, probation period, and reporting details..."></textarea>
                    </label>
                    <div class="flex justify-end">
                        <button type="button"
                                class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors"
                                disabled="@(busy || candidate <= 0 || string.IsNullOrWhiteSpace(terms))"
                                @onclick="Issue">
                            Issue Offer
                        </button>
                    </div>
                }
            </div>

            <!-- Right: Issued Offers & Onboarding -->
            <div class="lg:col-span-7 space-y-3">
                <h3 class="text-xs font-bold uppercase tracking-wide text-slate-700">Issued Offers (@workspace.Offers.Count)</h3>
                @if (workspace.Offers.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-xs text-slate-500">
                        No offers issued for this vacancy yet.
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var o in workspace.Offers)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white p-3 text-xs">
                                <div>
                                    <span class="font-semibold text-slate-900">@o.ApplicantName</span>
                                    <span class="mx-1.5 text-slate-300">•</span>
                                    <span class="font-mono text-[11px] text-blue-700">@o.ApplicationReference</span>
                                    <span class="ml-2 rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(o.Status == "Accepted" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">@o.Status</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    @if (o.OnboardingRequestId.HasValue)
                                    {
                                        <a class="inline-flex items-center justify-center rounded-lg border border-blue-300 bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-800 hover:bg-blue-100"
                                           href="@($"/admin/my/workspace/onboarding?requestId={o.OnboardingRequestId}")">
                                            Open Onboarding Request
                                        </a>
                                    }
                                    @if (o.Status == "Accepted" && !o.OnboardingRequestId.HasValue)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-emerald-700"
                                                @onclick="() => offer = o.Id">
                                            Prepare Onboarding
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (offer > 0)
                {
                    <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-bold text-slate-900">Onboarding Request for Offer #@offer</h4>
                            <button type="button" class="text-xs font-semibold text-slate-500 hover:text-slate-800" @onclick="() => offer = 0">Cancel</button>
                        </div>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <label class="block text-xs font-medium text-slate-700">
                                Individual Registry ID
                                <input type="number" min="1" class="@InputClass" @bind="individual" />
                            </label>
                            <label class="block text-xs font-medium text-slate-700">
                                Organisation Structure ID
                                <input type="number" min="1" class="@InputClass" @bind="structure" />
                            </label>
                            <label class="block text-xs font-medium text-slate-700">
                                Job Type ID
                                <input type="number" min="1" class="@InputClass" @bind="jobType" />
                            </label>
                            <label class="block text-xs font-medium text-slate-700">
                                Position ID
                                <input type="number" min="1" class="@InputClass" @bind="position" />
                            </label>
                            <label class="block text-xs font-medium text-slate-700 sm:col-span-2">
                                Joining Date
                                <input type="date" class="@InputClass" @bind="joined" />
                            </label>
                        </div>
                        <p class="text-[11px] text-slate-500">The applicant identity and existing onboarding approval requirements are checked when submitted.</p>
                        <div class="flex justify-end">
                            <button type="button"
                                    class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors"
                                    disabled="@(busy || individual <= 0 || structure <= 0 || jobType <= 0 || position <= 0)"
                                    @onclick="Onboard">
                                Submit Onboarding Request
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (message is not null)
    {
        <div role="status" class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800">
            <span>@message</span>
            <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
        </div>
    }
</section>

@code {
    private IReadOnlyList<RecruitmentVacancyRow> vacancies = [];
    private RecruitmentOfferWorkspace? workspace;
    private int vacancy, candidate, offer, individual, structure, jobType, position;
    private string terms = "";
    private bool busy;
    private string? message;
    private DateTime joined = DateTime.UtcNow.AddHours(5).Date;
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500";

    protected override async Task OnInitializedAsync()
    {
        try { vacancies = await Api.GetVacanciesAsync(); }
        catch (HttpRequestException) { message = "Vacancies could not be loaded."; }
    }

    private async Task Load()
    {
        workspace = null;
        candidate = offer = 0;
        individual = structure = jobType = position = 0;
        terms = "";
        try
        {
            if (vacancy > 0) workspace = await Api.GetOfferWorkspaceAsync(vacancy);
        }
        catch (HttpRequestException)
        {
            message = "Offers could not be loaded.";
        }
    }

    private Task Issue() => Run(() => Api.CreateOfferAsync(new(candidate, System.Text.Json.JsonSerializer.Serialize(new { Terms = terms }))));
    private Task Onboard() => Run(() => Api.SubmitOnboardingAsync(new(offer, individual, structure, jobType, position, joined, "Recruitment offer onboarding")));

    private async Task Run(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await action();
            message = result.Message;
            if (result.Success) await Load();
        }
        catch (HttpRequestException)
        {
            message = "The action failed. Verify recruitment permissions, final results and onboarding requirements.";
        }
        finally
        {
            busy = false;
        }
    }
}
