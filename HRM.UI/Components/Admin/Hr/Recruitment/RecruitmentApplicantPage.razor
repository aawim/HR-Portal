@page "/online/recruitment"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode RenderMode.InteractiveServer
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>My Recruitment Applications</PageTitle>

<section class="w-full min-w-0 p-2 space-y-4">
    <!-- Full-Width Sticky Header -->
    <header class="sticky top-0 z-30 m-0 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-3 py-3 shadow-xs rounded-2xl flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">Careers &amp; Recruitment</span>
                <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">eFaas Verified Identity</span>
            </div>
            <h1 class="text-lg font-bold text-slate-900 truncate mt-0.5">My Applications &amp; Offers</h1>
            <p class="text-xs text-slate-500 mt-0.5">Browse open vacancies, submit applications, track progress, and respond to job offers.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
                    @onclick="ToggleWidthAsync">
                <span>@(isFullWidth ? "Shrink View" : "Full Width")</span>
            </button>
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors"
                    disabled="@busy"
                    @onclick="Load">
                <span>Refresh</span>
            </button>
        </div>
    </header>

    @if (message is not null)
    {
        <div role="status" class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3 text-xs text-slate-800 shadow-2xs @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl")">
            <span>@message</span>
            <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
        </div>
    }

    @if (workspace is not null)
    {
        <div class="grid items-start gap-4 lg:grid-cols-12 @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl")">
            <!-- Left: Apply & Applicant Profile -->
            <div class="lg:col-span-7">
                <RecruitmentApplyPanel Registered="workspace.ApplicantId.HasValue" Changed="Load" />
            </div>

            <!-- Right: Applications & Offers -->
            <aside class="lg:col-span-5 space-y-4">
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-bold text-slate-900">My Applications</h2>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">@workspace.Applications.Count</span>
                    </div>

                    @if (workspace.Applications.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-xs text-slate-500">
                            No applications are linked to your signed-in eFaas identity yet.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var a in workspace.Applications)
                            {
                                <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50/70 p-3 text-xs">
                                    <div>
                                        <p class="font-mono font-semibold text-blue-700">@a.Reference</p>
                                        <p class="text-[11px] text-slate-500">Vacancy: @a.VacancyReference</p>
                                    </div>
                                    <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-[11px] font-semibold text-blue-800">@a.Status</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @{
                    var myResults = workspace.Results ?? [];
                }
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-bold text-slate-900">Published Merit Results &amp; Objections</h2>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">@myResults.Count</span>
                    </div>

                    @if (myResults.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-xs text-slate-500">
                            No published merit results are available for your applications yet.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var r in myResults)
                            {
                                var objectionOpen = !r.IsFinal && r.ObjectionClosesAtUtc > DateTime.UtcNow;
                                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 text-xs space-y-2">
                                    <div class="flex items-start justify-between gap-2 flex-wrap">
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900">@(string.IsNullOrWhiteSpace(r.PositionName) ? r.VacancyReference : r.PositionName)</p>
                                            <p class="font-mono text-[11px] text-slate-500">@r.VacancyReference · App @r.ApplicationReference</p>
                                        </div>
                                        <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(r.IsFinal ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                            @(r.IsFinal ? "Finalised" : objectionOpen ? "Objection Period Open" : "Objection Period Closed")
                                        </span>
                                    </div>

                                    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2">
                                        <div>
                                            <span class="block text-[10px] uppercase tracking-wide text-slate-500">Merit Rank</span>
                                            <strong class="text-sm text-blue-700">#@r.Rank</strong>
                                        </div>
                                        <div class="h-6 w-px bg-slate-200"></div>
                                        <div>
                                            <span class="block text-[10px] uppercase tracking-wide text-slate-500">Total Score</span>
                                            <strong class="text-sm text-slate-900 tabular-nums">@r.Score.ToString("0.##")</strong>
                                        </div>
                                        <div class="h-6 w-px bg-slate-200"></div>
                                        <div>
                                            <span class="block text-[10px] uppercase tracking-wide text-slate-500">Objections Close</span>
                                            <span class="font-semibold text-slate-700">@r.ObjectionClosesAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT</span>
                                        </div>
                                    </div>

                                    @if (r.ObjectionId.HasValue)
                                    {
                                        <div class="rounded-lg border border-amber-200 bg-amber-50/60 p-2.5 space-y-1.5">
                                            <div class="flex items-center justify-between gap-2">
                                                <span class="font-semibold text-slate-800">Your Objection</span>
                                                <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(r.ObjectionStatus == "Upheld" ? "bg-emerald-100 text-emerald-800" : r.ObjectionStatus == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                                    @r.ObjectionStatus
                                                </span>
                                            </div>
                                            <p class="whitespace-pre-wrap text-slate-700">@r.ObjectionGrounds</p>
                                            @if (!string.IsNullOrWhiteSpace(r.ObjectionResolution))
                                            {
                                                <div class="rounded border border-slate-200 bg-white p-2 text-slate-700">
                                                    <span class="block text-[10px] font-bold uppercase tracking-wide text-slate-500">Committee Resolution</span>
                                                    <p class="whitespace-pre-wrap mt-0.5">@r.ObjectionResolution</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (objectionOpen)
                                    {
                                        @if (objectingPublicationId == r.PublicationId && objectingApplicationId == r.ApplicationId)
                                        {
                                            <div class="rounded-lg border border-blue-200 bg-blue-50/50 p-2.5 space-y-2">
                                                <label class="block text-xs font-semibold text-slate-700">
                                                    Grounds for Objection *
                                                    <textarea rows="3"
                                                              maxlength="4000"
                                                              class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"
                                                              placeholder="Explain the specific scoring or screening issue you are objecting to…"
                                                              @bind="objectionGrounds"
                                                              @bind:event="oninput"></textarea>
                                                </label>
                                                <div class="flex items-center justify-end gap-2">
                                                    <button type="button"
                                                            class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                                            disabled="@busy"
                                                            @onclick="CancelObjection">
                                                        Cancel
                                                    </button>
                                                    <button type="button"
                                                            class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50"
                                                            disabled="@(busy || string.IsNullOrWhiteSpace(objectionGrounds))"
                                                            @onclick="SubmitObjectionAsync">
                                                        Submit Objection
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-900 hover:bg-amber-100 disabled:opacity-50 transition-colors"
                                                    disabled="@busy"
                                                    @onclick="() => StartObjection(r.PublicationId, r.ApplicationId)">
                                                Submit Objection
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-bold text-slate-900">My Offers</h2>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">@workspace.Offers.Count</span>
                    </div>

                    @if (workspace.Offers.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-xs text-slate-500">
                            You have no job offers at this time.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var o in workspace.Offers)
                            {
                                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 text-xs space-y-2">
                                    <div class="flex items-center justify-between">
                                        <span class="font-mono font-semibold text-slate-900">@o.VacancyReference</span>
                                        <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(o.Status == "Accepted" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">@o.Status</span>
                                    </div>
                                    <p class="whitespace-pre-wrap rounded-lg border border-slate-200 bg-white p-2.5 text-slate-700">@Terms(o.TermsSnapshotJson)</p>
                                    @if (o.Status == "Offered")
                                    {
                                        @if (confirmation == o.Id)
                                        {
                                            <div class="rounded-lg border border-blue-200 bg-blue-50 p-2.5 space-y-2">
                                                <p class="font-medium text-blue-900">Confirm that you have reviewed and accept these offer terms.</p>
                                                <div class="flex gap-2">
                                                    <button type="button" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50" disabled="@busy" @onclick="() => Accept(o.Id)">Confirm Acceptance</button>
                                                    <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" disabled="@busy" @onclick="() => confirmation = 0">Cancel</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50" disabled="@busy" @onclick="() => confirmation = o.Id">Review Acceptance</button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    }
</section>

@code {
    private HRM.Application.Contracts.Recruitment.MyRecruitmentWorkspace? workspace;
    private bool busy, isFullWidth;
    private string? message;
    private int confirmation;
    private int objectingPublicationId;
    private int objectingApplicationId;
    private string objectionGrounds = "";

    private void StartObjection(int publicationId, int applicationId)
    {
        objectingPublicationId = publicationId;
        objectingApplicationId = applicationId;
        objectionGrounds = "";
    }

    private void CancelObjection()
    {
        objectingPublicationId = 0;
        objectingApplicationId = 0;
        objectionGrounds = "";
    }

    private async Task SubmitObjectionAsync()
    {
        if (busy || objectingPublicationId <= 0 || objectingApplicationId <= 0 || string.IsNullOrWhiteSpace(objectionGrounds)) return;
        busy = true;
        try
        {
            var result = await Api.SubmitMyObjectionAsync(new(objectingPublicationId, objectingApplicationId, objectionGrounds.Trim()));
            message = result.Message;
            if (result.Success)
            {
                CancelObjection();
                await Load();
            }
        }
        catch (HttpRequestException)
        {
            message = "Objection could not be submitted. Verify that the objection period is still open.";
        }
        finally
        {
            busy = false;
        }
    }

    protected override Task OnInitializedAsync() => Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isFullWidth = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.my-recruitment.full-width") == "true";
            StateHasChanged();
        }
    }

    private async Task ToggleWidthAsync()
    {
        isFullWidth = !isFullWidth;
        await JS.InvokeVoidAsync("localStorage.setItem", "hrm.my-recruitment.full-width", isFullWidth ? "true" : "false");
    }

    private async Task Load()
    {
        busy = true;
        try
        {
            workspace = await Api.GetMyWorkspaceAsync();
        }
        catch (HttpRequestException ex)
        {
            workspace = null;
            message = ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden
                ? "Sign in through eFaas to view your applications and offers."
                : "Your applications could not be loaded. Try again shortly.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Accept(int id)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await Api.AcceptMyOfferAsync(id);
            message = result.Message;
            if (result.Success)
            {
                confirmation = 0;
                await Load();
            }
        }
        catch (HttpRequestException)
        {
            message = "Offer acceptance failed. Refresh and check the offer status.";
        }
        finally
        {
            busy = false;
        }
    }

    private static string Terms(string json)
    {
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(json);
            return d.RootElement.TryGetProperty("Terms", out var t) ? t.GetString() ?? "" : "Contact the recruitment office for your offer terms.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "Contact the recruitment office for your offer terms.";
        }
    }
}
