@page "/online/recruitment"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode RenderMode.InteractiveServer
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api
<PageTitle>My recruitment applications</PageTitle>
<section class="p-2 w-full min-w-0 space-y-4">
    <header class="sticky top-0 z-30 flex flex-wrap justify-between gap-2 border-b border-slate-200 bg-white/95 px-3 py-3 shadow-xs"><div><h1 class="text-lg font-bold text-slate-900">My applications and offers</h1><p class="mt-0.5 text-xs text-slate-500">Track your recruitment applications and respond to your offers.</p></div><button class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="Load">Refresh</button></header>
    @if(message is not null){<p role="status" class="p-3 rounded-xl border border-slate-200 text-sm">@message</p>}
    @if(workspace is not null){
        <div class="p-4 rounded-2xl border border-slate-200 app-surface space-y-3"><h2 class="p-1 font-bold">Applications</h2>
            @if(workspace.Applications.Count==0){<p class="p-3 text-xs text-slate-500">No applications are linked to your signed-in eFaas identity.</p>}
            @foreach(var a in workspace.Applications){<div class="p-3 rounded-xl border border-slate-200 text-xs">@a.Reference · @a.VacancyReference · @a.Status</div>}
        </div>
        <div class="p-4 rounded-2xl border border-slate-200 app-surface space-y-3"><h2 class="p-1 font-bold">Offers</h2>
            @if(workspace.Offers.Count==0){<p class="p-3 text-xs text-slate-500">You have no offers.</p>}
            @foreach(var o in workspace.Offers){<div class="p-3 rounded-xl border border-slate-200 text-xs space-y-2"><p>@o.VacancyReference · @o.Status</p><p class="whitespace-pre-wrap">@Terms(o.TermsSnapshotJson)</p>@if(o.Status=="Offered"){<button class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="()=>confirmation=o.Id">Review acceptance</button>@if(confirmation==o.Id){<p>Confirm that you have reviewed and accept these offer terms.</p><button class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="()=>Accept(o.Id)">Confirm acceptance</button><button class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="()=>confirmation=0">Cancel</button>}}</div>}
        </div>
    }
</section>
@code{
    private HRM.Application.Contracts.Recruitment.MyRecruitmentWorkspace? workspace;
    private bool busy;private string? message;private int confirmation;
    protected override Task OnInitializedAsync()=>Load();
    private async Task Load(){busy=true;try{workspace=await Api.GetMyWorkspaceAsync();}catch(HttpRequestException ex){workspace=null;message=ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden?"Sign in through eFaas to view your applications and offers.":"Your applications could not be loaded. Try again shortly.";}finally{busy=false;}}
    private async Task Accept(int id){if(busy)return;busy=true;try{var result=await Api.AcceptMyOfferAsync(id);message=result.Message;if(result.Success){confirmation=0;await Load();}}catch(HttpRequestException){message="Offer acceptance failed. Refresh and check the offer status.";}finally{busy=false;}}
    private static string Terms(string json){try{using var d=System.Text.Json.JsonDocument.Parse(json);return d.RootElement.TryGetProperty("Terms",out var t)?t.GetString()??"":"Contact the recruitment office for your offer terms.";}catch(System.Text.Json.JsonException){return "Contact the recruitment office for your offer terms.";}}
}
