@page "/online/recruitment"
@page "/careers"
@page "/careers/{OfficeName}"
@page "/careers/{OfficeName}/{VacancyRef}"
@page "/vacancies"
@page "/{OfficeName}/vacancies"
@rendermode RenderMode.InteractiveServer
@using HRM.Application.Contracts.Recruitment
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@(officeResponse is not null ? $"{officeResponse.OrganisationName} — Careers" : "Government Careers Portal")</PageTitle>

<div class="je-portal w-full min-w-0">
    <!-- JobEntry-style Clean Top Navigation Bar (No Post A Job, No Carousel) -->
    <header class="je-navbar">
        <div class="je-navbar-inner">
            <a href="@(officeResponse is not null ? $"/careers/{officeResponse.OfficeSlug}" : "/careers")" class="je-brand">
                <span class="je-brand-icon" aria-hidden="true">
                    <i class="bi bi-briefcase-fill"></i>
                </span>
                <span class="min-w-0">
                    <span class="je-brand-title">@(officeResponse is not null ? officeResponse.OrganisationName : "Careers Portal")</span>
                    <span class="je-brand-sub">@(isAuthenticated ? "eFaas Verified Applicant" : "Maldives Public Service Vacancies")</span>
                </span>
            </a>

            <nav class="je-nav-links" aria-label="Careers navigation">
                <button type="button"
                        class="je-nav-item @(activeTab == "vacancies" ? "is-active" : "")"
                        @onclick='() => OpenTab("vacancies")'>
                    <i class="bi bi-briefcase" aria-hidden="true"></i>
                    <span>Vacancies</span>
                    @if (publicVacancies.Count > 0)
                    {
                        <span class="je-pill">@publicVacancies.Count</span>
                    }
                </button>

                @if (isAuthenticated)
                {
                    <button type="button"
                            class="je-nav-item @(activeTab == "applications" ? "is-active" : "")"
                            @onclick='() => OpenTab("applications")'>
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                        <span>My Applications</span>
                        <span class="je-pill">@(workspace?.Applications.Count ?? 0)</span>
                    </button>

                    <button type="button"
                            class="je-nav-item @(activeTab == "results" ? "is-active" : "")"
                            @onclick='() => OpenTab("results")'>
                        <i class="bi bi-trophy" aria-hidden="true"></i>
                        <span>Results &amp; Objections</span>
                        <span class="je-pill">@(workspace?.Results?.Count ?? 0)</span>
                    </button>

                    <button type="button"
                            class="je-nav-item @(activeTab == "offers" ? "is-active" : "")"
                            @onclick='() => OpenTab("offers")'>
                        <i class="bi bi-envelope-check" aria-hidden="true"></i>
                        <span>Offers</span>
                        <span class="je-pill">@(workspace?.Offers.Count ?? 0)</span>
                    </button>

                    <button type="button"
                            class="je-nav-item @(activeTab == "profile" ? "is-active" : "")"
                            @onclick='() => OpenTab("profile")'>
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span>Profile</span>
                        @if (workspace is not null && !workspace.ApplicantId.HasValue)
                        {
                            <span class="je-pill-warn">Setup</span>
                        }
                    </button>
                }
            </nav>

            <div class="je-nav-actions">
                @if (officeResponse is not null)
                {
                    <a href="/careers" class="je-btn-outline" title="Browse vacancies across all offices">All Offices</a>
                }
                @if (!isAuthenticated)
                {
                    <a href="@LoginUrl" class="je-btn-primary">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        <span>Sign in with eFaas</span>
                    </a>
                }
                else
                {
                    <button type="button" class="je-user-chip" @onclick='() => OpenTab("profile")' title="View Applicant Profile">
                        <span class="je-avatar">@GetInitials(workspace?.ProfileFullName)</span>
                        <span class="je-user-name">@(string.IsNullOrWhiteSpace(workspace?.ProfileFullName) ? "Applicant" : workspace.ProfileFullName)</span>
                    </button>
                    <a href="/Online/Auth/NoAccessLogout" class="je-btn-outline" title="Sign out">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>Sign Out</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- JobEntry-style Emerald Search Band (shown on Vacancies listing) -->
    @if (!officeNotFound && activeTab == "vacancies" && string.IsNullOrWhiteSpace(applyingVacancyRef))
    {
        <div class="je-search-band">
            <div class="je-container">
                <div class="je-search-grid">
                    <div class="je-search-input-wrap">
                        <i class="bi bi-search je-search-icon" aria-hidden="true"></i>
                        <input type="text"
                               class="je-search-input"
                               placeholder="Search job title or vacancy reference..."
                               @bind="searchKeyword"
                               @bind:event="oninput" />
                    </div>

                    @if (DistinctEmploymentTypes.Count > 0)
                    {
                        <select class="je-search-select" @bind="selectedEmploymentType">
                            <option value="">All Employment Types</option>
                            @foreach (var empType in DistinctEmploymentTypes)
                            {
                                <option value="@empType">@empType</option>
                            }
                        </select>
                    }

                    @if (officeResponse is null && DistinctOffices.Count > 1)
                    {
                        <select class="je-search-select" @bind="selectedOfficeFilter">
                            <option value="">All Organisations (@publicVacancies.Count)</option>
                            @foreach (var office in DistinctOffices)
                            {
                                <option value="@office">@office</option>
                            }
                        </select>
                    }

                    <select class="je-search-select" @bind="sortOrder">
                        <option value="closing">Closing Soonest</option>
                        <option value="title">Position Title (A–Z)</option>
                    </select>

                    <button type="button" class="je-search-btn" disabled="@busy" @onclick="Load">
                        <i class="bi bi-arrow-clockwise @(busy ? "animate-spin" : "")" aria-hidden="true"></i>
                        <span>Refresh</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Main Centered Portal Container -->
    <div class="je-container je-main">
        @if (officeNotFound)
        {
            <div role="alert" class="je-card je-empty">
                <i class="bi bi-building-x text-3xl text-amber-500" aria-hidden="true"></i>
                <h2 class="text-base font-bold text-slate-900 mt-2">Organisation not found for "@OfficeName"</h2>
                <p class="text-xs text-slate-500 mt-1">No active organisation matched this careers URL. Browse all open government vacancies instead.</p>
                <a href="/careers" class="je-btn-primary mt-3">View All Open Vacancies</a>
            </div>
        }
        else
        {
            @if (message is not null)
            {
                <div role="status" class="je-alert">
                    <span>@message</span>
                    <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
                </div>
            }

            @if (isAuthenticated && workspace is not null && !workspace.ApplicantId.HasValue && activeTab != "profile")
            {
                <div class="je-setup-banner">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <i class="bi bi-person-exclamation text-lg text-amber-600 shrink-0" aria-hidden="true"></i>
                        <div class="text-xs">
                            <strong class="text-slate-900">Complete your eFaas Applicant Profile</strong>
                            <span class="text-slate-600"> — confirm your email and mobile number once so you can submit applications.</span>
                        </div>
                    </div>
                    <button type="button" class="je-btn-primary shrink-0" @onclick='() => OpenTab("profile")'>
                        Complete Profile
                    </button>
                </div>
            }

            <!-- TAB 1: OPEN VACANCIES / APPLY WORKSPACE -->
            @if (activeTab == "vacancies")
            {
                @if (isAuthenticated && workspace is not null && !string.IsNullOrWhiteSpace(applyingVacancyRef))
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <button type="button" class="je-btn-outline" @onclick="BackToListings">
                                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                <span>Back to Job Listings</span>
                            </button>
                            <span class="text-xs font-mono text-slate-500">Applying for: <strong>@applyingVacancyRef</strong></span>
                        </div>

                        <RecruitmentApplyPanel @key="applyingVacancyRef"
                                               Registered="workspace.ApplicantId.HasValue"
                                               ShowProfileCard="true"
                                               InitialFullName="@workspace.ProfileFullName"
                                               InitialEmail="@workspace.ProfileEmail"
                                               InitialMobile="@workspace.ProfileMobile"
                                               OrganisationIdFilter="@officeResponse?.OrganisationId"
                                               OrganisationNameFilter="@officeResponse?.OrganisationName"
                                               InitialVacancyRef="@applyingVacancyRef"
                                               Changed="Load" />
                    </div>
                }
                else
                {
                    <div class="je-section-head">
                        <div>
                            <h2 class="je-section-title">
                                @(officeResponse is not null ? $"Job Listings at {officeResponse.OrganisationName}" : "Open Job Listings")
                            </h2>
                            <p class="je-section-sub">
                                Showing @FilteredVacancies.Count open @(FilteredVacancies.Count == 1 ? "vacancy" : "vacancies")
                            </p>
                        </div>
                    </div>

                    @if (FilteredVacancies.Count == 0)
                    {
                        <div class="je-card je-empty">
                            <i class="bi bi-briefcase text-3xl text-slate-300" aria-hidden="true"></i>
                            <p class="text-sm font-semibold text-slate-700 mt-2">No matching open vacancies found</p>
                            <p class="text-xs text-slate-500 mt-0.5">
                                @(string.IsNullOrWhiteSpace(searchKeyword) && string.IsNullOrWhiteSpace(selectedOfficeFilter)
                                    ? "There are currently no published vacancies accepting applications."
                                    : "Try clearing your search keyword or organisation filter.")
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="je-job-list">
                            @foreach (var v in FilteredVacancies)
                            {
                                var isExpired = v.ClosingAtUtc <= DateTime.UtcNow;
                                var alreadyApplied = isAuthenticated && workspace?.Applications.Any(a => string.Equals(a.VacancyReference, v.Reference, StringComparison.OrdinalIgnoreCase)) == true;
                                <article class="je-job-item @(isExpired ? "je-job-expired" : "")">
                                    <div class="je-job-left">
                                        <div class="je-job-logo @(isExpired ? "is-expired" : "")" aria-hidden="true">
                                            <i class="bi bi-briefcase-fill"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <h3 class="je-job-title">@(string.IsNullOrWhiteSpace(v.PositionName) ? v.Reference : v.PositionName)</h3>
                                                @if (!string.IsNullOrWhiteSpace(v.EmploymentType))
                                                {
                                                    <span class="rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[10px] font-semibold text-blue-700">@v.EmploymentType</span>
                                                }
                                                @if (isExpired)
                                                {
                                                    <span class="rounded-full bg-rose-50 border border-rose-200 px-2 py-0.5 text-[10px] font-semibold text-rose-700">Expired</span>
                                                }
                                                else
                                                {
                                                    <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">Open</span>
                                                }
                                                @if (v.HasPublishedResults)
                                                {
                                                    <span class="rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-[10px] font-semibold text-amber-800">
                                                        @(v.IsResultFinal ? "Results Finalised" : "Results Published")
                                                    </span>
                                                }
                                            </div>
                                            <div class="je-job-meta">
                                                @if (!string.IsNullOrWhiteSpace(v.OrganisationName))
                                                {
                                                    <span><i class="bi bi-building" aria-hidden="true"></i> @v.OrganisationName</span>
                                                }
                                                <span class="font-mono"><i class="bi bi-hash" aria-hidden="true"></i> @v.Reference</span>
                                                <span class="@(isExpired ? "text-rose-600 font-semibold" : "")">
                                                    <i class="bi bi-calendar-event" aria-hidden="true"></i>
                                                    @(isExpired ? "Expired:" : "Expires:") @v.ClosingAtUtc.AddHours(5).ToString("dd MMM yyyy, HH:mm") MVT
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="je-job-right">
                                        @if (v.HasPublishedResults && v.PublicationId.HasValue)
                                        {
                                            <button type="button"
                                                    class="je-btn-outline"
                                                    disabled="@loadingResultDetail"
                                                    @onclick="() => ViewVacancyResultAsync(v)">
                                                <i class="bi bi-trophy" aria-hidden="true"></i>
                                                <span>View Result</span>
                                            </button>
                                        }

                                        @if (isExpired)
                                        {
                                            <button type="button" class="je-btn-disabled" disabled>
                                                <i class="bi bi-lock" aria-hidden="true"></i>
                                                <span>Closed</span>
                                            </button>
                                        }
                                        else if (alreadyApplied)
                                        {
                                            <button type="button" class="je-btn-outline" @onclick="() => BeginApply(v.Reference)">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                <span>View / Edit Application</span>
                                            </button>
                                        }
                                        else if (isAuthenticated)
                                        {
                                            <button type="button" class="je-btn-primary" @onclick="() => BeginApply(v.Reference)">
                                                <span>Apply Now</span>
                                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@LoginUrlForVacancy(v)" class="je-btn-primary">
                                                <span>Apply Now</span>
                                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            }

            <!-- TAB 2: MY APPLICATIONS -->
            @if (activeTab == "applications" && workspace is not null)
            {
                <div class="je-section-head">
                    <div>
                        <h2 class="je-section-title">My Applications</h2>
                        <p class="je-section-sub">Track all draft and submitted applications linked to your eFaas identity.</p>
                    </div>
                </div>

                @if (workspace.Applications.Count == 0)
                {
                    <div class="je-card je-empty">
                        <i class="bi bi-file-earmark-text text-3xl text-slate-300" aria-hidden="true"></i>
                        <p class="text-sm font-semibold text-slate-700 mt-2">No applications yet</p>
                        <button type="button" class="je-btn-primary mt-3" @onclick='() => OpenTab("vacancies")'>Browse Open Vacancies</button>
                    </div>
                }
                else
                {
                    <div class="je-card overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                    <tr>
                                        <th class="px-4 py-3">Application Ref</th>
                                        <th class="px-4 py-3">Vacancy Ref</th>
                                        <th class="px-4 py-3">Submitted (MVT)</th>
                                        <th class="px-4 py-3">Status</th>
                                        <th class="px-4 py-3 text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var a in workspace.Applications)
                                    {
                                        var isReturned = a.Status == "ReturnedForCorrection";
                                        var correctionOpen = isReturned && a.CorrectionDeadlineUtc.HasValue && a.CorrectionDeadlineUtc.Value > DateTime.UtcNow;
                                        <tr class="hover:bg-slate-50/70 @(isReturned ? "bg-amber-50/40" : "")">
                                            <td class="px-4 py-3 font-mono font-semibold text-blue-700">@a.Reference</td>
                                            <td class="px-4 py-3 font-mono text-slate-700">@a.VacancyReference</td>
                                            <td class="px-4 py-3 text-slate-500">@(a.SubmittedAtUtc.HasValue ? a.SubmittedAtUtc.Value.AddHours(5).ToString("dd MMM yyyy HH:mm") : "Draft")</td>
                                            <td class="px-4 py-3 space-y-1">
                                                <span class="inline-block rounded-full border px-2.5 py-0.5 text-[11px] font-semibold @(isReturned ? "bg-amber-100 border-amber-300 text-amber-900" : "bg-blue-50 border-blue-200 text-blue-800")">
                                                    @(isReturned ? "Returned for Correction" : a.Status)
                                                </span>
                                                @if (isReturned)
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(a.ReturnComment))
                                                    {
                                                        <p class="text-[11px] text-amber-900 max-w-md whitespace-pre-wrap">@a.ReturnComment</p>
                                                    }
                                                    @if (a.CorrectionDeadlineUtc.HasValue)
                                                    {
                                                        <p class="text-[10px] font-semibold @(correctionOpen ? "text-amber-700" : "text-rose-700")">
                                                            @(correctionOpen ? "Resubmit before: " : "Correction deadline passed: ")@a.CorrectionDeadlineUtc.Value.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT
                                                        </p>
                                                    }
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-right">
                                                @if (correctionOpen)
                                                {
                                                    <button type="button" class="je-btn-primary" @onclick="() => BeginApply(a.VacancyReference)">
                                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                        <span>Correct &amp; Resubmit</span>
                                                    </button>
                                                }
                                                else if (a.Status == "Draft")
                                                {
                                                    <button type="button" class="je-btn-outline" @onclick="() => BeginApply(a.VacancyReference)">
                                                        <span>Continue Draft</span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }

            <!-- TAB 3: PUBLISHED MERIT RESULTS & OBJECTIONS -->
            @if (activeTab == "results" && workspace is not null)
            {
                var myResults = workspace.Results ?? [];
                <div class="je-section-head">
                    <div>
                        <h2 class="je-section-title">Published Merit Results &amp; Objections</h2>
                        <p class="je-section-sub">Inspect published A2 merit sheets, review your score breakdown, and submit objections during the open window.</p>
                    </div>
                </div>

                @if (myResults.Count == 0)
                {
                    <div class="je-card je-empty">
                        <i class="bi bi-trophy text-3xl text-slate-300" aria-hidden="true"></i>
                        <p class="text-sm font-semibold text-slate-700 mt-2">No published merit results yet</p>
                        <p class="text-xs text-slate-500 mt-0.5">Published A2 merit sheets for vacancies you applied to will appear here automatically.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        @foreach (var r in myResults)
                        {
                            var objectionOpen = !r.IsFinal && r.ObjectionClosesAtUtc > DateTime.UtcNow;
                            <div class="je-card p-4 text-xs space-y-3">
                                <div class="flex items-start justify-between gap-2 flex-wrap">
                                    <div class="min-w-0">
                                        <h3 class="text-sm font-bold text-slate-900">@(string.IsNullOrWhiteSpace(r.PositionName) ? r.VacancyReference : r.PositionName)</h3>
                                        <p class="font-mono text-[11px] text-slate-500">@r.VacancyReference · App @r.ApplicationReference</p>
                                    </div>
                                    <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(r.IsFinal ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                        @(r.IsFinal ? "Finalised" : objectionOpen ? "Objection Period Open" : "Objection Period Closed")
                                    </span>
                                </div>

                                <div class="flex flex-wrap items-center gap-4 rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5">
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-wider text-slate-500">Merit Rank</span>
                                        <strong class="text-sm @(r.Rank.HasValue ? "text-blue-700" : "text-slate-600")">@(r.Rank.HasValue ? $"#{r.Rank}" : "Not Ranked")</strong>
                                    </div>
                                    <div class="h-6 w-px bg-slate-200"></div>
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-wider text-slate-500">Total Score</span>
                                        <strong class="text-sm text-slate-900 tabular-nums">@(r.Score.HasValue ? r.Score.Value.ToString("0.##") : r.ApplicationStatus)</strong>
                                    </div>
                                    <div class="h-6 w-px bg-slate-200"></div>
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-wider text-slate-500">Objections Close</span>
                                        <span class="font-semibold text-slate-700">@r.ObjectionClosesAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT</span>
                                    </div>
                                </div>

                                <div class="flex flex-wrap items-center gap-2">
                                    <button type="button"
                                            class="je-btn-primary"
                                            disabled="@(busy || loadingResultDetail)"
                                            @onclick="() => ViewResultSheetAsync(r.PublicationId, r.ApplicationId)">
                                        <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                                        <span>View Result Sheet</span>
                                    </button>
                                    @if (!r.ObjectionId.HasValue && objectionOpen && !(objectingPublicationId == r.PublicationId && objectingApplicationId == r.ApplicationId))
                                    {
                                        <button type="button"
                                                class="je-btn-outline"
                                                disabled="@busy"
                                                @onclick="() => StartObjection(r.PublicationId, r.ApplicationId)">
                                            Submit Objection
                                        </button>
                                    }
                                </div>

                                @if (r.ObjectionId.HasValue)
                                {
                                    <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-3 space-y-1.5">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="font-semibold text-slate-800">Your Objection</span>
                                            <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(r.ObjectionStatus == "Upheld" ? "bg-emerald-100 text-emerald-800" : r.ObjectionStatus == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                                @r.ObjectionStatus
                                            </span>
                                        </div>
                                        <p class="whitespace-pre-wrap text-slate-700">@r.ObjectionGrounds</p>
                                        @if (!string.IsNullOrWhiteSpace(r.ObjectionResolution))
                                        {
                                            <div class="rounded-lg border border-slate-200 bg-white p-2.5 text-slate-700">
                                                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Committee Resolution</span>
                                                <p class="whitespace-pre-wrap mt-0.5">@r.ObjectionResolution</p>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (objectionOpen && objectingPublicationId == r.PublicationId && objectingApplicationId == r.ApplicationId)
                                {
                                    <div class="rounded-xl border border-teal-200 bg-teal-50/40 p-3 space-y-2">
                                        <label class="block text-xs font-semibold text-slate-700">
                                            Grounds for Objection *
                                            <textarea rows="3"
                                                      maxlength="4000"
                                                      class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-teal-600 focus:outline-none"
                                                      placeholder="Explain the specific scoring or screening issue you are objecting to…"
                                                      @bind="objectionGrounds"
                                                      @bind:event="oninput"></textarea>
                                        </label>
                                        <div class="flex items-center justify-end gap-2">
                                            <button type="button" class="je-btn-outline" disabled="@busy" @onclick="CancelObjection">Cancel</button>
                                            <button type="button" class="je-btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(objectionGrounds))" @onclick="SubmitObjectionAsync">Submit Objection</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- TAB 4: MY OFFERS -->
            @if (activeTab == "offers" && workspace is not null)
            {
                <div class="je-section-head">
                    <div>
                        <h2 class="je-section-title">My Job Offers</h2>
                        <p class="je-section-sub">Review official offer terms and confirm acceptance.</p>
                    </div>
                </div>

                @if (workspace.Offers.Count == 0)
                {
                    <div class="je-card je-empty">
                        <i class="bi bi-envelope-check text-3xl text-slate-300" aria-hidden="true"></i>
                        <p class="text-sm font-semibold text-slate-700 mt-2">No job offers at this time</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        @foreach (var o in workspace.Offers)
                        {
                            <div class="je-card p-4 text-xs space-y-3">
                                <div class="flex items-center justify-between">
                                    <span class="font-mono font-bold text-slate-900">@o.VacancyReference</span>
                                    <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(o.Status == "Accepted" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">@o.Status</span>
                                </div>
                                <p class="whitespace-pre-wrap rounded-xl border border-slate-200 bg-slate-50 p-3 text-slate-700">@Terms(o.TermsSnapshotJson)</p>
                                @if (o.Status == "Offered")
                                {
                                    @if (confirmation == o.Id)
                                    {
                                        <div class="rounded-xl border border-teal-200 bg-teal-50/50 p-3 space-y-2">
                                            <p class="font-medium text-teal-900">Confirm that you have reviewed and accept these offer terms.</p>
                                            <div class="flex gap-2">
                                                <button type="button" class="je-btn-primary" disabled="@busy" @onclick="() => Accept(o.Id)">Confirm Acceptance</button>
                                                <button type="button" class="je-btn-outline" disabled="@busy" @onclick="() => confirmation = 0">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="je-btn-primary" disabled="@busy" @onclick="() => confirmation = o.Id">Review Acceptance</button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- TAB 5: MY APPLICANT PROFILE -->
            @if (activeTab == "profile" && workspace is not null)
            {
                <div class="je-section-head">
                    <div>
                        <h2 class="je-section-title">My Applicant Profile</h2>
                        <p class="je-section-sub">Your eFaas-verified identity and contact information for job applications.</p>
                    </div>
                </div>

                <div class="je-card p-5 max-w-3xl space-y-4 text-xs">
                    <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
                        <div class="je-avatar-lg">@GetInitials(workspace.ProfileFullName)</div>
                        <div>
                            <h3 class="text-base font-bold text-slate-900">@(string.IsNullOrWhiteSpace(workspace.ProfileFullName) ? "eFaas Applicant" : workspace.ProfileFullName)</h3>
                            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10px] font-semibold mt-1 @(workspace.ApplicantId.HasValue ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                @(workspace.ApplicantId.HasValue ? $"Registered Applicant #{workspace.ApplicantId}" : "Profile Setup Required")
                            </span>
                        </div>
                    </div>

                    @if (workspace.ApplicantId.HasValue)
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Full Name (eFaas Verified)</span>
                                <strong class="text-sm text-slate-900">@(workspace.ProfileFullName ?? "—")</strong>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Email</span>
                                <span class="font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(workspace.ProfileEmail) ? "—" : workspace.ProfileEmail)</span>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Mobile</span>
                                <span class="font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(workspace.ProfileMobile) ? "—" : workspace.ProfileMobile)</span>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Applications Submitted</span>
                                <strong class="text-sm text-blue-700">@workspace.Applications.Count</strong>
                            </div>
                        </div>
                        <div class="flex justify-end pt-2">
                            <button type="button" class="je-btn-primary" @onclick='() => OpenTab("vacancies")'>Browse Open Vacancies</button>
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-600">
                            Your full name is fetched directly from your verified eFaas record. Confirm your email and mobile number once to activate your applicant profile.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <label class="block text-xs font-medium text-slate-700">
                                Full Name <span class="text-[10px] text-slate-400">(eFaas verified)</span>
                                <input class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600 cursor-not-allowed"
                                       value="@regName"
                                       disabled="@(!string.IsNullOrWhiteSpace(workspace.ProfileFullName))"
                                       readonly="@(!string.IsNullOrWhiteSpace(workspace.ProfileFullName))" />
                            </label>
                            <label class="block text-xs font-medium text-slate-700">
                                Email *
                                <input type="email"
                                       maxlength="320"
                                       class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-900 focus:border-teal-600 focus:outline-none"
                                       @bind="regEmail"
                                       @bind:event="oninput" />
                            </label>
                            <label class="block text-xs font-medium text-slate-700">
                                Mobile
                                <input type="tel"
                                       maxlength="40"
                                       class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-900 focus:border-teal-600 focus:outline-none"
                                       @bind="regMobile"
                                       @bind:event="oninput" />
                            </label>
                        </div>
                        <div class="flex justify-end pt-2">
                            <button type="button"
                                    class="je-btn-primary"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(regName) || string.IsNullOrWhiteSpace(regEmail))"
                                    @onclick="RegisterProfileAsync">
                                <span>Register Applicant Profile</span>
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Published Merit Result Sheet Modal -->
    @if (viewingResult is not null)
    {
        var modalObjectionOpen = !viewingResult.IsFinal && viewingResult.ObjectionClosesAtUtc > DateTime.UtcNow;
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-3"
             role="dialog"
             aria-modal="true"
             aria-label="Published Merit Result Sheet"
             @onclick="CloseResultSheet">
            <div class="w-full max-w-4xl max-h-screen rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden flex flex-col"
                 style="max-height: calc(100vh - 2rem);"
                 @onclick:stopPropagation="true">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50/90 px-4 py-3 shrink-0">
                    <div class="min-w-0">
                        <h3 class="text-sm font-bold text-slate-900 truncate">
                            Published Merit Result Sheet — @(string.IsNullOrWhiteSpace(viewingResult.PositionName) ? viewingResult.VacancyReference : viewingResult.PositionName)
                        </h3>
                        <p class="text-[11px] text-slate-500 font-mono">
                            @viewingResult.VacancyReference · Published @viewingResult.PublishedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT · Objections close @viewingResult.ObjectionClosesAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT
                        </p>
                    </div>
                    <button type="button" class="je-btn-outline" @onclick="CloseResultSheet">Close</button>
                </div>

                <div class="p-4 overflow-y-auto space-y-4 text-xs">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Your Application</span>
                            <strong class="font-mono text-slate-900">@viewingResult.ApplicationReference</strong>
                            <span class="block text-[11px] text-slate-500 mt-0.5">Status: @viewingResult.ApplicationStatus</span>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Your Merit Rank &amp; Score</span>
                            <strong class="text-sm text-teal-700">@(viewingResult.MyRank.HasValue ? $"Rank #{viewingResult.MyRank} · {viewingResult.MyScore:0.##}" : "Not Ranked")</strong>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Publication Status</span>
                            <strong class="@(viewingResult.IsFinal ? "text-emerald-700" : "text-amber-700")">
                                @(viewingResult.IsFinal ? "Finalised" : modalObjectionOpen ? "Objection Period Open" : "Objection Period Closed")
                            </strong>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Published A2 Merit Ranking (@viewingResult.MeritSheet.Count)</h4>
                        <div class="overflow-x-auto rounded-xl border border-slate-200">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold uppercase tracking-wider text-slate-600">
                                    <tr>
                                        <th class="px-3 py-2">Rank</th>
                                        <th class="px-3 py-2">Application Reference</th>
                                        <th class="px-3 py-2 text-right">Total Score</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in viewingResult.MeritSheet)
                                    {
                                        <tr class="@(entry.IsMine ? "bg-blue-50/80 font-semibold" : "hover:bg-slate-50/70")">
                                            <td class="px-3 py-2 font-bold text-slate-900">#@entry.Rank</td>
                                            <td class="px-3 py-2 font-mono text-slate-800">
                                                @entry.ApplicationReference
                                                @if (entry.IsMine)
                                                {
                                                    <span class="ml-1.5 rounded-full bg-blue-600 px-2 py-0.5 text-[10px] font-sans font-semibold text-white">You</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 text-right font-mono tabular-nums text-slate-900">@entry.Score.ToString("0.##")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @if (viewingResult.MyScorecards.Count > 0)
                    {
                        <div class="space-y-2">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Your Assessment Score Breakdown</h4>
                            @foreach (var sc in viewingResult.MyScorecards)
                            {
                                var criteria = ParseCriteria(sc.CriterionScoresJson);
                                <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3 space-y-2">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="font-bold text-slate-800">@sc.AssessmentKind</span>
                                        <span class="font-mono font-bold text-teal-700 tabular-nums">Total: @sc.TotalScore.ToString("0.##")</span>
                                    </div>
                                    @if (criteria.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var kv in criteria)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2 py-1 text-[11px] text-slate-700">
                                                    <span class="font-medium">@kv.Key:</span>
                                                    <strong class="font-mono text-slate-900">@kv.Value</strong>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3.5 space-y-2.5">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Objection</h4>
                        @if (viewingResult.ObjectionId.HasValue)
                        {
                            <div class="space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="font-semibold text-slate-800">Submitted Objection</span>
                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(viewingResult.ObjectionStatus == "Upheld" ? "bg-emerald-100 text-emerald-800" : viewingResult.ObjectionStatus == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                        @viewingResult.ObjectionStatus
                                    </span>
                                </div>
                                <p class="whitespace-pre-wrap rounded-lg border border-slate-200 bg-white p-2.5 text-slate-700">@viewingResult.ObjectionGrounds</p>
                                @if (!string.IsNullOrWhiteSpace(viewingResult.ObjectionResolution))
                                {
                                    <div class="rounded-lg border border-teal-200 bg-teal-50/60 p-2.5 text-slate-800">
                                        <span class="block text-[10px] font-bold uppercase tracking-wider text-teal-800">Committee Resolution</span>
                                        <p class="whitespace-pre-wrap mt-0.5">@viewingResult.ObjectionResolution</p>
                                    </div>
                                }
                            </div>
                        }
                        else if (modalObjectionOpen)
                        {
                            <label class="block text-xs font-semibold text-slate-700">
                                Grounds for Objection *
                                <textarea rows="3"
                                          maxlength="4000"
                                          class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-teal-600 focus:outline-none"
                                          placeholder="After reviewing the result sheet above, explain the specific scoring or screening issue…"
                                          @bind="objectionGrounds"
                                          @bind:event="oninput"></textarea>
                            </label>
                            <div class="flex justify-end">
                                <button type="button"
                                        class="je-btn-primary"
                                        disabled="@(busy || string.IsNullOrWhiteSpace(objectionGrounds))"
                                        @onclick="() => SubmitModalObjectionAsync(viewingResult.PublicationId, viewingResult.ApplicationId)">
                                    <span>Submit Objection</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-slate-500">The objection period for this publication is closed.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Public Published Merit Result Sheet Modal (for unauthenticated visitors or non-applicants) -->
    @if (viewingPublicResult is not null)
    {
        var pubObjectionOpen = !viewingPublicResult.IsFinal && viewingPublicResult.ObjectionClosesAtUtc > DateTime.UtcNow;
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-3"
             role="dialog"
             aria-modal="true"
             aria-label="Published Merit Result Sheet"
             @onclick="() => viewingPublicResult = null">
            <div class="w-full max-w-3xl max-h-screen rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden flex flex-col"
                 style="max-height: calc(100vh - 2rem);"
                 @onclick:stopPropagation="true">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50/90 px-4 py-3 shrink-0">
                    <div class="min-w-0">
                        <h3 class="text-sm font-bold text-slate-900 truncate">
                            Published A2 Merit Sheet — @(string.IsNullOrWhiteSpace(viewingPublicResult.PositionName) ? viewingPublicResult.VacancyReference : viewingPublicResult.PositionName)
                        </h3>
                        <p class="text-[11px] text-slate-500 font-mono">
                            @viewingPublicResult.VacancyReference · Published @viewingPublicResult.PublishedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT · Objections close @viewingPublicResult.ObjectionClosesAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT
                        </p>
                    </div>
                    <button type="button" class="je-btn-outline" @onclick="() => viewingPublicResult = null">Close</button>
                </div>

                <div class="p-4 overflow-y-auto space-y-4 text-xs">
                    <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(viewingPublicResult.IsFinal ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                @(viewingPublicResult.IsFinal ? "Finalised" : pubObjectionOpen ? "Objection Period Open" : "Objection Period Closed")
                            </span>
                            <span class="text-slate-600">@viewingPublicResult.MeritSheet.Count ranked candidate(s)</span>
                        </div>
                        @if (!isAuthenticated && pubObjectionOpen)
                        {
                            <a href="@LoginUrl" class="je-btn-primary">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                                <span>Sign in with eFaas to Submit Objection</span>
                            </a>
                        }
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-200">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold uppercase tracking-wider text-slate-600">
                                <tr>
                                    <th class="px-3 py-2">Rank</th>
                                    <th class="px-3 py-2">Application Reference</th>
                                    <th class="px-3 py-2 text-right">Total Score</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var entry in viewingPublicResult.MeritSheet)
                                {
                                    <tr class="hover:bg-slate-50/70">
                                        <td class="px-3 py-2 font-bold text-slate-900">#@entry.Rank</td>
                                        <td class="px-3 py-2 font-mono text-slate-800">@entry.ApplicationReference</td>
                                        <td class="px-3 py-2 text-right font-mono tabular-nums text-slate-900">@entry.Score.ToString("0.##")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

