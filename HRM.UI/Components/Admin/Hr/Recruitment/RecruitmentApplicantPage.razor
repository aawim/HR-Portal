@page "/online/recruitment"
@page "/careers"
@page "/careers/{OfficeName}"
@page "/careers/{OfficeName}/{VacancyRef}"
@page "/vacancies"
@page "/{OfficeName}/vacancies"
@rendermode RenderMode.InteractiveServer
@using HRM.Application.Contracts.Recruitment
@inject HRM.UI.Services.Recruitment.IRecruitmentApiClient Api
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@(officeResponse is not null ? $"{officeResponse.OrganisationName} — Careers Portal" : "Careers & Recruitment Portal")</PageTitle>

<section class="careers-portal w-full min-w-0 p-2 flex flex-col gap-3 text-slate-900 dark:text-slate-100">
    <!-- Full-Width Compact Header (never shrinks) -->
    <header class="staff-overview-no-print bg-transparent flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">
                    @(officeResponse is not null ? officeResponse.OrganisationName : "Careers & Recruitment Portal")
                </h1>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    @(isAuthenticated ? "eFaas Verified Applicant" : "Public Careers Portal")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                @(officeResponse is not null
                    ? $"Browse open vacancies at {officeResponse.OrganisationName}, submit applications, view published merit results, and manage job offers."
                    : "Browse open government vacancies, submit applications, review published merit results, and respond to offers.")
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            @if (officeResponse is not null)
            {
                <a href="/careers" class="app-button app-button-secondary app-button-sm">
                    <i class="bi bi-grid text-xs" aria-hidden="true"></i>
                    <span>All Careers</span>
                </a>
            }
            @if (!isAuthenticated)
            {
                <a href="@LoginUrl" class="app-button app-button-primary app-button-sm">
                    <i class="bi bi-box-arrow-in-right text-xs" aria-hidden="true"></i>
                    <span>Sign in with eFaas</span>
                </a>
            }
            <button type="button"
                    class="app-button app-button-neutral app-button-sm"
                    title="@(isFullWidth ? "Shrink to standard layout" : "Expand to full page width")"
                    @onclick="ToggleWidthAsync">
                <AppIcon Name="@(isFullWidth ? "fullscreen_exit" : "fullscreen")" Class="text-xs" />
                <span>@(isFullWidth ? "Shrink View" : "Full Width")</span>
            </button>
            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    disabled="@busy"
                    @onclick="Load">
                <AppIcon Name="refresh" Class="@(busy ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
        </div>
    </header>

    <!-- Full-Width Careers Portal Navigation Menu (gives non-staff & public users a clear menu) -->
    @if (!officeNotFound)
    {
        <div class="org-workspace-tabs my-workspace-tabs w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
            <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Careers Portal Menu">
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(activeTab == "vacancies" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => activeTab = "vacancies"'>
                    <i class="bi bi-briefcase text-xs" aria-hidden="true"></i>
                    <span>Open Vacancies</span>
                    @if (publicVacancies.Count > 0)
                    {
                        <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(activeTab == "vacancies" ? "bg-white/25 text-white" : "bg-teal-100 text-teal-800")">@publicVacancies.Count</span>
                    }
                </button>

                @if (isAuthenticated)
                {
                    <button type="button"
                            class="rounded-t-xl px-4 py-2 font-bold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(activeTab == "applications" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                            @onclick='() => activeTab = "applications"'>
                        <i class="bi bi-file-earmark-text text-xs" aria-hidden="true"></i>
                        <span>My Applications</span>
                        <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(activeTab == "applications" ? "bg-white/25 text-white" : "bg-slate-200 text-slate-700")">@(workspace?.Applications.Count ?? 0)</span>
                    </button>

                    <button type="button"
                            class="rounded-t-xl px-4 py-2 font-bold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(activeTab == "results" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                            @onclick='() => activeTab = "results"'>
                        <i class="bi bi-trophy text-xs" aria-hidden="true"></i>
                        <span>Results &amp; Objections</span>
                        <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(activeTab == "results" ? "bg-white/25 text-white" : "bg-amber-100 text-amber-800")">@(workspace?.Results?.Count ?? 0)</span>
                    </button>

                    <button type="button"
                            class="rounded-t-xl px-4 py-2 font-bold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(activeTab == "offers" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                            @onclick='() => activeTab = "offers"'>
                        <i class="bi bi-envelope-check text-xs" aria-hidden="true"></i>
                        <span>My Offers</span>
                        <span class="rounded-full px-1.5 py-0.2 text-[10px] font-bold @(activeTab == "offers" ? "bg-white/25 text-white" : "bg-emerald-100 text-emerald-800")">@(workspace?.Offers.Count ?? 0)</span>
                    </button>

                    <button type="button"
                            class="rounded-t-xl px-4 py-2 font-bold text-xs transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(activeTab == "profile" ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                            @onclick='() => activeTab = "profile"'>
                        <i class="bi bi-person-vcard text-xs" aria-hidden="true"></i>
                        <span>My Applicant Profile</span>
                        @if (workspace is not null && !workspace.ApplicantId.HasValue)
                        {
                            <span class="rounded-full bg-amber-500 px-1.5 py-0.2 text-[10px] font-bold text-white">Setup</span>
                        }
                    </button>
                }
            </nav>
        </div>
    }

    <!-- Content Shell (shrinks in Shrink View; header & nav menu always remain full width) -->
    <div class="recruitment-online-shell @(isFullWidth ? "recruitment-online-shell-full" : "recruitment-online-shell-standard")">
        @if (officeNotFound)
        {
            <div role="alert" class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-xs text-amber-900 space-y-2.5">
                <p class="font-bold text-sm">Organisation not found for "@OfficeName"</p>
                <p>No active organisation matched this careers URL. You can browse all open government vacancies instead.</p>
                <a href="/careers" class="app-button app-button-primary app-button-sm">View All Open Vacancies</a>
            </div>
        }
        else
        {
            @if (message is not null)
            {
                <div role="status" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-2.5 text-xs text-slate-800 dark:text-slate-200 shadow-2xs">
                    <span>@message</span>
                    <button type="button" class="font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" @onclick="() => message = null">✕</button>
                </div>
            }

            <!-- Signed-in Applicant Summary Strip -->
            @if (isAuthenticated && workspace is not null)
            {
                <div class="rounded-2xl border border-teal-200/80 dark:border-teal-800 bg-white dark:bg-slate-900 px-4 py-3 shadow-xs flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="h-11 w-11 rounded-full bg-teal-100 dark:bg-teal-900/60 border border-teal-300 dark:border-teal-700 text-teal-800 dark:text-teal-200 font-bold text-sm flex items-center justify-center shrink-0">
                            @GetInitials(workspace.ProfileFullName)
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">
                                    @(string.IsNullOrWhiteSpace(workspace.ProfileFullName) ? "eFaas Applicant" : workspace.ProfileFullName)
                                </span>
                                <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(workspace.ApplicantId.HasValue ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                    @(workspace.ApplicantId.HasValue ? "Profile Registered" : "Profile Setup Required")
                                </span>
                            </div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                                @(string.IsNullOrWhiteSpace(workspace.ProfileEmail) ? "Signed in via eFaas" : workspace.ProfileEmail)
                                @(!string.IsNullOrWhiteSpace(workspace.ProfileMobile) ? $" · {workspace.ProfileMobile}" : "")
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (!workspace.ApplicantId.HasValue && activeTab != "profile")
                        {
                            <button type="button" class="app-button app-button-primary app-button-sm" @onclick='() => activeTab = "profile"'>
                                <i class="bi bi-person-plus text-xs" aria-hidden="true"></i>
                                <span>Complete Applicant Profile</span>
                            </button>
                        }
                        <a href="/Online/Auth/NoAccessLogout" class="app-button app-button-secondary app-button-sm">
                            <i class="bi bi-box-arrow-right text-xs" aria-hidden="true"></i>
                            <span>Sign Out</span>
                        </a>
                    </div>
                </div>
            }

            <!-- TAB 1: OPEN VACANCIES -->
            @if (activeTab == "vacancies")
            {
                @if (!isAuthenticated)
                {
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
                        <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center justify-between gap-2">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
                                Open Vacancies@(officeResponse is not null ? $" — {officeResponse.OrganisationName}" : "")
                            </h2>
                            <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@publicVacancies.Count</span>
                        </div>
                        <div class="p-4">
                            @if (publicVacancies.Count == 0)
                            {
                                <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-10 text-center text-xs text-slate-500">
                                    No open vacancies are currently published@(officeResponse is not null ? $" for {officeResponse.OrganisationName}" : "").
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    @foreach (var v in publicVacancies)
                                    {
                                        var isHighlighted = !string.IsNullOrWhiteSpace(VacancyRef) && string.Equals(v.Reference, VacancyRef, StringComparison.OrdinalIgnoreCase);
                                        <div class="rounded-xl border p-4 text-xs flex flex-col justify-between gap-3 @(isHighlighted ? "border-teal-500 bg-teal-50/40 ring-1 ring-teal-500/30" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40")">
                                            <div>
                                                <div class="flex items-start justify-between gap-2">
                                                    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@(string.IsNullOrWhiteSpace(v.PositionName) ? v.Reference : v.PositionName)</h3>
                                                    <span class="font-mono text-[10px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md shrink-0">@v.Reference</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(v.OrganisationName) && officeResponse is null)
                                                {
                                                    <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-1">@v.OrganisationName</p>
                                                }
                                                <p class="text-[11px] text-slate-500 mt-1.5">
                                                    <i class="bi bi-clock text-[10px] mr-1" aria-hidden="true"></i>
                                                    Closes: <strong>@v.ClosingAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT</strong>
                                                </p>
                                            </div>
                                            <div class="flex justify-end pt-2.5 border-t border-slate-200/70 dark:border-slate-800">
                                                <a href="@LoginUrlForVacancy(v)" class="app-button app-button-primary app-button-sm">
                                                    <i class="bi bi-box-arrow-in-right text-xs" aria-hidden="true"></i>
                                                    <span>Sign in with eFaas to Apply</span>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (workspace is not null)
                {
                    @if (!workspace.ApplicantId.HasValue)
                    {
                        <div class="rounded-xl border border-amber-300 bg-amber-50/80 px-4 py-3 text-xs text-amber-900 flex flex-wrap items-center justify-between gap-2">
                            <span><strong>One-time setup required:</strong> Complete your applicant contact details before submitting an application.</span>
                            <button type="button" class="app-button app-button-primary app-button-sm" @onclick='() => activeTab = "profile"'>
                                Go to Applicant Profile
                            </button>
                        </div>
                    }

                    <RecruitmentApplyPanel Registered="workspace.ApplicantId.HasValue"
                                           ShowProfileCard="false"
                                           InitialFullName="@workspace.ProfileFullName"
                                           InitialEmail="@workspace.ProfileEmail"
                                           InitialMobile="@workspace.ProfileMobile"
                                           OrganisationIdFilter="@officeResponse?.OrganisationId"
                                           OrganisationNameFilter="@officeResponse?.OrganisationName"
                                           InitialVacancyRef="@VacancyRef"
                                           Changed="Load" />
                }
            }

            <!-- TAB 2: MY APPLICATIONS -->
            @if (activeTab == "applications" && workspace is not null)
            {
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">My Applications</h2>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@workspace.Applications.Count</span>
                    </div>
                    <div class="p-4">
                        @if (workspace.Applications.Count == 0)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-8 text-center text-xs text-slate-500 space-y-2">
                                <p>No applications are linked to your signed-in eFaas identity yet.</p>
                                <button type="button" class="app-button app-button-primary app-button-sm" @onclick='() => activeTab = "vacancies"'>Browse Open Vacancies</button>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                <table class="w-full text-left text-xs">
                                    <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-[10px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">
                                        <tr>
                                            <th class="px-3 py-2.5">Application Ref</th>
                                            <th class="px-3 py-2.5">Vacancy Ref</th>
                                            <th class="px-3 py-2.5">Submitted (MVT)</th>
                                            <th class="px-3 py-2.5">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                        @foreach (var a in workspace.Applications)
                                        {
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40">
                                                <td class="px-3 py-2.5 font-mono font-semibold text-blue-700 dark:text-blue-400">@a.Reference</td>
                                                <td class="px-3 py-2.5 font-mono text-slate-700 dark:text-slate-300">@a.VacancyReference</td>
                                                <td class="px-3 py-2.5 text-slate-500">@(a.SubmittedAtUtc.HasValue ? a.SubmittedAtUtc.Value.AddHours(5).ToString("dd MMM yyyy HH:mm") : "Draft")</td>
                                                <td class="px-3 py-2.5">
                                                    <span class="rounded-full bg-blue-100 dark:bg-blue-950/60 px-2.5 py-0.5 text-[11px] font-semibold text-blue-800 dark:text-blue-300">@a.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- TAB 3: PUBLISHED MERIT RESULTS & OBJECTIONS -->
            @if (activeTab == "results" && workspace is not null)
            {
                var myResults = workspace.Results ?? [];
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Published Merit Results &amp; Objections</h2>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@myResults.Count</span>
                    </div>
                    <div class="p-4">
                        @if (myResults.Count == 0)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-8 text-center text-xs text-slate-500">
                                No published merit results are available for your applications yet.
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
                                @foreach (var r in myResults)
                                {
                                    var objectionOpen = !r.IsFinal && r.ObjectionClosesAtUtc > DateTime.UtcNow;
                                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/40 p-3.5 text-xs space-y-2.5">
                                        <div class="flex items-start justify-between gap-2 flex-wrap">
                                            <div class="min-w-0">
                                                <p class="font-bold text-slate-900 dark:text-slate-100">@(string.IsNullOrWhiteSpace(r.PositionName) ? r.VacancyReference : r.PositionName)</p>
                                                <p class="font-mono text-[11px] text-slate-500">@r.VacancyReference · App @r.ApplicationReference</p>
                                            </div>
                                            <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(r.IsFinal ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                                @(r.IsFinal ? "Finalised" : objectionOpen ? "Objection Period Open" : "Objection Period Closed")
                                            </span>
                                        </div>

                                        <div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2">
                                            <div>
                                                <span class="block text-[10px] uppercase tracking-wide text-slate-500">Merit Rank</span>
                                                <strong class="text-sm @(r.Rank.HasValue ? "text-blue-700" : "text-slate-600")">@(r.Rank.HasValue ? $"#{r.Rank}" : "Not Ranked")</strong>
                                            </div>
                                            <div class="h-6 w-px bg-slate-200 dark:bg-slate-700"></div>
                                            <div>
                                                <span class="block text-[10px] uppercase tracking-wide text-slate-500">Total Score</span>
                                                <strong class="text-sm text-slate-900 dark:text-slate-100 tabular-nums">@(r.Score.HasValue ? r.Score.Value.ToString("0.##") : r.ApplicationStatus)</strong>
                                            </div>
                                            <div class="h-6 w-px bg-slate-200 dark:bg-slate-700"></div>
                                            <div>
                                                <span class="block text-[10px] uppercase tracking-wide text-slate-500">Objections Close</span>
                                                <span class="font-semibold text-slate-700 dark:text-slate-300">@r.ObjectionClosesAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT</span>
                                            </div>
                                        </div>

                                        <div class="flex flex-wrap items-center gap-2">
                                            <button type="button"
                                                    class="app-button app-button-primary app-button-sm"
                                                    disabled="@(busy || loadingResultDetail)"
                                                    @onclick="() => ViewResultSheetAsync(r.PublicationId, r.ApplicationId)">
                                                <i class="bi bi-file-earmark-bar-graph text-xs" aria-hidden="true"></i>
                                                <span>View Result Sheet</span>
                                            </button>
                                            @if (!r.ObjectionId.HasValue && objectionOpen && !(objectingPublicationId == r.PublicationId && objectingApplicationId == r.ApplicationId))
                                            {
                                                <button type="button"
                                                        class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-900 hover:bg-amber-100 disabled:opacity-50 transition-colors"
                                                        disabled="@busy"
                                                        @onclick="() => StartObjection(r.PublicationId, r.ApplicationId)">
                                                    Submit Objection
                                                </button>
                                            }
                                        </div>

                                        @if (r.ObjectionId.HasValue)
                                        {
                                            <div class="rounded-lg border border-amber-200 bg-amber-50/60 p-2.5 space-y-1.5">
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="font-semibold text-slate-800">Your Objection</span>
                                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(r.ObjectionStatus == "Upheld" ? "bg-emerald-100 text-emerald-800" : r.ObjectionStatus == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                                        @r.ObjectionStatus
                                                    </span>
                                                </div>
                                                <p class="whitespace-pre-wrap text-slate-700">@r.ObjectionGrounds</p>
                                                @if (!string.IsNullOrWhiteSpace(r.ObjectionResolution))
                                                {
                                                    <div class="rounded border border-slate-200 bg-white p-2 text-slate-700">
                                                        <span class="block text-[10px] font-bold uppercase tracking-wide text-slate-500">Committee Resolution</span>
                                                        <p class="whitespace-pre-wrap mt-0.5">@r.ObjectionResolution</p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (objectionOpen && objectingPublicationId == r.PublicationId && objectingApplicationId == r.ApplicationId)
                                        {
                                            <div class="rounded-lg border border-blue-200 bg-blue-50/50 p-2.5 space-y-2">
                                                <label class="block text-xs font-semibold text-slate-700">
                                                    Grounds for Objection *
                                                    <textarea rows="3"
                                                              maxlength="4000"
                                                              class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"
                                                              placeholder="Explain the specific scoring or screening issue you are objecting to…"
                                                              @bind="objectionGrounds"
                                                              @bind:event="oninput"></textarea>
                                                </label>
                                                <div class="flex items-center justify-end gap-2">
                                                    <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="CancelObjection">Cancel</button>
                                                    <button type="button" class="app-button app-button-primary app-button-sm" disabled="@(busy || string.IsNullOrWhiteSpace(objectionGrounds))" @onclick="SubmitObjectionAsync">Submit Objection</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- TAB 4: MY OFFERS -->
            @if (activeTab == "offers" && workspace is not null)
            {
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">My Offers</h2>
                        <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@workspace.Offers.Count</span>
                    </div>
                    <div class="p-4">
                        @if (workspace.Offers.Count == 0)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-8 text-center text-xs text-slate-500">
                                You have no job offers at this time.
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
                                @foreach (var o in workspace.Offers)
                                {
                                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-950/40 p-3.5 text-xs space-y-2.5">
                                        <div class="flex items-center justify-between">
                                            <span class="font-mono font-semibold text-slate-900 dark:text-slate-100">@o.VacancyReference</span>
                                            <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(o.Status == "Accepted" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">@o.Status</span>
                                        </div>
                                        <p class="whitespace-pre-wrap rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2.5 text-slate-700 dark:text-slate-300">@Terms(o.TermsSnapshotJson)</p>
                                        @if (o.Status == "Offered")
                                        {
                                            @if (confirmation == o.Id)
                                            {
                                                <div class="rounded-lg border border-blue-200 bg-blue-50 p-2.5 space-y-2">
                                                    <p class="font-medium text-blue-900">Confirm that you have reviewed and accept these offer terms.</p>
                                                    <div class="flex gap-2">
                                                        <button type="button" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50" disabled="@busy" @onclick="() => Accept(o.Id)">Confirm Acceptance</button>
                                                        <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="() => confirmation = 0">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="() => confirmation = o.Id">Review Acceptance</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- TAB 5: MY APPLICANT PROFILE -->
            @if (activeTab == "profile" && workspace is not null)
            {
                <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden max-w-3xl">
                    <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center justify-between gap-2">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">My Applicant Profile</h2>
                        <span class="rounded-full px-2.5 py-0.5 text-[10px] font-semibold @(workspace.ApplicantId.HasValue ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                            @(workspace.ApplicantId.HasValue ? "Registered" : "Not Registered Yet")
                        </span>
                    </div>
                    <div class="p-4 space-y-4 text-xs">
                        @if (workspace.ApplicantId.HasValue)
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/40 p-3">
                                    <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Full Name (eFaas Verified)</span>
                                    <strong class="text-sm text-slate-900 dark:text-slate-100">@(workspace.ProfileFullName ?? "—")</strong>
                                </div>
                                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/40 p-3">
                                    <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Applicant Profile ID</span>
                                    <strong class="font-mono text-sm text-slate-900 dark:text-slate-100">#@workspace.ApplicantId</strong>
                                </div>
                                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/40 p-3">
                                    <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Email</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(workspace.ProfileEmail) ? "—" : workspace.ProfileEmail)</span>
                                </div>
                                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/40 p-3">
                                    <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Mobile</span>
                                    <span class="font-semibold text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(workspace.ProfileMobile) ? "—" : workspace.ProfileMobile)</span>
                                </div>
                            </div>
                            <div class="flex justify-end">
                                <button type="button" class="app-button app-button-primary app-button-sm" @onclick='() => activeTab = "vacancies"'>
                                    Browse Open Vacancies
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-slate-600 dark:text-slate-400">
                                Your full name is verified directly from your eFaas identity. Confirm your email and mobile number once to activate your applicant profile.
                            </p>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                    Full Name <span class="text-[10px] text-slate-400">(eFaas verified)</span>
                                    <input class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600 cursor-not-allowed"
                                           value="@regName"
                                           disabled="@(!string.IsNullOrWhiteSpace(workspace.ProfileFullName))"
                                           readonly="@(!string.IsNullOrWhiteSpace(workspace.ProfileFullName))" />
                                </label>
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                    Email *
                                    <input type="email"
                                           maxlength="320"
                                           class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none"
                                           @bind="regEmail"
                                           @bind:event="oninput" />
                                </label>
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                    Mobile
                                    <input type="tel"
                                           maxlength="40"
                                           class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none"
                                           @bind="regMobile"
                                           @bind:event="oninput" />
                                </label>
                            </div>
                            <div class="flex justify-end">
                                <button type="button"
                                        class="app-button app-button-primary app-button-sm"
                                        disabled="@(busy || string.IsNullOrWhiteSpace(regName) || string.IsNullOrWhiteSpace(regEmail))"
                                        @onclick="RegisterProfileAsync">
                                    <span>Register Applicant Profile</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Published Merit Result Sheet Modal -->
    @if (viewingResult is not null)
    {
        var modalObjectionOpen = !viewingResult.IsFinal && viewingResult.ObjectionClosesAtUtc > DateTime.UtcNow;
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-3"
             role="dialog"
             aria-modal="true"
             aria-label="Published Merit Result Sheet"
             @onclick="CloseResultSheet">
            <div class="w-full max-w-4xl max-h-screen rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden flex flex-col"
                 style="max-height: calc(100vh - 2rem);"
                 @onclick:stopPropagation="true">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50/90 px-4 py-3 shrink-0">
                    <div class="min-w-0">
                        <h3 class="text-sm font-bold text-slate-900 truncate">
                            Published Merit Result Sheet — @(string.IsNullOrWhiteSpace(viewingResult.PositionName) ? viewingResult.VacancyReference : viewingResult.PositionName)
                        </h3>
                        <p class="text-[11px] text-slate-500 font-mono">
                            @viewingResult.VacancyReference · Published @viewingResult.PublishedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT · Objections close @viewingResult.ObjectionClosesAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm") MVT
                        </p>
                    </div>
                    <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="CloseResultSheet">Close</button>
                </div>

                <div class="p-4 overflow-y-auto space-y-4 text-xs">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Your Application</span>
                            <strong class="font-mono text-slate-900">@viewingResult.ApplicationReference</strong>
                            <span class="block text-[11px] text-slate-500 mt-0.5">Status: @viewingResult.ApplicationStatus</span>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Your Merit Rank &amp; Score</span>
                            <strong class="text-sm text-blue-700">@(viewingResult.MyRank.HasValue ? $"Rank #{viewingResult.MyRank} · {viewingResult.MyScore:0.##}" : "Not Ranked")</strong>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Publication Status</span>
                            <strong class="@(viewingResult.IsFinal ? "text-emerald-700" : "text-amber-700")">
                                @(viewingResult.IsFinal ? "Finalised" : modalObjectionOpen ? "Objection Period Open" : "Objection Period Closed")
                            </strong>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Published A2 Merit Ranking (@viewingResult.MeritSheet.Count)</h4>
                        <div class="overflow-x-auto rounded-xl border border-slate-200">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold uppercase tracking-wider text-slate-600">
                                    <tr>
                                        <th class="px-3 py-2">Rank</th>
                                        <th class="px-3 py-2">Application Reference</th>
                                        <th class="px-3 py-2 text-right">Total Score</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in viewingResult.MeritSheet)
                                    {
                                        <tr class="@(entry.IsMine ? "bg-blue-50/80 font-semibold" : "hover:bg-slate-50/70")">
                                            <td class="px-3 py-2 font-bold text-slate-900">#@entry.Rank</td>
                                            <td class="px-3 py-2 font-mono text-slate-800">
                                                @entry.ApplicationReference
                                                @if (entry.IsMine)
                                                {
                                                    <span class="ml-1.5 rounded-full bg-blue-600 px-2 py-0.5 text-[10px] font-sans font-semibold text-white">You</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 text-right font-mono tabular-nums text-slate-900">@entry.Score.ToString("0.##")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @if (viewingResult.MyScorecards.Count > 0)
                    {
                        <div class="space-y-2">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Your Assessment Score Breakdown</h4>
                            @foreach (var sc in viewingResult.MyScorecards)
                            {
                                var criteria = ParseCriteria(sc.CriterionScoresJson);
                                <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3 space-y-2">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="font-bold text-slate-800">@sc.AssessmentKind</span>
                                        <span class="font-mono font-bold text-blue-700 tabular-nums">Total: @sc.TotalScore.ToString("0.##")</span>
                                    </div>
                                    @if (criteria.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var kv in criteria)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2 py-1 text-[11px] text-slate-700">
                                                    <span class="font-medium">@kv.Key:</span>
                                                    <strong class="font-mono text-slate-900">@kv.Value</strong>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3.5 space-y-2.5">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Objection</h4>
                        @if (viewingResult.ObjectionId.HasValue)
                        {
                            <div class="space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="font-semibold text-slate-800">Submitted Objection</span>
                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(viewingResult.ObjectionStatus == "Upheld" ? "bg-emerald-100 text-emerald-800" : viewingResult.ObjectionStatus == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                        @viewingResult.ObjectionStatus
                                    </span>
                                </div>
                                <p class="whitespace-pre-wrap rounded-lg border border-slate-200 bg-white p-2.5 text-slate-700">@viewingResult.ObjectionGrounds</p>
                                @if (!string.IsNullOrWhiteSpace(viewingResult.ObjectionResolution))
                                {
                                    <div class="rounded-lg border border-blue-200 bg-blue-50/60 p-2.5 text-slate-800">
                                        <span class="block text-[10px] font-bold uppercase tracking-wider text-blue-800">Committee Resolution</span>
                                        <p class="whitespace-pre-wrap mt-0.5">@viewingResult.ObjectionResolution</p>
                                    </div>
                                }
                            </div>
                        }
                        else if (modalObjectionOpen)
                        {
                            <label class="block text-xs font-semibold text-slate-700">
                                Grounds for Objection *
                                <textarea rows="3"
                                          maxlength="4000"
                                          class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"
                                          placeholder="After reviewing the result sheet above, explain the specific scoring or screening issue…"
                                          @bind="objectionGrounds"
                                          @bind:event="oninput"></textarea>
                            </label>
                            <div class="flex justify-end">
                                <button type="button"
                                        class="app-button app-button-primary app-button-sm"
                                        disabled="@(busy || string.IsNullOrWhiteSpace(objectionGrounds))"
                                        @onclick="() => SubmitModalObjectionAsync(viewingResult.PublicationId, viewingResult.ApplicationId)">
                                    <span>Submit Objection</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-slate-500">The objection period for this publication is closed.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<style>
    .recruitment-online-shell {
        width: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: max-width 200ms ease;
    }

    .recruitment-online-shell-standard {
        max-width: 80rem;
        margin-left: auto;
        margin-right: auto;
    }

    .recruitment-online-shell-full {
        max-width: none;
    }
</style>

@code {
    [Parameter] public string? OfficeName { get; set; }
    [Parameter] public string? VacancyRef { get; set; }

    private MyRecruitmentWorkspace? workspace;
    private MyPublishedResultDetail? viewingResult;
    private OfficeVacanciesResponse? officeResponse;
    private IReadOnlyList<PublishedRecruitmentVacancyRow> publicVacancies = [];
    private bool busy, isFullWidth, loadingResultDetail, isAuthenticated, officeNotFound;
    private string activeTab = "vacancies";
    private string? message;
    private string? loadedOfficeName;
    private int confirmation;
    private int objectingPublicationId;
    private int objectingApplicationId;
    private string objectionGrounds = "";
    private string regName = "", regEmail = "", regMobile = "";

    private string LoginUrl
    {
        get
        {
            var rel = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
            return $"/Online/Auth/login?returnUrl={Uri.EscapeDataString(rel)}";
        }
    }

    private string LoginUrlForVacancy(PublishedRecruitmentVacancyRow v)
    {
        var slug = officeResponse?.OfficeSlug;
        var target = !string.IsNullOrWhiteSpace(slug)
            ? $"/careers/{slug}/{Uri.EscapeDataString(v.Reference)}"
            : "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        return $"/Online/Auth/login?returnUrl={Uri.EscapeDataString(target)}";
    }

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        if (loadedOfficeName != OfficeName || (workspace is null && publicVacancies.Count == 0 && !officeNotFound))
        {
            loadedOfficeName = OfficeName;
            await Load();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isFullWidth = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.my-recruitment.full-width") == "true";
            StateHasChanged();
        }
    }

    private async Task ToggleWidthAsync()
    {
        isFullWidth = !isFullWidth;
        await JS.InvokeVoidAsync("localStorage.setItem", "hrm.my-recruitment.full-width", isFullWidth ? "true" : "false");
    }

    private async Task Load()
    {
        busy = true;
        officeNotFound = false;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = auth.User.Identity?.IsAuthenticated == true;

            if (!string.IsNullOrWhiteSpace(OfficeName))
            {
                officeResponse = await Api.GetOfficeVacanciesAsync(OfficeName);
                if (officeResponse is null)
                {
                    officeNotFound = true;
                    publicVacancies = [];
                    workspace = null;
                    return;
                }
                publicVacancies = officeResponse.Vacancies;
            }
            else
            {
                officeResponse = null;
                publicVacancies = await Api.BrowsePublicVacanciesAsync();
            }

            if (isAuthenticated)
            {
                workspace = await Api.GetMyWorkspaceAsync();
                if (!string.IsNullOrWhiteSpace(workspace.ProfileFullName)) regName = workspace.ProfileFullName.Trim();
                if (string.IsNullOrWhiteSpace(regEmail) && !string.IsNullOrWhiteSpace(workspace.ProfileEmail)) regEmail = workspace.ProfileEmail.Trim();
                if (string.IsNullOrWhiteSpace(regMobile) && !string.IsNullOrWhiteSpace(workspace.ProfileMobile)) regMobile = workspace.ProfileMobile.Trim();
            }
            else
            {
                workspace = null;
                activeTab = "vacancies";
            }
        }
        catch (HttpRequestException ex)
        {
            workspace = null;
            message = ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden
                ? "Sign in through eFaas to view your applications and offers."
                : "Vacancies could not be loaded. Try again shortly.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RegisterProfileAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(regName) || string.IsNullOrWhiteSpace(regEmail)) return;
        busy = true;
        try
        {
            var result = await Api.RegisterApplicantAsync(new(regName.Trim(), regEmail.Trim(), string.IsNullOrWhiteSpace(regMobile) ? null : regMobile.Trim()));
            message = result.Message;
            if (result.Success)
            {
                await Load();
                activeTab = "vacancies";
            }
        }
        catch (HttpRequestException)
        {
            message = "Applicant registration failed. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private void StartObjection(int publicationId, int applicationId)
    {
        objectingPublicationId = publicationId;
        objectingApplicationId = applicationId;
        objectionGrounds = "";
    }

    private void CancelObjection()
    {
        objectingPublicationId = 0;
        objectingApplicationId = 0;
        objectionGrounds = "";
    }

    private async Task ViewResultSheetAsync(int publicationId, int applicationId)
    {
        loadingResultDetail = true;
        objectionGrounds = "";
        try
        {
            viewingResult = await Api.GetMyPublishedResultAsync(publicationId, applicationId);
            if (viewingResult is null)
            {
                message = "Published result sheet could not be found for this application.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Published result sheet could not be loaded. Try again shortly.";
        }
        finally
        {
            loadingResultDetail = false;
        }
    }

    private void CloseResultSheet()
    {
        viewingResult = null;
        objectionGrounds = "";
    }

    private async Task SubmitModalObjectionAsync(int publicationId, int applicationId)
    {
        objectingPublicationId = publicationId;
        objectingApplicationId = applicationId;
        await SubmitObjectionAsync();
        if (viewingResult is not null)
        {
            viewingResult = await Api.GetMyPublishedResultAsync(publicationId, applicationId);
        }
    }

    private async Task SubmitObjectionAsync()
    {
        if (busy || objectingPublicationId <= 0 || objectingApplicationId <= 0 || string.IsNullOrWhiteSpace(objectionGrounds)) return;
        busy = true;
        try
        {
            var result = await Api.SubmitMyObjectionAsync(new(objectingPublicationId, objectingApplicationId, objectionGrounds.Trim()));
            message = result.Message;
            if (result.Success)
            {
                CancelObjection();
                await Load();
            }
        }
        catch (HttpRequestException)
        {
            message = "Objection could not be submitted. Verify that the objection period is still open.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Accept(int id)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await Api.AcceptMyOfferAsync(id);
            message = result.Message;
            if (result.Success)
            {
                confirmation = 0;
                await Load();
            }
        }
        catch (HttpRequestException)
        {
            message = "Offer acceptance failed. Refresh and check the offer status.";
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "EF";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private static List<KeyValuePair<string, string>> ParseCriteria(string json)
    {
        var list = new List<KeyValuePair<string, string>>();
        if (string.IsNullOrWhiteSpace(json)) return list;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var prop in doc.RootElement.EnumerateObject())
                {
                    list.Add(new KeyValuePair<string, string>(prop.Name, prop.Value.ToString()));
                }
            }
        }
        catch { }
        return list;
    }

    private static string Terms(string json)
    {
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(json);
            return d.RootElement.TryGetProperty("Terms", out var t) ? t.GetString() ?? "" : "Contact the recruitment office for your offer terms.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "Contact the recruitment office for your offer terms.";
        }
    }
}
