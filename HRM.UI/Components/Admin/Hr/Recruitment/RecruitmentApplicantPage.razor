@code {
    [Parameter] public string? OfficeName { get; set; }
    [Parameter] public string? VacancyRef { get; set; }

    private MyRecruitmentWorkspace? workspace;
    private MyPublishedResultDetail? viewingResult;
    private PublicMeritSheetResponse? viewingPublicResult;
    private OfficeVacanciesResponse? officeResponse;
    private IReadOnlyList<PublishedRecruitmentVacancyRow> publicVacancies = [];
    private bool busy, loadingResultDetail, isAuthenticated, officeNotFound;
    private string activeTab = "vacancies";
    private string? applyingVacancyRef;
    private string searchKeyword = "";
    private string selectedOfficeFilter = "";
    private string selectedEmploymentType = "";
    private string sortOrder = "closing";
    private string? message;
    private string? loadedOfficeName;
    private int confirmation;
    private int objectingPublicationId;
    private int objectingApplicationId;
    private string objectionGrounds = "";
    private string regName = "", regEmail = "", regMobile = "";

    private IReadOnlyList<string> DistinctOffices =>
        publicVacancies
            .Select(v => v.OrganisationName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Select(n => n!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n)
            .ToList();

    private IReadOnlyList<string> DistinctEmploymentTypes =>
        publicVacancies
            .Select(v => v.EmploymentType)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Select(t => t!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t)
            .ToList();

    private IReadOnlyList<PublishedRecruitmentVacancyRow> FilteredVacancies
    {
        get
        {
            var q = publicVacancies.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(selectedOfficeFilter))
                q = q.Where(v => string.Equals(v.OrganisationName, selectedOfficeFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(selectedEmploymentType))
                q = q.Where(v => string.Equals(v.EmploymentType, selectedEmploymentType, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(searchKeyword))
            {
                var term = searchKeyword.Trim();
                q = q.Where(v =>
                    (v.PositionName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || v.Reference.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (v.EmploymentType?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || (v.OrganisationName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true));
            }
            var now = DateTime.UtcNow;
            return sortOrder == "title"
                ? q.OrderBy(v => v.ClosingAtUtc <= now).ThenBy(v => string.IsNullOrWhiteSpace(v.PositionName) ? v.Reference : v.PositionName).ToList()
                : q.OrderBy(v => v.ClosingAtUtc <= now).ThenBy(v => v.ClosingAtUtc).ToList();
        }
    }

    private async Task ViewVacancyResultAsync(PublishedRecruitmentVacancyRow v)
    {
        if (!v.PublicationId.HasValue) return;
        if (isAuthenticated && workspace?.Results is { Count: > 0 })
        {
            var myResult = workspace.Results.FirstOrDefault(r => r.PublicationId == v.PublicationId.Value);
            if (myResult is not null)
            {
                await ViewResultSheetAsync(myResult.PublicationId, myResult.ApplicationId);
                return;
            }
        }
        loadingResultDetail = true;
        try
        {
            viewingPublicResult = await Api.GetPublicMeritSheetAsync(v.PublicationId.Value);
            if (viewingPublicResult is null)
                message = "Published merit sheet could not be found.";
        }
        catch (HttpRequestException)
        {
            message = "Published merit sheet could not be loaded.";
        }
        finally
        {
            loadingResultDetail = false;
        }
    }

    private string LoginUrl
    {
        get
        {
            var rel = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
            return $"/Online/Auth/login?returnUrl={Uri.EscapeDataString(rel)}";
        }
    }

    private string LoginUrlForVacancy(PublishedRecruitmentVacancyRow v)
    {
        var slug = officeResponse?.OfficeSlug;
        var target = !string.IsNullOrWhiteSpace(slug)
            ? $"/careers/{slug}/{Uri.EscapeDataString(v.Reference)}"
            : "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        return $"/Online/Auth/login?returnUrl={Uri.EscapeDataString(target)}";
    }

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        if (!string.IsNullOrWhiteSpace(VacancyRef) && isAuthenticated && string.IsNullOrWhiteSpace(applyingVacancyRef))
        {
            applyingVacancyRef = VacancyRef;
            activeTab = "vacancies";
        }
        if (loadedOfficeName != OfficeName || (workspace is null && publicVacancies.Count == 0 && !officeNotFound))
        {
            loadedOfficeName = OfficeName;
            await Load();
        }
    }

    private void OpenTab(string tab)
    {
        activeTab = tab;
        if (tab != "vacancies") applyingVacancyRef = null;
    }

    private void BeginApply(string reference)
    {
        activeTab = "vacancies";
        applyingVacancyRef = reference;
    }

    private void BackToListings()
    {
        applyingVacancyRef = null;
    }

    private async Task Load()
    {
        busy = true;
        officeNotFound = false;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = auth.User.Identity?.IsAuthenticated == true;

            if (!string.IsNullOrWhiteSpace(OfficeName))
            {
                officeResponse = await Api.GetOfficeVacanciesAsync(OfficeName);
                if (officeResponse is null)
                {
                    officeNotFound = true;
                    publicVacancies = [];
                    workspace = null;
                    return;
                }
                publicVacancies = officeResponse.Vacancies;
            }
            else
            {
                officeResponse = null;
                publicVacancies = await Api.BrowsePublicVacanciesAsync();
            }

            if (isAuthenticated)
            {
                workspace = await Api.GetMyWorkspaceAsync();
                if (!string.IsNullOrWhiteSpace(workspace.ProfileFullName)) regName = workspace.ProfileFullName.Trim();
                if (string.IsNullOrWhiteSpace(regEmail) && !string.IsNullOrWhiteSpace(workspace.ProfileEmail)) regEmail = workspace.ProfileEmail.Trim();
                if (string.IsNullOrWhiteSpace(regMobile) && !string.IsNullOrWhiteSpace(workspace.ProfileMobile)) regMobile = workspace.ProfileMobile.Trim();
            }
            else
            {
                workspace = null;
                activeTab = "vacancies";
                applyingVacancyRef = null;
            }
        }
        catch (HttpRequestException ex)
        {
            workspace = null;
            message = ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden
                ? "Sign in through eFaas to view your applications and offers."
                : "Vacancies could not be loaded. Try again shortly.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RegisterProfileAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(regName) || string.IsNullOrWhiteSpace(regEmail)) return;
        busy = true;
        try
        {
            var result = await Api.RegisterApplicantAsync(new(regName.Trim(), regEmail.Trim(), string.IsNullOrWhiteSpace(regMobile) ? null : regMobile.Trim()));
            message = result.Message;
            if (result.Success)
            {
                await Load();
                activeTab = "vacancies";
            }
        }
        catch (HttpRequestException)
        {
            message = "Applicant registration failed. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private void StartObjection(int publicationId, int applicationId)
    {
        objectingPublicationId = publicationId;
        objectingApplicationId = applicationId;
        objectionGrounds = "";
    }

    private void CancelObjection()
    {
        objectingPublicationId = 0;
        objectingApplicationId = 0;
        objectionGrounds = "";
    }

    private async Task ViewResultSheetAsync(int publicationId, int applicationId)
    {
        loadingResultDetail = true;
        objectionGrounds = "";
        try
        {
            viewingResult = await Api.GetMyPublishedResultAsync(publicationId, applicationId);
            if (viewingResult is null)
            {
                message = "Published result sheet could not be found for this application.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Published result sheet could not be loaded. Try again shortly.";
        }
        finally
        {
            loadingResultDetail = false;
        }
    }

    private void CloseResultSheet()
    {
        viewingResult = null;
        objectionGrounds = "";
    }

    private async Task SubmitModalObjectionAsync(int publicationId, int applicationId)
    {
        objectingPublicationId = publicationId;
        objectingApplicationId = applicationId;
        await SubmitObjectionAsync();
        if (viewingResult is not null)
        {
            viewingResult = await Api.GetMyPublishedResultAsync(publicationId, applicationId);
        }
    }

    private async Task SubmitObjectionAsync()
    {
        if (busy || objectingPublicationId <= 0 || objectingApplicationId <= 0 || string.IsNullOrWhiteSpace(objectionGrounds)) return;
        busy = true;
        try
        {
            var result = await Api.SubmitMyObjectionAsync(new(objectingPublicationId, objectingApplicationId, objectionGrounds.Trim()));
            message = result.Message;
            if (result.Success)
            {
                CancelObjection();
                await Load();
            }
        }
        catch (HttpRequestException)
        {
            message = "Objection could not be submitted. Verify that the objection period is still open.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Accept(int id)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await Api.AcceptMyOfferAsync(id);
            message = result.Message;
            if (result.Success)
            {
                confirmation = 0;
                await Load();
            }
        }
        catch (HttpRequestException)
        {
            message = "Offer acceptance failed. Refresh and check the offer status.";
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "EF";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private static List<KeyValuePair<string, string>> ParseCriteria(string json)
    {
        var list = new List<KeyValuePair<string, string>>();
        if (string.IsNullOrWhiteSpace(json)) return list;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var prop in doc.RootElement.EnumerateObject())
                {
                    list.Add(new KeyValuePair<string, string>(prop.Name, prop.Value.ToString()));
                }
            }
        }
        catch { }
        return list;
    }

    private static string Terms(string json)
    {
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(json);
            return d.RootElement.TryGetProperty("Terms", out var t) ? t.GetString() ?? "" : "Contact the recruitment office for your offer terms.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "Contact the recruitment office for your offer terms.";
        }
    }
}
