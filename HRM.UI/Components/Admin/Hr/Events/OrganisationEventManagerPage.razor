@page "/admin/hr/events"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode RenderMode.InteractiveServer
@using HRM.DTOs.Calendar
@inject HRM.Services.Calendar.Contracts.OrganisationEventServiceContracts.IOperations Events
@inject HRM.Services.ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Organisation Event Manager - HR Portal</PageTitle>

<div class="mx-auto min-w-7xl max-w-full p-2 flex flex-col gap-2">
<section class="organisation-events w-full min-w-0 p-2 space-y-4">
    <header class="sticky top-0 z-30 m-0 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white/95 px-3 py-3 shadow-xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900/95">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">Organisation Event Manager</h1>
                <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-800">@events.Count events</span>
            </div>
            <p class="mt-0.5 text-xs text-slate-500">Create, publish and cancel organisation events. Only events with a calendar impact change working days.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="ToggleFullWidth" title="@(isFullWidth ? "Shrink to standard layout" : "Expand to full page width")">
                @(isFullWidth ? "⤡ Shrink View" : "⤢ Full Width")
            </button>
            <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="LoadAsync" aria-label="Refresh" title="Refresh">↻ Refresh</button>
            <button type="button" class="app-button app-button-primary app-button-sm" @onclick="NewEvent">+ New Event</button>
        </div>
    </header>

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">
            <span>@error</span>
            <button type="button" class="font-bold" aria-label="Dismiss" @onclick="() => error = null">✕</button>
        </div>
    }

    <div class="mx-auto grid w-full min-w-0 grid-cols-1 items-start gap-4 lg:grid-cols-12 @(isFullWidth ? "" : "max-w-7xl")">
        <!-- LEFT: filters + list -->
        <div class="@(editing == null && detail == null ? "lg:col-span-12" : "lg:col-span-7") min-w-0 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <div class="grid grid-cols-2 gap-2 md:grid-cols-6">
                <div><label class="block p-1 text-xs font-medium text-slate-700">From</label>
                    <input type="date" class="@Input" @bind="from" @bind:after="LoadAsync" /></div>
                <div><label class="block p-1 text-xs font-medium text-slate-700">To</label>
                    <input type="date" class="@Input" @bind="to" @bind:after="LoadAsync" /></div>
                <div><label class="block p-1 text-xs font-medium text-slate-700">Category</label>
                    <select class="@Input" @bind="category" @bind:after="LoadAsync"><option value="">All</option>@foreach (var c in Categories) {<option value="@c">@Pretty(c)</option>}</select></div>
                <div><label class="block p-1 text-xs font-medium text-slate-700">Status</label>
                    <select class="@Input" @bind="status" @bind:after="LoadAsync"><option value="">All</option>@foreach (var s in Statuses) {<option value="@s">@Pretty(s)</option>}</select></div>
                <div><label class="block p-1 text-xs font-medium text-slate-700">Calendar impact</label>
                    <select class="@Input" @bind="impact" @bind:after="LoadAsync"><option value="">All</option>@foreach (var i in Impacts) {<option value="@i">@Pretty(i)</option>}</select></div>
                <div><label class="block p-1 text-xs font-medium text-slate-700">When</label>
                    <select class="@Input" @bind="upcoming" @bind:after="LoadAsync"><option value="">All</option><option value="true">Upcoming</option></select></div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="border-b border-slate-200 text-slate-500">
                        <tr><th class="p-2">Event</th><th class="p-2">Category</th><th class="p-2">Date &amp; time</th><th class="p-2">Venue</th><th class="p-2">Audience</th><th class="p-2">Calendar impact</th><th class="p-2">Status</th><th class="p-2">Actions</th></tr>
                    </thead>
                    <tbody>
                    @if (busy) { <tr><td colspan="8" class="p-4 text-slate-500">Loading…</td></tr> }
                    else if (events.Count == 0) { <tr><td colspan="8" class="p-4 text-slate-500">No events match the filters.</td></tr> }
                    else foreach (var e in events)
                    {
                        <tr class="border-b border-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                            <td class="p-2 font-semibold text-slate-900 dark:text-slate-100">@e.Title</td>
                            <td class="p-2">@Pretty(e.Category)</td>
                            <td class="p-2 whitespace-nowrap">@e.StartDateTime.ToString("dd MMM yyyy")@(e.IsAllDay ? " (all day)" : " " + e.StartDateTime.ToString("HH:mm") + "–" + e.EndDateTime.ToString("HH:mm"))</td>
                            <td class="p-2">@(e.VenueName ?? "—")</td>
                            <td class="p-2">@e.AudienceSummary</td>
                            <td class="p-2">@(e.CalendarImpactType == "None" ? "Informational" : "⚑ " + Pretty(e.CalendarImpactType))</td>
                            <td class="p-2"><span class="rounded-full border px-2 py-0.5 font-semibold @StatusClass(e.Status)">@Pretty(e.Status)</span></td>
                            <td class="p-2"><div class="flex flex-wrap gap-1">
                                <button type="button" class="app-button app-button-ghost app-button-sm" @onclick="() => OpenDetailAsync(e.OrganisationEventId)">View</button>
                                @if (e.Status is "Draft" or "PendingApproval" or "Published")
                                {
                                    <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => EditAsync(e.OrganisationEventId)">Edit</button>
                                }
                                <button type="button" class="app-button app-button-ghost app-button-sm" @onclick="() => DuplicateAsync(e.OrganisationEventId)">Duplicate</button>
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- RIGHT: editor or detail -->
        @if (editing != null)
        {
            <aside class="lg:col-span-5 min-w-0 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <h2 class="font-bold text-slate-800 p-1">@(editing.OrganisationEventId == 0 ? "New event" : "Edit event")</h2>
                <div class="grid grid-cols-2 gap-2">
                    <div class="col-span-2"><label class="block p-1 text-xs font-medium text-slate-700">Title *</label><input class="@Input" maxlength="200" @bind="editing.Title" /></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Category</label>
                        <select class="@Input" @bind="editing.Category">@foreach (var c in Categories) {<option value="@c">@Pretty(c)</option>}</select></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Event code</label><input class="@Input" maxlength="40" @bind="editing.EventCode" /></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Start</label><input type="datetime-local" class="@Input" @bind="editing.StartDateTime" /></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">End</label><input type="datetime-local" class="@Input" @bind="editing.EndDateTime" /></div>
                    <label class="col-span-2 flex items-center gap-2 p-1 text-xs"><input type="checkbox" @bind="editing.IsAllDay" /> All-day event</label>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Venue</label><input class="@Input" maxlength="200" @bind="editing.VenueName" /></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Online meeting URL</label><input class="@Input" maxlength="500" @bind="editing.MeetingUrl" /></div>
                    <div class="col-span-2"><label class="block p-1 text-xs font-medium text-slate-700">Venue address</label><input class="@Input" maxlength="400" @bind="editing.VenueAddress" /></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Dress code</label><input class="@Input" maxlength="200" @bind="editing.DressCode" /></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Contact</label><input class="@Input" maxlength="300" @bind="editing.ContactInformation" /></div>
                    <div class="col-span-2"><label class="block p-1 text-xs font-medium text-slate-700">Description</label><textarea rows="2" class="@Input" @bind="editing.Description"></textarea></div>
                    <div class="col-span-2"><label class="block p-1 text-xs font-medium text-slate-700">Attendance instructions</label><textarea rows="2" class="@Input" @bind="editing.AttendanceInstructions"></textarea></div>
                    <div><label class="block p-1 text-xs font-medium text-slate-700">Attendance</label>
                        <select class="@Input" @bind="editing.AttendanceRequirement"><option value="InformationOnly">Information only</option><option value="Optional">Optional</option><option value="Required">Required</option><option value="RequiredSelected">Required for selected staff</option></select></div>
                    <label class="flex items-center gap-2 p-1 pt-6 text-xs"><input type="checkbox" @bind="editing.NotifyStaff" /> Notify staff on publish</label>
                </div>

                <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                    <h3 class="font-bold text-slate-800 p-1">Audience</h3>
                    <label class="flex items-center gap-2 text-xs"><input type="checkbox" checked="@wholeOrganisation" @onchange="e => ToggleOrganisation((bool)e.Value!)" /> Entire organisation</label>
                    @if (!wholeOrganisation)
                    {
                        @foreach (var a in editing.Audiences)
                        {
                            <div class="flex items-center gap-2">
                                <select class="@Input" @bind="a.AudienceType"><option value="Department">Department</option><option value="Team">Team</option><option value="Individual">Staff member</option><option value="EmploymentCategory">Employment category</option></select>
                                <input type="number" min="1" class="@Input" placeholder="Target ID" @bind="a.TargetEntityId" />
                                <button type="button" class="app-button app-button-ghost app-button-sm app-button-icon" aria-label="Remove audience" title="Remove" @onclick="() => editing.Audiences.Remove(a)">✕</button>
                            </div>
                        }
                        <button type="button" class="app-button app-button-secondary app-button-sm self-start" @onclick="AddAudience">+ Add audience group</button>
                    }
                </div>

                <div class="flex flex-col gap-2 rounded-xl border border-blue-200 bg-blue-50/40 p-3.5">
                    <h3 class="font-bold text-slate-800 p-1">Calendar impact</h3>
                    <select class="@Input" @bind="editing.CalendarImpactType">@foreach (var i in Impacts) {<option value="@i">@Pretty(i)</option>}</select>
                    @if (editing.CalendarImpactType is "MarkAsWorkingDay" or "OverrideWorkingHours" or "ShortenedWorkingDay" or "ExtendedWorkingDay")
                    {
                        <div class="grid grid-cols-2 gap-2">
                            <div><label class="block p-1 text-xs font-medium text-slate-700">Effective start</label><input type="time" class="@Input" @bind="startTime" /></div>
                            <div><label class="block p-1 text-xs font-medium text-slate-700">Effective end</label><input type="time" class="@Input" @bind="endTime" /></div>
                        </div>
                    }
                    @if (editing.CalendarImpactType != "None")
                    {
                        <label class="flex items-center gap-2 text-xs"><input type="checkbox" @bind="editing.AffectsAttendanceExpectation" /> Affects attendance expectations</label>
                        <label class="flex items-center gap-2 text-xs"><input type="checkbox" @bind="editing.RequiresLeaveRecalculation" /> Authorised leave recalculation required</label>
                    }
                    <p class="text-xs text-slate-600">@ImpactHelp(editing.CalendarImpactType)</p>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="SaveAsync">Save</button>
                    <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="() => editing = null">Close</button>
                </div>
            </aside>
        }
        else if (detail != null)
        {
            <aside class="lg:col-span-5 min-w-0 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-start justify-between gap-2">
                    <h2 class="font-bold text-slate-800 p-1">@detail.Title</h2>
                    <span class="rounded-full border px-2 py-0.5 text-xs font-semibold @StatusClass(detail.Status)">@Pretty(detail.Status)</span>
                </div>
                <dl class="grid grid-cols-3 gap-x-2 gap-y-1 text-xs">
                    <dt class="font-medium text-slate-500">Category</dt><dd class="col-span-2">@Pretty(detail.Category)</dd>
                    <dt class="font-medium text-slate-500">When</dt><dd class="col-span-2">@detail.StartDateTime.ToString("ddd dd MMM yyyy HH:mm") – @detail.EndDateTime.ToString("ddd dd MMM yyyy HH:mm")</dd>
                    <dt class="font-medium text-slate-500">Venue</dt><dd class="col-span-2">@(detail.VenueName ?? "—") @detail.VenueAddress</dd>
                    <dt class="font-medium text-slate-500">Audience</dt><dd class="col-span-2">@detail.AudienceSummary</dd>
                    <dt class="font-medium text-slate-500">Dress code</dt><dd class="col-span-2">@(detail.DressCode ?? "—")</dd>
                    <dt class="font-medium text-slate-500">Attendance</dt><dd class="col-span-2">@Pretty(detail.AttendanceRequirement)</dd>
                    <dt class="font-medium text-slate-500">Contact</dt><dd class="col-span-2">@(detail.ContactInformation ?? "—")</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(detail.Description)) { <p class="text-xs text-slate-700">@detail.Description</p> }

                @if (preview != null)
                {
                    <div class="rounded-xl border @(preview.ChangesWorkSchedule ? "border-amber-300 bg-amber-50" : "border-slate-200 bg-slate-50/70") p-3 text-xs flex flex-col gap-1.5">
                        <h3 class="font-bold text-slate-800">Calendar impact preview</h3>
                        <p>@preview.EffectSummary</p>
                        @if (preview.AffectedDates.Count > 0) { <p><b>Dates:</b> @string.Join(", ", preview.AffectedDates.Take(10).Select(d => d.ToString("ddd dd MMM"))) @(preview.AffectedDates.Count > 10 ? "…" : "")</p> }
                        @if (preview.Scopes.Count > 0) { <p><b>Applies to:</b> @string.Join(", ", preview.Scopes)</p> }
                        @foreach (var w in preview.Warnings) { <p class="text-amber-800">⚠ @w</p> }
                        @foreach (var c in preview.Conflicts) { <p class="text-rose-700">⛔ @c</p> }
                    </div>
                }

                <div class="flex flex-wrap gap-2">
                    @if (detail.Status is "Draft" or "PendingApproval")
                    {
                        <button type="button" class="app-button app-button-success app-button-sm" disabled="@(busy || preview?.CanPublish == false)" @onclick="PublishAsync">Publish</button>
                    }
                    @if (detail.Status is "Draft" or "PendingApproval" or "Published")
                    {
                        <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => cancelling = true">Cancel event</button>
                    }
                    <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="() => { detail = null; preview = null; audit.Clear(); }">Close</button>
                </div>
                @if (cancelling)
                {
                    <div class="flex flex-col gap-2 rounded-xl border border-rose-200 bg-rose-50 p-3">
                        <label class="block text-xs font-medium text-rose-900">Cancellation reason *</label>
                        <input class="@Input" maxlength="400" @bind="cancelReason" />
                        <div class="flex gap-2">
                            <button type="button" class="app-button app-button-danger app-button-sm" disabled="@busy" @onclick="CancelAsync">Confirm cancellation</button>
                            <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="() => cancelling = false">Keep event</button>
                        </div>
                    </div>
                }

                <div>
                    <h3 class="font-bold text-slate-800 p-1">Audit history</h3>
                    @if (audit.Count == 0) { <p class="p-1 text-xs text-slate-500">No history yet.</p> }
                    <ul class="flex flex-col gap-1 text-xs">
                        @foreach (var a in audit) { <li class="rounded-lg border border-slate-100 p-2"><b>@a.Action</b> · @a.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · staff #@a.ActorIndividualId@(string.IsNullOrWhiteSpace(a.Reason) ? "" : " — " + a.Reason)</li> }
                    </ul>
                </div>
            </aside>
        }
    </div>
</section>
</div>

@code {
    private static readonly string[] Categories = ["Meeting", "Ceremony", "Gathering", "Training", "Workshop", "Holiday", "SpecialWorkingDay", "NonWorkingDay", "WorkingHourChange", "StaffDevelopment", "MandatoryAttendance", "Official"];
    private static readonly string[] Statuses = ["Draft", "PendingApproval", "Published", "Cancelled", "Completed"];
    private static readonly string[] Impacts = ["None", "MarkAsNonWorkingDay", "MarkAsWorkingDay", "OverrideWorkingHours", "ShortenedWorkingDay", "ExtendedWorkingDay"];
    private const string Input = "mt-1 w-full rounded-lg border border-slate-300 bg-white p-1 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100";
    private const string FullWidthKey = "hrm.organisation-events.full-width";

    private List<OrganisationEventDto> events = [];
    private OrganisationEventDto? editing, detail;
    private EventImpactPreviewDto? preview;
    private List<OrganisationEventAuditDto> audit = [];
    private DateTime? from = DateTime.Today.AddMonths(-1), to = DateTime.Today.AddMonths(12);
    private string? category, status, impact, upcoming, error, cancelReason;
    private bool busy, isFullWidth, cancelling;
    private CancellationTokenSource? cts;

    private bool wholeOrganisation => editing != null && (editing.Audiences.Count == 0 || editing.Audiences.Any(a => a.AudienceType == "Organisation"));
    private TimeOnly startTime { get => TimeOnly.FromTimeSpan(editing?.EffectiveWorkStartTime ?? new(9, 0, 0)); set { if (editing != null) editing.EffectiveWorkStartTime = value.ToTimeSpan(); } }
    private TimeOnly endTime { get => TimeOnly.FromTimeSpan(editing?.EffectiveWorkEndTime ?? new(15, 0, 0)); set { if (editing != null) editing.EffectiveWorkEndTime = value.ToTimeSpan(); } }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { isFullWidth = await JS.InvokeAsync<string>("localStorage.getItem", FullWidthKey) == "True"; StateHasChanged(); } catch { }
        await LoadAsync();
    }

    private async Task ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
        try { await JS.InvokeVoidAsync("localStorage.setItem", FullWidthKey, isFullWidth.ToString()); } catch { }
    }

    private async Task LoadAsync()
    {
        cts?.Cancel(); cts = new();
        busy = true; error = null; StateHasChanged();
        try { events = await Events.ListAsync(from, to, Nz(category), Nz(status), Nz(impact), null, upcoming == "true" ? true : null); }
        catch (Exception ex) { error = ex.Message; }
        busy = false; StateHasChanged();
    }

    private static string? Nz(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private void NewEvent()
    {
        detail = null; preview = null;
        var start = DateTime.Today.AddDays(1).AddHours(9);
        editing = new() { StartDateTime = start, EndDateTime = start.AddHours(1), Audiences = [new() { AudienceType = "Organisation" }] };
    }

    private async Task EditAsync(int id)
    {
        await Run(async () => { editing = await Events.GetAsync(id); detail = null; preview = null; });
    }

    private async Task OpenDetailAsync(int id)
    {
        await Run(async () =>
        {
            editing = null; cancelling = false; cancelReason = null;
            detail = await Events.GetAsync(id);
            preview = await Events.PreviewImpactAsync(id);
            audit = await Events.AuditAsync(id);
        });
    }

    private void ToggleOrganisation(bool on)
    {
        if (editing == null) return;
        editing.Audiences = on ? [new() { AudienceType = "Organisation" }] : [];
        if (!on) AddAudience();
    }

    private void AddAudience() => editing?.Audiences.Add(new() { AudienceType = "Department" });

    private async Task SaveAsync()
    {
        if (editing == null) return;
        await Run(async () =>
        {
            if (editing.CalendarImpactType is "None" or "MarkAsNonWorkingDay") { editing.EffectiveWorkStartTime = null; editing.EffectiveWorkEndTime = null; }
            else { editing.EffectiveWorkStartTime ??= startTime.ToTimeSpan(); editing.EffectiveWorkEndTime ??= endTime.ToTimeSpan(); }
            var id = await Events.SaveAsync(editing);
            Toasts.Success("Event saved.");
            editing = null;
            await LoadAsync();
            await OpenDetailAsync(id);
        });
    }

    private async Task PublishAsync()
    {
        if (detail == null) return;
        var id = detail.OrganisationEventId;
        await Run(async () => { await Events.PublishAsync(id); Toasts.Success("Event published."); await LoadAsync(); await OpenDetailAsync(id); });
    }

    private async Task CancelAsync()
    {
        if (detail == null) return;
        var id = detail.OrganisationEventId;
        await Run(async () => { await Events.CancelAsync(id, cancelReason ?? ""); Toasts.Success("Event cancelled."); cancelling = false; await LoadAsync(); await OpenDetailAsync(id); });
    }

    private async Task DuplicateAsync(int id)
    {
        await Run(async () => { var copy = await Events.DuplicateAsync(id); Toasts.Success("Draft copy created."); await LoadAsync(); await EditAsync(copy); });
    }

    private async Task Run(Func<Task> action)
    {
        busy = true; error = null;
        try { await action(); }
        catch (Exception ex) { error = ex.Message; Toasts.Error(ex.Message); }
        busy = false; StateHasChanged();
    }

    private static string Pretty(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z])(?=[A-Z])", " ");

    private static string StatusClass(string s) => s switch
    {
        "Published" => "border-emerald-200 bg-emerald-50 text-emerald-800",
        "Cancelled" => "border-rose-200 bg-rose-50 text-rose-800",
        "PendingApproval" => "border-amber-200 bg-amber-50 text-amber-800",
        "Completed" => "border-slate-300 bg-slate-100 text-slate-700",
        _ => "border-blue-200 bg-blue-50 text-blue-800"
    };

    private static string ImpactHelp(string impact) => impact switch
    {
        "MarkAsNonWorkingDay" => "On publication, the covered dates become non-working days for the audience. Existing approved leave is flagged for review, not changed.",
        "MarkAsWorkingDay" => "On publication, the covered dates become working days with the hours below, even if normally non-working.",
        "OverrideWorkingHours" or "ShortenedWorkingDay" or "ExtendedWorkingDay" => "On publication, working hours on the covered dates are replaced by the hours below.",
        _ => "Informational only. Schedules, attendance and leave calculations are not affected."
    };
}
