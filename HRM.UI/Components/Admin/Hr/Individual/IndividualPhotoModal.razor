@using HRM.Services
@using HRM.Services.Interfaces
@inject IIndividualRegistryService Registry
@inject ToastService Toasts
@inject ILogger<IndividualPhotoModal> Logger

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-200"
     role="dialog"
     aria-modal="true"
     aria-labelledby="photo-modal-title">
    
    <!-- Modal Backdrop Click Dismiss -->
    <div class="fixed inset-0" @onclick="HandleClose" aria-hidden="true"></div>

    <div class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden z-10 animate-in zoom-in-95 duration-200">
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 px-5 py-4">
            <div>
                <h3 id="photo-modal-title" class="text-base font-bold text-slate-900 dark:text-slate-100">
                    @(string.IsNullOrEmpty(CurrentImageUrl) ? "Add Photo" : "Edit Photo")
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    @IndividualName
                </p>
            </div>
            <button type="button"
                    @onclick="HandleClose"
                    disabled="@isBusy"
                    class="rounded-lg p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                    aria-label="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Body -->
        <div class="p-5 space-y-4">
            <!-- Photo Preview Area -->
            <div class="flex flex-col items-center justify-center gap-2">
                <div class="w-32 h-32 rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 shadow-xs bg-slate-100 dark:bg-slate-800 relative flex items-center justify-center">
                    @if (!string.IsNullOrEmpty(ActivePreview) && !isMarkedForRemoval)
                    {
                        <img src="@ActivePreview"
                             alt="@IndividualName"
                             class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center text-slate-400 p-2 text-center">
                            <svg class="w-10 h-10 mb-1 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                                @(isMarkedForRemoval ? "No Photo (Removed)" : "No Photo")
                            </span>
                        </div>
                    }

                    @if (imageLoading)
                    {
                        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-2xs flex items-center justify-center">
                            <svg class="animate-spin h-6 w-6 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </div>
                    }
                </div>

                <!-- Status Badges -->
                @if (isMarkedForRemoval)
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 dark:bg-red-950/50 px-2.5 py-0.5 text-[11px] font-medium text-red-700 dark:text-red-300 border border-red-200 dark:border-red-900">
                        Photo marked for removal
                    </span>
                }
                else if (pendingImageData != null)
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 dark:bg-blue-950/50 px-2.5 py-0.5 text-[11px] font-medium text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                        New photo staged
                    </span>
                }
            </div>

            <!-- Upload File Input -->
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200">
                    @(HasPhoto ? "Replace Photo" : "Upload Photo")
                </label>
                <InputFile @key="inputKey"
                           OnChange="OnImageChanged"
                           accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                           disabled="@isBusy"
                           class="block w-full text-xs text-slate-600 dark:text-slate-300
                                  file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0
                                  file:text-xs file:font-semibold file:bg-blue-50 dark:file:bg-blue-950/60
                                  file:text-blue-700 dark:file:text-blue-300 hover:file:bg-blue-100
                                  cursor-pointer transition" />
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    PNG or JPEG · up to 2 MB · maximum 4096 × 4096 pixels
                </p>
            </div>

            <!-- Error message alert -->
            @if (!string.IsNullOrEmpty(imageError))
            {
                <div role="alert" class="p-3 rounded-lg bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-xs text-red-700 dark:text-red-300 flex items-start gap-2">
                    <svg class="w-4 h-4 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@imageError</span>
                </div>
            }

            <!-- Quick Action: Remove or Reset -->
            <div class="flex items-center justify-between pt-1">
                @if (HasPhoto && !isMarkedForRemoval)
                {
                    <button type="button"
                            @onclick="MarkForRemoval"
                            disabled="@isBusy"
                            class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Remove Photo</span>
                    </button>
                }
                else if (isMarkedForRemoval || pendingImageData != null)
                {
                    <button type="button"
                            @onclick="ResetChanges"
                            disabled="@isBusy"
                            class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
                        Discard Changes
                    </button>
                }
                else
                {
                    <span></span>
                }
            </div>
        </div>

        <!-- Footer -->
        <div class="flex items-center justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 px-5 py-3">
            <button type="button"
                    @onclick="HandleClose"
                    disabled="@isBusy"
                    class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                Cancel
            </button>
            <button type="button"
                    @onclick="SaveAsync"
                    disabled="@(!HasChanges || isBusy || imageLoading || imageError != null)"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white shadow-2xs hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition">
                @if (isBusy)
                {
                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Photo</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int IndividualId { get; set; }
    [Parameter] public string IndividualName { get; set; } = string.Empty;
    [Parameter] public string? CurrentImageUrl { get; set; }
    [Parameter] public EventCallback<string?> OnPhotoUpdated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private byte[]? pendingImageData;
    private string? stagedPreviewUrl;
    private string? imageError;
    private bool imageLoading;
    private bool isBusy;
    private bool isMarkedForRemoval;
    private int inputKey = 1;
    private int loadVersion;

    private bool HasPhoto => !string.IsNullOrEmpty(CurrentImageUrl) || pendingImageData != null;
    private string? ActivePreview => stagedPreviewUrl ?? CurrentImageUrl;
    private bool HasChanges => isMarkedForRemoval || pendingImageData != null;

    private async Task HandleClose()
    {
        if (isBusy) return;
        await OnClose.InvokeAsync();
    }

    private void MarkForRemoval()
    {
        isMarkedForRemoval = true;
        pendingImageData = null;
        stagedPreviewUrl = null;
        imageError = null;
        inputKey++;
    }

    private void ResetChanges()
    {
        isMarkedForRemoval = false;
        pendingImageData = null;
        stagedPreviewUrl = null;
        imageError = null;
        imageLoading = false;
        inputKey++;
    }

    private async Task OnImageChanged(InputFileChangeEventArgs e)
    {
        loadVersion++;
        var currentVersion = loadVersion;
        imageLoading = true;
        imageError = null;
        isMarkedForRemoval = false;

        try
        {
            await using var stream = e.File.OpenReadStream(IndividualImage.MaximumBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            var contentType = IndividualImage.Validate(bytes);

            if (currentVersion != loadVersion) return;

            pendingImageData = bytes;
            stagedPreviewUrl = IndividualImage.DataUrl(bytes, contentType);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            if (currentVersion != loadVersion) return;
            pendingImageData = null;
            stagedPreviewUrl = null;
            imageError = ex is InvalidOperationException ? ex.Message : "Choose a PNG or JPEG image up to 2 MB.";
            inputKey++;
        }
        finally
        {
            if (currentVersion == loadVersion)
                imageLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!HasChanges || isBusy || imageLoading || imageError != null) return;

        isBusy = true;
        imageError = null;

        try
        {
            if (isMarkedForRemoval)
            {
                await Registry.UpdatePhotoAsync(IndividualId, null);
                Toasts.Success("Photo removed successfully.");
                await OnPhotoUpdated.InvokeAsync(null);
            }
            else if (pendingImageData != null)
            {
                await Registry.UpdatePhotoAsync(IndividualId, pendingImageData);
                Toasts.Success("Photo updated successfully.");
                await OnPhotoUpdated.InvokeAsync(stagedPreviewUrl);
            }

            await OnClose.InvokeAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            imageError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update individual photo for {IndividualId}", IndividualId);
            imageError = ex is InvalidOperationException ? ex.Message : "Photo could not be saved. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
