@using HRM.DTOs.Registry
@using HRM.Models
@using HRM.Services
@using HRM.Components.Shared
@using HRM.Services.Interfaces

@inject IIndividualRegistryService Registry
@inject IUserAccessService UserAccess

<div class="relative w-full h-full mx-auto space-y-3">
    <!-- Compact Header at Top -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 pb-1">
        <div>
            <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">Search Individual Registry</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Search unattached individuals by Name, National ID, or Passport to start staff onboarding.</p>
        </div>
    </div>

    <!-- Standard Size Search Bar -->
    <div class="flex flex-wrap items-center gap-2 max-w-2xl">
        <select @bind="searchModel.SearchType"
                class="h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
            <option value="Name">Name</option>
            <option value="ID">National ID</option>
            <option value="Passport">Passport</option>
        </select>

        <div class="relative flex-1 min-w-[220px]">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400 dark:text-slate-500">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text"
                   @bind="searchModel.SearchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   placeholder="Enter search term..."
                   class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 pl-9 pr-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 shadow-xs focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" />
        </div>

        <button type="button"
                @onclick="ExecuteSearch"
                disabled="@(string.IsNullOrWhiteSpace(searchModel.SearchTerm) || isLoading)"
                class="h-9 inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors">
            @if (isLoading)
            {
                <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span>Searching...</span>
            }
            else
            {
                <span>Search</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(searchError))
    {
        <p role="alert" class="rounded-lg border p-4">@searchError</p>
    }
    else if (hasSearched)
    {
        if (!searchResults.Any())
        {
            <div class="flex flex-col items-center justify-center py-12 px-4 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50">
                <span class="text-4xl mb-3">📭</span>
                <h3 class="text-lg font-bold text-slate-700">No individuals found</h3>
                <p class="text-sm text-slate-500 mt-1">Check the @searchModel.SearchType and try again.</p>
            </div>
        }
        else
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
                <div class="block lg:hidden divide-y divide-slate-100">
                    @for (int i = 0; i < searchResults.Count; i++)
                    {
                        var ind = searchResults[i];
                        <div class="p-5 hover:bg-slate-50 transition-colors">
                            <div class="flex justify-between items-start gap-4 mb-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold shrink-0">
                                        @(string.IsNullOrEmpty(ind.FullName) ? "?" : ind.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-slate-800 leading-tight">@ind.FullName</h4>
                                    </div>
                                </div>
                                @if (canOnboard)
                                {
                                    <a href="/admin/my/workspace/onboarding?individualId=@ind.BusinessEntityId" class="inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">Add as Staff</a>
                                }
                            </div>
                            <div class="grid grid-cols-2 gap-3 text-sm">
                                <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">ID Card</span>
                                    <span class="text-slate-700 font-medium">@(string.IsNullOrEmpty(ind.IDNumber) ? "-" : ind.IDNumber)</span>
                                </div>
                                <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Passport</span>
                                    <span class="text-slate-700 font-medium">@(string.IsNullOrEmpty(ind.PassportNumber) ? "-" : ind.PassportNumber)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="hidden lg:block overflow-x-auto">
                    <table class="w-full text-left border-collapse whitespace-nowrap text-sm">
                        <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="py-3 px-4 font-bold text-slate-500 uppercase tracking-wider w-12">#</th>
                                <th class="py-3 px-4 font-bold text-slate-500 uppercase tracking-wider">Name</th>
                                <th class="py-3 px-4 font-bold text-slate-500 uppercase tracking-wider">ID Card</th>
                                <th class="py-3 px-4 font-bold text-slate-500 uppercase tracking-wider">Passport</th>
                                @if (canOnboard) { <th class="py-3 px-4 font-bold text-slate-500 uppercase tracking-wider">Action</th> }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @for (int i = 0; i < searchResults.Count; i++)
                            {
                                var ind = searchResults[i];
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                    <td class="py-3 px-4 text-slate-400">@(i + 1)</td>
                                    <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-100">
                                        <div class="flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold">
                                                @(string.IsNullOrEmpty(ind.FullName) ? "?" : ind.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            @ind.FullName
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 font-medium text-slate-600 dark:text-slate-300">@(string.IsNullOrEmpty(ind.IDNumber) ? "-" : ind.IDNumber)</td>
                                    <td class="py-3 px-4 font-medium text-slate-600 dark:text-slate-300">@(string.IsNullOrEmpty(ind.PassportNumber) ? "-" : ind.PassportNumber)</td>
                                    @if (canOnboard)
                                    {
                                        <td class="py-3 px-4"><a href="/admin/my/workspace/onboarding?individualId=@ind.BusinessEntityId" class="inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">Add as Staff</a></td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    // --- State Variables ---
    private SearchModel searchModel = new();
    private List<RegistryIndividualDto> searchResults = new();
    private bool isLoading = false;
    private bool hasSearched = false;
    private string? searchError;
    private bool canOnboard;
    protected override async Task OnInitializedAsync()
    {
        var actor = await UserAccess.RequireContextAsync();
        canOnboard = actor.IsSuperAdministrator || actor.IsHRStaff || actor.IsHRHead || actor.IsHRManager || actor.IsOrganisationAdmin ||
            await UserAccess.HasPermissionAsync("Admin");
    }

    // --- Search Logic ---
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchModel.SearchTerm))
        {
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchModel.SearchTerm)) return;

        isLoading = true;
        hasSearched = false;
        searchResults.Clear();
        searchError = null;
        StateHasChanged();

        try
        {
            searchResults = await Registry.SearchAsync(searchModel.SearchTerm, searchModel.SearchType);
        }
        catch (UnauthorizedAccessException)
        {
            searchError = "You do not have access to search this organisation’s registry. Contact your organisation’s HR administrator.";
        }
        catch (InvalidOperationException)
        {
            searchError = "The registry search could not be completed. Check your organisation access and try again.";
        }
        finally
        {
            isLoading = false;
            hasSearched = true;
        }
    }

    // --- DTOs ---
    public class SearchModel
    {
        public string SearchTerm { get; set; } = string.Empty;
        public string SearchType { get; set; } = "Name";
    }


}
