@using HRM.DTOs.Registry
@using HRM.Models
@using HRM.Services
@using HRM.Components.Shared
@using HRM.Services.Interfaces

@inject IIndividualRegistryService Registry
@inject IUserAccessService UserAccess

<div class="relative w-full h-full mx-auto space-y-3">
    <!-- Compact Header at Top -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 pb-1">
        <div>
            <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">Search Individual Registry</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Search unattached individuals by Name, National ID, or Passport to manage photos and start staff onboarding.</p>
        </div>
    </div>

    <!-- Standard Size Search Bar -->
    <div class="flex flex-wrap items-center gap-2 max-w-2xl">
        <select @bind="searchModel.SearchType"
                class="h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
            <option value="Name">Name</option>
            <option value="ID">National ID</option>
            <option value="Passport">Passport</option>
        </select>

        <div class="relative flex-1 min-w-[220px]">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400 dark:text-slate-500">
                <AppIcon Name="search" Class="h-4 w-4 text-base" />
            </span>
            <input type="text"
                   @bind="searchModel.SearchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   placeholder="Enter search term..."
                   class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 pl-9 pr-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 shadow-xs focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" />
        </div>

        <button type="button"
                @onclick="ExecuteSearch"
                disabled="@(string.IsNullOrWhiteSpace(searchModel.SearchTerm) || isLoading)"
                class="h-9 inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50 transition-colors">
            @if (isLoading)
            {
                <AppIcon Name="progress_activity" Class="animate-spin h-3.5 w-3.5 text-white text-sm" />
                <span>Searching...</span>
            }
            else
            {
                <span>Search</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(searchError))
    {
        <p role="alert" class="rounded-lg border p-4 text-xs text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-900">@searchError</p>
    }
    else if (hasSearched)
    {
        if (!searchResults.Any())
        {
            <div class="flex flex-col items-center justify-center py-12 px-4 border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-2xl bg-slate-50 dark:bg-slate-800/40">
                <span class="text-4xl mb-3">📭</span>
                <h3 class="text-base font-bold text-slate-700 dark:text-slate-200">No individuals found</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Check the @searchModel.SearchType and try again.</p>
            </div>
        }
        else
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-300">
                <!-- Mobile Card List -->
                <div class="block lg:hidden divide-y divide-slate-100 dark:divide-slate-800">
                    @for (int i = 0; i < searchResults.Count; i++)
                    {
                        var ind = searchResults[i];
                        <div class="p-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <div class="flex justify-between items-start gap-4 mb-3">
                                <div class="flex items-center gap-3 min-w-0">
                                    @if (!string.IsNullOrEmpty(ind.ImageUrl))
                                    {
                                        <img src="@ind.ImageUrl"
                                             alt="@ind.FullName"
                                             class="w-11 h-11 rounded-full object-cover shrink-0 border border-slate-200 dark:border-slate-700 shadow-2xs" />
                                    }
                                    else
                                    {
                                        <div class="w-11 h-11 rounded-full bg-blue-100 text-blue-600 dark:bg-blue-950/60 dark:text-blue-300 flex items-center justify-center text-sm font-bold shrink-0">
                                            @(string.IsNullOrEmpty(ind.FullName) ? "?" : ind.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                    <div class="min-w-0">
                                        <h4 class="font-bold text-slate-900 dark:text-slate-100 text-sm leading-tight truncate">@ind.FullName</h4>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-1.5 shrink-0">
                                    @if (canManagePhoto)
                                    {
                                        <button type="button"
                                                @onclick="() => OpenPhotoModal(ind)"
                                                class="inline-flex items-center justify-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 shadow-2xs transition">
                                            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                            <span>@(string.IsNullOrEmpty(ind.ImageUrl) ? "Add photo" : "Edit photo")</span>
                                        </button>
                                    }
                                    @if (canOnboard)
                                    {
                                        <a href="/admin/my/workspace/onboarding?individualId=@ind.BusinessEntityId"
                                           class="inline-flex items-center justify-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 transition">
                                            Add as Staff
                                        </a>
                                    }
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div class="bg-slate-50 dark:bg-slate-800/60 p-2 rounded-lg border border-slate-100 dark:border-slate-800">
                                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">ID Card</span>
                                    <span class="text-slate-700 dark:text-slate-300 font-medium">@(string.IsNullOrEmpty(ind.IDNumber) ? "-" : ind.IDNumber)</span>
                                </div>
                                <div class="bg-slate-50 dark:bg-slate-800/60 p-2 rounded-lg border border-slate-100 dark:border-slate-800">
                                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Passport</span>
                                    <span class="text-slate-700 dark:text-slate-300 font-medium">@(string.IsNullOrEmpty(ind.PassportNumber) ? "-" : ind.PassportNumber)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Desktop Table View -->
                <div class="hidden lg:block overflow-x-auto">
                    <table class="w-full text-left border-collapse whitespace-nowrap text-sm">
                        <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="py-2.5 px-4 font-bold text-slate-500 uppercase tracking-wider w-12 text-xs">#</th>
                                <th class="py-2.5 px-4 font-bold text-slate-500 uppercase tracking-wider text-xs">Name</th>
                                <th class="py-2.5 px-4 font-bold text-slate-500 uppercase tracking-wider text-xs">ID Card</th>
                                <th class="py-2.5 px-4 font-bold text-slate-500 uppercase tracking-wider text-xs">Passport</th>
                                @if (canOnboard || canManagePhoto)
                                {
                                    <th class="py-2.5 px-4 font-bold text-slate-500 uppercase tracking-wider text-xs">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @for (int i = 0; i < searchResults.Count; i++)
                            {
                                var ind = searchResults[i];
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                    <td class="py-2.5 px-4 text-slate-400 text-xs">@(i + 1)</td>
                                    <td class="py-2.5 px-4 font-semibold text-slate-800 dark:text-slate-100">
                                        <div class="flex items-center gap-2.5">
                                            @if (!string.IsNullOrEmpty(ind.ImageUrl))
                                            {
                                                <img src="@ind.ImageUrl"
                                                     alt="@ind.FullName"
                                                     class="w-7 h-7 rounded-full object-cover shrink-0 border border-slate-200 dark:border-slate-700 shadow-2xs" />
                                            }
                                            else
                                            {
                                                <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-600 dark:bg-blue-950/60 dark:text-blue-300 flex items-center justify-center text-xs font-bold shrink-0">
                                                    @(string.IsNullOrEmpty(ind.FullName) ? "?" : ind.FullName.Substring(0, 1).ToUpper())
                                                </div>
                                            }
                                            <span>@ind.FullName</span>
                                        </div>
                                    </td>
                                    <td class="py-2.5 px-4 font-medium text-slate-600 dark:text-slate-300 text-xs">@(string.IsNullOrEmpty(ind.IDNumber) ? "-" : ind.IDNumber)</td>
                                    <td class="py-2.5 px-4 font-medium text-slate-600 dark:text-slate-300 text-xs">@(string.IsNullOrEmpty(ind.PassportNumber) ? "-" : ind.PassportNumber)</td>
                                    @if (canOnboard || canManagePhoto)
                                    {
                                        <td class="py-2.5 px-4">
                                            <div class="flex items-center gap-2">
                                                @if (canManagePhoto)
                                                {
                                                    <button type="button"
                                                            @onclick="() => OpenPhotoModal(ind)"
                                                            class="inline-flex items-center justify-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 shadow-2xs transition">
                                                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                                        <span>@(string.IsNullOrEmpty(ind.ImageUrl) ? "Add photo" : "Edit photo")</span>
                                                    </button>
                                                }
                                                @if (canOnboard)
                                                {
                                                    <a href="/admin/my/workspace/onboarding?individualId=@ind.BusinessEntityId"
                                                       class="inline-flex items-center justify-center gap-1 rounded-lg px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 transition">
                                                        Add as Staff
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    <!-- Individual Photo Modal -->
    @if (activePhotoTarget != null)
    {
        <IndividualPhotoModal IndividualId="activePhotoTarget.BusinessEntityId"
                              IndividualName="@activePhotoTarget.FullName"
                              CurrentImageUrl="@activePhotoTarget.ImageUrl"
                              OnPhotoUpdated="HandlePhotoUpdated"
                              OnClose="ClosePhotoModal" />
    }
</div>

@code {
    // --- State Variables ---
    private SearchModel searchModel = new();
    private List<RegistryIndividualDto> searchResults = new();
    private bool isLoading = false;
    private bool hasSearched = false;
    private string? searchError;
    private bool canOnboard;
    private bool canManagePhoto;
    private RegistryIndividualDto? activePhotoTarget;

    protected override async Task OnInitializedAsync()
    {
        var actor = await UserAccess.RequireContextAsync();
        canOnboard = actor.IsSuperAdministrator || actor.IsHRStaff || actor.IsHRHead || actor.IsHRManager || actor.IsOrganisationAdmin ||
            await UserAccess.HasPermissionAsync("Admin");
        canManagePhoto = actor.IsSuperAdministrator || actor.IsHRStaff || actor.IsHRHead || actor.IsHRManager || actor.IsOrganisationAdmin ||
            await UserAccess.HasPermissionAsync("Admin") || await UserAccess.HasPermissionAsync("Individual.Edit") || await UserAccess.HasPermissionAsync("Individual.Create");
    }

    private void OpenPhotoModal(RegistryIndividualDto target)
    {
        activePhotoTarget = target;
    }

    private void ClosePhotoModal()
    {
        activePhotoTarget = null;
    }

    private void HandlePhotoUpdated(string? newUrl)
    {
        if (activePhotoTarget != null)
        {
            activePhotoTarget.ImageUrl = newUrl;
        }
    }

    // --- Search Logic ---
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchModel.SearchTerm))
        {
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchModel.SearchTerm)) return;

        isLoading = true;
        hasSearched = false;
        searchResults.Clear();
        searchError = null;
        StateHasChanged();

        try
        {
            searchResults = await Registry.SearchAsync(searchModel.SearchTerm, searchModel.SearchType);
        }
        catch (UnauthorizedAccessException)
        {
            searchError = "You do not have access to search this organisation’s registry. Contact your organisation’s HR administrator.";
        }
        catch (InvalidOperationException)
        {
            searchError = "The registry search could not be completed. Check your organisation access and try again.";
        }
        finally
        {
            isLoading = false;
            hasSearched = true;
        }
    }

    // --- DTOs ---
    public class SearchModel
    {
        public string SearchTerm { get; set; } = string.Empty;
        public string SearchType { get; set; } = "Name";
    }
}
