@code {
    private const string FullWidthSettingKey = "hrm.staff-manage.full-width";

    public sealed class ManagedStaffMember
    {
        public int JobId { get; set; }
        public int IndividualId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? EmployeeNumber { get; set; }
        public string Department { get; set; } = string.Empty;
        public string JobType { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public List<string> Groups { get; set; } = [];
        public bool IsActive => Status.Equals("Active", StringComparison.OrdinalIgnoreCase) ||
                                Status.Equals("Approved", StringComparison.OrdinalIgnoreCase);
    }

    public sealed class DepartmentGroupView
    {
        public string Name { get; set; } = string.Empty;
        public string StructureType { get; set; } = string.Empty;
        public List<string> Supervisors { get; set; } = [];
        public List<ManagedStaffMember> Staff { get; set; } = [];
    }

    public sealed class GroupEntryView
    {
        public string Name { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
        public string ParentStructure { get; set; } = string.Empty;
        public List<ManagedStaffMember> Staff { get; set; } = [];
    }

    private List<ManagedStaffMember> allStaff = [];
    private readonly Dictionary<int, string?> staffPhotos = new();
    private OrganisationTeamSettingsData? teamData;
    private OperationalGroupsData? operationalGroupsData;

    private int orgId;
    private string organisationName = string.Empty;
    private string activeTab = "all";
    private bool busy = true;
    private bool isFullWidth = false;
    private string? error;

    // Filters
    private string searchTerm = string.Empty;
    private string selectedDepartment = string.Empty;
    private string selectedGroup = string.Empty;
    private string selectedStatus = "all";

    // Sub-view selections
    private string? selectedDeptName;
    private string? selectedGroupName;

    // Modal state
    private ManagedStaffMember? activePhotoStaff;

    // Exporting flags
    private bool exporting => exportingCsv || exportingPdf;
    private bool exportingCsv = false;
    private bool exportingPdf = false;

    private bool disposed;

    private int DepartmentCount => teamData?.Rows.Count(r => r.Kind == "Department") ??
                                   allStaff.Select(s => s.Department).Where(d => !string.IsNullOrEmpty(d)).Distinct().Count();

    private int GroupCount => (operationalGroupsData?.Groups.Count ?? 0) + (teamData?.Rows.Count(r => r.Kind == "Team") ?? 0);

    private IEnumerable<string> DepartmentsList =>
        allStaff.Select(s => s.Department).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(d => d);

    private IEnumerable<string> GroupsList =>
        allStaff.SelectMany(s => s.Groups).Distinct().OrderBy(g => g);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrWhiteSpace(selectedDepartment) ||
        !string.IsNullOrWhiteSpace(selectedGroup) ||
        selectedStatus != "all";

    private IEnumerable<ManagedStaffMember> FilteredStaff =>
        allStaff.Where(s =>
        {
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                var match = s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                            (s.EmployeeNumber != null && s.EmployeeNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                            s.Department.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                            s.JobType.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                            s.Groups.Any(g => g.Contains(term, StringComparison.OrdinalIgnoreCase));
                if (!match) return false;
            }

            if (!string.IsNullOrWhiteSpace(selectedDepartment) &&
                !s.Department.Equals(selectedDepartment, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            if (!string.IsNullOrWhiteSpace(selectedGroup) &&
                !s.Groups.Any(g => g.Equals(selectedGroup, StringComparison.OrdinalIgnoreCase)))
            {
                return false;
            }

            if (selectedStatus == "active" && !s.IsActive) return false;
            if (selectedStatus == "inactive" && s.IsActive) return false;

            return true;
        });

    private IEnumerable<DepartmentGroupView> DepartmentGroups
    {
        get
        {
            var deptRows = teamData?.Rows.Where(r => r.Kind == "Department").ToList() ?? [];
            var structureTypeMap = teamData?.StructureTypes.ToDictionary(t => t.Id, t => t.Name) ?? [];

            var list = new List<DepartmentGroupView>();
            foreach (var r in deptRows)
            {
                var typeName = r.StructureTypeId.HasValue && structureTypeMap.TryGetValue(r.StructureTypeId.Value, out var t) ? t : "Department";
                var members = allStaff.Where(s => s.Department.Equals(r.Name, StringComparison.OrdinalIgnoreCase)).ToList();
                list.Add(new DepartmentGroupView
                {
                    Name = r.Name,
                    StructureType = typeName,
                    Supervisors = r.Supervisors.Select(s => s.Name).ToList(),
                    Staff = members
                });
            }

            // Fallback for any departments in staff list not in teamData
            foreach (var deptName in DepartmentsList)
            {
                if (!list.Any(d => d.Name.Equals(deptName, StringComparison.OrdinalIgnoreCase)))
                {
                    list.Add(new DepartmentGroupView
                    {
                        Name = deptName,
                        StructureType = "Department",
                        Supervisors = [],
                        Staff = allStaff.Where(s => s.Department.Equals(deptName, StringComparison.OrdinalIgnoreCase)).ToList()
                    });
                }
            }

            return list.OrderBy(d => d.Name);
        }
    }

    private DepartmentGroupView? ActiveDepartmentGroup =>
        DepartmentGroups.FirstOrDefault(d => d.Name == selectedDeptName) ?? DepartmentGroups.FirstOrDefault();

    private IEnumerable<GroupEntryView> GroupEntries
    {
        get
        {
            var list = new List<GroupEntryView>();

            // Operational groups
            if (operationalGroupsData?.Groups != null)
            {
                foreach (var g in operationalGroupsData.Groups)
                {
                    var members = allStaff.Where(s => s.Groups.Contains(g.Name)).ToList();
                    list.Add(new GroupEntryView
                    {
                        Name = g.Name,
                        Kind = string.IsNullOrEmpty(g.Type) ? "Operational Group" : g.Type,
                        ParentStructure = g.Structure,
                        Staff = members
                    });
                }
            }

            // Functional teams
            if (teamData?.Rows != null)
            {
                foreach (var t in teamData.Rows.Where(r => r.Kind == "Team"))
                {
                    if (!list.Any(g => g.Name.Equals(t.Name, StringComparison.OrdinalIgnoreCase)))
                    {
                        var members = allStaff.Where(s => s.Groups.Contains(t.Name)).ToList();
                        list.Add(new GroupEntryView
                        {
                            Name = t.Name,
                            Kind = "Team",
                            ParentStructure = "",
                            Staff = members
                        });
                    }
                }
            }

            return list.OrderBy(g => g.Name);
        }
    }

    private GroupEntryView? ActiveGroupEntry =>
        GroupEntries.FirstOrDefault(g => g.Name == selectedGroupName) ?? GroupEntries.FirstOrDefault();

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !disposed)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", FullWidthSettingKey);
                if (!disposed && bool.TryParse(saved, out var val))
                {
                    isFullWidth = val;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", FullWidthSettingKey, isFullWidth.ToString());
        }
        catch { }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "department" && selectedDeptName == null)
        {
            selectedDeptName = DepartmentGroups.FirstOrDefault()?.Name;
        }
        else if (tab == "groups" && selectedGroupName == null)
        {
            selectedGroupName = GroupEntries.FirstOrDefault()?.Name;
        }
    }

    private void ResetFilters()
    {
        searchTerm = string.Empty;
        selectedDepartment = string.Empty;
        selectedGroup = string.Empty;
        selectedStatus = "all";
    }

    private void OpenPhotoModal(ManagedStaffMember staff)
    {
        activePhotoStaff = staff;
    }

    private void HandlePhotoUpdated(string? newPhoto)
    {
        if (activePhotoStaff != null)
        {
            lock (staffPhotos)
            {
                if (string.IsNullOrEmpty(newPhoto))
                {
                    staffPhotos.Remove(activePhotoStaff.IndividualId);
                }
                else
                {
                    staffPhotos[activePhotoStaff.IndividualId] = newPhoto;
                }
            }
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        if (disposed) return;
        busy = true;
        error = null;
        try
        {
            orgId = await Access.GetCurrentOrganisationIdAsync();
            var orgs = await Settings.GetTeamOrganisationsAsync();
            organisationName = orgs.FirstOrDefault(o => o.Id == orgId)?.Name ?? "Organisation";

            // 1. Load all staff rows
            var rawStaff = await Settings.GetStaffAsync(orgId);

            // 2. Load department and team structure
            teamData = await Settings.GetTeamSettingsAsync(orgId);

            // 3. Load operational groups safely
            try
            {
                operationalGroupsData = await Groups.LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Operational groups could not be loaded; continuing with standard staff records");
            }

            // 4. Fetch group memberships
            var groupStaffMap = new Dictionary<int, List<int>>();
            if (operationalGroupsData?.Groups != null)
            {
                var groupTasks = operationalGroupsData.Groups.Select(async g =>
                {
                    try
                    {
                        var details = await Directory.GetDetailsAsync(new OrganisationUnitKey(OrganisationUnitKind.Group, g.Id));
                        return (g.Id, Members: details?.CurrentStaff?.Select(s => s.StaffId).ToList() ?? []);
                    }
                    catch
                    {
                        return (g.Id, Members: (List<int>)[]);
                    }
                });

                var loadedGroupDetails = await Task.WhenAll(groupTasks);
                foreach (var gd in loadedGroupDetails)
                {
                    groupStaffMap[gd.Id] = gd.Members;
                }
            }

            // Build assigned group names per staff member
            var staffGroupNames = new Dictionary<int, List<string>>();

            if (operationalGroupsData?.Groups != null)
            {
                foreach (var g in operationalGroupsData.Groups)
                {
                    if (groupStaffMap.TryGetValue(g.Id, out var members))
                    {
                        foreach (var staffId in members)
                        {
                            if (!staffGroupNames.TryGetValue(staffId, out var list))
                            {
                                list = [];
                                staffGroupNames[staffId] = list;
                            }
                            if (!list.Contains(g.Name)) list.Add(g.Name);
                        }
                    }
                }
            }

            if (teamData?.Rows != null)
            {
                foreach (var team in teamData.Rows.Where(r => r.Kind == "Team"))
                {
                    foreach (var member in team.Members)
                    {
                        if (!staffGroupNames.TryGetValue(member.Id, out var list))
                        {
                            list = [];
                            staffGroupNames[member.Id] = list;
                        }
                        if (!list.Contains(team.Name)) list.Add(team.Name);
                    }
                }
            }

            // Build staff view model list
            allStaff = rawStaff.Select(r => new ManagedStaffMember
            {
                JobId = r.JobId,
                IndividualId = r.IndividualId,
                Name = r.Name,
                EmployeeNumber = r.EmployeeNumber,
                Department = r.Department,
                JobType = r.JobType,
                Status = r.Status,
                Groups = staffGroupNames.TryGetValue(r.IndividualId, out var grps) ? grps : []
            }).ToList();

            if (selectedDeptName == null)
            {
                selectedDeptName = DepartmentGroups.FirstOrDefault()?.Name;
            }
            if (selectedGroupName == null)
            {
                selectedGroupName = GroupEntries.FirstOrDefault()?.Name;
            }

            // Trigger non-blocking asynchronous photo loading for all distinct staff individuals
            var distinctStaffIds = allStaff.Select(s => s.IndividualId).Where(id => id > 0).Distinct().ToList();
            _ = LoadPhotosAsync(distinctStaffIds);
        }
        catch (Exception ex)
        {
            if (disposed) return;
            allStaff = [];
            Logger.LogError(ex, "Failed loading staff management data");
            error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Staff directory could not be loaded. Please refresh or contact HR.";
        }
        finally
        {
            if (!disposed) busy = false;
        }
    }

    private async Task LoadPhotosAsync(List<int> individualIds)
    {
        var throttler = new SemaphoreSlim(6);
        var tasks = individualIds.Select(async id =>
        {
            if (disposed) return;
            await throttler.WaitAsync();
            try
            {
                var photo = await Registry.GetPhotoAsync(id);
                if (!string.IsNullOrEmpty(photo))
                {
                    lock (staffPhotos)
                    {
                        staffPhotos[id] = photo;
                    }
                    if (!disposed)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Photo fetch failed for individual {Id}", id);
            }
            finally
            {
                throttler.Release();
            }
        });

        await Task.WhenAll(tasks);
    }

    private async Task ExportCsvAsync()
    {
        if (exporting) return;
        exportingCsv = true;
        try
        {
            var exportRows = FilteredStaff.Select(s => new StaffExportRow
            {
                IndividualId = s.IndividualId,
                Name = s.Name,
                EmployeeNumber = s.EmployeeNumber,
                Department = s.Department,
                JobType = s.JobType,
                Status = s.Status,
                Groups = string.Join("; ", s.Groups)
            }).ToList();

            var filterSummary = $"Tab: {activeTab} | Search: {(string.IsNullOrEmpty(searchTerm) ? "All" : searchTerm)} | Dept: {(string.IsNullOrEmpty(selectedDepartment) ? "All" : selectedDepartment)} | Group: {(string.IsNullOrEmpty(selectedGroup) ? "All" : selectedGroup)} | Status: {selectedStatus}";
            var bytes = StaffManagementExport.ToCsv(organisationName, filterSummary, exportRows);

            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await module.InvokeVoidAsync("download", $"staff-roster-{DateTime.Now:yyyyMMdd-HHmmss}.csv", "text/csv;charset=utf-8", reference);
            Toasts.Success("Staff roster CSV exported successfully.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export staff CSV");
            Toasts.Error("Staff CSV export failed. Please try again.");
        }
        finally
        {
            exportingCsv = false;
        }
    }

