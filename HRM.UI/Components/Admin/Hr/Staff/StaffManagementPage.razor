@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode RenderMode.InteractiveServer

@using HRM.DTOs.Organisation
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Components.Admin.Hr.Individual
@using HRM.Application.Contracts.Pages
@using Microsoft.JSInterop

@inject HRM.Services.Contracts.OrganisationSettingsServiceContracts.IOperations Settings
@inject HRM.Services.Contracts.GroupsManagementServiceContracts.IOperations Groups
@inject HRM.Application.Contracts.Pages.IOrganisationDirectoryQueries Directory
@inject HRM.Services.Interfaces.IIndividualRegistryService Registry
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject HRM.Services.ToastService Toasts
@inject IJSRuntime JS
@inject ILogger<StaffManagementPage> Logger
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<PageTitle>Staff Management - HR Portal</PageTitle>

<section class="staff-manage-page w-full min-w-0 p-1 space-y-4">
        <!-- Sticky Header conforming to UI Design Standard -->
        <header class="staff-manage-header sticky top-0 z-30 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/95 backdrop-blur-xs p-3 shadow-xs no-print">
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-lg font-bold text-slate-900">Staff Management</h1>
                    @if (!string.IsNullOrWhiteSpace(organisationName))
                    {
                        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">@organisationName</span>
                    }
                    <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">@allStaff.Count Total Staff</span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">Comprehensive workforce roster, department allocations, operational groups, and staff profiles.</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <!-- Full Width / Shrink View Toggle Button -->
                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
                        title="@(isFullWidth ? "Shrink to standard layout" : "Expand to full page width")"
                        @onclick="ToggleFullWidth">
                    @if (isFullWidth)
                    {
                        <AppIcon Name="fullscreen_exit" Class="h-4 w-4 text-slate-600 text-base" />
                        <span>Shrink View</span>
                    }
                    else
                    {
                        <AppIcon Name="fullscreen" Class="h-4 w-4 text-slate-600 text-base" />
                        <span>Full Width</span>
                    }
                </button>

                <!-- Export CSV Button -->
                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                        disabled="@(exporting || !FilteredStaff.Any())"
                        @onclick="ExportCsvAsync"
                        title="Export current staff list to CSV spreadsheet">
                    <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>@(exportingCsv ? "Exporting..." : "Export CSV")</span>
                </button>

                <!-- Export PDF Button -->
                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                        disabled="@(exporting || !FilteredStaff.Any())"
                        @onclick="ExportPdfAsync"
                        title="Export current staff list to PDF report">
                    <svg class="h-4 w-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <span>@(exportingPdf ? "Generating..." : "Export PDF")</span>
                </button>

                <!-- Refresh Button -->
                <button type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                        disabled="@busy"
                        @onclick="LoadAsync"
                        title="Reload staff records and group assignments">
                    <span class="@(busy ? "animate-spin" : "")">↻</span>
                    <span>Refresh</span>
                </button>

                <!-- Add / Onboard Staff Action Button -->
                <a class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition-colors"
                   href="/admin/my/workspace/onboarding?tab=add-individual">
                    <span>+</span>
                    <span>Onboard Staff</span>
                </a>
            </div>
        </header>

        <!-- Error Banner -->
        @if (!string.IsNullOrEmpty(error))
        {
            <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 no-print">
                <div class="flex items-center gap-2">
                    <span class="text-base">⚠️</span>
                    <span>@error</span>
                </div>
                <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 hover:text-rose-800">✕</button>
            </div>
        }

        <!-- KPI Metric Summary Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 no-print">
            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Total Staff</span>
                    <span class="text-xl font-bold text-slate-900">@allStaff.Count</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <span class="text-lg">💼</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Active Staff</span>
                    <span class="text-xl font-bold text-slate-900">@allStaff.Count(s => s.IsActive)</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <span class="text-lg">✅</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Departments</span>
                    <span class="text-xl font-bold text-slate-900">@DepartmentCount</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                    <span class="text-lg">🏢</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Groups & Teams</span>
                    <span class="text-xl font-bold text-slate-900">@GroupCount</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-50 text-purple-600">
                    <span class="text-lg">🏷️</span>
                </div>
            </div>
        </div>

        <!-- View Segmented Tabs & Filters Toolbar -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex flex-col gap-3 no-print">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
                <!-- View Tabs Switcher -->
                <div class="flex rounded-lg border border-slate-300 p-0.5 bg-slate-50">
                    <button type="button"
                            class="px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all flex items-center gap-1.5 @(activeTab == "all" ? "bg-white text-blue-700 shadow-xs" : "text-slate-600 hover:text-slate-900")"
                            @onclick='() => SetTab("all")'>
                        <span>👥</span>
                        <span>All Staff</span>
                        <span class="ml-1 rounded-full bg-slate-200/70 px-1.5 py-0.2 text-[10px] text-slate-700">@allStaff.Count</span>
                    </button>
                    <button type="button"
                            class="px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all flex items-center gap-1.5 @(activeTab == "department" ? "bg-white text-blue-700 shadow-xs" : "text-slate-600 hover:text-slate-900")"
                            @onclick='() => SetTab("department")'>
                        <span>🏢</span>
                        <span>Staff by Department</span>
                        <span class="ml-1 rounded-full bg-slate-200/70 px-1.5 py-0.2 text-[10px] text-slate-700">@DepartmentCount</span>
                    </button>
                    <button type="button"
                            class="px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all flex items-center gap-1.5 @(activeTab == "groups" ? "bg-white text-blue-700 shadow-xs" : "text-slate-600 hover:text-slate-900")"
                            @onclick='() => SetTab("groups")'>
                        <span>🏷️</span>
                        <span>Staff by Groups</span>
                        <span class="ml-1 rounded-full bg-slate-200/70 px-1.5 py-0.2 text-[10px] text-slate-700">@GroupCount</span>
                    </button>
                </div>

                <!-- Active Filter Counter & Reset Button -->
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-500">
                        Showing <strong class="text-slate-800">@FilteredStaff.Count()</strong> of <strong class="text-slate-800">@allStaff.Count</strong> staff
                    </span>
                    @if (HasActiveFilters)
                    {
                        <button type="button"
                                class="text-xs font-medium text-blue-600 hover:text-blue-800 underline ml-1"
                                @onclick="ResetFilters">
                            Reset filters
                        </button>
                    }
                </div>
            </div>

            <!-- Filter Controls Bar -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
                <!-- Search Text Filter -->
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">🔍</span>
                    <input type="text"
                           class="w-full rounded-lg border border-slate-300 bg-white pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                           placeholder="Search name, employee #, position..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button type="button"
                                class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600 text-xs font-bold"
                                @onclick="() => searchTerm = string.Empty">✕</button>
                    }
                </div>

                <!-- Department Filter Dropdown -->
                <div>
                    <select class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            @bind="selectedDepartment">
                        <option value="">All Departments</option>
                        @foreach (var dept in DepartmentsList)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>

                <!-- Group / Team Filter Dropdown -->
                <div>
                    <select class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            @bind="selectedGroup">
                        <option value="">All Groups & Teams</option>
                        @foreach (var grp in GroupsList)
                        {
                            <option value="@grp">@grp</option>
                        }
                    </select>
                </div>

                <!-- Status Filter Dropdown -->
                <div>
                    <select class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            @bind="selectedStatus">
                        <option value="all">All Employment Statuses</option>
                        <option value="active">Active Employees Only</option>
                        <option value="inactive">Inactive / Former Only</option>
                    </select>
                </div>
            </div>
        </div>

        @if (busy)
        {
            <div role="status" class="flex flex-col items-center justify-center p-16 text-slate-500 rounded-2xl border border-slate-200 bg-white shadow-xs">
                <div class="h-8 w-8 animate-spin rounded-full border-2 border-blue-600 border-t-transparent mb-3"></div>
                <span class="text-xs font-semibold text-slate-700">Loading staff directory and assignments…</span>
            </div>
        }
        else if (activeTab == "all")
        {
            <!-- ========================================== -->
            <!-- TAB 1: ALL STAFF ROSTER VIEW               -->
            <!-- ========================================== -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-xs overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-3 w-12 text-center">Photo</th>
                                <th class="p-3">Staff Name</th>
                                <th class="p-3">Employee #</th>
                                <th class="p-3">Department</th>
                                <th class="p-3">Job Type / Position</th>
                                <th class="p-3">Assigned Groups</th>
                                <th class="p-3">Status</th>
                                <th class="p-3 text-center no-print w-28">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!FilteredStaff.Any())
                            {
                                <tr>
                                    <td colspan="8" class="p-10 text-center text-slate-400">
                                        <div class="flex flex-col items-center justify-center gap-1.5">
                                            <span class="text-3xl">📭</span>
                                            <span class="text-sm font-semibold text-slate-700">No staff members found</span>
                                            <span class="text-xs text-slate-500">Try adjusting your search criteria or resetting filters.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var staff in FilteredStaff)
                                {
                                    <tr @key="staff.JobId" class="hover:bg-slate-50/70 transition-colors">
                                        <!-- Photo Avatar -->
                                        <td class="p-3 text-center">
                                            <div class="relative group inline-block">
                                                @if (staffPhotos.TryGetValue(staff.IndividualId, out var photoUrl) && !string.IsNullOrEmpty(photoUrl))
                                                {
                                                    <img src="@photoUrl"
                                                         alt="@staff.Name"
                                                         class="h-9 w-9 rounded-full object-cover border border-slate-200 shadow-2xs" />
                                                }
                                                else
                                                {
                                                    <div class="h-9 w-9 rounded-full @GetAvatarBg(staff.Name) flex items-center justify-center text-xs font-bold shadow-2xs">
                                                        @GetInitials(staff.Name)
                                                    </div>
                                                }

                                                <!-- Photo Edit Quick Button overlay -->
                                                <button type="button"
                                                        class="absolute inset-0 rounded-full bg-slate-900/60 text-white opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-[11px] shadow-sm no-print"
                                                        title="Add or change photo for @staff.Name"
                                                        @onclick="() => OpenPhotoModal(staff)">
                                                    📷
                                                </button>
                                            </div>
                                        </td>

                                        <!-- Staff Name -->
                                        <td class="p-3">
                                            <a href="@($"/admin/my/workspace/staff/{staff.IndividualId}/overview")"
                                               class="font-semibold text-slate-900 hover:text-blue-600 transition flex items-center gap-1"
                                               title="Open 360 profile for @staff.Name">
                                                <span>@staff.Name</span>
                                            </a>
                                            <span class="text-[11px] text-slate-400 block font-mono">ID: @staff.IndividualId</span>
                                        </td>

                                        <!-- Employee Number -->
                                        <td class="p-3">
                                            @if (!string.IsNullOrWhiteSpace(staff.EmployeeNumber))
                                            {
                                                <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md inline-block">
                                                    @staff.EmployeeNumber
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400 text-[11px] italic">Not assigned</span>
                                            }
                                        </td>

                                        <!-- Department -->
                                        <td class="p-3">
                                            <div class="flex items-center gap-1.5 text-slate-700">
                                                <span class="text-slate-400">🏢</span>
                                                <span>@(string.IsNullOrWhiteSpace(staff.Department) ? "Unassigned" : staff.Department)</span>
                                            </div>
                                        </td>

                                        <!-- Job Type / Position -->
                                        <td class="p-3 text-slate-600">
                                            <span>@staff.JobType</span>
                                        </td>

                                        <!-- Assigned Groups / Teams -->
                                        <td class="p-3">
                                            @if (staff.Groups.Any())
                                            {
                                                <div class="flex flex-wrap gap-1 max-w-xs">
                                                    @foreach (var g in staff.Groups)
                                                    {
                                                        <span class="rounded-full bg-purple-50 border border-purple-200 px-2 py-0.5 text-[10px] font-medium text-purple-700">
                                                            @g
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400 text-[11px] italic">-</span>
                                            }
                                        </td>

                                        <!-- Status Badge -->
                                        <td class="p-3">
                                            @if (staff.IsActive)
                                            {
                                                <span class="bg-emerald-100 text-emerald-800 rounded-full px-2.5 py-0.5 font-semibold text-[11px] inline-flex items-center gap-1">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
                                                    <span>@staff.Status</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="bg-slate-100 text-slate-700 rounded-full px-2 py-0.5 text-[11px] font-medium inline-flex items-center gap-1">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                                    <span>@staff.Status</span>
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions -->
                                        <td class="p-3 text-center no-print">
                                            <div class="flex items-center justify-center gap-1.5">
                                                <a href="@($"/admin/my/workspace/staff/{staff.IndividualId}/overview")"
                                                   class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition shadow-2xs"
                                                   title="View 360 Workspace Profile">
                                                    <span>Profile</span>
                                                    <span>→</span>
                                                </a>
                                                <button type="button"
                                                        class="p-1 rounded-lg border border-slate-200 text-slate-500 hover:text-blue-600 hover:bg-blue-50 transition shadow-2xs"
                                                        title="Add or update photo"
                                                        @onclick="() => OpenPhotoModal(staff)">
                                                    📷
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == "department")
        {
            <!-- ========================================== -->
            <!-- TAB 2: STAFF BY DEPARTMENT VIEW            -->
            <!-- ========================================== -->
            <div class="page-panels @(isFullWidth ? "page-panels-full" : "page-panels-standard")">
                <!-- Left Panel: Department Directory -->
                <div class="page-panel-left min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex flex-col gap-3">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                        <div>
                            <h2 class="text-sm font-bold text-slate-900">Departments Directory</h2>
                            <p class="text-xs text-slate-500">Select a department to view assigned personnel.</p>
                        </div>
                        <span class="text-xs font-semibold rounded-full bg-blue-50 text-blue-700 px-2 py-0.5 border border-blue-200">
                            @DepartmentGroups.Count() departments
                        </span>
                    </div>

                    <!-- Department List -->
                    <div class="flex flex-col gap-2 max-h-[600px] overflow-y-auto pr-1">
                        @foreach (var dept in DepartmentGroups)
                        {
                            var isSelected = selectedDeptName == dept.Name;
                            <div class="rounded-xl border p-3 text-xs transition cursor-pointer hover:shadow-xs flex flex-col gap-2 @(isSelected ? "border-blue-500 bg-blue-50/70 shadow-xs ring-1 ring-blue-500" : "border-slate-200 bg-white hover:border-slate-300")"
                                 @onclick="() => selectedDeptName = dept.Name">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <div class="h-8 w-8 rounded-lg @(isSelected ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-600") flex items-center justify-center text-sm font-bold shrink-0">
                                            🏢
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-slate-900 text-xs">@dept.Name</h3>
                                            @if (!string.IsNullOrEmpty(dept.StructureType))
                                            {
                                                <span class="text-[10px] text-slate-500">@dept.StructureType</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="rounded-full bg-slate-100 text-slate-700 px-2 py-0.5 text-[11px] font-semibold shrink-0">
                                        @dept.Staff.Count staff
                                    </span>
                                </div>

                                @if (dept.Supervisors.Any())
                                {
                                    <div class="flex items-center gap-1 text-[11px] text-slate-600 border-t border-slate-100/80 pt-1.5 mt-0.5">
                                        <span class="text-indigo-600 font-semibold">Lead:</span>
                                        <span class="truncate">@string.Join(", ", dept.Supervisors)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Panel: Selected Department Roster -->
                <aside class="page-panel-right min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex flex-col gap-3">
                    @if (ActiveDepartmentGroup != null)
                    {
                        var dept = ActiveDepartmentGroup;
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3 flex-wrap gap-2">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 class="text-base font-bold text-slate-900">@dept.Name</h2>
                                    @if (!string.IsNullOrEmpty(dept.StructureType))
                                    {
                                        <span class="rounded-full bg-purple-100 text-purple-800 px-2 py-0.5 text-[10px] font-semibold">@dept.StructureType</span>
                                    }
                                </div>
                                @if (dept.Supervisors.Any())
                                {
                                    <p class="text-xs text-slate-500 mt-0.5">
                                        Supervisors: <strong class="text-slate-700">@string.Join(", ", dept.Supervisors)</strong>
                                    </p>
                                }
                            </div>
                            <span class="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 text-xs font-semibold">
                                @dept.Staff.Count Assigned Staff
                            </span>
                        </div>

                        <!-- Department Staff List -->
