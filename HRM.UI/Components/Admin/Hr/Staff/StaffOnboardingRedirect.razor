@page "/admin/hr/onboarding"
@attribute [Authorize]
@inject NavigationManager Navigation
<p role="status">Opening staff onboarding…</p>
@code {
    protected override void OnInitialized()
    {
        var uri=new Uri(Navigation.Uri);
        Navigation.NavigateTo("/admin/my/workspace/onboarding"+uri.Query+uri.Fragment,replace:true);
    }
}
