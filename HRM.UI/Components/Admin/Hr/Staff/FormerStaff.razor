@implements IDisposable
@using HRM.Services
@inject HRM.Services.Contracts.FormerStaffServiceContracts.IOperations Records
@inject ILogger<FormerStaff> Logger
<section class="space-y-3 p-3" aria-busy="@loading">
    <h1 class="text-xl font-semibold">Former Staff</h1>
    <p class="text-sm text-slate-500">Read-only staff records. @data?.Organisation</p>
    <div class="flex flex-wrap items-end gap-3">
        <label class="min-w-0 flex-1 text-sm">Search former staff<input type="search" @bind="search" @bind:event="oninput" @bind:after="SearchChanged" maxlength="250" placeholder="Name, employee number, national ID or passport" class="mt-1 block w-full rounded border bg-transparent p-2" /></label>
        <label class="text-sm">Department<select id="former-department" @bind="department" @bind:after="ApplyFilters" class="mt-1 block w-full rounded border bg-transparent p-2"><option value="">All departments</option>@foreach(var option in departments){<option value="@option.Id">@option.Name</option>}</select></label>
        <label class="text-sm">Job Type<select id="former-job-type" @bind="jobType" @bind:after="ApplyFilters" class="mt-1 block w-full rounded border bg-transparent p-2"><option value="">All Job Types</option>@foreach(var option in jobTypes){<option value="@option.Id">@option.Name</option>}</select></label>
        <label class="text-sm">Ended from<input id="former-from" type="date" @bind="from" @bind:after="ApplyFilters" class="mt-1 block w-full rounded border bg-transparent p-2" /></label>
        <label class="text-sm">Ended to<input id="former-to" type="date" @bind="to" @bind:after="ApplyFilters" class="mt-1 block w-full rounded border bg-transparent p-2" /></label>
        <label class="text-sm">Verification state<select id="former-verification" @bind="verified" @bind:after="ApplyFilters" class="mt-1 block w-full rounded border bg-transparent p-2"><option value="">All verification states</option><option value="-1">Not set</option>@foreach(var option in verifiedStates){<option value="@option.Id">@option.Name</option>}</select></label>
        <label class="text-sm">Business entity state<select id="former-entity-state" @bind="entityState" @bind:after="ApplyFilters" class="mt-1 block w-full rounded border bg-transparent p-2"><option value="">All entity states</option><option value="-1">Not set</option>@foreach(var option in entityStates){<option value="@option.Id">@option.Name</option>}</select></label>
        <button type="button" class="app-button app-button-secondary" @onclick="Reset">Reset</button>
    </div>
    @if(error!=null){<p role="alert" class="rounded border p-3 text-sm">@error</p>}
    @if(data!=null)
    {
        <HRM.Components.Shared.AttendanceExportButtons CreateReport="ListReport" Disabled="@(loading||data.Staff.Count==0)" />
        <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b"><th class="p-2">Staff</th><th class="p-2">Employee number</th><th class="p-2">Department / job type</th><th class="p-2">Employment dates</th><th class="p-2">Registry states</th><th class="p-2">View</th></tr></thead><tbody>
        @foreach(var row in data.Staff.Skip((page-1)*25).Take(25))
        {
            <tr @key="row.Id" class="border-b"><td class="p-2">@row.Name<br />@row.NationalId @row.Passport</td><td class="p-2">@row.EmployeeNumber</td><td class="p-2">@row.Department<br />@row.JobType</td><td class="p-2">@row.Joined.ToString("dd MMM yyyy") – @row.Ended?.ToString("dd MMM yyyy")</td><td class="p-2">@row.VerificationState<br />@row.EntityState</td><td class="p-2"><div class="flex flex-wrap gap-2"><a class="app-button app-button-secondary" href="@($"/admin/my/workspace/onboarding?formerStaffId={row.Id}")">View record</a>@if(ForOnboarding){<a class="app-button app-button-primary" href="@($"/admin/my/workspace/onboarding?individualId={row.Id}")">New appointment</a>}</div></td></tr>
        }
        @if(data.Staff.Count==0){<tr><td colspan="6" class="p-3">No former staff found.</td></tr>}
        </tbody></table></div>
        <div class="flex flex-wrap items-center gap-3 text-sm"><button class="app-button app-button-secondary" disabled="@(page<=1)" @onclick="()=>page--">Previous</button><span>Page @(page) of @Pages · @data.Staff.Count staff</span><button class="app-button app-button-secondary" disabled="@(page>=Pages)" @onclick="()=>page++">Next</button></div>
    }
    @if(loading){<p role="status">Loading former staff…</p>}
</section>
@code {
    [Parameter] public bool ForOnboarding { get; set; }
    private FormerStaffData? data;private string search="";private string? error;private bool loading,disposed;private int version,page=1;private CancellationTokenSource? pending;
    private int? department,jobType,verified,entityState;private DateTime? from,to;
    private List<FormerStaffChoice> departments=[],jobTypes=[],verifiedStates=[],entityStates=[];
    private int Pages=>Math.Max(1,((data?.Staff.Count??0)+24)/25);
    private AttendanceExportReport ListReport()=>new("Former staff",$"{data?.Organisation} · {data?.FilterDescription}",[new("Former staff",["Name","Employee number","National ID","Passport","Department","Job type","Joined","Ended","Verification state","Business entity state"],data!.Staff.Select(r=>new object?[]{r.Name,r.EmployeeNumber,r.NationalId,r.Passport,r.Department,r.JobType,r.Joined.ToString("yyyy-MM-dd"),r.Ended?.ToString("yyyy-MM-dd"),r.VerificationState,r.EntityState}).ToList())]);
    protected override Task OnInitializedAsync()=>Load(false);
    private Task SearchChanged(){page=1;return Load(true);}
    private Task ApplyFilters(){page=1;return Load(false);}
    private Task Reset(){search="";department=jobType=verified=entityState=null;from=to=null;page=1;return Load(false);}
    private async Task Load(bool debounce)
    {
        pending?.Cancel();pending?.Dispose();pending=new();var ct=pending.Token;var current=++version;var text=search;var filters=new FormerStaffFilters(department,jobType,from,to,verified,entityState);loading=true;error=null;
        try{if(debounce)await Task.Delay(300,ct);var result=await Records.SearchAsync(text,ct,filters);if(current==version&&!disposed){data=result;departments=result.Departments;jobTypes=result.JobTypes;verifiedStates=result.VerifiedStates;entityStates=result.EntityStates;page=Math.Min(page,Pages);}}
        catch(OperationCanceledException)when(ct.IsCancellationRequested){}
        catch(Exception ex){if(current==version&&!disposed){data=null;Logger.LogError(ex,"Former staff search");error=ex is InvalidOperationException or UnauthorizedAccessException?ex.Message:"Former staff could not be loaded. Please try again.";}}
        finally{if(current==version&&!disposed)loading=false;}
    }
    public void Dispose(){disposed=true;pending?.Cancel();pending?.Dispose();}
}
