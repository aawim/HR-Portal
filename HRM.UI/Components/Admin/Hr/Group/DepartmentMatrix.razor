@page "/admin/hr/departments/matrix"
@page "/admin/hr/departments/department-matrix"
@page "/admin/hr/departments/department-metrix"
@using HRM.DTOs
@inject HRM.Services.Contracts.OrganisationWorkspaceServiceContracts.IOperations Workspace
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject HRM.Services.Interfaces.IUserContext UserContext
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<section class="department-matrix-page w-full min-w-0 p-2 flex flex-col gap-3">
    <!-- Sticky Header -->
    <header class="sticky top-0 z-30 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/95 backdrop-blur-xs p-3 shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <h1 id="department-status-heading" class="text-lg font-bold text-slate-900">Department Status & Matrix</h1>
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">Workforce Capacity</span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">Departments with assigned staff: total headcount, on leave, and available operational capacity.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs">
            <!-- Filter: On Leave Only -->
            <label class="inline-flex items-center gap-1.5 cursor-pointer select-none rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors">
                <input type="checkbox"
                       class="rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                       @bind="departmentsOnLeaveOnly" />
                <span>Staff on leave only</span>
            </label>

            <!-- Refresh Button -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                    disabled="@isLoading"
                    @onclick="LoadData">
                <span>↻</span>
                <span>Refresh</span>
            </button>
        </div>
    </header>

    @if (isLoading)
    {
        <div role="status" class="flex flex-col items-center justify-center p-16 text-slate-500 rounded-2xl border border-slate-200 bg-white shadow-xs">
            <div class="h-8 w-8 animate-spin rounded-full border-2 border-blue-600 border-t-transparent mb-3"></div>
            <span class="text-xs font-semibold text-slate-700">Loading department status matrix…</span>
        </div>
    }
    else if (organisation == null)
    {
        <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700">
            Unable to load organisation workspace data. Please verify your permissions or refresh.
        </div>
    }
    else
    {
        <!-- Summary KPI Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Monitored Departments</span>
                    <span class="text-xl font-bold text-slate-900">@TotalDepartmentsCount</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <span class="text-lg">🏢</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Total Workforce</span>
                    <span class="text-xl font-bold text-slate-900">@TotalStaffCount</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <span class="text-lg">👥</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Staff On Leave</span>
                    <span class="text-xl font-bold @(TotalOnLeaveCount > 0 ? "text-rose-600" : "text-slate-900")">
                        @TotalOnLeaveCount
                    </span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-600">
                    <span class="text-lg">🏖️</span>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs flex items-center justify-between">
                <div>
                    <span class="block text-xs font-medium text-slate-500">Overall Availability</span>
                    <span class="text-xl font-bold text-emerald-600">@OverallCapacityPercent%</span>
                </div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <span class="text-lg">⚡</span>
                </div>
            </div>
        </div>

        <!-- Department Cards Grid -->
        <div id="department-status-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            @foreach (var dep in DisplayedDepartments)
            {
                <article class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col gap-3 shadow-xs hover:border-slate-300 hover:shadow-sm transition-all">
                    <header class="flex items-center justify-between gap-2 pb-2 border-b border-slate-100">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="text-base shrink-0">🏢</span>
                            <h3 class="text-xs font-bold text-slate-900 truncate" title="@dep.DepartmentName">
                                @dep.DepartmentName
                            </h3>
                        </div>
                        <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold shrink-0 @(dep.OnLeaveValue > 0 ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">
                            @(dep.OnLeaveValue > 0 ? $"{dep.OnLeaveValue} on leave" : "Full staff")
                        </span>
                    </header>

                    <dl class="grid grid-cols-3 gap-2 py-1 text-center bg-slate-50/70 rounded-lg p-2 border border-slate-100">
                        <div>
                            <dt class="text-[10px] uppercase font-bold text-slate-400">Total</dt>
                            <dd class="text-xs font-bold text-slate-800 mt-0.5">@dep.TotalValue</dd>
                        </div>
                        <div>
                            <dt class="text-[10px] uppercase font-bold text-slate-400">On Leave</dt>
                            <dd class="text-xs font-bold @(dep.OnLeaveValue > 0 ? "text-rose-600" : "text-slate-600") mt-0.5">
                                @dep.OnLeaveValue
                            </dd>
                        </div>
                        <div>
                            <dt class="text-[10px] uppercase font-bold text-slate-400">Active</dt>
                            <dd class="text-xs font-bold text-emerald-700 mt-0.5">@dep.AvailableValue</dd>
                        </div>
                    </dl>

                    <div class="space-y-1.5 pt-1">
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-slate-500 text-[11px]">Active Capacity</span>
                            <strong class="text-slate-800 font-semibold">@dep.AvailablePercent%</strong>
                        </div>
                        <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-300 @(dep.AvailablePercent >= 80 ? "bg-emerald-500" : dep.AvailablePercent >= 50 ? "bg-amber-500" : "bg-rose-500")"
                                 style="width: @(Math.Clamp(dep.AvailablePercent, 0, 100))%"></div>
                        </div>
                    </div>
                </article>
            }

            @if (!DisplayedDepartments.Any())
            {
                <div class="col-span-full rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center text-xs text-slate-500">
                    <p class="font-semibold text-slate-700">No departments match the criteria</p>
                    <p class="mt-1">
                        @(departmentsOnLeaveOnly ? "No departments currently have staff on leave." : "No departments found with active staff.")
                    </p>
                </div>
            }
        </div>
    }
</section>

@code {
    private OrganisationWorkspaceData? organisation;
    private bool departmentsOnLeaveOnly = false;
    private bool isLoading = true;
    private bool disposed;

    public void Dispose()
    {
        disposed = true;
    }

    private int TotalDepartmentsCount => DepartmentStatus.Count();
    private int TotalStaffCount => DepartmentStatus.Sum(d => d.TotalValue);
    private int TotalOnLeaveCount => DepartmentStatus.Sum(d => d.OnLeaveValue);
    private int OverallCapacityPercent => TotalStaffCount > 0
        ? (int)Math.Round((TotalStaffCount - TotalOnLeaveCount) / (double)TotalStaffCount * 100)
        : 100;

    protected override Task OnInitializedAsync() => LoadData();

    private async Task LoadData()
    {
        if (disposed) return;
        isLoading = true;
        try
        {
            var organisationId = await Access.GetCurrentOrganisationIdAsync();
            if (disposed) return;
            organisation = await Workspace.LoadAsync(organisationId);
        }
        catch
        {
            if (disposed) return;
            organisation = null;
        }
        finally
        {
            if (!disposed)
            {
                isLoading = false;
            }
        }
    }

    private IEnumerable<(string DepartmentName, int OnLeaveValue, int AvailableValue, int TotalValue, int AvailablePercent)> DepartmentStatus =>
        (organisation?.Departments ?? [])
            .Where(d => d.Members > 0)
            .Select(d => {
                var staff = (organisation?.Workforce ?? []).Where(s => s.DepartmentId == d.Id).Select(s => s.IndividualId).Distinct().ToList();
                var total = staff.Count;
                var onLeave = staff.Count(id => organisation!.OnLeaveStaffIds.Contains(id));
                var available = total - onLeave;
                var percent = total > 0 ? (int)Math.Round(available / (double)total * 100) : 0;
                return (DepartmentName: d.Name, OnLeaveValue: onLeave, AvailableValue: available, TotalValue: total, AvailablePercent: percent);
            });

    private IEnumerable<(string DepartmentName, int OnLeaveValue, int AvailableValue, int TotalValue, int AvailablePercent)> DisplayedDepartments =>
        DepartmentStatus
            .Where(d => !departmentsOnLeaveOnly || d.OnLeaveValue > 0)
            .OrderByDescending(d => d.OnLeaveValue)
            .ThenBy(d => d.DepartmentName);
}
