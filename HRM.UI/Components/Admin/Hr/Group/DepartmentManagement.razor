@inject HRM.Services.Contracts.OrganisationSettingsServiceContracts.IOperations Settings
@inject ILogger<DepartmentManagement> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using HRM.DTOs.Organisation
@implements IDisposable

<section class="departments-page w-full min-w-0 @(HideHeader ? "" : "p-2") flex flex-col gap-3">
    @if (!HideHeader)
    {
    <!-- Full-Width Sticky Header -->
    <header class="departments-header sticky top-0 z-30 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/95 backdrop-blur-xs p-3 shadow-xs">
        <div class="flex items-center gap-3">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
                    aria-label="Go back to previous page"
                    @onclick="GoBack">
                <span aria-hidden="true">←</span>
                <span>Back</span>
            </button>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-lg font-bold text-slate-900">Departments Management</h1>
                    @if (!string.IsNullOrWhiteSpace(organisation))
                    {
                        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">@organisation</span>
                    }
                </div>
                <p class="text-xs text-slate-500 mt-0.5">Approved departments, supervisors, and assigned workforce roster.</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Full Width / Shrink View Toggle Button -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
                    title="@(isFullWidth ? "Shrink to standard layout" : "Expand to full page width")"
                    @onclick="ToggleFullWidth">
                @if (isFullWidth)
                {
                    <AppIcon Name="fullscreen_exit" Class="h-4 w-4 text-slate-600 text-base" />
                    <span>Shrink View</span>
                }
                else
                {
                    <AppIcon Name="fullscreen" Class="h-4 w-4 text-slate-600 text-base" />
                    <span>Full Width</span>
                }
            </button>

            <!-- Refresh Button -->
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                    disabled="@busy"
                    @onclick="Load">
                <span>↻</span>
                <span>Refresh</span>
            </button>

            <!-- Quick Link: Manage Supervisors -->
            <a class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700 shadow-xs hover:bg-indigo-100 transition-colors"
               href="@($"/admin/hr/supervisors/management?organisationId={orgId}&teamView=departments")">
                <span>👥</span>
                <span>Manage Supervisors</span>
            </a>

            <!-- Quick Link: Structure Types -->
            <a class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
               href="/admin/settings/org/types">
                <span>⚙️</span>
                <span>Structure Types</span>
            </a>
        </div>
    </header>
    }

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50 dark:bg-rose-950/40 p-3 text-xs text-rose-800 dark:text-rose-200">
            <span>@error</span>
            <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 dark:text-rose-300 hover:text-rose-800">✕</button>
        </div>
    }

    @if (data != null)
    {
        <!-- Narrow Sub-Navigation & Inline KPI Bar (UI_DESIGN_STANDARD Section 6.5) -->
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex flex-wrap items-center gap-1" role="tablist" aria-label="Department status filter">
                <button type="button" role="tab" aria-selected="@(statusFilter == "all")"
                        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(statusFilter == "all" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                        @onclick='() => statusFilter = "all"'>
                    <span>All</span>
                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.2 text-[10px] font-bold text-slate-600 dark:text-slate-300">@TotalDepartmentCount</span>
                </button>
                <button type="button" role="tab" aria-selected="@(statusFilter == "staff")"
                        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(statusFilter == "staff" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                        @onclick='() => statusFilter = "staff"'>
                    <span>With Staff</span>
                </button>
                <button type="button" role="tab" aria-selected="@(statusFilter == "nosup")"
                        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(statusFilter == "nosup" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                        @onclick='() => statusFilter = "nosup"'>
                    <span>No Lead</span>
                    @if (TotalDepartmentCount - SupervisedDepartmentCount > 0)
                    {
                        <span class="rounded-full bg-amber-100 dark:bg-amber-900/50 px-1.5 py-0.2 text-[10px] font-bold text-amber-800 dark:text-amber-200">@(TotalDepartmentCount - SupervisedDepartmentCount)</span>
                    }
                </button>
            </div>

            <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
                <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>Departments: <strong class="text-slate-800 dark:text-slate-100">@TotalDepartmentCount</strong></span>
                <span>·</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Workforce: <strong class="text-slate-800 dark:text-slate-100">@TotalStaffCount</strong></span>
                <span>·</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>With Leads: <strong class="text-slate-800 dark:text-slate-100">@SupervisedDepartmentCount</strong></span>
                <span>·</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-violet-500"></span>Types: <strong class="text-slate-800 dark:text-slate-100">@data.StructureTypes.Count</strong></span>

                @if (HideHeader)
                {
                    <button type="button"
                            class="app-button app-button-secondary app-button-sm ml-1"
                            disabled="@busy"
                            @onclick="Load">
                        <AppIcon Name="refresh" Class="@(busy ? "animate-spin text-xs" : "text-xs")" />
                        <span>Refresh</span>
                    </button>
                    <a class="app-button app-button-neutral app-button-sm"
                       href="@($"/admin/hr/supervisors/management?organisationId={orgId}&teamView=departments")">
                        <AppIcon Name="groups" Class="text-xs" />
                        <span>Supervisors</span>
                    </a>
                }
            </div>
        </div>

        <!-- 2-Panel Master-Detail Layout -->
        <div class="page-panels @(HideHeader || isFullWidth ? "page-panels-full" : "page-panels-standard")">

            <!-- LEFT PANEL: Department Directory Table & Filters (UI_DESIGN_STANDARD Section 7) -->
            <div class="page-panel-left min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden flex flex-col">
                <!-- Filter Card Header -->
                <div class="border-b border-slate-200 dark:border-slate-800 p-3.5 space-y-2.5">
                    <div class="flex items-center justify-between gap-2">
                        <div>
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-100">Departments Directory</h2>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">
                                Showing @Filtered.Count() of @TotalDepartmentCount departments
                            </p>
                        </div>
                        @if (Filtered.Count() != TotalDepartmentCount)
                        {
                            <button type="button"
                                    class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
                                    @onclick="ResetFilters">
                                Reset filters
                            </button>
                        }
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300 mb-1">Search department</label>
                            <div class="relative">
                                <input type="text"
                                       class="h-8 w-full rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 pr-7 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                       placeholder="Department name..."
                                       @bind="search"
                                       @bind:event="oninput" />
                                @if (!string.IsNullOrWhiteSpace(search))
                                {
                                    <button type="button"
                                            class="absolute inset-y-0 right-0 pr-2 flex items-center text-slate-400 hover:text-slate-600 text-xs"
                                            @onclick="() => search = string.Empty">✕</button>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-medium text-slate-700 dark:text-slate-300 mb-1">Structure type</label>
                            <select class="h-8 w-full rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-800 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                    @bind="type">
                                <option value="0">All structure types</option>
                                @foreach (var t in data.StructureTypes)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Enterprise Zebra-Striped Data Table -->
                @{
                    var filteredList = Filtered.ToList();
                }
                @if (filteredList.Count == 0)
                {
                    <div class="p-8 text-center text-xs text-slate-500 dark:text-slate-400">
                        <p class="font-semibold text-slate-700 dark:text-slate-200">No matching departments</p>
                        <p class="mt-1">Try adjusting your search query or structure type filter.</p>
                        <button type="button"
                                class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
                                @onclick="ResetFilters">
                            Reset all filters
                        </button>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto overflow-y-auto" style="max-height: 600px; scrollbar-gutter: stable;">
                        <table class="min-w-full divide-y divide-slate-200/80 dark:divide-slate-800 text-left text-xs">
                            <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/90 text-[10px] font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300">
                                <tr>
                                    <th class="px-3.5 py-2.5">Department</th>
                                    <th class="px-3.5 py-2.5">Type</th>
                                    <th class="px-3.5 py-2.5">Lead</th>
                                    <th class="px-3.5 py-2.5 text-right">Staff</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @for (var i = 0; i < filteredList.Count; i++)
                                {
                                    var row = filteredList[i];
                                    var isSelected = selected?.Id == row.Id;
                                    var hasSup = row.Supervisors.Any();
                                    var typeName = data.StructureTypes.FirstOrDefault(t => t.Id == row.StructureTypeId)?.Name ?? "Department";
                                    var isAlt = i % 2 == 1;

                                    <tr @key="row.Id"
                                        tabindex="0"
                                        class="cursor-pointer transition-colors @(isSelected ? "bg-blue-50/90 dark:bg-blue-950/40" : isAlt ? "bg-[#f3f8fd] dark:bg-slate-800/30 hover:bg-blue-50/50 dark:hover:bg-slate-800/60" : "bg-white dark:bg-slate-900 hover:bg-blue-50/50 dark:hover:bg-slate-800/60")"
                                        @onclick="() => SelectDepartment(row)"
                                        @onkeydown="(e) => HandleKeySelect(e, row)">
                                        <td class="px-3.5 py-2.5 font-semibold @(isSelected ? "text-blue-700 dark:text-blue-300" : "text-slate-900 dark:text-slate-100")">
                                            @row.Name
                                        </td>
                                        <td class="px-3.5 py-2.5 whitespace-nowrap">
                                            <span class="inline-flex rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 px-2 py-0.5 text-[10px] font-medium text-slate-700 dark:text-slate-300">
                                                @typeName
                                            </span>
                                        </td>
                                        <td class="px-3.5 py-2.5 whitespace-nowrap">
                                            @if (hasSup)
                                            {
                                                <span class="inline-flex rounded-full border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-300" title="@string.Join(", ", row.Supervisors.Select(s => s.Name))">
                                                    @row.Supervisors.Count @(row.Supervisors.Count == 1 ? "lead" : "leads")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex rounded-full border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/50 px-2 py-0.5 text-[10px] font-semibold text-amber-800 dark:text-amber-300">
                                                    No lead
                                                </span>
                                            }
                                        </td>
                                        <td class="px-3.5 py-2.5 text-right whitespace-nowrap">
                                            <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold @(row.Members.Count > 0 ? "bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200/80 dark:border-blue-800" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                                                @row.Members.Count
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- RIGHT PANEL: Department Details & Workforce Roster -->
            <div class="page-panel-right min-w-0 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 flex flex-col gap-3.5">
                @if (selected == null)
                {
                    <div class="flex flex-col items-center justify-center p-12 text-center text-slate-500 dark:text-slate-400 min-h-[420px] rounded-xl border border-dashed border-slate-200 dark:border-slate-700">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 mb-3">
                            <AppIcon Name="corporate_fare" Class="text-xl" />
                        </div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Select a Department</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm">
                            Choose any department from the directory on the left to inspect its assigned workforce, supervisors, and profile links.
                        </p>
                    </div>
                }
                else
                {
                    var selectedType = data.StructureTypes.FirstOrDefault(t => t.Id == selected.StructureTypeId)?.Name ?? "Department";
                    var hasSupervisorIssue = data.SupervisorIssues.TryGetValue(selected.Id, out var issueDetail);

                    <!-- Selected Department Header -->
                    <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">@selected.Name</h2>
                                <span class="inline-flex rounded-full border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-950/50 px-2 py-0.5 text-[10px] font-semibold text-blue-700 dark:text-blue-300">
                                    @selectedType
                                </span>
                            </div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                @selected.Members.Count assigned staff · @selected.Supervisors.Count designated supervisor(s)
                            </p>
                        </div>

                        <div class="flex items-center gap-1.5">
                            <a class="app-button app-button-primary app-button-sm"
                               href="@($"/admin/hr/supervisors/management?organisationId={orgId}&teamView=departments")">
                                <span>Manage supervisors</span>
                            </a>
                            <button type="button"
                                    class="app-button app-button-neutral app-button-sm"
                                    @onclick="() => selected = null">
                                Close
                            </button>
                        </div>
                    </div>

                    @if (hasSupervisorIssue && !string.IsNullOrWhiteSpace(issueDetail))
                    {
                        <div class="flex items-center justify-between gap-2 rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50/80 dark:bg-amber-950/40 px-3 py-2 text-xs text-amber-900 dark:text-amber-200">
                            <span><strong>Supervisor Warning:</strong> @issueDetail</span>
                            <a href="@($"/admin/hr/supervisors/management?organisationId={orgId}&teamView=departments")"
                               class="text-xs font-semibold text-amber-800 dark:text-amber-300 underline shrink-0">
                                Fix now
                            </a>
                        </div>
                    }

                    <!-- Inset Department Leadership Strip -->
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Department Leadership</span>
                            <span class="text-[11px] text-slate-500 dark:text-slate-400">@selected.Supervisors.Count supervisor(s)</span>
                        </div>

                        @if (selected.Supervisors.Any())
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var sup in selected.Supervisors)
                                {
                                    <div class="inline-flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2.5 py-1">
                                        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-teal-50 dark:bg-teal-950/60 text-[10px] font-bold text-teal-700 dark:text-teal-300 shrink-0">
                                            @(string.IsNullOrWhiteSpace(sup.Name) ? "?" : sup.Name.Substring(0, 1).ToUpper())
                                        </span>
                                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">@sup.Name</span>
                                        <span class="rounded-full bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200/80 dark:border-indigo-800 px-1.5 py-0.2 text-[10px] font-semibold text-indigo-700 dark:text-indigo-300">Supervisor</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center justify-between gap-2 rounded-lg border border-dashed border-amber-300 dark:border-amber-800 bg-amber-50/60 dark:bg-amber-950/30 px-3 py-2 text-xs text-amber-800 dark:text-amber-200">
                                <span>No supervisor designated for this department.</span>
                                <a class="font-semibold text-amber-900 dark:text-amber-200 underline text-xs shrink-0"
                                   href="@($"/admin/hr/supervisors/management?organisationId={orgId}&teamView=departments")">
                                    Assign Lead
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Assigned Staff Table -->
                    <div class="flex flex-col gap-2.5">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                                    Assigned Staff (@selected.Members.Count)
                                </h3>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400">Employees mapped to this department.</p>
                            </div>

                            @if (selected.Members.Any())
                            {
                                <div class="relative w-full sm:w-52">
                                    <input type="text"
                                           class="h-8 w-full rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 pr-6 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                           placeholder="Filter staff by name..."
                                           @bind="staffSearch"
                                           @bind:event="oninput" />
                                    @if (!string.IsNullOrWhiteSpace(staffSearch))
                                    {
                                        <button type="button"
                                                class="absolute inset-y-0 right-0 pr-2 flex items-center text-slate-400 hover:text-slate-600 text-xs"
                                                @onclick="() => staffSearch = string.Empty">✕</button>
                                    }
                                </div>
                            }
                        </div>

                        @if (selected.Members.Any())
                        {
                            var membersList = FilteredMembers.ToList();
                            if (membersList.Count == 0)
                            {
                                <div class="p-6 text-center text-xs text-slate-500 dark:text-slate-400 rounded-xl border border-dashed border-slate-200 dark:border-slate-700">
                                    No staff members match "<strong>@staffSearch</strong>".
                                </div>
                            }
                            else
                            {
                                <div class="overflow-x-auto max-h-[420px] overflow-y-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                    <table class="min-w-full divide-y divide-slate-200/80 dark:divide-slate-800 text-left text-xs">
                                        <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/90 text-[10px] font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300">
                                            <tr>
                                                <th class="px-3 py-2">Staff Member</th>
                                                <th class="px-3 py-2">ID</th>
                                                <th class="px-3 py-2 text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                            @for (var i = 0; i < membersList.Count; i++)
                                            {
                                                var member = membersList[i];
                                                var isAlt = i % 2 == 1;
                                                <tr class="@(isAlt ? "bg-[#f3f8fd] dark:bg-slate-800/30" : "bg-white dark:bg-slate-900") hover:bg-blue-50/50 dark:hover:bg-slate-800/60 transition-colors">
                                                    <td class="px-3 py-2 font-semibold text-slate-900 dark:text-slate-100">@member.Name</td>
                                                    <td class="px-3 py-2 font-mono text-[11px] text-slate-500 dark:text-slate-400">#@member.Id</td>
                                                    <td class="px-3 py-2 text-right whitespace-nowrap">
                                                        <a class="inline-flex items-center rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-0.5 text-[11px] font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors"
                                                           href="@($"/admin/my/workspace/staff/{member.Id}/overview")">
                                                            View
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center text-slate-500 dark:text-slate-400">
                                <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">No active staff currently assigned</p>
                                <p class="text-xs mt-1">Staff members can be assigned through staff profile work details or transfer workflows.</p>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    }
    else if (busy)
    {
        <div role="status" class="flex flex-col items-center justify-center p-16 text-slate-500 dark:text-slate-400 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
            <div class="h-8 w-8 animate-spin rounded-full border-2 border-blue-600 border-t-transparent mb-3"></div>
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Loading department structures…</span>
        </div>
    }
</section>

<style>
    .departments-page {
        width: 100%;
        min-width: 0;
    }

    .departments-header {
        width: 100%;
    }

    .page-panels {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 1rem;
        width: 100%;
        min-width: 0;
        padding: 0;
        margin-inline: auto;
        transition: max-width .3s ease;
        box-sizing: border-box;
    }

    .page-panels-standard {
        max-width: 80rem;
    }

    .page-panels-full {
        max-width: none;
    }

    .page-panel-left, .page-panel-right {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
    }

    @@media (min-width: 1024px) {
        .page-panels {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }
    }
</style>

@code {
    [Parameter] public bool HideHeader { get; set; }
    [Inject] private HRM.Services.Interfaces.IUserAccessService Access { get; set; } = null!;

    private const string FullWidthSettingKey = "hrm.departments-management.full-width";

    private OrganisationTeamSettingsData? data;
    private OrganisationTeamSettingsRow? selected;
    private int orgId;
    private int type = 0;
    private bool busy;
    private bool isFullWidth = false;
    private string organisation = "";
    private string search = "";
    private string staffSearch = "";
    private string statusFilter = "all";
    private string? error;

    private int TotalDepartmentCount => data?.Rows.Count(r => r.Kind == "Department") ?? 0;
    private int TotalStaffCount => data?.Rows.Where(r => r.Kind == "Department").Sum(r => r.Members.Count) ?? 0;
    private int SupervisedDepartmentCount => data?.Rows.Count(r => r.Kind == "Department" && r.Supervisors.Any()) ?? 0;

    private IEnumerable<OrganisationTeamSettingsRow> Filtered =>
        data?.Rows.Where(r =>
            r.Kind == "Department" &&
            (type == 0 || r.StructureTypeId == type) &&
            (string.IsNullOrWhiteSpace(search) || r.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
            (statusFilter switch
            {
                "staff" => r.Members.Count > 0,
                "nosup" => !r.Supervisors.Any(),
                _ => true
            })
        ) ?? [];

    private IEnumerable<OrganisationSettingsOption> FilteredMembers =>
        selected?.Members.Where(m =>
            string.IsNullOrWhiteSpace(staffSearch) ||
            m.Name.Contains(staffSearch, StringComparison.OrdinalIgnoreCase)
        ) ?? [];

    private bool disposed;

    public void Dispose()
    {
        disposed = true;
    }

    protected override Task OnInitializedAsync() => Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !disposed)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", FullWidthSettingKey);
                if (!disposed && bool.TryParse(saved, out var val))
                {
                    isFullWidth = val;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", FullWidthSettingKey, isFullWidth.ToString());
        }
        catch { }
    }

    private void SelectDepartment(OrganisationTeamSettingsRow row)
    {
        selected = row;
        staffSearch = string.Empty;
    }

    private void HandleKeySelect(KeyboardEventArgs e, OrganisationTeamSettingsRow row)
    {
        if (e.Key is "Enter" or " ")
        {
            SelectDepartment(row);
        }
    }

    private void ResetFilters()
    {
        search = string.Empty;
        type = 0;
        statusFilter = "all";
    }

    private async Task GoBack()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/navigation-history.js");
            await module.InvokeVoidAsync("goBack", "/admin/hr");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { Navigation.NavigateTo("/admin/hr"); }
    }

    private async Task Load()
    {
        if (disposed) return;
        busy = true;
        error = null;
        try
        {
            orgId = await Access.GetCurrentOrganisationIdAsync();
            if (disposed) return;
            data = await Settings.GetTeamSettingsAsync(orgId);
            if (disposed) return;
            organisation = (await Settings.GetTeamOrganisationsAsync()).FirstOrDefault(o => o.Id == orgId)?.Name ?? "";

            if (selected != null)
            {
                selected = data?.Rows.FirstOrDefault(r => r.Id == selected.Id && r.Kind == "Department");
            }

            if (selected == null)
            {
                selected = Filtered.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            if (disposed) return;
            data = null;
            Logger.LogError(ex, "Loading departments");
            error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Departments could not be loaded. Refresh or contact HR.";
        }
        finally
        {
            if (!disposed)
            {
                busy = false;
            }
        }
    }
}
