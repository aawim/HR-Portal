@using HRM.Services
@using HRM.Components.Admin.Hr.Organisation.Tabs
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HRM.Services.Contracts.GroupsManagementServiceContracts.IOperations Groups
@inject ToastService Toasts
@inject ILogger<ManageGroupsGrid> Logger
@inject NavigationManager Navigation

<section class="space-y-4 p-4">
    <h1 class="text-xl font-semibold">Groups Management</h1>
    <p class="text-sm text-slate-500">Manage operational groups and group types here. Access-control User Groups are managed under Roles &amp; Permissions.</p>
    @if(error!=null){<p role="alert" class="rounded-lg border p-3 text-sm">@error</p>}
    @if(data==null){<button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Reload groups</button>}
    else
    {
        @if(data.IsSuperAdmin){<label class="block text-sm">Organisation<select value="@data.OrganisationId" @onchange="ChangeOrganisation" disabled="@busy" class="mt-1 block w-full rounded border bg-transparent p-2">@foreach(var org in data.Organisations){<option value="@org.Id">@org.Name</option>}</select></label>}
        else{<p class="text-sm">Organisation: <strong>@data.Organisation</strong></p>}
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Group management sections"><button class="app-button @(tab=="groups"?"app-button-primary":"app-button-secondary")" role="tab" aria-selected="@(tab=="groups")" @onclick='()=>SelectTab("groups")'>Groups</button><button class="app-button @(tab=="types"?"app-button-primary":"app-button-secondary")" role="tab" aria-selected="@(tab=="types")" @onclick='()=>SelectTab("types")'>Group types</button></div>
        <div class="flex flex-wrap items-end gap-3"><label class="text-sm">Search<input @bind="search" @bind:event="oninput" class="mt-1 block rounded border bg-transparent p-2" /></label><button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Refresh</button>@if(data.CanManage){<button class="app-button app-button-primary" disabled="@busy" @onclick="New">@(tab=="types"?"Add group type":"Add group")</button>}</div>
        @if(editing)
        {
            <fieldset disabled="@busy" class="space-y-3 rounded-xl border p-4">
                <h2 class="font-semibold">@(editId==0?"Add":"Edit") @(tab=="types"?"group type":"group")</h2>
                <label class="block text-sm">Name<input @bind="name" maxlength="@(tab=="types"?150:250)" class="mt-1 block w-full rounded border bg-transparent p-2" /></label>
                @if(tab=="groups")
                {
                    <div class="grid gap-3 sm:grid-cols-2"><label class="text-sm">Group type<select @bind="typeId" class="mt-1 block w-full rounded border bg-transparent p-2"><option value="0">Select group type</option>@foreach(var type in data.Types){<option value="@type.Id">@type.Name</option>}</select></label><label class="text-sm">Approved organisation structure<select @bind="structureId" class="mt-1 block w-full rounded border bg-transparent p-2"><option value="0">Select structure</option>@foreach(var structure in data.Structures){<option value="@structure.Id">@structure.Name</option>}</select></label></div>
                }
                <div class="flex flex-wrap gap-2"><button class="app-button app-button-primary" @onclick="SaveAsync">Save</button><button class="app-button app-button-secondary" @onclick="()=>editing=false">Cancel</button></div>
            </fieldset>
        }
        @if(deletingId.HasValue)
        {
            <div role="alert" class="space-y-2 rounded-lg border p-3 text-sm"><p>Delete the unused @(tab=="types"?"group type":"group") “@deletingName”? Records with staff, schedule or leave history cannot be deleted.</p><div class="flex gap-2"><button class="app-button app-button-primary" disabled="@busy" @onclick="DeleteAsync">Confirm delete</button><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>deletingId=null">Cancel</button></div></div>
        }
        <div class="overflow-x-auto rounded-lg border"><table class="w-full text-left text-sm"><thead><tr><th class="p-3">Name</th>@if(tab=="groups"){<th class="p-3">Group type</th><th class="p-3">Structure</th>}<th class="p-3">Actions</th></tr></thead><tbody>
        @if(tab=="groups")
        {
            @foreach(var row in data.Groups.Where(g=>g.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||g.Type.Contains(search,StringComparison.OrdinalIgnoreCase)||g.Structure.Contains(search,StringComparison.OrdinalIgnoreCase)))
            {
                <tr class="border-t"><td class="p-3">@row.Name</td><td class="p-3">@row.Type</td><td class="p-3">@row.Structure</td><td class="p-3"><div class="flex flex-wrap gap-2"><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>View(row)">View</button>@if(data.CanManage){<button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>Edit(row)">Edit</button><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>BeginDelete(row.Id,row.Name,row.AuditId)">Delete</button>}</div></td></tr>
            }
        }
        else
        {
            @foreach(var row in data.Types.Where(t=>t.Name.Contains(search,StringComparison.OrdinalIgnoreCase)))
            {
                <tr class="border-t"><td class="p-3">@row.Name</td><td class="p-3">@if(data.CanManage){<div class="flex flex-wrap gap-2"><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>EditType(row)">Edit</button><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>BeginDelete(row.Id,row.Name,0)">Delete</button></div>}</td></tr>
            }
        }
        </tbody></table></div>
        @if(tab=="groups" && data.Groups.Count==0 || tab=="types" && data.Types.Count==0){<p class="text-sm text-slate-500">No records found.</p>}
        <GroupDetailPanel @bind-IsOpen="detailOpen" Group="selectedGroup" />
    }
</section>
@code {
    [SupplyParameterFromQuery(Name="organisationId")] public int? OrganisationId {get;set;}
    [SupplyParameterFromQuery(Name="tab")] public string? RequestedTab {get;set;}
    private OperationalGroupsData? data;
    private string? error,originalName,loaded;
    private string name="",search="",tab="groups",deletingName="";
    private bool busy,editing,detailOpen;
    private int editId,typeId,structureId,expectedAudit,deletingAudit;
    private int? deletingId;
    private OrganisationGroupsTab.GroupDto? selectedGroup;
    protected override async Task OnParametersSetAsync(){var key=$"{OrganisationId}:{RequestedTab}";if(loaded==key)return;loaded=key;tab=RequestedTab=="types"?"types":"groups";await LoadAsync();}
    private async Task LoadAsync(){busy=true;error=null;editing=false;deletingId=null;detailOpen=false;try{data=await Groups.LoadAsync(OrganisationId);}catch(Exception ex){data=null;Fail(ex);}finally{busy=false;}}
    private void SelectTab(string value){if(busy)return;Navigation.NavigateTo($"/admin/hr/groups/management?organisationId={data!.OrganisationId}&tab={value}");}
    private void ChangeOrganisation(ChangeEventArgs e){if(!busy && int.TryParse(e.Value?.ToString(),out var id))Navigation.NavigateTo($"/admin/hr/groups/management?organisationId={id}&tab={tab}");}
    private void New(){editId=0;name="";typeId=structureId=expectedAudit=0;originalName=null;editing=true;deletingId=null;error=null;}
    private void Edit(OperationalGroupRow row){New();editId=row.Id;name=row.Name;typeId=row.TypeId;structureId=row.StructureId;expectedAudit=row.AuditId;}
    private void EditType(OperationalGroupOption row){New();editId=row.Id;name=originalName=row.Name;}
    private void View(OperationalGroupRow row){selectedGroup=new(){GroupID=row.Id,Name=row.Name,GroupTypeName=row.Type,DivisionName=row.Structure};detailOpen=true;}
    private void BeginDelete(int id,string value,int audit){editing=false;deletingId=id;deletingName=value;deletingAudit=audit;error=null;}
    private Task SaveAsync()=>Act(async()=>{if(tab=="types")await Groups.SaveTypeAsync(data!.OrganisationId,editId,name,originalName);else await Groups.SaveGroupAsync(data!.OrganisationId,editId,name,typeId,structureId,expectedAudit);},"Group configuration saved.");
    private Task DeleteAsync()=>Act(async()=>{if(!deletingId.HasValue)return;if(tab=="types")await Groups.DeleteTypeAsync(data!.OrganisationId,deletingId.Value,deletingName);else await Groups.DeleteGroupAsync(data!.OrganisationId,deletingId.Value,deletingAudit);},"Unused record deleted.");
    private async Task Act(Func<Task> action,string message){if(busy)return;busy=true;error=null;var saved=false;try{await action();Toasts.Success(message);saved=true;}catch(Exception ex){Fail(ex);}finally{busy=false;}if(saved)await LoadAsync();}
    private void Fail(Exception ex){Logger.LogError(ex,"Managing operational groups");error=ex is UnauthorizedAccessException or InvalidOperationException?ex.Message:"Groups could not be loaded or saved. Please refresh or contact HR.";}
}
