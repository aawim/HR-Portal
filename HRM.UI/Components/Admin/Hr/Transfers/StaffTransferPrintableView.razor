@namespace HRM.Components.Admin.Hr.Transfers
@using HRM.DTOs
@using HRM.DTOs.StaffTransfer
@using HRM.Enums
@inject IJSRuntime JS

@if (Document is not null)
{
    <div class="space-y-4">
        <!-- Action Bar (Hidden in Print) -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-300 pb-3 print:hidden">
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-blue-800">
                    @Document.DocumentNumber · v@Document.RequestVersion
                </span>
                <span class="text-xs text-slate-600">
                    Issued @Document.IssueDateUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                </span>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                @if (AllowVariantSwitch)
                {
                    <div class="inline-flex gap-3 text-xs">
                        <button type="button"
                                @onclick="() => OnVariantChanged.InvokeAsync(StaffTransferDocumentVariants.EmployeeNotice)"
                                class="border-b-2 pb-0.5 font-semibold transition @(Document.DocumentVariant == StaffTransferDocumentVariants.EmployeeNotice ? "border-blue-700 text-blue-700" : "border-transparent text-slate-600 hover:text-slate-900")">
                            Standard Employee Notice
                        </button>
                        <button type="button"
                                @onclick="() => OnVariantChanged.InvokeAsync(StaffTransferDocumentVariants.RestrictedAdminRecord)"
                                class="border-b-2 pb-0.5 font-semibold transition @(Document.DocumentVariant == StaffTransferDocumentVariants.RestrictedAdminRecord ? "border-amber-700 text-amber-800" : "border-transparent text-slate-600 hover:text-slate-900")">
                            Restricted HR / Admin Record
                        </button>
                    </div>
                }

                <button type="button"
                        @onclick="PrintDocumentAsync"
                        class="inline-flex items-center gap-1.5 bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-slate-800">
                    <span>🖨️</span>
                    <span>Print / Save PDF</span>
                </button>

                @if (OnClose.HasDelegate)
                {
                    <button type="button"
                            @onclick="OnClose"
                            class="text-xs font-semibold text-slate-700 underline hover:text-slate-900">
                        Close
                    </button>
                }
            </div>
        </div>

        <!-- Printable Formal A4 Document (No Borders / Panels) -->
        <div id="staff-transfer-printable-sheet"
             class="mx-auto max-w-[210mm] bg-white py-4 text-slate-900 print:max-w-none print:p-0">

            <!-- 1. Organization Header -->
            <div class="flex items-start justify-between border-b-2 border-slate-900 pb-4">
                <div>
                    <div class="text-xs font-bold uppercase tracking-widest text-slate-500">
                        @(string.IsNullOrWhiteSpace(Document.OrganisationBrandingName) ? "Human Resource Management System" : Document.OrganisationBrandingName)
                    </div>
                    <h1 class="mt-1 text-xl font-extrabold uppercase tracking-tight text-slate-900">
                        @(Document.DocumentVariant == StaffTransferDocumentVariants.RestrictedAdminRecord
                            ? "Internal Staff Transfer — Restricted HR & Security Record"
                            : "Official Internal Staff Transfer Notice")
                    </h1>
                    <p class="mt-0.5 text-xs text-slate-600">
                        Formal Organizational Reassignment, Work Schedule, Access &amp; Reporting Record
                    </p>
                </div>
                <div class="text-right text-xs">
                    <div class="font-bold text-slate-900">Doc: @Document.DocumentNumber</div>
                    <div class="text-slate-600">Ref: @(Document.RequestReferenceNumber ?? $"#{Document.StaffTransferId}")</div>
                    <div class="text-slate-600">Version: v@Document.RequestVersion</div>
                    <div class="text-slate-600">Issued: @Document.IssueDateUtc.ToLocalTime().ToString("dd MMM yyyy")</div>
                    <div class="mt-1 text-[11px] font-bold uppercase text-slate-900">
                        [@Document.Status]
                    </div>
                </div>
            </div>

            <!-- 2. Employee Identification & 3. Organization Movement -->
            <div class="mt-5 grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        01 · Employee Identification
                    </h2>
                    <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1.5 text-xs">
                        <dt class="text-slate-500">Full Name</dt>
                        <dd class="font-semibold text-slate-900">@Document.Staff.FullName</dd>

                        <dt class="text-slate-500">Staff Number</dt>
                        <dd class="font-semibold text-slate-900">@Document.Staff.EmployeeNumber</dd>

                        @if (Document.DocumentVariant == StaffTransferDocumentVariants.RestrictedAdminRecord && !string.IsNullOrWhiteSpace(Document.Staff.IdCardNumber))
                        {
                            <dt class="text-slate-500">ID Card Number</dt>
                            <dd class="font-mono font-semibold text-amber-900">@Document.Staff.IdCardNumber</dd>
                        }

                        <dt class="text-slate-500">Employment Category</dt>
                        <dd class="text-slate-800">@Document.Staff.EmploymentCategory</dd>

                        <dt class="text-slate-500">Employment Status</dt>
                        <dd class="text-slate-800">@Document.Staff.CurrentEmploymentStatus</dd>

                        <dt class="text-slate-500">Date Joined</dt>
                        <dd class="text-slate-800">@Document.Staff.DateJoined.ToString("dd MMM yyyy")</dd>
                    </dl>
                </div>

                <div class="p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        02 · Organizational Movement
                    </h2>
                    <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1.5 text-xs">
                        <dt class="text-slate-500">Sending Department</dt>
                        <dd class="font-medium text-slate-800">@Document.Staff.CurrentOrganisationName · @Document.Staff.CurrentDepartmentName</dd>

                        <dt class="text-slate-500">Appointment Mode</dt>
                        <dd class="font-semibold text-blue-900">@Document.Job.TransferAppointmentMode</dd>

                        <dt class="text-slate-500">Effective Date</dt>
                        <dd class="font-bold text-slate-900">@Document.Job.EffectiveDate.ToString("dd MMM yyyy")</dd>

                        <dt class="text-slate-500">Reporting Date</dt>
                        <dd class="font-semibold text-slate-900">@Document.Reporting.ReportingDate.ToString("dd MMM yyyy")</dd>

                        <dt class="text-slate-500">New Supervisor</dt>
                        <dd class="text-slate-800">@(Document.Job.NewReportingSupervisorName ?? Document.Reporting.ReportingToName ?? "—")</dd>
                    </dl>
                </div>
            </div>

            <!-- 4. Job & Position Comparison -->
            <div class="mt-5 p-2">
                <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                    03 · Job, Position &amp; Matrix Comparison
                </h2>
                <div class="mt-2 grid grid-cols-1 gap-4 text-xs md:grid-cols-2">
                    <div>
                        <div class="text-[11px] font-bold uppercase text-slate-500">Current Appointment</div>
                        <div class="mt-1 font-semibold text-slate-900">@Document.Job.ExistingPositionTitle</div>
                        <div class="text-slate-600">Matrix: @(Document.Job.ExistingPositionMatrixLabel ?? "—") · Grade/Level: @(Document.Job.ExistingGradeLevel ?? "—")</div>
                        @if (Document.DocumentVariant == StaffTransferDocumentVariants.RestrictedAdminRecord && Document.Job.ExistingBasicSalary.HasValue)
                        {
                            <div class="mt-0.5 text-amber-800">Salary: @Document.Job.ExistingBasicSalary.Value.ToString("N2") @(Document.Job.ExistingAllowance.HasValue ? $"+ Allowance {Document.Job.ExistingAllowance.Value:N2}" : "")</div>
                        }
                    </div>
                    <div>
                        <div class="text-[11px] font-bold uppercase text-blue-800">Approved Destination Appointment</div>
                        <div class="mt-1 font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Document.Job.DestinationPositionTitle) ? Document.Job.ExistingPositionTitle : Document.Job.DestinationPositionTitle)</div>
                        <div class="text-slate-600">Grade/Level: @(Document.Job.DestinationGradeLevel ?? Document.Job.ExistingGradeLevel ?? "—")</div>
                        @if (Document.DocumentVariant == StaffTransferDocumentVariants.RestrictedAdminRecord && Document.Job.ProposedBasicSalary.HasValue)
                        {
                            <div class="mt-0.5 text-amber-800">Proposed Salary: @Document.Job.ProposedBasicSalary.Value.ToString("N2") @(Document.Job.ProposedAllowance.HasValue ? $"+ Allowance {Document.Job.ProposedAllowance.Value:N2}" : "")</div>
                        }
                    </div>
                </div>
                <div class="mt-2 text-xs text-slate-700">
                    <span class="font-semibold">Transfer Reason &amp; Justification:</span> @Document.Job.TransferReason
                </div>
            </div>

            <!-- 5. Work Schedule & Attendance Arrangements -->
            <div class="mt-5 p-2">
                <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                    04 · Work Schedule &amp; Attendance Arrangements
                </h2>
                <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs md:grid-cols-4">
                    <div>
                        <span class="block text-slate-500">Work Location</span>
                        <span class="font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Document.Work.ProposedLocationName) ? Document.Work.CurrentLocationName ?? "—" : Document.Work.ProposedLocationName)</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Working Schedule</span>
                        <span class="font-semibold text-slate-900">@(Document.Work.ProposedWorkTemplateName ?? Document.Work.ProposedScheduleMode)</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Work Arrangement</span>
                        <span class="font-semibold text-slate-900">@Document.Work.WorkArrangementMode (@Document.Work.WeeklyWorkingHours hrs/wk)</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Start / End Time</span>
                        <span class="font-semibold text-slate-900">@(Document.Work.StandardStartTime?.ToString("HH:mm") ?? "08:00")–@(Document.Work.StandardEndTime?.ToString("HH:mm") ?? "14:00")</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Planning Provider</span>
                        <span class="text-slate-800">@(Document.Work.ProposedPlanningProviderName ?? "Organization Default")</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Attendance Method / Device</span>
                        <span class="text-slate-800">@Document.Work.RequiredAttendanceMethod @(string.IsNullOrWhiteSpace(Document.Work.AttendanceDeviceName) ? "" : $"· {Document.Work.AttendanceDeviceName}")</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Attendance Supervisor</span>
                        <span class="text-slate-800">@(Document.Work.AttendanceVerificationSupervisorName ?? Document.Job.NewReportingSupervisorName ?? "—")</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Schedule Effective Date</span>
                        <span class="font-semibold text-slate-900">@Document.Work.ScheduleEffectiveDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- 6. Organizational Access Summary -->
            @if (Document.AccessChanges.Count > 0)
            {
                <div class="mt-5 p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        05 · Organizational Access &amp; System Permissions
                    </h2>
                    <div class="mt-2 overflow-x-auto">
                        <table class="w-full border-collapse text-left text-[11px]">
                            <thead>
                                <tr class="border-b border-slate-300 text-slate-600">
                                    <th class="px-2 py-1">Access Area</th>
                                    <th class="px-2 py-1">Current Access</th>
                                    <th class="px-2 py-1">Action</th>
                                    <th class="px-2 py-1">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var row in Document.AccessChanges)
                                {
                                    <tr>
                                        <td class="px-2 py-1 font-medium text-slate-900">@row.AccessAreaName</td>
                                        <td class="px-2 py-1 text-slate-600">@(row.CurrentScopeSummary ?? "—")</td>
                                        <td class="px-2 py-1 font-semibold text-slate-800">@row.TransitionAction</td>
                                        <td class="px-2 py-1 text-slate-600">@row.ProvisioningStatus</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- 7. Physical Door Access Summary -->
            @if (Document.DoorAccessChanges.Count > 0)
            {
                <div class="mt-5 p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        06 · Physical Door Access &amp; Security Provisioning
                    </h2>
                    <div class="mt-2 overflow-x-auto">
                        <table class="w-full border-collapse text-left text-[11px]">
                            <thead>
                                <tr class="border-b border-slate-300 text-slate-600">
                                    <th class="px-2 py-1">Building / Floor / Office</th>
                                    <th class="px-2 py-1">Card Ref</th>
                                    <th class="px-2 py-1">Proposed Access Groups</th>
                                    <th class="px-2 py-1">Transition Action</th>
                                    <th class="px-2 py-1">Provisioning State</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var door in Document.DoorAccessChanges)
                                {
                                    <tr>
                                        <td class="px-2 py-1 font-medium text-slate-900">
                                            @door.BuildingName @(string.IsNullOrWhiteSpace(door.FloorName) ? "" : $"/ {door.FloorName}") @(string.IsNullOrWhiteSpace(door.DepartmentOfficeArea) ? "" : $"/ {door.DepartmentOfficeArea}")
                                        </td>
                                        <td class="px-2 py-1 text-slate-600">@(door.AccessCardReference ?? "—")</td>
                                        <td class="px-2 py-1 text-slate-800">@(door.ProposedAccessGroups ?? "—")</td>
                                        <td class="px-2 py-1 text-slate-700">@door.TransitionAction</td>
                                        <td class="px-2 py-1 font-semibold text-slate-800">@door.ProvisioningState</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- 8 & 9. Reporting & Handover Arrangements -->
            <div class="mt-5 p-2">
                <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                    07 · Reporting Instructions &amp; Handover Obligations
                </h2>
                <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs md:grid-cols-4">
                    <div>
                        <span class="block text-slate-500">Reporting Date &amp; Time</span>
                        <span class="font-semibold text-slate-900">@Document.Reporting.ReportingDate.ToString("dd MMM yyyy") @(Document.Reporting.ReportingTime?.ToString("HH:mm") ?? "08:00")</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Reporting Location</span>
                        <span class="font-semibold text-slate-900">@Document.Reporting.ReportingLocation</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Reporting To</span>
                        <span class="font-semibold text-slate-900">@(Document.Reporting.ReportingToName ?? Document.Job.NewReportingSupervisorName ?? "—")</span>
                    </div>
                    <div>
                        <span class="block text-slate-500">Handover Required</span>
                        <span class="font-semibold text-slate-900">
                            @(Document.Reporting.HandoverRequired
                                ? $"Yes (by {Document.Reporting.HandoverDeadline?.ToString("dd MMM yyyy") ?? "Effective Date"})"
                                : "No")
                        </span>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Document.Reporting.OutstandingAssignmentsSummary) ||
                     !string.IsNullOrWhiteSpace(Document.Reporting.AssetsToReturnSummary) ||
                     !string.IsNullOrWhiteSpace(Document.Reporting.AssetsToReceiveSummary) ||
                     !string.IsNullOrWhiteSpace(Document.Reporting.SpecialInstructions))
                {
                    <div class="mt-2 grid grid-cols-1 gap-2 border-t border-slate-100 pt-2 text-xs md:grid-cols-2">
                        @if (!string.IsNullOrWhiteSpace(Document.Reporting.OutstandingAssignmentsSummary))
                        {
                            <div><span class="font-semibold text-slate-700">Selected Work Handovers:</span> @Document.Reporting.OutstandingAssignmentsSummary</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Document.Reporting.AssetsToReturnSummary))
                        {
                            <div><span class="font-semibold text-slate-700">Selected Items to Return:</span> @Document.Reporting.AssetsToReturnSummary</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Document.Reporting.AssetsToReceiveSummary))
                        {
                            <div><span class="font-semibold text-slate-700">Assets to Receive:</span> @Document.Reporting.AssetsToReceiveSummary</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Document.Reporting.SpecialInstructions))
                        {
                            <div><span class="font-semibold text-slate-700">Special Instructions:</span> @Document.Reporting.SpecialInstructions</div>
                        }
                    </div>
                }
            </div>

            <!-- 10, 11, 12. Confirmation & Final Approval -->
            <div class="mt-5 grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        08 · Employee Confirmation Record
                    </h2>
                    @if (Document.ConfirmedVersion.HasValue && Document.ConfirmedAtUtc.HasValue)
                    {
                        <div class="mt-2 text-xs">
                            <div class="font-semibold text-emerald-800">
                                Confirmed by @Document.ConfirmedByName on @Document.ConfirmedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") (Version v@Document.ConfirmedVersion)
                            </div>
                            <p class="mt-1 italic text-slate-600">"@Document.ConfirmationStatement"</p>
                            @if (!string.IsNullOrWhiteSpace(Document.EmployeeRemarks))
                            {
                                <div class="mt-1 text-slate-700"><span class="font-semibold">Remarks:</span> @Document.EmployeeRemarks</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 text-xs text-amber-700">Pending employee confirmation for version v@Document.RequestVersion.</div>
                    }
                </div>

                <div class="p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        09 · Receiving Department Final Approval
                    </h2>
                    @if (Document.FinalApprovedAtUtc.HasValue)
                    {
                        <div class="mt-2 text-xs">
                            <div class="font-semibold text-blue-900">
                                Approved by @Document.FinalApprovedByName on @Document.FinalApprovedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Document.FinalDecisionRemarks))
                            {
                                <div class="mt-1 text-slate-700"><span class="font-semibold">Decision Remarks:</span> @Document.FinalDecisionRemarks</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 text-xs text-slate-500">Awaiting receiving department final decision.</div>
                    }
                </div>
            </div>

            @if (Document.SupervisorComments.Count > 0 || Document.HodComments.Count > 0)
            {
                <div class="mt-5 p-2">
                    <h2 class="border-b border-slate-300 pb-1 text-xs font-bold uppercase tracking-wider text-slate-800">
                        10 · Supervisor / HOD Advisory Comments
                    </h2>
                    <div class="mt-2 space-y-1.5 text-xs">
                        @foreach (var comment in Document.SupervisorComments.Concat(Document.HodComments))
                        {
                            <div class="py-1">
                                <span class="font-semibold text-slate-800">@comment.AuthorName (@comment.ParticipantRole · @comment.CommentKind):</span>
                                <span class="text-slate-700">@comment.CommentText</span>
                                <span class="ml-2 text-[10px] text-slate-400">@comment.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- 14. System Verification Footer -->
            <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-slate-300 pt-3 text-[10px] text-slate-500">
                <div>
                    Document #@Document.DocumentNumber · Transfer #@Document.StaffTransferId
                </div>
                <div class="font-mono">
                    SHA-256: @Document.Sha256Hash
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public StaffTransferPrintableDocumentDto? Document { get; set; }
    [Parameter] public bool AllowVariantSwitch { get; set; } = true;
    [Parameter] public EventCallback<string> OnVariantChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task PrintDocumentAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch
        {
            // Ignore JS interop disconnect errors
        }
    }
}
