    private async Task SwitchPrintableVariantAsync(string variant)
    {
        if (printableDocument is null)
            return;
        await OpenPrintableViewAsync(printableDocument.StaffTransferId, variant);
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        StaffTransferStatuses.Draft => "border-slate-200 bg-slate-50 text-slate-700",
        StaffTransferStatuses.PendingStaffConfirmation => "border-amber-200 bg-amber-50 text-amber-800",
        StaffTransferStatuses.CorrectionRequested => "border-rose-200 bg-rose-50 text-rose-800",
        StaffTransferStatuses.PendingReceivingApproval => "border-blue-200 bg-blue-50 text-blue-800",
        StaffTransferStatuses.Scheduled or StaffTransferStatuses.Approved => "border-indigo-200 bg-indigo-50 text-indigo-800",
        StaffTransferStatuses.Active => "border-emerald-200 bg-emerald-50 text-emerald-800",
        StaffTransferStatuses.Rejected or StaffTransferStatuses.ActivationFailed => "border-rose-200 bg-rose-50 text-rose-800",
        _ => "border-slate-200 bg-slate-50 text-slate-600"
    };

    private string GetFormTabSolidClass(int index)
    {
        if (activeTab != index)
            return "bg-slate-100 text-slate-700 hover:bg-slate-200 hover:text-slate-900";

        return index switch
        {
            1 => "bg-blue-600 text-white shadow-sm",
            2 => "bg-indigo-600 text-white shadow-sm",
            3 => "bg-sky-600 text-white shadow-sm",
            4 => "bg-violet-600 text-white shadow-sm",
            5 => "bg-amber-600 text-white shadow-sm",
            6 => "bg-teal-600 text-white shadow-sm",
            7 => "bg-slate-700 text-white shadow-sm",
            8 => "bg-emerald-600 text-white shadow-sm",
            _ => "bg-blue-600 text-white shadow-sm"
        };
    }

    private string GetStatusTabSolidClass(string status)
    {
        if (selectedStatusFilter != status)
            return "bg-slate-100 text-slate-700 hover:bg-slate-200";

        return status switch
        {
            StaffTransferStatuses.Draft => "bg-slate-700 text-white shadow-sm",
            StaffTransferStatuses.PendingStaffConfirmation => "bg-amber-600 text-white shadow-sm",
            StaffTransferStatuses.CorrectionRequested => "bg-rose-600 text-white shadow-sm",
            StaffTransferStatuses.PendingReceivingApproval => "bg-indigo-600 text-white shadow-sm",
            StaffTransferStatuses.Scheduled => "bg-purple-600 text-white shadow-sm",
            StaffTransferStatuses.Active => "bg-emerald-600 text-white shadow-sm",
            StaffTransferStatuses.ActivationFailed => "bg-red-700 text-white shadow-sm",
            _ => "bg-blue-600 text-white shadow-sm"
        };
    }
