    private async Task OnDestinationOrganisationChangedAsync(ChangeEventArgs e)
    {
        if (editInput is null || activeDetail is null)
            return;

        if (int.TryParse(e.Value?.ToString(), out var destOrgId))
        {
            editInput.Job.DestinationOrganisationId = destOrgId;
            editInput.Job.DestinationOrganisationStructureId = 0;
            lookups = await Transfers.LoadFormLookupsAsync(activeDetail.Staff.CurrentOrganisationId, activeDetail.Staff.IndividualId, destOrgId);
            var orgName = lookups.Organisations.FirstOrDefault(x => x.Id == destOrgId)?.Name ?? string.Empty;
            foreach (var door in editInput.DoorAccessChanges)
            {
                door.BuildingName = orgName;
            }
        }
    }

    private void OnDestinationStructureChanged(ChangeEventArgs e)
    {
        if (editInput is null || lookups is null)
            return;

        var structId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        editInput.Job.DestinationOrganisationStructureId = structId;

        var dept = lookups.Departments.FirstOrDefault(d => d.Id == structId);
        var deptName = dept?.Name ?? string.Empty;

        // Filter & default supervisor from the selected Receiving Department / Structure
        var firstSup = SupervisorsForDestinationStructure.FirstOrDefault();
        editInput.Job.NewReportingSupervisorIndividualId = firstSup?.IndividualId;
        editInput.Work.AttendanceVerificationSupervisorIndividualId = firstSup?.IndividualId;

        // Populate Tab 03 Location, Tab 05 Door Access, and Tab 06 Reporting Location & Reporting Officer
        if (!string.IsNullOrWhiteSpace(deptName))
        {
            editInput.Work.ProposedLocationName = deptName;
            editInput.Reporting.ReportingLocation = deptName;
            foreach (var door in editInput.DoorAccessChanges)
            {
                door.DepartmentOfficeArea = deptName;
                door.ProposedAccessGroups = $"{deptName} — Standard Staff Door Access";
            }
        }
        editInput.Reporting.ReportingToIndividualId = firstSup?.IndividualId;
        editInput.Reporting.ReportingToName = firstSup?.Name;
    }

    private void OnTransferTypeChanged(ChangeEventArgs e)
    {
        if (editInput is null || activeDetail is null)
            return;

        if (int.TryParse(e.Value?.ToString(), out var ttId))
        {
            editInput.Job.TransferTypeId = ttId;
            var transferType = (StaffTransferType)ttId;
            editInput.Job.IsExternalTransfer = transferType is StaffTransferType.ExternalOrganizationTransfer or StaffTransferType.TemporaryAssignmentOrSecondment;
            editInput.Job.IsLegalEmployerChanged = transferType == StaffTransferType.ExternalOrganizationTransfer;

            if (ttId == (int)StaffTransferType.InternalDepartmental)
            {
                // Lock to current position settings on Internal Transfer
                editInput.Job.TransferAppointmentMode = TransferAppointmentModes.OrganisationalReassignment;
                editInput.Job.DestinationPositionId = activeDetail.Job.ExistingPositionId;
                editInput.Job.DestinationPositionTitle = activeDetail.Job.ExistingPositionTitle;
                editInput.Job.DestinationPositionMatrixId = activeDetail.Job.ExistingPositionMatrixId;
            }
            else if (transferType == StaffTransferType.ExternalOrganizationTransfer)
            {
                editInput.Job.TransferAppointmentMode = TransferAppointmentModes.NewEmploymentAppointment;
            }
            else if (transferType == StaffTransferType.TemporaryAssignmentOrSecondment)
            {
                editInput.Job.TransferAppointmentMode = TransferAppointmentModes.OrganisationalReassignment;
                editInput.Job.SecondmentEndDate ??= editInput.Job.EffectiveDate.AddMonths(6);
            }
        }
    }

    private void OnDestinationPositionChanged(ChangeEventArgs e)
    {
        if (editInput is null || lookups is null || activeDetail is null)
            return;

        if (int.TryParse(e.Value?.ToString(), out var posId) && posId > 0)
        {
            editInput.Job.DestinationPositionId = posId;
            var pos = lookups.Positions.FirstOrDefault(p => p.PositionId == posId);
            if (pos is not null)
            {
                editInput.Job.DestinationPositionTitle = pos.Name;
                editInput.Job.DestinationPositionMatrixId = pos.PositionMatrixId ?? editInput.Job.ExistingPositionMatrixId;
                editInput.Job.SalaryBenefitChangeNotes =
                    $"Position: {pos.Name} · Basic Salary: MVR {(pos.BasicSalary ?? activeDetail.Job.ExistingBasicSalary ?? 0m):N2}";
            }
        }
        else
        {
            editInput.Job.DestinationPositionId = activeDetail.Job.ExistingPositionId;
            editInput.Job.DestinationPositionTitle = activeDetail.Job.ExistingPositionTitle;
            editInput.Job.DestinationPositionMatrixId = activeDetail.Job.ExistingPositionMatrixId;
        }
    }

    private void OnNewSupervisorChanged(ChangeEventArgs e)
    {
        if (editInput is null)
            return;

        var supId = int.TryParse(e.Value?.ToString(), out var id) ? (int?)id : null;
        editInput.Job.NewReportingSupervisorIndividualId = supId;
