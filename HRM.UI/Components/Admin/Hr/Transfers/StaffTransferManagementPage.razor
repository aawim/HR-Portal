    private void OnAccessStructureChanged(StaffTransferAccessChangeItemDto row, string? structureName)
    {
        row.AccessAreaName = structureName ?? string.Empty;
        var dept = lookups?.Departments.FirstOrDefault(d => d.Name == structureName);
        row.AccessAreaCode = dept?.Id.ToString() ?? StaffTransferAccessAreas.DepartmentInformation;
        var firstScope = GetStructureScopes(row.AccessAreaName).FirstOrDefault();
        row.CurrentScopeSummary = firstScope ?? $"{row.AccessAreaName} — Staff & Directory Access";
    }

    private IEnumerable<string> GetStructureScopes(string? structureName)
    {
        if (lookups is null)
            return Enumerable.Empty<string>();

        if (!string.IsNullOrWhiteSpace(structureName))
        {
            var matched = lookups.StructureAccessScopes
                .Where(s => string.Equals(s.StructureName, structureName, StringComparison.OrdinalIgnoreCase))
                .Select(s => s.ScopeLabel)
                .ToList();
            if (matched.Count > 0)
                return matched;
        }

        return lookups.StructureAccessScopes.Select(s => s.ScopeLabel).Distinct();
    }

    private async Task OpenTransferAsync(int staffTransferId)
    {
        printableDocument = null;
        activeDetail = await Transfers.LoadDetailAsync(staffTransferId);
        if (activeDetail is not null)
        {
            lookups = await Transfers.LoadFormLookupsAsync(
                activeDetail.Staff.CurrentOrganisationId,
                activeDetail.Staff.IndividualId,
                activeDetail.Job.DestinationOrganisationId > 0 ? activeDetail.Job.DestinationOrganisationId : null);
            BindEditInputFromDetail(activeDetail);
            decisionInput = new StaffTransferDecisionInput
            {
                StaffTransferId = activeDetail.StaffTransferId,
                ExpectedVersion = activeDetail.CurrentVersion,
                Decision = "Approve"
            };
            activeTab = 1;
        }
    }

    private void BindEditInputFromDetail(StaffTransferDetailDto d)
    {
        d.Work.ScheduleEffectiveDate = d.Reporting.ReportingDate;

        selectedHandoverRefs = !string.IsNullOrWhiteSpace(d.Reporting.OutstandingAssignmentsSummary)
            ? d.Reporting.WorkHandoverLinks
                .Where(h => !h.Status.Contains("Cancel", StringComparison.OrdinalIgnoreCase) &&
                            d.Reporting.OutstandingAssignmentsSummary.Contains(h.Reference, StringComparison.OrdinalIgnoreCase))
                .Select(h => h.Reference)
                .ToHashSet(StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        selectedAssetRefs = !string.IsNullOrWhiteSpace(d.Reporting.AssetsToReturnSummary)
            ? d.Reporting.AssetReturnRequestLinks
                .Where(a => !a.Status.Contains("Cancel", StringComparison.OrdinalIgnoreCase) &&
                            d.Reporting.AssetsToReturnSummary.Contains(a.Reference, StringComparison.OrdinalIgnoreCase))
                .Select(a => a.Reference)
                .ToHashSet(StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        editInput = new StaffTransferSaveInput
        {
            StaffTransferId = d.StaffTransferId,
            IndividualId = d.Staff.IndividualId,
            CurrentJobId = d.Staff.CurrentJobId,
            ExpectedVersion = d.CurrentVersion,
            PortalAccessContext = d.PortalAccessContext,
            Job = d.Job,
            Work = d.Work,
            AccessChanges = d.AccessChanges.ToList(),
            DoorAccessChanges = d.DoorAccessChanges.ToList(),
            Reporting = d.Reporting
        };
    }

    private void OpenHandoverModal()
    {
        showHandoverModal = true;
    }

    private void ToggleHandoverSelection(string reference, bool isSelected)
    {
        if (isSelected)
            selectedHandoverRefs.Add(reference);
        else
            selectedHandoverRefs.Remove(reference);
    }

    private void RemoveHandoverSelection(string reference)
    {
        selectedHandoverRefs.Remove(reference);
        ApplySelectedHandovers();
    }

    private void ApplySelectedHandovers()
    {
        if (editInput is not null && activeDetail is not null)
        {
            var chosen = SelectedHandoverItems.ToList();
            editInput.Reporting.HandoverRequired = chosen.Count > 0 || editInput.Reporting.HandoverRequired;
            editInput.Reporting.OutstandingAssignmentsSummary = chosen.Count > 0
                ? string.Join("; ", chosen.Select(x => $"{x.Reference} ({x.Title} - {x.Status})"))
                : string.Empty;
        }
        showHandoverModal = false;
    }

