    private void OnReportingDateChanged(ChangeEventArgs e)
    {
        if (editInput is null)
            return;

        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            editInput.Reporting.ReportingDate = dt.Date;
