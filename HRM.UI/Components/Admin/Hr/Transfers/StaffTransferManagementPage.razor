    private void AddAccessChangeRow()
    {
        var defaultDept = activeDetail?.Staff.CurrentDepartmentName ?? lookups?.Departments.FirstOrDefault()?.Name ?? "";
        editInput?.AccessChanges.Add(new StaffTransferAccessChangeItemDto
        {
            AccessAreaCode = activeDetail?.Staff.CurrentOrganisationStructureId.ToString() ?? StaffTransferAccessAreas.DepartmentInformation,
            AccessAreaName = defaultDept,
            CurrentScopeSummary = $"{defaultDept} — Staff & Directory Access",
            TransitionAction = StaffTransferAccessActions.RevokeOldGrantNew,
            ProposedScopeSummary = "Receiving department scope",
            ProvisioningStatus = "Pending"
        });
    }

    private async Task SaveTransferAsync(bool submitImmediately)
    {
        if (editInput is null)
            return;

        isSaving = true;
        try
        {
            editInput.Work.ScheduleEffectiveDate = editInput.Reporting.ReportingDate;
            editInput.SubmitImmediately = submitImmediately;
            var res = await Transfers.SaveAsync(editInput);
            if (!res.Success)
            {
                Toasts.Show(res.Message, ToastType.Error);
                return;
            }

            Toasts.Show(res.Message, ToastType.Success);
            await ReloadDashboardAsync();

            if (editInput.StaffTransferId > 0)
            {
                await OpenTransferAsync(editInput.StaffTransferId);
            }
            else if (dashboard?.Items.Count > 0)
            {
                var latest = dashboard.Items.OrderByDescending(x => x.StaffTransferId).First();
                await OpenTransferAsync(latest.StaffTransferId);
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SubmitAdvisoryCommentAsync()
    {
        if (activeDetail is null || activeDetail.StaffTransferId <= 0 || string.IsNullOrWhiteSpace(newCommentText))
            return;

        var res = await Transfers.AddCommentAsync(activeDetail.StaffTransferId, newCommentKind, newCommentText, true);
        if (res.Success)
        {
            newCommentText = string.Empty;
            Toasts.Show(res.Message, ToastType.Success);
            await OpenTransferAsync(activeDetail.StaffTransferId);
        }
        else
        {
            Toasts.Show(res.Message, ToastType.Error);
        }
    }

    private async Task SubmitReceivingDecisionAsync()
    {
        if (activeDetail is null || activeDetail.StaffTransferId <= 0)
            return;

        decisionInput.StaffTransferId = activeDetail.StaffTransferId;
        decisionInput.ExpectedVersion = activeDetail.CurrentVersion;
        var res = await Transfers.SubmitReceivingDecisionAsync(decisionInput);
        if (res.Success)
        {
            Toasts.Show(res.Message, ToastType.Success);
            await ReloadDashboardAsync();
            await OpenTransferAsync(activeDetail.StaffTransferId);
        }
        else
        {
            Toasts.Show(res.Message, ToastType.Error);
        }
    }

    private async Task TriggerActivationNowAsync(int staffTransferId)
    {
        var result = await Transfers.ActivateTransferAsync(staffTransferId);
        if (result.Succeeded)
        {
            Toasts.Show(result.Message, ToastType.Success);
        }
        else
        {
            Toasts.Show(result.Message, ToastType.Error);
        }

        await ReloadDashboardAsync();
        await OpenTransferAsync(staffTransferId);
    }

    private async Task MarkDoorProvisionedAsync(int doorAccessId)
    {
        if (activeDetail is null)
            return;

        var res = await Transfers.UpdateDoorAccessProvisioningAsync(
            doorAccessId,
            StaffTransferDoorAccessStates.StateProvisioned,
            "Confirmed by security/admin officer.");
        if (res.Success)
        {
            Toasts.Show(res.Message, ToastType.Success);
            await OpenTransferAsync(activeDetail.StaffTransferId);
        }
        else
        {
            Toasts.Show(res.Message, ToastType.Error);
        }
    }

    private async Task OpenPrintableViewAsync(int staffTransferId, string variant)
    {
        printableDocument = await Transfers.GetPrintableDocumentAsync(staffTransferId, variant);
        if (printableDocument is null)
        {
            Toasts.Show("Unable to load printable transfer notice.", ToastType.Error);
