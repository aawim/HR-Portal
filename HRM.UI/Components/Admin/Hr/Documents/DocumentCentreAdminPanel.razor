    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024.0 / 1024.0:F2} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private static RenderFragment RenderStatusBadge(string status) => builder =>
    {
        var css = status switch
        {
            "PendingVerification" or "PendingApproval" or "Submitted" or "UnderReview" => "bg-amber-100 text-amber-800",
            "Approved" or "Active" or "OfficialRecord" or "Published" or "Issued" => "bg-emerald-100 text-emerald-800",
            "Rejected" or "Revoked" or "Disposed" => "bg-rose-100 text-rose-800",
            "Archived" or "ReturnedForCorrection" or "Superseded" => "bg-purple-100 text-purple-800",
            _ => "bg-slate-100 text-slate-700"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"rounded-full px-2.5 py-0.5 font-semibold text-[11px] {css}");
        builder.AddContent(2, status);
        builder.CloseElement();
    };

    private static RenderFragment RenderClassificationBadge(string classification) => builder =>
    {
        var css = classification switch
        {
            "Public" => "bg-blue-50 text-blue-700",
            "Internal" => "bg-slate-100 text-slate-700",
            "Confidential" => "bg-amber-100 text-amber-800",
            "Restricted" or "Secret" => "bg-rose-100 text-rose-800",
            _ => "bg-slate-100 text-slate-700"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"rounded-full px-2 py-0.5 font-medium text-[11px] {css}");
        builder.AddContent(2, classification);
        builder.CloseElement();
    };
}
