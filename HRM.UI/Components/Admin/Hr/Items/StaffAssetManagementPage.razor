@page "/admin/hr/items/asset-custody"
@namespace HRM.Components.Admin.Hr.Items
@using HRM.DTOs
@using HRM.DTOs.Assets
@using HRM.Enums
@using HRM.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer
@inject HRM.Services.Contracts.StaffAssetServiceContracts.IOperations AssetService
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Staff Asset Custody & Lifecycle - HR Portal</PageTitle>

<div class="mx-auto max-w-7xl space-y-6 px-2 py-4">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-blue-700">
                    Staff Asset Assignment & Custody
                </span>
                <span class="text-xs text-slate-400">AM_ Auditable Serialized Asset Lifecycle</span>
            </div>
            <h1 class="mt-1 text-2xl font-extrabold text-slate-900">Asset Assignment, Acknowledgement & Custody</h1>
            <p class="text-sm text-slate-500">
                Track physical possession, verified handover, item-level staff accept/reject decisions, HR authorization, active custody, returns, and clearances.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            @if (dashboard?.CanManageInventory == true)
            {
                <button type="button"
                        @onclick="OpenNewAssetModal"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-800 shadow-sm hover:bg-slate-50">
                    <span>+</span>
                    <span>Register Asset</span>
                </button>
            }

            @if (dashboard?.CanInitiateIssuance == true)
            {
                <button type="button"
                        @onclick="OpenNewIssuanceModal"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-blue-700">
                    <span>+</span>
                    <span>Issue Assets</span>
                </button>
            }

            <button type="button"
                    @onclick="OpenNewServiceRequestModal"
                    class="inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-amber-50 px-3.5 py-2 text-xs font-semibold text-amber-800 shadow-sm hover:bg-amber-100">
                <span>🛠</span>
                <span>+ Service Ticket</span>
            </button>

            <button type="button"
                    @onclick="OpenNewUpgradeModal"
                    class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-300 bg-indigo-50 px-3.5 py-2 text-xs font-semibold text-indigo-800 shadow-sm hover:bg-indigo-100">
                <span>⚡</span>
                <span>+ Upgrade</span>
            </button>

            <button type="button"
                    @onclick="OpenNewLoanerModal"
                    class="inline-flex items-center gap-1.5 rounded-xl border border-teal-300 bg-teal-50 px-3.5 py-2 text-xs font-semibold text-teal-800 shadow-sm hover:bg-teal-100">
                <span>💻</span>
                <span>+ Issue Loaner</span>
            </button>

            <button type="button"
                    @onclick='() => activeTab = "clearance"'
                    class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50">
                <span>📋</span>
                <span>Staff Clearance</span>
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="flex min-h-[400px] items-center justify-center">
            <div class="flex flex-col items-center gap-2">
                <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-600 border-t-transparent"></div>
                <p class="text-xs text-slate-500">Loading asset register & custody records...</p>
            </div>
        </div>
    }
    else if (dashboard is not null)
    {
        <!-- Solid-color KPI Tiles (Section 15: Blue Total, Green Assigned, Teal Available, Amber Staff Pending, Violet HR Pending, Rose Overdue Returns) -->
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
            <div class="rounded-2xl bg-blue-600 p-4 text-white shadow-sm">
                <div class="text-xs font-medium text-blue-100 uppercase tracking-wider">Total Assets</div>
                <div class="mt-2 text-2xl font-black">@dashboard.TotalAssetsCount</div>
                <div class="mt-1 text-[11px] text-blue-100">Registered equipment</div>
            </div>

            <div class="rounded-2xl bg-emerald-600 p-4 text-white shadow-sm">
                <div class="text-xs font-medium text-emerald-100 uppercase tracking-wider">Assigned</div>
                <div class="mt-2 text-2xl font-black">@dashboard.AssignedAssetsCount</div>
                <div class="mt-1 text-[11px] text-emerald-100">Active custody</div>
            </div>

            <div class="rounded-2xl bg-teal-600 p-4 text-white shadow-sm">
                <div class="text-xs font-medium text-teal-100 uppercase tracking-wider">Available</div>
                <div class="mt-2 text-2xl font-black">@dashboard.AvailableAssetsCount</div>
                <div class="mt-1 text-[11px] text-teal-100">In inventory pool</div>
            </div>

            <div class="rounded-2xl bg-amber-500 p-4 text-white shadow-sm">
                <div class="text-xs font-medium text-amber-100 uppercase tracking-wider">Staff Pending</div>
                <div class="mt-2 text-2xl font-black">@dashboard.StaffPendingCount</div>
                <div class="mt-1 text-[11px] text-amber-100">Handed over, unconfirmed</div>
            </div>

            <div class="rounded-2xl bg-indigo-600 p-4 text-white shadow-sm">
                <div class="text-xs font-medium text-indigo-100 uppercase tracking-wider">HR Pending</div>
                <div class="mt-2 text-2xl font-black">@dashboard.HrPendingCount</div>
                <div class="mt-1 text-[11px] text-indigo-100">Accepted, awaiting review</div>
            </div>

            <div class="rounded-2xl bg-rose-600 p-4 text-white shadow-sm">
                <div class="text-xs font-medium text-rose-100 uppercase tracking-wider">Overdue Returns</div>
                <div class="mt-2 text-2xl font-black">@dashboard.OverdueReturnsCount</div>
                <div class="mt-1 text-[11px] text-rose-100">Unresolved custody/clearance</div>
            </div>
        </div>

        <!-- Overdue & Reconciliation Alerts -->
        @if (dashboard.OverdueAndReconciliationAlerts.Count > 0)
        {
            <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-100 text-xs text-amber-700">⚠️</span>
                        <h2 class="text-sm font-bold text-amber-900">Overdue Custody & Response Alerts (@dashboard.OverdueAndReconciliationAlerts.Count)</h2>
                    </div>
                    <span class="text-xs text-amber-700">Action required</span>
                </div>
                <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var alert in dashboard.OverdueAndReconciliationAlerts.Take(6))
                    {
                        <div class="rounded-xl border border-amber-200 bg-white p-3 text-xs shadow-sm">
                            <div class="flex items-center justify-between">
                                <span class="font-mono font-bold text-slate-900">@alert.AssetCode</span>
                                <span class="rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-800">@alert.AlertKind</span>
                            </div>
                            <div class="mt-1 font-medium text-slate-800 truncate">@alert.ItemSummary</div>
                            <div class="mt-0.5 text-slate-500">Staff: <span class="text-slate-700 font-medium">@alert.StaffName</span></div>
                            <div class="mt-1 text-[11px] text-slate-600">@alert.Description</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Tabs Navigation -->
        <div class="border-b border-slate-200">
            <nav class="-mb-px flex space-x-6 overflow-x-auto text-xs font-semibold">
                <button type="button"
                        @onclick='() => activeTab = "issuances"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "issuances" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Issuance Queue (@dashboard.Issuances.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "inventory"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "inventory" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Asset Register (@dashboard.Assets.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "custody"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "custody" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Active Custody (@dashboard.Custodies.Count(c => c.CustodyToLocal == null))
                </button>

                <button type="button"
                        @onclick='() => activeTab = "returns"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "returns" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Returns (@dashboard.Returns.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "service"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "service" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    IT Workshop & Repairs (@dashboard.ServiceRequests.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "upgrades"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "upgrades" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Hardware Upgrades
                </button>

                <button type="button"
                        @onclick='() => activeTab = "loaners"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "loaners" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Temporary Loaners (@dashboard.ActiveLoaners.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "replacements"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "replacements" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Replacements (@dashboard.ReplacementLinks.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "clearance"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "clearance" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Staff Clearance
                </button>

                <button type="button"
                        @onclick='() => activeTab = "transfers"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "transfers" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Transfer Dispositions (@dashboard.TransferDispositions.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "categories"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "categories" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Categories & Policies (@dashboard.Categories.Count)
                </button>

                <button type="button"
                        @onclick='() => activeTab = "audit"'
                        class="whitespace-nowrap border-b-2 py-3 px-1 transition @(activeTab == "audit" ? "border-blue-600 text-blue-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                    Audit Timeline (@dashboard.RecentAuditEvents.Count)
                </button>
            </nav>
        </div>

        <!-- TAB 1: Issuances Queue -->
        @if (activeTab == "issuances")
        {
            <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="text-slate-500">Filter status:</span>
                        <select @bind="issuanceStatusFilter" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs">
                            <option value="All">All statuses</option>
                            <option value="@AssetIssuanceStatuses.Draft">Draft</option>
                            <option value="@AssetIssuanceStatuses.AwaitingHandover">Awaiting Handover</option>
                            <option value="@AssetIssuanceStatuses.PendingStaffAcknowledgement">Pending Staff Decision</option>
                            <option value="@AssetIssuanceStatuses.PendingHRApproval">Pending HR Approval</option>
                            <option value="@AssetIssuanceStatuses.ReturnedForCorrection">Returned For Correction</option>
                            <option value="@AssetIssuanceStatuses.Completed">Completed</option>
                            <option value="@AssetIssuanceStatuses.PartiallyCompleted">Partially Completed</option>
                            <option value="@AssetIssuanceStatuses.Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="text-xs text-slate-500">
                        Showing @FilteredIssuances.Count() issuances
                    </div>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <table class="w-full text-left text-xs text-slate-700">
                        <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-4 py-3">Reference / Staff</th>
                                <th class="px-4 py-3">Department & Position</th>
                                <th class="px-4 py-3">Date</th>
                                <th class="px-4 py-3">Lines Progress</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!FilteredIssuances.Any())
                            {
                                <tr>
                                    <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                                        No asset issuances found matching the selected filter.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in FilteredIssuances)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3">
                                        <div class="font-mono font-bold text-slate-900">@item.ReferenceNumber</div>
                                        <div class="font-semibold text-slate-800">@item.EmployeeName</div>
                                        <div class="text-[11px] text-slate-400">ID: @item.StaffNumber</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="font-medium text-slate-800">@item.DepartmentName</div>
                                        <div class="text-slate-500 text-[11px]">@item.PositionTitle</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div>@item.IssueDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-[11px] text-slate-400">Updated @item.UpdatedAtLocal.ToString("dd/MM HH:mm")</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-1.5 font-medium">
                                            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@item.TotalLines total</span>
                                            @if (item.HandedOverLines > 0)
                                            {
                                                <span class="rounded bg-amber-50 px-1.5 py-0.5 text-amber-700">@item.HandedOverLines handed over</span>
                                            }
                                            @if (item.AcceptedLines > 0)
                                            {
                                                <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-emerald-700">@item.AcceptedLines accepted</span>
                                            }
                                            @if (item.RejectedLines > 0)
                                            {
                                                <span class="rounded bg-rose-50 px-1.5 py-0.5 text-rose-700">@item.RejectedLines rejected</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold @GetIssuanceBadgeClass(item.Status)">
                                            @item.Status
                                        </span>
                                        @if (item.IsOverdueAcknowledgement)
                                        {
                                            <div class="mt-1 text-[10px] font-semibold text-rose-600">⚠️ Response Overdue</div>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button"
                                                    @onclick="() => OpenIssuanceDetailModal(item.AssetIssuanceId)"
                                                    class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50">
                                                Review / Manage
                                            </button>
                                            <button type="button"
                                                    @onclick="() => PrintIssuanceDocumentAsync(item.AssetIssuanceId)"
                                                    class="rounded-lg border border-slate-300 bg-white p-1 text-slate-600 hover:bg-slate-50 hover:text-slate-900"
                                                    title="Print A4 Handover Sheet">
                                                🖨️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- TAB 2: Asset Register -->
        @if (activeTab == "inventory")
        {
            <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <input type="text"
                               @bind="assetSearchTerm"
                               @bind:event="oninput"
                               placeholder="Search code, serial, description..."
                               class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs w-60" />

                        <select @bind="assetCategoryFilter" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs">
                            <option value="0">All Categories</option>
                            @foreach (var cat in dashboard.Categories)
                            {
                                <option value="@cat.AssetCategoryId">@cat.Name</option>
                            }
                        </select>

                        <select @bind="assetStatusFilter" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs">
                            <option value="All">All Statuses</option>
                            <option value="@AssetInventoryStatuses.Available">Available</option>
                            <option value="@AssetInventoryStatuses.Reserved">Reserved</option>
                            <option value="@AssetInventoryStatuses.PendingHandover">Pending Handover</option>
                            <option value="@AssetInventoryStatuses.Assigned">Assigned</option>
                            <option value="@AssetInventoryStatuses.ReturnPending">Return Pending</option>
                            <option value="@AssetInventoryStatuses.Maintenance">Maintenance</option>
                            <option value="@AssetInventoryStatuses.Lost">Lost</option>
                            <option value="@AssetInventoryStatuses.Disposed">Disposed</option>
                        </select>
                    </div>

                    <div class="text-xs text-slate-500">
                        Showing @FilteredAssets.Count() assets
                    </div>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <table class="w-full text-left text-xs text-slate-700">
                        <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-4 py-3">Asset Code / Serial</th>
                                <th class="px-4 py-3">Description & Brand</th>
                                <th class="px-4 py-3">Category</th>
                                <th class="px-4 py-3">Condition & Location</th>
                                <th class="px-4 py-3">Current Status</th>
                                <th class="px-4 py-3">Active Custodian</th>
                                <th class="px-4 py-3 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!FilteredAssets.Any())
                            {
                                <tr>
                                    <td colspan="7" class="px-4 py-8 text-center text-slate-400">
                                        No inventory assets match the search criteria.
                                    </td>
                                </tr>
                            }
                            @foreach (var asset in FilteredAssets)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3 font-mono">
                                        <div class="font-bold text-slate-900">@asset.AssetCode</div>
                                        <div class="text-[11px] text-slate-500">S/N: @(asset.SerialNumber ?? "None")</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="font-semibold text-slate-800">@asset.Name</div>
                                        <div class="text-[11px] text-slate-500">@asset.Brand @asset.Model</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700">
                                            @asset.CategoryName
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div>@asset.CurrentConditionName</div>
                                        <div class="text-[11px] text-slate-400">@asset.Location</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold @GetAssetStatusBadgeClass(asset.Status)">
                                            @asset.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (asset.ActiveCustodianName is not null)
                                        {
                                            <div class="font-medium text-slate-900">@asset.ActiveCustodianName</div>
                                            <div class="text-[10px] text-slate-400">Since @asset.ActiveCustodyFromLocal?.ToString("dd MMM yyyy")</div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 italic">None</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <button type="button"
                                                @onclick="() => EditAsset(asset)"
                                                class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- TAB 3: Active Custody -->
        @if (activeTab == "custody")
        {
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Effective Active Custodies</h2>
                    <span class="text-xs text-slate-500">Showing @dashboard.Custodies.Count records</span>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <table class="w-full text-left text-xs text-slate-700">
                        <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-4 py-3">Staff Custodian</th>
                                <th class="px-4 py-3">Asset Details</th>
                                <th class="px-4 py-3">Custody From</th>
                                <th class="px-4 py-3">Expected Return</th>
                                <th class="px-4 py-3">Condition / Accessories</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var c in dashboard.Custodies)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3">
                                        <div class="font-bold text-slate-900">@c.EmployeeName</div>
                                        <div class="text-[11px] text-slate-500">@c.DepartmentName • @c.StaffNumber</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="font-mono font-semibold text-slate-900">@c.AssetCode</div>
                                        <div class="text-slate-700">@c.ItemName</div>
                                        <div class="text-[11px] text-slate-400">S/N: @(c.SerialNumber ?? "None")</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div>@c.CustodyFromLocal.ToString("dd MMM yyyy")</div>
                                        <div class="text-[11px] text-slate-400">Ref: @c.IssuanceReference</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (c.ExpectedReturnDate.HasValue)
                                        {
                                            <div class="@(c.IsOverdueReturn ? "font-bold text-rose-600" : "text-slate-700")">
                                                @c.ExpectedReturnDate.Value.ToString("dd MMM yyyy")
                                            </div>
                                            @if (c.IsOverdueReturn)
                                            {
                                                <div class="text-[10px] font-semibold text-rose-600">OVERDUE</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">Indefinite</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        <div>@c.ConditionAtIssueName</div>
                                        <div class="text-[11px] text-slate-500">@c.Accessories</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold @(c.Status == "Active" ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-800")">
                                            @c.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-right">
