<!-- Modal 11: Configuration & Component History Timeline -->
@if (showConfigTimelineModal && configTimeline is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
        <div class="w-full max-w-3xl rounded-2xl bg-white p-6 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                <div>
                    <h3 class="text-base font-extrabold text-slate-900">Hardware Configuration Timeline</h3>
                    <p class="text-xs font-mono text-blue-600">[@configTimeline.AssetCode] @configTimeline.Name (S/N: @configTimeline.SerialNumber)</p>
                </div>
                <button type="button" @onclick="() => showConfigTimelineModal = false" class="text-slate-400 hover:text-slate-600">✕</button>
            </div>

            <!-- Current Specs Summary -->
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <div>
                    <div class="text-[10px] font-semibold uppercase text-slate-400">Total Installed RAM</div>
                    <div class="font-bold text-slate-900">@(string.IsNullOrWhiteSpace(configTimeline.CurrentRamSummary) ? "Not captured" : configTimeline.CurrentRamSummary)</div>
                </div>
                <div>
                    <div class="text-[10px] font-semibold uppercase text-slate-400">Storage Summary</div>
                    <div class="font-bold text-slate-900">@(string.IsNullOrWhiteSpace(configTimeline.CurrentStorageSummary) ? "Not captured" : configTimeline.CurrentStorageSummary)</div>
                </div>
                <div>
                    <div class="text-[10px] font-semibold uppercase text-slate-400">Processor</div>
                    <div class="font-bold text-slate-900">@(configTimeline.CurrentProcessorSpec ?? "N/A")</div>
                </div>
                <div>
                    <div class="text-[10px] font-semibold uppercase text-slate-400">Battery Health</div>
                    <div class="font-bold text-slate-900">@(configTimeline.CurrentBatteryHealth.HasValue ? $"{configTimeline.CurrentBatteryHealth}%" : "N/A")</div>
                </div>
            </div>

            <!-- Active Installed Modular Components -->
            <div class="space-y-2 text-xs">
                <span class="font-bold text-slate-800">Currently Installed Hardware Components (@configTimeline.ActiveComponents.Count)</span>
                <div class="overflow-x-auto rounded-xl border border-slate-200">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold">
                            <tr>
                                <th class="p-2.5">Type</th>
                                <th class="p-2.5">Brand & Model</th>
                                <th class="p-2.5">Specification / Capacity</th>
                                <th class="p-2.5">Serial #</th>
                                <th class="p-2.5">Slot</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!configTimeline.ActiveComponents.Any())
                            {
                                <tr>
                                    <td colspan="5" class="p-3 text-center text-slate-400">No modular component records logged.</td>
                                </tr>
                            }
                            @foreach (var comp in configTimeline.ActiveComponents)
                            {
                                <tr>
                                    <td class="p-2.5 font-bold text-slate-800">@comp.ComponentType</td>
                                    <td class="p-2.5 text-slate-700">@comp.Brand @comp.Model</td>
                                    <td class="p-2.5 font-medium text-slate-800">@(comp.CapacityOrRating ?? comp.Specification)</td>
                                    <td class="p-2.5 font-mono text-slate-600">@(comp.SerialNumber ?? "N/A")</td>
                                    <td class="p-2.5 text-slate-500">@(comp.SlotOrPortLocation ?? "Internal")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Snapshots History -->
            @if (configTimeline.Snapshots.Count > 0)
            {
                <div class="space-y-2 text-xs">
                    <span class="font-bold text-slate-800">Configuration Snapshot History (@configTimeline.Snapshots.Count)</span>
                    <div class="space-y-2 max-h-48 overflow-y-auto">
                        @foreach (var snap in configTimeline.Snapshots)
                        {
                            <div class="rounded-xl border border-slate-200 p-3 bg-white space-y-1">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-slate-800">@snap.TriggerEvent</span>
                                    <span class="text-slate-400 text-[10px]">@snap.CapturedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                                <div class="text-[11px] text-slate-600">
                                    RAM: <span class="font-medium text-slate-800">@snap.RamSummary</span> | Storage: <span class="font-medium text-slate-800">@snap.StorageSummary</span>
                                </div>
                                <div class="text-[10px] text-slate-400">Captured by: @snap.CapturedByName</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="flex justify-end border-t border-slate-200 pt-3">
                <button type="button" @onclick="() => showConfigTimelineModal = false" class="rounded-lg bg-slate-900 px-4 py-1.5 text-xs font-semibold text-white hover:bg-slate-800">
                    Close
                </button>
            </div>
        </div>
    </div>
}

