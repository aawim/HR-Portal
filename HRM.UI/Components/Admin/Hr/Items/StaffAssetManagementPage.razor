                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(d.Status == "Executed" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                            @d.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-slate-500">
