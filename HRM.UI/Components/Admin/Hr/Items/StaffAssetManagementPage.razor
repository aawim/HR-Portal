            Decisions = [new AssetHrLineDecisionInput
            {
                AssetIssuanceItemId = lineId,
                ExpectedVersion = version,
                Decision = decision,
                Comments = decision == AssetHrDecisionKinds.HRApproved ? "Authorized custody" : "Returned/Closed"
