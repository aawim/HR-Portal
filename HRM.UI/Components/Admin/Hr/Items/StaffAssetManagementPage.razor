                            <tr>
                                <th class="px-4 py-3">Staff Member</th>
                                <th class="px-4 py-3">Asset</th>
                                <th class="px-4 py-3">Transfer Route</th>
                                <th class="px-4 py-3">Disposition Decision</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3">Decided At</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!dashboard.TransferDispositions.Any())
                            {
                                <tr>
                                    <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                                        No transfer dispositions recorded.
                                    </td>
                                </tr>
                            }
                            @foreach (var d in dashboard.TransferDispositions)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3 font-semibold text-slate-900">@d.EmployeeName</td>
                                    <td class="px-4 py-3">
                                        <div class="font-mono font-bold text-slate-800">@d.AssetCode</div>
                                        <div class="text-[11px] text-slate-500">@d.ItemName</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div>@d.FromDepartmentName → @(string.IsNullOrWhiteSpace(d.ToDepartmentName) ? "Destination" : d.ToDepartmentName)</div>
                                    </td>
