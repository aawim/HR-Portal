        <!-- TAB 7: Audit Timeline -->
        @if (activeTab == "audit")
        {
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Immutable Audit Event Timeline</h2>
                    <span class="text-xs text-slate-500">Showing last @dashboard.RecentAuditEvents.Count events</span>
                </div>

                <div class="flow-root rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <ul class="-mb-8">
                        @foreach (var ev in dashboard.RecentAuditEvents)
                        {
                            <li>
                                <div class="relative pb-8">
                                    <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-slate-200" aria-hidden="true"></span>
                                    <div class="relative flex space-x-3">
                                        <div>
                                            <span class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center ring-8 ring-white text-white text-xs">
                                                📜
                                            </span>
                                        </div>
                                        <div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
                                            <div>
                                                <p class="text-xs font-bold text-slate-900">
                                                    @ev.EventType
                                                    @if (!string.IsNullOrWhiteSpace(ev.AssetCode))
                                                    {
                                                        <span class="ml-1 font-mono text-blue-600">(@ev.AssetCode)</span>
                                                    }
                                                </p>
                                                <p class="text-[11px] text-slate-500">
                                                    Entity: <span class="font-mono">@ev.RelatedEntityType #@ev.RelatedEntityId</span>
                                                    @if (ev.FromStatus != null || ev.ToStatus != null)
                                                    {
                                                        <span class="ml-1 text-slate-600">(@(ev.FromStatus ?? "None") → @(ev.ToStatus ?? "None"))</span>
                                                    }
                                                </p>
                                            </div>
                                            <div class="whitespace-nowrap text-right text-[11px] text-slate-400">
                                                <div>@ev.AtLocal.ToString("dd MMM yyyy HH:mm")</div>
                                                <div>By @ev.ActorName</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- TAB: IT Workshop & Repairs -->
        @if (activeTab == "service")
        {
            <div class="space-y-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h2 class="text-sm font-bold text-slate-800">IT Maintenance, Repairs & Service Tickets</h2>
                        <p class="text-xs text-slate-500">Corrective repairs, hardware diagnostics, parts replacement, and technician work orders.</p>
                    </div>
                    <button type="button"
                            @onclick="OpenNewServiceRequestModal"
                            class="inline-flex items-center gap-1.5 rounded-xl bg-amber-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-amber-700">
                        <span>+</span>
                        <span>Create Service Ticket</span>
                    </button>
                </div>

                <!-- Service Requests Queue -->
                <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <table class="w-full text-left text-xs text-slate-700">
                        <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-4 py-3">Reference / Title</th>
                                <th class="px-4 py-3">Staff Requester</th>
                                <th class="px-4 py-3">Type & Priority</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3">Submitted</th>
                                <th class="px-4 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!dashboard.ServiceRequests.Any())
                            {
                                <tr>
                                    <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                                        No active service requests or repair tickets found.
                                    </td>
                                </tr>
                            }
                            @foreach (var req in dashboard.ServiceRequests)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3">
                                        <div class="font-mono font-bold text-slate-900">@req.ReferenceNumber</div>
                                        <div class="font-medium text-slate-800">@req.Title</div>
                                        <div class="text-[11px] text-slate-400">@req.ItemsCount item(s) logged</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="font-medium text-slate-800">@req.StaffName</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700">@req.RequestType</span>
                                        <span class="ml-1 rounded px-2 py-0.5 text-[10px] font-bold @(req.Priority == "Critical" || req.Priority == "High" ? "bg-rose-100 text-rose-800" : "bg-blue-50 text-blue-700")">
                                            @req.Priority
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(req.Status == AssetServiceRequestStatuses.Completed ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                            @req.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-slate-500">
                                        @req.SubmittedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm")
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button"
                                                    @onclick="() => OpenAssignTechModal(req.AssetServiceRequestId)"
                                                    class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                                                Assign Tech
                                            </button>
                                            <button type="button"
                                                    @onclick='() => PrintServiceDocAsync(req.AssetServiceRequestId, "ServiceReport")'
                                                    class="rounded-lg bg-slate-900 px-2.5 py-1 text-xs font-semibold text-white hover:bg-slate-800">
                                                🖨️ Report
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Maintenance Jobs & Bench Diagnostics -->
                <div class="space-y-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600">Active Bench Diagnostics & Work Orders (@dashboard.MaintenanceJobs.Count)</h3>
                    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <table class="w-full text-left text-xs text-slate-700">
                            <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                                <tr>
                                    <th class="px-4 py-3">Work Order #</th>
                                    <th class="px-4 py-3">Asset Code</th>
                                    <th class="px-4 py-3">Job Type</th>
                                    <th class="px-4 py-3">Technician</th>
                                    <th class="px-4 py-3">Total Cost</th>
                                    <th class="px-4 py-3">Status</th>
                                    <th class="px-4 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @if (!dashboard.MaintenanceJobs.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="px-4 py-8 text-center text-slate-400">
                                            No bench work orders currently recorded.
                                        </td>
                                    </tr>
                                }
                                @foreach (var job in dashboard.MaintenanceJobs)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="px-4 py-3 font-mono font-bold text-slate-900">@job.WorkOrderNumber</td>
                                        <td class="px-4 py-3 font-mono font-bold text-blue-600">@job.AssetCode</td>
                                        <td class="px-4 py-3 font-medium text-slate-700">@job.JobType</td>
                                        <td class="px-4 py-3 text-slate-800">@job.TechnicianName</td>
                                        <td class="px-4 py-3 font-mono font-semibold text-slate-900">$@job.TotalCost.ToString("F2")</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(job.Status == AssetMaintenanceJobStatuses.Completed ? "bg-emerald-100 text-emerald-800" : "bg-indigo-100 text-indigo-800")">
                                                @job.Status
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            <div class="flex items-center justify-end gap-1.5">
