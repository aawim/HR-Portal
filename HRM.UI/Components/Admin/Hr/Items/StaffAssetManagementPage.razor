                            <tr>
                                <th class="px-4 py-3">Return Ref / Staff</th>
                                <th class="px-4 py-3">Return Type</th>
                                <th class="px-4 py-3">Items Returned</th>
                                <th class="px-4 py-3">Return Date</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!dashboard.Returns.Any())
                            {
                                <tr>
                                    <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                                        No asset returns recorded.
                                    </td>
                                </tr>
                            }
                            @foreach (var ret in dashboard.Returns)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3">
                                        <div class="font-mono font-bold text-slate-900">@ret.ReferenceNumber</div>
                                        <div class="font-medium text-slate-800">@ret.EmployeeName</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-700 font-medium">@ret.ReturnType</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="space-y-1">
                                            @foreach (var item in ret.Items)
                                            {
                                                <div class="text-[11px]">
                                                    <span class="font-mono font-bold text-slate-800">@item.AssetCode</span>: @item.ItemName
