    private static string GetIssuanceBadgeClass(string status) => status switch
    {
        AssetIssuanceStatuses.Completed => "bg-emerald-100 text-emerald-800",
        AssetIssuanceStatuses.PartiallyCompleted => "bg-teal-100 text-teal-800",
        AssetIssuanceStatuses.PendingStaffAcknowledgement => "bg-amber-100 text-amber-800",
        AssetIssuanceStatuses.PendingHRApproval => "bg-indigo-100 text-indigo-800",
        AssetIssuanceStatuses.ReturnedForCorrection => "bg-rose-100 text-rose-800",
        AssetIssuanceStatuses.Cancelled => "bg-slate-100 text-slate-800",
        _ => "bg-blue-100 text-blue-800"
    };

    private static string GetAssetStatusBadgeClass(string status) => status switch
    {
        AssetInventoryStatuses.Available => "bg-teal-100 text-teal-800",
        AssetInventoryStatuses.Assigned => "bg-emerald-100 text-emerald-800",
        AssetInventoryStatuses.Reserved or AssetInventoryStatuses.PendingHandover => "bg-amber-100 text-amber-800",
        AssetInventoryStatuses.Maintenance => "bg-indigo-100 text-indigo-800",
        AssetInventoryStatuses.Lost or AssetInventoryStatuses.Disposed => "bg-rose-100 text-rose-800",
        _ => "bg-slate-100 text-slate-800"
    };

    private static string GetLineBadgeClass(string status) => status switch
    {
        AssetIssuanceLineStatuses.HRApproved => "bg-emerald-100 text-emerald-800",
        AssetIssuanceLineStatuses.Accepted => "bg-blue-100 text-blue-800",
        AssetIssuanceLineStatuses.Rejected => "bg-rose-100 text-rose-800",
        AssetIssuanceLineStatuses.HandedOver => "bg-amber-100 text-amber-800",
        AssetIssuanceLineStatuses.ReturnedForCorrection => "bg-rose-100 text-rose-800",
        _ => "bg-slate-100 text-slate-800"
    };

