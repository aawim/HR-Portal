    private async Task SubmitServiceRequestAsync()
    {
        if (serviceAssetItemId <= 0)
        {
            Toasts.Error("Please select an equipment asset item.");
            return;
        }

        var asset = dashboard?.Assets.FirstOrDefault(a => a.AssetItemId == serviceAssetItemId);
        serviceInput.Items =
        [
            new AssetServiceRequestItemInput
            {
                AssetItemId = serviceAssetItemId,
                AssetCustodyId = asset?.ActiveCustodianIndividualId == serviceInput.IndividualId ? (int?)null : null,
                ItemRequestType = serviceInput.RequestType,
                ReportedFaultOrRequirement = string.IsNullOrWhiteSpace(serviceInput.Description) ? serviceInput.Title : serviceInput.Description
            }
        ];

        var res = await AssetService.CreateServiceRequestAsync(serviceInput);
        if (res.Success)
        {
            Toasts.Success("Service ticket created successfully.");
            showServiceModal = false;
            await LoadDataAsync();
        }
        else
        {
            Toasts.Error(res.Message);
        }
    }

