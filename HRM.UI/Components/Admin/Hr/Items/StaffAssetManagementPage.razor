@code {
    private bool loading = true;
    private AssetDashboardData? dashboard;
    private string activeTab = "issuances";
    private string issuanceStatusFilter = "All";

    private string assetSearchTerm = "";
    private int assetCategoryFilter = 0;
    private string assetStatusFilter = "All";

    // Modals
    private bool showAssetModal;
    private AssetItemSaveInput assetInput = new();

    private bool showIssuanceModal;
    private AssetIssuanceDraftInput issuanceDraftInput = new();
    private int selectedStaffIndividualId;
    private int assetToAddId;

    private bool showDetailModal;
    private AssetIssuanceDetailDto? selectedIssuance;

    private bool showReplaceModal;
    private AssetIssuanceLineDto? lineToReplace;
    private AssetReplaceLineInput replaceInput = new();

    private bool showPrintModal;
    private AssetPrintableDocumentDto? printableDoc;
    private int currentPrintingIssuanceId;

    private bool showInspectModal;
    private AssetReturnDetailDto? returnToInspect;
    private Dictionary<int, AssetReturnItemInspectInput> inspectItemsMap = new();

    // Lifecycle Modals & State
    private bool showServiceModal;
    private AssetServiceRequestCreateInput serviceInput = new();
    private int selectedServiceStaffId;
    private int serviceAssetItemId;

    private bool showAssignTechModal;
    private AssetTechnicianAssignInput assignTechInput = new();

    private bool showCompleteJobModal;
    private AssetMaintenanceJobCompleteInput completeJobInput = new();

    private bool showUpgradeModal;
    private AssetHardwareUpgradeInput upgradeInput = new();

    private bool showConfigTimelineModal;
    private AssetConfigurationTimelineDto? configTimeline;

    private bool showIssueLoanerModal;
    private AssetLoanerIssueInput loanerInput = new();
    private int selectedLoanerStaffId;

    private bool showReturnLoanerModal;
    private AssetLoanerReturnInput loanerReturnInput = new();

    private bool showReplacementModal;
    private AssetReplacementLinkInput replacementInput = new();

    private bool showServicePrintModal;
    private AssetServicePrintableDocumentDto? servicePrintDoc;

    private int selectedClearanceStaffId;
    private AssetClearanceCheckDto? clearanceCheck;
    private bool isEvaluatingClearance;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
