                                                    {
                                                        <span class="ml-1 text-slate-500 font-medium">(@item.InspectionResult)</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div>@ret.ReturnDateLocal.ToString("dd MMM yyyy")</div>
