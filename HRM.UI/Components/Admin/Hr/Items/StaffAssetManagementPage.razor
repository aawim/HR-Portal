                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- TAB 5: Transfers -->
        @if (activeTab == "transfers")
        {
            <div class="space-y-4">
                <div class="flex items-center justify-between">
