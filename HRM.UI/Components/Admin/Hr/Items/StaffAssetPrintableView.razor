@namespace HRM.Components.Admin.Hr.Items
@using HRM.DTOs.Assets
@using HRM.Enums
@inject IJSRuntime JS

@if (Document is not null)
{
    <div class="space-y-4">
        <!-- Action Bar (Hidden in Print) -->
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 print:hidden">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center rounded-md bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-800">
                    @Document.DocumentNumber • v@Document.DocumentVersion
                </span>
                <span class="text-xs text-slate-600">
                    Generated @Document.GeneratedAtLocal.ToString("dd MMM yyyy HH:mm")
                </span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                @if (AllowVariantSwitch)
                {
                    <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
                        <button type="button"
                                @onclick="() => OnVariantChanged.InvokeAsync(AssetDocumentVariants.StandardHandoverRecord)"
                                class="rounded-md px-2.5 py-1 font-medium transition @(Document.DocumentVariant == AssetDocumentVariants.StandardHandoverRecord ? "bg-blue-600 text-white" : "text-slate-600 hover:text-slate-900")">
                            Standard Handover Record
                        </button>
                        <button type="button"
                                @onclick="() => OnVariantChanged.InvokeAsync(AssetDocumentVariants.RestrictedSecurityRecord)"
                                class="rounded-md px-2.5 py-1 font-medium transition @(Document.DocumentVariant == AssetDocumentVariants.RestrictedSecurityRecord ? "bg-amber-600 text-white" : "text-slate-600 hover:text-slate-900")">
                            Restricted Security Record
                        </button>
                    </div>
                }

                <button type="button"
                        @onclick="PrintDocumentAsync"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                    <span>Print / Save PDF</span>
                </button>

                @if (OnClose.HasDelegate)
                {
                    <button type="button"
                            @onclick="OnClose"
                            class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
                        Close
                    </button>
                }
            </div>
        </div>

        <!-- Printable A4 Document Sheet -->
        <div class="mx-auto max-w-[210mm] border border-slate-200 bg-white p-8 shadow-sm print:m-0 print:max-w-none print:border-none print:p-0 print:shadow-none font-sans text-slate-900">
            <!-- Header -->
            <div class="border-b-2 border-slate-900 pb-4">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="text-xs font-bold uppercase tracking-widest text-slate-500">Government of Maldives</div>
                        <h1 class="text-xl font-extrabold text-slate-900">@Document.OrganisationName</h1>
                        <p class="text-sm font-medium text-slate-600">@Document.DepartmentName</p>
                    </div>
                    <div class="text-right">
                        <div class="inline-block rounded border border-slate-300 bg-slate-50 px-2 py-1 text-xs font-mono font-semibold text-slate-800">
                            @Document.DocumentNumber
                        </div>
                        <div class="mt-1 text-xs text-slate-500">
                            Status: <span class="font-semibold text-slate-800">@Document.IssuanceStatus</span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 flex items-center justify-between">
                    <h2 class="text-base font-bold uppercase tracking-wider text-blue-900">
                        Asset Handover & Acknowledgement Record
                    </h2>
                    <div class="text-xs text-slate-600">
                        Issue Date: <span class="font-medium text-slate-900">@Document.IssueDate.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Employee & Job Metadata Box -->
            <div class="mt-4 grid grid-cols-2 gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 text-xs">
                <div>
                    <span class="text-slate-500">Staff Member:</span>
                    <span class="ml-1 font-bold text-slate-900">@Document.EmployeeName</span>
                </div>
                <div>
                    <span class="text-slate-500">Employee Number:</span>
                    <span class="ml-1 font-mono font-semibold text-slate-900">@Document.StaffNumber</span>
                </div>
                <div>
                    <span class="text-slate-500">Position / Designation:</span>
                    <span class="ml-1 font-medium text-slate-900">@Document.PositionTitle</span>
                </div>
                <div>
                    <span class="text-slate-500">Issuance Reference:</span>
                    <span class="ml-1 font-mono font-semibold text-slate-900">@Document.IssuanceReference</span>
                </div>
                <div class="col-span-2">
                    <span class="text-slate-500">Issuance Purpose / Reason:</span>
                    <span class="ml-1 text-slate-800">@Document.Reason</span>
                </div>
            </div>

            <!-- Serialized Assets Table -->
            <div class="mt-5">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Issued Equipment & Serialized Assets</h3>
                <table class="mt-2 w-full table-auto border-collapse border border-slate-300 text-left text-[11px]">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700">
                            <th class="border border-slate-300 px-2 py-1.5 w-8 text-center">#</th>
                            <th class="border border-slate-300 px-2 py-1.5">Asset Code / Serial</th>
                            <th class="border border-slate-300 px-2 py-1.5">Item Description</th>
                            <th class="border border-slate-300 px-2 py-1.5">Condition & Accessories</th>
                            <th class="border border-slate-300 px-2 py-1.5">Staff Decision</th>
                            <th class="border border-slate-300 px-2 py-1.5">HR Authorization</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Document.Lines)
                        {
                            <tr class="border-b border-slate-200">
                                <td class="border border-slate-300 px-2 py-1.5 text-center font-mono text-slate-500">@line.LineNumber</td>
                                <td class="border border-slate-300 px-2 py-1.5 font-mono">
                                    <div class="font-bold text-slate-900">@line.AssetCode</div>
                                    <div class="text-[10px] text-slate-500">S/N: @line.SerialNumberDisplay</div>
                                </td>
                                <td class="border border-slate-300 px-2 py-1.5">
                                    <div class="font-semibold text-slate-900">@line.ItemName</div>
                                    <div class="text-[10px] text-slate-500">@line.CategoryName @(string.IsNullOrWhiteSpace(line.BrandModel) ? "" : $"• {line.BrandModel}")</div>
                                </td>
                                <td class="border border-slate-300 px-2 py-1.5">
                                    <span class="inline-block rounded bg-slate-100 px-1.5 py-0.5 font-medium text-slate-700">@line.ConditionName</span>
                                    <div class="mt-0.5 text-[10px] text-slate-600">@line.Accessories</div>
                                </td>
                                <td class="border border-slate-300 px-2 py-1.5">
                                    <span class="font-semibold @(line.StaffDecision == "Accepted" ? "text-emerald-700" : "text-rose-700")">
                                        @line.StaffDecision
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(line.StaffRemarks))
                                    {
                                        <div class="text-[10px] text-slate-500 italic">"@line.StaffRemarks"</div>
                                    }
                                    @if (line.StaffConfirmedAtLocal.HasValue)
                                    {
                                        <div class="text-[9px] text-slate-400">@line.StaffConfirmedAtLocal.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    }
                                </td>
                                <td class="border border-slate-300 px-2 py-1.5">
                                    <span class="font-semibold @(line.HrDecision == "HRApproved" ? "text-blue-700" : "text-amber-700")">
                                        @line.HrDecision
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(line.HrOfficerName))
                                    {
                                        <div class="text-[10px] text-slate-500">By: @line.HrOfficerName</div>
                                    }
                                    @if (line.HrDecidedAtLocal.HasValue)
                                    {
                                        <div class="text-[9px] text-slate-400">@line.HrDecidedAtLocal.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Custody Terms & Conditions -->
            <div class="mt-5 rounded border border-slate-200 bg-slate-50 p-3 text-[11px] text-slate-700">
                <div class="font-bold uppercase tracking-wider text-slate-900">Custody Terms & Undertaking</div>
                <p class="mt-1 leading-relaxed">@Document.CustodyTermsText</p>
                <div class="mt-2 border-t border-slate-200 pt-2 text-[10px] text-slate-500 italic">
                    @Document.AcknowledgementDisclaimerText
                </div>
            </div>

            <!-- Signature & Verification Sign-off Blocks -->
            <div class="mt-6 grid grid-cols-2 gap-8 text-xs">
                <div class="rounded border border-slate-200 p-3">
                    <div class="text-slate-500">Staff Custodian Acknowledgement:</div>
                    <div class="mt-2 font-bold text-slate-900">@Document.EmployeeName</div>
                    <div class="text-slate-500">Staff ID: @Document.StaffNumber</div>
                    <div class="mt-4 border-t border-dashed border-slate-300 pt-1 text-[10px] text-slate-400">
                        Electronic acknowledgement recorded via employee portal
                    </div>
                </div>

                <div class="rounded border border-slate-200 p-3">
                    <div class="text-slate-500">Issuing / Authorizing HR Officer:</div>
                    <div class="mt-2 font-bold text-slate-900">@Document.Lines.FirstOrDefault()?.HrOfficerName</div>
                    <div class="text-slate-500">@Document.OrganisationName</div>
                    <div class="mt-4 border-t border-dashed border-slate-300 pt-1 text-[10px] text-slate-400">
                        Authorized in accordance with civil service property regulations
                    </div>
                </div>
            </div>

            <!-- Integrity Footer -->
            <div class="mt-8 border-t border-slate-200 pt-3 flex items-center justify-between text-[10px] text-slate-400 font-mono">
                <div>Document Hash (SHA-256): <span class="select-all text-slate-600">@Document.Sha256Hash</span></div>
                <div>GHR System Verification • Page 1 of 1</div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AssetPrintableDocumentDto? Document { get; set; }
    [Parameter] public bool AllowVariantSwitch { get; set; } = true;
    [Parameter] public EventCallback<string> OnVariantChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task PrintDocumentAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
