@namespace HRM.Components.Admin.Hr.Items
@using HRM.DTOs.Items
@inject IJSRuntime JS

@if (Report is not null)
{
    <div class="space-y-4">
        <!-- Action Bar (Hidden when printing) -->
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-xs print:hidden">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">
                    Official Custody & Clearance Note
                </span>
                <span class="text-xs text-slate-500">
                    Staff: <strong class="text-slate-800">@Report.StaffName</strong> (@Report.StaffNumber)
                </span>
            </div>

            <div class="flex items-center gap-2">
                <button type="button"
                        @onclick="PrintDocumentAsync"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 transition">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                    <span>Print Release Note (PDF)</span>
                </button>

                @if (OnClose.HasDelegate)
                {
                    <button type="button"
                            @onclick="OnClose"
                            class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 transition">
                        ✕ Close
                    </button>
                }
            </div>
        </div>

        <!-- Printable Document Area -->
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm print:p-0 print:border-none print:shadow-none text-slate-900">
            <!-- Header with Official Details -->
            <div class="flex flex-wrap items-start justify-between border-b-2 border-slate-900 pb-5 gap-4">
                <div>
                    <h1 class="text-2xl font-black uppercase tracking-tight text-slate-900">@Report.OrganisationName</h1>
                    <p class="text-sm font-semibold text-slate-600 mt-0.5">Asset Custody, Consumables & Property Release Report</p>
                    <span class="inline-block mt-2 font-mono text-[11px] text-slate-500">Document Generated: @Report.GeneratedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</span>
                </div>
                <div class="text-right text-xs space-y-1">
                    <div class="font-bold uppercase tracking-wider text-slate-500 text-[10px]">Staff Profile</div>
                    <div class="text-base font-bold text-slate-900">@Report.StaffName</div>
                    <div class="text-slate-600">ID / Staff #: <span class="font-mono font-medium">@Report.StaffNumber</span></div>
                    <div class="text-slate-600">Position: @Report.Position</div>
                    <div class="text-slate-600">Department: @Report.Department</div>
                </div>
            </div>

            <!-- Active Assets In Custody -->
            <div class="mt-6 space-y-3">
                <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                        1. Job-Related Equipment & Assets in Active Custody (@Report.ActiveAssets.Sum(a => a.Lines.Count))
                    </h2>
                    <span class="text-[11px] font-semibold @(Report.ActiveAssets.Count == 0 ? "text-emerald-700" : "text-amber-700")">
                        @(Report.ActiveAssets.Count == 0 ? "✓ No active assets currently assigned (Cleared)" : "Items awaiting return or in active possession")
                    </span>
                </div>

                @if (Report.ActiveAssets.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-emerald-300 bg-emerald-50/50 p-4 text-xs text-emerald-800">
                        No outstanding physical assets or hardware held by this staff member.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-200">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 font-semibold text-slate-700 border-b border-slate-200">
                                <tr>
                                    <th class="p-2.5">Ref #</th>
                                    <th class="p-2.5">Item Name</th>
                                    <th class="p-2.5">Inventory #</th>
                                    <th class="p-2.5">Serial #</th>
                                    <th class="p-2.5">Issued Date</th>
                                    <th class="p-2.5">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var req in Report.ActiveAssets)
                                {
                                    @foreach (var line in req.Lines)
                                    {
                                        <tr>
                                            <td class="p-2.5 font-mono text-slate-600">@req.Reference</td>
                                            <td class="p-2.5 font-medium text-slate-900">@line.ItemName</td>
                                            <td class="p-2.5 font-mono">@(line.InventoryNumber ?? "—")</td>
                                            <td class="p-2.5 font-mono">@(line.SerialNumber ?? "—")</td>
                                            <td class="p-2.5 text-slate-600">@(req.IssuedAtUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                            <td class="p-2.5">
                                                <span class="rounded px-2 py-0.5 text-[10px] font-semibold bg-blue-100 text-blue-800">
                                                    @req.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Returned Assets -->
            @if (Report.ReturnedAssets.Count > 0)
            {
                <div class="mt-6 space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                            2. Returned & Replaced Equipment History (@Report.ReturnedAssets.Sum(a => a.Lines.Count))
                        </h2>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-200">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 font-semibold text-slate-700 border-b border-slate-200">
                                <tr>
                                    <th class="p-2.5">Ref #</th>
                                    <th class="p-2.5">Item Name</th>
                                    <th class="p-2.5">Inventory #</th>
                                    <th class="p-2.5">Return Date</th>
                                    <th class="p-2.5">Return Condition</th>
                                    <th class="p-2.5">HR Inspection Notes</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var req in Report.ReturnedAssets)
                                {
                                    @foreach (var line in req.Lines)
                                    {
                                        <tr>
                                            <td class="p-2.5 font-mono text-slate-600">@req.Reference</td>
                                            <td class="p-2.5 font-medium text-slate-900">@line.ItemName</td>
                                            <td class="p-2.5 font-mono">@(line.InventoryNumber ?? "—")</td>
                                            <td class="p-2.5 text-slate-600">@(req.ReturnedAtUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                            <td class="p-2.5">
                                                <span class="rounded px-2 py-0.5 text-[10px] font-semibold @(req.ReturnCondition is "Good" or "Fair" ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")">
                                                    @(req.ReturnCondition ?? "Returned")
                                                </span>
                                            </td>
                                            <td class="p-2.5 text-slate-600">@(req.ReturnNotes ?? "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Personal / Consumable Items Consumed -->
            <div class="mt-6 space-y-3">
                <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                        3. Personal Items & Office Supplies Consumed (@Report.Consumables.Count records)
                    </h2>
                    <span class="text-[11px] text-slate-500">Non-returnable consumable supplies</span>
                </div>

                @if (Report.Consumables.Count == 0)
                {
                    <div class="text-xs text-slate-500 italic p-2">No personal supplies recorded for this staff member.</div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-200">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 font-semibold text-slate-700 border-b border-slate-200">
                                <tr>
                                    <th class="p-2.5">Ref #</th>
                                    <th class="p-2.5">Items</th>
                                    <th class="p-2.5">Requested Date</th>
                                    <th class="p-2.5">Purpose / Reason</th>
                                    <th class="p-2.5">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var req in Report.Consumables)
                                {
                                    <tr>
                                        <td class="p-2.5 font-mono text-slate-600">@req.Reference</td>
                                        <td class="p-2.5 font-medium text-slate-900">
                                            @string.Join(", ", req.Lines.Select(l => $"{l.ItemName} (x{l.Quantity})"))
                                        </td>
                                        <td class="p-2.5 text-slate-600">@req.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td class="p-2.5 text-slate-600">@req.Reason</td>
                                        <td class="p-2.5">
                                            <span class="rounded px-2 py-0.5 text-[10px] font-semibold bg-slate-100 text-slate-800">
                                                @req.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Sign-Off & Verification Block -->
            <div class="mt-10 border-t-2 border-slate-900 pt-6">
                <div class="grid grid-cols-2 gap-12 text-xs">
                    <div class="space-y-4">
                        <div class="text-slate-500 font-semibold uppercase text-[10px]">Staff Custodian / Relinquishing Employee</div>
                        <div class="h-12 border-b border-slate-400"></div>
                        <div>
                            <div class="font-bold text-slate-900">@Report.StaffName</div>
                            <div class="text-slate-500 text-[11px]">Date: _______________________</div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="text-slate-500 font-semibold uppercase text-[10px]">Authorized HR & Property Officer</div>
                        <div class="h-12 border-b border-slate-400"></div>
                        <div>
                            <div class="font-bold text-slate-900">Name: _______________________________</div>
                            <div class="text-slate-500 text-[11px]">Designation: _________________________</div>
                            <div class="text-slate-500 text-[11px]">Date: _______________________________</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ItemStaffClearanceReportDto? Report { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task PrintDocumentAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
