    private int newPeriodMonth = DateTime.UtcNow.Month;
    private DateOnly newPeriodStartDate = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateOnly newPeriodEndDate = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month));
    private DateOnly newPeriodAttendanceCutoff = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, Math.Min(20, DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month)));
    private DateOnly newPeriodAdjustmentCutoff = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, Math.Min(22, DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month)));
    private DateOnly newPeriodPaymentDate = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, Math.Min(28, DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month)));

    private int editingPeriodId = 0;
    private DateOnly editPeriodStartDate;
    private DateOnly editPeriodEndDate;
    private DateOnly editPeriodAttendanceCutoff;
    private DateOnly editPeriodAdjustmentCutoff;
    private DateOnly editPeriodPaymentDate;
    private int newRunPeriodId = 0;
    private int newRunType = 1;
    private string newRunTitle = "";

    private decimal TotalGross => runs.Sum(r => r.TotalGrossEarnings);
    private decimal TotalDeductions => runs.Sum(r => r.TotalDeductions);
