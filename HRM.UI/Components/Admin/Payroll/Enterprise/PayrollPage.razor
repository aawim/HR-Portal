    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
    }

    private void ToggleFullWidth() => isFullWidth = !isFullWidth;

    private async Task RefreshAllAsync()
    {
        isLoading = true;
        try
        {
            try
            {
                payrollConfig = await Payroll.GetConfigurationAsync();
                if (payrollConfig != null)
                {
                    configEmployeePension = payrollConfig.EmployeePensionPercentage;
                    configEmployerPension = payrollConfig.EmployerPensionPercentage;
                    configOvertimeMultiplier = payrollConfig.OvertimeMultiplier;
                    configDefaultPaymentDay = payrollConfig.DefaultPaymentDay;
                    configAttendanceCutoffDay = payrollConfig.AttendanceCutoffDay;
                    configAdjustmentCutoffDay = payrollConfig.AdjustmentCutoffDay;
                }
            }
            catch { }

            periods = await Payroll.GetPeriodsAsync();
            if (periods.Count > 0 && selectedPeriod == null)
            {
                selectedPeriod = periods.FirstOrDefault(p => p.PeriodStatus == (int)PayrollPeriodStatus.Open) ?? periods.First();
                newRunPeriodId = selectedPeriod.PayrollPeriodId;
                newRunTitle = $"{DateTime.UtcNow:MMMM yyyy} Regular Payroll";
            }

            runs = await Payroll.GetRunsAsync(selectedPeriod?.PayrollPeriodId);
            if (runs.Count > 0 && selectedRun == null)
            {
                selectedRun = runs.First();
                await SelectRun(selectedRun);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to load payroll data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectRun(PayrollRunSummaryRow run)
    {
        selectedRun = run;
        try
        {
            currentProgress = await Payroll.GetProgressAsync(run.PayrollRunId);
            exceptions = await Payroll.GetExceptionsAsync(run.PayrollRunId);
            if (run.Status == (int)PayrollRunStatus.Calculating || (currentProgress != null && currentProgress.PercentComplete < 100.0 && currentProgress.PercentComplete > 0))
            {
                StartProgressPolling();
            }
        }
        catch { }
    }

    private void StartProgressPolling()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = new CancellationTokenSource();
        var token = pollCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested && selectedRun != null)
                {
                    await Task.Delay(1500, token);
                    var progress = await Payroll.GetProgressAsync(selectedRun.PayrollRunId);
                    currentProgress = progress;
                    await InvokeAsync(StateHasChanged);

                    if (progress == null || progress.PercentComplete >= 100.0)
                    {
                        await InvokeAsync(async () =>
                        {
                            await RefreshAllAsync();
                            StateHasChanged();
                        });
                        break;
                    }
                }
            }
            catch (OperationCanceledException) { }
            catch { }
        }, token);
    }

    private async Task QueueCalculationAsync()
    {
        if (selectedRun == null) return;
        try
        {
            var res = await Payroll.QueueCalculationAsync(selectedRun.PayrollRunId);
            if (res.Success)
            {
                Toasts.Success(res.Message);
                await RefreshAllAsync();
                StartProgressPolling();
            }
            else
            {
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Queue calculation failed: {ex.Message}");
        }
    }

    private async Task SubmitReviewAsync()
    {
        if (selectedRun == null) return;
        try
        {
            var res = await Payroll.SubmitReviewAsync(selectedRun.PayrollRunId, "Submitted for review");
            if (res.Success)
            {
                Toasts.Success("Payroll submitted for review.");
                await RefreshAllAsync();
