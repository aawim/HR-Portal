    private async Task DownloadBankExportAsync(int batchId)
    {
        try
        {
            string csv = await Payroll.ExportPaymentFileAsync(batchId);
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv));
            var fileName = $"Bank_Payment_Batch_{batchId}_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("eval", $"(function(){{ const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); a.remove(); }})()");
            Toasts.Success($"Bank CSV downloaded: {fileName}");
