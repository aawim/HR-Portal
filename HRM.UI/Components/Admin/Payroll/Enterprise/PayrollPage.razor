    private void OpenCreatePeriodModal()
    {
        newPeriodYear = DateTime.UtcNow.Year;
        newPeriodMonth = DateTime.UtcNow.Month;
        ComputeNewPeriodDates();
        showCreatePeriodModal = true;
    }

    private void ComputeNewPeriodDates()
    {
        var daysInMonth = DateTime.DaysInMonth(newPeriodYear, newPeriodMonth);
        newPeriodStartDate = new DateOnly(newPeriodYear, newPeriodMonth, 1);
        newPeriodEndDate = new DateOnly(newPeriodYear, newPeriodMonth, daysInMonth);

        int attDay = Math.Min(configAttendanceCutoffDay, daysInMonth);
        int adjDay = Math.Min(configAdjustmentCutoffDay, daysInMonth);
        int payDay = Math.Min(configDefaultPaymentDay, daysInMonth);

        newPeriodAttendanceCutoff = new DateOnly(newPeriodYear, newPeriodMonth, attDay);
        newPeriodAdjustmentCutoff = new DateOnly(newPeriodYear, newPeriodMonth, adjDay);
        newPeriodPaymentDate = new DateOnly(newPeriodYear, newPeriodMonth, payDay);
    }

    private void OpenEditPeriodModal(PayrollPeriodRow p)
    {
        editingPeriodId = p.PayrollPeriodId;
        editPeriodStartDate = p.PeriodStartDate;
        editPeriodEndDate = p.PeriodEndDate;
        editPeriodAttendanceCutoff = p.AttendanceCutoffDate;
        editPeriodAdjustmentCutoff = p.AdjustmentCutoffDate;
        editPeriodPaymentDate = p.PaymentDate;
        showEditPeriodModal = true;
    }

