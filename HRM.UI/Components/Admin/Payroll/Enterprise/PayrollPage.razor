        try
        {
            var res = await Payroll.CreateRunAsync(new CreatePayrollRunInput(newRunPeriodId, newRunType, newRunTitle, null));
            if (res.Success)
            {
                Toasts.Success("Payroll run created.");
                showCreateRunModal = false;
                await RefreshAllAsync();
