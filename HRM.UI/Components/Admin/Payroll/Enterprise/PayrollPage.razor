    private static string GetRunTypeName(int runType) => runType switch
    {
        1 => "Regular Monthly",
        2 => "Supplementary",
        3 => "Off-Cycle",
        4 => "Final Settlement",
        5 => "Arrears & Adjustments",
        _ => "Standard"
    };

    private static RenderFragment GetStatusBadge(int status) => builder =>
    {
        var (cls, text) = (PayrollRunStatus)status switch
        {
            PayrollRunStatus.Draft => ("bg-slate-100 text-slate-700 border-slate-200", "Draft"),
            PayrollRunStatus.Queued => ("bg-blue-100 text-blue-800 border-blue-200", "Queued"),
            PayrollRunStatus.Calculating => ("bg-blue-100 text-blue-800 border-blue-200 animate-pulse", "Calculating"),
            PayrollRunStatus.Calculated => ("bg-indigo-100 text-indigo-800 border-indigo-200", "Calculated"),
            PayrollRunStatus.ValidationFailed => ("bg-red-100 text-red-800 border-red-200", "Validation Issues"),
            PayrollRunStatus.UnderReview => ("bg-amber-100 text-amber-800 border-amber-200", "Under Review"),
            PayrollRunStatus.Approved => ("bg-emerald-100 text-emerald-800 border-emerald-200", "Approved"),
            PayrollRunStatus.Finalised => ("bg-purple-100 text-purple-800 border-purple-200", "Finalised & Locked"),
            PayrollRunStatus.PaymentPrepared => ("bg-cyan-100 text-cyan-800 border-cyan-200", "Payment Prepared"),
            PayrollRunStatus.Paid => ("bg-teal-100 text-teal-800 border-teal-200", "Paid & Reconciled"),
            PayrollRunStatus.Failed => ("bg-rose-100 text-rose-800 border-rose-200", "Failed"),
            _ => ("bg-slate-100 text-slate-700 border-slate-200", ((PayrollRunStatus)status).ToString())
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold {cls}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
    }
