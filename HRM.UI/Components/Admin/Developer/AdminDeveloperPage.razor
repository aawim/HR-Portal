@page "/developer"
@page "/developer/{ActiveTab}"
@page "/admin/developer"
@page "/admin/developer/{ActiveTab}"
@using HRM.Components.Admin.Settings
@using HRM.Components.Admin.Settings.JobTypes
@using HRM.DTOs
@using HRM.Services.Interfaces
@using HRM.Services
@using HRM.Enum
@using HRM.UI.Services.Developer
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

@inject IUserAccessService UserAccess
@inject PortalContext PortalContext
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject IJSRuntime JS
@inject DeveloperTestClockService TestClockPreference
@inject HRM.Services.Contracts.RequestTransitionSettingsServiceContracts.IOperations TransitionService
@inject HRM.Services.Contracts.RequestNotificationServiceContracts.IOperations NotificationService

<PageTitle>Developer Workspace - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (checking)
        {
            <div class="mx-auto max-w-7xl p-4">
                <div class="flex flex-col items-center justify-center p-12 my-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
                    <div class="w-12 h-12 border-4 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
                    <p class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-200">Loading Developer Dashboard...</p>
                    <p class="text-xs text-slate-400 mt-0.5">Verifying developer permissions and workspace configuration</p>
                </div>
            </div>
        }
        else if (!isDeveloper)
        {
            <div class="mx-auto max-w-7xl p-4">
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900 shadow-sm space-y-2">
                    <h2 class="font-bold text-base">Developer Access Required</h2>
                    <p>Your account does not currently hold Developer permissions or group membership.</p>
                    <a href="/online" class="inline-block font-semibold text-blue-700 underline mt-2">Return to Employee Portal</a>
                </div>
            </div>
        }
        else
        {
            <section class="developer-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-all duration-300 @(isFullWidth ? "max-w-none" : "max-w-7xl mx-auto")">

                <!-- 1. Top Header Area Matching Admin / Staff Workspace Standard -->
                <div class="developer-workspace-header staff-overview-no-print flex flex-col gap-2 p-2">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Developer Workspace</h1>
                                <span class="rounded-full bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-0.5 text-xs font-bold">
                                    Developer Portal
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Centralized configuration for request types, state transition rules, approval workflows, and system diagnostics.
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    @onclick="ToggleFullWidthAsync">
                                <span>@(isFullWidth ? "⤢ Shrink View" : "⤡ Full Width")</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    disabled="@loading"
                                    @onclick="RefreshAsync">
                                <span class="@(loading ? "animate-spin" : "")">↻</span>
                                <span>Refresh</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. Solid Folder Navigation Tabs (Matching StaffHubWorkspace with Ember Palette) -->
                <div class="developer-workspace-tabs staff-overview-no-print w-full border-b-2 border-amber-600 dark:border-amber-500 overflow-x-auto">
                    <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Developer Workspace Tabs">
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "overview" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("overview"))">
                            Overview
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "error-logs" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("error-logs"))">
                            <span class="inline-flex items-center gap-1.5">
                                <span>Error Logs</span>
                                <span class="rounded-full bg-rose-500 text-white px-1.5 py-0.2 text-[10px] font-extrabold">ERR</span>
                            </span>
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "request-types" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("request-types"))">
                            Request Types
                            @if (requestTypesCount > 0)
                            {
                                <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "request-types" ? "bg-white/20 text-white" : "bg-amber-200 text-amber-900")">
                                    @requestTypesCount
                                </span>
                            }
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "transitions" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("transitions"))">
                            Transition States
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "notification-resolution" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("notification-resolution"))">
                            Notification Resolution
                            @if (configurationAlerts.Count > 0)
                            {
                                <span class="ml-1 rounded-full bg-rose-500 px-1.5 py-0.5 text-[10px] text-white">@configurationAlerts.Count</span>
                            }
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "workflows" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("workflows"))">
                            Approval Workflows
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "health" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("health"))">
                            Application Health
                        </button>
                        <button type="button" class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "edge-agents" ? "bg-amber-600 text-white border-amber-600" : "bg-[#fef3c7]/60 text-slate-700 hover:bg-[#fde68a]/60 border-slate-300")" @onclick="@(e => SetTab("edge-agents"))">Client Agents</button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "diagnostics" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-700 hover:text-slate-900 hover:bg-[#fde68a]/60 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                @onclick="@(e => SetTab("diagnostics"))">
                            System & Diagnostics
                        </button>
                    </nav>
                </div>

                <!-- 3. Workspace Tab Content Area -->
                <div class="developer-workspace-content w-full min-w-0 pt-2">
                    @if (activeTab == "overview")
                    {
                        @if (loading)
                        {
                            <div class="flex flex-col items-center justify-center p-12 my-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
                                <div class="w-12 h-12 border-4 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
                                <p class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-200">Loading Developer Dashboard...</p>
                                <p class="text-xs text-slate-400 mt-0.5">Fetching request types, transition states, and telemetry</p>
                            </div>
                        }
                        else
                        {
                        <!-- Overview Dashboard -->
                        <div class="space-y-4">
                            <!-- Quick Stat Summary Cards -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-700 text-xl font-bold">
                                        📋
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Request Types</p>
                                        <p class="text-xl font-bold text-slate-900">@requestTypesCount</p>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-50 text-orange-700 text-xl font-bold">
                                        🔄
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Known States</p>
                                        <p class="text-xl font-bold text-slate-900">@statesCount</p>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 text-xl font-bold">
                                        ✓
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Developer Role</p>
                                        <p class="text-base font-bold text-emerald-600">Active (Verified)</p>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-800 text-xl font-bold">
                                        ⚡
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Active Context</p>
                                        <p class="text-base font-bold text-amber-800">Developer (/developer)</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Diagnostic Toggles Card -->
                            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs">
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                    <div class="flex items-start gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 text-xl font-bold border border-amber-200 dark:border-amber-800">
                                            ⏱️
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100">Test Attendance Time Card</h3>
                                                @if (testClockEnabled)
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800">
                                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                                        Enabled
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs font-bold text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700">
                                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                                        Disabled
                                                    </span>
                                                }
                                            </div>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                                                Controls whether the custom attendance test clock card is displayed on the employee portal (<a href="/online" class="font-semibold text-blue-600 dark:text-blue-400 underline">/online</a>). Use to simulate check-in and check-out punches at arbitrary dates and times.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                        <button type="button"
                                                class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-bold shadow-xs transition @(testClockEnabled ? "bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-300 dark:bg-rose-950/40 dark:text-rose-300 dark:border-rose-800" : "bg-emerald-600 hover:bg-emerald-700 text-white")"
                                                @onclick="ToggleTestClockAsync">
                                            <span>@(testClockEnabled ? "Disable Test Card" : "Enable Test Card")</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Fast Navigation Feature Panels -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">📋</span>
                                            <h3 class="font-bold text-sm text-slate-900">Request Type Configuration</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Create and manage system request types, sequence numbering definitions, Dhivehi localized names, and active flags.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("request-types"))">
                                        Manage Request Types →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">🔄</span>
                                            <h3 class="font-bold text-sm text-slate-900">Request State Transitions</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Control allowable From State → To State transitions per request type. Block invalid or out-of-order state updates.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("transitions"))">
                                        Manage Transitions →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">🔀</span>
                                            <h3 class="font-bold text-sm text-slate-900">Approval Workflows</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Assign multi-stage approval levels and user groups by Job Type and Request Type for automated workflow dispatch.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("workflows"))">
                                        Configure Workflows →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">❤️</span>
                                            <h3 class="font-bold text-sm text-slate-900">Application Health</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Live health telemetry for Backend API, Payroll.Worker background service, pages directory, and most visited pages.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("health"))">
                                        View App Health →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">🐞</span>
                                            <h3 class="font-bold text-sm text-slate-900">Application Error Logs</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Pinpoint source line numbers, exception stack traces, context metadata, and prescriptive fix recommendations.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("error-logs"))">
                                        Inspect Error Logs →
                                    </button>
                                </div>
                            </div>
                        </div>
                        }
                    }
                    else if (activeTab == "error-logs")
                    {
                        <ErrorLogsTab />
                    }
                    else if (activeTab == "request-types")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <JobTypeConfiguration RequestTypesMode="true" />
                        </div>
                    }
                    else if (activeTab == "transitions")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <RequestStateTransitionSettings />
                        </div>
                    }
                    else if (activeTab == "notification-resolution")
                    {
                        <section class="flex flex-col gap-2">
                            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white/95 p-2 shadow-xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900/95">
                                <div><h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Notification Resolution</h2><p class="text-xs text-slate-500">Resolve workflow configuration without leaving the Developer Portal.</p></div>
                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="LoadConfigurationAlertsAsync" disabled="@loading"><AppIcon Name="arrow-clockwise" />Refresh notifications</button>
                            </header>
                            <div class="grid min-w-0 grid-cols-1 items-start gap-2 lg:grid-cols-12">
                                <div class="min-w-0 rounded-2xl border border-slate-200 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900 lg:col-span-7">
                                    <div class="border-b border-slate-200 p-2 dark:border-slate-800"><h3 class="font-bold text-slate-900 dark:text-slate-100">Transition configuration</h3><p class="text-xs text-slate-500">Enter Request Type, From State and To State in the order shown in the notification.</p></div>
                                    <RequestStateTransitionSettings Embedded="true"
                                                                    InitialRequestTypeId="@ResolutionRequestTypeId"
                                                                    InitialFromStateId="@ResolutionFromStateId"
                                                                    InitialToStateId="@ResolutionToStateId"
                                                                    InitialRequestTypeName="@ResolutionRequestTypeName"
                                                                    InitialFromStateName="@ResolutionFromStateName"
                                                                    InitialToStateName="@ResolutionToStateName"
                                                                    OnConfigurationChanged="LoadConfigurationAlertsAsync" />
                                </div>
                                <aside class="flex min-w-0 max-h-[75vh] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900 lg:col-span-5" aria-label="Configuration notification details">
                                    <div class="border-b border-slate-200 p-2 dark:border-slate-800"><div class="flex items-center justify-between gap-2"><h3 class="font-bold text-slate-900 dark:text-slate-100">Notification details</h3><span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800">@configurationAlerts.Count recent</span></div><p class="text-xs text-slate-500">Newest notification appears first.</p></div>
                                    <div class="mt-2 flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto overscroll-contain pr-1">
                                    @if (configurationAlerts.Count == 0)
                                    {
                                        <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-xs text-slate-500">No recent configuration-resolution notifications.</div>
                                    }
                                    else
                                    {
                                        @foreach (var alert in configurationAlerts)
                                        {
                                            <article class="flex flex-col gap-2 rounded-xl border border-amber-200 bg-amber-50/50 p-3 text-xs dark:border-amber-900 dark:bg-amber-950/20">
                                                <div class="flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><strong class="text-amber-900 dark:text-amber-200">@alert.Item.Reference</strong>@if (alert.Resolved){<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800">Resolved</span>}</div><time class="text-[11px] text-slate-500">@alert.Item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</time></div>
                                                <p class="whitespace-pre-wrap text-slate-700 dark:text-slate-300">@alert.Item.Message</p>
                                                @if (alert.Resolved)
                                                {
                                                    <button type="button" class="app-button app-button-secondary app-button-sm self-start" disabled><AppIcon Name="check-circle" />Configuration already exists</button>
