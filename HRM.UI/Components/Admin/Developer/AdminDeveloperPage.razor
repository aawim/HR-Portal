@page "/developer"
@page "/developer/{ActiveTab}"
@page "/admin/developer"
@page "/admin/developer/{ActiveTab}"
@using HRM.Components.Admin.Settings
@using HRM.Components.Admin.Settings.JobTypes
@using HRM.Services.Interfaces
@using HRM.Services
@using HRM.Enum
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject IUserAccessService UserAccess
@inject PortalContext PortalContext
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject HRM.Services.Contracts.RequestTransitionSettingsServiceContracts.IOperations TransitionService

<PageTitle>Developer Workspace - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (checking)
        {
            <div class="mx-auto max-w-7xl p-4">
                <div class="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600 shadow-xs">
                    Verifying developer access...
                </div>
            </div>
        }
        else if (!isDeveloper)
        {
            <div class="mx-auto max-w-7xl p-4">
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900 shadow-sm space-y-2">
                    <h2 class="font-bold text-base">Developer Access Required</h2>
                    <p>Your account does not currently hold Developer permissions or group membership.</p>
                    <a href="/online" class="inline-block font-semibold text-blue-700 underline mt-2">Return to Employee Portal</a>
                </div>
            </div>
        }
        else
        {
            <section class="developer-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-all duration-300 @(isFullWidth ? "max-w-none" : "max-w-7xl mx-auto")">

                <!-- 1. Top Header Area Matching Admin / Staff Workspace Standard -->
                <div class="developer-workspace-header staff-overview-no-print flex flex-col gap-2 p-2">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Developer Workspace</h1>
                                <span class="rounded-full bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-0.5 text-xs font-bold">
                                    Developer Portal
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Centralized configuration for request types, state transition rules, approval workflows, and system diagnostics.
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    @onclick="ToggleFullWidthAsync">
                                <span>@(isFullWidth ? "⤢ Shrink View" : "⤡ Full Width")</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                    disabled="@loading"
                                    @onclick="RefreshAsync">
                                <span class="@(loading ? "animate-spin" : "")">↻</span>
                                <span>Refresh</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. Solid Folder Navigation Tabs (Matching StaffHubWorkspace with Ember Palette) -->
                <div class="developer-workspace-tabs staff-overview-no-print w-full border-b-2 border-amber-600 dark:border-amber-500 overflow-x-auto">
                    <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Developer Workspace Tabs">
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "overview" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#fde68a]/60")"
                                @onclick="@(e => SetTab("overview"))">
                            Overview
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "request-types" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#fde68a]/60")"
                                @onclick="@(e => SetTab("request-types"))">
                            Request Types
                            @if (requestTypesCount > 0)
                            {
                                <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "request-types" ? "bg-white/20 text-white" : "bg-amber-200 text-amber-900")">
                                    @requestTypesCount
                                </span>
                            }
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "transitions" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#fde68a]/60")"
                                @onclick="@(e => SetTab("transitions"))">
                            Transition States
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "workflows" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#fde68a]/60")"
                                @onclick="@(e => SetTab("workflows"))">
                            Approval Workflows
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "health" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#fde68a]/60")"
                                @onclick="@(e => SetTab("health"))">
                            Application Health
                        </button>
                        <button type="button"
                                class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "diagnostics" ? "bg-amber-600 dark:bg-amber-600 text-white border-amber-600 dark:border-amber-500 shadow-sm" : "bg-[#fef3c7]/60 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700 hover:bg-[#fde68a]/60")"
                                @onclick="@(e => SetTab("diagnostics"))">
                            System & Diagnostics
                        </button>
                    </nav>
                </div>

                <!-- 3. Workspace Tab Content Area -->
                <div class="developer-workspace-content w-full min-w-0 pt-2">
                    @if (activeTab == "overview")
                    {
                        <!-- Overview Dashboard -->
                        <div class="space-y-4">
                            <!-- Quick Stat Summary Cards -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-700 text-xl font-bold">
                                        📋
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Request Types</p>
                                        <p class="text-xl font-bold text-slate-900">@requestTypesCount</p>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-50 text-orange-700 text-xl font-bold">
                                        🔄
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Known States</p>
                                        <p class="text-xl font-bold text-slate-900">@statesCount</p>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 text-xl font-bold">
                                        ✓
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Developer Role</p>
                                        <p class="text-base font-bold text-emerald-600">Active (Verified)</p>
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex items-center gap-3">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-800 text-xl font-bold">
                                        ⚡
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500">Active Context</p>
                                        <p class="text-base font-bold text-amber-800">Developer (/developer)</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Fast Navigation Feature Panels -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">📋</span>
                                            <h3 class="font-bold text-sm text-slate-900">Request Type Configuration</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Create and manage system request types, sequence numbering definitions, Dhivehi localized names, and active flags.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("request-types"))">
                                        Manage Request Types →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">🔄</span>
                                            <h3 class="font-bold text-sm text-slate-900">Request State Transitions</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Control allowable From State → To State transitions per request type. Block invalid or out-of-order state updates.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("transitions"))">
                                        Manage Transitions →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">🔀</span>
                                            <h3 class="font-bold text-sm text-slate-900">Approval Workflows</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Assign multi-stage approval levels and user groups by Job Type and Request Type for automated workflow dispatch.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("workflows"))">
                                        Configure Workflows →
                                    </button>
                                </div>

                                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs flex flex-col justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-lg">❤️</span>
                                            <h3 class="font-bold text-sm text-slate-900">Application Health</h3>
                                        </div>
                                        <p class="text-xs text-slate-500">
                                            Live health telemetry for Backend API, Payroll.Worker background service, pages directory, and most visited pages.
                                        </p>
                                    </div>
                                    <button type="button" class="w-full rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 text-xs font-semibold transition"
                                            @onclick="@(e => SetTab("health"))">
                                        View App Health →
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (activeTab == "request-types")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <JobTypeConfiguration RequestTypesMode="true" />
                        </div>
                    }
                    else if (activeTab == "transitions")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <RequestStateTransitionSettings />
                        </div>
                    }
                    else if (activeTab == "workflows")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <LeaveFlowSettings />
                        </div>
                    }
                    else if (activeTab == "health")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <ApplicationHealthTab />
                        </div>
                    }
                    else if (activeTab == "diagnostics")
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                                <h3 class="font-bold text-sm text-slate-900 border-b border-slate-100 pb-2">Developer Environment</h3>
                                <dl class="divide-y divide-slate-100 text-xs">
                                    <div class="py-2 flex justify-between">
                                        <dt class="text-slate-500">Framework</dt>
                                        <dd class="font-semibold text-slate-800">.NET 9 / ASP.NET Core Blazor</dd>
                                    </div>
                                    <div class="py-2 flex justify-between">
                                        <dt class="text-slate-500">Rendering Mode</dt>
                                        <dd class="font-semibold text-slate-800">InteractiveServer</dd>
                                    </div>
                                    <div class="py-2 flex justify-between">
                                        <dt class="text-slate-500">Portal Context</dt>
                                        <dd class="font-semibold text-amber-800 font-mono">@PortalContext.CurrentContext.ToString()</dd>
                                    </div>
                                    <div class="py-2 flex justify-between">
                                        <dt class="text-slate-500">Developer Role</dt>
                                        <dd class="font-semibold text-emerald-600">Active (Verified)</dd>
                                    </div>
                                    <div class="py-2 flex justify-between">
                                        <dt class="text-slate-500">Current URL</dt>
                                        <dd class="font-semibold text-slate-800 font-mono text-[11px] truncate max-w-[20rem]">@Navigation.Uri</dd>
                                    </div>
                                </dl>
                            </div>

                            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                                <h3 class="font-bold text-sm text-slate-900 border-b border-slate-100 pb-2">Quick Navigation</h3>
                                <ul class="space-y-2 text-xs">
                                    <li>
                                        <a href="/online" class="text-blue-600 hover:text-blue-800 font-medium underline flex items-center gap-1.5">
                                            <span>👤 Employee Self Portal</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/admin/settings/config" class="text-blue-600 hover:text-blue-800 font-medium underline flex items-center gap-1.5">
                                            <span>⚙️ Admin Configuration Settings</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/admin/my/workspace" class="text-blue-600 hover:text-blue-800 font-medium underline flex items-center gap-1.5">
                                            <span>🏢 Staff & Team Workspace</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public string? ActiveTab { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private bool checking = true;
    private bool isDeveloper;
    private bool loading;
    private bool isFullWidth;
    private string activeTab = "overview";
    private int requestTypesCount;
    private int statesCount;

    protected override async Task OnInitializedAsync()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        if (path.StartsWith("/admin/developer", StringComparison.OrdinalIgnoreCase))
        {
            var target = "/developer" + path.Substring("/admin/developer".Length);
            Navigation.NavigateTo(target, replace: true);
            return;
        }
        try
        {
            isDeveloper = await UserAccess.HasUserGroupAsync("Developer") || await UserAccess.HasPermissionAsync("Developer");
            if (isDeveloper)
            {
                await LoadOverviewStatsAsync();
            }
        }
        catch
        {
            isDeveloper = false;
        }
        finally
        {
            checking = false;
        }
    }

    protected override void OnParametersSet()
    {
        var selected = !string.IsNullOrWhiteSpace(ActiveTab) ? ActiveTab : TabQuery;
        if (!string.IsNullOrWhiteSpace(selected))
        {
            var normalized = selected.ToLowerInvariant();
            if (normalized is "overview" or "request-types" or "transitions" or "workflows" or "health" or "diagnostics")
            {
                activeTab = normalized;
            }
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var baseUri = uri.AbsolutePath.TrimEnd('/');
        if (baseUri.Contains("/developer/"))
        {
            var root = baseUri.Substring(0, baseUri.LastIndexOf('/'));
            Navigation.NavigateTo($"{root}/{tab}", replace: true);
        }
        else
        {
            Navigation.NavigateTo($"/developer/{tab}", replace: true);
        }
    }

    private async Task LoadOverviewStatsAsync()
    {
        try
        {
            var data = await TransitionService.LoadAsync();
            requestTypesCount = data.RequestTypes.Count;
            statesCount = data.States.Count;
        }
        catch
        {
            // Non-critical stat loading
        }
    }

    private void ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try
        {
            await LoadOverviewStatsAsync();
            StateHasChanged();
        }
        finally
        {
            loading = false;
        }
    }
}
