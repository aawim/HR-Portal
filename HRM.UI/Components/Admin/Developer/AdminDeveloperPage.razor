                                                {
                                                    <a class="app-button app-button-primary app-button-sm self-start" href="@alert.Url"><AppIcon Name="arrow-left-right" />Populate configuration form</a>
                                                }
                                            </article>
                                        }
                                    }
                                    </div>
                                </aside>
                            </div>
                        </section>
                    }
                    else if (activeTab == "workflows")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <LeaveFlowSettings />
                        </div>
                    }
                    else if (activeTab == "health")
                    {
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                            <ApplicationHealthTab />
                        </div>
                    }
                    else if (activeTab == "edge-agents")
                    {
                        <HRM.Components.Admin.Settings.EdgeAgentManagementPage />
                    }
                    else if (activeTab == "diagnostics")
                    {
                        <div class="space-y-4">
                            <!-- Diagnostic Feature Toggles -->
                            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs">
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                    <div class="flex items-start gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 text-xl font-bold border border-amber-200 dark:border-amber-800">
                                            ⏱️
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100">Test Attendance Time Card</h3>
                                                @if (testClockEnabled)
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800">
                                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                                        Enabled
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs font-bold text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700">
                                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                                        Disabled
                                                    </span>
                                                }
                                            </div>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                                                Controls whether the custom attendance test clock card is displayed on the employee portal (<a href="/online" class="font-semibold text-blue-600 dark:text-blue-400 underline">/online</a>). Use to simulate check-in and check-out punches at arbitrary dates and times.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                        <button type="button"
                                                class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-bold shadow-xs transition @(testClockEnabled ? "bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-300 dark:bg-rose-950/40 dark:text-rose-300 dark:border-rose-800" : "bg-emerald-600 hover:bg-emerald-700 text-white")"
                                                @onclick="ToggleTestClockAsync">
                                            <span>@(testClockEnabled ? "Disable Test Card" : "Enable Test Card")</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                                <h3 class="font-bold text-sm text-slate-900 border-b border-slate-100 pb-2">Developer Environment</h3>
                                <dl class="divide-y divide-slate-100 text-xs">
                                    <div class="py-2 flex justify-between">
                                        <dt class="text-slate-500">Framework</dt>
                                        <dd class="font-semibold text-slate-800">.NET 9 / ASP.NET Core Blazor</dd>
