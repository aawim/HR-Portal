                                </ul>
                            </div>
                        </div>
                        </div>
                    }
                </div>
            </section>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public string? ActiveTab { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = "jobTypeId")] public int? ResolutionJobTypeId { get; set; }
    [SupplyParameterFromQuery(Name = "requestTypeId")] public int? ResolutionRequestTypeId { get; set; }
    [SupplyParameterFromQuery(Name = "fromStateId")] public int? ResolutionFromStateId { get; set; }
    [SupplyParameterFromQuery(Name = "toStateId")] public int? ResolutionToStateId { get; set; }
    [SupplyParameterFromQuery(Name = "requestTypeName")] public string? ResolutionRequestTypeName { get; set; }
    [SupplyParameterFromQuery(Name = "fromStateName")] public string? ResolutionFromStateName { get; set; }
    [SupplyParameterFromQuery(Name = "toStateName")] public string? ResolutionToStateName { get; set; }

    private bool checking = true;
    private bool isDeveloper;
    private bool loading;
    private bool isFullWidth;
    private bool testClockEnabled = true;
    private string activeTab = "overview";
    private int requestTypesCount;
    private int statesCount;
    private sealed record ResolutionTarget(int RequestTypeId, int FromStateId, int ToStateId);
    private sealed record ConfigurationAlertView(RequestNotificationItem Item, string Url, bool Resolved);
    private List<ConfigurationAlertView> configurationAlerts = [];
    private static string DeveloperResolutionUrl(RequestNotificationItem alert)
    {
        if (alert.Url.StartsWith("/developer/", StringComparison.OrdinalIgnoreCase) &&
            alert.Url.Contains("requestTypeId=", StringComparison.OrdinalIgnoreCase)) return alert.Url;
        var text = alert.Message ?? string.Empty;
        var ids = System.Text.RegularExpressions.Regex.Match(text,
            @"Request Type\s*=.*?\(ID\s+(\d+)\).*?From State\s*=.*?\(ID\s+(\d+)\).*?To State\s*=.*?\(ID\s+(\d+)\)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (ids.Success)
            return $"/developer/notification-resolution?requestTypeId={ids.Groups[1].Value}&fromStateId={ids.Groups[2].Value}&toStateId={ids.Groups[3].Value}";
        var request = System.Text.RegularExpressions.Regex.Match(text,
            @"Request Type:\s*(.*?)\.\s*(?:Transition not allowed|Missing transition)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var states = System.Text.RegularExpressions.Regex.Match(text,
            @"Transition not allowed for .*?:\s*(.*?)\s*→\s*(.*?)\.\s*Configure",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (request.Success && states.Success)
            return "/developer/notification-resolution?requestTypeName=" + Uri.EscapeDataString(request.Groups[1].Value.Trim()) +
                "&fromStateName=" + Uri.EscapeDataString(states.Groups[1].Value.Trim()) +
                "&toStateName=" + Uri.EscapeDataString(states.Groups[2].Value.Trim());
        return "/developer/notification-resolution";
    }

    private static ResolutionTarget? ResolutionTargetFor(RequestNotificationItem alert, RequestTransitionSettingsDto settings)
    {
        var text = alert.Message ?? string.Empty;
        var ids = System.Text.RegularExpressions.Regex.Match(text,
            @"Request Type\s*=.*?\(ID\s+(\d+)\).*?From State\s*=.*?\(ID\s+(\d+)\).*?To State\s*=.*?\(ID\s+(\d+)\)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (ids.Success && int.TryParse(ids.Groups[1].Value, out var requestId) && int.TryParse(ids.Groups[2].Value, out var fromId) && int.TryParse(ids.Groups[3].Value, out var toId))
            return new(requestId, fromId, toId);
        var request = System.Text.RegularExpressions.Regex.Match(text, @"Request Type:\s*(.*?)\.\s*(?:Transition not allowed|Missing transition)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var states = System.Text.RegularExpressions.Regex.Match(text, @"Transition not allowed for .*?:\s*(.*?)\s*→\s*(.*?)\.\s*Configure", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!request.Success || !states.Success) return null;
        var requestOption = settings.RequestTypes.FirstOrDefault(x => x.Name.Trim().Equals(request.Groups[1].Value.Trim(), StringComparison.OrdinalIgnoreCase));
        var fromOption = settings.States.FirstOrDefault(x => x.Name.Trim().Equals(states.Groups[1].Value.Trim(), StringComparison.OrdinalIgnoreCase));
        var toOption = settings.States.FirstOrDefault(x => x.Name.Trim().Equals(states.Groups[2].Value.Trim(), StringComparison.OrdinalIgnoreCase));
        return requestOption is null || fromOption is null || toOption is null ? null : new(requestOption.Id, fromOption.Id, toOption.Id);
    }

    protected override async Task OnInitializedAsync()
    {
        TestClockPreference.OnChange += TestClockPreferenceChanged;
        testClockEnabled = TestClockPreference.CurrentState;
        var path = new Uri(Navigation.Uri).AbsolutePath;
        if (path.StartsWith("/admin/developer", StringComparison.OrdinalIgnoreCase))
        {
            var target = "/developer" + path.Substring("/admin/developer".Length);
            Navigation.NavigateTo(target, replace: true);
            return;
        }
        try
        {
            isDeveloper = await UserAccess.HasUserGroupAsync("Developer") || await UserAccess.HasPermissionAsync("Developer");
            if (isDeveloper)
            {
                await LoadOverviewStatsAsync();
                await LoadConfigurationAlertsAsync();
            }
        }
        catch
        {
            isDeveloper = false;
        }
        finally
        {
            checking = false;
        }
    }

    protected override void OnParametersSet()
    {
        var selected = !string.IsNullOrWhiteSpace(ActiveTab) ? ActiveTab : TabQuery;
        if (!string.IsNullOrWhiteSpace(selected))
        {
            var normalized = selected.ToLowerInvariant();
            if (normalized is "overview" or "error-logs" or "errors" or "request-types" or "transitions" or "notification-resolution" or "workflows" or "health" or "edge-agents" or "diagnostics")
            {
                activeTab = normalized == "errors" ? "error-logs" : normalized;
            }
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var baseUri = uri.AbsolutePath.TrimEnd('/');
        if (baseUri.Contains("/developer/"))
        {
            var root = baseUri.Substring(0, baseUri.LastIndexOf('/'));
            Navigation.NavigateTo($"{root}/{tab}", replace: true);
        }
        else
        {
            Navigation.NavigateTo($"/developer/{tab}", replace: true);
        }
    }

    private async Task LoadOverviewStatsAsync()
    {
        try
        {
            var data = await TransitionService.LoadAsync();
            requestTypesCount = data.RequestTypes.Count;
            statesCount = data.States.Count;
        }
        catch
        {
            // Non-critical stat loading
        }
    }

    private async Task LoadConfigurationAlertsAsync()
    {
        try
        {
            var inbox = await NotificationService.GetInboxAsync();
            var settings = await TransitionService.LoadAsync();
            var items = inbox.Items
                .Where(x => x.Id < 0 && x.Reference.Contains("needs attention", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => x.CreatedAtUtc)
                .ToList();
            var transitionCache = new Dictionary<int, List<AllowedRequestTransitionDto>>();
            configurationAlerts = [];
            foreach (var item in items)
            {
                var target = ResolutionTargetFor(item, settings);
                var resolved = false;
                if (target is not null)
                {
                    if (!transitionCache.TryGetValue(target.RequestTypeId, out var transitions))
                    {
                        transitions = await TransitionService.GetAsync(target.RequestTypeId);
                        transitionCache[target.RequestTypeId] = transitions;
                    }
                    resolved = transitions.Any(x => x.FromStateId == target.FromStateId && x.ToStateId == target.ToStateId);
                }
                configurationAlerts.Add(new(item, DeveloperResolutionUrl(item), resolved));
            }
        }
        catch
        {
            configurationAlerts = [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedFullWidth = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.developer.full-width");
                if (bool.TryParse(savedFullWidth, out var val))
                {
                    isFullWidth = val;
                }
                await TestClockPreference.InitializeAsync();
                testClockEnabled = TestClockPreference.CurrentState;
                StateHasChanged();
            }
            catch
            {
                // Browser JS unavailable or test environment
            }
        }
    }

    private async Task ToggleTestClockAsync()
    {
        testClockEnabled = !testClockEnabled;
        await TestClockPreference.SetEnabledAsync(testClockEnabled);
        if (testClockEnabled)
        {
            ToastService.Success("Test Time Clock card enabled on Employee Portal.");
        }
        else
        {
            ToastService.Info("Test Time Clock card disabled on Employee Portal.");
        }
        StateHasChanged();
    }

    private void TestClockPreferenceChanged()
    {
        _ = InvokeAsync(() =>
        {
            testClockEnabled = TestClockPreference.CurrentState;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TestClockPreference.OnChange -= TestClockPreferenceChanged;
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "hrm.developer.full-width", isFullWidth ? "true" : "false");
        }
        catch { }
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try
        {
            await LoadOverviewStatsAsync();
            await LoadConfigurationAlertsAsync();
            StateHasChanged();
        }
        finally
        {
            loading = false;
        }
    }
}
