@using HRM.DTOs.Roles
@using HRM.Services
@inject HRM.Services.Contracts.PermissionSettingsServiceContracts.IOperations Settings
@inject ToastService Toast

<section class="staff-access-control w-full min-w-0 p-2 flex flex-col gap-2">
    <header class="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white/95 p-2 shadow-xs backdrop-blur-xs">
        <div>
            <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-xs font-bold text-slate-900">Organisational Data Isolation &amp; Access Control</h2>
                @if (!string.IsNullOrWhiteSpace(data?.OrganisationName))
                {
                    <span class="rounded-full bg-teal-50 border border-teal-200 px-2 py-0.5 text-[10px] font-semibold text-teal-700">@data.OrganisationName</span>
                }
            </div>
            <p class="mt-0.5 text-[11px] text-slate-500">Combine RBAC permissions, hierarchical division/department/team access scopes, ABAC classification policies, and server-calculated effective access previews.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (data?.IsSuperAdmin == true && data.Organisations.Count > 0)
            {
                <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-700">
                    <span>Organisation</span>
                    <select class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            value="@selectedOrganisationId"
                            disabled="@(loading || busy)"
                            @onchange="ChangeOrganisationAsync">
                        @foreach (var org in data.Organisations)
                        {
                            <option value="@org.Id">@org.Name</option>
                        }
                    </select>
                </label>
            }
            <button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50" @onclick="Load">↻ Refresh</button>
        </div>
    </header>

    @if (error != null)
    {
        <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-2 text-xs text-rose-800">@error</div>
    }

    @if (loading)
    {
        <p class="rounded-2xl border border-slate-200 bg-white p-2 text-xs text-slate-500">Loading organisational access scopes and policies…</p>
    }
    else if (data != null)
    {
        <div class="grid w-full grid-cols-1 gap-2 lg:grid-cols-12">
            <div class="min-w-0 flex flex-col gap-2 lg:col-span-7">
                <!-- 1. Hierarchical Organisational Access Scope Assignment -->
                <section class="rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex flex-col gap-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h3 class="font-bold text-slate-800 p-1">Hierarchical Organisational Access Scopes</h3>
                            <p class="px-1 text-xs text-slate-500">Assign division, department, team, or organisation-wide scopes to users or roles. Multiple scopes can be combined (e.g. Northern + Southern Division).</p>
                        </div>
                        @if (orgScope.Id > 0)
                        {
                            <button type="button" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs text-slate-600 hover:bg-slate-50" @onclick="ResetOrgScope">New scope</button>
                        }
                    </div>

                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
                        <label class="text-xs font-medium text-slate-700 p-1">Subject type
                            <select class="@Input" @bind="orgScope.SubjectType">
                                <option value="User">User</option>
                                <option value="Role">Role (User Group)</option>
                            </select>
                        </label>
                        <label class="text-xs font-medium text-slate-700 p-1 sm:col-span-2">Subject
                            <select class="@Input" @bind="orgScope.SubjectId">
                                <option value="0">Select @(orgScope.SubjectType == "Role" ? "role" : "user")</option>
                                @foreach (var x in SubjectOptions(orgScope.SubjectType))
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                        <label class="text-xs font-medium text-slate-700 p-1">Scope type
                            <select class="@Input" @bind="orgScope.ScopeType">
                                <option value="Self">Self — Only the employee's own records</option>
                                <option value="Team">Team — Assigned team members</option>
                                <option value="Department">Department — One department</option>
                                <option value="Division">Division — One division</option>
                                <option value="DivisionAndDescendants">Division and descendants — Division plus subordinate units</option>
                                <option value="Organisation">Organisation — Entire organisation</option>
                                <option value="Custom">Custom — Specific approved organisational unit</option>
                            </select>
                        </label>

                        @if (orgScope.ScopeType is "Division" or "DivisionAndDescendants" or "Department" or "Custom")
                        {
                            <label class="text-xs font-medium text-slate-700 p-1">Organisational unit (Division / Department)
                                <select class="@Input" @bind="orgScope.UnitId">
                                    <option value="">Select unit</option>
                                    @foreach (var u in data.Units)
                                    {
                                        <option value="@u.Id">@u.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        else if (orgScope.ScopeType == "Team")
                        {
                            <label class="text-xs font-medium text-slate-700 p-1">Specific team (or leave blank for supervised teams)
                                <select class="@Input" @bind="orgScope.TeamId">
                                    <option value="">All supervised / assigned teams</option>
                                    @foreach (var t in data.Teams)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        else
                        {
                            <label class="text-xs font-medium text-slate-700 p-1">Optional module / permission filter
                                <input class="@Input" maxlength="200" placeholder="All held permissions (*)" @bind="orgScope.PermissionFilter" />
                            </label>
                        }
                    </div>

                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
                        <label class="text-xs font-medium text-slate-700 p-1">Valid from
                            <input type="date" class="@Input" @bind="orgScope.ValidFrom" />
                        </label>
                        <label class="text-xs font-medium text-slate-700 p-1">Valid to (optional temporary grant)
                            <input type="date" class="@Input" @bind="orgScope.ValidTo" />
                        </label>
                        <label class="text-xs font-medium text-slate-700 p-1">Permission filter (optional)
                            <input class="@Input" maxlength="200" placeholder="e.g. Employee or Attendance" @bind="orgScope.PermissionFilter" />
                        </label>
                    </div>

                    <div class="flex flex-wrap items-center gap-4 px-1">
                        <label class="flex items-center gap-2 text-xs text-slate-700">
                            <input type="checkbox" @bind="orgScope.IncludeDescendants" /> Include subordinate / child units
                        </label>
                        <label class="flex items-center gap-2 text-xs text-slate-700">
                            <input type="checkbox" @bind="orgScope.IsActive" /> Active scope grant
                        </label>
                    </div>

                    <label class="block text-xs font-medium text-slate-700 p-1">Authorisation reason
                        <textarea class="@Input" maxlength="1000" placeholder="Document why this division, department, or organisation scope is granted…" @bind="orgScope.Reason"></textarea>
                    </label>

                    <div class="flex flex-wrap items-center gap-2">
                        <button disabled="@busy" class="@Primary" @onclick="SaveOrgScope">
                            @(orgScope.Id > 0 ? "Update organisational scope" : "Grant organisational scope")
                        </button>
                        @if (orgScope.Id > 0 && orgScope.IsActive)
                        {
                            <button disabled="@busy" type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-300 bg-rose-50 px-3.5 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100 disabled:opacity-50" @onclick="() => RevokeOrgScope(orgScope.Id)">
                                Revoke scope
                            </button>
                        }
                    </div>
                </section>

                <!-- 2. Effective Access Preview / Access Scope Simulation -->
                <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h3 class="font-bold text-slate-800 p-1">Effective Access Preview (Access Scope Simulation)</h3>
                            <p class="px-1 text-xs text-slate-500">Server-calculated effective organisational scopes, division isolation boundaries, and field-level permissions for a selected user.</p>
                        </div>
                        <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Server-Calculated</span>
                    </div>

                    <div class="flex flex-wrap items-end gap-2 p-1">
                        <label class="min-w-60 flex-1 text-xs font-medium text-slate-700">Preview user account
                            <select class="@Input" @bind="simulatedUserId">
                                <option value="0">Select user to simulate effective access…</option>
                                @foreach (var u in data.Users)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                        </label>
                        <button disabled="@(busy || simulatedUserId <= 0)" type="button" class="@Primary" @onclick="RunSimulation">
                            Simulate Effective Access
                        </button>
                    </div>

                    @if (simulation != null)
                    {
                        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 space-y-3">
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-2.5">
                                <div>
                                    <p class="text-sm font-bold text-slate-900">@simulation.UserName</p>
                                    <p class="text-xs text-slate-500">@simulation.JobTitle · Home unit: @simulation.HomeUnitName</p>
                                </div>
                                <div class="text-right">
                                    <span class="block text-xs text-slate-500">Organisation scope</span>
                                    <span class="inline-block rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">@simulation.EffectiveScopeSummary</span>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                                <div class="rounded-lg border border-slate-200 bg-white p-2.5">
                                    <span class="block text-[11px] text-slate-500">Visible Employees</span>
                                    <strong class="text-sm text-slate-900">@simulation.TotalVisibleStaff / @simulation.TotalOrganisationStaff</strong>
                                </div>
                                <div class="rounded-lg border border-slate-200 bg-white p-2.5">
                                    <span class="block text-[11px] text-slate-500">Accessible Units</span>
                                    <strong class="text-sm text-slate-900">@simulation.UnitAccessMatrix.Count(u => u.IsAllowed) / @simulation.UnitAccessMatrix.Count</strong>
                                </div>
                                <div class="rounded-lg border border-slate-200 bg-white p-2.5">
                                    <span class="block text-[11px] text-slate-500">Effective RBAC Permissions</span>
                                    <strong class="text-sm text-slate-900">@simulation.EffectivePermissions.Count</strong>
                                </div>
                            </div>

                            <!-- Division / Unit Isolation Matrix -->
                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                                <div class="border-b border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700">
                                    Division &amp; Department Isolation Matrix
                                </div>
                                <div class="max-h-64 divide-y divide-slate-100 overflow-y-auto">
                                    @foreach (var unit in simulation.UnitAccessMatrix)
                                    {
                                        <div class="flex items-center justify-between gap-2 px-3 py-2 text-xs">
                                            <div class="min-w-0">
                                                <span class="font-semibold text-slate-800">@unit.UnitName</span>
                                                <span class="ml-1.5 text-slate-400">(@unit.UnitType)</span>
                                                <span class="block text-[11px] text-slate-500">@unit.AccessSummary · @unit.VisibleStaffCount/@unit.TotalStaffCount staff</span>
                                            </div>
                                            <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold @(unit.IsAllowed ? (unit.AccessLevel == "Full" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800") : "bg-rose-100 text-rose-800")">
                                                @(unit.IsAllowed ? (unit.AccessLevel == "Full" ? "Allowed" : unit.AccessLevel) : "Restricted")
                                            </span>
                                        </div>
                                    }
                                    @if (simulation.UnitAccessMatrix.Count == 0)
                                    {
                                        <p class="p-3 text-xs text-slate-500">No approved organisational units configured.</p>
                                    }
                                </div>
                            </div>

                            <!-- Data Classification & Field Permissions Matrix -->
                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                                <div class="border-b border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700">
                                    Data Classification &amp; Field-Level Permissions
                                </div>
                                <div class="divide-y divide-slate-100">
                                    @foreach (var field in simulation.FieldAccessMatrix)
                                    {
                                        <div class="flex items-center justify-between gap-2 px-3 py-2 text-xs">
                                            <div>
                                                <span class="font-medium text-slate-800">@field.FieldCategory</span>
                                                <span class="ml-1.5 font-mono text-[11px] text-slate-400">@field.PermissionCode</span>
                                            </div>
                                            <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold @(field.IsAllowed ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")">
                                                @field.StatusLabel
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </section>

                <!-- 3. Existing ABAC Staff Classification & Explicit Grant Controls -->
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                        <div><h3 class="font-bold text-slate-800 p-1">Restricted classifications</h3><p class="px-1 text-xs text-slate-500">Mark classifications such as Political as restricted. Access is denied unless an explicit allow exists.</p></div>
                        <label class="block text-xs font-medium text-slate-700 p-1">Position classification<select class="@Input" @bind="policy.PositionClassificationId"><option value="0">Select classification</option>@foreach (var x in data.Classifications) { <option value="@x.Id">@x.Name</option> }</select></label>
                        <label class="flex items-center gap-2 text-xs"><input type="checkbox" @bind="policy.IsRestricted" /> Restricted</label>
                        <label class="block text-xs font-medium text-slate-700 p-1">Description<textarea class="@Input" maxlength="1000" @bind="policy.Description"></textarea></label>
                        <button disabled="@busy" class="@Primary" @onclick="SavePolicy">Save classification policy</button>
                    </section>

                    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                        <div><h3 class="font-bold text-slate-800 p-1">Explicit-only subjects</h3><p class="px-1 text-xs text-slate-500">Use this when a user or role should see only specifically granted staff or classifications.</p></div>
                        <div class="grid grid-cols-2 gap-2"><label class="text-xs p-1">Subject type<select class="@Input" @bind="scope.SubjectType"><option>User</option><option>Role</option></select></label><label class="text-xs p-1">Subject<select class="@Input" @bind="scope.SubjectId"><option value="0">Select</option>@foreach (var x in SubjectOptions(scope.SubjectType)) { <option value="@x.Id">@x.Name</option> }</select></label></div>
                        <label class="flex items-center gap-2 text-xs"><input type="checkbox" @bind="scope.RequireExplicitGrant" /> Require an explicit grant for every staff record</label>
                        <button disabled="@busy" class="@Primary" @onclick="SaveScope">Save access scope</button>
                    </section>
                </div>

                <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                    <div><h3 class="font-bold text-slate-800 p-1">Allow or deny grant</h3><p class="px-1 text-xs text-slate-500">Deny always wins. Grants may target a classification or one staff member.</p></div>
                    <div class="grid grid-cols-2 gap-2"><label class="text-xs p-1">Subject type<select class="@Input" @bind="grant.SubjectType"><option>User</option><option>Role</option></select></label><label class="text-xs p-1">Subject<select class="@Input" @bind="grant.SubjectId"><option value="0">Select</option>@foreach (var x in SubjectOptions(grant.SubjectType)) { <option value="@x.Id">@x.Name</option> }</select></label></div>
                    <div class="grid grid-cols-2 gap-2"><label class="text-xs p-1">Resource type<select class="@Input" @bind="grant.ResourceType"><option>Classification</option><option>Staff</option></select></label><label class="text-xs p-1">Resource<select class="@Input" @bind="grant.ResourceId"><option value="0">Select</option>@foreach (var x in ResourceOptions(grant.ResourceType)) { <option value="@x.Id">@x.Name</option> }</select></label></div>
                    <label class="flex items-center gap-2 text-xs"><input type="checkbox" @bind="grant.IsAllowed" /> Allow (clear for explicit deny)</label>
                    <label class="block text-xs font-medium text-slate-700 p-1">Reason<textarea class="@Input" maxlength="1000" @bind="grant.Reason"></textarea></label>
                    <button disabled="@busy" class="@Primary" @onclick="SaveGrant">Save access grant</button>
                </section>
            </div>

            <aside class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-4 lg:col-span-5">
                <div>
                    <h3 class="font-bold text-slate-800 p-1">Current Scopes, Rules &amp; Audit Trail</h3>
                    <p class="px-1 text-xs text-slate-500">Select any entry below to inspect or modify it.</p>
                </div>

                <RuleTable Title="Organisational access scopes (UserAccessScopes)" Empty="No hierarchical unit scopes configured yet.">
                    @foreach (var x in data.OrganisationalScopes)
                    {
                        <button type="button" class="block w-full border-b border-slate-100 p-2.5 text-left text-xs hover:bg-slate-50" @onclick="() => orgScope = CopyOrgScope(x)">
                            <div class="flex items-center justify-between gap-2">
                                <strong>@x.SubjectName <span class="font-normal text-slate-400">(@x.SubjectType)</span></strong>
                                <span class="rounded-full px-2 py-0.5 @(x.IsActive ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-600")">
                                    @(x.IsActive ? x.ScopeType : "Revoked")
                                </span>
                            </div>
                            <span class="block mt-1 text-slate-700">
                                @if (!string.IsNullOrWhiteSpace(x.UnitName))
                                {
                                    @($"{x.UnitName} {(x.IncludeDescendants ? "(+ child units)" : "(exact unit)")}")
                                }
                                else if (!string.IsNullOrWhiteSpace(x.TeamName))
                                {
                                    @($"Team: {x.TeamName}")
                                }
                                else
                                {
                                    @x.ScopeType
                                }
                            </span>
                            <span class="block mt-0.5 text-[11px] text-slate-500">
                                Valid: @x.ValidFrom.ToString("yyyy-MM-dd")@(x.ValidTo.HasValue ? $" → {x.ValidTo.Value:yyyy-MM-dd}" : " onwards") · @x.Reason
                            </span>
                        </button>
                    }
                </RuleTable>

                <RuleTable Title="Classification policies" Empty="No restricted classifications configured.">
                    @foreach (var x in data.Policies) { <button class="block w-full border-b border-slate-100 p-2.5 text-left text-xs hover:bg-slate-50" @onclick="() => policy = Copy(x)"><strong>@x.ClassificationName</strong><span class="ml-2 rounded-full px-2 py-0.5 @(x.IsRestricted ? "bg-rose-100 text-rose-800" : "bg-slate-100 text-slate-700")">@(x.IsRestricted ? "Restricted" : "Normal")</span><span class="block mt-1 text-slate-500">@x.Description</span></button> }
                </RuleTable>

                <RuleTable Title="Explicit-only scopes" Empty="No explicit-only subjects configured.">
                    @foreach (var x in data.Scopes) { <button class="block w-full border-b border-slate-100 p-2.5 text-left text-xs hover:bg-slate-50" @onclick="() => scope = Copy(x)"><strong>@x.SubjectName</strong><span class="ml-2 text-slate-500">@x.SubjectType</span><span class="block mt-1">@(x.RequireExplicitGrant ? "Explicit grants only" : "Normal visibility")</span></button> }
                </RuleTable>

                <RuleTable Title="Grants and denials" Empty="No staff access grants configured.">
                    @foreach (var x in data.Grants) { <button class="block w-full border-b border-slate-100 p-2.5 text-left text-xs hover:bg-slate-50" @onclick="() => grant = Copy(x)"><strong>@x.SubjectName</strong> → @x.ResourceName <span class="ml-2 rounded-full px-2 py-0.5 @(x.IsAllowed ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")">@(x.IsAllowed ? "Allow" : "Deny")</span><span class="block mt-1 text-slate-500">@x.Reason</span></button> }
                </RuleTable>

                <RuleTable Title="Access scope audit history (UserAccessScopeAudits)" Empty="No scope audit events recorded yet.">
                    @foreach (var a in data.ScopeAudits.Take(25))
                    {
                        <div class="border-b border-slate-100 p-2.5 text-xs">
                            <div class="flex items-center justify-between gap-2">
                                <strong>@a.SubjectName → @a.TargetUnitOrTeam</strong>
                                <span class="rounded-full px-2 py-0.5 @(a.Action.Contains("Revoke") ? "bg-rose-100 text-rose-800" : "bg-blue-50 text-blue-700")">@a.Action</span>
                            </div>
                            <span class="block mt-0.5 text-slate-500">@a.Detail</span>
                            <span class="block mt-0.5 text-[11px] text-slate-400">By @a.PerformedByName · @a.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>
                    }
                </RuleTable>
            </aside>
        </div>
    }
</section>

@code {
    private StaffAccessSettingsData? data;
    private EffectiveAccessSimulationDto? simulation;
    private int? selectedOrganisationId;
    private int simulatedUserId;
    private bool loading = true, busy;
    private string? error;
    private StaffAccessPolicyDto policy = new() { IsRestricted = true };
    private StaffAccessScopeDto scope = new() { RequireExplicitGrant = true };
    private StaffAccessGrantDto grant = new() { IsAllowed = true };
    private OrganisationalAccessScopeDto orgScope = new() { ScopeType = "DivisionAndDescendants", IncludeDescendants = true, IsActive = true, ValidFrom = DateTime.UtcNow.Date };

    private const string Input = "mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500";
    private const string Primary = "inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 disabled:opacity-50";

    protected override Task OnInitializedAsync() => Load();

    private async Task ChangeOrganisationAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var orgId) && orgId > 0)
        {
            selectedOrganisationId = orgId;
            simulatedUserId = 0;
            simulation = null;
            policy = new() { IsRestricted = true };
            scope = new() { RequireExplicitGrant = true };
            grant = new() { IsAllowed = true };
            ResetOrgScope();
            await Load();
        }
    }

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            data = await Settings.LoadStaffAccessForOrganisationAsync(selectedOrganisationId);
            selectedOrganisationId = data.OrganisationId;
            if (simulatedUserId > 0)
                simulation = await Settings.SimulateEffectiveAccessForOrganisationAsync(simulatedUserId, selectedOrganisationId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<StaffAccessOption> SubjectOptions(string type) => type == "Role" ? data?.Groups ?? [] : data?.Users ?? [];
    private IEnumerable<StaffAccessOption> ResourceOptions(string type) => type == "Staff" ? data?.Staff ?? [] : data?.Classifications ?? [];

    private void ResetOrgScope() =>
        orgScope = new() { OrganisationId = selectedOrganisationId, ScopeType = "DivisionAndDescendants", IncludeDescendants = true, IsActive = true, ValidFrom = DateTime.UtcNow.Date };

    private async Task SavePolicy() { policy.OrganisationId = selectedOrganisationId; await Save(() => Settings.SaveStaffAccessPolicyAsync(policy), "Classification policy saved."); }
    private async Task SaveScope() { scope.OrganisationId = selectedOrganisationId; await Save(() => Settings.SaveStaffAccessScopeAsync(scope), "Access scope saved."); }
    private async Task SaveGrant() { grant.OrganisationId = selectedOrganisationId; await Save(() => Settings.SaveStaffAccessGrantAsync(grant), "Access grant saved."); }
    private async Task SaveOrgScope() { orgScope.OrganisationId = selectedOrganisationId; await Save(() => Settings.SaveOrganisationalAccessScopeAsync(orgScope), "Organisational access scope saved."); }

    private async Task RevokeOrgScope(int id)
    {
        var reason = string.IsNullOrWhiteSpace(orgScope.Reason) ? "Revoked by administrator." : orgScope.Reason;
        await Save(() => Settings.RevokeOrganisationalAccessScopeForOrganisationAsync(id, reason, selectedOrganisationId), "Organisational access scope revoked.");
        ResetOrgScope();
    }

    private async Task RunSimulation()
    {
        if (simulatedUserId <= 0) return;
        busy = true;
        error = null;
        try
        {
            simulation = await Settings.SimulateEffectiveAccessForOrganisationAsync(simulatedUserId, selectedOrganisationId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Save(Func<Task<HRM.DTOs.ServiceResult>> action, string message)
    {
        busy = true;
        error = null;
        try
        {
            var result = await action();
            if (!result.Success)
            {
                error = result.Message;
                return;
            }
            Toast.Show(message);
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static StaffAccessPolicyDto Copy(StaffAccessPolicyDto x) => new() { Id=x.Id, PositionClassificationId=x.PositionClassificationId, ClassificationName=x.ClassificationName, IsRestricted=x.IsRestricted, IsActive=x.IsActive, Description=x.Description };
    private static StaffAccessScopeDto Copy(StaffAccessScopeDto x) => new() { Id=x.Id, SubjectType=x.SubjectType, SubjectId=x.SubjectId, SubjectName=x.SubjectName, RequireExplicitGrant=x.RequireExplicitGrant, IsActive=x.IsActive };
    private static StaffAccessGrantDto Copy(StaffAccessGrantDto x) => new() { Id=x.Id, SubjectType=x.SubjectType, SubjectId=x.SubjectId, SubjectName=x.SubjectName, ResourceType=x.ResourceType, ResourceId=x.ResourceId, ResourceName=x.ResourceName, IsAllowed=x.IsAllowed, IsActive=x.IsActive, ExpiresAtUtc=x.ExpiresAtUtc, Reason=x.Reason };
    private static OrganisationalAccessScopeDto CopyOrgScope(OrganisationalAccessScopeDto x) => new()
    {
        Id = x.Id,
        SubjectType = x.SubjectType,
        SubjectId = x.SubjectId,
        SubjectName = x.SubjectName,
        ScopeType = x.ScopeType,
        UnitId = x.UnitId,
        UnitName = x.UnitName,
        TeamId = x.TeamId,
        TeamName = x.TeamName,
        IncludeDescendants = x.IncludeDescendants,
        PermissionFilter = x.PermissionFilter,
        ValidFrom = x.ValidFrom,
        ValidTo = x.ValidTo,
        IsActive = x.IsActive,
        Reason = x.Reason
    };
}
