@using HRM.DTOs.Roles
@using HRM.Services
@inject HRM.Services.Contracts.PermissionSettingsServiceContracts.IOperations Settings
@inject ToastService Toast
@inject ILogger<AccessSettingsEditor> Logger
@inject NavigationManager Navigation

<section class="w-full min-w-0 p-2 flex flex-col gap-2">
    <!-- Section Header matching OrganisationResources & UserSettingsEditor -->
    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800 flex-wrap gap-2">
        <div>
            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <span>@(GroupsMode ? "Roles" : "Permissions")</span>
                @if (data != null)
                {
                    <span class="rounded-full border px-2 py-0.5 text-[10px] font-semibold @(IsSuperAdminContext ? "" : "bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border-teal-200 dark:border-teal-800/40")"
                          style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)">
                        @(GroupsMode ? data.Roles.Count : data.Permissions.Count) configured
                    </span>
                }
            </h2>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                @(GroupsMode
                    ? $"{(string.IsNullOrWhiteSpace(data?.OrganisationName) ? "" : data.OrganisationName + " · ")}Create reusable job-function roles by selecting module permissions or applying a starter template."
                    : "Permissions are individual actions, grouped by HR module.")
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (GroupsMode && data?.IsSuperAdmin == true && data.Organisations.Count > 1)
            {
                <label class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                    <span>Organisation</span>
                    <select class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs font-medium text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                            value="@(selectedOrganisationId ?? data.OrganisationId)"
                            disabled="@(busy || loading)"
                            @onchange="ChangeOrganisationAsync">
                        @foreach (var org in data.Organisations)
                        {
                            <option value="@org.Id">@org.Name</option>
                        }
                    </select>
                </label>
            }
            <div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 p-0.5" role="tablist" aria-label="Role and permission view mode">
                @if (GroupsMode)
                {
                    <button type="button"
                            role="tab"
                            aria-selected="@(activeView == "matrix")"
                            class="rounded-md px-2.5 py-1 text-xs font-semibold transition flex items-center gap-1 @(activeView == "matrix" ? "bg-teal-700 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white")"
                            @onclick='() => activeView = "matrix"'>
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                        <span>Module Matrix</span>
                    </button>
                }
                <button type="button"
                        role="tab"
                        aria-selected="@(activeView == "editor")"
                        class="rounded-md px-2.5 py-1 text-xs font-semibold transition @(activeView == "editor" ? "bg-teal-700 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white")"
                        @onclick='() => activeView = "editor"'>
                    @(GroupsMode ? "Detailed List" : "Permission Editor")
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="@(activeView == "area-map")"
                        class="rounded-md px-2.5 py-1 text-xs font-semibold transition flex items-center gap-1 @(activeView == "area-map" ? "bg-teal-700 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white")"
                        @onclick='() => activeView = "area-map"'>
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <span>Area Map</span>
                </button>
            </div>
            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 text-white px-3 py-1.5 text-xs font-semibold shadow-xs disabled:opacity-50 transition"
                    aria-label="Add @Singular"
                    title="Add @Singular"
                    disabled="@busy"
                    @onclick="NewItem">
                <span>+ Add @Singular</span>
            </button>
        </div>
    </div>

    @if (error != null)
    {
        <div role="alert" class="rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2 text-xs text-rose-800 dark:text-rose-300">
            @error
        </div>
    }

    @if (loading)
    {
        <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            Loading access settings…
        </div>
    }
    else if (data != null)
    {
        <fieldset disabled="@busy" class="w-full min-w-0">
            <div class="grid grid-cols-1 gap-2 xl:grid-cols-12 items-start">
                <!-- Left: Editor Card -->
                <section class="min-w-0 xl:col-span-9">
                    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 p-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300">
                                    <AppIcon Name="@(Editing ? "edit_note" : "add_circle")" />
                                </span>
                                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">
                                    @(Editing ? "Edit" : "Create") @Singular
                                </h3>
                                @if (Editing)
                                {
                                    <span class="rounded bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/40 px-1.5 py-0.5 text-[10px] font-semibold text-amber-700 dark:text-amber-300">
                                        Editing #@(GroupsMode ? role.Id : permission.Id)
                                    </span>
                                }
                            </div>
                            @if (Editing)
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                        @onclick="NewItem">
                                    Cancel editing
                                </button>
                            }
                        </div>

                        <div class="p-2 flex flex-col gap-2">
                            @if (GroupsMode)
                            {
                                <label class="@LabelClass">Role name
                                    <input class="@InputClass" maxlength="250" @bind="role.Name" placeholder="For example HR Officer or Leave Approver" />
                                </label>

                                <!-- Quick Role Templates Strip -->
                                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2 flex flex-col gap-1.5">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200">Quick Role Templates</span>
                                        <span class="text-[10px] text-slate-500">One-click starter permission bundles</span>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var tpl in HRM.Helpers.AccessControlUiHelper.RoleTemplates)
                                        {
                                            <button type="button"
                                                    title="@tpl.Summary"
                                                    class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:border-teal-500 hover:text-teal-700 transition"
                                                    @onclick="() => ApplyRoleTemplate(tpl)">
                                                + @tpl.Name
                                            </button>
                                        }
                                        @if (role.PermissionIds.Count > 0)
                                        {
                                            <button type="button"
                                                    class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-semibold text-rose-700 hover:bg-rose-100 transition"
                                                    @onclick="() => role.PermissionIds.Clear()">
                                                Clear all (@role.PermissionIds.Count)
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (activeView == "matrix")
                                {
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Toggle actions by column or click any HR module to inspect, search, and select individual permissions.</p>
                                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                        <table class="w-full text-left text-xs">
                                            <thead class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/70 text-[11px] font-bold text-slate-700 dark:text-slate-200">
                                                <tr>
                                                    <th class="p-2">HR Module</th>
                                                    <th class="p-2 text-center">View</th>
                                                    <th class="p-2 text-center">Create / Edit</th>
                                                    <th class="p-2 text-center">Approve</th>
                                                    <th class="p-2 text-center">Configure</th>
                                                    <th class="p-2 text-center">All</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                @foreach (var mod in HRM.Helpers.AccessControlUiHelper.Modules)
                                                {
                                                    var modPerms = data.Permissions.Where(p => HRM.Helpers.AccessControlUiHelper.ResolveModule(p).Key == mod.Key).ToList();
                                                    if (modPerms.Count == 0) continue;
                                                    var allModSelected = modPerms.All(p => role.PermissionIds.Contains(p.Id));
                                                    var modSelectedCount = modPerms.Count(p => role.PermissionIds.Contains(p.Id));
                                                    var isExpanded = expandedModuleKey == mod.Key;
                                                    <tr class="@(isExpanded ? "bg-teal-50/50 dark:bg-teal-950/30" : "hover:bg-slate-50/60 dark:hover:bg-slate-800/40")" @key="mod.Key">
                                                        <td class="p-2">
                                                            <button type="button"
                                                                    class="w-full text-left flex items-center justify-between gap-2 group cursor-pointer"
                                                                    title="Click to inspect and search permissions in @mod.Label"
                                                                    @onclick="() => ToggleModuleInspector(mod.Key)">
                                                                <span class="flex items-center gap-2 min-w-0">
                                                                    <i class="bi @(isExpanded ? "bi-chevron-down text-teal-700 dark:text-teal-300" : "bi-chevron-right text-slate-400 group-hover:text-teal-600") text-[11px] shrink-0"></i>
                                                                    <i class="bi @mod.Icon text-teal-700 dark:text-teal-400 shrink-0"></i>
                                                                    <span class="min-w-0">
                                                                        <span class="block font-semibold text-slate-900 dark:text-slate-100 group-hover:text-teal-700 dark:group-hover:text-teal-300 truncate">@mod.Label</span>
                                                                        <span class="block text-[10px] text-slate-500">@modSelectedCount / @modPerms.Count permissions</span>
                                                                    </span>
                                                                </span>
                                                            </button>
                                                        </td>
                                                        @foreach (var bucket in new[] { HRM.Helpers.AccessActionBucket.View, HRM.Helpers.AccessActionBucket.CreateEdit, HRM.Helpers.AccessActionBucket.Approve, HRM.Helpers.AccessActionBucket.Configure })
                                                        {
                                                            var bucketPerms = modPerms.Where(p => HRM.Helpers.AccessControlUiHelper.ResolveAction(p) == bucket).ToList();
                                                            var bucketIds = bucketPerms.Select(p => p.Id).ToList();
                                                            var selCount = bucketPerms.Count(p => role.PermissionIds.Contains(p.Id));
                                                            var allChecked = bucketPerms.Count > 0 && selCount == bucketPerms.Count;
                                                            <td class="p-2 text-center">
                                                                @if (bucketPerms.Count == 0)
                                                                {
                                                                    <span class="text-slate-300 dark:text-slate-700">—</span>
                                                                }
                                                                else
                                                                {
                                                                    <label class="inline-flex items-center justify-center gap-1 cursor-pointer">
                                                                        <input type="checkbox"
                                                                               class="h-4 w-4 rounded accent-teal-700"
                                                                               checked="@allChecked"
                                                                               @onchange="e => MovePermissions(bucketIds, e.Value is true)" />
                                                                        <span class="text-[10px] @(selCount > 0 ? "font-semibold text-teal-700 dark:text-teal-300" : "text-slate-400")">@selCount/@bucketPerms.Count</span>
                                                                    </label>
                                                                }
                                                            </td>
                                                        }
                                                        <td class="p-2 text-center">
                                                            <input type="checkbox"
                                                                   class="h-4 w-4 rounded accent-teal-700 cursor-pointer"
                                                                   checked="@allModSelected"
                                                                   @onchange="e => MovePermissions(modPerms.Select(p => p.Id).ToList(), e.Value is true)" />
                                                        </td>
                                                    </tr>
                                                    @if (isExpanded)
                                                    {
                                                        var filteredModPerms = FilterModulePermissions(modPerms);
                                                        var filteredIds = filteredModPerms.Select(p => p.Id).ToList();
                                                        <tr class="bg-slate-50/80 dark:bg-slate-800/30" @key='($"{mod.Key}-drawer")'>
                                                            <td colspan="6" class="p-2.5">
                                                                <div class="rounded-xl border border-teal-200/80 dark:border-teal-800/60 bg-white dark:bg-slate-900 p-2.5 flex flex-col gap-2">
                                                                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2">
                                                                        <div class="min-w-0">
                                                                            <p class="text-xs font-bold text-slate-900 dark:text-slate-100">@mod.Label Permissions</p>
                                                                            <p class="text-[11px] text-slate-500">@modSelectedCount / @modPerms.Count selected@(string.IsNullOrWhiteSpace(moduleSearch) && moduleActionFilter == "all" ? "" : $" · {filteredModPerms.Count} shown")</p>
                                                                        </div>
                                                                        <div class="flex flex-wrap items-center gap-1.5">
                                                                            @if (filteredModPerms.Count > 0)
                                                                            {
                                                                                <button type="button"
                                                                                        class="rounded-lg border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/50 px-2 py-1 text-[11px] font-semibold text-teal-800 dark:text-teal-200 hover:bg-teal-100 transition"
                                                                                        @onclick="() => MovePermissions(filteredIds, true)">
                                                                                    Select shown
                                                                                </button>
                                                                                <button type="button"
                                                                                        class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 transition"
                                                                                        @onclick="() => MovePermissions(filteredIds, false)">
                                                                                    Deselect shown
                                                                                </button>
                                                                            }
                                                                            <button type="button"
                                                                                    class="rounded-lg px-2 py-1 text-[11px] font-semibold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition"
                                                                                    @onclick="CloseModuleInspector">
                                                                                Close
                                                                            </button>
                                                                        </div>
                                                                    </div>

                                                                    <div class="flex flex-wrap items-center gap-2">
                                                                        <input type="search"
                                                                               placeholder="Search permissions in @mod.Label…"
                                                                               @bind="moduleSearch"
                                                                               @bind:event="oninput"
                                                                               class="flex-1 min-w-[180px] rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                                                        <div class="flex flex-wrap items-center gap-1">
                                                                            @foreach (var opt in ModuleActionFilterOptions)
                                                                            {
                                                                                var activeFilter = moduleActionFilter == opt.Key;
                                                                                <button type="button"
                                                                                        class="rounded-lg border px-2 py-1 text-[11px] font-semibold transition @(activeFilter ? "border-teal-600 bg-teal-600 text-white" : "border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-teal-400")"
                                                                                        @onclick="() => moduleActionFilter = opt.Key">
                                                                                    @opt.Label
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>

                                                                    @if (filteredModPerms.Count == 0)
                                                                    {
                                                                        <p class="p-3 text-center text-xs text-slate-500">No permissions in @mod.Label match your search or filter.</p>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="grid max-h-64 grid-cols-1 gap-1.5 overflow-y-auto pr-0.5 md:grid-cols-2">
                                                                            @foreach (var perm in filteredModPerms)
                                                                            {
                                                                                var isChecked = role.PermissionIds.Contains(perm.Id);
                                                                                var actionLabel = ActionBucketLabel(HRM.Helpers.AccessControlUiHelper.ResolveAction(perm));
                                                                                <label class="flex items-start gap-2 rounded-lg border p-2 cursor-pointer transition @(isChecked ? "border-teal-200 dark:border-teal-800 bg-teal-50/40 dark:bg-teal-950/25" : "border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-800/40 hover:border-teal-300")"
                                                                                       @key="perm.Id">
                                                                                    <input type="checkbox"
                                                                                           class="mt-0.5 h-4 w-4 rounded accent-teal-700"
                                                                                           checked="@isChecked"
                                                                                           @onchange="e => TogglePermission(perm.Id, e.Value is true)" />
                                                                                    <span class="min-w-0 flex-1">
                                                                                        <span class="flex flex-wrap items-center gap-1.5">
                                                                                            <span class="text-xs font-semibold text-slate-900 dark:text-slate-100">@perm.Name</span>
                                                                                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 dark:text-slate-300">@actionLabel</span>
                                                                                        </span>
                                                                                        <span class="mt-0.5 block break-all font-mono text-[10px] text-slate-500 dark:text-slate-400">@perm.Key</span>
                                                                                        @if (!string.IsNullOrWhiteSpace(perm.Description))
                                                                                        {
                                                                                            <span class="mt-0.5 block text-[11px] leading-snug text-slate-600 dark:text-slate-300">@perm.Description</span>
                                                                                        }
                                                                                    </span>
                                                                                </label>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else if (activeView == "area-map")
                                {
                                    <RoleAreaMapPanel AreaMap="data.AreaMap"
                                                      AssignedPermissionIds="role.PermissionIds"
                                                      SelectedRoleName="@role.Name"
                                                      InteractiveAssignment="true"
                                                      OnTogglePermission="args => TogglePermission(args.PermissionId, args.Assign)"
                                                      OnMoveGroup="args => MovePermissions(args.PermissionIds, args.Assign)" />
                                }
                                else
                                {
                                    <div class="rounded-xl border border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30 p-2 text-xs text-teal-900 dark:text-teal-200">
                                        Add or remove permissions below, then save the role to apply your changes.
                                    </div>
                                    <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
                                        <PermissionAssignmentColumn @key="(role.Id, true)" Assigned="true"
                                            Permissions="data.Permissions.Where(x => role.PermissionIds.Contains(x.Id)).ToList()"
                                            Modules="data.Modules"
                                            OnMove="id => TogglePermission(id, false)" OnMoveGroup="ids => MovePermissions(ids, false)" />
                                        <PermissionAssignmentColumn @key="(role.Id, false)" Assigned="false"
                                            Permissions="data.Permissions.Where(x => !role.PermissionIds.Contains(x.Id)).ToList()"
                                            Modules="data.Modules"
                                            OnMove="id => TogglePermission(id, true)" OnMoveGroup="ids => MovePermissions(ids, true)" />
                                    </div>
                                }
                                @if (role.Id > 0)
                                {
                                    <section aria-label="Assigned staff" class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                                        <div class="flex flex-col gap-2 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2">
                                            <div class="flex items-center justify-between gap-2">
                                                <div class="flex items-center gap-2">
                                                    <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100">Assigned staff</h4>
                                                    <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">@role.Members.Count</span>
                                                </div>
                                                <button type="button"
                                                        class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:border-teal-400 transition cursor-pointer"
                                                        @onclick="() => OpenRoleStaffModal(role.Id)">
                                                    <i class="bi bi-people text-[11px]"></i>
                                                    <span>Manage staff</span>
                                                </button>
                                            </div>
                                            <input type="search" class="@InputClass" aria-label="Search assigned staff" placeholder="Search staff name or username…" @bind="staffSearch" @bind:event="oninput" />
                                        </div>
                                        <div class="divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto" style="max-height: 20rem;" tabindex="0">
                                            @foreach (var member in FilteredStaff)
                                            {
                                                <div @key="member.UserId" class="flex items-center justify-between gap-2 p-2">
                                                    <div class="min-w-0">
                                                        <p class="break-words text-xs font-semibold text-slate-800 dark:text-slate-100">@member.Name</p>
                                                        <p class="break-all text-[11px] text-slate-500 dark:text-slate-400">@member.Username</p>
                                                    </div>
                                                    <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold @(member.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(member.IsActive ? "Active" : "Inactive")</span>
                                                </div>
                                            }
                                            @if (!FilteredStaff.Any())
                                            {
                                                <p class="p-4 text-center text-xs text-slate-500">@(role.Members.Count == 0 ? "No staff are assigned to this role." : "No assigned staff match your search.")</p>
                                            }
                                        </div>
                                    </section>
                                }
                            }
                            else
                            {
                                @if (activeView == "area-map")
                                {
                                    <RoleAreaMapPanel AreaMap="data.AreaMap"
                                                      InteractiveAssignment="false"
                                                      OnSelectPermission="InspectPermissionById" />
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                                        <label class="@LabelClass">Permission key
                                            <input class="@InputClass" maxlength="100" readonly="@(permission.Id != 0)" @bind="permission.Key" @bind:event="oninput" placeholder="Leave.Approve" />
                                            <span class="mt-1 block text-[11px] font-normal text-slate-500 dark:text-slate-400">@(permission.Id == 0 ? $"Area: {permission.Group}. Keys determine grouping." : "Keys stay unchanged because application access checks use them.")</span>
                                        </label>
                                        <label class="@LabelClass">Permission name<input class="@InputClass" maxlength="250" @bind="permission.Name" /></label>
                                        <label class="@LabelClass md:col-span-2">Description<textarea class="@InputClass" rows="3" maxlength="1000" @bind="permission.Description"></textarea></label>
                                        <label class="@LabelClass">Context<select class="@InputClass" @bind="permission.ContextId">@foreach (var item in data.Contexts) { <option value="@item.Id">@item.Name</option> }</select></label>
                                        <label class="@LabelClass">Module<select class="@InputClass" @bind="permission.ModuleId"><option value="">Not assigned</option>@foreach (var item in data.Modules) { <option value="@item.Id">@item.Name</option> }</select></label>
                                    </div>
                                    @if (permission.IsSystem)
                                    {
                                        <div class="rounded-lg border border-violet-200 bg-violet-50 p-2 text-xs text-violet-700">
                                            System permission. Its key and existing assignments are preserved.
                                        </div>
                                    }
                                }
                            }
                        </div>

                        <div class="flex flex-wrap items-center gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 text-white px-3 py-1.5 text-xs font-semibold shadow-xs disabled:opacity-50 transition"
                                    @onclick="SaveAsync">
                                @(busy ? "Saving…" : $"Save {Singular.ToLowerInvariant()}")
                            </button>
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                                    @onclick="NewItem">
                                Clear
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Right: Role / Permission List Card -->
                <aside class="min-w-0 xl:col-span-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                    <div class="flex flex-col gap-2 border-b border-slate-100 dark:border-slate-800 p-2">
                        <div class="flex items-center justify-between gap-2">
                            <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">@(GroupsMode ? "Roles" : "Permissions")</h3>
                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                                @(GroupsMode ? data.Roles.Count : FilteredPermissions.Count())
                            </span>
                        </div>
                        <input type="search"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                               placeholder="Search…"
                               aria-label="Search @(GroupsMode ? "roles" : "permissions")"
                               @bind="search"
                               @bind:event="oninput" />
                    </div>
                    <div class="overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800" style="max-height: 680px; scrollbar-gutter: stable;" tabindex="0" aria-label="@(GroupsMode ? "Role list" : "Grouped permission list")">
                        @if (GroupsMode)
                        {
                            @foreach (var item in data.Roles.Where(x => x.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                var isCurrent = role.Id == item.Id;
                                <div @key="item.Id" class="border-l-4 p-2 transition-colors flex items-center justify-between gap-2 @(isCurrent ? "border-teal-700 bg-teal-50/70 dark:bg-teal-950/40" : "border-transparent hover:bg-slate-50 dark:hover:bg-slate-800/60")">
                                    <button type="button" class="min-w-0 flex-1 text-left cursor-pointer" @onclick="() => SelectRole(item)">
                                        <span class="block text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">@item.Name</span>
                                        <span class="mt-0.5 block text-[11px] text-slate-500 dark:text-slate-400">@item.PermissionIds.Count permissions · @item.MemberCount staff</span>
                                    </button>
                                    <button type="button"
                                            class="shrink-0 inline-flex items-center gap-1 rounded-lg border px-2 py-1 text-[10px] font-semibold transition cursor-pointer @(IsSuperAdminContext ? "hover:opacity-90" : "border-teal-200 dark:border-teal-800 bg-teal-50/70 dark:bg-teal-950/40 text-teal-800 dark:text-teal-200 hover:bg-teal-100")"
                                            style="@(IsSuperAdminContext ? "background-color: #eef8fc; border-color: #ADD8E6; color: #0f172a;" : null)"
                                            title="View, add, or remove staff assigned to @item.Name"
                                            @onclick="() => OpenRoleStaffModal(item.Id)">
                                        <i class="bi bi-people text-[11px]"></i>
                                        <span>Staff (@item.MemberCount)</span>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var group in FilteredPermissions.GroupBy(x => x.Group).OrderBy(x => x.Key))
                            {
                                <details open="@(group.Key == "Leave" || !string.IsNullOrWhiteSpace(search))" class="border-b border-slate-100 dark:border-slate-800">
                                    <summary class="cursor-pointer bg-slate-50 dark:bg-slate-800/60 p-2 text-xs font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between">
                                        <span>@group.Key</span>
                                        <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">@group.Count()</span>
                                    </summary>
                                    @foreach (var item in group)
                                    {
                                        <button type="button" class="@ItemClass(permission.Id == item.Id)" @onclick="() => SelectPermission(item)">
                                            <span class="block text-xs font-semibold text-slate-800 dark:text-slate-100">@item.Name</span>
                                            <span class="mt-0.5 block break-all text-[11px] font-mono text-slate-500 dark:text-slate-400">@item.Key</span>
                                        </button>
                                    }
                                </details>
                            }
                            @if (!FilteredPermissions.Any())
                            {
                                <p class="p-4 text-center text-xs text-slate-500">No permissions found.</p>
                            }
                        }
                    </div>
                </aside>
            </div>
        </fieldset>
    }

    <!-- Role Staff Modal (View Assigned Staff, Remove, and Add Staff) -->
    @if (GroupsMode && ModalRole is { } activeModalRole)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" @onclick="CloseRoleStaffModal">
            <section role="dialog"
                     aria-modal="true"
                     aria-labelledby="role-staff-modal-title"
                     class="w-full max-w-4xl max-h-[88vh] flex flex-col rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-2xl overflow-hidden"
                     @onclick:stopPropagation="true">
                <!-- Modal Header -->
                <div class="flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-4 py-3 @(IsSuperAdminContext ? "" : "bg-teal-50/50 dark:bg-teal-950/30")"
                     style="@(IsSuperAdminContext ? "background-color: #eef8fc; border-bottom-color: #ADD8E6;" : null)">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 id="role-staff-modal-title" class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">
                                @activeModalRole.Name — Staff Assignment
                            </h3>
                            <span class="rounded-full border px-2 py-0.5 text-[10px] font-semibold @(IsSuperAdminContext ? "" : "bg-teal-100 text-teal-800 border-teal-200")"
                                  style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)">
                                @activeModalRole.Members.Count assigned
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(data?.OrganisationName))
                        {
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@data.OrganisationName</p>
                        }
                    </div>
                    <button type="button"
                            class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition cursor-pointer"
                            aria-label="Close staff modal"
                            @onclick="CloseRoleStaffModal">
                        <i class="bi bi-x-lg text-xs"></i>
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(modalError))
                {
                    <div role="alert" class="mx-4 mt-3 rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2 text-xs text-rose-800 dark:text-rose-300">
                        @modalError
                    </div>
                }

                <!-- Modal Body: 2 Columns (Left: Assigned Staff with Remove, Right: Add Staff) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 p-4 overflow-y-auto flex-1 min-h-0">
                    <!-- Left: Currently Assigned Staff -->
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden min-h-[260px]">
                        <div class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5 flex flex-col gap-2">
                            <div class="flex items-center justify-between gap-2">
                                <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">Assigned Staff</h4>
                                <span class="rounded-full bg-slate-200/80 dark:bg-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-200">
                                    @FilteredModalAssignedStaff.Count / @activeModalRole.Members.Count
                                </span>
                            </div>
                            <input type="search"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                   placeholder="Search assigned staff…"
                                   @bind="modalAssignedSearch"
                                   @bind:event="oninput" />
                        </div>
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto max-h-[380px] flex-1">
                            @foreach (var member in FilteredModalAssignedStaff)
                            {
                                <div @key="member.UserId" class="flex items-center justify-between gap-2 p-2.5 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                    <div class="min-w-0">
                                        <p class="text-xs font-semibold text-slate-900 dark:text-slate-100 truncate">@member.Name</p>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">@member.Username</span>
                                            <span class="rounded-full px-1.5 py-0.2 text-[9px] font-semibold @(member.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">
                                                @(member.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="shrink-0 rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 px-2.5 py-1 text-[11px] font-semibold text-rose-700 dark:text-rose-300 hover:bg-rose-100 disabled:opacity-50 transition cursor-pointer"
                                            disabled="@modalBusy"
                                            @onclick="() => RemoveStaffFromModalRoleAsync(member.UserId)">
                                        Remove
                                    </button>
                                </div>
                            }
                            @if (FilteredModalAssignedStaff.Count == 0)
                            {
                                <p class="p-6 text-center text-xs text-slate-500 dark:text-slate-400">
                                    @(activeModalRole.Members.Count == 0 ? "No staff are assigned to this role yet." : "No assigned staff match your search.")
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Right: Add Staff to Role -->
                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden min-h-[260px]">
                        <div class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5 flex flex-col gap-2">
                            <div class="flex items-center justify-between gap-2">
                                <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">Add Staff to Role</h4>
                                <span class="rounded-full bg-slate-200/80 dark:bg-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-200">
                                    @FilteredModalAvailableStaff.Count available
                                </span>
                            </div>
                            <input type="search"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                   placeholder="Search staff to add…"
                                   @bind="modalAvailableSearch"
                                   @bind:event="oninput" />
                        </div>
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto max-h-[380px] flex-1">
                            @foreach (var candidate in FilteredModalAvailableStaff)
                            {
                                <div @key="candidate.UserId" class="flex items-center justify-between gap-2 p-2.5 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                    <div class="min-w-0">
                                        <p class="text-xs font-semibold text-slate-900 dark:text-slate-100 truncate">@candidate.Name</p>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">@candidate.Username</span>
                                            <span class="rounded-full px-1.5 py-0.2 text-[9px] font-semibold @(candidate.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">
                                                @(candidate.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="shrink-0 rounded-lg border px-2.5 py-1 text-[11px] font-semibold disabled:opacity-50 transition cursor-pointer @(IsSuperAdminContext ? "hover:opacity-90" : "border-teal-600 bg-teal-700 text-white hover:bg-teal-800")"
                                            style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)"
                                            disabled="@modalBusy"
                                            @onclick="() => AddStaffToModalRoleAsync(candidate.UserId)">
                                        + Add
                                    </button>
                                </div>
                            }
                            @if (FilteredModalAvailableStaff.Count == 0)
                            {
                                <p class="p-6 text-center text-xs text-slate-500 dark:text-slate-400">
                                    @(string.IsNullOrWhiteSpace(modalAvailableSearch) ? "All staff accounts in this organisation are already assigned to this role." : "No matching staff found.")
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="flex items-center justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 px-4 py-2.5">
                    <button type="button"
                            class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 transition cursor-pointer"
                            @onclick="CloseRoleStaffModal">
                        Done
                    </button>
                </div>
            </section>
        </div>
    }
</section>

@code {
    [Parameter] public bool GroupsMode { get; set; }
    [Parameter] public string? InitialView { get; set; }
    private PermissionSettingsData? data;
    private PermissionDefinitionDto permission = new();
    private AccessRoleDto role = new();
    private bool loading, busy;
    private string? error;
    private int? selectedOrganisationId;
    private string search = "";
    private bool IsSuperAdminContext => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/superadmin", StringComparison.OrdinalIgnoreCase);

    // Role Staff Modal State
    private int? modalRoleId;
    private bool modalBusy;
    private string? modalError;
    private string modalAssignedSearch = "";
    private string modalAvailableSearch = "";

    private AccessRoleDto? ModalRole =>
        modalRoleId.HasValue ? data?.Roles.FirstOrDefault(r => r.Id == modalRoleId.Value) : null;

    private List<RoleStaffDto> FilteredModalAssignedStaff =>
        ModalRole == null
            ? []
            : ModalRole.Members
                .Where(m => string.IsNullOrWhiteSpace(modalAssignedSearch) ||
                            m.Name.Contains(modalAssignedSearch, StringComparison.OrdinalIgnoreCase) ||
                            m.Username.Contains(modalAssignedSearch, StringComparison.OrdinalIgnoreCase))
                .OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

    private List<RoleStaffDto> FilteredModalAvailableStaff
    {
        get
        {
            if (ModalRole == null || data == null) return [];
            var assignedIds = ModalRole.Members.Select(m => m.UserId).ToHashSet();
            return data.OrganisationUsers
                .Where(u => !assignedIds.Contains(u.UserId) &&
                            (string.IsNullOrWhiteSpace(modalAvailableSearch) ||
                             u.Name.Contains(modalAvailableSearch, StringComparison.OrdinalIgnoreCase) ||
                             u.Username.Contains(modalAvailableSearch, StringComparison.OrdinalIgnoreCase)))
                .OrderBy(u => u.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private void OpenRoleStaffModal(int targetRoleId)
    {
        modalRoleId = targetRoleId;
        modalError = null;
        modalAssignedSearch = "";
        modalAvailableSearch = "";
    }

    private void CloseRoleStaffModal()
    {
        modalRoleId = null;
        modalError = null;
        modalAssignedSearch = "";
        modalAvailableSearch = "";
    }

    private async Task AddStaffToModalRoleAsync(int userId)
    {
        if (!modalRoleId.HasValue || modalBusy) return;
        modalBusy = true;
        modalError = null;
        try
        {
            var orgId = selectedOrganisationId ?? data?.OrganisationId;
            var result = await Settings.AddStaffToRoleAsync(modalRoleId.Value, userId, orgId);
            if (!result.Success) { modalError = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message);
            await RefreshAfterModalChangeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not add staff {UserId} to role {RoleId}.", userId, modalRoleId);
            modalError = ex is UnauthorizedAccessException ? ex.Message : "Could not add staff to this role. Please try again.";
            Toast.Error(modalError);
        }
        finally { modalBusy = false; }
    }

    private async Task RemoveStaffFromModalRoleAsync(int userId)
    {
        if (!modalRoleId.HasValue || modalBusy) return;
        modalBusy = true;
        modalError = null;
        try
        {
            var orgId = selectedOrganisationId ?? data?.OrganisationId;
            var result = await Settings.RemoveStaffFromRoleAsync(modalRoleId.Value, userId, orgId);
            if (!result.Success) { modalError = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message);
            await RefreshAfterModalChangeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not remove staff {UserId} from role {RoleId}.", userId, modalRoleId);
            modalError = ex is UnauthorizedAccessException ? ex.Message : "Could not remove staff from this role. Please try again.";
            Toast.Error(modalError);
        }
        finally { modalBusy = false; }
    }

    private async Task RefreshAfterModalChangeAsync()
    {
        data = await Settings.LoadForOrganisationAsync(GroupsMode, selectedOrganisationId);
        if (role.Id > 0 && data.Roles.FirstOrDefault(r => r.Id == role.Id) is { } updatedSelected)
        {
            SelectRole(updatedSelected);
        }
    }
    private string staffSearch = "";
    private string activeView = "matrix";
    private string? expandedModuleKey;
    private string moduleSearch = "";
    private string moduleActionFilter = "all";

    private static readonly (string Key, string Label)[] ModuleActionFilterOptions =
    [
        ("all", "All"),
        ("View", "View"),
        ("CreateEdit", "Create / Edit"),
        ("Approve", "Approve"),
        ("Configure", "Configure")
    ];

    private void ToggleModuleInspector(string moduleKey)
    {
        if (expandedModuleKey == moduleKey)
        {
            CloseModuleInspector();
            return;
        }
        expandedModuleKey = moduleKey;
        moduleSearch = "";
        moduleActionFilter = "all";
    }

    private void CloseModuleInspector()
    {
        expandedModuleKey = null;
        moduleSearch = "";
        moduleActionFilter = "all";
    }

    private List<PermissionDefinitionDto> FilterModulePermissions(List<PermissionDefinitionDto> perms) =>
        perms.Where(p =>
            (moduleActionFilter == "all" || HRM.Helpers.AccessControlUiHelper.ResolveAction(p).ToString() == moduleActionFilter) &&
            (string.IsNullOrWhiteSpace(moduleSearch) || Matches(p, moduleSearch)))
        .OrderBy(p => p.Name)
        .ToList();

    private static string ActionBucketLabel(HRM.Helpers.AccessActionBucket bucket) => bucket switch
    {
        HRM.Helpers.AccessActionBucket.CreateEdit => "Create / Edit",
        HRM.Helpers.AccessActionBucket.Approve => "Approve",
        HRM.Helpers.AccessActionBucket.Configure => "Configure",
        _ => "View"
    };
    private void ApplyRoleTemplate(HRM.Helpers.RoleTemplatePreset template)
    {
        if (data == null) return;
        if (string.IsNullOrWhiteSpace(role.Name)) role.Name = template.Name;
        var matched = HRM.Helpers.AccessControlUiHelper.MatchTemplatePermissions(template, data.Permissions);
        role.PermissionIds = matched;
        Toast.Info($"Applied '{template.Name}' template ({matched.Count} permissions). Review and save.");
    }
    private IEnumerable<RoleStaffDto> FilteredStaff => role.Members.Where(x =>
        x.Name.Contains(staffSearch, StringComparison.OrdinalIgnoreCase) || x.Username.Contains(staffSearch, StringComparison.OrdinalIgnoreCase));
    private string Singular => GroupsMode ? "Role" : "Permission";
    private bool Editing => GroupsMode ? role.Id > 0 : permission.Id > 0;
    private const string LabelClass = "block text-[11px] font-semibold text-slate-600 dark:text-slate-400";
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500 read-only:bg-slate-50 dark:read-only:bg-slate-800/50";
    private static string ItemClass(bool selected) => "block w-full border-l-4 p-2 text-left transition-colors " + (selected ? "border-teal-700 bg-teal-50/70 dark:bg-teal-950/40" : "border-transparent hover:bg-slate-50 dark:hover:bg-slate-800/60");
    private static bool Matches(PermissionDefinitionDto p, string query) => p.Key.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Name.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Group.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Description.Contains(query, StringComparison.OrdinalIgnoreCase);
    private IEnumerable<PermissionDefinitionDto> FilteredPermissions => data?.Permissions.Where(x => Matches(x, search)) ?? Enumerable.Empty<PermissionDefinitionDto>();
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(InitialView))
            activeView = InitialView.Equals("area-map", StringComparison.OrdinalIgnoreCase) ? "area-map" : (GroupsMode ? "matrix" : "editor");
        else if (!GroupsMode && activeView == "matrix")
            activeView = "editor";
    }
    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            data = await Settings.LoadForOrganisationAsync(GroupsMode, selectedOrganisationId);
            if (data.OrganisationId > 0) selectedOrganisationId = data.OrganisationId;
            if (GroupsMode && role.Id == 0) role.OrganisationId = selectedOrganisationId;
        }
        catch (Exception ex) { Fail(ex); }
        finally { loading = false; }
    }

    private async Task ChangeOrganisationAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var orgId) || orgId <= 0) return;
        selectedOrganisationId = orgId;
        search = "";
        CloseModuleInspector();
        NewItem();
        await LoadDataAsync();
    }

    private void NewItem() { permission = new(); role = new() { OrganisationId = selectedOrganisationId ?? data?.OrganisationId }; error = null; staffSearch = ""; }
    private void SelectPermission(PermissionDefinitionDto p) { error = null; permission = new() { Id = p.Id, Key = p.Key, Name = p.Name, Description = p.Description, ContextId = p.ContextId, ModuleId = p.ModuleId, IsSystem = p.IsSystem }; }
    private void InspectPermissionById(int id)
    {
        if (data?.Permissions.FirstOrDefault(x => x.Id == id) is { } found)
        {
            SelectPermission(found);
            activeView = "editor";
        }
    }
    private void SelectRole(AccessRoleDto r) { error = null; staffSearch = ""; role = new() { Id = r.Id, OrganisationId = r.OrganisationId ?? selectedOrganisationId ?? data?.OrganisationId, Name = r.Name, MemberCount = r.MemberCount, PermissionIds = r.PermissionIds.ToList(), Members = r.Members.ToList() }; }
    private void TogglePermission(int id, bool selected) { if (selected && !role.PermissionIds.Contains(id)) role.PermissionIds.Add(id); else if (!selected) role.PermissionIds.Remove(id); }
    private void MovePermissions(List<int> ids, bool selected) { foreach (var id in ids) TogglePermission(id, selected); }
    private async Task SaveAsync()
    {
        busy = true; error = null;
        try
        {
            if (GroupsMode) role.OrganisationId = selectedOrganisationId ?? data?.OrganisationId;
            var result = GroupsMode ? await Settings.SaveRoleAsync(role) : await Settings.SavePermissionAsync(permission);
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message);
            data = await Settings.LoadForOrganisationAsync(GroupsMode, selectedOrganisationId);
            if (GroupsMode && data.Roles.FirstOrDefault(x => x.Id == role.Id) is { } savedRole) SelectRole(savedRole);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private void Fail(Exception ex)
    {
        Logger.LogError(ex, "Could not load or save permission settings.");
        error = ex is UnauthorizedAccessException ? ex.Message : "Access settings could not be loaded or saved. Please try again.";
        Toast.Error(error);
    }
}
