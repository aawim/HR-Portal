<section class="overflow-hidden rounded-xl border border-slate-200">
    <h4 class="border-b border-slate-200 bg-slate-50 p-2.5 text-xs font-semibold text-slate-700">@Title</h4>
    @if (ChildContent == null) { <p class="p-4 text-center text-xs text-slate-500">@Empty</p> } else { @ChildContent }
</section>
@code { [Parameter] public string Title { get; set; } = ""; [Parameter] public string Empty { get; set; } = ""; [Parameter] public RenderFragment? ChildContent { get; set; } }
