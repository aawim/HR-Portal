  private void ToggleDevice(int id)
  {
    if (!enrolment.AttendanceDeviceIds.Remove(id))
      enrolment.AttendanceDeviceIds.Add(id);
  }

  private (string Thumbprint, string Issuer, DateTime NotAfterUtc, byte[] PfxBytes, string CaBase64, string FileName) BuildCertificateArtifacts(string agentId, string password, DateTime expiryUtc)
  {
    var notBefore = DateTimeOffset.UtcNow.AddMinutes(-5);
    var notAfter = new DateTimeOffset(expiryUtc.ToUniversalTime(), TimeSpan.Zero);
    if (notAfter <= notBefore) notAfter = DateTimeOffset.UtcNow.AddYears(1);

    using var caRsa = RSA.Create(2048);
    var caReq = new CertificateRequest("CN=DHR Edge Authority Root CA, O=HRM Attendance Edge", caRsa, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);
    caReq.CertificateExtensions.Add(new X509BasicConstraintsExtension(true, false, 0, true));
    caReq.CertificateExtensions.Add(new X509KeyUsageExtension(X509KeyUsageFlags.KeyCertSign | X509KeyUsageFlags.CrlSign, true));
    using var caCert = caReq.CreateSelfSigned(notBefore, DateTimeOffset.UtcNow.AddYears(10));

    using var clientRsa = RSA.Create(2048);
    var clientReq = new CertificateRequest($"CN={agentId}, O=HRM Attendance Edge", clientRsa, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);
    clientReq.CertificateExtensions.Add(new X509BasicConstraintsExtension(false, false, 0, false));
    clientReq.CertificateExtensions.Add(new X509KeyUsageExtension(X509KeyUsageFlags.DigitalSignature | X509KeyUsageFlags.KeyEncipherment, true));
    clientReq.CertificateExtensions.Add(new X509EnhancedKeyUsageExtension(new OidCollection { new Oid("1.3.6.1.5.5.7.3.2") }, false));

    var serial = new byte[8];
    RandomNumberGenerator.Fill(serial);
    using var clientCert = clientReq.Create(caCert, notBefore, notAfter, serial);
    using var clientWithKey = clientCert.CopyWithPrivateKey(clientRsa);
    var pfxBytes = clientWithKey.Export(X509ContentType.Pfx, password);
    return (clientCert.Thumbprint, clientCert.Issuer, notAfter.UtcDateTime, pfxBytes, Convert.ToBase64String(caCert.RawData), $"{agentId}.pfx");
  }

  private void AutoGenerateThumbprintAsync()
  {
    error = null;
    successMessage = null;
    var agentId = string.IsNullOrWhiteSpace(enrolment.AgentIdentifier) ? "edge-agent-01" : enrolment.AgentIdentifier.Trim();
    if (string.IsNullOrWhiteSpace(enrolment.AgentIdentifier)) enrolment.AgentIdentifier = agentId;
    var password = string.IsNullOrWhiteSpace(certPassword) ? "ChangeThisPassword123!" : certPassword;
    var cert = BuildCertificateArtifacts(agentId, password, enrolment.CertificateNotAfterUtc);
    enrolment.CertificateThumbprint = cert.Thumbprint;
    enrolment.CertificateIssuer = cert.Issuer;
    enrolment.CertificateNotAfterUtc = cert.NotAfterUtc;
    pendingPfxBytes = cert.PfxBytes;
    pendingCaBase64 = cert.CaBase64;
    pendingFileName = cert.FileName;
    successMessage = $"Generated thumbprint {cert.Thumbprint}. Click 'Enrol with Existing Thumbprint' or 'Generate, Enrol & Download .pfx' to save.";
  }

  private async Task GenerateAndEnrolAsync()
  {
    error = null;
    successMessage = null;
    generatedConfigSnippet = null;
    if (string.IsNullOrWhiteSpace(enrolment.AgentIdentifier) || enrolment.OrganisationId <= 0)
    {
      error = "Enter Agent Identifier and select an Organisation before generating a certificate.";
      return;
    }

    generatingCert = true;
    try
    {
      var agentId = enrolment.AgentIdentifier.Trim();
      var password = string.IsNullOrWhiteSpace(certPassword) ? "ChangeThisPassword123!" : certPassword;
      var cert = BuildCertificateArtifacts(agentId, password, enrolment.CertificateNotAfterUtc);

      await Agents.AddTrustedIssuerAsync(new EdgeTrustedIssuerInput { CertificateBase64 = cert.CaBase64 });

      enrolment.CertificateThumbprint = cert.Thumbprint;
      enrolment.CertificateIssuer = cert.Issuer;
      enrolment.CertificateNotAfterUtc = cert.NotAfterUtc;

      var orgId = enrolment.OrganisationId;
      var apiUrl = Config["Api:BaseUrl"] ?? Config["ApiBaseUrl"] ?? "https://localhost:62840/";
      var result = await Agents.RegisterAsync(enrolment);
      if (!result.Success)
      {
        error = result.Message;
        return;
      }

      var base64Pfx = Convert.ToBase64String(cert.PfxBytes);
      await JS.InvokeVoidAsync("eval", $@"(function(){{
        const b = atob('{base64Pfx}');
        const a = new Uint8Array(b.length);
        for (let i = 0; i < b.length; i++) a[i] = b.charCodeAt(i);
        const url = URL.createObjectURL(new Blob([a], {{type:'application/x-pkcs12'}}));
        const link = document.createElement('a');
        link.href = url; link.download = '{cert.FileName}';
        document.body.appendChild(link); link.click(); link.remove();
        URL.revokeObjectURL(url);
      }})();");

      generatedConfigSnippet = $"{{\n  \"AttendanceEdge\": {{\n    \"AgentId\": \"{agentId}\",\n    \"OrganisationId\": \"{orgId}\",\n    \"ApiBaseUrl\": \"{apiUrl}\",\n    \"ClientCertificatePath\": \"./certs/{cert.FileName}\",\n    \"ClientCertificatePassword\": \"{password}\",\n    \"PollSeconds\": 30,\n    \"Devices\": [\n      {{ \"DeviceId\": \"device-1\", \"Adapter\": \"zkteco\", \"Host\": \"127.0.0.1\", \"Port\": 4370 }}\n    ]\n  }}\n}}";
      successMessage = $"Generated certificate {cert.Thumbprint} and enrolled agent '{agentId}'.";
      enrolment = new() { CertificateNotAfterUtc = DateTime.UtcNow.AddYears(1) };
      pendingPfxBytes = null;
      pendingCaBase64 = null;
      pendingFileName = null;
      await LoadAsync();
    }
    catch (Exception ex)
    {
      error = $"Could not generate certificate: {ex.Message}";
    }
    finally
    {
      generatingCert = false;
    }
  }

  private async Task EnrolAsync()
  {
    enrolment.CertificateNotAfterUtc = enrolment.CertificateNotAfterUtc.ToUniversalTime();
    var result = await Agents.RegisterAsync(enrolment);
    if (!result.Success)
    {
      error = result.Message;
      return;
    }
    enrolment = new() { CertificateNotAfterUtc = DateTime.UtcNow.AddYears(1) };
    await LoadAsync();
  }

  private async Task RevokeAsync(int id)
  {
    var result = await Agents.RevokeAsync(id);
    if (!result.Success)
    {
      error = result.Message;
      return;
    }
    await LoadAsync();
  }

  private void StartAddDevice() => editing = new()
  {
    AttendanceDeviceId = 0,
    OrganisationId = selectedFilterOrgId > 0
      ? selectedFilterOrgId
      : (enrolment.OrganisationId > 0 ? enrolment.OrganisationId : (organisations.FirstOrDefault()?.Id ?? 0)),
    IpAddress = "127.0.0.1",
    Port = 4370,
    Location = "Virtual Biometric Device",
    AdapterType = "zkteco",
    IsEdgeEnabled = true
  };

  private void OpenAddDeviceFromHeader()
  {
    activeTab = "devices";
    StartAddDevice();
  }

  private async Task SetActiveTabAsync(string tab)
  {
    activeTab = tab;
    if (tab == "mapping" && staffDirectory.Count == 0)
    {
      await LoadStaffDirectoryAsync();
    }
  }

  private async Task SetMappingFilterAsync(string filter)
  {
    mappingFilter = filter;
    if (filter != "unmapped" && staffDirectory.Count == 0)
    {
      await LoadStaffDirectoryAsync();
    }
  }

  private async Task OnFilterOrgChangedAsync(ChangeEventArgs e)
  {
    selectedFilterOrgId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    if (selectedFilterOrgId > 0)
    {
      enrolment.OrganisationId = selectedFilterOrgId;
      mappingOrgId = selectedFilterOrgId;
      if (activeTab == "mapping" && mappingFilter != "unmapped")
      {
        await LoadStaffDirectoryAsync();
      }
    }
  }

  private async Task OnMappingOrgChangedAsync(ChangeEventArgs e)
  {
    mappingOrgId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    editingEnrollment = null;
    await LoadStaffDirectoryAsync();
  }

  private async Task LoadStaffDirectoryAsync()
  {
    if (mappingOrgId <= 0)
    {
      mappingOrgId = selectedFilterOrgId > 0
        ? selectedFilterOrgId
        : (currentUserOrgId > 0 ? currentUserOrgId : (organisations.FirstOrDefault()?.Id ?? 0));
    }
    if (mappingOrgId <= 0) return;

    loadingDirectory = true;
    try
    {
      staffDirectory = (await Agents.SearchStaffAsync(new EdgeStaffSearchInput
      {
        OrganisationId = mappingOrgId,
        Query = string.IsNullOrWhiteSpace(mappingSearchQuery) ? null : mappingSearchQuery.Trim()
      })).ToList();

      try
      {
        var userSettings = await UserSettings.LoadAsync(UserSettingsTab.Enrollment);
        currentUserOrgId = userSettings.UserOrganisationId;
        orgEnrollments = userSettings.Enrollments ?? [];
      }
      catch
      {
        // Ignore if user lacks UserSettings permission; SearchStaffAsync still shows CurrentEnrollmentNumber
      }
    }
    catch (Exception ex)
    {
      error = $"Failed to load staff directory: {ex.Message}";
    }
    finally
    {
      loadingDirectory = false;
    }
  }

  private void StartEditEnrollment(EdgeStaffOptionDto staff)
  {
    var existing = orgEnrollments.FirstOrDefault(e => e.IndividualId == staff.IndividualId);
    editingEnrollment = new ManagedEnrollmentDto
    {
      Id = existing?.Id ?? 0,
      IndividualId = staff.IndividualId,
      Name = staff.FullName,
      Number = existing?.Number ?? staff.CurrentEnrollmentNumber ?? ""
    };
  }

  private async Task SaveStaffEnrollmentAsync()
  {
    if (editingEnrollment is null) return;
    savingEnrollment = true;
    error = null;
    successMessage = null;
    try
    {
      var result = await UserSettings.SaveEnrollmentAsync(editingEnrollment);
      if (!result.Success)
      {
        error = result.Message;
        return;
      }
      successMessage = $"Saved badge #{editingEnrollment.Number} for {editingEnrollment.Name}.";
      editingEnrollment = null;
      await Agents.ReevaluatePendingReceiptsAsync(new EdgeReconciliationFilterInput { OrganisationId = mappingOrgId > 0 ? mappingOrgId : null });
      await LoadAsync();
      await LoadStaffDirectoryAsync();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      savingEnrollment = false;
    }
  }

  private void Edit(EdgeAttendanceDeviceDto device) => editing = new()
  {
    AttendanceDeviceId = device.Id,
    OrganisationId = device.OrganisationId ?? 0,
    EdgeAttendanceAgentId = device.AgentId,
    AdapterType = device.AdapterType ?? "zkteco",
    IsEdgeEnabled = device.IsEdgeEnabled
  };

  private async Task SaveDeviceAsync()
  {
    if (editing is null) return;
    var result = await Agents.SaveDeviceConfigurationAsync(editing);
    if (!result.Success)
    {
      error = result.Message;
      return;
    }
    editing = null;
    await LoadAsync();
  }

  private async Task GenerateActivationCodeAsync()
  {
    error = null;
    successMessage = null;
    if (newActivationInput.OrganisationId <= 0)
    {
      error = "Please select an organisation before generating an activation code.";
      return;
    }
    creatingCode = true;
    try
    {
      lastCreatedCode = await Agents.CreateActivationCodeAsync(newActivationInput);
      successMessage = $"One-time activation code generated (expires {lastCreatedCode.ExpiresAtUtc:HH:mm} UTC).";
      activationCodes = (await Agents.ListActivationCodesAsync()).ToList();
    }
    catch (Exception ex)
    {
      error = $"Failed to create activation code: {ex.Message}";
    }
    finally
    {
      creatingCode = false;
    }
  }

  private async Task RevokeActivationCodeAsync(int id)
  {
    error = null;
    var res = await Agents.RevokeActivationCodeAsync(id);
    if (!res.Success) { error = res.Message; return; }
    successMessage = res.Message;
    activationCodes = (await Agents.ListActivationCodesAsync()).ToList();
  }

  private async Task QueueCommandAsync()
  {
    error = null;
    if (commandAgentId <= 0)
    {
      error = "Select an active connector first.";
      return;
    }
    var res = await Agents.QueueCommandAsync(new QueueConnectorCommandInput
    {
      EdgeAttendanceAgentId = commandAgentId,
      CommandType = commandType
    });
    if (!res.Success) { error = res.Message; return; }
    successMessage = res.Message;
    connectorCommands = (await Agents.ListCommandsAsync()).ToList();
  }
}
