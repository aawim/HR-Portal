@page "/admin/settings/edge-agents"
@attribute [Authorize]
@using HRM.DTOs.EdgeAttendance
@inject HRM.Services.Contracts.EdgeAgentManagementContracts.IOperations Agents
@rendermode InteractiveServer
<PageTitle>Edge Agent Management</PageTitle>
<section class="w-full min-w-0 p-2 space-y-4">
  <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 px-3 py-3 shadow-xs"><div class="flex items-center justify-between"><div><h1 class="text-lg font-bold text-slate-900">Attendance Edge Agents</h1><p class="text-xs text-slate-500">MDS-managed machine identities and device bindings.</p></div><button class="app-button app-button-secondary app-button-sm" @onclick="LoadAsync">Refresh</button></div></header>
  @if (error is not null) { <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">@error</div> }
  else if (loading) { <div class="rounded-xl border border-slate-200 bg-white p-6 text-xs text-slate-500">Loading registered agents...</div> }
  else {
    <div class="overflow-x-auto rounded-xl border border-slate-200"><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 bg-slate-50 text-slate-700"><tr><th class="p-2.5">Agent</th><th class="p-2.5">Certificate</th><th class="p-2.5">Health</th><th class="p-2.5">Devices</th><th class="p-2.5">Failures</th><th class="p-2.5">Status</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var agent in agents) { <tr><td class="p-2.5 font-semibold">@agent.AgentIdentifier<br/><span class="font-normal text-slate-500">Organisation #@agent.OrganisationId</span></td><td class="p-2.5 font-mono text-[11px] text-blue-700">@agent.Thumbprint<br/><span class="font-sans text-slate-500">Expires @agent.ExpiresUtc.ToString("yyyy-MM-dd")</span></td><td class="p-2.5">@(agent.HealthStatus ?? "No contact")<br/><span class="text-slate-500">@agent.LastSeenUtc?.ToString("u")</span></td><td class="p-2.5">@agent.DeviceCount</td><td class="p-2.5">@agent.FailureCount</td><td class="p-2.5"><span class="@(agent.IsActive ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800") rounded-full px-2.5 py-0.5 font-semibold">@(agent.IsActive ? "Active" : "Revoked")</span></td></tr> }</tbody></table></div>
    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-3"><h2 class="text-sm font-bold text-slate-800">Enrol agent</h2><p class="text-xs text-slate-500">Only configured devices in the selected organisation can be bound. Certificate trust remains fail-closed until PKI is configured.</p><div class="mt-3 grid gap-3 md:grid-cols-4"><label class="text-xs text-slate-700">Agent identifier<input class="app-input mt-1 w-full" @bind="enrolment.AgentIdentifier" /></label><label class="text-xs text-slate-700">Organisation ID<input class="app-input mt-1 w-full" type="number" @bind="enrolment.OrganisationId" /></label><label class="text-xs text-slate-700">Certificate thumbprint<input class="app-input mt-1 w-full" @bind="enrolment.CertificateThumbprint" /></label><label class="text-xs text-slate-700">Certificate issuer<input class="app-input mt-1 w-full" @bind="enrolment.CertificateIssuer" /></label><label class="text-xs text-slate-700">Certificate expiry<input class="app-input mt-1 w-full" type="date" @bind="enrolment.CertificateNotAfterUtc" /></label></div><div class="mt-3 grid gap-2 md:grid-cols-3">@foreach(var device in devices.Where(x=>x.OrganisationId==enrolment.OrganisationId && !x.AgentId.HasValue)){<label class="flex items-center gap-2 rounded border border-slate-200 px-2 py-1 text-xs"><input type="checkbox" checked="@enrolment.AttendanceDeviceIds.Contains(device.Id)" @onchange="()=>ToggleDevice(device.Id)" />@device.IpAddress:@device.Port — @(device.Location ?? "Device #" + device.Id)</label>}</div><button class="app-button app-button-primary app-button-sm mt-3" @onclick="EnrolAsync">Enrol selected devices</button></div>
    <div class="mt-2 flex flex-wrap gap-2">@foreach(var agent in agents.Where(x=>x.IsActive)){<button class="app-button app-button-danger app-button-sm" @onclick="()=>RevokeAsync(agent.Id)">Revoke @agent.AgentIdentifier</button>}</div>
    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-3"><h2 class="text-sm font-bold text-slate-800">Trusted PKI roots</h2><p class="text-xs text-slate-500">Paste a Base64-encoded, self-signed CA root certificate. This immediately enables only chains signed by an active trusted root.</p><textarea class="app-input mt-2 min-h-20 w-full" @bind="issuerInput.CertificateBase64" placeholder="Base64 CA certificate"></textarea><button class="app-button app-button-primary app-button-sm mt-2" @onclick="AddIssuerAsync">Add trusted root</button><div class="mt-3 space-y-1">@foreach(var issuer in trustedIssuers){<div class="flex items-center justify-between rounded border border-slate-200 p-2 text-xs"><span><strong>@issuer.Subject</strong><br/><span class="font-mono text-slate-500">@issuer.Thumbprint</span></span><button class="app-button app-button-danger app-button-sm" disabled="@(!issuer.IsActive)" @onclick="()=>RevokeIssuerAsync(issuer.Id)">@(issuer.IsActive ? "Revoke" : "Revoked")</button></div>}</div></div>
    <div class="mt-4 rounded-xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-3 py-2"><h2 class="text-sm font-bold text-slate-800">Organisation devices</h2><p class="text-xs text-slate-500">Configure each existing device once; one agent can securely manage many devices in its organisation.</p></div><div class="overflow-x-auto"><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 bg-slate-50 text-slate-700"><tr><th class="p-2.5">Device</th><th class="p-2.5">Current binding</th><th class="p-2.5">Adapter</th><th class="p-2.5">Edge</th><th class="p-2.5"></th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var device in devices) { <tr><td class="p-2.5 font-mono">@device.IpAddress:@device.Port<br/><span class="font-sans text-slate-500">@(device.Location ?? "No location") · #@device.Id</span></td><td class="p-2.5">Organisation #@(device.OrganisationId?.ToString() ?? "Not assigned")<br/><span class="text-slate-500">Agent #@(device.AgentId?.ToString() ?? "Not bound")</span></td><td class="p-2.5">@(device.AdapterType ?? "Vendor adapter pending")</td><td class="p-2.5">@(device.IsEdgeEnabled ? "Enabled" : "Disabled")</td><td class="p-2.5"><button class="app-button app-button-secondary app-button-sm" @onclick="()=>Edit(device)">Configure</button></td></tr> }</tbody></table></div></div>
    @if (editing is not null) { <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-3"><h2 class="text-sm font-bold text-slate-800">Configure device #@editing.AttendanceDeviceId</h2><div class="mt-3 grid gap-3 md:grid-cols-4"><label class="text-xs text-slate-700">Organisation ID<input class="app-input mt-1 w-full" type="number" @bind="editing.OrganisationId" /></label><label class="text-xs text-slate-700">Agent<select class="app-input mt-1 w-full" @bind="editing.EdgeAttendanceAgentId"><option value="">Not bound</option>@foreach(var agent in agents.Where(x=>x.IsActive && x.OrganisationId==editing.OrganisationId)){<option value="@agent.Id">@agent.AgentIdentifier</option>}</select></label><label class="text-xs text-slate-700">Adapter type<input class="app-input mt-1 w-full" @bind="editing.AdapterType" placeholder="e.g. ZKTeco" /></label><label class="flex items-end gap-2 pb-2 text-xs text-slate-700"><input type="checkbox" @bind="editing.IsEdgeEnabled" /> Enable edge ingestion</label></div><div class="mt-3 flex gap-2"><button class="app-button app-button-primary app-button-sm" @onclick="SaveDeviceAsync">Save configuration</button><button class="app-button app-button-secondary app-button-sm" @onclick="()=>editing=null">Cancel</button></div></div> }
    <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-3 py-2"><h2 class="text-sm font-bold text-slate-800">Recent ingestion failures</h2></div><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 bg-slate-50 text-slate-700"><tr><th class="p-2.5">Time</th><th class="p-2.5">Agent / device</th><th class="p-2.5">Reason</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var failure in failures){<tr><td class="p-2.5 text-slate-600">@failure.OccurredAtUtc.ToString("u")</td><td class="p-2.5">Agent #@(failure.AgentId?.ToString() ?? "—") / Device #@(failure.DeviceId?.ToString() ?? "—")</td><td class="p-2.5"><span class="font-semibold text-rose-700">@failure.Code</span><br/><span class="text-slate-600">@failure.Detail</span></td></tr>}</tbody></table></div>
  }
</section>
@code { private bool loading = true; private string? error; private List<EdgeAgentSummaryDto> agents = []; private List<EdgeAttendanceDeviceDto> devices = []; private List<EdgeAttendanceIngestionFailureDto> failures = []; private List<EdgeTrustedIssuerDto> trustedIssuers = []; private EdgeAttendanceDeviceConfigurationInput? editing; private EdgeAgentRegistrationInput enrolment = new() { CertificateNotAfterUtc = DateTime.UtcNow.AddYears(1) }; private EdgeTrustedIssuerInput issuerInput = new(); protected override Task OnInitializedAsync() => LoadAsync(); private async Task LoadAsync() { loading = true; error = null; try { agents = (await Agents.ListAsync()).ToList(); devices = (await Agents.ListDevicesAsync()).ToList(); failures = (await Agents.ListFailuresAsync()).ToList(); trustedIssuers = (await Agents.ListTrustedIssuersAsync()).ToList(); } catch (UnauthorizedAccessException) { error = "You do not have permission to manage Edge Agents."; } catch { error = "Agent data could not be loaded."; } finally { loading = false; } } private async Task AddIssuerAsync() { var result = await Agents.AddTrustedIssuerAsync(issuerInput); if (!result.Success) { error = result.Message; return; } issuerInput = new(); await LoadAsync(); } private async Task RevokeIssuerAsync(int id) { var result = await Agents.RevokeTrustedIssuerAsync(id); if (!result.Success) { error = result.Message; return; } await LoadAsync(); } private void ToggleDevice(int id) { if (!enrolment.AttendanceDeviceIds.Remove(id)) enrolment.AttendanceDeviceIds.Add(id); } private async Task EnrolAsync() { enrolment.CertificateNotAfterUtc = enrolment.CertificateNotAfterUtc.ToUniversalTime(); var result = await Agents.RegisterAsync(enrolment); if (!result.Success) { error = result.Message; return; } enrolment = new() { CertificateNotAfterUtc = DateTime.UtcNow.AddYears(1) }; await LoadAsync(); } private async Task RevokeAsync(int id) { var result = await Agents.RevokeAsync(id); if (!result.Success) { error = result.Message; return; } await LoadAsync(); } private void Edit(EdgeAttendanceDeviceDto device) => editing = new() { AttendanceDeviceId = device.Id, OrganisationId = device.OrganisationId ?? 0, EdgeAttendanceAgentId = device.AgentId, AdapterType = device.AdapterType, IsEdgeEnabled = device.IsEdgeEnabled }; private async Task SaveDeviceAsync() { if (editing is null) return; var result = await Agents.SaveDeviceConfigurationAsync(editing); if (!result.Success) { error = result.Message; return; } editing = null; await LoadAsync(); } }
