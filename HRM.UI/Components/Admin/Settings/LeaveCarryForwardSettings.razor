@page "/admin/settings/leaves/carry-forward"
@attribute [Authorize]
@rendermode InteractiveServer
@using HRM.Services.Leave
@using HRM.Models.LeaveTypes
@inject HRM.Services.Leave.Contracts.LeaveCarryForwardServiceContracts.IOperations Service
@inject ILogger<LeaveCarryForwardSettings> Logger
@inject HRM.Services.Interfaces.IUserAccessService UserAccess

<PageTitle>Leave carry forward</PageTitle>
<div class="mx-auto max-w-6xl space-y-4 p-4">
    <a href="/admin/settings/leaves" class="underline">Back to Leaves Management</a>
    <h1 class="text-2xl font-semibold">Leave carry forward</h1>
    <p>Leave must be used by the last day of the staff member's contract year. At the anniversary, HR can carry unused days into the next contract year within the Job Type policy. Contract and Temporary staff continue earning 2.5 days per completed month when configured; their 30-day yearly entitlement is earned monthly. Earlier due accruals must be processed first.</p>
    @if (message != null) { <p role="status" class="rounded border p-3">@message</p> }
    <button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Refresh</button>
    @if (loaded)
    {
        <h2 class="text-lg font-semibold">Awaiting HR review (@pending.Count)</h2>
        @if (pending.Count == 0) { <p>No eligible renewals await review. Only enabled, configured accrual rules are included.</p> }
        <div class="overflow-x-auto rounded border">
            <table class="w-full text-left text-sm"><thead><tr><th class="p-3">Staff</th><th class="p-3">Leave</th><th class="p-3">Closing contract year</th><th class="p-3">Renewal</th><th class="p-3">Unused days</th><th class="p-3">Policy maximum</th><th class="p-3">Action</th></tr></thead><tbody>
            @foreach (var row in pending)
            {
                <tr class="border-t"><td class="p-3">@row.Staff</td><td class="p-3">@row.LeaveType</td><td class="p-3">@row.PeriodStart.ToString("dd MMM yyyy") – @row.PeriodEnd.ToString("dd MMM yyyy")</td><td class="p-3">@row.RenewalDate.ToString("dd MMM yyyy")</td><td class="p-3">@row.UnusedBalance.ToString("0.##")</td><td class="p-3">@row.SuggestedDays.ToString("0.##")</td><td class="p-3">@if (canProcess) { <button class="app-button app-button-secondary" disabled="@busy" @onclick="() => Select(row)">Review</button> }</td></tr>
            }
            </tbody></table>
        </div>
        @if (selected != null)
        {
            <fieldset disabled="@busy" class="space-y-3 rounded border p-4">
                <legend>Review @selected.Staff · @selected.RenewalDate.ToString("dd MMM yyyy")</legend>
                <label class="block">Days to carry<input class="ml-2 rounded border p-2" type="number" min="0" max="@selected.SuggestedDays" step="0.01" @bind="days" /></label>
                <label class="block">Reason<textarea class="mt-1 block w-full rounded border p-2" maxlength="1000" @bind="reason"></textarea></label>
                <p>Contract year: @selected.PeriodStart.ToString("dd MMM yyyy") through @selected.PeriodEnd.ToString("dd MMM yyyy"). Use-by date: @selected.PeriodEnd.ToString("dd MMM yyyy").</p>
                <p>Recorded balance: @selected.Balance.ToString("0.##") · Final completed-period credit: @selected.ClosingGrant.ToString("0.##") · Unused days: @selected.UnusedBalance.ToString("0.##").</p>
                <p>Carry into next year: @days.ToString("0.##") · Days removed: @((selected.UnusedBalance - days).ToString("0.##")) · New-year grant at renewal: @selected.RenewalGrantFor(days).ToString("0.##") · New balance: @((days + selected.RenewalGrantFor(days)).ToString("0.##")).</p>
                <p>Next year's configured entitlement rate: @selected.AnnualEntitlement.ToString("0.##") days per year · @selected.AccrualDescription. Monthly entitlement is earned throughout the new contract year.</p>
                <div class="flex flex-wrap gap-2"><button class="app-button app-button-primary" @onclick="ProcessAsync">Process carry forward</button><button class="app-button app-button-secondary" @onclick="() => selected = null">Close</button></div>
            </fieldset>
        }
        <h2 class="text-lg font-semibold">Recent carry-forward history</h2>
        <div class="overflow-x-auto rounded border"><table class="w-full text-left text-sm"><thead><tr><th class="p-3">Job</th><th class="p-3">Contract year / renewal</th><th class="p-3">Unused</th><th class="p-3">Carried</th><th class="p-3">New-year grant</th><th class="p-3">New balance</th><th class="p-3">Processed by</th><th class="p-3">Reason</th></tr></thead><tbody>
        @foreach (var row in history)
        {
            <tr class="border-t"><td class="p-3">@row.JobId</td><td class="p-3">@if (row.PeriodStart.HasValue) { <div>@row.PeriodStart.Value.ToString("dd MMM yyyy") – @row.PeriodEnd?.ToString("dd MMM yyyy")</div> }<div>Renewal: @row.RenewalDate.ToString("dd MMM yyyy")</div></td><td class="p-3">@row.PreviousBalance.ToString("0.##")</td><td class="p-3">@row.CarriedDays.ToString("0.##")</td><td class="p-3">@(row.RenewalGrant?.ToString("0.##") ?? "—")</td><td class="p-3">@(row.NewBalance?.ToString("0.##") ?? "—")</td><td class="p-3">User #@row.ProcessedByUserId · @row.ProcessedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm")</td><td class="p-3">@row.Reason</td></tr>
        }
        </tbody></table></div>
    }
</div>
@code {
    private List<CarryForwardReview> pending = new();
    private List<HRM.DTOs.Contracts.LeaveCarryForwardDto> history = new();
    private CarryForwardReview? selected;
    private decimal days;
    private string reason = "";
    private string? message;
    private bool busy, loaded, canProcess;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private void Select(CarryForwardReview row) { selected = row; days = row.SuggestedDays; reason = ""; }
    private async Task LoadAsync()
    {
        busy = true; selected = null;
        try { pending = await Service.PendingAsync(); history = await Service.HistoryAsync(); canProcess = await UserAccess.HasPermissionAsync(LeaveCarryForwardPermissions.Process); loaded = true; }
        catch (Exception ex) { Logger.LogError(ex, "Loading carry-forward"); message = ex is UnauthorizedAccessException ? ex.Message : "Carry-forward could not be loaded. Please try again."; loaded = false; }
        finally { busy = false; }
    }
    private async Task ProcessAsync()
    {
        if (selected == null || busy) return;
        busy = true;
        try { await Service.ProcessAsync(selected, days, reason); message = "Carry-forward and the renewal balance have been recorded. Future accruals continue under the configured schedule."; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Processing carry-forward"); message = ex is InvalidOperationException or UnauthorizedAccessException ? ex.Message : "Carry-forward could not be processed. Refresh before retrying."; }
        finally { busy = false; }
    }
}
