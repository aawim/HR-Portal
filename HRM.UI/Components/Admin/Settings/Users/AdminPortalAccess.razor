@page "/admin/settings/admin-access"
@using HRM.Services
@using HRM.DTOs
@using HRM.Helpers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HRM.Services.Contracts.AdminAccessGrantServiceContracts.IOperations Grants
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Portal Access</PageTitle>

<section class="w-full min-w-0 p-2 flex flex-col gap-2">
    <!-- Section Header matching UI Design Standard -->
    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800 flex-wrap gap-2">
        <div>
            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <span>Portal Access</span>
                @if (data != null)
                {
                    <span class="rounded-full border px-2 py-0.5 text-[10px] font-semibold @(IsSuperAdminContext ? "" : "bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border-teal-200 dark:border-teal-800/40")"
                          style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)">
                        @FilteredRequests.Count() requests
                    </span>
                }
            </h2>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Select an employee and a single portal from the dropdown to grant or revoke access. Users can hold multiple portals, granted one portal at a time.</p>
        </div>
        <div class="flex items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(EffectiveReturnUrl))
            {
                <a href="@EffectiveReturnUrl"
                   class="app-button app-button-secondary app-button-sm">
                    <AppIcon Name="arrow_back" />
                    <span>Back to Staff Transfer</span>
                </a>
            }
            <button type="button"
                    @onclick="Refresh"
                    disabled="@busy"
                    class="app-button app-button-secondary app-button-sm">
                <AppIcon Name="arrow-clockwise" />
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div role="alert" class="rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2 text-xs text-rose-800 dark:text-rose-300">
            @message
        </div>
    }

    @if (data == null && string.IsNullOrEmpty(message))
    {
        <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            Loading admin portal access…
        </div>
    }

    @if (data != null)
    {
        <div class="rounded-xl border border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30 p-2 flex flex-wrap items-center justify-between gap-2 text-xs text-teal-900 dark:text-teal-200">
            @if (data.IsSuperAdmin)
            {
                <label class="flex flex-wrap items-center gap-2 font-semibold">
                    <span>Organisation</span>
                    <select class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-normal text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                            value="@data.OrganisationId"
                            @onchange="ChangeOrganisation"
                            disabled="@busy">
                        @foreach (var org in data.Organisations)
                        {
                            <option value="@org.Id">@org.Name</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <span><strong>Organisation:</strong> @data.Organisations.FirstOrDefault()?.Name</span>
            }
            <div class="flex flex-wrap items-center gap-2">
                @if (IsSuperAdminContext)
                {
                    <a class="app-button app-button-secondary app-button-sm" href="/superadmin/permissions">Manage organisation permissions</a>
                }
                else
                {
                    <a class="app-button app-button-secondary app-button-sm" href="/admin/settings/organisation-permissions">Manage organisation permissions</a>
                    <a class="app-button app-button-secondary app-button-sm" href="/admin/settings/config/approval-flows">Configure approval flows</a>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 gap-2 xl:grid-cols-12 items-start">
            @if (data.CanManage)
            {
                <section class="min-w-0 xl:col-span-7 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 p-2">
                        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">Grant or Revoke Portal Access</h3>
                        @if (selected > 0)
                        {
                            <span class="rounded bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/40 px-1.5 py-0.5 text-[10px] font-semibold text-amber-700 dark:text-amber-300">
                                Account #@selected
                            </span>
                        }
                    </div>

                    <div class="p-2 flex flex-col gap-2">
                        <!-- Single-Select Portal Dropdown (One Portal at a Time) -->
                        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
                            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1 flex-1">
                                Target Portal (grant one portal at a time)
                                <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                        @bind="selectedPortal"
                                        disabled="@busy">
                                    <option value="Admin">Admin Portal (Organisation HR &amp; Management)</option>
                                    <option value="Developer">Developer Portal (Workflows, Logs &amp; Diagnostics)</option>
                                    @if (data.IsSuperAdmin)
                                    {
                                        <option value="SuperAdmin">SuperAdmin Portal (Platform Configuration)</option>
                                    }
                                </select>
                            </label>
                            <span class="text-[11px] text-slate-500 dark:text-slate-400 px-1 pb-1.5">
                                Online (Self) portal is enabled by default for active staff.
                            </span>
                        </div>

                        <fieldset disabled="@busy" class="flex flex-col gap-2">
                            <legend class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 p-1">Find employee (single selection)</legend>
                            @if (EffectiveStaffId > 0)
                            {
                                @if (SelectedAccount is { } lockedAccount)
                                {
                                    <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-teal-200 bg-teal-50/60 p-2">
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="text-xs font-semibold text-slate-900">@lockedAccount.Name</span>
                                                <span class="rounded bg-teal-100 px-2 py-0.5 text-[10px] font-bold uppercase text-teal-800">Locked for Staff Transfer</span>
                                            </div>
                                            <div class="mt-1 flex flex-wrap items-center gap-1">
                                                <span class="rounded-full bg-blue-100 text-blue-800 px-2 py-0.5 text-[10px] font-semibold">Online</span>
                                                @if (lockedAccount.Enabled) { <span class="rounded-full bg-teal-100 text-teal-800 px-2 py-0.5 text-[10px] font-semibold">Admin</span> }
                                                @if (lockedAccount.HasDeveloperAccess) { <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-semibold">Developer</span> }
                                                @if (lockedAccount.HasSuperAdminAccess) { <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold" style="background-color:#ADD8E6; color:#0f172a;">SuperAdmin</span> }
                                            </div>
                                        </div>
                                        <span class="text-[11px] font-medium text-slate-500">Selection locked to transfer subject</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-2 text-xs text-amber-800">
                                        Staff member #@EffectiveStaffId does not have an active user account in @(data.Organisations.FirstOrDefault(o => o.Id == data.OrganisationId)?.Name ?? "this organisation").
                                    </div>
                                }
                            }
                            else
                            {
                                <HRM.Components.Admin.My.Workspace.WorkspaceSearch @key="data.OrganisationId"
                                    StaffOnly="true" RequireActivePosition="true" OrganisationId="data.OrganisationId" AllowedStaffIds="AccountStaffIds" OnSelected="SelectEmployee" />
                                <p class="text-[11px] text-slate-500 dark:text-slate-400">Search by name or national ID. Only one employee can be selected at a time.</p>
                                @if (SelectedAccount is { } account)
                                {
                                    <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-2">
                                        <div>
                                            <p class="text-xs font-semibold text-slate-900 dark:text-slate-100">@account.Name</p>
                                            <div class="mt-1 flex flex-wrap items-center gap-1">
                                                <span class="text-[10px] text-slate-500 mr-0.5">Active portals:</span>
                                                <span class="rounded-full bg-blue-100 text-blue-800 px-2 py-0.5 text-[10px] font-semibold">Online</span>
                                                @if (account.Enabled) { <span class="rounded-full bg-teal-100 text-teal-800 px-2 py-0.5 text-[10px] font-semibold">Admin</span> }
                                                @if (account.HasDeveloperAccess) { <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-[10px] font-semibold">Developer</span> }
                                                @if (account.HasSuperAdminAccess) { <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold" style="background-color:#ADD8E6; color:#0f172a;">SuperAdmin</span> }
                                            </div>
                                        </div>
                                        <button type="button"
                                                class="app-button app-button-secondary app-button-sm"
                                                @onclick="ClearAccount">
                                            Clear selection
                                        </button>
                                    </div>
                                }
                            }
                        </fieldset>

                        @if (selectedPortal == "Admin")
                        {
                            <!-- Effective Admin Access Summary -->
                            <div class="rounded-xl border p-2.5 flex flex-col gap-1.5 @(IsSuperAdminContext ? "" : "border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30")"
                                 style="@(IsSuperAdminContext ? "background-color: #eef8fc; border-color: #ADD8E6; color: #0f172a;" : null)">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <span class="text-[11px] font-bold text-slate-800 dark:text-slate-100">Effective Admin Access</span>
                                    <div class="flex flex-wrap items-center gap-1.5 text-[10px] font-semibold">
                                        <span class="rounded-full bg-white/80 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-slate-700 dark:text-slate-200">@groups.Count roles</span>
                                        <span class="rounded-full bg-white/80 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-slate-700 dark:text-slate-200">@EffectiveAdminModules.Count modules</span>
                                        @if (permissions.Count > 0)
                                        {
                                            <span class="rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200 px-2 py-0.5">@permissions.Count direct exceptions</span>
                                        }
                                    </div>
                                </div>
                                @if (EffectiveAdminModules.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var mod in EffectiveAdminModules)
                                        {
                                            <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-medium text-slate-700 dark:text-slate-200">@mod</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Assign one or more roles below to grant access to HR modules.</p>
                                }
                            </div>

                            <!-- Assigned Roles -->
                            <fieldset class="rounded-xl border border-slate-200 dark:border-slate-800 p-2">
                                <legend class="px-1 text-[11px] font-bold text-slate-700 dark:text-slate-300">Assigned Roles</legend>
                                <div class="grid max-h-64 grid-cols-1 gap-1.5 overflow-auto md:grid-cols-2">
                                    @foreach (var group in data.Groups)
                                    {
                                        var enabledCount = group.PermissionIds.Count(id => data.OrganisationPermissionIds.Contains(id));
                                        <label class="flex items-start gap-2 rounded-lg border border-slate-200/80 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-2 text-xs text-slate-800 dark:text-slate-100 cursor-pointer hover:border-teal-400 transition">
                                            <input type="checkbox" class="mt-0.5 accent-teal-700" checked="@groups.Contains(group.Id)" disabled="@busy" @onchange="e => Toggle(groups, group.Id, e)" />
                                            <span class="min-w-0">
                                                <span class="block font-semibold text-slate-800 dark:text-slate-100">@group.Name</span>
                                                <span class="block text-[10px] text-slate-500 dark:text-slate-400">@enabledCount enabled permissions</span>
                                            </span>
                                        </label>
                                    }
                                    @if (data.Groups.Count == 0)
                                    {
                                        <p class="text-xs text-slate-500">No roles configured for this organisation.</p>
                                    }
                                </div>
                            </fieldset>

                            <!-- Collapsible Advanced: Direct Permission Exceptions -->
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
                                <button type="button"
                                        class="w-full flex items-center justify-between gap-2 bg-slate-50/70 dark:bg-slate-800/40 px-3 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100/70 dark:hover:bg-slate-800/70 transition"
                                        @onclick="() => showDirectPermissions = !showDirectPermissions">
                                    <span class="flex items-center gap-1.5">
                                        <i class="bi @(showDirectPermissions ? "bi-chevron-down" : "bi-chevron-right") text-[11px] text-slate-500"></i>
                                        <span>Advanced: Direct Permission Exceptions</span>
                                    </span>
                                    <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400">@permissions.Count direct · @GroupPermissions.Count via roles</span>
                                </button>
                                @if (showDirectPermissions)
                                {
                                    <div class="p-2 flex flex-col gap-2 border-t border-slate-200 dark:border-slate-800">
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Use direct permissions only for rare one-off exceptions. Permissions from assigned roles are checked automatically.</p>
                                        <input type="search"
                                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                               placeholder="Search individual permissions…"
                                               @bind="search"
                                               @bind:event="oninput" />
                                        <div class="max-h-56 overflow-auto flex flex-col gap-1.5">
                                            @foreach (var permission in data.Permissions.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                var inherited = GroupPermissions.Contains(permission.Id);
                                                var available = data.OrganisationPermissionIds.Contains(permission.Id);
                                                <label class="flex items-center gap-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 p-1.5 text-xs text-slate-800 dark:text-slate-100 @(available && !inherited ? "cursor-pointer hover:bg-teal-50/50" : "opacity-75")">
                                                    <input type="checkbox" class="accent-teal-700" checked="@(available && (inherited || permissions.Contains(permission.Id)))" disabled="@(busy || inherited || !available)" @onchange="e => Toggle(permissions, permission.Id, e)" />
                                                    <span class="min-w-0">
                                                        <span>@permission.Name</span>
                                                        @if (!available) { <span class="ml-1 text-[10px] text-slate-500">(Not enabled for organisation)</span> }
                                                        @if (inherited) { <span class="ml-1 text-[10px] text-teal-700 font-medium">(Role)</span> }
                                                        @if (inherited && permissions.Contains(permission.Id)) { <span class="ml-1 text-[10px] text-slate-500">(also direct)</span> }
                                                    </span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <p class="text-[11px] text-slate-500 dark:text-slate-400">These selections replace the account’s current organisation roles and direct permission exceptions after approval. Global role memberships and organisation defaults remain applicable.</p>
                        }
                        else
                        {
                            <div class="rounded-xl border p-3 text-xs space-y-1"
                                 style="@(selectedPortal == "SuperAdmin" ? "background-color: #eef8fc; border-color: #ADD8E6; color: #0f172a;" : "background-color: #fffbeb; border-color: #fde68a; color: #78350f;")">
                                <p class="font-semibold">@selectedPortal Portal Access</p>
                                <p class="text-[11px]">
                                    @(selectedPortal == "SuperAdmin"
                                        ? "Grants or revokes platform-wide SuperAdmin authority (Super.Admin.Manage) for the selected user. Other portal grants on this user remain preserved."
                                        : "Grants or revokes Developer Portal access (workflows, request types, diagnostics, and logs) for the selected user. Other portal grants on this user remain preserved.")
                                </p>
                            </div>
                        }

                        <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 p-1">
                            Reason
                            <textarea rows="2"
                                      class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                      maxlength="1000"
                                      placeholder="Provide a reason for this portal access change…"
                                      @bind="reason"
                                      disabled="@busy"></textarea>
                        </label>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2">
                        @if (selectedPortal == "Admin")
                        {
                            <button type="button"
                                    class="app-button app-button-primary app-button-sm"
                                    disabled="@(busy || selected == 0)"
                                    @onclick="Submit">
                                Submit Admin access for approval
                            </button>
                            <button type="button"
                                    class="app-button app-button-danger app-button-sm"
                                    disabled="@(busy || selected == 0)"
                                    @onclick="Revoke">
                                Revoke Admin access
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="app-button app-button-primary app-button-sm"
                                    disabled="@(busy || selected == 0)"
                                    @onclick="() => SetDirectPortalAccess(true)">
                                Grant @selectedPortal access
                            </button>
                            <button type="button"
                                    class="app-button app-button-danger app-button-sm"
                                    disabled="@(busy || selected == 0)"
                                    @onclick="() => SetDirectPortalAccess(false)">
                                Revoke @selectedPortal access
                            </button>
                        }
                    </div>
                </section>
            }

            <!-- Right: Requests List Card -->
            <section class="min-w-0 @(data.CanManage ? "xl:col-span-5" : "xl:col-span-12") rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 p-2">
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">Admin Access Grant Requests</h3>
                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                        @FilteredRequests.Count()
                    </span>
                </div>
                <div class="p-2 flex flex-col gap-2 max-h-[680px] overflow-y-auto">
                    @if (!FilteredRequests.Any())
                    {
                        <p class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">No access requests found.</p>
                    }
                    @foreach (var request in FilteredRequests)
                    {
                        <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-800/30 p-2 flex flex-col gap-2" @key="request.Id">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-900 dark:text-slate-100">@request.Name <span class="font-mono font-normal text-[11px] text-slate-500">· @request.Reference</span></p>
                                    <p class="text-[11px] text-slate-600 dark:text-slate-400">@request.Status · @request.Stage</p>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(request.Reason))
                            {
                                <p class="text-xs text-slate-700 dark:text-slate-300">@request.Reason</p>
                            }
                            <details class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 text-xs">
                                <summary class="cursor-pointer font-semibold text-slate-700 dark:text-slate-200">Requested assignments and history</summary>
                                <div class="mt-2 flex flex-col gap-1 text-[11px] text-slate-600 dark:text-slate-300">
                                    <p>@request.Assignments</p>
                                    @foreach (var history in request.History)
                                    {
                                        <p class="text-slate-500">@history</p>
                                    }
                                </div>
                            </details>
                            @if (request.CanApprove || request.CanCancel)
                            {
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                    Action comment
                                    <textarea rows="2"
                                              class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                              maxlength="2000"
                                              value="@Comment(request.Id)"
                                              @oninput="e => comments[request.Id] = e.Value?.ToString() ?? string.Empty"
                                              disabled="@busy"></textarea>
                                </label>
                                <div class="flex flex-wrap items-center gap-2">
                                    @if (request.CanApprove)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center gap-1 rounded-lg bg-teal-700 hover:bg-teal-800 text-white px-3 py-1.5 text-xs font-semibold disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick='() => Act(request, "Approve")'>
                                            Approve stage
                                        </button>
                                        <button type="button"
                                                class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick='() => Act(request, "Reject")'>
                                            Reject
                                        </button>
                                    }
                                    @if (request.CanCancel)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center gap-1 rounded-lg border border-rose-300 dark:border-rose-800 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-rose-700 dark:text-rose-300 hover:bg-rose-50 disabled:opacity-50 transition"
                                                disabled="@busy"
                                                @onclick='() => Act(request, "Cancel")'>
                                            Cancel request
                                        </button>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "staffId")]
    public int? StaffId { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private int? EffectiveStaffId => StaffId ?? ParseIntQuery("staffId");
    private string? EffectiveReturnUrl => !string.IsNullOrWhiteSpace(ReturnUrl) ? ReturnUrl : ParseStringQuery("returnUrl");

    private AdminAccessGrantData? data;
    private int selected;
    private string selectedPortal = "Admin";
    private string reason = "", message = "", search = "";
    private bool busy, showDirectPermissions;
    private bool IsSuperAdminContext => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/superadmin", StringComparison.OrdinalIgnoreCase);
    private HashSet<int> groups = [], permissions = [];
    private HashSet<int> GroupPermissions => data?.Groups.Where(g => groups.Contains(g.Id))
        .SelectMany(g => g.PermissionIds).Where(id => data.OrganisationPermissionIds.Contains(id)).ToHashSet() ?? [];
    private List<string> EffectiveAdminModules => data is null
        ? []
        : data.Permissions
            .Where(p => data.OrganisationPermissionIds.Contains(p.Id) && (GroupPermissions.Contains(p.Id) || permissions.Contains(p.Id)))
            .Select(p => AccessControlUiHelper.ResolveModule(p.Name))
            .DistinctBy(m => m.Key)
            .OrderBy(m => AccessControlUiHelper.Modules.ToList().FindIndex(x => x.Key == m.Key))
            .Select(m => m.Label)
            .ToList();
    private Dictionary<int, string> comments = [];

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Refresh() => await Load(data?.OrganisationId);

    private async Task Load(int? org = null)
    {
        try
        {
            data = await Grants.LoadAsync(org);
            var staffId = EffectiveStaffId;
            if (staffId.HasValue && staffId.Value > 0 && data is not null)
            {
                var account = data.Accounts.FirstOrDefault(a => a.IndividualId == staffId.Value);
                if (account is not null)
                {
                    selected = account.Id;
                    groups = account.GroupIds.ToHashSet();
                    permissions = account.PermissionIds.Where(id => data.OrganisationPermissionIds.Contains(id)).ToHashSet();
                    if (string.IsNullOrWhiteSpace(reason))
                    {
                        reason = $"Admin portal access grant review for Staff Transfer (Staff #{staffId.Value})";
                    }
                }
            }
        }
        catch (UnauthorizedAccessException ex) { data = null; message = ex.Message; }
        catch (Exception) { message = "Admin portal access could not be loaded. Please try again."; }
    }

    private int? ParseIntQuery(string key)
    {
        var raw = ParseStringQuery(key);
        return int.TryParse(raw, out var value) ? value : null;
    }

    private string? ParseStringQuery(string key)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (string.IsNullOrEmpty(uri.Query)) return null;
        var pairs = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var pair in pairs)
        {
            var idx = pair.IndexOf('=');
            if (idx <= 0) continue;
            var k = Uri.UnescapeDataString(pair[..idx]);
            if (string.Equals(k, key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[(idx + 1)..].Replace('+', ' '));
        }
        return null;
    }

    private async Task ChangeOrganisation(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var org)) return;
        selected = 0; groups.Clear(); permissions.Clear(); reason = ""; comments.Clear(); message = "";
        await Load(org);
    }

    private IReadOnlyCollection<int> AccountStaffIds => data?.Accounts.Select(a => a.IndividualId).Where(id => id > 0).Distinct().ToArray() ?? [];
    private AdminAccessAccount? SelectedAccount => data?.Accounts.FirstOrDefault(a => a.Id == selected);
    private IEnumerable<AdminAccessGrantRow> FilteredRequests =>
        EffectiveStaffId > 0 && SelectedAccount is not null
            ? (data?.Requests.Where(r => r.Name == SelectedAccount.Name) ?? Enumerable.Empty<AdminAccessGrantRow>())
            : (data?.Requests ?? Enumerable.Empty<AdminAccessGrantRow>());

    private void ClearAccount()
    {
        if (EffectiveStaffId > 0) return;
        selected = 0; groups.Clear(); permissions.Clear(); reason = "";
    }

    private void SelectEmployee(WorkspaceSearchResult staff)
    {
        if (busy || EffectiveStaffId > 0) return;
        var account = data?.Accounts.FirstOrDefault(a => a.IndividualId == staff.IndividualId);
        ClearAccount();
        if (account == null) { message = "This employee does not have an account in the selected organisation."; return; }
        message = "";
        selected = account.Id;
        groups = account.GroupIds.ToHashSet();
        permissions = account.PermissionIds.Where(id => data!.OrganisationPermissionIds.Contains(id)).ToHashSet();
    }

    private static void Toggle(HashSet<int> values, int id, ChangeEventArgs e) { if (e.Value is true) values.Add(id); else values.Remove(id); }
    private string Comment(int id) => comments.GetValueOrDefault(id, "");
    private async Task Submit() => await Execute(() => Grants.SubmitAsync(data!.OrganisationId, selected, groups.ToArray(), permissions.ToArray(), reason));
    private async Task Revoke() => await Execute(() => Grants.RevokeAsync(data!.OrganisationId, selected, reason));
    private async Task SetDirectPortalAccess(bool grant) => await Execute(() => Grants.SetPortalAccessAsync(data!.OrganisationId, selected, selectedPortal, grant, reason));
    private async Task Act(AdminAccessGrantRow row, string action) => await Execute(() => Grants.ActAsync(data!.OrganisationId, row.Id, row.StateId, action, Comment(row.Id)));

    private async Task Execute(Func<Task<ServiceResult>> action)
    {
        if (busy) return;
        busy = true; message = "";
        try
        {
            var result = await action();
            if (result.Success) Toasts.Success(result.Message); else message = result.Message;
            await Load(data?.OrganisationId);
        }
        catch (UnauthorizedAccessException ex) { message = ex.Message; }
        catch (Exception) { message = "The action could not be completed. Refresh and try again."; }
        finally { busy = false; }
    }
}
