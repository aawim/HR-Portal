@using HRM.DTOs
@using HRM.DTOs.Roles
@using HRM.Services
@using HRM.Components.Admin.Settings.Roles
@inject HRM.Services.Contracts.UserSettingsServiceContracts.IOperations Settings
@inject ToastService Toast
@inject ILogger<UserSettingsEditor> Logger

<div class="w-full">
    @if (error != null) { <p role="alert" class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">@error</p> }
    @if (loading) { <p class="rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Loading @Title.ToLowerInvariant()…</p> }
    else if (data != null)
    {
        <fieldset disabled="@busy">
            <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
                <section class="min-w-0 xl:col-span-8">
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
                            <div class="flex items-center gap-3"><div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"><span class="material-symbols-rounded" aria-hidden="true">@Icon</span></div>
                                <div><h2 class="text-sm font-semibold text-slate-900">@Title</h2><p class="mt-0.5 text-xs text-slate-500">@data.OrganisationName</p></div></div>
                            <button type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-600" @onclick="ReloadAsync">Refresh</button>
                        </div>
                        <div class="space-y-5 p-5">
                            @if (Tab is UserSettingsTab.Accounts or UserSettingsTab.Permissions)
                            {
                                @if (user == null) { <p class="py-8 text-center text-sm text-slate-500">Select an account from the list to manage it.</p> }
                                else if (Tab == UserSettingsTab.Accounts)
                                {
                                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                                        <label class="@LabelClass">Username<input readonly class="@InputClass" value="@user.Username" /></label>
                                        <label class="@LabelClass">Full name<input class="@InputClass" maxlength="255" @bind="user.Name" /></label>
                                        <label class="@LabelClass">Email<input type="email" class="@InputClass" maxlength="128" @bind="user.Email" /></label>
                                        <label class="@LabelClass">Mobile<input class="@InputClass" maxlength="20" @bind="user.Mobile" /></label>
                                        <label class="@LabelClass">Account state<select class="@InputClass" @bind="user.StateId">@foreach (var option in data.AccountStates) { <option value="@option.Id">@option.Name</option> }</select></label>
                                        <div class="rounded-lg border border-slate-100 bg-slate-50 p-4 text-sm text-slate-600">Sign-in provider status: @user.SsoStatus</div>
                                        <label class="rounded-lg border border-slate-100 bg-slate-50 p-4 text-sm"><input type="checkbox" @bind="user.Active" /> Active account</label>
                                        <label class="rounded-lg border border-slate-100 bg-slate-50 p-4 text-sm"><input type="checkbox" @bind="user.Approved" /> Approved account</label>
                                    </div>
                                }
                                else
                                {
                                    <h3 class="text-sm font-semibold text-slate-800">@user.Name <span class="font-normal text-slate-500">(@user.Username)</span></h3>
                                    <section class="rounded-xl border border-slate-200 p-4 space-y-3">
                                        <h4 class="text-sm font-semibold text-slate-800">Assigned roles</h4>
                                        <div class="grid max-h-60 grid-cols-1 gap-2 overflow-y-auto md:grid-cols-2">
                                            @foreach (var role in data.Roles)
                                            {
                                                <label class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm"><input type="checkbox" class="mt-1" checked="@user.RoleIds.Contains(role.Id)" @onchange="e => ToggleRole(role.Id, e.Value is true)" /><span>@role.Name<span class="block text-xs text-slate-500">@role.PermissionIds.Count permissions</span></span></label>
                                            }
                                            @if (data.Roles.Count == 0) { <p class="text-sm text-slate-500">No roles are configured for this organisation.</p> }
                                        </div>
                                    </section>
                                    <h4 class="text-sm font-semibold text-slate-800">Direct permissions</h4>
                                    <p class="text-xs text-slate-500">Direct and User Group permissions are limited to permissions enabled for the organisation.</p>
                                    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                                        <PermissionAssignmentColumn @key="(user.Id, true)" Assigned="true" Permissions="data.Permissions.Where(p => user.DirectPermissionIds.Contains(p.Id)).ToList()" OnMove="id => ToggleDirect(id, false)" OnMoveGroup="ids => MoveDirect(ids, false)" />
                                        <PermissionAssignmentColumn @key="(user.Id, false)" Permissions="data.Permissions.Where(p => !user.DirectPermissionIds.Contains(p.Id)).ToList()" OnMove="id => ToggleDirect(id, true)" OnMoveGroup="ids => MoveDirect(ids, true)" />
                                    </div>
                                    <details class="rounded-xl border border-slate-200 p-4"><summary class="cursor-pointer text-sm font-semibold text-slate-800">Inherited permissions (@InheritedIds.Count)</summary>
                                        <div class="mt-3 max-h-60 space-y-2 overflow-y-auto">@foreach (var permission in data.Permissions.Where(p => InheritedIds.Contains(p.Id))) { <p class="text-xs text-slate-600">@permission.Key</p> }</div>
                                    </details>
                                }
                            }
                            else if (Tab == UserSettingsTab.Staff)
                            {
                                <label class="@LabelClass">Individual<select class="@InputClass" disabled="@existingStaff" @bind="staff.IndividualId"><option value="0">Select individual</option>@foreach (var person in data.People) { <option value="@person.IndividualId">@person.Name (#@person.IndividualId)</option> }</select></label>
                                <label class="@LabelClass">Employee number<input class="@InputClass" maxlength="50" @bind="staff.EmployeeNumber" /></label>
                                <p class="text-xs text-slate-500">Add a staff record for an individual already associated with this organisation. Employment and job details are managed in the staff workspace.</p>
                            }
                            else if (Tab == UserSettingsTab.Enrollment)
                            {
                                <label class="@LabelClass">Staff member<select class="@InputClass" disabled="@(enrollment.Id > 0)" @bind="enrollment.IndividualId"><option value="0">Select staff</option>@foreach (var person in data.Staff) { <option value="@person.IndividualId">@person.Name</option> }</select></label>
                                <label class="@LabelClass">Enrollment number<input class="@InputClass" maxlength="10" @bind="enrollment.Number" /></label>
                            }
                            else
                            {
                                <p class="rounded-xl bg-indigo-50 p-4 text-sm text-indigo-800">These permissions limit which resources accounts in @data.OrganisationName can be granted. Each account still needs direct or User Group permissions.</p>
                                <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                                    <PermissionAssignmentColumn Assigned="true" Permissions="data.Permissions.Where(p => organisationPermissions.Contains(p.Id)).ToList()" OnMove="id => ToggleOrganisation(id, false)" OnMoveGroup="ids => MoveOrganisation(ids, false)" />
                                    <PermissionAssignmentColumn Permissions="data.Permissions.Where(p => !organisationPermissions.Contains(p.Id)).ToList()" OnMove="id => ToggleOrganisation(id, true)" OnMoveGroup="ids => MoveOrganisation(ids, true)" />
                                </div>
                            }
                        </div>
                        @if (user != null || Tab is UserSettingsTab.Staff or UserSettingsTab.Enrollment or UserSettingsTab.Organisation)
                        {
                            <div class="flex gap-3 border-t border-slate-100 bg-slate-50/50 px-5 py-4">
                                <button type="button" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm text-slate-600" @onclick="CancelAsync">Cancel</button>
                                <button type="button" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700" @onclick="SaveAsync">@(busy ? "Saving…" : "Save changes")</button>
                            </div>
                        }
                    </div>
                </section>
                <aside class="min-w-0 xl:col-span-4">
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <div class="border-b border-slate-200 px-5 py-4">
                            <div class="flex items-center justify-between gap-3"><div><h2 class="text-sm font-semibold text-slate-900">@ListTitle</h2><p class="mt-1 text-xs text-slate-500">@Rows.Count() records</p></div>
                                @if (Tab is UserSettingsTab.Staff or UserSettingsTab.Enrollment) { <button type="button" class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-white" title="Add @ListTitle" aria-label="Add @ListTitle" @onclick="NewItem"><span class="material-symbols-rounded">add</span></button> }</div>
                            <input type="search" class="mt-4 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm" aria-label="Search @ListTitle" placeholder="Search name or number…" @bind="search" @bind:event="oninput" />
                        </div>
                        <div class="divide-y divide-slate-100 overflow-y-auto" style="max-height: 680px; scrollbar-gutter: stable;" tabindex="0">
                            @foreach (var row in FilteredRows)
                            { <button type="button" class="block w-full border-l-4 px-5 py-4 text-left @(SelectedId == row.Id ? "border-indigo-600 bg-indigo-50" : "border-transparent hover:bg-slate-50")" @onclick="() => Select(row.Id)"><span class="block text-sm font-semibold text-slate-800">@row.Name</span><span class="mt-1 block break-all text-xs text-slate-500">@row.Detail</span></button> }
                            @if (!FilteredRows.Any()) { <p class="px-5 py-12 text-center text-sm text-slate-500">No records found.</p> }
                        </div>
                    </div>
                </aside>
            </div>
        </fieldset>
    }
</div>

@code {
    [Parameter] public UserSettingsTab Tab { get; set; }
    [SupplyParameterFromQuery(Name = "userId")] public int? RequestedUserId { get; set; }
    private UserSettingsData? data;
    private ManagedUserDto? user;
    private ManagedStaffDto staff = new();
    private ManagedEnrollmentDto enrollment = new();
    private List<int> organisationPermissions = new();
    private string search = "";
    private string? error;
    private bool busy, loading, existingStaff;
    private const string LabelClass = "block text-xs font-bold uppercase tracking-wide text-slate-700";
    private const string InputClass = "mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-normal normal-case outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 read-only:bg-slate-50";
    private string Title => Tab switch { UserSettingsTab.Accounts => "Manage Account", UserSettingsTab.Permissions => "Account Roles & Permissions", UserSettingsTab.Staff => "Manage Staff", UserSettingsTab.Enrollment => "Staff Enrollment Numbers", _ => "User Organisation Permissions" };
    private string Icon => Tab switch { UserSettingsTab.Accounts => "manage_accounts", UserSettingsTab.Permissions => "admin_panel_settings", UserSettingsTab.Staff => "groups", UserSettingsTab.Enrollment => "badge", _ => "corporate_fare" };
    private string ListTitle => Tab switch { UserSettingsTab.Staff => "Staff", UserSettingsTab.Enrollment => "Enrollments", UserSettingsTab.Organisation => "Organisation", _ => "Accounts" };
    private int SelectedId => Tab switch { UserSettingsTab.Staff => staff.IndividualId, UserSettingsTab.Enrollment => enrollment.Id, UserSettingsTab.Organisation => data?.UserOrganisationId ?? 0, _ => user?.Id ?? 0 };
    private record Row(int Id, string Name, string Detail);
    private IEnumerable<Row> Rows => data == null ? Enumerable.Empty<Row>() : Tab switch
    {
        UserSettingsTab.Staff => data.Staff.Select(x => new Row(x.IndividualId, x.Name, x.EmployeeNumber ?? "No employee number")),
        UserSettingsTab.Enrollment => data.Enrollments.Select(x => new Row(x.Id, x.Name, x.Number)),
        UserSettingsTab.Organisation => new[] { new Row(data.UserOrganisationId, data.OrganisationName, $"{organisationPermissions.Count} allowed permissions") },
        _ => data.Users.Select(x => new Row(x.Id, x.Name, $"{x.Username} · {(x.Active && x.StateId == 1 && x.Approved ? "Active" : "Inactive / pending")}"))
    };
    private IEnumerable<Row> FilteredRows => Rows.Where(x => x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Detail.Contains(search, StringComparison.OrdinalIgnoreCase));
    private HashSet<int> InheritedIds => (data?.Roles.Where(r => user?.RoleIds.Contains(r.Id) == true).SelectMany(r => r.PermissionIds) ?? Enumerable.Empty<int>()).Where(id => data?.OrganisationPermissionIds.Contains(id) == true).ToHashSet();
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true;
        try { var selected = RequestedUserId ?? SelectedId; data = await Settings.LoadAsync(Tab); organisationPermissions = data.OrganisationPermissionIds.ToList(); if (selected != 0) Select(selected); }
        catch (Exception ex) { Fail(ex); }
        finally { loading = false; }
    }
    private void NewItem() { staff = new(); enrollment = new(); user = null; existingStaff = false; error = null; }
    private async Task CancelAsync() { NewItem(); await ReloadAsync(); }
    private void Select(int id)
    {
        error = null; if (data == null) return;
        if (Tab is UserSettingsTab.Accounts or UserSettingsTab.Permissions)
        {
            var x = data.Users.FirstOrDefault(x => x.Id == id); if (x == null) { user = null; return; }
            user = new() { Id = x.Id, Username = x.Username, Name = x.Name, Email = x.Email, Mobile = x.Mobile, Active = x.Active, Approved = x.Approved, StateId = x.StateId, SsoStatus = x.SsoStatus, DirectPermissionIds = x.DirectPermissionIds.ToList(), RoleIds = x.RoleIds.ToList() };
        }
        if (Tab == UserSettingsTab.Staff && data.Staff.FirstOrDefault(x => x.IndividualId == id) is { } s) { staff = new() { IndividualId = s.IndividualId, Name = s.Name, EmployeeNumber = s.EmployeeNumber }; existingStaff = true; }
        if (Tab == UserSettingsTab.Enrollment && data.Enrollments.FirstOrDefault(x => x.Id == id) is { } e) enrollment = new() { Id = e.Id, IndividualId = e.IndividualId, Name = e.Name, Number = e.Number };
    }
    private static void Toggle(List<int> ids, int id, bool selected) { if (selected && !ids.Contains(id)) ids.Add(id); else if (!selected) ids.Remove(id); }
    private void ToggleRole(int id, bool selected) { if (user != null) Toggle(user.RoleIds, id, selected); }
    private void ToggleDirect(int id, bool selected) { if (user != null) Toggle(user.DirectPermissionIds, id, selected); }
    private void MoveDirect(List<int> ids, bool selected) { foreach (var id in ids) ToggleDirect(id, selected); }
    private void ToggleOrganisation(int id, bool selected) => Toggle(organisationPermissions, id, selected);
    private void MoveOrganisation(List<int> ids, bool selected) { foreach (var id in ids) ToggleOrganisation(id, selected); }
    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            var result = Tab switch
            {
                UserSettingsTab.Accounts when user != null => await Settings.SaveAccountAsync(user),
                UserSettingsTab.Permissions when user != null => await Settings.SaveUserAccessAsync(user),
                UserSettingsTab.Staff => await Settings.SaveStaffAsync(staff),
                UserSettingsTab.Enrollment => await Settings.SaveEnrollmentAsync(enrollment),
                UserSettingsTab.Organisation => await Settings.SaveOrganisationAccessAsync(organisationPermissions),
                _ => ServiceResult.Fail("Select an account first.")
            };
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message); await ReloadAsync();
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private void Fail(Exception ex) { Logger.LogError(ex, "User settings operation failed for {Tab}.", Tab); error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "User settings could not be loaded or saved. Please try again."; Toast.Error(error); }
}
