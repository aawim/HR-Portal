@using HRM.DTOs
@using HRM.DTOs.Roles
@using HRM.Helpers
@using HRM.Services
@using HRM.Components.Admin.Settings.Roles
@inject HRM.Services.Contracts.UserSettingsServiceContracts.IOperations Settings
@inject ToastService Toast
@inject ILogger<UserSettingsEditor> Logger
@inject NavigationManager Navigation

<section class="w-full min-w-0 p-2 flex flex-col gap-2">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800 flex-wrap gap-2">
        <div>
            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <span>@Title</span>
                @if (data != null)
                {
                    <span class="rounded-full border px-2 py-0.5 text-[10px] font-semibold @(IsSuperAdminContext ? "" : "bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border-teal-200 dark:border-teal-800/40")"
                          style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)">
                        @FilteredRows.Count() records
                    </span>
                }
            </h2>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@(data?.OrganisationName ?? "Organisation user administration")</p>
        </div>
        <div class="flex items-center gap-2">
            @if (Tab is UserSettingsTab.Staff or UserSettingsTab.Enrollment)
            {
                <button type="button"
                        @onclick="NewItem"
                        disabled="@busy"
                        class="app-button app-button-primary app-button-sm">
                    <AppIcon Name="add" />
                    <span>Add @ListTitle</span>
                </button>
            }
            <button type="button"
                    @onclick="ReloadAsync"
                    disabled="@(busy || loading)"
                    class="app-button app-button-secondary app-button-sm">
                <AppIcon Name="arrow-clockwise" />
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (data != null && (data.IsSuperAdmin || data.Departments.Count > 0 || data.Teams.Count > 0))
    {
        <!-- Organisation & Staff Filter Bar (Select Organisation First, then Department / Team) -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-2xs grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 items-end">
            @if (data.IsSuperAdmin)
            {
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">
                    1. Organisation
                    <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            value="@selectedOrganisationId"
                            @onchange="ChangeOrganisationAsync"
                            disabled="@(busy || loading)">
                        @foreach (var org in data.Organisations)
                        {
                            <option value="@org.Id">@org.Name</option>
                        }
                    </select>
                </label>
            }
            @if (Tab != UserSettingsTab.Organisation)
            {
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">
                    Department
                    <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            @bind="selectedDepartmentId"
                            disabled="@(busy || loading)">
                        <option value="">All Departments (@data.Departments.Count)</option>
                        @foreach (var dept in data.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </label>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">
                    Team
                    <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            @bind="selectedTeamId"
                            disabled="@(busy || loading)">
                        <option value="">All Teams (@data.Teams.Count)</option>
                        @foreach (var team in data.Teams)
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    </select>
                </label>
                <div class="flex items-center gap-1.5 p-1">
                    @if (selectedDepartmentId.HasValue || selectedTeamId.HasValue || !string.IsNullOrWhiteSpace(search))
                    {
                        <button type="button"
                                class="app-button app-button-neutral app-button-sm"
                                @onclick="ClearFilters">
                            Clear filters
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (error != null)
    {
        <div role="alert" class="rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2 text-xs text-rose-800 dark:text-rose-300">
            @error
        </div>
    }

    @if (loading)
    {
        <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            Loading @Title.ToLowerInvariant()…
        </div>
    }
    else if (data != null)
    {
        <fieldset disabled="@busy" class="w-full min-w-0">
            <div class="grid grid-cols-1 gap-2 xl:grid-cols-12 items-start">
                <!-- Left: Details / Editor Card -->
                <div class="min-w-0 xl:col-span-8 flex flex-col gap-2">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                        <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 p-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300">
                                    <AppIcon Name="@Icon" />
                                </span>
                                <div class="min-w-0">
                                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                                        @(user != null ? $"{user.Name} ({user.Username})" : Title)
                                    </h3>
                                </div>
                            </div>
                            @if (SelectedId > 0)
                            {
                                <span class="rounded bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/40 px-1.5 py-0.5 text-[10px] font-semibold text-amber-700 dark:text-amber-300 shrink-0">
                                    Editing #@SelectedId
                                </span>
                            }
                        </div>

                        <div class="p-2 flex flex-col gap-2">
                            @if (Tab is UserSettingsTab.Accounts or UserSettingsTab.Permissions)
                            {
                                @if (user == null)
                                {
                                    <div class="rounded-xl border border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30 p-2 text-xs text-teal-900 dark:text-teal-200">
                                        Select an account from the list on the right to manage it.
                                    </div>
                                }
                                else if (Tab == UserSettingsTab.Accounts)
                                {
                                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                                        <label class="@LabelClass">Username<input readonly class="@InputClass" value="@user.Username" /></label>
                                        <label class="@LabelClass">Full name<input class="@InputClass" maxlength="255" @bind="user.Name" /></label>
                                        <label class="@LabelClass">Email<input type="email" class="@InputClass" maxlength="128" @bind="user.Email" /></label>
                                        <label class="@LabelClass">Mobile<input class="@InputClass" maxlength="20" @bind="user.Mobile" /></label>
                                        <label class="@LabelClass">Account state<select class="@InputClass" @bind="user.StateId">@foreach (var option in data.AccountStates) { <option value="@option.Id">@option.Name</option> }</select></label>
                                        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-2 text-xs text-slate-600 dark:text-slate-300 flex items-center">
                                            Sign-in provider status: <strong class="ml-1 text-slate-800 dark:text-slate-100">@user.SsoStatus</strong>
                                        </div>
                                        <label class="flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-2 text-xs font-medium text-slate-700 dark:text-slate-200 cursor-pointer">
                                            <input type="checkbox" class="accent-teal-700" @bind="user.Active" /> Active account
                                        </label>
                                        <label class="flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-2 text-xs font-medium text-slate-700 dark:text-slate-200 cursor-pointer">
                                            <input type="checkbox" class="accent-teal-700" @bind="user.Approved" /> Approved account
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <!-- Effective Access Summary -->
                                    <div class="rounded-xl border p-2.5 flex flex-col gap-1.5 @(IsSuperAdminContext ? "" : "border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30")"
                                         style="@(IsSuperAdminContext ? "background-color: #eef8fc; border-color: #ADD8E6; color: #0f172a;" : null)">
                                        <div class="flex flex-wrap items-center justify-between gap-2">
                                            <span class="text-[11px] font-bold text-slate-800 dark:text-slate-100">Effective Access Summary</span>
                                            <div class="flex flex-wrap items-center gap-1.5 text-[10px] font-semibold">
                                                <span class="rounded-full bg-white/80 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-slate-700 dark:text-slate-200">@user.RoleIds.Count roles</span>
                                                <span class="rounded-full bg-white/80 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-slate-700 dark:text-slate-200">@EffectiveUserModules.Count modules</span>
                                                @if (user.DirectPermissionIds.Count > 0)
                                                {
                                                    <span class="rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200 px-2 py-0.5">@user.DirectPermissionIds.Count direct exceptions</span>
                                                }
                                            </div>
                                        </div>
                                        @if (EffectiveUserModules.Count > 0)
                                        {
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var mod in EffectiveUserModules)
                                                {
                                                    <span class="rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-medium text-slate-700 dark:text-slate-200">@mod</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400">Assign one or more roles below to grant access to HR modules.</p>
                                        }
                                    </div>

                                    <section class="rounded-xl border border-slate-200 dark:border-slate-800 p-2 flex flex-col gap-2">
                                        <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100">Assigned Roles</h4>
                                        <div class="grid max-h-60 grid-cols-1 gap-2 overflow-y-auto md:grid-cols-2">
                                            @foreach (var role in data.Roles)
                                            {
                                                <label class="flex items-start gap-2 rounded-lg border border-slate-200/80 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-2 text-xs cursor-pointer hover:border-teal-400 transition">
                                                    <input type="checkbox" class="mt-0.5 accent-teal-700" checked="@user.RoleIds.Contains(role.Id)" @onchange="e => ToggleRole(role.Id, e.Value is true)" />
                                                    <span class="min-w-0">
                                                        <span class="block font-semibold text-slate-800 dark:text-slate-100">@role.Name</span>
                                                        <span class="block text-[11px] text-slate-500 dark:text-slate-400">@role.PermissionIds.Count permissions</span>
                                                    </span>
                                                </label>
                                            }
                                            @if (data.Roles.Count == 0)
                                            {
                                                <p class="text-xs text-slate-500 dark:text-slate-400">No roles are configured for this organisation.</p>
                                            }
                                        </div>
                                    </section>

                                    <div class="rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
                                        <button type="button"
                                                class="w-full flex items-center justify-between gap-2 bg-slate-50/70 dark:bg-slate-800/40 px-3 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100/70 dark:hover:bg-slate-800/70 transition"
                                                @onclick="() => showDirectPermissions = !showDirectPermissions">
                                            <span class="flex items-center gap-1.5">
                                                <i class="bi @(showDirectPermissions ? "bi-chevron-down" : "bi-chevron-right") text-[11px] text-slate-500"></i>
                                                <span>Advanced: Direct Permission Exceptions</span>
                                            </span>
                                            <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400">@user.DirectPermissionIds.Count direct · @InheritedIds.Count via roles</span>
                                        </button>
                                        @if (showDirectPermissions)
                                        {
                                            <div class="p-2 flex flex-col gap-2 border-t border-slate-200 dark:border-slate-800">
                                                <p class="text-[11px] text-slate-500 dark:text-slate-400">Use direct permissions only for rare one-off exceptions. Both direct and role permissions are limited to permissions enabled for the organisation.</p>
                                                <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
                                                    <PermissionAssignmentColumn @key="(user.Id, true)" Assigned="true" Permissions="data.Permissions.Where(p => user.DirectPermissionIds.Contains(p.Id)).ToList()" OnMove="id => ToggleDirect(id, false)" OnMoveGroup="ids => MoveDirect(ids, false)" />
                                                    <PermissionAssignmentColumn @key="(user.Id, false)" Permissions="data.Permissions.Where(p => !user.DirectPermissionIds.Contains(p.Id)).ToList()" OnMove="id => ToggleDirect(id, true)" OnMoveGroup="ids => MoveDirect(ids, true)" />
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <details class="rounded-xl border border-slate-200 dark:border-slate-800 p-2">
                                        <summary class="cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-100">Inherited role permissions (@InheritedIds.Count)</summary>
                                        <div class="mt-2 max-h-60 flex flex-col gap-1 overflow-y-auto">
                                            @foreach (var permission in data.Permissions.Where(p => InheritedIds.Contains(p.Id)))
                                            {
                                                <p class="text-[11px] font-mono text-slate-600 dark:text-slate-300">@permission.Key</p>
                                            }
                                        </div>
                                    </details>
                                }
                            }
                            else if (Tab == UserSettingsTab.Staff)
                            {
                                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                                    <label class="@LabelClass">Individual<select class="@InputClass" disabled="@existingStaff" @bind="staff.IndividualId"><option value="0">Select individual</option>@foreach (var person in data.People) { <option value="@person.IndividualId">@person.Name (#@person.IndividualId)</option> }</select></label>
                                    <label class="@LabelClass">Employee number<input class="@InputClass" maxlength="50" @bind="staff.EmployeeNumber" /></label>
                                </div>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400">Add a staff record for an individual already associated with this organisation. Employment and job details are managed in the staff workspace.</p>
                            }
                            else if (Tab == UserSettingsTab.Enrollment)
                            {
                                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                                    <label class="@LabelClass">Staff member<select class="@InputClass" disabled="@(enrollment.Id > 0)" @bind="enrollment.IndividualId"><option value="0">Select staff</option>@foreach (var person in data.Staff) { <option value="@person.IndividualId">@person.Name</option> }</select></label>
                                    <label class="@LabelClass">Enrollment number<input class="@InputClass" maxlength="10" @bind="enrollment.Number" /></label>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-xl border border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30 p-2 text-xs text-teal-900 dark:text-teal-200">
                                    These permissions limit which resources accounts in @data.OrganisationName can be granted. Each account still needs an assigned role or direct permission exception.
                                </div>
                                <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
                                    <PermissionAssignmentColumn Assigned="true" Permissions="data.Permissions.Where(p => organisationPermissions.Contains(p.Id)).ToList()" OnMove="id => ToggleOrganisation(id, false)" OnMoveGroup="ids => MoveOrganisation(ids, false)" />
                                    <PermissionAssignmentColumn Permissions="data.Permissions.Where(p => !organisationPermissions.Contains(p.Id)).ToList()" OnMove="id => ToggleOrganisation(id, true)" OnMoveGroup="ids => MoveOrganisation(ids, true)" />
                                </div>
                            }
                        </div>

                        @if (user != null || Tab is UserSettingsTab.Staff or UserSettingsTab.Enrollment or UserSettingsTab.Organisation)
                        {
                            <div class="flex flex-wrap items-center gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-2">
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 text-white px-3 py-1.5 text-xs font-semibold shadow-xs disabled:opacity-50 transition"
                                        @onclick="SaveAsync">
                                    @(busy ? "Saving…" : "Save Changes")
                                </button>
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                                        @onclick="CancelAsync">
                                    Cancel
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right: Account / Record List Card -->
                <aside class="min-w-0 xl:col-span-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                    <div class="flex flex-col gap-2 border-b border-slate-100 dark:border-slate-800 p-2">
                        <div class="flex items-center justify-between gap-2">
                            <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">@ListTitle</h3>
                            <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
                                @FilteredRows.Count() / @Rows.Count()
                            </span>
                        </div>
                        <input type="search"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                               aria-label="Search @ListTitle"
                               placeholder="Search name or number…"
                               @bind="search"
                               @bind:event="oninput" />
                    </div>
                    <div class="divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto" style="max-height: 680px; scrollbar-gutter: stable;" tabindex="0">
                        @foreach (var row in FilteredRows)
                        {
                            var isSelected = SelectedId == row.Id;
                            <button type="button"
                                    class="block w-full border-l-4 p-2 text-left transition @(isSelected ? (IsSuperAdminContext ? "font-semibold" : "border-teal-700 bg-teal-50/70 dark:bg-teal-950/40") : "border-transparent hover:bg-slate-50 dark:hover:bg-slate-800/60")"
                                    style="@(isSelected && IsSuperAdminContext ? "background-color: #eef8fc; border-left-color: #0369a1;" : null)"
                                    @onclick="() => Select(row.Id)">
                                <span class="block text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">@row.Name</span>
                                <span class="mt-0.5 block break-all text-[11px] text-slate-500 dark:text-slate-400">@row.Detail</span>
                                @if (!string.IsNullOrWhiteSpace(row.DepartmentName) || !string.IsNullOrWhiteSpace(row.TeamName))
                                {
                                    <div class="mt-1 flex flex-wrap gap-1">
                                        @if (!string.IsNullOrWhiteSpace(row.DepartmentName))
                                        {
                                            <span class="rounded bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-600 dark:text-slate-300">@row.DepartmentName</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.TeamName))
                                        {
                                            <span class="rounded bg-sky-50 dark:bg-sky-950/50 px-1.5 py-0.5 text-[10px] text-sky-700 dark:text-sky-300">@row.TeamName</span>
                                        }
                                    </div>
                                }
                            </button>
                        }
                        @if (!FilteredRows.Any())
                        {
                            <p class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">No records found.</p>
                        }
                    </div>
                </aside>
            </div>
        </fieldset>
    }
</section>

@code {
    [Parameter] public UserSettingsTab Tab { get; set; }
    private int? RequestedUserId => HRM.Helpers.QueryStringReader.GetInt(Navigation.Uri, "userId");
    private UserSettingsData? data;
    private ManagedUserDto? user;
    private ManagedStaffDto staff = new();
    private ManagedEnrollmentDto enrollment = new();
    private List<int> organisationPermissions = new();
    private string search = "";
    private int? selectedOrganisationId;
    private int? selectedDepartmentId;
    private int? selectedTeamId;
    private string? error;
    private bool busy, loading, existingStaff, showDirectPermissions;
    private bool IsSuperAdminContext => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/superadmin", StringComparison.OrdinalIgnoreCase);
    private const string LabelClass = "block text-[11px] font-semibold text-slate-600 dark:text-slate-400 p-1";
    private const string InputClass = "mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 read-only:bg-slate-50 dark:read-only:bg-slate-800/50";
    private string Title => Tab switch { UserSettingsTab.Accounts => "Manage Account", UserSettingsTab.Permissions => "Account Roles & Permissions", UserSettingsTab.Staff => "Manage Staff", UserSettingsTab.Enrollment => "Staff Enrollment Numbers", _ => "User Organisation Permissions" };
    private string Icon => Tab switch { UserSettingsTab.Accounts => "manage_accounts", UserSettingsTab.Permissions => "admin_panel_settings", UserSettingsTab.Staff => "groups", UserSettingsTab.Enrollment => "badge", _ => "corporate_fare" };
    private string ListTitle => Tab switch { UserSettingsTab.Staff => "Staff", UserSettingsTab.Enrollment => "Enrollments", UserSettingsTab.Organisation => "Organisation", _ => "Accounts" };
    private int SelectedId => Tab switch { UserSettingsTab.Staff => staff.IndividualId, UserSettingsTab.Enrollment => enrollment.Id, UserSettingsTab.Organisation => data?.UserOrganisationId ?? 0, _ => user?.Id ?? 0 };
    private record Row(int Id, string Name, string Detail, int? DepartmentId = null, string? DepartmentName = null, int? TeamId = null, string? TeamName = null);
    private IEnumerable<Row> Rows => data == null ? Enumerable.Empty<Row>() : Tab switch
    {
        UserSettingsTab.Staff => data.Staff.Select(x => new Row(x.IndividualId, x.Name, x.EmployeeNumber ?? "No employee number", x.DepartmentId, x.DepartmentName, x.TeamId, x.TeamName)),
        UserSettingsTab.Enrollment => data.Enrollments.Select(x => new Row(x.Id, x.Name, x.Number, x.DepartmentId, x.DepartmentName, x.TeamId, x.TeamName)),
        UserSettingsTab.Organisation => new[] { new Row(data.UserOrganisationId, data.OrganisationName, $"{organisationPermissions.Count} allowed permissions") },
        _ => data.Users.Select(x => new Row(x.Id, x.Name, $"{x.Username} · {(x.Active && x.StateId == 1 && x.Approved ? "Active" : "Inactive / pending")}", x.DepartmentId, x.DepartmentName, x.TeamId, x.TeamName))
    };
    private IEnumerable<Row> FilteredRows => Rows.Where(x =>
        (!selectedDepartmentId.HasValue || x.DepartmentId == selectedDepartmentId.Value) &&
        (!selectedTeamId.HasValue || x.TeamId == selectedTeamId.Value) &&
        (string.IsNullOrWhiteSpace(search) ||
         x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         x.Detail.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         (x.DepartmentName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (x.TeamName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)));
    private HashSet<int> InheritedIds => (data?.Roles.Where(r => user?.RoleIds.Contains(r.Id) == true).SelectMany(r => r.PermissionIds) ?? Enumerable.Empty<int>()).Where(id => data?.OrganisationPermissionIds.Contains(id) == true).ToHashSet();
    private List<string> EffectiveUserModules => data == null || user == null
        ? []
        : AccessControlUiHelper.SummarizeEnabledModules(
            data.Permissions.Where(p => data.OrganisationPermissionIds.Contains(p.Id) && (InheritedIds.Contains(p.Id) || user.DirectPermissionIds.Contains(p.Id))));
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ChangeOrganisationAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var orgId) || orgId <= 0) return;
        selectedOrganisationId = orgId;
        selectedDepartmentId = null;
        selectedTeamId = null;
        search = "";
        NewItem();
        await ReloadAsync();
    }
    private void ClearFilters() { selectedDepartmentId = null; selectedTeamId = null; search = ""; }
    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            var selected = RequestedUserId ?? SelectedId;
            data = await Settings.LoadForOrganisationAsync(Tab, selectedOrganisationId);
            selectedOrganisationId = data.OrganisationId;
            organisationPermissions = data.OrganisationPermissionIds.ToList();
            if (selected != 0) Select(selected);
        }
        catch (Exception ex) { Fail(ex); }
        finally { loading = false; }
    }
    private void NewItem() { staff = new() { OrganisationId = data?.OrganisationId }; enrollment = new() { OrganisationId = data?.OrganisationId }; user = null; existingStaff = false; error = null; }
    private async Task CancelAsync() { NewItem(); await ReloadAsync(); }
    private void Select(int id)
    {
        error = null; if (data == null) return;
        if (Tab is UserSettingsTab.Accounts or UserSettingsTab.Permissions)
        {
            var x = data.Users.FirstOrDefault(x => x.Id == id); if (x == null) { user = null; return; }
            user = new() { Id = x.Id, IndividualId = x.IndividualId, OrganisationId = data.OrganisationId, Username = x.Username, Name = x.Name, Email = x.Email, Mobile = x.Mobile, Active = x.Active, Approved = x.Approved, StateId = x.StateId, SsoStatus = x.SsoStatus, DirectPermissionIds = x.DirectPermissionIds.ToList(), RoleIds = x.RoleIds.ToList() };
        }
        if (Tab == UserSettingsTab.Staff && data.Staff.FirstOrDefault(x => x.IndividualId == id) is { } s) { staff = new() { IndividualId = s.IndividualId, OrganisationId = data.OrganisationId, Name = s.Name, EmployeeNumber = s.EmployeeNumber }; existingStaff = true; }
        if (Tab == UserSettingsTab.Enrollment && data.Enrollments.FirstOrDefault(x => x.Id == id) is { } e) enrollment = new() { Id = e.Id, IndividualId = e.IndividualId, OrganisationId = data.OrganisationId, Name = e.Name, Number = e.Number };
    }
    private static void Toggle(List<int> ids, int id, bool selected) { if (selected && !ids.Contains(id)) ids.Add(id); else if (!selected) ids.Remove(id); }
    private void ToggleRole(int id, bool selected) { if (user != null) Toggle(user.RoleIds, id, selected); }
    private void ToggleDirect(int id, bool selected) { if (user != null) Toggle(user.DirectPermissionIds, id, selected); }
    private void MoveDirect(List<int> ids, bool selected) { foreach (var id in ids) ToggleDirect(id, selected); }
    private void ToggleOrganisation(int id, bool selected) => Toggle(organisationPermissions, id, selected);
    private void MoveOrganisation(List<int> ids, bool selected) { foreach (var id in ids) ToggleOrganisation(id, selected); }
    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            var result = Tab switch
            {
                UserSettingsTab.Accounts when user != null => await Settings.SaveAccountAsync(user),
                UserSettingsTab.Permissions when user != null => await Settings.SaveUserAccessAsync(user),
                UserSettingsTab.Staff => await Settings.SaveStaffAsync(staff),
                UserSettingsTab.Enrollment => await Settings.SaveEnrollmentAsync(enrollment),
                UserSettingsTab.Organisation => await Settings.SaveOrganisationAccessAsync(organisationPermissions),
                _ => ServiceResult.Fail("Select an account first.")
            };
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message); await ReloadAsync();
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private void Fail(Exception ex) { Logger.LogError(ex, "User settings operation failed for {Tab}.", Tab); error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "User settings could not be loaded or saved. Please try again."; Toast.Error(error); }
}
