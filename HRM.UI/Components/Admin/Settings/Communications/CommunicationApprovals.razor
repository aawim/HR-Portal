@page "/online/communication-approvals"
@page "/admin/settings/communications/approvals"
@attribute [Authorize]
@using HRM.DTOs.Communications
@inject HRM.Services.Contracts.CommunicationHubContracts.IOperations Hub
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Announcement approvals</PageTitle>
<section class="w-full min-w-0 p-2 space-y-4">
  <header class="sticky top-0 z-30 m-0 flex w-full flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white/95 px-3 py-3 shadow-xs backdrop-blur-xs dark:bg-slate-900/95 dark:border-slate-700">
    <div><h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">Announcement approvals</h1><p class="mt-0.5 text-xs text-slate-500">Review the saved message and destination. Only final approval queues delivery.</p></div>
    <div class="flex flex-wrap gap-2"><button type="button" class="app-button app-button-secondary app-button-sm" @onclick="ToggleWidthAsync">@(full ? "Shrink View" : "Full Width")</button><button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="LoadAsync">Refresh</button></div>
  </header>
  <div class="mx-auto w-full min-w-0 space-y-4 @(full ? "max-w-none" : "max-w-7xl")">
    @if (error is not null) { <p role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">@error</p> }
    @if (notice is not null) { <p role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800">@notice</p> }
    @if (loading) { <p class="p-4 text-xs text-slate-500">Loading assigned announcements…</p> }
    else if (!VisibleRows.Any()) { <p class="app-surface rounded-xl border border-dashed border-slate-300 p-6 text-center text-xs text-slate-500">No announcements are available to you in this organisation.</p> }
    @foreach (var row in VisibleRows)
    {
      <article @key="row.Id" class="app-surface rounded-2xl border border-slate-200 p-4 shadow-xs space-y-3 dark:border-slate-700">
        <div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-bold text-slate-900 dark:text-slate-100">@row.Subject</h2><span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-700">@row.Status · Request #@row.RequestId</span></div>
        <p class="text-xs text-slate-500">Destination: <strong>@row.Destination</strong> · Stage: @row.Stage</p>
        <p class="whitespace-pre-wrap break-words rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-700">@row.Body</p>
        @if (row.CanApprove || row.CanCancel)
        {
          <label class="block p-1 text-xs font-medium text-slate-700 dark:text-slate-200" for="@($"approval-comment-{row.Id}")">Comment (required for rejection or cancellation)</label>
          <textarea id="@($"approval-comment-{row.Id}")" maxlength="2000" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" @bind="comments[row.Id]"></textarea>
          <div class="flex flex-wrap gap-2">
            @if (row.CanApprove) { <button type="button" class="app-button app-button-success app-button-sm" disabled="@busy" @onclick='() => ActAsync(row, "Approve")'>Approve</button><button type="button" class="app-button app-button-danger app-button-sm" disabled="@busy" @onclick='() => ActAsync(row, "Reject")'>Reject</button> }
            @if (row.CanCancel) { <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick='() => ActAsync(row, "Cancel")'>Cancel request</button> }
          </div>
        }
      </article>
    }
  </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "requestId")] public int? RequestId { get; set; }
    private List<CommunicationApprovalReviewDto> rows = [];
    private IEnumerable<CommunicationApprovalReviewDto> VisibleRows => RequestId.HasValue ? rows.Where(x => x.RequestId == RequestId) : rows;
    private readonly Dictionary<long, string> comments = new();
    private bool loading, busy, full;
    private string? error, notice;
    protected override Task OnParametersSetAsync() => LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        full = bool.TryParse(await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.communication-approvals.full-width"), out var saved) && saved;
        StateHasChanged();
    }
    private async Task ToggleWidthAsync() { full = !full; await JS.InvokeVoidAsync("localStorage.setItem", "hrm.communication-approvals.full-width", full); }
    private async Task LoadAsync()
    {
        loading = true;
        try { rows = await Hub.LoadApprovalsAsync(RequestId ?? 0); foreach (var row in rows) comments.TryAdd(row.Id, ""); }
        catch { error = "Announcement approvals could not be loaded. Check your organisation access and refresh."; }
        finally { loading = false; }
    }
    private async Task ActAsync(CommunicationApprovalReviewDto row, string action)
    {
        if (busy) return;
        error = null; notice = null;
        if (action != "Approve" && string.IsNullOrWhiteSpace(comments[row.Id])) { error = "Enter a comment before rejecting or cancelling."; return; }
        busy = true;
        try
        {
            await Hub.ActOnAnnouncementAsync(new() { Id = row.Id, ExpectedState = row.ExpectedState, Action = action, Comment = comments[row.Id] });
            await LoadAsync();
            notice = "Decision recorded. Delivery is queued only when all required approval stages are complete.";
        }
        catch (Exception ex) { error = ex is InvalidOperationException or UnauthorizedAccessException ? ex.Message : "Decision could not be recorded. Refresh before trying again."; }
        finally { busy = false; }
    }
}
