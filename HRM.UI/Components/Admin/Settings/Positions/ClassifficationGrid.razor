@using HRM.Models
@rendermode RenderMode.InteractiveServer

<section class="space-y-4 w-full min-w-0 p-2">
    <header class="sticky top-0 z-20 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-3 py-3 shadow-xs rounded-xl">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-slate-900">Manage Classifications</h2>
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">
                    Classifications
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">Civil Service position classifications and functional category groupings.</p>
        </div>
    </header>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50/50 p-8 text-center text-xs text-slate-500 space-y-2">
            <div class="text-3xl">🏷️</div>
            <p class="font-semibold text-slate-700">Classification Structure Configuration</p>
            <p>Position classifications categorize roles across administrative, professional, technical, and executive tracks.</p>
        </div>
    </div>
</section>

