@using HRM.Application.Contracts.Pages
@inject IPositionManagement Positions
@inject HRM.Services.ToastService Toasts
<section class="space-y-3 position-management">
    <div class="flex justify-between gap-2"><h2 class="text-xl font-semibold">Positions</h2><button class="app-button app-button-secondary" disabled="@busy" @onclick="Load">Refresh</button></div>
    @if(error!=null){<p role="alert" class="rounded border p-3">@error</p>}
    @if(data!=null)
    {
        @if(data.CanManage)
        {
            <div class="flex flex-wrap gap-2" role="group" aria-label="Position framework">
                @foreach(var f in data.Frameworks)
                {
                    <button type="button" class="app-button @(framework==f.Id?"app-button-primary":"app-button-secondary")" aria-pressed="@(framework==f.Id?"true":"false")" disabled="@(!f.Active||busy)" @onclick="()=>SelectFramework(f.Id)">@f.Name@(!f.Active?" (inactive)":"")</button>
                }
            </div>
            @if(id==0&&CanCreateDirect&&HasJobMatrices)
            {
                <div class="flex flex-wrap gap-2"><button class="app-button @(matrixCreation?"app-button-secondary":"app-button-primary")" @onclick="()=>matrixCreation=false">Direct position</button><button class="app-button @(matrixCreation?"app-button-primary":"app-button-secondary")" @onclick="()=>matrixCreation=true">From job matrix</button></div>
            }
            @if(id==0&&(!CanCreateDirect||matrixCreation))
            {
                <PositionMatrixEditor FrameworkId="framework" Data="payData" OnCreated="Load" />
            }
            else
            {
            <fieldset disabled="@busy" class="rounded-xl border p-3 space-y-3">
                <h3 class="font-semibold">@(id==0?"New position":"Edit position")</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @if(matrix>0){<p>Position matrix #@matrix · Position #@id</p>}
                    <label>Name<input @bind="name" maxlength="250" /></label><label>Dhivehi name<input @bind="dhivehi" maxlength="250" /></label>
                    <label>Position type<select @bind="typeId"><option value="">Select</option>@foreach(var t in data.Types){<option value="@t.Id">@t.Name</option>}</select></label>
                    @if(IsCsc)
                    {
                        <label>Rank<select @bind="rankId"><option value="">Select</option>@foreach(var r in data.Ranks){<option value="@r.Id">@r.Name</option>}</select></label>
                        <label>Classification<select @bind="classificationId"><option value="">Select</option>@foreach(var c in data.Classifications){<option value="@c.Id">@c.Name</option>}</select></label>
                    }
                    @if(!IsGovernment&&matrix==0)
                    {
                        <label>New basic salary<input type="number" min="0" step="0.01" @bind="salary" /></label>
                        <label>Salary effective date<input type="date" @bind="salaryDate" /></label>
                    }
                    <label><input type="checkbox" @bind="active" /> Active</label>@if(data.IsSuperAdministrator&&!IsGovernment&&matrix==0){<label><input type="checkbox" @bind="global" /> Global — available to all organisations</label>}
                </div>
                <label class="block">Description<textarea @bind="description" maxlength="4000" rows="2"></textarea></label>
                @if(salaryHistory.Count>0){<details><summary>Basic salary history</summary><div class="overflow-x-auto"><table class="w-full"><thead><tr><th>Effective from</th><th>Basic salary</th></tr></thead><tbody>@foreach(var s in salaryHistory){<tr><td>@s.EffectiveDate.ToString("dd MMM yyyy")</td><td>@s.Amount.ToString("N2")</td></tr>}</tbody></table></div></details>}
                <div class="flex gap-2"><button class="app-button app-button-primary" disabled="@(id==0&&IsGovernment)" @onclick="Save">Save position</button><button class="app-button app-button-secondary" @onclick="Reset">New / clear</button></div>
            </fieldset>
            }
        }
        <div class="flex flex-wrap items-end gap-3"><label class="flex-1">Search<input type="search" @bind="search" @bind:event="oninput" placeholder="Position name" /></label><label>Framework<select @bind="filter"><option value="0">All</option>@foreach(var f in data.Frameworks){<option value="@f.Id">@f.Name</option>}</select></label><label>Status<select @bind="state"><option value="active">Active</option><option value="all">All</option><option value="inactive">Inactive</option></select></label></div>
        <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><th>Position</th><th>Framework</th><th>Scope</th><th>Matrix</th><th>Staff</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in data.Positions.Where(x=>(filter==0||x.FrameworkId==filter)&&(state=="all"||x.Active==(state=="active"))&&x.Name.Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td>@p.Name · #@p.Id</td><td>@p.Framework</td><td>@(p.Global?"Global":"Organisation")</td><td>@(p.MatrixId?.ToString()??"Custom")</td><td>@p.CurrentStaff</td><td>@(p.Active?"Active":"Inactive")</td><td>@if(p.CanEdit){<button class="app-button app-button-secondary" @onclick="()=>Edit(p)">Edit</button>}</td></tr>}</tbody></table></div>
    }
</section>
@code{
    private PositionManagementData? data;private PayFrameworkData? payData;private bool busy,active=true,global,matrixCreation;private int id,framework,matrix,filter;private string name="",dhivehi="",description="",search="",state="active";private string? error;
    private int? typeId,rankId,classificationId;private decimal? salary;private DateOnly? salaryDate;private List<PositionSalaryRow> salaryHistory=[];
    private bool IsGovernment=>data?.Frameworks.FirstOrDefault(x=>x.Id==framework)?.Code=="NEW_PAY";
    private bool IsCsc=>data?.Frameworks.FirstOrDefault(x=>x.Id==framework)?.Code=="LEGACY";
    private bool CanCreateDirect=>data?.Frameworks.FirstOrDefault(x=>x.Id==framework)?.Code is "LEGACY" or "CUSTOM";
    private bool HasJobMatrices=>payData?.Matrices.Any(x=>x.FrameworkId==framework)==true;
    protected override async Task OnInitializedAsync()=>await Load();
    private async Task Load(){busy=true;error=null;try{var positionsTask=Positions.LoadAsync();var payTask=Positions.LoadPayFrameworksAsync();await Task.WhenAll(positionsTask,payTask);data=await positionsTask;payData=await payTask;if(framework==0)framework=data.Frameworks.FirstOrDefault(x=>x.Active)?.Id??0;}catch(Exception){error="Positions could not be loaded. Please check your current organisation and permissions.";}finally{busy=false;}}
    private void SelectFramework(int value){Reset();framework=value;matrixCreation=false;ChangeFramework();}
    private void ChangeFramework(){matrix=0;typeId=null;rankId=null;classificationId=null;salary=null;salaryDate=null;if(IsGovernment)global=false;}
    private void Reset(){id=0;name="";dhivehi="";description="";active=true;global=false;matrix=0;typeId=null;rankId=null;classificationId=null;salary=null;salaryDate=null;salaryHistory=[];}
    private void Edit(ManagedPosition p){id=p.Id;name=p.Name;dhivehi=p.DhivehiName??"";description=p.Description??"";active=p.Active;global=p.Global;framework=p.FrameworkId??0;matrix=p.MatrixId??0;typeId=p.TypeId;rankId=p.RankId;classificationId=p.ClassificationId;salary=null;salaryDate=null;salaryHistory=p.Salaries;}
    private async Task Save(){if(busy)return;busy=true;error=null;var saved=false;try{var result=await Positions.SaveAsync(new(id,name,dhivehi,description,active,global,framework,matrix>0?matrix:null){TypeId=typeId,RankId=rankId,ClassificationId=classificationId,BasicSalary=salary,SalaryEffectiveDate=salaryDate});saved=result.Success;if(saved)Toasts.Success(result.Message);else error=result.Message;}catch(Exception){error="Position could not be saved. Check the framework and matrix selection.";}finally{busy=false;}if(saved){Reset();await Load();}}
}
