@using HRM.Application.Contracts.Pages
@inject IPositionManagement Positions
@inject HRM.Services.ToastService Toasts
<section class="space-y-3 position-management">
    <div class="flex justify-between gap-2"><h2 class="text-xl font-semibold">Positions</h2><button class="app-button app-button-secondary" disabled="@busy" @onclick="Load">Refresh</button></div>
    @if(error!=null){<p role="alert" class="rounded border p-3">@error</p>}
    @if(data!=null)
    {
        @if(data.CanManage)
        {
            <fieldset disabled="@busy" class="rounded-xl border p-3 space-y-3">
                <h3 class="font-semibold">@(id==0?"New position":"Edit position")</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <label>Framework<select @bind="framework" @bind:after="ChangeFramework"><option value="0">Select</option>@foreach(var f in data.Frameworks.Where(x=>x.Active)){<option value="@f.Id">@f.Name · @(f.Code=="NEW_PAY"?"Government Job Matrix":"Custom / existing")</option>}</select></label>
                    @if(IsGovernment){<label>Government position matrix<select @bind="matrix"><option value="0">Select existing matrix</option>@foreach(var m in data.Matrices){<option value="@m.Id">@m.Name · @m.ApprovedSlots slots</option>}</select></label>}
                    <label>Name<input @bind="name" maxlength="250" /></label><label>Dhivehi name<input @bind="dhivehi" maxlength="250" /></label>
                    <label><input type="checkbox" @bind="active" /> Active</label>@if(data.IsSuperAdministrator&&!IsGovernment){<label><input type="checkbox" @bind="global" /> Global position</label>}
                </div>
                @if(IsGovernment&&data.Matrices.Count==0){<p role="status" class="text-sm">No active government position matrices are configured for this organisation.</p>}
                <label class="block">Description<textarea @bind="description" maxlength="4000" rows="2"></textarea></label>
                <div class="flex gap-2"><button class="app-button app-button-primary" @onclick="Save">Save position</button><button class="app-button app-button-secondary" @onclick="Reset">New / clear</button></div>
            </fieldset>
        }
        <div class="flex flex-wrap items-end gap-3"><label class="flex-1">Search<input type="search" @bind="search" @bind:event="oninput" placeholder="Position name" /></label><label>Framework<select @bind="filter"><option value="0">All</option>@foreach(var f in data.Frameworks){<option value="@f.Id">@f.Name</option>}</select></label><label>Status<select @bind="state"><option value="active">Active</option><option value="all">All</option><option value="inactive">Inactive</option></select></label></div>
        <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><th>Position</th><th>Framework</th><th>Matrix</th><th>Staff</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in data.Positions.Where(x=>(filter==0||x.FrameworkId==filter)&&(state=="all"||x.Active==(state=="active"))&&x.Name.Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td>@p.Name</td><td>@p.Framework</td><td>@(p.MatrixId?.ToString()??"Custom")</td><td>@p.CurrentStaff</td><td>@(p.Active?"Active":"Inactive")</td><td>@if(p.CanEdit){<button class="app-button app-button-secondary" @onclick="()=>Edit(p)">Edit</button>}</td></tr>}</tbody></table></div>
    }
</section>
@code{
    private PositionManagementData? data;private bool busy,active=true,global;private int id,framework,matrix,filter;private string name="",dhivehi="",description="",search="",state="active";private string? error;
    private bool IsGovernment=>data?.Frameworks.FirstOrDefault(x=>x.Id==framework)?.Code=="NEW_PAY";
    protected override async Task OnInitializedAsync()=>await Load();
    private async Task Load(){busy=true;error=null;try{data=await Positions.LoadAsync();if(framework==0)framework=data.Frameworks.FirstOrDefault(x=>x.Code=="LEGACY")?.Id??0;}catch(Exception){error="Positions could not be loaded. Please check your current organisation and permissions.";}finally{busy=false;}}
    private void ChangeFramework(){matrix=0;if(IsGovernment)global=false;}
    private void Reset(){id=0;name="";dhivehi="";description="";active=true;global=false;matrix=0;framework=data?.Frameworks.FirstOrDefault(x=>x.Code=="LEGACY")?.Id??0;}
    private void Edit(ManagedPosition p){id=p.Id;name=p.Name;dhivehi=p.DhivehiName??"";description=p.Description??"";active=p.Active;global=p.Global;framework=p.FrameworkId??0;matrix=p.MatrixId??0;}
    private async Task Save(){if(busy)return;busy=true;error=null;var saved=false;try{var result=await Positions.SaveAsync(new(id,name,dhivehi,description,active,global,framework,IsGovernment&&matrix>0?matrix:null));saved=result.Success;if(saved)Toasts.Success(result.Message);else error=result.Message;}catch(Exception){error="Position could not be saved. Check the framework and matrix selection.";}finally{busy=false;}if(saved){Reset();await Load();}}
}
