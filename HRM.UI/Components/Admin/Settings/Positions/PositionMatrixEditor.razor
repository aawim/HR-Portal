@using HRM.Application.Contracts.Pages
@inject IPositionManagement Service
@inject HRM.Services.ToastService Toasts
<section class="border rounded-lg p-3 text-sm">
    <h3 class="font-semibold">Create position matrix</h3>
    @if(error!=null){<p role="alert">@error</p>}
    @if(data?.CanManagePositions==true)
    {
        <fieldset disabled="@busy" class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">
            <label>Job matrix<select @bind="matrixId" @bind:after="ChangeMatrix"><option value="0">Select</option>@foreach(var m in data.Matrices.Where(x=>x.FrameworkId==FrameworkId).OrderBy(x=>x.Name).ThenBy(x=>x.Profile.PublicServiceRank).ThenBy(x=>x.Code)){<option value="@m.Id" disabled="@(!m.Active)">@m.Code · @m.Name@(string.IsNullOrWhiteSpace(m.Profile.PublicServiceRank)?"":$" · Rank {m.Profile.PublicServiceRank}")@(!m.Active?" · Inactive":"")</option>}</select></label>
            <label>Title<select @bind="titleId"><option value="0">Select</option>@if(Selected!=null){@foreach(var t in Selected.Titles){<option value="@t.Id">@t.Name</option>}}</select></label>
            <label>Approved staffing slots<input type="number" min="1" max="100000" @bind="slots" /></label>
            <label>Effective from<input type="date" @bind="from" /></label><label>Effective through<input type="date" @bind="to" /></label>
            <button class="app-button app-button-primary self-end" disabled="@(Selected?.Active!=true||titleId==0)" @onclick="Save">Create @slots position(s)</button>
        </fieldset>
        @if(!data.Matrices.Any(x=>x.FrameworkId==FrameworkId)){<p role="status">No Job Matrices are configured for this framework.</p>}
        @if(Selected!=null)
        {
            <details class="mt-3"><summary>Job Matrix requirements</summary><JobMatrixProfileView Profile="Selected.Profile" /></details>
            <div class="mt-3 space-y-1"><p>Basic salary: @Selected.BasicSalary.ToString("N2") · @data.Currencies.FirstOrDefault(x=>x.Id==Selected.CurrencyId)?.Name</p><p>Pay step is selected for the employee's Job at assignment.</p>@foreach(var b in Selected.Benefits){<p>@b.Name · @(b.Amount?.ToString("N2")??"Non-cash") · @b.Frequency</p>}</div>
        }
    }
</section>
@code{
    [Parameter]public EventCallback OnCreated{get;set;}
    [Parameter]public int FrameworkId{get;set;}
    [Parameter]public PayFrameworkData? Data{get;set;}
    private PayFrameworkData? data;private bool busy;private string? error;private int previousFramework=-1,matrixId,titleId,slots=1;private DateTime from=DateTime.UtcNow.AddHours(5).Date;private DateTime? to;
    private JobMatrixRow? Selected=>data?.Matrices.FirstOrDefault(x=>x.Id==matrixId);
    protected override async Task OnParametersSetAsync(){try{data=Data??await Service.LoadPayFrameworksAsync();if(previousFramework!=FrameworkId){matrixId=0;titleId=0;error=null;previousFramework=FrameworkId;}}catch(Exception){error="Job matrix information could not be loaded.";}}
    private void ChangeMatrix(){titleId=0;if(Selected!=null){from=Selected.From>DateTime.UtcNow.AddHours(5).Date?Selected.From:DateTime.UtcNow.AddHours(5).Date;to=Selected.To;}}
    private async Task Save(){if(busy)return;busy=true;error=null;try{var result=await Service.CreatePositionMatrixAsync(new(matrixId,titleId,slots,from,to));if(result.Success){Toasts.Success(result.Message);matrixId=0;titleId=0;slots=1;await OnCreated.InvokeAsync();}else error=result.Message;}catch(Exception){error="The position matrix could not be created. Please try again.";}finally{busy=false;}}
}
