@using HRM.Application.Contracts.Pages

<section class="matrix-requirements space-y-4">
    <div class="flex flex-wrap justify-between items-center gap-2 border-b border-slate-200 pb-2">
        <div>
            <h4 class="text-xs font-bold text-slate-800">Licences &amp; Professional Training Requirements</h4>
            <p class="text-[11px] text-slate-500">Specify mandatory or conditional certifications, licences, or registrations.</p>
        </div>
        <button type="button"
                class="inline-flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition"
                @onclick="() => Profile.CredentialRequirements.Add(new())">
            ＋ Add Requirement
        </button>
    </div>

    @foreach (var item in Profile.CredentialRequirements)
    {
        <fieldset @key="RowKey(item)" class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 space-y-3">
            <div class="requirements-grid">
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Credential / Training Name</label>
                    <input maxlength="250" @bind="item.Name" list="credential-names" placeholder="e.g. Practising Licence" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Type</label>
                    <select @bind="item.Kind" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none">
                        <option>Licence</option>
                        <option>Registration</option>
                        <option>Certification</option>
                        <option>Training</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Issuing Authority</label>
                    <input maxlength="250" @bind="item.Issuer" list="credential-authorities" placeholder="e.g. Bar Council" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Requirement Level</label>
                    <select @bind="item.Requirement" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none">
                        <option>Mandatory</option>
                        <option>Preferred</option>
                        <option>Conditional</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Validity (Months)</label>
                    <input type="number" min="1" max="600" @bind="item.ValidityMonths" placeholder="Optional" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Training Hours</label>
                    <input type="number" min="0" max="10000" step="0.01" @bind="item.TrainingHours" placeholder="Optional" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div class="flex items-center gap-4 py-2 col-span-full">
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                        <input type="checkbox" @bind="item.RenewalRequired" class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <span>Renewal required</span>
                    </label>
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                        <input type="checkbox" @bind="item.EvidenceRequired" class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <span>Documentary evidence required</span>
                    </label>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Condition (For Conditional)</label>
                    <textarea rows="2" maxlength="2000" @bind="item.Condition" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Accepted Equivalents</label>
                    <textarea rows="2" maxlength="2000" @bind="item.Equivalents" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Verification Instructions</label>
                    <textarea rows="2" maxlength="2000" @bind="item.VerificationInstructions" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                </div>
                <div class="col-span-full">
                    <label class="block text-xs font-medium text-slate-700 p-1">Source / Regulation / Matrix Reference</label>
                    <textarea rows="2" maxlength="2000" @bind="item.SourceReference" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                </div>
            </div>
            <div class="flex justify-end pt-2 border-t border-slate-200">
                <button type="button"
                        class="inline-flex items-center gap-1 rounded-lg border border-rose-300 bg-white px-2.5 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50 transition"
                        @onclick="() => RemoveRow(Profile.CredentialRequirements, item)">
                    Remove Requirement
                </button>
            </div>
        </fieldset>
    }

    <datalist id="credential-authorities">
        <option>Maldives Medical and Dental Council</option>
        <option>Maldives Nursing and Midwifery Council</option>
        <option>Maldives Allied Health Council</option>
        <option>Bar Council of the Maldives</option>
        <option>Maldives Civil Aviation Authority</option>
    </datalist>
    <datalist id="credential-names">
        <option>Practising licence</option>
        <option>Professional registration</option>
        <option>Bar practising certificate</option>
        <option>Certificate of Competency</option>
        <option>Continuing professional development</option>
        <option>CCNP</option>
        <option>CCIE</option>
        <option>CISSP</option>
        <option>CISA</option>
    </datalist>

    <div class="flex flex-wrap justify-between items-center gap-2 border-b border-slate-200 pb-2 pt-2">
        <div>
            <h4 class="text-xs font-bold text-slate-800">Qualification Pathways &amp; Experience</h4>
            <p class="text-[11px] text-slate-500">Complete any one pathway (OR). All qualifications and conditions within it apply (AND).</p>
        </div>
        <button type="button"
                class="inline-flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition"
                @onclick="AddPathway">
            ＋ Add Alternative Pathway
        </button>
    </div>

    @foreach (var path in Profile.QualificationPathways)
    {
        <fieldset @key="RowKey(path)" class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 space-y-3">
            <div class="requirements-grid">
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Pathway Name</label>
                    <input maxlength="250" @bind="path.Name" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Relevant Experience (Months)</label>
                    <input type="number" min="0" max="1200" @bind="path.RelevantExperienceMonths" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Post-Qualification Experience (Months)</label>
                    <input type="number" min="0" max="1200" @bind="path.PostQualificationMonths" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Managerial Experience (Months)</label>
                    <input type="number" min="0" max="1200" @bind="path.ManagerialExperienceMonths" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                </div>
            </div>

            @foreach (var qualification in path.Qualifications)
            {
                <div @key="RowKey(qualification)" class="rounded-lg border border-slate-200 bg-white p-3 space-y-2">
                    <div class="requirements-grid">
                        <div class="col-span-2">
                            <label class="block text-xs font-medium text-slate-700 p-1">Qualification Type / Description</label>
                            <input maxlength="250" @bind="qualification.Qualification" placeholder="e.g. Bachelor's Degree" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-700 p-1">MNQF Level</label>
                            <select @bind="qualification.MinimumLevel" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none">
                                <option value="">Not specified / non-MNQF</option>
                                @for (var level = 1; level <= 10; level++)
                                {
                                    <option value="@level">MNQF Level @level</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-700 p-1">Or Through Level (Optional)</label>
                            <select @bind="qualification.MaximumLevel" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none">
                                <option value="">Exact level</option>
                                @for (var level = 1; level <= 10; level++)
                                {
                                    <option value="@level">MNQF Level @level</option>
                                }
                            </select>
                        </div>
                        <div class="col-span-2">
                            <label class="block text-xs font-medium text-slate-700 p-1">Required Field of Study</label>
                            <input maxlength="1000" @bind="qualification.FieldOfStudy" placeholder="e.g. Computer Science, Information Technology" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none" />
                        </div>
                    </div>
                    <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                        <label class="inline-flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" @bind="qualification.AccreditedRequired" class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                            <span>Recognised / accredited qualification required</span>
                        </label>
                        <button type="button"
                                class="inline-flex items-center gap-1 rounded border border-rose-300 bg-white px-2 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50 transition"
                                @onclick="() => RemoveRow(path.Qualifications, qualification)">
                            Remove Qualification
                        </button>
                    </div>
                </div>
            }

            <div class="flex flex-wrap gap-2 pt-1">
                <button type="button"
                        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition"
                        @onclick="() => path.Qualifications.Add(new())">
                    ＋ Add Qualification (AND)
                </button>
                <button type="button"
                        class="inline-flex items-center gap-1 rounded-lg border border-rose-300 bg-white px-2.5 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50 transition"
                        @onclick="() => RemoveRow(Profile.QualificationPathways, path)">
                    Remove Pathway
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Additional Conditions / Experience Scope</label>
                    <textarea rows="2" maxlength="4000" @bind="path.Conditions" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 p-1">Source / Matrix Reference</label>
                    <textarea rows="2" maxlength="2000" @bind="path.SourceReference" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                </div>
            </div>
        </fieldset>
    }
</section>

@code {
    [Parameter, EditorRequired] public JobMatrixProfile Profile { get; set; } = new();
    private readonly System.Runtime.CompilerServices.ConditionalWeakTable<object, object> rowKeys = new();
    private object RowKey(object row) => rowKeys.GetValue(row, _ => new object());
    private static void RemoveRow<T>(List<T> rows, T row) where T : class
    {
        var index = rows.FindIndex(x => ReferenceEquals(x, row));
        if (index >= 0) rows.RemoveAt(index);
    }
    private void AddPathway() => Profile.QualificationPathways.Add(new() { Name = $"Pathway {Profile.QualificationPathways.Count + 1}", Qualifications = [new()] });
}
