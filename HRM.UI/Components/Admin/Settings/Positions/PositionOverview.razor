@using HRM.DTOs
@using HRM.Services
@inject HRM.Services.Contracts.PositionOverviewServiceContracts.IOperations Overview
@inject ILogger<PositionOverview> Logger

<section class="position-overview-page w-full min-w-0 flex flex-col gap-3 text-slate-900 dark:text-slate-100">
    <!-- Compact Header (no background/border) -->
    <header class="flex w-full min-w-0 flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">Position Overview</h2>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    @(data?.Organisation ?? "Positions")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">@(data?.Positions.Count ?? 0) positions · @CurrentStaffCount current staff. Only approved, currently effective job assignments are counted.</p>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" class="app-button app-button-secondary app-button-sm" aria-pressed="@tableView" @onclick="() => tableView = !tableView">
                @(tableView ? "Card View" : "Table View")
            </button>
            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    disabled="@loading"
                    @onclick="LoadAsync">
                <AppIcon Name="refresh" Class="@(loading ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
            <a href="/admin/settings/positions/position-allowances"
               class="app-button app-button-secondary app-button-sm">
                <span>Position Allowances</span>
            </a>
            <a href="/admin/settings/positions/manage-positions"
               class="app-button app-button-primary app-button-sm">
                <span>Manage Positions</span>
            </a>
        </div>
    </header>

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50/80 dark:bg-rose-950/40 px-3.5 py-2.5 text-xs text-rose-800 dark:text-rose-200">
            <span>@error</span>
            <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 hover:text-rose-800">✕</button>
        </div>
    }

    @if (loading)
    {
        <div role="status" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-10 text-xs text-slate-500">
            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
            <span>Loading positions…</span>
        </div>
    }
    else if (data != null)
    {
        <div class="po-layout">
            <!-- Left Main Panel: Active Positions -->
            <div class="min-w-0 flex flex-col gap-3">
                @if (!VisiblePositions.Any())
                {
                    <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center text-xs text-slate-500">
                        No positions match the search criteria.
                    </div>
                }
                else if (tableView)
                {
                    <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <caption class="sr-only">Positions and their currently assigned staff</caption>
                                <thead class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-800/60 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                    <tr>
                                        <th class="px-3 py-2" scope="col" aria-sort="@(sortDescending ? "descending" : "ascending")">
                                            <button type="button" class="font-bold uppercase tracking-wider" @onclick="() => sortDescending = !sortDescending">Position <span aria-hidden="true">@(sortDescending ? "↓" : "↑")</span></button>
                                        </th>
                                        <th class="px-3 py-2" scope="col">Type</th>
                                        <th class="px-3 py-2" scope="col">Scope</th>
                                        <th class="px-3 py-2" scope="col">Status</th>
                                        <th class="px-3 py-2 text-right" scope="col">Current Staff</th>
                                        <th class="px-3 py-2" scope="col">Staff Details</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
                                    @foreach (var position in TablePositions)
                                    {
                                        var staff = StaffFor(position).ToList();
                                        <tr @key="position.Id" class="even:bg-slate-50/40 dark:even:bg-slate-800/20 hover:bg-teal-50/30 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="px-3 py-2 font-semibold text-slate-900 dark:text-slate-100">@position.Name</td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@(position.MatrixId.HasValue ? "Government Job Matrix" : "Custom / Existing")</td>
                                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@(position.IsGlobal ? "Global" : "Organisation")</td>
                                            <td class="px-3 py-2">
                                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @(position.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-200")">@(position.IsActive ? "Active" : "Inactive")</span>
                                            </td>
                                            <td class="px-3 py-2 text-right font-semibold tabular-nums">@staff.Select(x => x.IndividualId).Distinct().Count()</td>
                                            <td class="px-3 py-2">
                                                @if (staff.Count == 0)
                                                {
                                                    <span class="text-slate-400">No current staff</span>
                                                }
                                                else
                                                {
                                                    <details>
                                                        <summary class="cursor-pointer font-semibold text-teal-700 dark:text-teal-400 select-none">View staff</summary>
                                                        <ul class="mt-2 space-y-1.5">
                                                            @foreach (var employee in staff)
                                                            {
                                                                <li>
                                                                    <a class="font-semibold text-blue-600 hover:underline" href="/admin/my/workspace?entityType=Staff&entityId=@employee.IndividualId">@employee.Name</a>
                                                                    <div class="text-[11px] text-slate-500">@employee.Department · @employee.From.ToString("dd MMM yyyy") – @(employee.To?.ToString("dd MMM yyyy") ?? "Ongoing")</div>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </details>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900 px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-400">
                            <span>@VisiblePositions.Count() matching positions · Page @SafePage of @PageCount</span>
                            <div class="flex items-center gap-2">
                                <label class="inline-flex items-center gap-1.5">Rows
                                    <select class="h-7 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-1.5 text-xs" @bind="pageSize" @bind:after="ResetPage">
                                        <option value="10">10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                </label>
                                <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@(SafePage <= 1)" @onclick="() => page = SafePage - 1">Previous</button>
                                <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@(SafePage >= PageCount)" @onclick="() => page = SafePage + 1">Next</button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="po-cards-grid">
                        @foreach (var position in VisiblePositions)
                        {
                            var staff = StaffFor(position).ToList();
                            <details @key="position.Id" class="group min-w-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-teal-400 dark:hover:border-teal-600 transition-colors">
                                <summary class="cursor-pointer list-none p-3.5 transition-colors hover:bg-slate-50/80 dark:hover:bg-slate-800/40 focus-visible:outline-none">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="min-w-0 break-words text-xs font-bold text-slate-900 dark:text-slate-100">@position.Name</span>
                                        <span aria-hidden="true" class="shrink-0 text-slate-400 transition-transform group-open:rotate-180">⌄</span>
                                    </div>
                                    <div class="mt-2 flex items-center gap-1.5 flex-wrap">
                                        <span class="rounded-md border border-slate-200 dark:border-slate-700 px-1.5 py-0.5 text-[10px] font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                            @(position.IsGlobal ? "Global" : "Organisation")
                                        </span>
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(position.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-200")">
                                            @(position.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </div>
                                    <div class="mt-2.5 flex items-end justify-between border-t border-slate-100 dark:border-slate-800 pt-2">
                                        <span class="text-xs text-slate-500">
                                            <strong class="text-sm font-bold text-slate-900 dark:text-slate-100 tabular-nums">@staff.Select(x => x.IndividualId).Distinct().Count()</strong> staff
                                        </span>
                                        <span class="text-[11px] font-semibold text-teal-700 dark:text-teal-400">
                                            View staff
                                        </span>
                                    </div>
                                </summary>
                                @if (staff.Count == 0)
                                {
                                    <div class="border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30 p-3 text-center text-xs text-slate-400">
                                        No currently assigned staff.
                                    </div>
                                }
                                else
                                {
                                    <ul class="divide-y divide-slate-100 dark:divide-slate-800 border-t border-slate-100 dark:border-slate-800 bg-slate-50/30 dark:bg-slate-950/20">
                                        @foreach (var employee in staff)
                                        {
                                            <li class="flex flex-wrap items-start justify-between gap-2 p-3 text-xs hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                                <div class="min-w-0">
                                                    <a href="/admin/my/workspace?entityType=Staff&entityId=@employee.IndividualId" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline">
                                                        @employee.Name
                                                    </a>
                                                    <p class="mt-0.5 text-[11px] text-slate-500">@employee.Department</p>
                                                    <p class="mt-0.5 font-mono text-[10px] text-slate-400">
                                                        @employee.From.ToString("dd MMM yyyy") – @(employee.To?.ToString("dd MMM yyyy") ?? "Ongoing")
                                                    </p>
                                                </div>
                                                <span class="rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-300">
                                                    @employee.Status
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </details>
                        }
                    </div>
                }
            </div>

            <!-- Right Sidebar: Filter & Position Schemes Summary -->
            <aside class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden min-w-0">
                <div class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 px-3.5 py-2.5">
                    <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Filter &amp; Schemes</h3>
                </div>
                <div class="p-3.5 space-y-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Search</label>
                        <input aria-label="Search positions or staff"
                               type="search"
                               placeholder="Position, staff or department…"
                               @bind="search"
                               @bind:event="oninput"
                               class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-teal-600 focus:outline-none" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">Type</label>
                        <select class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-600 focus:outline-none" @bind="positionType">
                            <option value="">All types</option>
                            <option value="custom">Custom / Existing</option>
                            <option value="matrix">Government Job Matrix</option>
                        </select>
                    </div>

                    <div class="border-t border-slate-200 dark:border-slate-800 pt-3 space-y-2">
                        <h4 class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Position Schemes</h4>
                        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-3 py-2 flex items-center justify-between">
                            <span class="text-xs font-medium text-slate-600 dark:text-slate-300">Custom / Existing</span>
                            <span class="text-sm font-bold text-slate-900 dark:text-slate-100 tabular-nums">@data.Positions.Count(x => !x.MatrixId.HasValue)</span>
                        </div>
                        <div class="rounded-lg border border-teal-200/80 dark:border-teal-800 bg-teal-50/50 dark:bg-teal-950/30 px-3 py-2 flex items-center justify-between">
                            <span class="text-xs font-medium text-teal-800 dark:text-teal-300">Gov. Job Matrix</span>
                            <span class="text-sm font-bold text-teal-900 dark:text-teal-200 tabular-nums">@data.Positions.Count(x => x.MatrixId.HasValue)</span>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    }
</section>

<style>
    .po-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
    }

    @@media (min-width: 1024px) {
        .po-layout {
            grid-template-columns: minmax(0, 3fr) minmax(260px, 1fr);
        }
    }

    .po-cards-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
    }

    @@media (min-width: 640px) {
        .po-cards-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

@code {
    private PositionOverviewData? data;
    private bool loading = true;
    private string search = "";
    private bool tableView = true;
    private bool sortDescending;
    private int page = 1;
    private int pageSize = 25;
    private int PageCount => Math.Max(1,(VisiblePositions.Count()+pageSize-1)/pageSize);
    private int SafePage => Math.Clamp(page,1,PageCount);
    private void ResetPage()=>page=1;
    private IEnumerable<PositionOverviewRow> TablePositions => (sortDescending ? VisiblePositions.OrderByDescending(x=>x.Name) : VisiblePositions.OrderBy(x=>x.Name)).ThenBy(x=>x.Id).Skip((SafePage-1)*pageSize).Take(pageSize);
    private string positionType = "";
    private string? error;
    private int CurrentStaffCount => data?.Positions.SelectMany(x => x.Staff).Where(x => x.IsCurrent).Select(x => x.IndividualId).Distinct().Count() ?? 0;
    private IEnumerable<PositionOverviewStaff> StaffFor(PositionOverviewRow position) => position.Staff.Where(x => x.IsCurrent);
    private bool Matches(string value) => value.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);
    private IEnumerable<PositionOverviewRow> VisiblePositions => data?.Positions.Where(p => (positionType == "" || (positionType == "matrix" ? p.MatrixId.HasValue : !p.MatrixId.HasValue))).Where(p => string.IsNullOrWhiteSpace(search) || Matches(p.Name) ||
        StaffFor(p).Any(s => Matches(s.Name) || Matches(s.Department))) ?? [];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null; data = null;
        try { data = await Overview.LoadAsync(); }
        catch (UnauthorizedAccessException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Unable to load position overview"); error = "Positions could not be loaded. Please try again."; }
        finally { loading = false; }
    }
}
