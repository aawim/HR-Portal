@using HRM.DTOs
@using HRM.Services
@inject HRM.Services.Contracts.PositionOverviewServiceContracts.IOperations Overview
@inject ILogger<PositionOverview> Logger

<section class="position-overview-page w-full min-w-0 p-2 space-y-4">
    <header class="sticky top-0 z-20 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-3 py-3 shadow-xs rounded-xl">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-slate-900">Position Overview</h2>
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">
                    @(data?.Organisation ?? "Positions")
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">Existing positions and currently assigned staff members.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 disabled:opacity-50 transition-colors"
                    disabled="@loading"
                    @onclick="LoadAsync">
                <span>↻</span>
                <span>Refresh</span>
            </button>
            <a href="/admin/settings/positions/manage-positions"
               class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition-colors">
                <span>💼</span>
                <span>Manage Positions</span>
            </a>
            <a href="/admin/settings/positions/position-allowances"
               class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors">
                <span>💵</span>
                <span>Position Allowances</span>
            </a>
        </div>
    </header>

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">
            <span>@error</span>
            <button type="button" @onclick="() => error = null" class="font-bold text-rose-600 hover:text-rose-800">✕</button>
        </div>
    }

    @if (loading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="text-center">
                <div class="w-10 h-10 border-4 border-blue-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
                <p class="mt-3 text-xs text-slate-500">Loading positions…</p>
            </div>
        </div>
    }
    else if (data != null)
    {
        <div class="grid min-w-0 items-start gap-4 xl:grid-cols-3">
            <!-- Left Main Panel: Active Positions -->
            <div class="min-w-0 space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs xl:col-span-2">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Active Positions</h3>
                        <p class="text-xs text-slate-500">
                            @data.Positions.Count positions · @CurrentStaffCount current staff. Only approved, currently effective job assignments are counted.
                        </p>
                    </div>
                </div>

                <div class="relative">
                    <input aria-label="Search positions or staff"
                           type="search"
                           placeholder="Search position, staff or department…"
                           @bind="search"
                           @bind:event="oninput"
                           class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>

                @if (!VisiblePositions.Any())
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-xs text-slate-500">
                        No positions match the search criteria.
                    </div>
                }
                else
                {
                    <div class="grid items-start gap-3 sm:grid-cols-2">
                        @foreach (var position in VisiblePositions)
                        {
                            var staff = StaffFor(position).ToList();
                            <details @key="position.Id" class="group min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition shadow-xs">
                                <summary class="cursor-pointer list-none p-3.5 transition-colors hover:bg-slate-50/80 focus-visible:outline-none">
                                    <div class="flex items-start justify-between gap-3">
                                        <span class="min-w-0 break-words text-xs font-bold text-slate-900">@position.Name</span>
                                        <span aria-hidden="true" class="shrink-0 text-slate-400 transition-transform group-open:rotate-180">⌄</span>
                                    </div>
                                    <div class="mt-2 flex items-center gap-1.5">
                                        <span class="rounded px-2 py-0.5 text-[10px] font-medium bg-slate-100 text-slate-600">
                                            @(position.IsGlobal ? "Global" : "Organisation")
                                        </span>
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(position.IsActive ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-600")">
                                            @(position.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </div>
                                    <div class="mt-3 flex items-end justify-between border-t border-slate-100 pt-2">
                                        <span class="text-xs text-slate-500">
                                            <strong class="text-base font-bold text-slate-900 tabular-nums">@staff.Select(x => x.IndividualId).Distinct().Count()</strong> staff
                                        </span>
                                        <span class="text-[11px] font-medium text-blue-600 group-open:text-slate-500">
                                            View staff
                                        </span>
                                    </div>
                                </summary>
                                @if (staff.Count == 0)
                                {
                                    <div class="border-t border-slate-100 bg-slate-50/50 p-3 text-center text-xs text-slate-400">
                                        No currently assigned staff.
                                    </div>
                                }
                                else
                                {
                                    <ul class="divide-y divide-slate-100 border-t border-slate-100 bg-slate-50/30">
                                        @foreach (var employee in staff)
                                        {
                                            <li class="flex flex-wrap items-start justify-between gap-2 p-3 text-xs hover:bg-slate-50/80 transition">
                                                <div class="min-w-0">
                                                    <a href="/admin/my/workspace?entityType=Staff&entityId=@employee.IndividualId" class="font-semibold text-blue-600 hover:text-blue-800 hover:underline">
                                                        @employee.Name
                                                    </a>
                                                    <p class="mt-0.5 text-[11px] text-slate-500">@employee.Department</p>
                                                    <p class="mt-0.5 text-[11px] text-slate-400">
                                                        @employee.From.ToString("dd MMM yyyy") – @(employee.To?.ToString("dd MMM yyyy") ?? "Ongoing")
                                                    </p>
                                                </div>
                                                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-700">
                                                    @employee.Status
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </details>
                        }
                    </div>
                }
            </div>

            <!-- Right Sidebar: Position Schemes Summary -->
            <div class="space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-bold text-slate-900">Position Schemes</h3>
                    <p class="text-xs text-slate-500">Overview of configured frameworks and positions.</p>
                </div>

                <div class="space-y-2.5">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                        <span class="text-xs font-medium text-slate-500">Custom / Existing</span>
                        <div class="mt-1 flex items-baseline justify-between">
                            <span class="text-xl font-bold text-slate-900">@data.Positions.Count(x => !x.MatrixId.HasValue)</span>
                            <span class="text-[11px] text-slate-500">positions</span>
                        </div>
                    </div>

                    <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-3">
                        <span class="text-xs font-medium text-blue-700">Government Job Matrix</span>
                        <div class="mt-1 flex items-baseline justify-between">
                            <span class="text-xl font-bold text-blue-900">@data.Positions.Count(x => x.MatrixId.HasValue)</span>
                            <span class="text-[11px] text-blue-600">positions</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private PositionOverviewData? data;
    private bool loading = true;
    private string search = "";
    private string? error;
    private int CurrentStaffCount => data?.Positions.SelectMany(x => x.Staff).Where(x => x.IsCurrent).Select(x => x.IndividualId).Distinct().Count() ?? 0;
    private IEnumerable<PositionOverviewStaff> StaffFor(PositionOverviewRow position) => position.Staff.Where(x => x.IsCurrent);
    private bool Matches(string value) => value.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);
    private IEnumerable<PositionOverviewRow> VisiblePositions => data?.Positions.Where(p => string.IsNullOrWhiteSpace(search) || Matches(p.Name) ||
        StaffFor(p).Any(s => Matches(s.Name) || Matches(s.Department))) ?? [];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null; data = null;
        try { data = await Overview.LoadAsync(); }
        catch (UnauthorizedAccessException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Unable to load position overview"); error = "Positions could not be loaded. Please try again."; }
        finally { loading = false; }
    }
}
