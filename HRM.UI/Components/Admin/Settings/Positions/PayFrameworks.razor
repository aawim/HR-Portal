@using HRM.Application.Contracts.Pages
@inject IPositionManagement Service
@inject HRM.Services.ToastService Toasts
<section class="pay-frameworks space-y-3 text-sm">
    <div class="flex flex-wrap gap-2"><button class="app-button @(tab=="frameworks"?"app-button-primary":"app-button-secondary")" @onclick='()=>tab="frameworks"'>Frameworks</button><button class="app-button @(tab=="matrices"?"app-button-primary":"app-button-secondary")" @onclick='()=>tab="matrices"'>Job Matrices</button></div>
    @if(error!=null){<p role="alert" class="border rounded p-3">@error</p>}
    @if(data!=null)
    {
        @if(tab=="frameworks")
        {
            @if(data.CanManageFrameworks)
            {
                <fieldset disabled="@busy" class="grid grid-cols-1 md:grid-cols-4 gap-3 border rounded-lg p-3">
                    <label>Code<input @bind="frameworkCode" maxlength="30" disabled="@(frameworkId!=0)" /></label>
                    <label>Name<input @bind="frameworkName" maxlength="150" /></label>
                    <label><input type="checkbox" @bind="frameworkActive" /> Active</label>
                    <div class="flex gap-2 items-end"><button class="app-button app-button-primary" @onclick="SaveFramework">Save framework</button><button class="app-button app-button-secondary" @onclick="ClearFramework">Clear</button></div>
                </fieldset>
            }
            <div class="overflow-x-auto"><table><thead><tr><th>Code</th><th>Framework</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var f in data.Frameworks){<tr><td>@f.Code</td><td>@f.Name</td><td>@(f.Active?"Active":"Inactive")</td><td>@if(data.CanManageFrameworks){<button class="app-button app-button-secondary" @onclick="()=>EditFramework(f)">Edit</button>}</td></tr>}</tbody></table></div>
        }
        else
        {
            @if(data.CanManageFrameworks)
            {
                <fieldset disabled="@busy" class="space-y-3 border rounded-lg p-3">
                    <h3 class="font-semibold">@(matrixId==0?"New job matrix":"Edit unused job matrix")</h3>
                    <div class="family-picker" role="group" aria-label="Job families">
                        @foreach(var family in data.JobFamilies)
                        {
                            <button type="button" class="family-choice" aria-pressed="@(profile.JobFamilyId==family.Id)" @onclick="()=>SelectFamily(family.Id)"><JobFamilyIcon Family="@family.Name" /><span>@family.Name</span></button>
                        }
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <label>Framework<select @bind="matrixFramework"><option value="0">Select</option>@foreach(var f in data.Frameworks.Where(x=>x.Active)){<option value="@f.Id">@f.Name</option>}</select></label>
                        <label>Matrix code<input @bind="matrixCode" maxlength="60" /></label><label>Job family<select @bind="profile.JobFamilyId" @bind:after="ChangeFamily"><option value="">Select</option>@foreach(var f in data.JobFamilies){<option value="@f.Id">@f.Name</option>}</select></label><label>Profession / Occupation<select @bind="profile.ProfessionId" @bind:after="ChangeProfession"><option value="">Select</option>@foreach(var p in data.Professions.Where(x=>x.FamilyId==profile.JobFamilyId)){<option value="@p.Id">@p.Name</option>}</select></label>
                        <label>Currency<select @bind="currency"><option value="0">Select</option>@foreach(var c in data.Currencies){<option value="@c.Id">@c.Name</option>}</select></label>
                        <label>Basic salary<input type="number" min="0" step="0.01" @bind="basicSalary" /></label><label>Effective from<input type="date" @bind="from" /></label><label>Effective through<input type="date" @bind="to" /></label><label><input type="checkbox" @bind="matrixActive" /> Active</label>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <label>Revised date<input type="date" @bind="profile.RevisedDate" /></label><label>MISSCO code<select @bind="profile.MisscoCode"><option value="">Select</option>@if(SelectedProfession!=null){@foreach(var missco in SelectedProfession.MisscoCodes){<option>@missco</option>}}</select></label><label>Skill level<input type="number" min="0" max="9" @bind="profile.SkillLevel" /></label>
                        <label>Public service rank<input maxlength="50" @bind="profile.PublicServiceRank" /></label><label>Institutional category<select @bind="profile.InstitutionalCategory"><option value="">Select</option><option value="1">Category 1</option><option value="2">Category 2</option><option value="3">Category 3</option>@if(!string.IsNullOrWhiteSpace(profile.InstitutionalCategory) && profile.InstitutionalCategory is not ("1" or "2" or "3")){<option value="@profile.InstitutionalCategory">@profile.InstitutionalCategory (existing)</option>}</select></label><label>Grade code<input maxlength="50" @bind="profile.GradeCode" /></label><label>Daily attendance benefit<input type="number" min="0" step="0.01" @bind="profile.AttendanceBenefitDaily" /></label>
                        <label class="md:col-span-3">Profession description<textarea maxlength="20000" rows="2" @bind="profile.Description"></textarea></label>
                        <label>Additional licence / training notes<textarea maxlength="20000" rows="3" @bind="profile.LicensesAndTraining"></textarea></label><label>Original qualification / experience notes<textarea maxlength="20000" rows="4" @bind="profile.Qualifications"></textarea></label><label>Fields of study<select @bind="studyFieldChoice" @bind:after="AddStudyField"><option value="">Add suggested field</option>@foreach(var field in data.StudyFields.Where(x=>x.FamilyId==profile.JobFamilyId)){<option value="@field.Name">@field.Name</option>}</select><textarea maxlength="20000" rows="3" @bind="profile.FieldsOfStudy"></textarea></label><label>Areas of work experience<select @bind="experienceAreaChoice" @bind:after="AddExperienceArea"><option value="">Add suggested experience area</option>@foreach(var sector in data.ExperienceAreas.Where(x=>!x.FamilyId.HasValue||x.FamilyId==profile.JobFamilyId).GroupBy(x=>x.Sector)){<optgroup label="@sector.Key">@foreach(var area in sector){<option value="@area.Id">@area.Name</option>}</optgroup>}</select><textarea maxlength="20000" rows="3" @bind="profile.ExperienceAreas"></textarea></label><label class="md:col-span-2">Core duties<textarea maxlength="20000" rows="4" @bind="profile.Duties"></textarea></label>
                    </div>
                    <JobMatrixRequirementsEditor Profile="profile" /><details><summary>Experience verification guidance</summary><p>Record employment dates, full-time or part-time contract, exact job title and duties with supporting experience documentation. Apply post-qualification experience requirements only where specified by the applicable Job Matrix; a rank alone does not establish eligibility.</p></details><div class="flex justify-between items-center"><h4 class="font-semibold">Allowed titles</h4><button class="app-button app-button-secondary" @onclick="()=>titles.Add(new())">Add title</button></div>
                    @foreach(var t in titles){<div @key="t" class="flex gap-2"><input aria-label="Allowed title" @bind="t.Name" maxlength="250" /><button class="app-button app-button-secondary" @onclick="()=>titles.Remove(t)">Remove</button></div>}
                    <div class="flex justify-between items-center"><h4 class="font-semibold">Pay steps</h4><button class="app-button app-button-secondary" @onclick="()=>steps.Add(new(){Number=steps.Count+1})">Add step</button></div>
                    <div class="overflow-x-auto"><table><thead><tr><th>Step</th><th>Basic salary override (optional)</th><th>Job allowance</th><th>Active</th><th></th></tr></thead><tbody>@foreach(var s in steps){<tr @key="s"><td><input aria-label="Step number" type="number" min="1" @bind="s.Number" /></td><td><input aria-label="Basic salary override" type="number" min="0" step="0.01" @bind="s.Salary" /></td><td><input aria-label="Step job allowance" type="number" min="0" step="0.01" @bind="s.Allowance" /></td><td><input aria-label="Step active" type="checkbox" @bind="s.Active" /></td><td><button class="app-button app-button-secondary" @onclick="()=>steps.Remove(s)">Remove</button></td></tr>}</tbody></table></div>
                    <div class="flex justify-between items-center"><h4 class="font-semibold">Matrix allowances / benefits</h4><button class="app-button app-button-secondary" @onclick="()=>benefits.Add(new())">Add allowance</button></div>
                    <div class="overflow-x-auto"><table><thead><tr><th>Allowance</th><th>Amount (optional)</th><th>Frequency</th><th></th></tr></thead><tbody>@foreach(var b in benefits){<tr @key="b"><td><input aria-label="Allowance name" @bind="b.Name" maxlength="200" /></td><td><input aria-label="Allowance amount" type="number" min="0" step="0.01" @bind="b.Amount" /></td><td><select aria-label="Allowance frequency" @bind="b.Frequency"><option>Monthly</option><option value="SixMonthly">Six-monthly</option><option>Annually</option></select></td><td><button class="app-button app-button-secondary" @onclick="()=>benefits.Remove(b)">Remove</button></td></tr>}</tbody></table></div>
                    <div class="flex gap-2"><button class="app-button app-button-primary" @onclick="SaveMatrix">Save job matrix</button><button class="app-button app-button-secondary" @onclick="ClearMatrix">New / clear</button></div>
                </fieldset>
            }
            <div class="overflow-x-auto"><table><thead><tr><th>Framework / matrix</th><th>Salary</th><th>Titles / steps</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var m in data.Matrices){<tr><td>@data.Frameworks.FirstOrDefault(x=>x.Id==m.FrameworkId)?.Name<br />@m.Code · @m.Name</td><td>@m.BasicSalary.ToString("N2") @data.Currencies.FirstOrDefault(x=>x.Id==m.CurrencyId)?.Name</td><td><details><summary>@m.Titles.Count titles · @m.Steps.Count steps</summary><JobMatrixProfileView Profile="m.Profile" />@foreach(var t in m.Titles){<div>@t.Name</div>}@foreach(var s in m.Steps){<div>Step @s.Number · Salary @s.BasicSalary.ToString("N2") · Job allowance @s.JobAllowance.ToString("N2")</div>}@foreach(var b in m.Benefits){<div>@b.Name · @(b.Amount?.ToString("N2")??"Non-cash") · @b.Frequency</div>}</details></td><td>@(m.Active?"Active":"Inactive")</td><td>@if(data.CanManageFrameworks&&!m.InUse){<button class="app-button app-button-secondary" @onclick="()=>EditMatrix(m)">Edit</button>}else if(m.InUse){<span>In use</span>}@if(data.CanManageFrameworks){<button type="button" class="app-button app-button-secondary" @onclick="()=>CopyMatrix(m)">Copy as new version</button>}</td></tr>}</tbody></table></div>
        }
    }
</section>
@code{
    private PayFrameworkData? data;private bool busy;private string? error;private string tab="frameworks";
    private int frameworkId;private string frameworkCode="",frameworkName="";private bool frameworkActive=true;
    private string studyFieldChoice="";
    private string experienceAreaChoice="";
    private void AddExperienceArea()
    {
        var area=data?.ExperienceAreas.FirstOrDefault(x=>x.Id.ToString()==experienceAreaChoice&&(!x.FamilyId.HasValue||x.FamilyId==profile.JobFamilyId));
        if(area!=null)
        {
            var value=$"{area.Sector} — {area.Name}: {area.Description}";
            var lines=(profile.ExperienceAreas??"").Split(new[]{'\r','\n'},StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
            if(!lines.Contains(value,StringComparer.OrdinalIgnoreCase))profile.ExperienceAreas=string.IsNullOrWhiteSpace(profile.ExperienceAreas)?value:profile.ExperienceAreas.TrimEnd()+Environment.NewLine+value;
        }
        experienceAreaChoice="";
    }
    private void AddStudyField()
    {
        if(string.IsNullOrWhiteSpace(studyFieldChoice))return;
        var fields=(profile.FieldsOfStudy??"").Split(new[]{'\r','\n',';'},StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
        if(!fields.Contains(studyFieldChoice,StringComparer.OrdinalIgnoreCase))profile.FieldsOfStudy=string.IsNullOrWhiteSpace(profile.FieldsOfStudy)?studyFieldChoice:profile.FieldsOfStudy.TrimEnd()+Environment.NewLine+studyFieldChoice;
        studyFieldChoice="";
    }
    private void SelectFamily(int id){if(profile.JobFamilyId==id)return;profile.JobFamilyId=id;ChangeFamily();}
    private int matrixId,matrixFramework,currency;private string matrixCode="",matrixName="";private decimal basicSalary;private DateTime from=DateTime.UtcNow.AddHours(5).Date;private DateTime? to;private bool matrixActive=true;
    private JobMatrixProfile profile=new(); private ProfessionOption? SelectedProfession=>data?.Professions.FirstOrDefault(x=>x.Id==profile.ProfessionId); private void ChangeFamily(){profile.ProfessionId=null;profile.MisscoCode="";matrixName="";} private void ChangeProfession(){var p=SelectedProfession;if(p==null)return;matrixName=p.Name;profile.JobFamily=data?.JobFamilies.FirstOrDefault(x=>x.Id==p.FamilyId)?.Name??"";profile.Description=p.Tasks;profile.Duties=p.Tasks;profile.MisscoCode=p.MisscoCodes.FirstOrDefault()??"";titles=p.Titles.Select(x=>new TitleDraft{Name=x}).ToList();}
    private List<TitleDraft> titles=[new()];private List<StepDraft> steps=[new()];private List<BenefitDraft> benefits=[];
    private sealed class TitleDraft{public string Name{get;set;}="";}
    private sealed class StepDraft{public int Number{get;set;}=1;public decimal? Salary{get;set;}public decimal Allowance{get;set;}public bool Active{get;set;}=true;}
    private sealed class BenefitDraft{public string Name{get;set;}="";public decimal? Amount{get;set;}public string Frequency{get;set;}="Monthly";}
    protected override async Task OnInitializedAsync(){try{data=await Service.LoadPayFrameworksAsync();}catch(Exception){error="Pay frameworks could not be loaded.";}}
    private void ClearFramework(){frameworkId=0;frameworkCode="";frameworkName="";frameworkActive=true;}
    private void EditFramework(PositionFrameworkOption f){frameworkId=f.Id;frameworkCode=f.Code;frameworkName=f.Name;frameworkActive=f.Active;}
    private void ClearMatrix(){profile=new();matrixId=0;matrixFramework=0;currency=0;matrixCode="";matrixName="";basicSalary=0;from=DateTime.UtcNow.AddHours(5).Date;to=null;matrixActive=true;titles=[new()];steps=[new()];benefits=[];}
    private void EditMatrix(JobMatrixRow m){profile=m.Profile with{CredentialRequirements=m.Profile.CredentialRequirements.Select(x=>x with{}).ToList(),QualificationPathways=m.Profile.QualificationPathways.Select(x=>x with{Qualifications=x.Qualifications.Select(q=>q with{}).ToList()}).ToList()};matrixId=m.Id;matrixFramework=m.FrameworkId;currency=m.CurrencyId;matrixCode=m.Code;matrixName=m.Name;basicSalary=m.BasicSalary;from=m.From;to=m.To;matrixActive=m.Active;titles=m.Titles.Select(x=>new TitleDraft{Name=x.Name}).ToList();steps=m.Steps.Select(x=>new StepDraft{Number=x.Number,Salary=x.BasicSalary==m.BasicSalary?null:x.BasicSalary,Allowance=x.JobAllowance,Active=x.Active}).ToList();benefits=m.Benefits.Select(x=>new BenefitDraft{Name=x.Name,Amount=x.Amount,Frequency=x.Frequency}).ToList();}
    private void CopyMatrix(JobMatrixRow m){EditMatrix(m);matrixId=0;matrixCode="";profile.RequirementsVersion="";foreach(var c in profile.CredentialRequirements)c.Id=0;foreach(var p in profile.QualificationPathways){p.Id=0;foreach(var q in p.Qualifications)q.Id=0;}} private Task SaveFramework()=>Run(()=>Service.SaveFrameworkAsync(new(frameworkId,frameworkCode,frameworkName,frameworkActive)),ClearFramework);
    private Task SaveMatrix()=>Run(()=>Service.SaveJobMatrixAsync(new(matrixId,matrixFramework,matrixCode,matrixName,currency,basicSalary,from,to,matrixActive,titles.Select(x=>x.Name).ToList(),steps.Select(x=>new MatrixStepInput(x.Number,x.Allowance,x.Salary,x.Active)).ToList(),benefits.Select(x=>new MatrixBenefitInput(x.Name,x.Amount,x.Frequency)).ToList()){Profile=profile}),ClearMatrix);
    private async Task Run(Func<Task<HRM.DTOs.ServiceResult>> save,Action clear){if(busy)return;busy=true;error=null;try{var result=await save();if(result.Success){Toasts.Success(result.Message);clear();data=await Service.LoadPayFrameworksAsync();}else error=result.Message;}catch(Exception){error="The configuration could not be saved. Please try again.";}finally{busy=false;}}
}
