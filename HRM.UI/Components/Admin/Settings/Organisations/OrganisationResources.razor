@using HRM.DTOs.Organisation
@inject HRM.Services.Contracts.OrganisationResourceSettingsServiceContracts.IOperations Settings
@inject HRM.Services.ToastService Toasts

<section class="space-y-3">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800 flex-wrap gap-2">
        <div>
            <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                <span>@Title</span>
                @if (data != null)
                {
                    <span class="rounded-full bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold">
                        @Filtered.Count() records
                    </span>
                }
            </h2>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@Description</p>
        </div>
        <div class="flex items-center gap-2">
            @if (Kind == OrganisationResourceKind.Locations && data != null)
            {
                <a class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                   href="@($"/admin/my/workspace/organisation/{data.OrganisationId}/manage")">
                    Manage Organisation Addresses
                </a>
            }
            <button type="button"
                    @onclick="Refresh"
                    disabled="@busy"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition">
                <span>↻</span>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (error != null)
    {
        <div role="alert" class="rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-2.5 text-xs text-rose-800 dark:text-rose-300">
            @error
        </div>
    }

    @if (data == null && error == null)
    {
        <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            Loading @Title.ToLowerInvariant()…
        </div>
    }

    @if (data != null)
    {
        @if (IsCatalogue)
        {
            <div class="grid grid-cols-1 gap-3 xl:grid-cols-12 items-start">
                <!-- Left: Form Card -->
                <div class="xl:col-span-5 space-y-3">
                    <div class="rounded-xl border border-teal-200/70 dark:border-teal-800/40 bg-teal-50/50 dark:bg-teal-950/30 p-3 text-xs text-teal-900 dark:text-teal-200">
                        Shared reference catalogue. @(data.CanEdit ? "Changes apply across organisations." : "Super Admin manages these shared type names.")
                    </div>
                    @if (data.CanEdit)
                    {
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 px-4 py-2.5">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">@(editId == 0 ? "Add Type" : "Edit Type")</h3>
                                @if (editId > 0)
                                {
                                    <span class="rounded bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/40 px-1.5 py-0.5 text-[10px] font-semibold text-amber-700 dark:text-amber-300">Editing #@editId</span>
                                }
                            </div>
                            <div class="p-4 space-y-3">
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                    Type Name
                                    <input class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                           maxlength="250"
                                           placeholder="Enter type name…"
                                           @bind="name"
                                           disabled="@busy" />
                                </label>
                                <div class="flex flex-wrap items-center gap-2 pt-1">
                                    <button type="button"
                                            class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 text-white px-3 py-1.5 text-xs font-semibold shadow-xs disabled:opacity-50 transition"
                                            disabled="@(busy || string.IsNullOrWhiteSpace(name))"
                                            @onclick="SaveType">
                                        @(editId == 0 ? "+ Save Type" : "Save Changes")
                                    </button>
                                    <button type="button"
                                            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                                            disabled="@busy"
                                            @onclick="Reset">
                                        Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Right: Catalogue Table -->
                <div class="xl:col-span-7 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-4 py-2.5">
                        <div class="flex-1 min-w-[200px]">
                            <input class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                   type="search"
                                   @bind="search"
                                   @bind:event="oninput"
                                   placeholder="Search name, reference or type…" />
                        </div>
                        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">@Filtered.Count() shown</span>
                    </div>

                    @if (!Filtered.Any())
                    {
                        <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400 p-6">
                            No matching records found.
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 dark:bg-slate-800/60 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                                    <tr>
                                        <th class="px-3 py-2.5">Name</th>
                                        <th class="px-3 py-2.5">Details</th>
                                        <th class="px-3 py-2.5">Status</th>
                                        <th class="px-3 py-2.5 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                    @foreach (var row in Filtered)
                                    {
                                        <tr @key="row.Id" class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition @(editId == row.Id ? "bg-teal-50/40 dark:bg-teal-950/20" : null)">
                                            <td class="px-3 py-2.5 font-semibold text-slate-900 dark:text-slate-100">@row.Name</td>
                                            <td class="px-3 py-2.5 text-slate-600 dark:text-slate-400">@(string.IsNullOrWhiteSpace(row.Detail) ? "—" : row.Detail)</td>
                                            <td class="px-3 py-2.5">
                                                @if (!string.IsNullOrWhiteSpace(row.Status))
                                                {
                                                    <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-300">@row.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">—</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                                @if (data.CanEdit)
                                                {
                                                    <button type="button"
                                                            class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-[11px] font-semibold text-teal-700 dark:text-teal-400 hover:bg-teal-50 dark:hover:bg-slate-700 disabled:opacity-50 transition"
                                                            disabled="@busy"
                                                            @onclick="() => Edit(row)">
                                                        Edit
                                                    </button>
                                                }
                                                @if (row.Url != null)
                                                {
                                                    <a class="ml-1 inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                                       href="@row.Url">View</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Organisation Scope & Calendar Form -->
            <div class="grid grid-cols-1 gap-3 @(Kind == OrganisationResourceKind.Calendar && data.CanEdit ? "xl:grid-cols-12" : null) items-start">
                @if (Kind == OrganisationResourceKind.Calendar && data.CanEdit)
                {
                    <div class="xl:col-span-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                        <div class="border-b border-slate-100 dark:border-slate-800 px-4 py-2.5">
                            <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100">Assign Calendar</h3>
                        </div>
                        <div class="p-4 space-y-3">
                            @if (data.IsSuperAdmin)
                            {
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                    Organisation
                                    <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                            value="@data.OrganisationId"
                                            disabled="@busy"
                                            @onchange="ChangeOrganisation">
                                        @foreach (var org in data.Organisations)
                                        {
                                            <option value="@org.Id">@org.Name</option>
                                        }
                                    </select>
                                </label>
                            }
                            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                Calendar
                                <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                        @bind="calendarId"
                                        disabled="@busy">
                                    <option value="0">Select a calendar</option>
                                    @foreach (var c in data.Calendars)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </label>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                    Effective From
                                    <input class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                           type="date"
                                           @bind="from"
                                           disabled="@busy" />
                                </label>
                                <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                    Effective To (Optional)
                                    <input class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                           type="date"
                                           @bind="to"
                                           disabled="@busy" />
                                </label>
                            </div>
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 text-white px-3 py-1.5 text-xs font-semibold shadow-xs disabled:opacity-50 transition"
                                    disabled="@(busy || calendarId == 0)"
                                    @onclick="LinkCalendar">
                                + Assign Calendar
                            </button>
                        </div>
                    </div>
                }

                <!-- Resource Table -->
                <div class="@(Kind == OrganisationResourceKind.Calendar && data.CanEdit ? "xl:col-span-7" : "w-full") rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                    <div class="flex flex-wrap items-end gap-2 border-b border-slate-100 dark:border-slate-800 px-4 py-3">
                        @if (data.IsSuperAdmin && !(Kind == OrganisationResourceKind.Calendar && data.CanEdit))
                        {
                            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 min-w-[200px]">
                                Organisation
                                <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                        value="@data.OrganisationId"
                                        disabled="@busy"
                                        @onchange="ChangeOrganisation">
                                    @foreach (var org in data.Organisations)
                                    {
                                        <option value="@org.Id">@org.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        <label class="block flex-1 min-w-[180px] text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                            Search
                            <input class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                   type="search"
                                   @bind="search"
                                   @bind:event="oninput"
                                   placeholder="Search name, reference or type…" />
                        </label>
                        @if (Kind == OrganisationResourceKind.Requests)
                        {
                            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                                Status
                                <select class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                                        @bind="status">
                                    <option value="">All statuses</option>
                                    @foreach (var state in data.Rows.Select(r => r.Status).Distinct().Order())
                                    {
                                        <option value="@state">@state</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>

                    @if (Kind == OrganisationResourceKind.Requests)
                    {
                        <p class="px-4 py-2 text-[11px] text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800">
                            Showing the latest 100 requests in this organisation. Open a request to use its existing approval process.
                        </p>
                    }

                    @if (!Filtered.Any())
                    {
                        <div class="py-10 text-center text-xs text-slate-500 dark:text-slate-400 p-6">
                            No matching records found.
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 dark:bg-slate-800/60 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                                    <tr>
                                        <th class="px-3 py-2.5">Name</th>
                                        <th class="px-3 py-2.5">Details</th>
                                        <th class="px-3 py-2.5">Status</th>
                                        @if (Filtered.Any(r => r.Url != null))
                                        {
                                            <th class="px-3 py-2.5 text-right">Actions</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                    @foreach (var row in Filtered)
                                    {
                                        <tr @key="row.Id" class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                                            <td class="px-3 py-2.5 font-semibold text-slate-900 dark:text-slate-100">@row.Name</td>
                                            <td class="px-3 py-2.5 text-slate-600 dark:text-slate-400">@(string.IsNullOrWhiteSpace(row.Detail) ? "—" : row.Detail)</td>
                                            <td class="px-3 py-2.5">
                                                @if (!string.IsNullOrWhiteSpace(row.Status))
                                                {
                                                    <span class="rounded bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/40 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-400">@row.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">—</span>
                                                }
                                            </td>
                                            @if (Filtered.Any(r => r.Url != null))
                                            {
                                                <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                                    @if (row.Url != null)
                                                    {
                                                        <a class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-[11px] font-semibold text-teal-700 dark:text-teal-400 hover:bg-teal-50 dark:hover:bg-slate-700 transition"
                                                           href="@row.Url">View →</a>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>

@code {
    [Parameter] public OrganisationResourceKind Kind { get; set; }
    private OrganisationResourceData? data;
    private OrganisationResourceKind? loadedKind;
    private bool busy;
    private int editId, calendarId;
    private string search = "", name = "", status = "";
    private string? expectedName, error;
    private DateTime from = DateTime.UtcNow.AddHours(5).Date;
    private DateTime? to;
    private bool IsCatalogue => (Kind is OrganisationResourceKind.StructureTypes or OrganisationResourceKind.LocationTypes or OrganisationResourceKind.OrganisationTypes or OrganisationResourceKind.StructureRequestTypes);
    private string Title => Kind switch { OrganisationResourceKind.StructureTypes => "Structure Types", OrganisationResourceKind.Calendar => "Calendar", OrganisationResourceKind.Locations => "Locations", OrganisationResourceKind.LocationTypes => "Location Types", OrganisationResourceKind.OrganisationTypes => "Organisation Types", OrganisationResourceKind.StructureRequestTypes => "Structure Request Types", _ => "Requests" };
    private string Description => Kind switch { OrganisationResourceKind.StructureTypes => "Organisation Structure Types, such as departments and divisions.", OrganisationResourceKind.Calendar => "Calendars assigned to the organisation and their effective periods.", OrganisationResourceKind.Locations => "Organisation locations and addresses, using the existing address editor.", OrganisationResourceKind.StructureRequestTypes => "Request types used for organisation structure changes.", OrganisationResourceKind.Requests => "Review requests belonging to the selected organisation.", _ => "Manage shared reference type names." };
    private IEnumerable<OrganisationResourceRow> Filtered => data?.Rows.Where(r => (status == "" || r.Status == status) && (r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Detail.Contains(search, StringComparison.OrdinalIgnoreCase))) ?? [];
    protected override async Task OnParametersSetAsync() { if (loadedKind != Kind) { loadedKind = Kind; search = status = ""; Reset(); await Load(); } }
    private async Task Refresh() => await Load(data?.OrganisationId);
    private async Task Load(int? org = null)
    {
        error = null;
        try { data = await Settings.LoadAsync(Kind, org); }
        catch (Exception ex) { data = null; error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Organisation information could not be loaded. Please try again."; }
    }
    private async Task ChangeOrganisation(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var id)) { search = status = ""; calendarId = 0; await Load(id); } }
    private void Edit(OrganisationResourceRow row) { editId = row.Id; name = row.Name; expectedName = row.Name; }
    private void Reset() { editId = 0; name = ""; expectedName = null; }
    private Task SaveType() => Execute(() => Settings.SaveTypeAsync(Kind, editId, name, expectedName));
    private Task LinkCalendar() => Execute(() => Settings.LinkCalendarAsync(data!.OrganisationId, calendarId, from, to));
    private async Task Execute(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return; busy = true; error = null;
        try { var result = await action(); if (result.Success) { Toasts.Success(result.Message); Reset(); await Load(data?.OrganisationId); } else error = result.Message; }
        catch (Exception ex) { error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "The change could not be saved. Please refresh and try again."; }
        finally { busy = false; }
    }
}
