@page "/admin/settings/organisation-permissions"
@using HRM.DTOs.Organisation
@using HRM.DTOs.Roles
@using HRM.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HRM.Services.Contracts.OrganisationPermissionServiceContracts.IOperations Settings
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Organisation permissions</PageTitle>

<section class="w-full min-w-0 @(HideHeader ? "space-y-4" : "p-2 space-y-4")">
    @if (!HideHeader)
    {
        <header class="sticky top-0 z-30 m-0 flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs px-3 py-3 shadow-xs rounded-2xl">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">Organisation Permissions</h1>
                    @if (data != null)
                    {
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @(Dirty ? "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200" : "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200")">
                            @(Dirty ? $"{Added.Count + Removed.Count} pending" : "Saved")
                        </span>
                    }
                </div>
                <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                    Control which resources the organisation can access. Direct permissions and User Groups cannot exceed these limits.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        class="app-button app-button-neutral app-button-sm"
                        @onclick="ToggleFullWidthAsync">
                    <i class="bi @(isFullWidth ? "bi-arrows-angle-contract" : "bi-arrows-angle-expand")"></i>
                    @(isFullWidth ? "Shrink View" : "Full Width")
                </button>
                <button type="button"
                        class="app-button app-button-secondary app-button-sm"
                        @onclick="Refresh"
                        disabled="@(busy || Dirty)">
                    <i class="bi bi-arrow-clockwise"></i>
                    Refresh
                </button>
            </div>
        </header>
    }

    <div class="mx-auto w-full min-w-0 space-y-4 @(HideHeader || isFullWidth ? "max-w-none" : "max-w-7xl")">
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="flex items-center justify-between gap-3 rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50 dark:bg-rose-950/40 p-3 text-xs text-rose-800 dark:text-rose-200" role="alert">
                <div class="flex items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill shrink-0"></i>
                    <span>@error</span>
                </div>
                <button type="button" class="text-rose-700 dark:text-rose-300 hover:underline font-semibold" @onclick="() => error = string.Empty">Dismiss</button>
            </div>
        }

        @if (data == null && string.IsNullOrEmpty(error))
        {
            <div class="flex flex-col items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-10 text-center shadow-xs" role="status">
                <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-600 border-t-transparent"></div>
                <p class="mt-3 text-xs font-semibold text-slate-700 dark:text-slate-200">Loading organisation permissions…</p>
            </div>
        }

        @if (data != null)
        {
            <!-- 2-Column Layout: Form & Controls (Left) | Permissions Catalog (Right) -->
            <div class="org-perm-panels">
                <!-- LEFT COLUMN: Organisation, Stats, Filters, and Review & Save Form -->
                <aside class="min-w-0 lg:sticky lg:top-4 space-y-4">
                    <!-- Organisation & KPI Card -->
                    <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                @if (data.IsSuperAdmin)
                                {
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Organisation</label>
                                    <select class="mt-0.5 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs font-medium text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:opacity-60"
                                            value="@data.OrganisationId"
                                            @onchange="ChangeOrganisation"
                                            disabled="@(busy || Dirty)">
                                        @foreach (var org in data.Organisations)
                                        {
                                            <option value="@org.Id">@org.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">@data.OrganisationName</h2>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Organisation permission ceiling</p>
                                }
                            </div>
                            @if (HideHeader)
                            {
                                <button type="button"
                                        class="app-button app-button-secondary app-button-sm shrink-0 mt-5"
                                        @onclick="Refresh"
                                        disabled="@(busy || Dirty)">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    Refresh
                                </button>
                            }
                        </div>

                        <!-- Compact 2x2 KPI Strip -->
                        <div class="grid grid-cols-2 gap-2">
                            <div class="rounded-xl border border-emerald-200/80 dark:border-emerald-900/50 bg-emerald-50/50 dark:bg-emerald-950/30 px-3 py-2">
                                <div class="text-[11px] font-medium text-emerald-700 dark:text-emerald-300">Enabled</div>
                                <div class="mt-0.5 text-base font-bold text-emerald-900 dark:text-emerald-100">@selected.Count</div>
                            </div>
                            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/50 px-3 py-2">
                                <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Unavailable</div>
                                <div class="mt-0.5 text-base font-bold text-slate-800 dark:text-slate-100">@(data.Permissions.Count - selected.Count)</div>
                            </div>
                            <div class="rounded-xl border border-blue-200/80 dark:border-blue-900/50 bg-blue-50/50 dark:bg-blue-950/30 px-3 py-2">
                                <div class="text-[11px] font-medium text-blue-700 dark:text-blue-300">Accounts</div>
                                <div class="mt-0.5 text-base font-bold text-blue-900 dark:text-blue-100">@data.AccountCount</div>
                            </div>
                            <div class="rounded-xl border px-3 py-2 @(Dirty ? "border-amber-200 dark:border-amber-800 bg-amber-50/60 dark:bg-amber-950/30" : "border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/50")" role="status">
                                <div class="text-[11px] font-medium @(Dirty ? "text-amber-700 dark:text-amber-300" : "text-slate-500 dark:text-slate-400")">Status</div>
                                <div class="mt-0.5 text-xs font-bold @(Dirty ? "text-amber-900 dark:text-amber-100" : "text-emerald-700 dark:text-emerald-300")">
                                    @(Dirty ? $"+{Added.Count} / -{Removed.Count}" : "Saved")
                                </div>
                            </div>
                        </div>

                        <!-- Policy Note -->
                        <div class="flex items-start gap-2 rounded-xl border border-blue-200/70 dark:border-blue-900/50 bg-blue-50/40 dark:bg-blue-950/20 px-3 py-2 text-[11px] leading-relaxed text-slate-700 dark:text-slate-300">
                            <i class="bi bi-info-circle-fill mt-0.5 shrink-0 text-blue-600 dark:text-blue-400"></i>
                            <div class="space-y-1">
                                <p>Removing a permission blocks it even when assigned directly or via User Groups. Admin portal access still requires an approved grant.</p>
                                @if (!data.CanEdit)
                                {
                                    <p class="font-semibold text-amber-700 dark:text-amber-300">View-only access. Contact a Super Administrator to make changes.</p>
                                }
                                @if (Dirty)
                                {
                                    <p class="font-semibold text-amber-700 dark:text-amber-300">Save or reset pending changes before switching organisations or refreshing.</p>
                                }
                            </div>
                        </div>
                    </section>

                    <!-- Review & Save Form Card -->
                    @if (data.CanEdit)
                    {
                        <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-3">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2.5">
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Review &amp; Save</h3>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400">All permission changes are audit logged.</p>
                                </div>
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold @(Dirty ? "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300")">
                                    @(Added.Count + Removed.Count) change(s)
                                </span>
                            </div>

                            @if (Dirty)
                            {
                                <div class="max-h-48 overflow-y-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2 space-y-1.5">
                                    @foreach (var p in data.Permissions.Where(p => Added.Contains(p.Id) || Removed.Contains(p.Id)))
                                    {
                                        var isAdd = Added.Contains(p.Id);
                                        <div class="flex items-center justify-between gap-2 rounded-lg bg-white dark:bg-slate-900 px-2.5 py-1.5 border border-slate-200/70 dark:border-slate-700/70 text-[11px]">
                                            <span class="min-w-0 truncate font-mono text-slate-700 dark:text-slate-200" title="@p.Key">@p.Key</span>
                                            <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold @(isAdd ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-200" : "bg-rose-100 text-rose-800 dark:bg-rose-900/60 dark:text-rose-200")">
                                                @(isAdd ? "Enable" : "Disable")
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="rounded-xl border border-dashed border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/30 p-3.5 text-center text-xs text-slate-500 dark:text-slate-400">
                                    Toggle permissions on the right to stage changes.
                                </div>
                            }

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">
                                    Reason for change <span class="text-rose-500">*</span>
                                </label>
                                <textarea rows="3"
                                          maxlength="1000"
                                          placeholder="Explain why these organisation permissions are being updated…"
                                          @bind="reason"
                                          @bind:event="oninput"
                                          disabled="@busy"
                                          class="mt-0.5 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:opacity-60"></textarea>
                                <div class="mt-0.5 text-right text-[10px] text-slate-400">@reason.Length / 1000</div>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 pt-1">
                                <button type="button"
                                        class="app-button app-button-primary app-button-sm flex-1"
                                        disabled="@(busy || !Dirty || string.IsNullOrWhiteSpace(reason))"
                                        @onclick="Save">
                                    @(busy ? "Saving…" : "Save permissions")
                                </button>
                                <button type="button"
                                        class="app-button app-button-neutral app-button-sm"
                                        disabled="@(busy || !Dirty)"
                                        @onclick="Reset">
                                    Reset
                                </button>
                            </div>
                        </section>
                    }
                </aside>

                <!-- RIGHT COLUMN: Filters & Grouped Permissions Catalog -->
                <div class="min-w-0 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs space-y-4">
                    <!-- Filter Controls -->
                    <div class="grid gap-3 sm:grid-cols-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Search permissions</label>
                            <input type="search"
                                   placeholder="Name, permission key or area…"
                                   @bind="search"
                                   @bind:event="oninput"
                                   class="mt-0.5 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Show</label>
                            <select @bind="filter"
                                    class="mt-0.5 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="all">All permissions</option>
                                <option value="enabled">Enabled</option>
                                <option value="disabled">Unavailable</option>
                                <option value="changed">Changed</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 p-1">Area</label>
                            <select @bind="area"
                                    class="mt-0.5 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">All areas</option>
                                @foreach (var item in data.Permissions.Select(p => p.Group).Distinct().Order())
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Toolbar -->
                    <div class="flex flex-wrap items-center justify-between gap-2 border-y border-slate-100 dark:border-slate-800 py-2.5">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">
                            Showing <span class="text-slate-900 dark:text-slate-100">@Visible.Count()</span> of @data.Permissions.Count permissions
                        </span>
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="button"
                                    class="app-button app-button-ghost app-button-sm"
                                    @onclick="() => expandAll = !expandAll">
                                @(expandAll ? "Collapse all" : "Expand all")
                            </button>
                            @if (data.CanEdit)
                            {
                                <button type="button"
                                        class="app-button app-button-secondary app-button-sm"
                                        disabled="@busy"
                                        @onclick="() => SelectVisible(true)">
                                    Enable displayed
                                </button>
                                <button type="button"
                                        class="app-button app-button-neutral app-button-sm"
                                        disabled="@busy"
                                        @onclick="() => SelectVisible(false)">
                                    Disable displayed
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Grouped Permissions List -->
                    <div class="space-y-3">
                        @{
                            var groups = Visible.GroupBy(p => p.Group).OrderBy(g => g.Key).ToList();
                        }
                        @if (groups.Count == 0)
                        {
                            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 py-10 text-center text-xs text-slate-500 dark:text-slate-400">
                                No permissions match these filters.
                            </div>
                        }
                        else
                        {
                            @foreach (var group in groups)
                            {
                                var enabledCount = group.Count(p => selected.Contains(p.Id));
                                var totalCount = group.Count();
                                var groupItems = group.ToList();
                                var isOpen = expandAll || !string.IsNullOrWhiteSpace(search) || area != "" || filter != "all";

                                <details class="group/acc rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-800/30 overflow-hidden" open="@isOpen">
                                    <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3.5 py-2.5 bg-slate-50/80 dark:bg-slate-800/60 hover:bg-slate-100/80 dark:hover:bg-slate-800 transition-colors">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <i class="bi bi-chevron-right text-[11px] text-slate-400 transition-transform group-open/acc:rotate-90"></i>
                                            <span class="truncate text-xs font-bold text-slate-800 dark:text-slate-100">@group.Key</span>
                                            <span class="inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @(enabledCount == totalCount ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200" : enabledCount > 0 ? "bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200" : "bg-slate-200/80 text-slate-600 dark:bg-slate-700 dark:text-slate-300")">
                                                @enabledCount / @totalCount enabled
                                            </span>
                                        </div>
                                        @if (data.CanEdit)
                                        {
                                            <div class="flex items-center gap-1.5 shrink-0" @onclick:stopPropagation="true">
                                                <button type="button"
                                                        class="rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-50"
                                                        disabled="@busy"
                                                        @onclick="() => SelectGroup(groupItems, true)">
                                                    All
                                                </button>
                                                <button type="button"
                                                        class="rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-50"
                                                        disabled="@busy"
                                                        @onclick="() => SelectGroup(groupItems, false)">
                                                    None
                                                </button>
                                            </div>
                                        }
                                    </summary>

                                    <div class="grid gap-2 border-t border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/80 p-3 md:grid-cols-2">
                                        @foreach (var permission in groupItems)
                                        {
                                            var isChecked = selected.Contains(permission.Id);
                                            var wasChecked = baseline.Contains(permission.Id);
                                            var isChanged = isChecked != wasChecked;
                                            var isLocked = !isChecked && !data.AssignableIds.Contains(permission.Id);

                                            <label class="flex items-start gap-2.5 rounded-xl border p-2.5 transition-colors @(isLocked || !data.CanEdit ? "cursor-default" : "cursor-pointer") @(isChanged ? "border-amber-300 dark:border-amber-700 bg-amber-50/50 dark:bg-amber-950/25 ring-1 ring-amber-200/70 dark:ring-amber-900/40" : isChecked ? "border-emerald-200/90 dark:border-emerald-900/60 bg-emerald-50/30 dark:bg-emerald-950/15 hover:bg-emerald-50/60 dark:hover:bg-emerald-950/30" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/60")"
                                                   @key="permission.Id">
                                                <input type="checkbox"
                                                       class="mt-0.5 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-blue-600 focus:ring-blue-500 disabled:opacity-50"
                                                       checked="@isChecked"
                                                       disabled="@(busy || !data.CanEdit || isLocked)"
                                                       @onchange="e => Toggle(permission.Id, e.Value is true)" />
                                                <span class="min-w-0 flex-1">
                                                    <span class="flex flex-wrap items-center gap-1.5">
                                                        <span class="text-xs font-semibold text-slate-900 dark:text-slate-100">@permission.Name</span>
                                                        @if (isChanged)
                                                        {
                                                            <span class="inline-flex rounded-full px-1.5 py-0.5 text-[10px] font-semibold @(isChecked ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-200" : "bg-rose-100 text-rose-800 dark:bg-rose-900/60 dark:text-rose-200")">
                                                                @(isChecked ? "Adding" : "Removing")
                                                            </span>
                                                        }
                                                    </span>
                                                    <span class="mt-0.5 block break-all font-mono text-[11px] text-slate-500 dark:text-slate-400">@permission.Key</span>
                                                    @if (!string.IsNullOrEmpty(permission.Description))
                                                    {
                                                        <span class="mt-1 block text-[11px] leading-relaxed text-slate-600 dark:text-slate-300">@permission.Description</span>
                                                    }
                                                    @if (isLocked)
                                                    {
                                                        <span class="mt-1 inline-flex items-center gap-1 text-[11px] font-medium text-amber-700 dark:text-amber-300">
                                                            <i class="bi bi-lock-fill text-[10px]"></i>
                                                            Super Admin must enable this permission.
                                                        </span>
                                                    }
                                                </span>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .org-perm-panels {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 1rem;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    @@media (min-width: 1024px) {
        .org-perm-panels {
            grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        }
    }
</style>

@code {
    private const string FullWidthStorageKey = "hrm.org-permissions.full-width";

    [Parameter] public int? InitialOrganisationId { get; set; }
    [Parameter] public bool HideHeader { get; set; }

    private int? lastInitialOrgId;
    private OrganisationPermissionData? data;
    private HashSet<int> selected = [], baseline = [];
    private string search = "", filter = "all", area = "", reason = "", error = "";
    private bool busy;
    private bool isFullWidth;
    private bool expandAll;

    private bool Dirty => !selected.SetEquals(baseline);
    private HashSet<int> Added => selected.Except(baseline).ToHashSet();
    private HashSet<int> Removed => baseline.Except(selected).ToHashSet();

    private IEnumerable<PermissionDefinitionDto> Visible => (data?.Permissions ?? []).Where(p =>
        (area == "" || area == p.Group) &&
        (p.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         p.Key.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         p.Group.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (filter == "all" ||
         filter == "enabled" && selected.Contains(p.Id) ||
         filter == "disabled" && !selected.Contains(p.Id) ||
         filter == "changed" && selected.Contains(p.Id) != baseline.Contains(p.Id)));

    protected override async Task OnInitializedAsync()
    {
        lastInitialOrgId = InitialOrganisationId;
        await Load(InitialOrganisationId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !HideHeader)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", FullWidthStorageKey);
                if (string.Equals(saved, "true", StringComparison.OrdinalIgnoreCase))
                {
                    isFullWidth = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore localStorage unavailability.
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (InitialOrganisationId != lastInitialOrgId && !Dirty)
        {
            lastInitialOrgId = InitialOrganisationId;
            await Load(InitialOrganisationId);
        }
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", FullWidthStorageKey, isFullWidth ? "true" : "false");
        }
        catch
        {
            // Ignore localStorage unavailability.
        }
    }

    private async Task Refresh()
    {
        if (!Dirty) await Load(data?.OrganisationId);
    }

    private async Task Load(int? org = null)
    {
        error = "";
        try
        {
            data = await Settings.LoadAsync(org);
            baseline = data.AllowedIds.ToHashSet();
            selected = baseline.ToHashSet();
            reason = "";
        }
        catch (Exception ex)
        {
            data = null;
            error = ex is UnauthorizedAccessException or InvalidOperationException
                ? ex.Message
                : "Organisation permissions could not be loaded. Please try again.";
        }
    }

    private async Task ChangeOrganisation(ChangeEventArgs e)
    {
        if (!Dirty && int.TryParse(e.Value?.ToString(), out var org))
        {
            search = "";
            area = "";
            filter = "all";
            await Load(org);
        }
    }

    private void Reset()
    {
        selected = baseline.ToHashSet();
        reason = "";
        error = "";
    }

    private void Toggle(int id, bool enabled)
    {
        if (enabled && data?.AssignableIds.Contains(id) == true) selected.Add(id);
        else if (!enabled) selected.Remove(id);
    }

    private void SelectVisible(bool enabled)
    {
        foreach (var p in Visible.ToList()) Toggle(p.Id, enabled);
    }

    private void SelectGroup(IReadOnlyList<PermissionDefinitionDto> items, bool enabled)
    {
        foreach (var p in items) Toggle(p.Id, enabled);
    }

    private async Task Save()
    {
        if (busy || data == null || !Dirty) return;
        busy = true;
        error = "";
        try
        {
            var result = await Settings.SaveAsync(data.OrganisationId, selected.ToArray(), baseline.ToArray(), reason);
            if (result.Success)
            {
                Toasts.Success(result.Message);
                await Load(data.OrganisationId);
            }
            else
            {
                error = result.Message;
            }
        }
        catch (Exception ex)
        {
            error = ex is UnauthorizedAccessException or InvalidOperationException
                ? ex.Message
                : "The change could not be saved. Refresh and try again.";
        }
        finally
        {
            busy = false;
        }
    }
}
