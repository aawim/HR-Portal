@page "/admin/settings/organisation-permissions"
@page "/online/organisation-permissions"
@using HRM.DTOs.Organisation
@using HRM.DTOs.Roles
@using HRM.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HRM.Services.Contracts.OrganisationPermissionServiceContracts.IOperations Settings
@inject ToastService Toasts

<PageTitle>Organisation permissions</PageTitle>
<div class="space-y-4">
    <header class="flex flex-wrap items-start justify-between gap-3">
        <div><h2 class="text-xl font-semibold">Organisation permissions</h2><p class="mt-1 text-sm">Control which resources the organisation can access. Direct permissions and User Groups cannot exceed these limits.</p></div>
        <button class="app-button app-button-secondary" disabled="@(busy || Dirty)" @onclick="Refresh">Refresh</button>
    </header>
    @if (!string.IsNullOrEmpty(error)) { <p class="rounded-xl border p-4" role="alert">@error</p> }
    @if (data == null && string.IsNullOrEmpty(error)) { <p role="status">Loading organisation permissions…</p> }
    @if (data != null)
    {
        <section class="rounded-xl border p-4 space-y-3">
            @if (data.IsSuperAdmin)
            {
                <label class="block font-medium">Organisation<select class="form-select mt-2" value="@data.OrganisationId" @onchange="ChangeOrganisation" disabled="@(busy || Dirty)">
                    @foreach (var org in data.Organisations) { <option value="@org.Id">@org.Name</option> }
                </select></label>
            }
            else { <h3 class="font-semibold">@data.OrganisationName</h3> }
            <div class="flex flex-wrap gap-3 text-sm">
                <span class="rounded-lg border px-3 py-2"><strong>@selected.Count</strong> enabled</span>
                <span class="rounded-lg border px-3 py-2"><strong>@(data.Permissions.Count - selected.Count)</strong> unavailable</span>
                <span class="rounded-lg border px-3 py-2"><strong>@data.AccountCount</strong> accounts affected</span>
                <span class="rounded-lg border px-3 py-2" role="status">@(Dirty ? $"{Added.Count} additions · {Removed.Count} removals pending" : "All changes saved")</span>
            </div>
            <p class="text-sm">Removing a permission blocks it even when assigned directly or through a User Group. Existing organisation-default grants remain applicable to eligible accounts. Admin portal access still requires an approved grant.</p>
            @if (!data.CanEdit) { <p class="text-sm">You have view access. Contact an administrator to make changes.</p> }
            @if (Dirty) { <p class="text-sm">Save or reset your changes before switching organisation or refreshing.</p> }
        </section>
        <section class="rounded-xl border p-4 space-y-4">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <label class="block text-sm">Search permissions<input class="form-control mt-1" type="search" placeholder="Name, permission key or area…" @bind="search" @bind:event="oninput" /></label>
                <label class="block text-sm">Show<select class="form-select mt-1" @bind="filter"><option value="all">All permissions</option><option value="enabled">Enabled</option><option value="disabled">Unavailable</option><option value="changed">Changed</option></select></label>
                <label class="block text-sm">Area<select class="form-select mt-1" @bind="area"><option value="">All areas</option>@foreach (var item in data.Permissions.Select(p => p.Group).Distinct().Order()) { <option value="@item">@item</option> }</select></label>
            </div>
            <div class="flex flex-wrap items-center gap-3 text-sm">
                <span>@Visible.Count() matching permissions</span>
                @if (data.CanEdit)
                {
                    <button class="app-button app-button-secondary" disabled="@busy" @onclick="() => SelectVisible(true)">Enable displayed</button>
                    <button class="app-button app-button-secondary" disabled="@busy" @onclick="() => SelectVisible(false)">Disable displayed</button>
                }
            </div>
            <div class="space-y-3">
                @foreach (var group in Visible.GroupBy(p => p.Group).OrderBy(g => g.Key))
                {
                    <details class="rounded-xl border" open="@(!string.IsNullOrWhiteSpace(search) || area != "" || filter != "all")">
                        <summary class="cursor-pointer px-4 py-3 font-medium">@group.Key <span class="text-sm font-normal">· @group.Count(p => selected.Contains(p.Id)) / @group.Count() enabled</span></summary>
                        <div class="grid gap-2 border-t p-3 lg:grid-cols-2">
                            @foreach (var permission in group)
                            {
                                <label class="flex items-start gap-3 rounded-lg border p-3" @key="permission.Id">
                                    <input type="checkbox" class="mt-1" checked="@selected.Contains(permission.Id)" disabled="@(busy || !data.CanEdit || !selected.Contains(permission.Id) && !data.AssignableIds.Contains(permission.Id))" @onchange="e => Toggle(permission.Id, e.Value is true)" />
                                    <span class="min-w-0"><span class="block font-medium">@permission.Name</span><span class="block break-all text-xs">@permission.Key</span>
                                        @if (!string.IsNullOrEmpty(permission.Description)) { <span class="mt-1 block text-sm">@permission.Description</span> }
                                        @if (!selected.Contains(permission.Id) && !data.AssignableIds.Contains(permission.Id)) { <span class="block text-xs">Super Admin must enable this permission.</span> }
                                    </span>
                                </label>
                            }
                        </div>
                    </details>
                }
                @if (!Visible.Any()) { <p class="py-6 text-center text-sm">No permissions match these filters.</p> }
            </div>
        </section>
        @if (data.CanEdit)
        {
            <section class="rounded-xl border p-4 space-y-3">
                @if (Dirty)
                {
                    <details><summary class="cursor-pointer font-medium">Review pending changes (@(Added.Count + Removed.Count))</summary>
                        @foreach (var p in data.Permissions.Where(p => Added.Contains(p.Id) || Removed.Contains(p.Id))) { <p class="mt-2 break-all text-sm">@(Added.Contains(p.Id) ? "Enable" : "Disable"): @p.Key</p> }
                    </details>
                }
                <label class="block text-sm">Reason for change<textarea class="form-control mt-1" maxlength="1000" @bind="reason" @bind:event="oninput" disabled="@busy"></textarea></label>
                <div class="flex flex-wrap gap-3">
                    <button class="app-button app-button-primary" disabled="@(busy || !Dirty || string.IsNullOrWhiteSpace(reason))" @onclick="Save">@(busy ? "Saving…" : "Save organisation permissions")</button>
                    <button class="app-button app-button-secondary" disabled="@(busy || !Dirty)" @onclick="Reset">Reset changes</button>
                </div>
            </section>
        }
    }
</div>
@code {
    private OrganisationPermissionData? data;
    private HashSet<int> selected = [], baseline = [];
    private string search = "", filter = "all", area = "", reason = "", error = "";
    private bool busy;
    private bool Dirty => !selected.SetEquals(baseline);
    private HashSet<int> Added => selected.Except(baseline).ToHashSet();
    private HashSet<int> Removed => baseline.Except(selected).ToHashSet();
    private IEnumerable<PermissionDefinitionDto> Visible => (data?.Permissions ?? []).Where(p =>
        (area == "" || area == p.Group) && (p.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || p.Key.Contains(search, StringComparison.OrdinalIgnoreCase) || p.Group.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (filter == "all" || filter == "enabled" && selected.Contains(p.Id) || filter == "disabled" && !selected.Contains(p.Id) || filter == "changed" && selected.Contains(p.Id) != baseline.Contains(p.Id)));
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Refresh() { if (!Dirty) await Load(data?.OrganisationId); }
    private async Task Load(int? org = null)
    {
        error = "";
        try { data = await Settings.LoadAsync(org); baseline = data.AllowedIds.ToHashSet(); selected = baseline.ToHashSet(); reason = ""; }
        catch (Exception ex) { data = null; error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Organisation permissions could not be loaded. Please try again."; }
    }
    private async Task ChangeOrganisation(ChangeEventArgs e) { if (!Dirty && int.TryParse(e.Value?.ToString(), out var org)) { search = ""; area = ""; filter = "all"; await Load(org); } }
    private void Reset() { selected = baseline.ToHashSet(); reason = ""; error = ""; }
    private void Toggle(int id, bool enabled) { if (enabled && data?.AssignableIds.Contains(id) == true) selected.Add(id); else if (!enabled) selected.Remove(id); }
    private void SelectVisible(bool enabled) { foreach (var p in Visible.ToList()) Toggle(p.Id, enabled); }
    private async Task Save()
    {
        if (busy || data == null || !Dirty) return;
        busy = true; error = "";
        try
        {
            var result = await Settings.SaveAsync(data.OrganisationId, selected.ToArray(), baseline.ToArray(), reason);
            if (result.Success) { Toasts.Success(result.Message); await Load(data.OrganisationId); } else error = result.Message;
        }
        catch (Exception ex) { error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "The change could not be saved. Refresh and try again."; }
        finally { busy = false; }
    }
}
