@page "/admin/hr/organisations"
@page "/admin/hr/organisations/search"
@inject NavigationManager Navigation
@rendermode RenderMode.InteractiveServer

<p class="p-4 text-sm text-slate-500">Organisation management has moved to <a href="/admin/settings/org" class="text-indigo-600">System Settings</a>.</p>
@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) Navigation.NavigateTo("/admin/settings/org", replace: true);
        return Task.CompletedTask;
    }
}
