@using HRM.DTOs
@using HRM.DTOs.Organisation
@using HRM.Services
@using HRM.Components.Admin.Hr.Organisation.Tabs
@inject HRM.Services.Contracts.OrganisationSettingsServiceContracts.IOperations Settings
@inject ToastService Toast
@inject ILogger<OrganisationSettingsEditor> Logger
@inject NavigationManager Navigation

<div class="mt-2 w-full min-w-0 p-2 flex flex-col gap-2">
    @if (error != null) { <p role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">@error</p> }
    @if (loading) { <p class="rounded-2xl border border-slate-200 bg-white p-6 text-xs text-slate-500">Loading organisations…</p> }
    else if (data != null)
    {
        <fieldset disabled="@busy" class="min-w-0">
            <div class="min-w-0 flex flex-col gap-2">
            <div class="@(IsSuperAdminContext ? "superadmin-workspace-tabs" : "workspace-tabs border-emerald-600 dark:border-emerald-500") w-full border-b-2 overflow-x-auto"
                 style="@(IsSuperAdminContext ? "border-bottom-color: #ADD8E6;" : null)">
                <nav aria-label="Organisation sections" class="flex items-end gap-1 px-1 min-w-max pb-0">
                    @foreach (var item in OrganisationSections.Where(s => !HideHeader || s.Name != "Structure"))
                    {
                        var isActive = activeSection == item.Name;
                        <button type="button"
                                disabled="@(model.Id == 0 && item.Name != "Manage")"
                                aria-pressed="@(isActive ? "true" : "false")"
                                class="rounded-t-xl px-3.5 py-2 font-semibold text-xs transition-all border-t border-l border-r disabled:opacity-40 disabled:cursor-not-allowed @(IsSuperAdminContext ? (isActive ? "text-slate-900 shadow-xs" : "bg-white text-slate-800 hover:bg-sky-50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-200 dark:border-slate-700") : (isActive ? "bg-emerald-600 dark:bg-emerald-500 text-white border-emerald-600 dark:border-emerald-500 shadow-sm" : "bg-emerald-50/80 hover:bg-emerald-100 text-emerald-950 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 border-emerald-200/90 dark:border-slate-700"))"
                                style="@(IsSuperAdminContext && isActive ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)"
                                @onclick="() => ChangeSection(item.Name)">
                            <span class="flex items-center gap-1.5 whitespace-nowrap">
                                <OrganisationIcon Name="@(item.Name == "Manage" ? "Edit" : item.Name)" />
                                <span>@item.Name</span>
                            </span>
                        </button>
                    }
                </nav>
            </div>
            @if (!HideHeader && model.Id > 0)
            {
                <div class="mb-2 flex items-center gap-2 px-1"><span class="text-teal-600 dark:text-teal-400"><OrganisationIcon /></span><h1 class="text-lg font-bold text-slate-900 dark:text-slate-100">@(data.Organisations.FirstOrDefault(x => x.Id == model.Id)?.Name ?? model.Name)</h1></div>
            }
            <div class="mt-2 grid w-full grid-cols-1 gap-2 lg:grid-cols-12 items-start">
                <section class="min-w-0 w-full flex flex-col gap-2 @(ShowRightOrganisationList ? (HasDetailView ? "lg:col-span-5" : "lg:col-span-8") : "col-span-full lg:col-span-12")">
                    @if (model.Id == 0)
                    {
                        <!-- New Organisation Onboarding Form (generous p-4 padding) -->
                        <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                                <div class="flex items-center gap-2.5">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-xl border @(IsSuperAdminContext ? "text-slate-900" : "bg-teal-50 text-teal-700 border-teal-200")"
                                         style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8;" : null)">
                                        <OrganisationIcon />
                                    </div>
                                    <div>
                                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">Onboard New Organisation</h2>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Save the organisation details below, or select an existing organisation from the list on the right to manage it.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 gap-2 p-4 md:grid-cols-2">
                                <label class="@Label">Organisation name<input class="@Input" maxlength="250" @bind="model.Name" /></label>
                                <label class="@Label">Dhivehi name<input class="@Input" maxlength="250" dir="rtl" @bind="model.DhivehiName" /></label>
                                <label class="@Label">Organisation type<select class="@Input" @bind="model.TypeId"><option value="0">Select type</option>@foreach (var option in data.Types) { <option value="@option.Id">@option.Name</option> }</select></label>
                                <label class="@Label">Registration number<input class="@Input" maxlength="50" @bind="model.RegistrationNumber" /></label>
                                <label class="@Label">Registration date<input type="date" class="@Input" @bind="model.RegistrationDate" /></label>
                                <label class="@Label">Country<select class="@Input" @bind="model.CountryId"><option value="0">Select country</option>@foreach (var option in data.Countries) { <option value="@option.Id">@option.Name</option> }</select></label>
                                <label class="@Label md:col-span-2">Parent organisation (optional)<select class="@Input" @bind="model.ParentId"><option value="">No parent</option>@foreach (var option in data.Organisations.Where(x => x.Id != model.Id)) { <option value="@option.Id">@option.Name</option> }</select></label>
                            </div>
                            <div class="flex items-center gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 px-4 py-3">
                                <button type="button" class="app-button app-button-primary app-button-sm" @onclick="SaveDetailsAsync">@(busy ? "Saving…" : "Save organisation")</button>
                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="NewOrganisation">Reset</button>
                            </div>
                        </div>
                    }
                    else if (activeSection == "Manage")
                    {
                        <!-- 1. Organisation Information Card (Edit / Soft Delete via Modal) -->
                        <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border @(IsSuperAdminContext ? "text-slate-900" : "bg-teal-50 text-teal-700 border-teal-200")"
                                         style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8;" : null)">
                                        <OrganisationIcon />
                                    </div>
                                    <div class="min-w-0">
                                        <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">@model.Name</h2>
                                        @if (!string.IsNullOrWhiteSpace(model.DhivehiName))
                                        {
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate" dir="rtl">@model.DhivehiName</p>
                                        }
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => NewOrganisation(true)">
                                        <AppIcon Name="add" Class="text-xs" />
                                        <span>New Organisation</span>
                                    </button>
                                    <button type="button" class="app-button app-button-primary app-button-sm" @onclick="OpenEditOrgModal">
                                        <AppIcon Name="edit" Class="text-xs" />
                                        <span>Edit</span>
                                    </button>
                                    <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => showDeleteOrgModal = true">
                                        <AppIcon Name="bi-trash" Class="text-xs" />
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 p-4 text-xs">
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Registration No.</p>
                                    <p class="mt-0.5 font-mono font-semibold text-slate-800 dark:text-slate-100">@(string.IsNullOrWhiteSpace(model.RegistrationNumber) ? "—" : model.RegistrationNumber)</p>
                                </div>
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Type</p>
                                    <p class="mt-0.5 font-medium text-slate-800 dark:text-slate-100">@(data.Types.FirstOrDefault(x => x.Id == model.TypeId)?.Name ?? "—")</p>
                                </div>
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Country</p>
                                    <p class="mt-0.5 font-medium text-slate-800 dark:text-slate-100">@(data.Countries.FirstOrDefault(x => x.Id == model.CountryId)?.Name ?? "—")</p>
                                </div>
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Registration Date</p>
                                    <p class="mt-0.5 font-medium text-slate-800 dark:text-slate-100">@(model.RegistrationDate?.ToString("dd MMM yyyy") ?? "—")</p>
                                </div>
                                <div class="col-span-2">
                                    <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Parent Organisation</p>
                                    <p class="mt-0.5 font-medium text-slate-800 dark:text-slate-100">@(data.Organisations.FirstOrDefault(x => x.Id == model.ParentId)?.Name ?? "None (Top-Level)")</p>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Compact Addresses & Contact Info Summary (add/update via Address & Contact tabs) -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                                <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-3 py-2">
                                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                        <span>Addresses</span>
                                        <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@links.Addresses.Count</span>
                                    </h3>
                                    <button type="button" class="text-[11px] font-semibold text-blue-700 hover:underline" @onclick='() => ChangeSection("Address")'>Manage →</button>
                                </div>
                                <div class="p-2 flex flex-col gap-2 max-h-36 overflow-y-auto">
                                    @if (links.Addresses.Count == 0)
                                    {
                                        <p class="p-2 text-[11px] text-slate-400">No addresses linked. Add from the Address tab.</p>
                                    }
                                    else
                                    {
                                        @foreach (var saved in links.Addresses)
                                        {
                                            <div class="rounded-lg bg-slate-50 dark:bg-slate-800/60 px-2.5 py-1.5 text-[11px] text-slate-700 dark:text-slate-200 truncate" title="@saved.Name">@saved.Name</div>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                                <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-3 py-2">
                                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                        <span>Contact Info</span>
                                        <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@links.Contacts.Count</span>
                                    </h3>
                                    <button type="button" class="text-[11px] font-semibold text-blue-700 hover:underline" @onclick='() => ChangeSection("Contact")'>Manage →</button>
                                </div>
                                <div class="p-2 flex flex-col gap-2 max-h-36 overflow-y-auto">
                                    @if (links.Contacts.Count == 0)
                                    {
                                        <p class="p-2 text-[11px] text-slate-400">No contacts added. Add from the Contact tab.</p>
                                    }
                                    else
                                    {
                                        @foreach (var saved in links.Contacts)
                                        {
                                            <div class="flex items-center justify-between gap-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 px-2.5 py-1.5 text-[11px]">
                                                <span class="font-semibold text-slate-500 shrink-0">@saved.Type</span>
                                                <span class="text-slate-800 dark:text-slate-100 truncate">@saved.Value</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 3. Departments Card (Staff count + View / Edit / Soft Delete) -->
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-3 py-2">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                    <span>Departments</span>
                                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@links.Departments.Count</span>
                                </h3>
                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="OpenAddDepartmentModal">
                                    <AppIcon Name="add" Class="text-xs" />
                                    <span>Add Department</span>
                                </button>
                            </div>
                            <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-56 overflow-y-auto">
                                @if (links.Departments.Count == 0)
                                {
                                    <p class="p-3 text-center text-xs text-slate-400">No active departments in this organisation.</p>
                                }
                                else
                                {
                                    @foreach (var dept in links.Departments)
                                    {
                                        var isViewed = viewedDepartment?.Id == dept.Id;
                                        <div class="flex items-center justify-between gap-2 px-3 py-2 text-xs transition @(isViewed ? "bg-sky-50/70 dark:bg-slate-800/70" : "hover:bg-slate-50/70 dark:hover:bg-slate-800/40")">
                                            <div class="min-w-0">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <p class="font-semibold text-slate-800 dark:text-slate-100 truncate">@dept.Name</p>
                                                    <span class="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 text-[10px] font-semibold shrink-0">@dept.StaffCount staff</span>
                                                </div>
                                                <p class="text-[10px] text-slate-500">@dept.TypeName</p>
                                            </div>
                                            <div class="flex items-center gap-1 shrink-0">
                                                <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="() => ViewDepartment(dept)">View</button>
                                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => OpenEditDepartmentModal(dept)">Edit</button>
                                                <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => deletingDepartment = dept">Delete</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- 4. Teams Card -->
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-3 py-2">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                    <span>Teams</span>
                                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@links.Teams.Count</span>
                                </h3>
                            </div>
                            <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-48 overflow-y-auto">
                                @if (links.Teams.Count == 0)
                                {
                                    <p class="p-3 text-center text-xs text-slate-400">No active teams in this organisation.</p>
                                }
                                else
                                {
                                    @foreach (var tm in links.Teams)
                                    {
                                        var isViewed = viewedTeam?.Id == tm.Id;
                                        <div class="flex items-center justify-between gap-2 px-3 py-2 text-xs transition @(isViewed ? "bg-sky-50/70 dark:bg-slate-800/70" : "hover:bg-slate-50/70 dark:hover:bg-slate-800/40")">
                                            <div class="min-w-0">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <p class="font-semibold text-slate-800 dark:text-slate-100 truncate">@tm.Name</p>
                                                    <span class="rounded-full bg-sky-50 text-sky-700 border border-sky-200 px-1.5 py-0.5 text-[10px] font-semibold shrink-0">@tm.StaffCount staff</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(tm.DepartmentName))
                                                {
                                                    <p class="text-[10px] text-slate-500 truncate">@tm.DepartmentName</p>
                                                }
                                            </div>
                                            <div class="flex items-center gap-1 shrink-0">
                                                <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="() => ViewTeam(tm)">View</button>
                                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => OpenEditTeamModal(tm)">Edit</button>
                                                <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => deletingTeam = tm">Delete</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- 5. Groups Card (Operational Groups + HR Staff Groups) -->
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs overflow-hidden">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-3 py-2">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                    <span>Groups</span>
                                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@links.Groups.Count</span>
                                </h3>
                                <button type="button" class="text-[11px] font-semibold text-blue-700 hover:underline" @onclick='() => ChangeSection("Groups")'>Open Groups Tab →</button>
                            </div>
                            <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-56 overflow-y-auto">
                                @if (links.Groups.Count == 0)
                                {
                                    <p class="p-3 text-center text-xs text-slate-400">No active groups in this organisation.</p>
                                }
                                else
                                {
                                    @foreach (var grp in links.Groups)
                                    {
                                        var isViewed = viewedGroup?.Id == grp.Id && viewedGroup?.Source == grp.Source;
                                        <div class="flex items-center justify-between gap-2 px-3 py-2 text-xs transition @(isViewed ? "bg-sky-50/70 dark:bg-slate-800/70" : "hover:bg-slate-50/70 dark:hover:bg-slate-800/40")">
                                            <div class="min-w-0">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <p class="font-semibold text-slate-800 dark:text-slate-100 truncate">@grp.Name</p>
                                                    @if (!string.IsNullOrWhiteSpace(grp.Code))
                                                    {
                                                        <span class="rounded bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 dark:text-slate-300">@grp.Code</span>
                                                    }
                                                    <span class="rounded-full bg-blue-50 text-blue-700 border border-blue-200 px-1.5 py-0.5 text-[10px] font-semibold shrink-0">@grp.MemberCount staff</span>
                                                </div>
                                                <p class="text-[10px] text-slate-500 truncate">
                                                    @(string.IsNullOrWhiteSpace(grp.DepartmentName) ? grp.Source : $"{grp.DepartmentName} · {grp.Source}")@(string.IsNullOrWhiteSpace(grp.Description) ? "" : $" · {grp.Description}")
                                                </p>
                                            </div>
                                            <div class="flex items-center gap-1 shrink-0">
                                                <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="() => ViewGroup(grp)">View</button>
                                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => OpenEditGroupModal(grp)">Edit</button>
                                                <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => deletingGroup = grp">Delete</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @if (model.Id > 0 && activeSection == "Address")
                    {
                        <section aria-label="Organisation addresses" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-5 py-4"><div><h3 class="text-sm font-semibold text-slate-900">Addresses</h3><p class="mt-1 text-xs text-slate-500">@links.Addresses.Count linked addresses</p></div><button type="button" class="@Secondary" @onclick="() => addingAddress = !addingAddress">@(addingAddress ? "Close address form" : "Add address")</button></div>
                            <div class="flex flex-col gap-2 p-5">
                                @foreach (var saved in links.Addresses)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
                                        <div class="flex items-center justify-between gap-2"><p>@saved.Name</p><div class="flex gap-2"><button type="button" class="@Secondary" @onclick="() => EditAddressAsync(saved.LinkId)">Edit</button><button type="button" class="rounded-lg border border-red-200 px-3 py-2 text-xs font-medium text-red-600 hover:bg-red-50" @onclick="() => deletingAddress = saved.LinkId">Delete</button></div></div>
                                        @if (deletingAddress == saved.LinkId)
                                        {
                                            <div class="mt-2 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-2"><span>Remove this address from the organisation?</span><button type="button" class="@Secondary" @onclick="() => deletingAddress = null">Cancel</button><button type="button" class="rounded-lg bg-red-600 px-3 py-2 text-xs font-medium text-white" @onclick="() => DeleteAddressAsync(saved.LinkId)">Confirm delete</button></div>
                                        }
                                    </div>
                                }
                                @if (links.Addresses.Count == 0) { <p class="text-sm text-slate-500">No addresses yet. Add a new address or link an existing one.</p> }
                                @if (addingAddress)
                                {
                                    <div class="flex flex-col gap-2 rounded-xl border border-blue-100 p-4">
                                        <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" @bind="useExisting" @bind:after="AddressModeChanged" /> Link an existing address</label>
                                        <label class="@Label">Address usage<select class="@Input" @bind="address.UsageId">@foreach (var option in data.AddressUsages) { <option value="@option.Id">@option.Name</option> }</select></label>
                                        @if (useExisting)
                                        {
                                            <label class="@Label">Search addresses<input type="search" class="@Input" placeholder="Building or street name…" @bind="addressSearch" /></label>
                                            <button type="button" class="@Secondary" @onclick="SearchAddressesAsync">Search addresses</button>
                                            <div class="max-h-56 flex flex-col gap-2 overflow-y-auto">@foreach (var result in addressResults) { <button type="button" class="block w-full rounded-lg border p-3 text-left text-sm @(address.ExistingLocationId == result.Id ? "border-blue-300 bg-blue-50" : "border-slate-200")" @onclick="() => address.ExistingLocationId = result.Id">@result.Name @(address.ExistingLocationId == result.Id ? "✓" : "")</button> }</div>
                                        }
                                        else
                                        {
                                            <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                                                <label class="@Label">Address type<select class="@Input" @bind="address.BaseTypeId">@foreach (var option in data.AddressTypes) { <option value="@option.Id">@option.Name</option> }</select></label>
                                                <label class="@Label">Country<select class="@Input" @bind="address.CountryId" @bind:after="ClearArea">@foreach (var option in data.Countries) { <option value="@option.Id">@option.Name</option> }</select></label>
                                                <label class="@Label">Address line 1<input class="@Input" maxlength="250" @bind="address.Line1" /></label>
                                                <label class="@Label">Address line 2<input class="@Input" maxlength="250" @bind="address.Line2" /></label>
                                                <label class="@Label">Street<input class="@Input" maxlength="250" @bind="address.Street" /></label>
                                                <label class="@Label">Floor / suite<input class="@Input" maxlength="50" @bind="address.Floor" /></label>
                                                @if (data.Countries.Any(x => x.Id == address.CountryId && x.Name.Equals("Maldives", StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <label class="@Label">Island<select class="@Input" @bind="address.IslandId" @bind:after="() => address.WardId = null"><option value="">Select island</option>@foreach (var option in data.Islands) { <option value="@option.Id">@option.Name</option> }</select></label>
                                                    <label class="@Label">Ward (optional)<select class="@Input" @bind="address.WardId"><option value="">Select ward</option>@foreach (var option in data.Wards.Where(x => x.ParentId == address.IslandId)) { <option value="@option.Id">@option.Name</option> }</select></label>
                                                }
                                                <label class="@Label">Postcode<input class="@Input" maxlength="20" @bind="address.PostCode" /></label>
                                            </div>
                                        }
                                        <div class="flex gap-2"><button type="button" class="@Primary" @onclick="SaveAddressAsync">@(address.LinkId > 0 ? "Save changes" : "Save address")</button><button type="button" class="@Secondary" @onclick="ResetForms">Cancel</button></div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    @if (model.Id > 0 && activeSection == "Contact")
                    {
                        <section aria-label="Organisation contacts" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-5 py-4"><div><h3 class="text-sm font-semibold text-slate-900">Contacts</h3><p class="mt-1 text-xs text-slate-500">@links.Contacts.Count contact details</p></div><button type="button" class="@Secondary" @onclick="NewContact">Add contact</button></div>
                            <div class="flex flex-col gap-2 p-5">
                                @foreach (var saved in links.Contacts)
                                {
                                    <div class="rounded-xl border border-slate-200 p-3">
                                        <div class="flex items-center justify-between gap-2"><div class="min-w-0"><p class="text-xs font-semibold text-slate-500">@saved.Type</p><p class="break-all text-sm text-slate-800">@saved.Value</p></div><div class="flex gap-2"><button type="button" class="@Secondary" @onclick="() => EditContact(saved)">Edit</button><button type="button" class="@Danger" @onclick="() => deletingContact = saved.Id">Delete</button></div></div>
                                        @if (deletingContact == saved.Id)
                                        {
                                            <div class="mt-2 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-2 text-sm"><span>Delete this contact?</span><button type="button" class="@Secondary" @onclick="() => deletingContact = null">Cancel</button><button type="button" class="@Danger" @onclick="() => ExecuteAsync(() => Settings.DeleteContactAsync(model.Id, saved.Id))">Confirm delete</button></div>
                                        }
                                    </div>
                                }
                                @if (links.Contacts.Count == 0) { <p class="text-sm text-slate-500">No contacts have been added yet.</p> }
                                @if (addingContact)
                                {
                                    <div class="grid grid-cols-1 gap-2 rounded-xl border border-blue-100 p-4 md:grid-cols-2">
                                        <label class="@Label">Contact type<select class="@Input" @bind="contact.TypeId"><option value="0">Select type</option>@foreach (var option in data.ContactTypes) { <option value="@option.Id">@option.Name</option> }</select></label>
                                        <label class="@Label">Contact value<input class="@Input" maxlength="250" @bind="contact.Value" /></label>
                                        <div class="flex gap-2 md:col-span-2"><button type="button" class="@Primary" @onclick="SaveContactAsync">Save contact</button><button type="button" class="@Secondary" @onclick="() => addingContact = false">Cancel</button></div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    @if (model.Id > 0 && activeSection == "Structure")
                    {
                        <OrganisationStructureTab OrganisationId="model.Id" @key="model.Id" />
                    }
                    @if (model.Id > 0 && activeSection == "Locations")
                    {
                        <OrganisationResources Kind="HRM.DTOs.Organisation.OrganisationResourceKind.Locations" InitialOrganisationId="model.Id" @key="model.Id" />
                    }
                    @if (model.Id > 0 && activeSection == "Groups")
                    {
                        <OrganisationGroupsTab Org="SelectedOrganisation" @key="model.Id" />
                    }
                    @if (model.Id > 0 && activeSection == "Schedules")
                    {
                        <HRM.Components.Admin.Settings.Workplan.ScopeScheduleSettings OrganisationId="model.Id" OrganisationOnly="true" @key="model.Id" />
                    }
                </section>
                @if (HasDetailView)
                {
                    <!-- Selected Department / Team / Group Detail Panel on the Right (with Close button & p-2) -->
                    <aside class="min-w-0 p-2 lg:col-span-5">
                        <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-3 py-2.5"
                                 style="@(IsSuperAdminContext ? "background-color: #eef8fc;" : null)">
                                <div class="min-w-0">
                                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">
                                        @(viewedDepartment != null ? "Department View" : viewedTeam != null ? "Team View" : "Group View")
                                    </p>
                                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                                        @(viewedDepartment?.Name ?? viewedTeam?.Name ?? viewedGroup?.Name)
                                    </h3>
                                </div>
                                <button type="button" class="app-button app-button-secondary app-button-sm shrink-0" @onclick="CloseDetailView">
                                    <span>✕ Close</span>
                                </button>
                            </div>

                            <div class="p-2 flex flex-col gap-2 text-xs max-h-[640px] overflow-y-auto">
                                @if (viewedDepartment != null)
                                {
                                    var deptStaff = links.DepartmentStaff.Where(s => s.DepartmentId == viewedDepartment.Id).ToList();
                                    var deptTeams = links.Teams.Where(t => t.DepartmentId == viewedDepartment.Id).ToList();
                                    var deptGroups = links.Groups.Where(g => g.DepartmentId == viewedDepartment.Id).ToList();

                                    <div class="grid grid-cols-2 gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                        <div>
                                            <p class="text-[10px] font-semibold uppercase text-slate-400">Department Name</p>
                                            <p class="font-semibold text-slate-900 dark:text-slate-100">@viewedDepartment.Name</p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-semibold uppercase text-slate-400">Structure Type</p>
                                            <p class="font-semibold text-slate-900 dark:text-slate-100">@viewedDepartment.TypeName</p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-semibold uppercase text-slate-400">Active Staff</p>
                                            <p class="font-bold text-emerald-700">@deptStaff.Count</p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-semibold uppercase text-slate-400">Status</p>
                                            <span class="inline-block rounded-full bg-emerald-100 text-emerald-800 px-2 py-0.5 text-[10px] font-semibold">@(viewedDepartment.IsActive ? "Active" : "Inactive")</span>
                                        </div>
                                    </div>

                                    <!-- Department Staff -->
                                    <div class="space-y-1.5">
                                        <p class="text-[11px] font-bold text-slate-800 dark:text-slate-200">Staff (@deptStaff.Count)</p>
                                        @if (deptStaff.Count == 0)
                                        {
                                            <p class="rounded-lg border border-dashed border-slate-200 p-2.5 text-[11px] text-slate-400">No active staff assigned to this department.</p>
                                        }
                                        else
                                        {
                                            <div class="divide-y divide-slate-100 dark:divide-slate-800 rounded-xl border border-slate-200 dark:border-slate-800 max-h-48 overflow-y-auto">
                                                @foreach (var st in deptStaff)
                                                {
                                                    <div class="px-2.5 py-1.5 flex items-center justify-between gap-2">
                                                        <div class="min-w-0">
                                                            <p class="font-semibold text-slate-800 dark:text-slate-100 truncate">@st.Name</p>
                                                            <p class="text-[10px] text-slate-500 truncate">@st.JobType</p>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(st.EmployeeNumber))
                                                        {
                                                            <span class="font-mono text-[10px] text-slate-500 shrink-0">@st.EmployeeNumber</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Department Teams -->
                                    <div class="space-y-1.5">
                                        <p class="text-[11px] font-bold text-slate-800 dark:text-slate-200">Teams (@deptTeams.Count)</p>
                                        @if (deptTeams.Count == 0)
                                        {
                                            <p class="rounded-lg border border-dashed border-slate-200 p-2 text-[11px] text-slate-400">No teams linked to this department.</p>
                                        }
                                        else
                                        {
                                            <div class="space-y-1">
                                                @foreach (var tm in deptTeams)
                                                {
                                                    <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 px-2.5 py-1.5">
                                                        <span class="font-semibold text-slate-800 dark:text-slate-100 truncate">@tm.Name</span>
                                                        <span class="rounded-full bg-sky-50 text-sky-700 border border-sky-200 px-1.5 py-0.5 text-[10px] font-semibold shrink-0">@tm.StaffCount staff</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Department Groups -->
                                    <div class="space-y-1.5">
                                        <p class="text-[11px] font-bold text-slate-800 dark:text-slate-200">Groups (@deptGroups.Count)</p>
                                        @if (deptGroups.Count == 0)
                                        {
                                            <p class="rounded-lg border border-dashed border-slate-200 p-2 text-[11px] text-slate-400">No groups linked to this department.</p>
                                        }
                                        else
                                        {
                                            <div class="space-y-1">
                                                @foreach (var grp in deptGroups)
                                                {
                                                    <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 px-2.5 py-1.5">
                                                        <div class="min-w-0">
                                                            <span class="block font-semibold text-slate-800 dark:text-slate-100 truncate">@grp.Name</span>
                                                            @if (!string.IsNullOrWhiteSpace(grp.Code)) { <span class="text-[10px] text-slate-500">@grp.Code</span> }
                                                        </div>
                                                        <span class="rounded-full bg-blue-50 text-blue-700 border border-blue-200 px-1.5 py-0.5 text-[10px] font-semibold shrink-0">@grp.MemberCount staff</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (viewedTeam != null)
                                {
                                    var tmStaff = links.TeamStaff.Where(s => s.ParentId == viewedTeam.Id).ToList();
                                    <div class="flex flex-col gap-2">
                                        <div class="grid grid-cols-2 gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                            <div>
                                                <p class="text-[10px] font-semibold uppercase text-slate-400">Team Name</p>
                                                <p class="font-semibold text-slate-900 dark:text-slate-100">@viewedTeam.Name</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-semibold uppercase text-slate-400">Department</p>
                                                <p class="font-medium text-slate-800 dark:text-slate-200">@(viewedTeam.DepartmentName ?? "Organisation-wide")</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-semibold uppercase text-slate-400">Active Staff</p>
                                                <p class="font-bold text-sky-700">@tmStaff.Count</p>
                                            </div>
                                            <div class="flex items-end justify-end gap-1">
                                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => OpenEditTeamModal(viewedTeam)">Edit</button>
                                                <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => deletingTeam = viewedTeam">Delete</button>
                                            </div>
                                        </div>

                                        <div class="space-y-1.5">
                                            <p class="text-[11px] font-bold text-slate-800 dark:text-slate-200">Team Staff (@tmStaff.Count)</p>
                                            @if (tmStaff.Count == 0)
                                            {
                                                <p class="rounded-lg border border-dashed border-slate-200 p-2.5 text-[11px] text-slate-400">No active staff assigned to this team.</p>
                                            }
                                            else
                                            {
                                                <div class="divide-y divide-slate-100 dark:divide-slate-800 rounded-xl border border-slate-200 dark:border-slate-800 max-h-60 overflow-y-auto">
                                                    @foreach (var st in tmStaff)
                                                    {
                                                        <div class="px-2.5 py-1.5 flex items-center justify-between gap-2">
                                                            <p class="font-semibold text-slate-800 dark:text-slate-100 truncate">@st.Name</p>
                                                            @if (!string.IsNullOrWhiteSpace(st.EmployeeNumber))
                                                            {
                                                                <span class="font-mono text-[10px] text-slate-500 shrink-0">@st.EmployeeNumber</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (viewedGroup != null)
                                {
                                    var grpStaff = links.GroupStaff.Where(s => s.ParentId == viewedGroup.Id && s.Source == viewedGroup.Source).ToList();
                                    <div class="flex flex-col gap-2">
                                        <div class="grid grid-cols-2 gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5">
                                            <div>
                                                <p class="text-[10px] font-semibold uppercase text-slate-400">Group Name</p>
                                                <p class="font-semibold text-slate-900 dark:text-slate-100">@viewedGroup.Name</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-semibold uppercase text-slate-400">Type / Code</p>
                                                <p class="font-medium text-slate-800 dark:text-slate-200">@(viewedGroup.Code ?? viewedGroup.Source)</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-semibold uppercase text-slate-400">Department</p>
                                                <p class="font-medium text-slate-800 dark:text-slate-200">@(viewedGroup.DepartmentName ?? "Organisation-wide")</p>
                                            </div>
                                            <div class="flex items-end justify-end gap-1">
                                                <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => OpenEditGroupModal(viewedGroup)">Edit</button>
                                                <button type="button" class="app-button app-button-danger app-button-sm" @onclick="() => deletingGroup = viewedGroup">Delete</button>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(viewedGroup.Description))
                                            {
                                                <div class="col-span-2">
                                                    <p class="text-[10px] font-semibold uppercase text-slate-400">Description</p>
                                                    <p class="text-slate-700 dark:text-slate-300">@viewedGroup.Description</p>
                                                </div>
                                            }
                                        </div>

                                        <div class="space-y-1.5">
                                            <p class="text-[11px] font-bold text-slate-800 dark:text-slate-200">Group Staff (@grpStaff.Count)</p>
                                            @if (grpStaff.Count == 0)
                                            {
                                                <p class="rounded-lg border border-dashed border-slate-200 p-2.5 text-[11px] text-slate-400">No active staff assigned to this group.</p>
                                            }
                                            else
                                            {
                                                <div class="divide-y divide-slate-100 dark:divide-slate-800 rounded-xl border border-slate-200 dark:border-slate-800 max-h-60 overflow-y-auto">
                                                    @foreach (var st in grpStaff)
                                                    {
                                                        <div class="px-2.5 py-1.5 flex items-center justify-between gap-2">
                                                            <p class="font-semibold text-slate-800 dark:text-slate-100 truncate">@st.Name</p>
                                                            @if (!string.IsNullOrWhiteSpace(st.EmployeeNumber))
                                                            {
                                                                <span class="font-mono text-[10px] text-slate-500 shrink-0">@st.EmployeeNumber</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </aside>
                }
                @if (ShowRightOrganisationList)
                {
                <aside class="min-w-0 p-2 @(HasDetailView ? "lg:col-span-2" : "lg:col-span-4")">
                    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
                        <div class="border-b border-slate-200 dark:border-slate-800 p-2 flex flex-col gap-2">
                            <div class="flex items-center justify-between gap-2">
                                <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                                    <span>All Organisations</span>
                                    <span class="rounded-full border px-2 py-0.5 text-[10px] font-semibold @(IsSuperAdminContext ? "" : "bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400 border-teal-200 dark:border-teal-800/40")"
                                          style="@(IsSuperAdminContext ? "background-color: #ADD8E6; border-color: #7cc0d8; color: #0f172a;" : null)">
                                        @data.Organisations.Count
                                    </span>
                                </h2>
                            </div>
                            <input type="search" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1 text-xs text-slate-800 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" aria-label="Search organisations" placeholder="Search name or reg no…" @bind="search" @bind:event="oninput" />
                        </div>
                        <div class="divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto" style="max-height: 540px; scrollbar-gutter: stable;" tabindex="0">
                            @foreach (var item in FilteredOrganisations)
                            {
                                var isSelected = model.Id == item.Id;
                                <button type="button"
                                        class="flex w-full items-center justify-between gap-1.5 border-l-4 px-2.5 py-1.5 text-left transition @(isSelected ? (IsSuperAdminContext ? "font-semibold" : "border-teal-600 bg-teal-50/70 dark:bg-teal-950/40") : "border-transparent hover:bg-slate-50 dark:hover:bg-slate-800/40")"
                                        style="@(isSelected && IsSuperAdminContext ? "background-color: #eef8fc; border-left-color: #0369a1;" : null)"
                                        @onclick="() => SelectAsync(item)">
                                    <div class="min-w-0">
                                        <span class="block text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">@item.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(item.RegistrationNumber))
                                        {
                                            <span class="block text-[10px] font-mono text-slate-500 dark:text-slate-400 truncate">@item.RegistrationNumber</span>
                                        }
                                    </div>
                                    <AppIcon Name="chevron_right" Class="text-xs text-slate-400 shrink-0" />
                                </button>
                            }
                            @if (!FilteredOrganisations.Any())
                            {
                                <p class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">No organisations found.</p>
                            }
                        </div>
                    </div>
                </aside>
                }
            </div>
            </div>
        </fieldset>

        <!-- Modals for Edit / Soft-Delete of Organisation, Department & Group -->
        @if (showEditOrgModal)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Edit Organisation">
                <div class="w-full max-w-2xl rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Edit Organisation</h3>
                        <button type="button" class="text-slate-400 hover:text-slate-600 text-sm font-bold" @onclick="() => showEditOrgModal = false">✕</button>
                    </div>
                    <div class="grid grid-cols-1 gap-2 p-4 md:grid-cols-2">
                        @if (!string.IsNullOrWhiteSpace(error))
                        {
                            <div role="alert" class="md:col-span-2 rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">@error</div>
                        }
                        <label class="@Label">Organisation name<input class="@Input" maxlength="250" @bind="editOrgDraft.Name" /></label>
                        <label class="@Label">Dhivehi name<input class="@Input" maxlength="250" dir="rtl" @bind="editOrgDraft.DhivehiName" /></label>
                        <label class="@Label">Organisation type<select class="@Input" @bind="editOrgDraft.TypeId"><option value="0">Select type</option>@foreach (var option in data.Types) { <option value="@option.Id">@option.Name</option> }</select></label>
                        <label class="@Label">Registration number<input class="@Input" maxlength="50" @bind="editOrgDraft.RegistrationNumber" /></label>
                        <label class="@Label">Registration date<input type="date" class="@Input" @bind="editOrgDraft.RegistrationDate" /></label>
                        <label class="@Label">Country<select class="@Input" @bind="editOrgDraft.CountryId"><option value="0">Select country</option>@foreach (var option in data.Countries) { <option value="@option.Id">@option.Name</option> }</select></label>
                        <label class="@Label md:col-span-2">Parent organisation (optional)<select class="@Input" @bind="editOrgDraft.ParentId"><option value="">No parent</option>@foreach (var option in data.Organisations.Where(x => x.Id != editOrgDraft.Id)) { <option value="@option.Id">@option.Name</option> }</select></label>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => showEditOrgModal = false">Cancel</button>
                        <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="SaveOrgModalAsync">@(busy ? "Saving…" : "Save changes")</button>
                    </div>
                </div>
            </div>
        }

        @if (showDeleteOrgModal)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Soft Delete Organisation">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-rose-700">Soft Delete Organisation</h3>
                    </div>
                    <div class="p-4 text-xs text-slate-700 dark:text-slate-300 space-y-2">
                        <p>Are you sure you want to soft-delete <strong>@model.Name</strong>?</p>
                        <p class="text-[11px] text-slate-500">The organisation will be marked inactive and hidden from active lists while preserving historical records.</p>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => showDeleteOrgModal = false">Cancel</button>
                        <button type="button" class="app-button app-button-danger app-button-sm" disabled="@busy" @onclick="ConfirmDeleteOrgModalAsync">Confirm Soft Delete</button>
                    </div>
                </div>
            </div>
        }

        @if (showDeptModal)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Edit Department">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">@(deptDraftId == 0 ? "Add Department" : "Edit Department")</h3>
                        <button type="button" class="text-slate-400 hover:text-slate-600 text-sm font-bold" @onclick="() => showDeptModal = false">✕</button>
                    </div>
                    <div class="flex flex-col gap-2 p-4">
                        <label class="@Label">Department name<input class="@Input" maxlength="250" @bind="deptDraftName" /></label>
                        <label class="@Label">Department type
                            <select class="@Input" @bind="deptDraftTypeId">
                                <option value="0">Select type</option>
                                @foreach (var t in data.DepartmentTypes) { <option value="@t.Id">@t.Name</option> }
                            </select>
                        </label>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => showDeptModal = false">Cancel</button>
                        <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="SaveDepartmentModalAsync">Save Department</button>
                    </div>
                </div>
            </div>
        }

        @if (deletingDepartment != null)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Soft Delete Department">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-rose-700">Soft Delete Department</h3>
                    </div>
                    <div class="p-4 text-xs text-slate-700 dark:text-slate-300 space-y-2">
                        <p>Soft-delete department <strong>@deletingDepartment.Name</strong>?</p>
                        <p class="text-[11px] text-slate-500">It will be marked inactive and hidden from active department lists while preserving historical job links.</p>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => deletingDepartment = null">Cancel</button>
                        <button type="button" class="app-button app-button-danger app-button-sm" disabled="@busy" @onclick="ConfirmSoftDeleteDepartmentAsync">Confirm Soft Delete</button>
                    </div>
                </div>
            </div>
        }

        @if (showGroupModal)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Edit Group">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Edit Group</h3>
                        <button type="button" class="text-slate-400 hover:text-slate-600 text-sm font-bold" @onclick="() => showGroupModal = false">✕</button>
                    </div>
                    <div class="flex flex-col gap-2 p-4">
                        <label class="@Label">Group name<input class="@Input" maxlength="200" @bind="groupDraftName" /></label>
                        <label class="@Label">Code (optional)<input class="@Input" maxlength="50" @bind="groupDraftCode" /></label>
                        <label class="@Label">Description<textarea rows="2" class="@Input" maxlength="500" @bind="groupDraftDescription"></textarea></label>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => showGroupModal = false">Cancel</button>
                        <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="SaveGroupModalAsync">Save Group</button>
                    </div>
                </div>
            </div>
        }

        @if (deletingGroup != null)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Soft Delete Group">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-rose-700">Soft Delete Group</h3>
                    </div>
                    <div class="p-4 text-xs text-slate-700 dark:text-slate-300 space-y-2">
                        <p>Soft-delete group <strong>@deletingGroup.Name</strong>?</p>
                        <p class="text-[11px] text-slate-500">The group will be dissolved and hidden from active lists while preserving history.</p>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => deletingGroup = null">Cancel</button>
                        <button type="button" class="app-button app-button-danger app-button-sm" disabled="@busy" @onclick="ConfirmSoftDeleteGroupAsync">Confirm Soft Delete</button>
                    </div>
                </div>
            </div>
        }

        @if (showTeamModal)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Edit Team">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Edit Team</h3>
                        <button type="button" class="text-slate-400 hover:text-slate-600 text-sm font-bold" @onclick="() => showTeamModal = false">✕</button>
                    </div>
                    <div class="flex flex-col gap-2 p-4">
                        <label class="@Label">Team name<input class="@Input" maxlength="200" @bind="teamDraftName" /></label>
                        <label class="@Label">Department (optional)
                            <select class="@Input" @bind="teamDraftDeptId">
                                <option value="">Organisation-wide</option>
                                @foreach (var d in links.Departments) { <option value="@d.Id">@d.Name</option> }
                            </select>
                        </label>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => showTeamModal = false">Cancel</button>
                        <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="SaveTeamModalAsync">Save Team</button>
                    </div>
                </div>
            </div>
        }

        @if (deletingTeam != null)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-label="Soft Delete Team">
                <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
                    <div class="border-b border-slate-200 dark:border-slate-800 px-4 py-3">
                        <h3 class="text-sm font-bold text-rose-700">Soft Delete Team</h3>
                    </div>
                    <div class="p-4 text-xs text-slate-700 dark:text-slate-300 space-y-2">
                        <p>Soft-delete team <strong>@deletingTeam.Name</strong>?</p>
                        <p class="text-[11px] text-slate-500">The team will be marked inactive and hidden from active lists while preserving history.</p>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
                        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="() => deletingTeam = null">Cancel</button>
                        <button type="button" class="app-button app-button-danger app-button-sm" disabled="@busy" @onclick="ConfirmSoftDeleteTeamAsync">Confirm Soft Delete</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private OrganisationSettingsData? data;
    private OrganisationSettingsDto model = new();
    private OrganisationLinksDto links = new();
    private OrganisationAddressDto address = new();
    private OrganisationContactDto contact = new();
    private List<OrganisationSettingsOption> addressResults = new();
    private string search = "", addressSearch = "";
    private string? error;
    private bool busy, loading, addingAddress, addingContact, useExisting;
    private int? deletingAddress;
    private int? deletingContact;
    private bool showEditOrgModal, showDeleteOrgModal, showDeptModal, showGroupModal, showTeamModal;
    private OrganisationSettingsDto editOrgDraft = new();
    private int deptDraftId, deptDraftTypeId, groupDraftId, teamDraftId;
    private int? teamDraftDeptId;
    private string deptDraftName = "", groupDraftName = "", teamDraftName = "";
    private string? groupDraftCode, groupDraftDescription;
    private OrganisationDepartmentSummaryDto? deletingDepartment;
    private OrganisationGroupSummaryDto? deletingGroup;
    private OrganisationTeamSummaryDto? deletingTeam;
    private OrganisationDepartmentSummaryDto? viewedDepartment;
    private OrganisationTeamSummaryDto? viewedTeam;
    private OrganisationGroupSummaryDto? viewedGroup;
    private bool HasDetailView => activeSection == "Manage" && model.Id > 0 && (viewedDepartment != null || viewedTeam != null || viewedGroup != null);
    private void ViewDepartment(OrganisationDepartmentSummaryDto dept) { viewedDepartment = dept; viewedTeam = null; viewedGroup = null; }
    private void ViewTeam(OrganisationTeamSummaryDto tm) { viewedDepartment = null; viewedTeam = tm; viewedGroup = null; }
    private void ViewGroup(OrganisationGroupSummaryDto grp) { viewedDepartment = null; viewedTeam = null; viewedGroup = grp; }
    private void CloseDetailView() { viewedDepartment = null; viewedTeam = null; viewedGroup = null; }
    private string activeSection = "Manage";
    private static readonly (string Name, string Icon)[] OrganisationSections =
    [ ("Structure", "account_tree"), ("Manage", "edit"), ("Contact", "contact_phone"),
      ("Locations", "location_on"), ("Address", "location_on"), ("Schedules", "calendar_month"), ("Groups", "group_work") ];
    private OrganisationResultDto SelectedOrganisation => new()
    {
        BusinessEntityID = model.Id, OrganisationName = model.Name, OrganisationNameDhivehi = model.DhivehiName ?? "",
        RegistrationNumber = model.RegistrationNumber, RegistrationDate = model.RegistrationDate,
        Type = data?.Types.FirstOrDefault(x => x.Id == model.TypeId)?.Name ?? "",
        Country = data?.Countries.FirstOrDefault(x => x.Id == model.CountryId)?.Name ?? ""
    };
    [Parameter] public int? InitialOrganisationId { get; set; }
    [Parameter] public string? InitialSection { get; set; }
    [Parameter] public bool HideHeader { get; set; }
    private bool IsSuperAdminContext => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/superadmin", StringComparison.OrdinalIgnoreCase);
    private bool ShowRightOrganisationList => IsSuperAdminContext || (activeSection != "Structure" && activeSection != "Manage" && activeSection != "Contact" && activeSection != "Groups" && activeSection != "Locations" && activeSection != "Address" && activeSection != "Schedules");
    private void ChangeSection(string name) { activeSection = name; ResetForms(); NavigateSection(); }
    private void NavigateSection()
    {
        if (HideHeader) return;
        if (model.Id > 0) Navigation.NavigateTo($"/admin/settings/org/manage/{model.Id}/{HRM.Helpers.SectionRoutes.Slug(activeSection)}");
    }
    protected override async Task OnParametersSetAsync()
    {
        if (data == null || InitialOrganisationId is not > 0) return;
        var item = data.Organisations.FirstOrDefault(o => o.Id == InitialOrganisationId);
        if (item == null) { error = "This organisation is not available in your current context."; return; }
        var orgChanged = model.Id != item.Id;
        if (orgChanged) await SelectAsync(item, false);
        if (orgChanged || !string.IsNullOrWhiteSpace(InitialSection))
            activeSection = HRM.Helpers.SectionRoutes.Tab(OrganisationSections.Select(s => s.Name), InitialSection, "Manage");
    }
    private const string Danger = "inline-flex items-center gap-1 rounded-lg border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 px-2.5 py-1.5 text-xs font-semibold text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/50 transition";
    private const string Label = "block text-xs font-medium text-slate-700 dark:text-slate-300 p-1";
    private const string Input = "mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-normal text-slate-800 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500";
    private const string Primary = "inline-flex items-center gap-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500 px-3 py-1.5 text-xs font-semibold text-white shadow-xs transition";
    private const string Secondary = "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition";
    private IEnumerable<OrganisationSettingsDto> FilteredOrganisations => data?.Organisations.Where(x => x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || x.RegistrationNumber.Contains(search, StringComparison.OrdinalIgnoreCase)) ?? Enumerable.Empty<OrganisationSettingsDto>();
    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try { data = await Settings.LoadAsync(); NewOrganisation(false); }
        catch (Exception ex) { Fail(ex); }
        finally { loading = false; }
    }
    private void NewOrganisation() => NewOrganisation(true);
    private void NewOrganisation(bool navigate)
    {
        activeSection = "Manage";
        model = new() { CountryId = data?.Countries.FirstOrDefault(x => x.Name == "Maldives")?.Id ?? 0 };
        links = new(); error = null; ResetForms();
        if (navigate && !HideHeader) Navigation.NavigateTo("/admin/settings/org/manage");
    }
    private void ResetForms()
    {
        deletingAddress = null;
        deletingContact = null;
        showEditOrgModal = false; showDeleteOrgModal = false;
        showDeptModal = false; deletingDepartment = null;
        showGroupModal = false; deletingGroup = null;
        showTeamModal = false; deletingTeam = null;
        CloseDetailView();
        address = new() { BaseTypeId = data?.AddressTypes.FirstOrDefault()?.Id ?? 0, CountryId = model.CountryId, UsageId = data?.AddressUsages.FirstOrDefault(x => x.Id == 3)?.Id ?? data?.AddressUsages.FirstOrDefault()?.Id ?? 0 };
        contact = new(); addressResults.Clear(); addressSearch = ""; useExisting = false; addingAddress = false; addingContact = false;
    }
    private void OpenEditOrgModal()
    {
        editOrgDraft = new() { Id = model.Id, Name = model.Name, DhivehiName = model.DhivehiName, TypeId = model.TypeId, CountryId = model.CountryId, RegistrationNumber = model.RegistrationNumber, RegistrationDate = model.RegistrationDate, ParentId = model.ParentId };
        showEditOrgModal = true;
    }
    private async Task SaveOrgModalAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await Settings.SaveDetailsAsync(editOrgDraft);
            if (result.Success)
            {
                model = new() { Id = editOrgDraft.Id, Name = editOrgDraft.Name, DhivehiName = editOrgDraft.DhivehiName, TypeId = editOrgDraft.TypeId, CountryId = editOrgDraft.CountryId, RegistrationNumber = editOrgDraft.RegistrationNumber, RegistrationDate = editOrgDraft.RegistrationDate, ParentId = editOrgDraft.ParentId };
            }
            return result;
        }, true);
    }
    private Task ConfirmDeleteOrgModalAsync() => DeleteOrganisationAsync();
    private void OpenAddDepartmentModal()
    {
        deptDraftId = 0; deptDraftName = ""; deptDraftTypeId = data?.DepartmentTypes.FirstOrDefault()?.Id ?? 0;
        showDeptModal = true;
    }
    private void OpenEditDepartmentModal(OrganisationDepartmentSummaryDto dept)
    {
        deptDraftId = dept.Id; deptDraftName = dept.Name; deptDraftTypeId = dept.TypeId;
        showDeptModal = true;
    }
    private Task SaveDepartmentModalAsync() => ExecuteAsync(() => Settings.SaveDepartmentAsync(model.Id, deptDraftId, deptDraftName, deptDraftTypeId));
    private Task ConfirmSoftDeleteDepartmentAsync() => deletingDepartment == null ? Task.CompletedTask : ExecuteAsync(() => Settings.SoftDeleteDepartmentAsync(model.Id, deletingDepartment.Id));
    private void OpenEditGroupModal(OrganisationGroupSummaryDto grp)
    {
        groupDraftId = grp.Id; groupDraftName = grp.Name; groupDraftCode = grp.Code; groupDraftDescription = grp.Description;
        showGroupModal = true;
    }
    private Task SaveGroupModalAsync() => ExecuteAsync(() => Settings.SaveGroupSummaryAsync(model.Id, groupDraftId, groupDraftName, groupDraftCode, groupDraftDescription));
    private Task ConfirmSoftDeleteGroupAsync() => deletingGroup == null ? Task.CompletedTask : ExecuteAsync(() => Settings.SoftDeleteGroupAsync(model.Id, deletingGroup.Id));
    private void OpenEditTeamModal(OrganisationTeamSummaryDto tm)
    {
        teamDraftId = tm.Id; teamDraftName = tm.Name; teamDraftDeptId = tm.DepartmentId;
        showTeamModal = true;
    }
    private Task SaveTeamModalAsync() => ExecuteAsync(() => Settings.SaveTeamSummaryAsync(model.Id, teamDraftId, teamDraftName, teamDraftDeptId));
    private Task ConfirmSoftDeleteTeamAsync() => deletingTeam == null ? Task.CompletedTask : ExecuteAsync(() => Settings.SoftDeleteTeamAsync(model.Id, deletingTeam.Id));
    private async Task SelectAsync(OrganisationSettingsDto item, bool navigate = true)
    {
        busy = true; error = null;
        try
        {
            var savedLinks = await Settings.GetLinksAsync(item.Id);
            model = new() { Id = item.Id, Name = item.Name, DhivehiName = item.DhivehiName, TypeId = item.TypeId, CountryId = item.CountryId, RegistrationNumber = item.RegistrationNumber, RegistrationDate = item.RegistrationDate, ParentId = item.ParentId };
            links = savedLinks; ResetForms();
            if (navigate) NavigateSection();
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private void AddressModeChanged() { address.ExistingLocationId = null; addressResults.Clear(); }
    private async Task EditAddressAsync(int linkId)
    {
        if (busy) return;
        busy = true; error = null;
        try { address = await Settings.GetAddressAsync(model.Id, linkId); useExisting = false; addressResults.Clear(); deletingAddress = null; addingAddress = true; }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private Task DeleteAddressAsync(int linkId) => ExecuteAsync(() => Settings.DeleteAddressAsync(model.Id, linkId));
    private void ClearArea() { address.IslandId = null; address.WardId = null; }
    private void NewContact() { contact = new(); addingContact = true; }
    private void EditContact(OrganisationContactDto item) { contact = new() { Id = item.Id, TypeId = item.TypeId, Type = item.Type, Value = item.Value }; addingContact = true; }
    private async Task SearchAddressesAsync()
    {
        busy = true;
        try { addressResults = await Settings.SearchAddressesAsync(model.Id, addressSearch); address.ExistingLocationId = null; if (addressResults.Count == 0) Toast.Info("No matching addresses. Try another search or add a new address."); }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private Task SaveDetailsAsync() => ExecuteAsync(() => Settings.SaveDetailsAsync(model), true);
    private Task DeleteOrganisationAsync() => ExecuteAsync(async () =>
    {
        var result = await Settings.DeleteOrganisationAsync(model.Id);
        if (result.Success) NewOrganisation();
        return result;
    }, true);
    private Task SaveAddressAsync() => ExecuteAsync(() => useExisting && !address.ExistingLocationId.HasValue ? Task.FromResult(ServiceResult.Fail("Select an existing address from the search results.")) : Settings.SaveAddressAsync(model.Id, address));
    private Task SaveContactAsync() => ExecuteAsync(() => Settings.SaveContactAsync(model.Id, contact));
    private async Task ExecuteAsync(Func<Task<ServiceResult>> save, bool refreshList = false)
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            var result = await save();
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message);
            if (refreshList) data = await Settings.LoadAsync();
            if (model.Id > 0) links = await Settings.GetLinksAsync(model.Id);
            ResetForms();
            if (refreshList && model.Id > 0) NavigateSection();
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private void Fail(Exception ex) { Logger.LogError(ex, "Organisation settings operation failed."); error = ex is UnauthorizedAccessException ? ex.Message : "Organisation settings could not be loaded or saved. Please try again."; Toast.Error(error); }
}
