@attribute [Authorize]
@rendermode InteractiveServer
@using HRM.DTOs.Leave
@using HRM.Services.Leave
@inject HRM.Services.Leave.Contracts.LeaveFlowConfigurationServiceContracts.IOperations Configuration
@inject ILogger<LeaveFlowSettings> Logger
@inject HRM.Services.Interfaces.IUserAccessService UserAccess
@inject NavigationManager Navigation

<PageTitle>Request Approval Flows</PageTitle>
<div class="@(Embedded ? "w-full min-w-0 space-y-4" : "mx-auto max-w-7xl p-2 space-y-4")">
    @if (!Embedded)
    {
        <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
            <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">Request Approval Flows</h1>
                    <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 border border-teal-200/80 px-2 py-0.5 text-[10px] font-semibold text-teal-700">
                        <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                        Workflow Engine
                    </span>
                </div>
                <p class="text-xs text-slate-500">Assign multi-stage approval levels and user groups by Job Type and Request Type.</p>
            </div>
        </header>
    }
    @if (message != null)
    {
        <div role="status" class="flex items-center justify-between whitespace-pre-line rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800">
            <span>@message</span>
            <button type="button" class="font-bold text-slate-500 hover:text-slate-800" @onclick="() => message = null">✕</button>
        </div>
    }
    @if (loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center text-xs text-slate-500">Loading workflow configuration…</div>
    }
    else if (data == null)
    {
        <button type="button" class="app-button app-button-secondary app-button-sm" @onclick="ReloadAsync">
            <AppIcon Name="arrow-clockwise" />
            <span>Try Again</span>
        </button>
    }
    else if (data != null)
    {
        <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-blue-100 bg-blue-50/50 px-3.5 py-2.5 text-xs text-slate-700">
            <span>Organisation: <strong class="text-slate-900">@data.Organisation</strong> · Select a Job Type and Request Type to configure its automated approval flow.</span>
            <div class="flex flex-wrap items-center gap-2">
                <a class="app-button app-button-secondary app-button-sm" href="/admin/settings/org/teams">Teams &amp; Supervisors</a>
                <a class="app-button app-button-secondary app-button-sm" href="/developer/transitions">State Transitions</a>
            </div>
        </div>

        <fieldset disabled="@busy" class="space-y-4 rounded-xl border border-slate-200 bg-white p-4">
            <h2 class="text-xs font-bold uppercase tracking-wide text-slate-700">1. Select Staff Group &amp; Request Type</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <label class="block text-xs font-medium text-slate-700 p-1">
                    Job Type
                    <select id="flow-job-type" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="jobType" @bind:after="LoadFlowAsync">
                        <option value="0">Select Job Type</option>
                        @foreach (var x in data.JobTypes) { <option value="@x.Id">@x.Name</option> }
                    </select>
                </label>
                <label class="block text-xs font-medium text-slate-700 p-1">
                    Request Type
                    <select id="flow-request-type" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="requestType" @bind:after="RequestTypeChangedAsync">
                        <option value="0">Select Request Type</option>
                        @foreach (var x in data.RequestTypes) { <option value="@x.Id">@x.Name</option> }
                    </select>
                </label>
            </div>
            @if (model != null)
            {
                <div class="border-t border-slate-100 pt-3 space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h2 class="text-xs font-bold uppercase tracking-wide text-slate-700">2. Approval Stages &amp; User Groups</h2>
                            <p class="text-[11px] text-slate-500 mt-0.5">@(model.Version == 0 ? "Not configured — new submissions are blocked until a flow is saved." : $"Configured version v{model.Version}")</p>
                        </div>
                        <button id="flow-add-stage" type="button" @onclick="AddStage" disabled="@(level >= 20)" class="app-button app-button-primary app-button-sm">
                            <AppIcon Name="bi-plus-lg" />
                            <span>Add Approval Stage</span>
                        </button>
                    </div>
                    @if (model.ImportedFromLegacy)
                    {
                        <div class="rounded-xl border border-blue-200 bg-blue-50 p-3 text-xs text-blue-900">Loaded your previous approval flow as a draft. Review each processing status and save to apply this flow to new requests.</div>
                    }
                    @if (model.Version > 0 && model.Stages!.Any(x => x.UserGroupId == 0))
                    {
                        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">This saved flow uses older approver rules. Select a User Group for each stage and save a new version.</div>
                    }
                    <label class="block text-xs font-medium text-slate-700 p-1 max-w-md">
                        Approval Level
                        <select id="flow-level" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="level" @bind:after="ResizeStages">
                            <option value="0">Level 0 — reserved for future automatic approval</option>
                            @for (var i = 1; i <= 20; i++) { <option value="@i">Level @i — @i approval @(i == 1 ? "stage" : "stages")</option> }
                        </select>
                    </label>
                    @if (level == 0)
                    {
                        <div role="status" class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Level 0 is reserved for future automatic approval. Select Level 1 or higher to configure stages.</div>
                    }
                    else
                    {
                        <div class="rounded-xl border border-blue-200 bg-blue-50/50 px-3.5 py-2.5 text-xs font-semibold text-blue-900">
                            Staff → @string.Join(" → ", model.Stages!.Select(x => $"{x.Name} ({data.States.FirstOrDefault(s => s.Id == x.StateId)?.Name.Trim() ?? x.StateId.ToString()})")) → Approved
                        </div>
                        <div class="space-y-3">
                            @for (var i = 0; i < model.Stages!.Count; i++)
                            {
                                var index = i;
                                var stage = model.Stages[index];
                                <section @key="stage" class="space-y-3 rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
                                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/80 pb-2">
                                        <h3 class="text-xs font-bold text-slate-900">Stage @(index + 1)</h3>
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <button type="button" disabled="@(index == 0)" @onclick="() => MoveStage(index, -1)" class="app-button app-button-secondary app-button-sm">Move Up</button>
                                            <button type="button" disabled="@(index == model.Stages.Count - 1)" @onclick="() => MoveStage(index, 1)" class="app-button app-button-secondary app-button-sm">Move Down</button>
                                            <button type="button" @onclick="() => RemoveStage(index)" class="app-button app-button-danger app-button-sm">Remove</button>
                                        </div>
                                    </div>
                                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                        <label class="block text-xs font-medium text-slate-700 p-1">
                                            Stage Name
                                            <input id="@($"flow-stage-name-{index}")" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" maxlength="150" @bind="stage.Name" />
                                        </label>
                                        <label class="block text-xs font-medium text-slate-700 p-1">
                                            Approver Source
                                            <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="stage.ApproverType">
                                                <option value="UserGroup">User Group</option>
                                                <option value="LeadershipPermission">Leadership Permission</option>
                                            </select>
                                        </label>
                                        @if (stage.ApproverType == "LeadershipPermission")
                                        {
                                            <label class="block text-xs font-medium text-slate-700 p-1">
                                                Required Authority Permission
                                                <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="stage.PermissionRoleId">
                                                    <option value="0">Select permission role</option>
                                                    @foreach (var role in data.PermissionRoles) { <option value="@role.Id">@role.Name</option> }
                                                </select>
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="block text-xs font-medium text-slate-700 p-1">
                                                User Group
                                                <select id="@($"flow-stage-group-{index}")" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="stage.UserGroupId">
                                                    <option value="0">Select User Group</option>
                                                    @foreach (var group in data.UserGroups) { <option value="@group.Id">@group.Name</option> }
                                                </select>
                                            </label>
                                        }
                                        <label class="block text-xs font-medium text-slate-700 p-1">
                                            Processing Status
                                            <select id="@($"flow-stage-state-{index}")" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="stage.StateId">
                                                <option value="0">Select processing status</option>
                                                @foreach (var state in data.States) { <option value="@state.Id">@state.Name</option> }
                                            </select>
                                        </label>
                                        @if (stage.ApproverType != "LeadershipPermission")
                                        {
                                            <label class="block text-xs font-medium text-slate-700 p-1 sm:col-span-2">
                                                Eligible Reviewers
                                                <select id="@($"flow-stage-scope-{index}")" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" @bind="stage.ApplicantSupervisorOnly">
                                                    <option value="false">Staff in this User Group within the organisation</option>
                                                    <option value="true">Applicant's team / department supervisors in this User Group</option>
                                                </select>
                                            </label>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                    <p class="text-[11px] text-slate-500">Stages run in the displayed order. Any one eligible assigned reviewer completes a stage. Staff cannot verify or approve their own requests.</p>
                    <div class="flex justify-end">
                        <button type="button" @onclick="SaveAsync" disabled="@(level == 0 || model.Stages!.Any(x => x.StateId == 0 || (x.ApproverType == "LeadershipPermission" ? x.PermissionRoleId == 0 : x.UserGroupId == 0)))" class="app-button app-button-primary app-button-sm">
                            <AppIcon Name="bi-check2-circle" />
                            <span>@(busy ? "Saving…" : "Save Approval Flow")</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div role="status" class="rounded-xl border border-dashed border-slate-300 bg-slate-50/70 p-6 text-center text-xs text-slate-600">
                    Select both a <strong>Job Type</strong> and a <strong>Request Type</strong> above to configure approval stages and user groups.
                </div>
            }
        </fieldset>
        <p class="text-[11px] text-slate-500">Each stage requires a distinct processing status. Saving creates a new version while existing requests retain their original flow.</p>
    }
</div>

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public int? InitialOrganisationId { get; set; }
    [Parameter] public int? InitialJobTypeId { get; set; }
    [Parameter] public int? InitialRequestTypeId { get; set; }
    private string? loadedAlert;
    private LeaveFlowSettingsData? data;
    private LeaveFlowConfigurationDto? model;
    private int jobType, requestType, level;
    private bool loading = true, busy;
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await ApplyAlertPresetAsync();
    }
    protected override Task OnParametersSetAsync() => ApplyAlertPresetAsync();
    private static int? ParseQueryInt(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key) =>
        query.TryGetValue(key, out var raw) && int.TryParse(raw.FirstOrDefault(), out var parsed) ? parsed : null;
    private async Task ApplyAlertPresetAsync()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        var effectiveOrgId = InitialOrganisationId ?? ParseQueryInt(query, "issueOrganisationId");
        var effectiveJobTypeId = InitialJobTypeId ?? ParseQueryInt(query, "jobTypeId");
        var effectiveRequestTypeId = InitialRequestTypeId ?? ParseQueryInt(query, "requestTypeId");
        if (data == null || (!effectiveJobTypeId.HasValue && !effectiveRequestTypeId.HasValue)) return;
        var key = $"{effectiveOrgId}:{effectiveJobTypeId}:{effectiveRequestTypeId}";
        if (loadedAlert == key) return;
        loadedAlert = key;
        try
        {
            if (effectiveOrgId.HasValue && await UserAccess.GetCurrentOrganisationIdAsync() != effectiveOrgId.Value)
            {
                model = null;
                message = "This alert concerns another organisation. Open that organisation's approved admin context before reviewing its approval flow.";
                return;
            }
            if (effectiveJobTypeId.HasValue && data.JobTypes.Any(x => x.Id == effectiveJobTypeId.Value))
                jobType = effectiveJobTypeId.Value;
            if (effectiveRequestTypeId.HasValue && data.RequestTypes.Any(x => x.Id == effectiveRequestTypeId.Value))
                requestType = effectiveRequestTypeId.Value;
            if (jobType > 0 && requestType > 0)
                await LoadFlowAsync();
        }
        catch (Exception ex) { Handle(ex); }
    }
    private async Task ReloadAsync()
    {
        loading = true;
        message = null;
        try { data = await Configuration.LoadAsync(); }
        catch (Exception ex) { Handle(ex); }
        finally { loading = false; }
    }
    private async Task LoadFlowAsync()
    {
        model = null;
        message = null;
        if (jobType <= 0 || requestType <= 0) return;
        busy = true;
        try { model = await Configuration.GetAsync(jobType, requestType); level = model.Stages!.Count; }
        catch (Exception ex) { Handle(ex); }
        finally { busy = false; }
    }
    private async Task RequestTypeChangedAsync()
    {
        await LoadFlowAsync();
    }
    private async Task SaveAsync()
    {
        if (model == null || busy) return;
        busy = true;
        try { var result = await Configuration.SaveAsync(model); message = result.Message; }
        catch (Exception ex) { Handle(ex); }
        finally { busy = false; }
    }
    private void ResizeStages()
    {
        if (model == null || data == null) return;
        var stages = model.Stages!;
        while (stages.Count > level) stages.RemoveAt(stages.Count - 1);
        while (stages.Count < level)
        {
            var state = data.States.FirstOrDefault(x => stages.All(s => s.StateId != x.Id));
            stages.Add(new() { Name = $"Approval stage {stages.Count + 1}", StateId = state?.Id ?? 0 });
        }
    }
    private void AddStage()
    {
        if (level >= 20) return;
        level++;
        ResizeStages();
    }
    private void RemoveStage(int index)
    {
        model!.Stages!.RemoveAt(index);
        level = model.Stages.Count;
    }
    private void MoveStage(int index, int direction)
    {
        var stages = model!.Stages!;
        var target = index + direction;
        if (target < 0 || target >= stages.Count) return;
        (stages[index], stages[target]) = (stages[target], stages[index]);
    }
    private void Handle(Exception ex)
    {
        Logger.LogError(ex, "Leave flow configuration failed.");
        message = ex is UnauthorizedAccessException ? ex.Message : "Configuration could not be loaded or saved. Please try again.";
    }
}
