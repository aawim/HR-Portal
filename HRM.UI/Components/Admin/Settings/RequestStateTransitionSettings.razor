@using HRM.DTOs
@using HRM.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject HRM.Services.Contracts.RequestTransitionSettingsServiceContracts.IOperations Configuration
@inject ILogger<RequestStateTransitionSettings> Logger

<PageTitle>Request State Transitions</PageTitle>
<div class="@(Embedded ? "flex flex-col gap-2 p-2" : "mx-auto max-w-5xl space-y-4 p-4")">
    @if (!Embedded)
    {
        <a class="text-sm text-blue-700 underline" href="/admin/settings/config">Back to Configurations</a>
        <h1 class="text-2xl font-semibold">Request State Transitions</h1>
        <p class="text-sm text-slate-600">A request can change status only when its Request Type, current From State and target To State match an allowed transition. Permissions and workflow stage order still apply.</p>
    }
    @if (message != null) { <p role="status" class="rounded border bg-slate-50 p-3">@message</p> }
    @if (data != null)
    {
        <fieldset disabled="@busy" class="space-y-4 rounded-xl border bg-white p-4">
            <label class="block">Request Type<select id="transition-request-type" class="mt-1 w-full rounded border p-2" @bind="requestType" @bind:after="LoadRowsAsync"><option value="0">Select Request Type</option>@foreach (var x in data.RequestTypes) { <option value="@x.Id">@x.Name</option> }</select></label>
            <div class="grid gap-3 sm:grid-cols-2">
                <label>From State<select id="transition-from" class="mt-1 w-full rounded border p-2" @bind="from"><option value="0">Select current state</option>@foreach (var x in data.States) { <option value="@x.Id">@x.Name</option> }</select></label>
                <label>To State<select id="transition-to" class="mt-1 w-full rounded border p-2" @bind="to"><option value="0">Select next state</option>@foreach (var x in data.States) { <option value="@x.Id">@x.Name</option> }</select></label>
            </div>
            <button type="button" disabled="@(requestType == 0 || from == 0 || to == 0)" @onclick="AddAsync" class="rounded bg-blue-600 px-4 py-2 text-white disabled:opacity-50">Allow transition</button>
        </fieldset>
        @if (requestType > 0)
        {
            <section class="space-y-3 rounded-xl border bg-white p-4"><h2 class="font-semibold">Allowed transitions</h2>
                @if (rows.Count == 0) { <p>No transitions configured. Status changes are blocked.</p> }
                <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="p-2">From State</th><th class="p-2">To State</th><th class="p-2">Action</th></tr></thead><tbody>
                    @foreach (var row in rows) { <tr class="border-t"><td class="p-2">@row.FromState</td><td class="p-2">@row.ToState</td><td class="p-2"><button type="button" disabled="@busy" @onclick="() => RemoveAsync(row)" class="text-red-700 disabled:opacity-50">Remove @row.FromState → @row.ToState</button></td></tr> }
                </tbody></table></div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public int? InitialRequestTypeId { get; set; }
    [Parameter] public int? InitialFromStateId { get; set; }
    [Parameter] public int? InitialToStateId { get; set; }
    [Parameter] public string? InitialRequestTypeName { get; set; }
    [Parameter] public string? InitialFromStateName { get; set; }
    [Parameter] public string? InitialToStateName { get; set; }
    [Parameter] public EventCallback OnConfigurationChanged { get; set; }
    private RequestTransitionSettingsDto? data;
    private List<AllowedRequestTransitionDto> rows = [];
    private int requestType, from, to;
    private bool busy;
    private string? message;
    private string? appliedPresetKey;
    protected override async Task OnInitializedAsync()
    {
        try { data = await Configuration.LoadAsync(); await ApplyPresetAsync(); }
        catch (Exception ex) { Error(ex); }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (data is not null) await ApplyPresetAsync();
    }
    private async Task ApplyPresetAsync()
    {
        var presetKey = $"{InitialRequestTypeId}|{InitialFromStateId}|{InitialToStateId}|{InitialRequestTypeName}|{InitialFromStateName}|{InitialToStateName}";
        if (presetKey == appliedPresetKey) return;
        var requestOption = InitialRequestTypeId.HasValue
            ? data!.RequestTypes.FirstOrDefault(x => x.Id == InitialRequestTypeId.Value)
            : data!.RequestTypes.FirstOrDefault(x => x.Name.Trim().Equals(InitialRequestTypeName?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (requestOption is null) return;
        requestType = requestOption.Id;
        var fromOption = InitialFromStateId.HasValue
            ? data.States.FirstOrDefault(x => x.Id == InitialFromStateId.Value)
            : data.States.FirstOrDefault(x => x.Name.Trim().Equals(InitialFromStateName?.Trim(), StringComparison.OrdinalIgnoreCase));
        var toOption = InitialToStateId.HasValue
            ? data.States.FirstOrDefault(x => x.Id == InitialToStateId.Value)
            : data.States.FirstOrDefault(x => x.Name.Trim().Equals(InitialToStateName?.Trim(), StringComparison.OrdinalIgnoreCase));
        from = fromOption?.Id ?? 0;
        to = toOption?.Id ?? 0;
        appliedPresetKey = presetKey;
        await LoadRowsAsync();
        message = from > 0 && to > 0
            ? "Notification values loaded in order: Request Type, From State, To State. Review and select Allow transition."
            : "Request Type loaded. Select the required From State and To State from the notification details.";
    }
    private async Task LoadRowsAsync()
    {
        busy = true; rows = []; message = null;
        try { if (requestType > 0) rows = await Configuration.GetAsync(requestType); }
        catch (Exception ex) { Error(ex); }
        finally { busy = false; }
    }
    private Task AddAsync() => SetAsync(from, to, true);
    private Task RemoveAsync(AllowedRequestTransitionDto row) => SetAsync(row.FromStateId, row.ToStateId, false);
    private async Task SetAsync(int source, int target, bool allowed)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await Configuration.SetAsync(requestType, source, target, allowed);
            message = result.Message;
            rows = await Configuration.GetAsync(requestType);
            if (result.Success && OnConfigurationChanged.HasDelegate) await OnConfigurationChanged.InvokeAsync();
        }
        catch (Exception ex) { Error(ex); }
        finally { busy = false; }
    }
    private void Error(Exception ex)
    {
        Logger.LogError(ex, "Request transition configuration failed.");
        message = ex is UnauthorizedAccessException ? ex.Message : "Transition configuration could not be loaded or saved. Please try again.";
    }
}
