@using HRM.DTOs.WorkTypes
@using HRM.Components.Shared
@inject HRM.Services.Interfaces.IWorkTypeService WorkTypes
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject ILogger<WorkTypeManagement> Logger
@inject HRM.Services.Interfaces.Profile.IProfileService Profile

<section class="space-y-4" aria-busy="@busy">
    <!-- Header -->
    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-3">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-slate-900">
                    @(StaffId > 0 ? "Staff Work Types & Time-Clock Authorization" : "Work Types Configuration")
                </h2>
                <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-200">
                    @(StaffId > 0 ? "Staff Assignment" : "Global Settings")
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">
                @(StaffId > 0
                    ? "Staff can clock in and log shifts while an active Work Type assignment covers today."
                    : "Define organization work types, categories, and operational time tracking options.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 disabled:opacity-50 transition-colors"
                    disabled="@busy"
                    @onclick="LoadAsync">
                <span>↻</span>
                <span>Refresh</span>
            </button>
        </div>
    </header>

    @if (message != null)
    {
        <div role="status" class="flex items-center justify-between rounded-xl border border-blue-200 bg-blue-50/70 p-3 text-xs text-blue-900">
            <span>@message</span>
            <button type="button" @onclick="() => message = null" class="font-bold text-blue-600 hover:text-blue-800">✕</button>
        </div>
    }

    @if (loaded)
    {
        @if (StaffId == 0)
        {
            <!-- Global Admin Work Types Settings -->
            @if (isSuperAdmin)
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-3">
                    <h3 class="text-sm font-bold text-slate-900">
                        @(editingType == 0 ? "Create New Work Type" : "Edit Work Type")
                    </h3>
                    <div class="flex flex-wrap items-end gap-3 text-xs">
                        <div class="flex-1 min-w-[15rem]">
                            <label class="block font-medium text-slate-700">Work Type Name *</label>
                            <input class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                   maxlength="100"
                                   placeholder="e.g. Standard Shift, Remote Work, Field Duty"
                                   @bind="name" />
                        </div>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 pb-2">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600" @bind="valid" />
                            <span>Active / Valid</span>
                        </label>
                        <div class="flex items-center gap-2">
                            <button class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 disabled:opacity-50 transition-colors"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(name))"
                                    @onclick="SaveType">
                                <span>@(editingType == 0 ? "Add Work Type" : "Save Work Type")</span>
                            </button>
                            <button class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
                                    @onclick="ResetType">
                                Clear
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="border-b border-slate-200 bg-slate-50/70 px-4 py-3 flex items-center justify-between">
                    <h3 class="font-bold text-slate-800 text-xs">Defined Work Types</h3>
                    <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-700">@types.Count</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-3">Work Type</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Active Assignments</th>
                                <th class="p-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var type in types)
                            {
                                <tr class="hover:bg-slate-50/50">
                                    <td class="p-3 font-semibold text-slate-900">@type.Name</td>
                                    <td class="p-3">
                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @(type.IsValid ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-200")">
                                            @(type.IsValid ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono text-slate-600">@type.AssignmentCount</td>
                                    <td class="p-3 text-right">
                                        @if (isSuperAdmin)
                                        {
                                            <button class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 transition"
                                                    @onclick="() => EditType(type)">
                                                Edit
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- Staff Specific Work Types -->
            @if (jobId == 0)
            {
                <div role="alert" class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-900 flex items-start gap-3">
                    <span class="text-amber-600 font-bold text-base">⚠️</span>
                    <div>
                        <strong class="font-bold">No Active Job Found</strong>
                        <p class="mt-0.5 text-amber-800">
                            This staff member does not have an active approved job in the current organisation. A valid job position is required before assigning work types.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <!-- Assignment Form Card -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">
                                @(editingAssignment == 0 ? "Assign Work Type to Staff" : "Update Work Type Assignment")
                            </h3>
                            <p class="text-[11px] text-slate-500 mt-0.5">
                                Select an active work type to enable attendance and shift recording for this employee.
                            </p>
                        </div>
                        @if (editingAssignment != 0)
                        {
                            <button type="button" class="text-xs text-blue-600 hover:underline font-semibold" @onclick="ResetAssignment">
                                Cancel Edit
                            </button>
                        }
                    </div>

                    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4 text-xs">
                        <div class="xl:col-span-1">
                            <SearchableSelect Label="Work Type *" Options="typeOptions" @bind-Value="typeId" Disabled="@busy" />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">From Date *</label>
                            <input type="date"
                                   class="mt-1 block w-full rounded-lg border border-slate-300 p-2 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                   @bind="from" />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">To Date <span class="text-slate-400 font-normal">(Optional)</span></label>
                            <input type="date"
                                   class="mt-1 block w-full rounded-lg border border-slate-300 p-2 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                   @bind="to" />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">Location <span class="text-slate-400 font-normal">(Optional)</span></label>
                            <input type="text"
                                   class="mt-1 block w-full rounded-lg border border-slate-300 p-2 text-xs focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                                   maxlength="250"
                                   placeholder="e.g. Head Office, Site A, Remote"
                                   @bind="location" />
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-100">
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox"
                                   class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                                   @bind="assignmentActive"
                                   disabled="@busy" />
                            <span>Active Assignment (Authorizes clocking)</span>
                        </label>
                        <div class="flex items-center gap-2">
                            <button class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 disabled:opacity-50 transition-colors"
                                    disabled="@(busy || jobId == 0 || typeId == 0)"
                                    @onclick="SaveAssignment">
                                <span>✓</span>
                                <span>@(editingAssignment == 0 ? "Assign Work Type" : "Save Assignment")</span>
                            </button>
                            <button class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
                                    @onclick="ResetAssignment">
                                Clear
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Assigned Work Types Table -->
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="border-b border-slate-200 bg-slate-50/70 px-4 py-3 flex items-center justify-between">
                        <div>
                            <h3 class="font-bold text-slate-800 text-xs">Assigned Work Types</h3>
                            <p class="text-[11px] text-slate-500">History of active and completed work type periods</p>
                        </div>
                        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-700">@assignments.Count</span>
                    </div>

                    @if (assignments.Count == 0)
                    {
                        <div class="p-8 text-center text-slate-500 text-xs space-y-1">
                            <span class="text-2xl">📋</span>
                            <p class="font-semibold text-slate-700">No Work Type Assignments</p>
                            <p class="text-slate-400">Use the form above to assign a work type for attendance tracking.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                                    <tr>
                                        <th class="p-3">Work Type</th>
                                        <th class="p-3">Effective Period</th>
                                        <th class="p-3">Location</th>
                                        <th class="p-3">Status</th>
                                        <th class="p-3 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var row in assignments)
                                    {
                                        <tr class="hover:bg-slate-50/50">
                                            <td class="p-3 font-semibold text-slate-900">@row.WorkTypeName</td>
                                            <td class="p-3 text-slate-700">
                                                <span class="font-medium">@row.FromDate.ToString("dd MMM yyyy")</span>
                                                <span class="text-slate-400"> → </span>
                                                <span>@(row.ToDate?.ToString("dd MMM yyyy") ?? "Ongoing")</span>
                                            </td>
                                            <td class="p-3 text-slate-600">
                                                @(string.IsNullOrWhiteSpace(row.Location) ? "—" : row.Location)
                                            </td>
                                            <td class="p-3">
                                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold @(row.IsValid ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-200")">
                                                    @(row.IsValid ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td class="p-3 text-right">
                                                <div class="inline-flex items-center gap-1.5">
                                                    <button class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 transition"
                                                            disabled="@busy"
                                                            @onclick="() => EditAssignment(row)">
                                                        Edit
                                                    </button>
                                                    @if (row.IsValid)
                                                    {
                                                        <button class="inline-flex items-center gap-1 rounded-lg border border-rose-200 bg-white px-2.5 py-1 text-xs font-medium text-rose-700 hover:bg-rose-50 transition"
                                                                disabled="@busy"
                                                                @onclick="() => RemoveAssignment(row)">
                                                            Deactivate
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }
    }
</section>

@code {
    [Parameter] public int StaffId { get; set; }
    private List<WorkTypeDto> types = [];
    private List<AssignedWorkTypeDto> assignments = [];
    private int selectedStaffJobId;
    private bool assignmentActive = true;
    private IEnumerable<SearchableSelect.Option> typeOptions => types.Where(t => t.IsValid).Select(t => new SearchableSelect.Option(t.WorkTypeId, t.Name));
    private bool busy, loaded, isSuperAdmin, valid = true;
    private int editingType, editingAssignment, jobId, typeId;
    private string name = "", location = "";
    private string? message;
    private DateTime from = DateTime.UtcNow.AddHours(5).Date;
    private DateTime? to;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        busy = true; loaded = false;
        try
        {
            isSuperAdmin = (await Access.RequireContextAsync()).IsSuperAdministrator;
            types = await WorkTypes.GetAllAsync(true);
            if (StaffId > 0)
            {
                var profile = await Profile.GetProfileAsync(StaffId);
                selectedStaffJobId = profile?.ActiveJob?.JobId ?? 0;
                jobId = selectedStaffJobId;
                assignments = jobId > 0 ? await WorkTypes.GetAssignmentsAsync(jobId: jobId, includeInactive: true) : [];
            }
            loaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Loading work types");
            message = "Work Types could not be loaded. Check your organisation and WorkTypes.Manage permission.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Act(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await action();
            message = result.Message;
            if (result.Success)
            {
                ResetType();
                ResetAssignment();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Saving work types");
            message = "The change could not be saved. Refresh and try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private Task SaveType() => Act(() => editingType == 0
        ? WorkTypes.CreateAsync(new() { Name = name, IsValid = valid })
        : WorkTypes.UpdateAsync(new() { WorkTypeId = editingType, Name = name, IsValid = valid }));

    private void EditType(WorkTypeDto t)
    {
        editingType = t.WorkTypeId;
        name = t.Name;
        valid = t.IsValid;
    }

    private void ResetType()
    {
        editingType = 0;
        name = "";
        valid = true;
    }

    private Task SaveAssignment() => Act(() => editingAssignment == 0
        ? WorkTypes.AssignAsync(new()
        {
            JobId = jobId,
            WorkTypeId = typeId,
            FromDate = DateOnly.FromDateTime(from),
            ToDate = to.HasValue ? DateOnly.FromDateTime(to.Value) : null,
            Location = location,
            IsValid = assignmentActive
        })
        : WorkTypes.UpdateAssignmentAsync(new()
        {
            AssignedWorkTypeId = editingAssignment,
            WorkTypeId = typeId,
            FromDate = DateOnly.FromDateTime(from),
            ToDate = to.HasValue ? DateOnly.FromDateTime(to.Value) : null,
            Location = location,
            IsValid = assignmentActive
        }));

    private void EditAssignment(AssignedWorkTypeDto a)
    {
        editingAssignment = a.AssignedWorkTypeId;
        jobId = a.JobId;
        typeId = a.WorkTypeId;
        from = a.FromDate.ToDateTime(TimeOnly.MinValue);
        to = a.ToDate?.ToDateTime(TimeOnly.MinValue);
        location = a.Location ?? "";
        assignmentActive = a.IsValid;
    }

    private Task RemoveAssignment(AssignedWorkTypeDto a) => Act(() => WorkTypes.DeactivateAssignmentAsync(a.AssignedWorkTypeId));

    private void ResetAssignment()
    {
        editingAssignment = typeId = 0;
        jobId = selectedStaffJobId;
        from = DateTime.UtcNow.AddHours(5).Date;
        to = null;
        location = "";
        assignmentActive = true;
    }
}
