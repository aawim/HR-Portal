@page "/admin/settings/{CategoryName}"
@using HRM.Components.Admin.Settings.Positions
@page "/admin/settings/{CategoryName}/{Section}"
@page "/admin/settings/org/teams/{TeamSection}"
@inject NavigationManager Navigation
@using HRM.Components.Admin.Settings.Roles
@using HRM.Components.Admin.Settings.Users
@using HRM.Components.Admin.Settings.Workplan
@using HRM.Components.Admin.Hr.Group
@using HRM.Components.Leave
@using HRM.Components.Leave.Policy
@using HRM.Components.Shared
@using HRM.DTOs
@using HRM.Enum
@using HRM.Models
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using Microsoft.AspNetCore.Components.Authorization

@inject HRM.Application.Contracts.Pages.ILeaveApplications LeaveService
@inject IUserAccessService UserAccess
@rendermode RenderMode.InteractiveServer

<PageTitle>@(ResolvedCategoryName == "org" ? "Organisation Workspace - Settings" : ResolvedCategoryName == "user" ? "User Workspace - Settings" : ResolvedCategoryName == "roles" ? "Roles & Access Workspace - Settings" : ResolvedCategoryName == "positions" ? "Positions & Pay Frameworks - Settings" : "Settings - HR Portal")</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (checkingAccess)
        {
            <div class="m-4 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Checking settings permissions…</div>
        }
        else if (!canAccessCategory)
        {
            <div class="m-4 rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
                You do not have permission to access this Settings category.
            </div>
        }
        else if (ResolvedCategoryName is "org" or "user" or "roles" or "positions")
        {
            var workspaceTitle = ResolvedCategoryName switch
            {
                "org" => "Organisation Workspace",
                "user" => "User Workspace",
                "positions" => "Positions & Pay Frameworks",
                _ => "Roles & Access Workspace"
            };
            var workspaceBadge = ResolvedCategoryName switch
            {
                "org" => "Organisation Settings",
                "user" => "User Settings",
                "positions" => "Position Settings",
                _ => "Access Settings"
            };
            var workspaceSubtitle = ResolvedCategoryName switch
            {
                "org" => "Central management for organisation details, document centre, structure types, calendars, locations and permissions.",
                "user" => "Central management for user accounts, roles, direct permissions, staff records and enrollment numbers.",
                "positions" => "Manage active positions, pay frameworks, ranks, classifications, and position allowances.",
                _ => "Central management for permissions, user groups, area map coverage and staff attribute access control."
            };
            <!-- Enterprise Workspace Layout for /admin/settings/org, /user, /roles, and /positions -->
            <section class="org-workspace-page w-full min-w-0 p-2 flex flex-col gap-3 text-slate-900 dark:text-slate-100">
                <!-- Compact Header (no background/border) -->
                <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100 truncate">@workspaceTitle</h1>
                            <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                                <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                                @workspaceBadge
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            @workspaceSubtitle
                        </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <button type="button"
                                class="app-button app-button-neutral app-button-sm"
                                @onclick="ToggleWorkspaceFullWidth">
                            <AppIcon Name="@(workspaceFullWidth ? "fullscreen_exit" : "fullscreen")" Class="text-xs" />
                            <span>@(workspaceFullWidth ? "Shrink View" : "Full Width")</span>
                        </button>
                        <button type="button"
                                class="app-button app-button-secondary app-button-sm"
                                @onclick="() => StateHasChanged()">
                            <AppIcon Name="refresh" Class="text-xs" />
                            <span>Refresh</span>
                        </button>
                    </div>
                </header>

                <!-- Contextual Folder Navigation Tabs -->
                <div class="org-workspace-tabs my-workspace-tabs w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
                    <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="@($"{workspaceTitle} Sections")">
                        @foreach (var item in VisibleItems)
                        {
                            var isActive = activeItem?.Title == item.Title;
                            <button type="button"
                                    aria-current="@(isActive ? "page" : null)"
                                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r flex items-center gap-2 @(isActive ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                    @onclick="() => SelectItem(item)">
                                <i class="bi @item.Icon text-base" aria-hidden="true"></i>
                                <span>@item.Title</span>
                            </button>
                        }
                    </nav>
                </div>

                <div class="settings-ws-shell @(workspaceFullWidth ? "settings-ws-shell-full" : "settings-ws-shell-standard")">

                    <!-- Dynamic Content Panel -->
                    <div class="w-full min-w-0 bg-white dark:bg-slate-900 rounded-b-xl rounded-tr-xl border border-slate-200 dark:border-slate-800 p-3">
                        @if (activeItem == null)
                        {
                            <div class="h-full flex flex-col items-center justify-center text-slate-400 opacity-60 py-12">
                                <i class="bi bi-arrow-left-circle text-6xl mb-4" aria-hidden="true"></i>
                                <p class="text-sm font-medium">Select an item from the menu to view data.</p>
                            </div>
                        }
                        else
                        {
                            @if (activeItem.ComponentType != null)
                            {
                                <DynamicComponent @key="(ResolvedCategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                            }
                            else
                            {
                                <div class="bg-slate-50 border border-slate-100 rounded-xl p-8 text-center text-xs text-slate-500">
                                    <p><strong>@activeItem.Title</strong> is not available yet. Return to the section menu to choose an available feature.</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </section>
            <style>
                .settings-ws-shell {
                    width: 100%;
                    min-width: 0;
                    display: flex;
                    flex-direction: column;
                    transition: max-width 200ms ease;
                }
                .settings-ws-shell-standard {
                    max-width: 80rem;
                    margin-left: auto;
                    margin-right: auto;
                }
                .settings-ws-shell-full {
                    max-width: none;
                }
            </style>
        }
        else
        {
            <div class="settings-page mx-auto w-full min-w-0 p-4">

                <div class="flex flex-col md:flex-row gap-3 items-start">

                    <div class="@(ResolvedCategoryName == "leaves" ? "leave-settings-sidebar" : "") @(!isSidebarExpanded ? "settings-sidebar-collapsed" : "") flex-shrink-0 flex flex-col gap-1 transition-all duration-300 ease-in-out overflow-hidden @(isSidebarExpanded ? "w-full md:w-60" : "w-20")">

                        <div class="flex items-center @(isSidebarExpanded ? "justify-between" : "justify-center") px-1 mb-3">

                            <h2 class="text-base font-semibold text-slate-800 capitalize truncate transition-opacity duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden")">
                                @ResolvedCategoryName Management
                            </h2>

                            <button aria-expanded="@isSidebarExpanded" aria-label="Toggle settings sections" @onclick="ToggleSidebar" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-blue-600 transition-colors flex-shrink-0" title="@(isSidebarExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                                <AppIcon Name="menu" Class="w-6 h-6 transition-transform duration-300 text-2xl " />
                            </button>
                        </div>

                        <div class="settings-section-list @(isSidebarExpanded ? "" : "settings-section-list-collapsed") flex flex-col gap-2 mb-2">
                            @foreach (var item in VisibleItems)
                            {
                                <button aria-current="@(activeItem?.Title == item.Title ? "page" : null)" @onclick="() => SelectItem(item)"
                                title="@(!isSidebarExpanded ? item.Title : null)"
                                class="settings-section-link text-left p-1 rounded-xl border transition-colors group flex items-center gap-3 overflow-hidden
                           @(activeItem?.Title == item.Title ? "settings-section-active" : "bg-white hover:bg-slate-50")">

                                    <div class="w-8 h-8 flex items-center justify-center rounded-lg text-xl flex-shrink-0 transition-colors duration-300 mx-auto
                            @(activeItem?.Title == item.Title ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-600 group-hover:bg-blue-100 group-hover:text-blue-700")">
                                        <i class="bi @item.Icon" aria-hidden="true"></i>
                                    </div>

                                    <div class="flex-grow min-w-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 w-auto" : "opacity-0 w-0 hidden")">
                                        <h3 class="settings-section-label font-bold text-sm mb-0.5 @(activeItem?.Title == item.Title ? "text-blue-800" : "text-slate-800 group-hover:text-blue-700")">
                                            @item.Title
                                        </h3>

                                    </div>

                                    <div class="flex-shrink-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden") @(activeItem?.Title == item.Title ? "text-blue-600" : "text-slate-300 group-hover:text-blue-600")">
                                        <AppIcon Name="chevron_right" Class="w-5 h-5 text-xl" />
                                    </div>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="w-full min-w-0 md:flex-1">

                        <div class="flex flex-col lg:flex-row gap-2 mt-1">

                            <div class="settings-content flex-1 min-w-0 bg-white rounded-xl border border-slate-200 p-3">

                                @if (activeItem == null)
                                {
                                    <div class="h-full flex flex-col items-center justify-center text-slate-400 opacity-60 py-6">
                                        <i class="bi bi-arrow-left-circle text-6xl mb-4" aria-hidden="true"></i>
                                        <p class="text-lg font-medium">Select an item from the menu to view data.</p>
                                    </div>
                                }
                                else
                                {

                                    <div class="mt-2">
                                        @if (activeItem.ComponentType != null)
                                        {
                                            <DynamicComponent @key="(ResolvedCategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                                        }
                                        else
                                        {
                                            <div class="bg-slate-50 border border-slate-100 rounded-xl p-8 text-center text-slate-500">
                                                <p><strong>@activeItem.Title</strong> is not available yet. Return to the section menu to choose an available feature.</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="p-6 text-center mt-12">
            <p class="text-slate-500 text-lg">
                Please log in to view the settings dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool workspaceFullWidth = true;
    private void ToggleWorkspaceFullWidth() => workspaceFullWidth = !workspaceFullWidth;
    [Parameter] public string CategoryName { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }
    [Parameter] public int? OrganisationId { get; set; }
    [Parameter] public string? OrganisationSection { get; set; }
    [Parameter] public string? TeamSection { get; set; }
    private string ResolvedCategoryName => OrganisationSection != null || TeamSection != null
        ? "org" : (CategoryName ?? "").Trim().ToLowerInvariant();
    [SupplyParameterFromQuery(Name = "organisationId")] public int? QueryOrganisationId { get; set; }
    private IDictionary<string, object>? SelectedParameters => activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationTeamSettings)
        ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)(OrganisationId ?? QueryOrganisationId)!, ["InitialKind"] = TeamSection == "departments" ? "Department" : "Team" }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationSettingsEditor)
            ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)OrganisationId!, ["InitialSection"] = OrganisationSection! }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationPermissions)
            ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)(OrganisationId ?? QueryOrganisationId)!, ["HideHeader"] = true }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Hr.Documents.DocumentCentreAdminPanel)
            ? new Dictionary<string, object> { ["InitialSection"] = "types" }
        : activeItem?.ComponentType == typeof(ManageGroupsGrid)
            ? new Dictionary<string, object> { ["RequestedTab"] = "types" }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Roles.AccessRolesGrid)
            ? new Dictionary<string, object> { ["InitialView"] = activeItem.Title == "Area Map" ? "area-map" : "editor" }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)
            ? new Dictionary<string, object> { ["Kind"] = activeItem.Title switch {
                "Manage type" => HRM.DTOs.Organisation.OrganisationResourceKind.StructureTypes,
                "Calendar" => HRM.DTOs.Organisation.OrganisationResourceKind.Calendar,
                "Locations" => HRM.DTOs.Organisation.OrganisationResourceKind.Locations,
                "Location Types" => HRM.DTOs.Organisation.OrganisationResourceKind.LocationTypes,
                "Organisation Types" => HRM.DTOs.Organisation.OrganisationResourceKind.OrganisationTypes,
                "Structure Request Types" => HRM.DTOs.Organisation.OrganisationResourceKind.StructureRequestTypes,
                _ => HRM.DTOs.Organisation.OrganisationResourceKind.Requests } } : null;
    private IEnumerable<SubItem> VisibleItems => GetSubItems(CategoryName).Where(x => x.ComponentType != null &&
        (x.ComponentType != typeof(RequestStateTransitionSettings) || isDeveloper) &&
        (x.ComponentType != typeof(LeaveCarryForwardSettings) || canViewCarryForward));
    private string ItemSlug(SubItem item) => item.Title switch
    {
        "Teams and supervisors" => "teams",
        "Organisation Permissions" => "permissions",
        "Staff Attribute Access" => "staff-access",
        "Manage" => "manage",
        "Manage type" => "types",
        "Document Centre" => "document-types",
        "Document Types" => "document-types",
        "Leave Set Management" => "manage-leave-sets",
        "Job Type Configuration" => "job-types",
        "Request State Transitions" => "state-transitions",
        "Request Approval Flows" => "approval-flows",
        "Leave Accrual by Job Type" => "accrual",
        "Leave Carry Forward" => "carry-forward",
        "Projects & Tasks" => "projects",
        "Project & Task Management" => "projects",
        "Group Types" => "group-types",
        _ => HRM.Helpers.SectionRoutes.Slug(item.Title)
    };

    // Fixed Record: Replaced 'Url' with 'ComponentType' to match your dynamic rendering goals
    private record SubItem(string Title, string Icon, string Description, Type? ComponentType = null);

     [Parameter]
    public WorkspaceEntityType EntityType { get; set; }




    private SubItem? activeItem;

    private void SelectItem(SubItem item)
    {
        activeItem = item;
        Navigation.NavigateTo($"/admin/settings/{ResolvedCategoryName}/{ItemSlug(item)}");
    }
    private bool isSidebarExpanded = true;

    private void ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
    }

    private List<SubItem> GetSubItems(string? cat) => (string.IsNullOrWhiteSpace(cat) ? ResolvedCategoryName : cat.Trim().ToLowerInvariant()) switch
    {
        "leaves" => new() {
            new("Work Handover Rules", "bi-arrow-left-right", "", typeof(HandoverRuleSettings)),
            new("Leave Set Management", "bi-collection", "", typeof(LeaveSetsGrid)),
            new("Leave Accrual by Job Type", "bi-calendar2-plus", "Configure this tenant's accrual rates, waiting periods and carry-forward for every Job Type.", typeof(LeaveAccrualSettings)),
            new("Leave Carry Forward", "bi-calendar2-check", "HR reviews unused days and processes carry-forward at service-year renewal.", typeof(LeaveCarryForwardSettings)),
            new("Manage Configurable", "bi-sliders", "Global leave system variables.", typeof(LeaveConfigGrid)),
            new("Manage Leave Types", "bi-tags", "Global leave system variables.", typeof(LeaveTypeManagement)),
            new("Manage Leave Policy", "bi-journal-check", "Global leave system variables.", typeof(LeavePolicyManagement)),

        },
        "user" => new() {
            new("Manage Account", "bi-person-gear", "Edit user account details and account status.", typeof(AccountGrid)),
            new("Admin Portal Access", "bi-shield-lock", "Explicitly grant or revoke access to the Admin portal.", typeof(AdminPortalAccess)),
            new("Manage Permissions", "bi-key", "Assign account roles and direct permissions.", typeof(AccountPermissionsGrid)),
        },
        "org" => new() {
            new("Manage", "bi-building-gear", "Manage organisation details, structure, locations, addresses, contacts, teams and supervisors.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationSettingsEditor)),
            new("Roles", "bi-shield-check", "Manage organisation user groups and assigned role permissions.", typeof(HRM.Components.Admin.Settings.Roles.AccessRolesGrid)),
            new("Permissions", "bi-key", "Control which permissions are enabled for each organisation.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationPermissions)),
            new("Document Types", "bi-folder2-open", "Configure organisation document classifications and types.", typeof(HRM.Components.Admin.Hr.Documents.DocumentCentreAdminPanel)),
            new("Manage type", "bi-diagram-3", "Manage Organisation Structure Types, such as departments and divisions.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Group Types", "bi-people", "Define operational group categories.", typeof(ManageGroupsGrid)),
            new("Calendar", "bi-calendar3", "View and assign organisation calendars.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Location Types", "bi-tags", "Manage the shared location type catalogue.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Organisation Types", "bi-buildings", "Manage organisation classifications.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Structure Request Types", "bi-inbox", "Manage request types used for organisation structure changes.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
        },
        "payroll" => new() {
            new("Manage Period", "bi-hourglass-split", "Configure pay cycles and deadlines.", null),
            new("Manage Item Type", "bi-receipt", "Categorize payroll income and deductions.", null)
        },
        "roles" => new() {
            new("Permissions", "bi-key", "Manage permissions grouped by area, such as Leave.", typeof(RoleGrid)),
            new("Roles", "bi-shield-check", "Manage user groups and their assigned permissions.", typeof(HRM.Components.Admin.Settings.Roles.AccessRolesGrid)),
            new("Area Map", "bi-diagram-3", "Browse Online, Admin, and Developer site map areas, sub-functions, and related permissions.", typeof(HRM.Components.Admin.Settings.Roles.AccessRolesGrid)),
            new("Staff Attribute Access", "bi-person-lock", "Restrict staff visibility by position classification, user, role or specific staff member.", typeof(HRM.Components.Admin.Settings.Roles.StaffAccessControl)),
        },
        "requests" => new() {
           new("Request Types", "bi-ui-checks", "Manage request types and default approval workflows.", typeof(HRM.Components.Admin.Settings.RequestTypes.RequestTypeConfiguration)),
        },
        "config" => new() {
            new("Work Types", "bi-list-check", "Manage the Work Type catalogue.", typeof(HRM.Components.Admin.Settings.WorkTypeManagement)),
            new("Request State Transitions", "bi-arrow-repeat", "Configure allowed From State and To State for each Request Type.", typeof(RequestStateTransitionSettings)),
            new("Request Approval Flows", "bi-diagram-3", "Configure approvals for all staff by Job Type and Request Type.", typeof(LeaveFlowSettings)),

           new("Job Type Configuration", "bi-people", "Manage job types and staff approval workflows.", typeof(HRM.Components.Admin.Settings.JobTypes.JobTypeConfiguration)),
           new("Manage Attendance Clients", "bi-pc-display", "Configure attendance clients and devices.", null),
        },
        "positions" => new() {
           new("Overview", "bi-card-list", "View active positions across both frameworks and their assigned staff.", typeof(PositionOverview)),
           new("Pay Frameworks", "bi-cash-stack", "Manage shared frameworks, Job Matrices, pay steps, titles and allowances.", typeof(PayFrameworks)),
           new("Manage Ranks", "bi-award", "Define and manage official job ranks.", typeof(RankGrid)),
           new("Manage Classifications", "bi-tags", "Define and manage position classifications.", typeof(ClassifficationGrid)),
           new("Manage Positions", "bi-briefcase", "Manage custom positions and government Job Matrix links.", typeof(PositionGrid)),
           new("Position Allowances", "bi-cash-coin", "Configure required position allowances.", typeof(PositionAllowances)),
        },
        "workplaning" or "work-planning" => new() {
           new("Working Hours", "bi-clock-history", "Configure weekly hours and temporary official start-time amendments.", typeof(WorkingHoursSettings)),
           new("Templates", "bi-layout-text-window", "Define working hours and required clock events using ordered segments.", typeof(WorkTemplateManagement)),
           new("Plans", "bi-calendar2-check", "Generate assigned schedules or add manual duty to a staff member's daily plan.", typeof(WorkPlanManagement)),
           new("Segments", "bi-segmented-nav", "Manage check-in, work, break and check-out events within templates.", typeof(Segments)),
        },
        "projects" => new() {
            new("Projects & Tasks", "bi-kanban", "Comprehensive management, CRUD operations, timelines and task tracking for all projects.", typeof(HRM.Components.Admin.Settings.Projects.ProjectsManagementHub)),
        },

        _ => new() { new("General Configuration", "bi-wrench-adjustable", "System level management.", null) }
    };

    // --- Authentication and Service Logic ---
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }





    private WorkspaceSearchResult? SelectedItem;

    private WorkspaceTab ActiveTab = WorkspaceTab.Overview;

    private void SelectItem(WorkspaceSearchResult item)
    {
        SelectedItem = item;
    }

    private void OnTabChanged(WorkspaceTab tab)
    {
        ActiveTab = tab;
    }




    // Variables for Dashboard Data

    private bool isDeveloper;
    private bool canViewCarryForward;
    private bool checkingAccess = true;
    private bool canAccessCategory;
    private string? checkedCategory;

    private static string[] GetCategoryPermissions(string category) => category.Trim().ToLowerInvariant() switch
    {
        "user" => ["Admin", "User.View", "User.Manage", "AdminAccess.Manage"],
        "org" => ["Admin", "Organisation.View", "Organisation.Manage", "Configuration.View"],
        "documents" => ["Admin", "Configuration.View", "Documents.View", "Documents.Manage"],
        "requests" => ["Admin", "Configuration.View"],
        "teams" => ["Admin", "Organisation.View", "Organisation.Manage"],
        "schedules" => ["Admin", "Configuration.View", "Schedules.Manage"],
        "leaves" => ["Admin", "Leave.Configure", "Configuration.View"],
        "payroll" => ["Admin", "Payroll.View", "Payroll.Configure"],
        "performance" => ["Admin", "Configuration.View"],
        "config" => ["Admin", "Configuration.View", "WorkTypes.Manage"],
        "roles" => ["Admin", "Roles.View", "UserOrganisation.Groups.View", "Organisation.Groups.View", "Developer"],
        "positions" => ["Admin", "Position.Details", "Staff.Positions.Manage", "Positions.Configure"],
        "workplaning" or "work-planning" => ["Admin", "WorkPlanning.Manage", "Schedules.Manage", "Configuration.View"],
        "projects" => ["Admin", "Project.Manage", "Project.View", "Configuration.View"],
        _ => ["Admin", "Configuration.View"]
    };

    protected override void OnParametersSet()
    {
        CategoryName = ResolvedCategoryName;
        if (CategoryName == "leaves" && Section is "new-lt" or "manage-new-lt") { Navigation.NavigateTo("/admin/settings/leaves/leave-types", replace: true); return; }
        if (CategoryName == "leaves" && Section == "leave-sets") { Navigation.NavigateTo("/admin/settings/leaves/manage-leave-sets", replace: true); return; }
        if (CategoryName == "documents") { Navigation.NavigateTo("/admin/settings/org/document-types", replace: true); return; }
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section is "document-centre" or "document-center") Section = "document-types";
        if (CategoryName is "workplaning" or "work-planning" && Section == "duty-roster")
        {
            Navigation.NavigateTo("/admin/hr/work-planning/duty-roster", replace: true);
            return;
        }
        if ((CategoryName is "workplaning" or "work-planning" && Section == "work-types") ||
            ((CategoryName is "job" or "jobs") && (string.IsNullOrWhiteSpace(Section) || Section == "work-types")))
        {
            Navigation.NavigateTo("/admin/settings/config/work-types", replace: true);
            return;
        }
        if ((CategoryName is "job" or "jobs") && Section is "job-types" or "job-type-configuration")
        {
            Navigation.NavigateTo("/admin/settings/config/job-types", replace: true);
            return;
        }
        if (CategoryName == "staff" || CategoryName == "user" && Section is "staff" or "manage-staff" or "staff-enrollment-number" or "manage-staff-enrollment-number")
        {
            var section = Section is "enrollment" or "staff-enrollment-number" or "manage-staff-enrollment-number" ? "enrollment" : "manage";
            var current = new Uri(Navigation.Uri);
            Navigation.NavigateTo($"/admin/hr/staff/{section}{current.Query}{current.Fragment}", replace: true);
            return;
        }
        if (OrganisationSection != null) { CategoryName = "org"; Section = "manage"; }
        if (TeamSection != null) { CategoryName = "org"; Section = "teams"; }
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "organisations") Section = "manage";
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "requests") Section = "structure-request-types";
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "teams")
        {
            var current = new Uri(Navigation.Uri);
            var target = "/admin/hr/supervisors/management" + current.Query;
            if (TeamSection == "departments") target = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(target, "teamView", "departments");
            Navigation.NavigateTo(target + current.Fragment, replace: true);
            return;
        }
        activeItem = string.IsNullOrWhiteSpace(Section) ? VisibleItems.FirstOrDefault() :
            VisibleItems.FirstOrDefault(x => HRM.Helpers.SectionRoutes.Matches(Section, ItemSlug(x)));
    }

    private int currentOrgId = 3;

    protected override async Task OnParametersSetAsync()
    {
        var category = ResolvedCategoryName;
        if (string.Equals(checkedCategory, category, StringComparison.OrdinalIgnoreCase))
            return;

        checkingAccess = true;
        canAccessCategory = false;
        try
        {
            var actor = await UserAccess.RequireContextAsync();
            if (actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Admin"))
            {
                canAccessCategory = true;
            }
            else
            {
                foreach (var perm in GetCategoryPermissions(category))
                {
                    if (await UserAccess.HasPermissionAsync(perm))
                    {
                        canAccessCategory = true;
                        break;
                    }
                }
            }
            checkedCategory = category;
        }
        catch
        {
            canAccessCategory = false;
        }
        finally
        {
            checkingAccess = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { var id = await UserAccess.GetCurrentOrganisationIdAsync(); if (id > 0) currentOrgId = id; } catch { }
        isDeveloper = await UserAccess.HasUserGroupAsync("Developer");
        canViewCarryForward = await UserAccess.HasPermissionAsync(HRM.Services.Leave.LeaveCarryForwardPermissions.View) &&
            (await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head"));
    }
}
