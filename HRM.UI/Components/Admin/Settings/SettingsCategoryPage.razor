@page "/admin/settings/{CategoryName}"
@using HRM.Components.Admin.Settings.Positions
@page "/admin/settings/{CategoryName}/{Section}"
@page "/admin/settings/org/organisations/{OrganisationId:int}/{OrganisationSection}"
@page "/admin/settings/org/manage/{OrganisationId:int}/{OrganisationSection}"
@page "/admin/settings/org/teams/{TeamSection}"
@inject NavigationManager Navigation
@using HRM.Components.Admin.Settings.Roles
@using HRM.Components.Admin.Settings.Users
@using HRM.Components.Admin.Settings.Workplan
@using HRM.Components.Leave
@using HRM.Components.Leave.Policy
@using HRM.Components.Shared
@using HRM.DTOs
@using HRM.Enum
@using HRM.Models
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using Microsoft.AspNetCore.Components.Authorization

@inject HRM.Application.Contracts.Pages.ILeaveApplications LeaveService
@inject IUserAccessService UserAccess
@rendermode RenderMode.InteractiveServer

<PageTitle>@(ResolvedCategoryName == "org" ? "Organisation Workspace - Settings" : "Settings - HR Portal")</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (ResolvedCategoryName == "org")
        {
            <!-- Admin Workspace Style Layout for /admin/settings/org -->
            <section class="org-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 text-slate-900 transition-all duration-300">
                <!-- Top Header Area Matching Admin Workspace Standard -->
                <div class="org-workspace-header flex flex-col gap-2 p-2">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-900">Organisation Workspace</h1>
                                <span class="rounded-full bg-teal-100 px-2.5 py-0.5 text-xs font-semibold text-teal-800">
                                    Organisation Settings
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Central management for organisation details, document centre, structure types, calendars, locations and permissions.
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
                                    @onclick="() => StateHasChanged()">
                                <span>â†»</span>
                                <span>Refresh</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Solid Folder Navigation Tabs Matching Admin Workspace -->
                <div class="org-workspace-tabs w-full border-b-2 border-teal-700 overflow-x-auto">
                    <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Organisation Workspace Sections">
                        @foreach (var item in VisibleItems)
                        {
                            var isActive = activeItem?.Title == item.Title;
                            <button type="button"
                                    aria-current="@(isActive ? "page" : null)"
                                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r flex items-center gap-2 @(isActive ? "bg-teal-700 text-white border-teal-700 shadow-sm" : "bg-[#86b0be]/40 text-slate-800 border-slate-300 hover:bg-[#86b0be]/60")"
                                    @onclick="() => SelectItem(item)">
                                <span class="text-base">@item.Icon</span>
                                <span>@item.Title</span>
                            </button>
                        }
                    </nav>
                </div>

                <!-- Dynamic Content Panel -->
                <div class="w-full min-w-0 bg-white rounded-b-2xl rounded-tr-2xl border border-slate-200 p-4 shadow-xs">
                    @if (activeItem == null)
                    {
                        <div class="h-full flex flex-col items-center justify-center text-slate-400 opacity-60 py-12">
                            <div class="text-6xl mb-4">ðŸ‘ˆ</div>
                            <p class="text-lg font-medium">Select an item from the menu to view data.</p>
                        </div>
                    }
                    else
                    {
                        @if (activeItem.ComponentType != null)
                        {
                            <DynamicComponent @key="(ResolvedCategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                        }
                        else
                        {
                            <div class="bg-slate-50 border border-slate-100 rounded-xl p-8 text-center text-slate-500">
                                <p><strong>@activeItem.Title</strong> is not available yet. Return to the section menu to choose an available feature.</p>
                            </div>
                        }
                    }
                </div>
            </section>
        }
        else
        {
            <div class="settings-page mx-auto w-full min-w-0 p-4">

                <div class="flex flex-col md:flex-row gap-3 items-start">

                    <div class="flex-shrink-0 flex flex-col gap-1 transition-all duration-300 ease-in-out overflow-hidden @(isSidebarExpanded ? "w-full md:w-60" : "w-20")">

                        <div class="flex items-center @(isSidebarExpanded ? "justify-between" : "justify-center") px-1 mb-3">

                            <h2 class="text-base font-semibold text-slate-800 capitalize truncate transition-opacity duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden")">
                                @ResolvedCategoryName Management
                            </h2>

                            <button aria-expanded="@isSidebarExpanded" aria-label="Toggle settings sections" @onclick="ToggleSidebar" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-blue-600 transition-colors flex-shrink-0" title="@(isSidebarExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                                <svg class="w-6 h-6 transition-transform duration-300 @(isSidebarExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                                </svg>
                            </button>
                        </div>

                        <div class="settings-section-list @(isSidebarExpanded ? "" : "settings-section-list-collapsed") flex flex-col gap-1 mb-2">
                            @foreach (var item in VisibleItems)
                            {
                                <button aria-current="@(activeItem?.Title == item.Title ? "page" : null)" @onclick="() => SelectItem(item)"
                                title="@(!isSidebarExpanded ? item.Title : null)"
                                class="settings-section-link text-left p-1 rounded-xl border transition-colors group flex items-center gap-3 overflow-hidden
                           @(activeItem?.Title == item.Title ? "settings-section-active" : "bg-white hover:bg-slate-50")">

                                    <div class="w-8 h-8 flex items-center justify-center rounded-lg text-xl flex-shrink-0 transition-colors duration-300 mx-auto
                            @(activeItem?.Title == item.Title ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-600 group-hover:bg-blue-100 group-hover:text-blue-700")">
                                        @item.Icon
                                    </div>

                                    <div class="flex-grow min-w-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 w-auto" : "opacity-0 w-0 hidden")">
                                        <h3 class="settings-section-label font-bold text-sm mb-0.5 @(activeItem?.Title == item.Title ? "text-blue-800" : "text-slate-800 group-hover:text-blue-700")">
                                            @item.Title
                                        </h3>

                                    </div>

                                    <div class="flex-shrink-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden") @(activeItem?.Title == item.Title ? "text-blue-600" : "text-slate-300 group-hover:text-blue-600")">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="w-full min-w-0 md:flex-1">

                        <div class="flex flex-col lg:flex-row gap-2 mt-1">

                            <div class="settings-content flex-1 min-w-0 bg-white rounded-xl border border-slate-200 p-3">

                                @if (activeItem == null)
                                {
                                    <div class="h-full flex flex-col items-center justify-center text-slate-400 opacity-60 py-6">
                                        <div class="text-6xl mb-4">ðŸ‘ˆ</div>
                                        <p class="text-lg font-medium">Select an item from the menu to view data.</p>
                                    </div>
                                }
                                else
                                {

                                    <div class="mt-2">
                                        @if (activeItem.ComponentType != null)
                                        {
                                            <DynamicComponent @key="(ResolvedCategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                                        }
                                        else
                                        {
                                            <div class="bg-slate-50 border border-slate-100 rounded-xl p-8 text-center text-slate-500">
                                                <p><strong>@activeItem.Title</strong> is not available yet. Return to the section menu to choose an available feature.</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="p-6 text-center mt-12">
            <p class="text-slate-500 text-lg">
                Please log in to view the settings dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string CategoryName { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }
    [Parameter] public int? OrganisationId { get; set; }
    [Parameter] public string? OrganisationSection { get; set; }
    [Parameter] public string? TeamSection { get; set; }
    private string ResolvedCategoryName => OrganisationSection != null || TeamSection != null
        ? "org" : (CategoryName ?? "").Trim().ToLowerInvariant();
    [SupplyParameterFromQuery(Name = "organisationId")] public int? QueryOrganisationId { get; set; }
    private IDictionary<string, object>? SelectedParameters => activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationTeamSettings)
        ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)(OrganisationId ?? QueryOrganisationId)!, ["InitialKind"] = TeamSection == "departments" ? "Department" : "Team" }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationSettingsEditor)
            ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)OrganisationId!, ["InitialSection"] = OrganisationSection! }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Hr.Documents.DocumentCentreAdminPanel)
            ? new Dictionary<string, object> { ["InitialSection"] = "types" }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)
            ? new Dictionary<string, object> { ["Kind"] = activeItem.Title switch {
                "Manage type" => HRM.DTOs.Organisation.OrganisationResourceKind.StructureTypes,
                "Calendar" => HRM.DTOs.Organisation.OrganisationResourceKind.Calendar,
                "Locations" => HRM.DTOs.Organisation.OrganisationResourceKind.Locations,
                "Location Types" => HRM.DTOs.Organisation.OrganisationResourceKind.LocationTypes,
                "Organisation Types" => HRM.DTOs.Organisation.OrganisationResourceKind.OrganisationTypes,
                "Structure Request Types" => HRM.DTOs.Organisation.OrganisationResourceKind.StructureRequestTypes,
                _ => HRM.DTOs.Organisation.OrganisationResourceKind.Requests } } : null;
    private IEnumerable<SubItem> VisibleItems => GetSubItems(CategoryName).Where(x => x.ComponentType != null &&
        (x.ComponentType != typeof(RequestStateTransitionSettings) || isDeveloper) &&
        (x.ComponentType != typeof(LeaveCarryForwardSettings) || canViewCarryForward));
    private string ItemSlug(SubItem item) => item.Title switch
    {
        "Teams and supervisors" => "teams",
        "Organisation Permissions" => "permissions",
        "Staff Attribute Access" => "staff-access",
        "Manage" => "manage",
        "Manage type" => "types",
        "Document Centre" => "document-types",
        "Document Types" => "document-types",
        "Leave Set Management" => "manage-leave-sets",
        "Job Type Configuration" => "job-types",
        "Request State Transitions" => "state-transitions",
        "Request Approval Flows" => "approval-flows",
        "Leave Accrual by Job Type" => "accrual",
        "Leave Carry Forward" => "carry-forward",
        "Projects & Tasks" => "projects",
        "Project & Task Management" => "projects",
        _ => HRM.Helpers.SectionRoutes.Slug(item.Title)
    };

    // Fixed Record: Replaced 'Url' with 'ComponentType' to match your dynamic rendering goals
    private record SubItem(string Title, string Icon, string Description, Type? ComponentType = null);

     [Parameter]
    public WorkspaceEntityType EntityType { get; set; }




    private SubItem? activeItem;

    private void SelectItem(SubItem item)
    {
        activeItem = item;
        Navigation.NavigateTo($"/admin/settings/{ResolvedCategoryName}/{ItemSlug(item)}");
    }
    private bool isSidebarExpanded = true;

    private void ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
    }

    private List<SubItem> GetSubItems(string? cat) => (string.IsNullOrWhiteSpace(cat) ? ResolvedCategoryName : cat.Trim().ToLowerInvariant()) switch
    {
        "leaves" => new() {
            new("Work Handover Rules", "ðŸ¤", "", typeof(HandoverRuleSettings)),
            new("Leave Set Management", "ðŸ—‚ï¸", "", typeof(LeaveSetsGrid)),
            new("Leave Accrual by Job Type", "ðŸ“…", "Configure this tenant's accrual rates, waiting periods and carry-forward for every Job Type.", typeof(LeaveAccrualSettings)),
            new("Leave Carry Forward", "ðŸ“…", "HR reviews unused days and processes carry-forward at service-year renewal.", typeof(LeaveCarryForwardSettings)),
            new("Manage Configurable", "âš™ï¸", "Global leave system variables.", typeof(LeaveConfigGrid)),
            new("Manage Leave Types", "âš™ï¸", "Global leave system variables.", typeof(LeaveTypeManagement)),
            new("Manage Leave Policy", "âš™ï¸", "Global leave system variables.", typeof(LeavePolicyManagement)),

        },
        "user" => new() {
            new("Manage Account", "ðŸ‘¤", "Edit user account details and account status.", typeof(AccountGrid)),
            new("Admin Portal Access", "ðŸ”", "Explicitly grant or revoke access to the Admin portal.", typeof(AdminPortalAccess)),
            new("Manage Permissions", "ðŸ”", "Assign account roles and direct permissions.", typeof(AccountPermissionsGrid)),
        },
        "org" => new() {
            new("Manage", "ðŸ¢", "Manage organisation details, addresses, contacts, teams and supervisors.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationSettingsEditor)),
            new("Document Centre", "ðŸ—‚ï¸", "Central enterprise document repository, classifications and document requests.", typeof(HRM.Components.Admin.Hr.Documents.DocumentCentreAdminPanel)),
            new("Manage type", "ðŸ·ï¸", "Manage Organisation Structure Types, such as departments and divisions.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Calendar", "ðŸ“…", "View and assign organisation calendars.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Locations", "ðŸ“", "View organisation locations and manage their addresses.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Location Types", "ðŸ·ï¸", "Manage the shared location type catalogue.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Organisation Types", "ðŸ›ï¸", "Manage organisation classifications.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Structure Request Types", "ðŸ“¥", "Manage request types used for organisation structure changes.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Organisation Permissions", "ðŸ”", "Manage the permissions available to this organisation.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationPermissions)),
        },
        "payroll" => new() {
            new("Manage Period", "â³", "Configure pay cycles and deadlines.", null),
            new("Manage Item Type", "ðŸ“‘", "Categorize payroll income and deductions.", null)
        },
        "roles" => new() {
            new("Permissions", "ðŸ”‘", "Manage permissions grouped by area, such as Leave.", typeof(RoleGrid)),
            new("Roles", "ðŸ›¡ï¸", "Manage user groups and their assigned permissions.", typeof(HRM.Components.Admin.Settings.Roles.AccessRolesGrid)),
            new("Staff Attribute Access", "ðŸ”’", "Restrict staff visibility by position classification, user, role or specific staff member.", typeof(HRM.Components.Admin.Settings.Roles.StaffAccessControl)),
        },
        "requests" => new() {
           new("Request Types", "ðŸ“‹", "Manage request types and default approval workflows.", typeof(HRM.Components.Admin.Settings.RequestTypes.RequestTypeConfiguration)),
        },
        "config" => new() {
            new("Work Types", "ðŸ“‹", "Manage the Work Type catalogue.", typeof(HRM.Components.Admin.Settings.WorkTypeManagement)),
            new("Request State Transitions", "ðŸ”„", "Configure allowed From State and To State for each Request Type.", typeof(RequestStateTransitionSettings)),
            new("Request Approval Flows", "ðŸ”„", "Configure approvals for all staff by Job Type and Request Type.", typeof(LeaveFlowSettings)),

           new("Job Type Configuration", "ðŸ‘¥", "Manage job types and staff approval workflows.", typeof(HRM.Components.Admin.Settings.JobTypes.JobTypeConfiguration)),
           new("Manage Attendance Clients", "ðŸ–¥ï¸", "Configure attendance clients and devices.", null),
        },
        "positions" => new() {
           new("Overview", "ðŸ“‹", "View active positions across both frameworks and their assigned staff.", typeof(PositionOverview)),
           new("Pay Frameworks", "ðŸ’°", "Manage shared frameworks, Job Matrices, pay steps, titles and allowances.", typeof(PayFrameworks)),
           new("Manage Ranks", "ðŸ…", "Configure attendance clients and devices.", typeof(RankGrid)),
           new("Manage Classiffications", "ðŸ·ï¸", "Configure attendance clients and devices.", typeof(ClassifficationGrid)),
           new("Manage Positions", "ðŸ’¼", "Manage custom positions and government Job Matrix links.", typeof(PositionGrid)),
           new("Position Allowances", "ðŸ’µ", "Configure required position allowances.", typeof(PositionAllowances)),
        },
        "workplaning" => new() {
           new("Working Hours", "🕒", "Configure weekly hours and temporary official start-time amendments.", typeof(WorkingHoursSettings)),
           new("Duty roster", "📅", "View dated duties, schedule assignments, manual assignments and create rosters.", typeof(HRM.Components.Admin.WorkPlanning.DutyRosterAdmin)),
           new("Templates", "💼", "Define working hours and required clock events using ordered segments.", typeof(WorkTemplateManagement)),
           new("Plans", "💼", "Generate assigned schedules or add manual duty to a staff member's daily plan.", typeof(WorkPlanManagement)),
           new("Segments", "💼", "Manage check-in, work, break and check-out events within templates.", typeof(Segments)),
        },
        "projects" => new() {
            new("Projects & Tasks", "📁", "Comprehensive management, CRUD operations, timelines and task tracking for all projects.", typeof(HRM.Components.Admin.Settings.Projects.ProjectsManagementHub)),
        },

        _ => new() { new("General Configuration", "ðŸ”§", "System level management.", null) }
    };

    // --- Authentication and Service Logic ---
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }





    private WorkspaceSearchResult? SelectedItem;

    private WorkspaceTab ActiveTab = WorkspaceTab.Overview;

    private void SelectItem(WorkspaceSearchResult item)
    {
        SelectedItem = item;
    }

    private void OnTabChanged(WorkspaceTab tab)
    {
        ActiveTab = tab;
    }




    // Variables for Dashboard Data

    private bool isDeveloper;
    private bool canViewCarryForward;
    protected override void OnParametersSet()
    {
        CategoryName = ResolvedCategoryName;
        if (CategoryName == "leaves" && Section is "new-lt" or "manage-new-lt") { Navigation.NavigateTo("/admin/settings/leaves/leave-types", replace: true); return; }
        if (CategoryName == "leaves" && Section == "leave-sets") { Navigation.NavigateTo("/admin/settings/leaves/manage-leave-sets", replace: true); return; }
        if (CategoryName == "documents") { Navigation.NavigateTo("/admin/settings/org/document-types", replace: true); return; }
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section is "document-centre" or "document-center") Section = "document-types";
        if ((CategoryName == "workplaning" && Section == "work-types") ||
            ((CategoryName is "job" or "jobs") && (string.IsNullOrWhiteSpace(Section) || Section == "work-types")))
        {
            Navigation.NavigateTo("/admin/settings/config/work-types", replace: true);
            return;
        }
        if ((CategoryName is "job" or "jobs") && Section is "job-types" or "job-type-configuration")
        {
            Navigation.NavigateTo("/admin/settings/config/job-types", replace: true);
            return;
        }
        if (CategoryName == "staff" || CategoryName == "user" && Section is "staff" or "manage-staff" or "staff-enrollment-number" or "manage-staff-enrollment-number")
        {
            var section = Section is "enrollment" or "staff-enrollment-number" or "manage-staff-enrollment-number" ? "enrollment" : "manage";
            var current = new Uri(Navigation.Uri);
            Navigation.NavigateTo($"/admin/hr/staff/{section}{current.Query}{current.Fragment}", replace: true);
            return;
        }
        if (OrganisationSection != null) { CategoryName = "org"; Section = "manage"; }
        if (TeamSection != null) { CategoryName = "org"; Section = "teams"; }
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "organisations") Section = "manage";
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "requests") Section = "structure-request-types";
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "teams")
        {
            var current = new Uri(Navigation.Uri);
            var target = "/admin/hr/supervisors/management" + current.Query;
            if (TeamSection == "departments") target = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(target, "teamView", "departments");
            Navigation.NavigateTo(target + current.Fragment, replace: true);
            return;
        }
        activeItem = string.IsNullOrWhiteSpace(Section) ? VisibleItems.FirstOrDefault() :
            VisibleItems.FirstOrDefault(x => HRM.Helpers.SectionRoutes.Matches(Section, ItemSlug(x)));
    }

    protected override async Task OnInitializedAsync()
    {
        isDeveloper = await UserAccess.HasUserGroupAsync("Developer");
        canViewCarryForward = await UserAccess.HasPermissionAsync(HRM.Services.Leave.LeaveCarryForwardPermissions.View) &&
            (await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head"));
    }
}
