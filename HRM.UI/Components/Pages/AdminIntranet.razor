@page "/admin/intranet"
@rendermode InteractiveServer

<div class="min-h-screen bg-slate-50">
    <div class="p-2 w-full space-y-2">
        <h1 class="text-2xl font-bold mb-1">Intranet Administration</h1>
        <p class="text-slate-500 text-sm mb-6">Manage intranet posts, categories, new joiners and recognition.</p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <div class="text-xs text-slate-500">Published Posts</div>
                <div class="text-2xl font-bold mt-1">342</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <div class="text-xs text-slate-500">Active Announcements</div>
                <div class="text-2xl font-bold mt-1">14</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <div class="text-xs text-slate-500">Pending Approvals</div>
                <div class="text-2xl font-bold mt-1 text-amber-600">7</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <div class="text-xs text-slate-500">New Joiners</div>
                <div class="text-2xl font-bold mt-1">5</div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2 bg-white border border-slate-200 rounded-xl p-4">
                <h2 class="font-semibold mb-3">Recent Publications</h2>
                <table class="w-full text-sm">
                    <thead class="text-xs text-slate-500 border-b border-slate-200">
                        <tr><th class="text-left py-2">Title</th><th class="text-left py-2">Type</th><th class="text-left py-2">Status</th><th class="text-left py-2">Date</th></tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-slate-100"><td class="py-2">Annual Town Hall</td><td>Announcement</td><td><span class="px-2 py-0.5 rounded bg-green-100 text-green-700 text-xs">Published</span></td><td>12 Nov</td></tr>
                        <tr class="border-b border-slate-100"><td class="py-2">IT Maintenance</td><td>Notice</td><td><span class="px-2 py-0.5 rounded bg-green-100 text-green-700 text-xs">Published</span></td><td>11 Nov</td></tr>
                        <tr><td class="py-2">Leave Policy v3</td><td>Circular</td><td><span class="px-2 py-0.5 rounded bg-amber-100 text-amber-700 text-xs">Scheduled</span></td><td>15 Nov</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <h2 class="font-semibold mb-3">Quick Actions</h2>
                <div class="space-y-2">
                    <button class="w-full p-2 rounded-lg bg-slate-50 text-sm text-left hover:bg-slate-100">Create Post</button>
                    <button class="w-full p-2 rounded-lg bg-slate-50 text-sm text-left hover:bg-slate-100">Manage New Joiners</button>
                    <button class="w-full p-2 rounded-lg bg-slate-50 text-sm text-left hover:bg-slate-100">Content Approval</button>
                    <button class="w-full p-2 rounded-lg bg-slate-50 text-sm text-left hover:bg-slate-100">Manage Categories</button>
                </div>
            </div>
        </div>
    </div>
</div>