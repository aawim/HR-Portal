@page "/budget/{CategoryName}"
@page "/budget/{CategoryName}/{Section}"
@page "/admin/budget/{CategoryName}"
@page "/admin/budget/{CategoryName}/{Section}"
@inject NavigationManager Navigation
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@rendermode RenderMode.InteractiveServer

<PageTitle>Budget - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="max-w-12xl mx-auto py-0 px-4">
            <!-- Back Button -->
            <a href="/admin/budget" class="text-slate-400 hover:text-slate-600 text-sm mb-2 flex items-center gap-1 transition-colors w-fit">
                <AppIcon Name="arrow_back" Class="w-4 h-4 text-base" />
                Back to Budget Hub
            </a>

            <!-- Main Responsive Layout: Stacks vertically on mobile, side-by-side on md+ screens -->
            <div class="flex flex-col md:flex-row gap-2 items-start">
                <!-- LEFT: Sidebar Menu (Responsive width) -->
                <div class="flex-shrink-0 flex flex-col gap-1.5 transition-all duration-300 ease-in-out overflow-hidden @(isSidebarExpanded ? "w-full md:w-80" : "w-20")">

                    <div class="flex items-center @(isSidebarExpanded ? "justify-between" : "justify-center") px-1 mb-2">
                        <h2 class="text-lg font-bold text-slate-800 truncate transition-opacity duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden")">
                            Budget Modules
                        </h2>

                        <button @onclick="ToggleSidebar" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-blue-600 transition-colors flex-shrink-0" title="@(isSidebarExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                            <AppIcon Name="menu" Class="w-6 h-6 transition-transform duration-300 text-2xl " />
                        </button>
                    </div>

                    @foreach (var item in budgetItems)
                    {
                        <button @onclick="() => SelectItem(item)"
                                title="@(!isSidebarExpanded ? item.Title : null)"
                                class="text-left p-2 rounded-xl border shadow-xs transition-all duration-200 group flex items-center gap-3 overflow-hidden
                       @(activeItem?.Key == item.Key ? "bg-blue-50 border-blue-200 ring-1 ring-blue-500/20" : "bg-white border-slate-200 hover:shadow-md hover:border-blue-200 hover:bg-slate-50")">

                            <div class="w-10 h-12 flex items-center justify-center rounded-lg text-xl flex-shrink-0 transition-colors duration-300 mx-auto
                        @(activeItem?.Key == item.Key ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-600 group-hover:bg-blue-100")">
                                @item.Icon
                            </div>

                            <div class="flex-grow min-w-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 w-auto" : "opacity-0 w-0 hidden")">
                                <h3 class="font-bold text-sm mb-0.5 truncate @(activeItem?.Key == item.Key ? "text-blue-800" : "text-slate-800 group-hover:text-blue-700")">
                                    @item.Title
                                </h3>
                                <p class="text-slate-500 text-xs leading-tight line-clamp-2">
                                    @item.Description
                                </p>
                            </div>

                            <div class="flex-shrink-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden") @(activeItem?.Key == item.Key ? "text-blue-600" : "text-slate-300 group-hover:text-blue-600")">
                                <AppIcon Name="chevron_right" Class="w-5 h-5 text-xl" />
                            </div>
                        </button>
                    }
                </div>

                <!-- RIGHT: Dynamic Data Display -->
                <div class="w-full md:w-2/3 lg:w-3/4 flex-grow bg-white rounded-2xl border border-slate-200 shadow-xs p-2 md:p-4 min-h-[600px]">
                    @if (activeItem?.ComponentType != null)
                    {
                        <DynamicComponent Type="@activeItem.ComponentType" />
                    }
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="p-6 text-center mt-12">
            <p class="text-slate-500 text-lg">
                Please log in to view the budget dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string CategoryName { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }

    private record SubItem(string Key, string Title, string Icon, string Description, Type ComponentType);

    private static readonly List<SubItem> budgetItems = new()
    {
        new("overview", "Overview & Execution Reports", "📊", "High-level summary of budget allocations, personal emoluments, and MoF CSV/PDF exports.", typeof(HRM.Components.Admin.Budget.BudgetOverviewPanel)),
        new("manage", "Budget Operations & Fiscal Years", "🏛️", "Configure Fiscal Years, Allocations, MoF Economic Codes, Virements, and Ledger Transactions.", typeof(HRM.Components.Admin.Budget.BudgetManagementHub)),
        new("payroll-bridge", "Payroll Budget Bridge", "🔗", "Pre-payroll budget solvency check and MoF COA component mappings.", typeof(HRM.Components.Admin.Budget.PayrollBudgetBridgePanel))
    };

    private SubItem? activeItem;
    private bool isSidebarExpanded = true;

    protected override void OnParametersSet()
    {
        var key = (Section ?? CategoryName ?? "overview").Trim().ToLowerInvariant();
        activeItem = key switch
        {
            "overview" or "reports" or "budget-overview" or "execution-statement" => budgetItems[0],
            "payroll-bridge" or "import" => budgetItems[2],
            "manage" or "transactions" or "operations-hub" or "allocations-config" or "virements-transfers" or "ledger-entries" => budgetItems[1],
            _ => budgetItems.FirstOrDefault(x => HRM.Helpers.SectionRoutes.Matches(key, x.Key) || HRM.Helpers.SectionRoutes.Matches(key, HRM.Helpers.SectionRoutes.Slug(x.Title)))
                 ?? budgetItems[0]
        };
    }

    private void SelectItem(SubItem item)
    {
        activeItem = item;
        Navigation.NavigateTo($"/admin/budget/{item.Key}");
    }

    private void ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
    }
}
