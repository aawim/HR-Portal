@page "/budget/{CategoryName}"
@page "/budget/{CategoryName}/{Section}"
@page "/admin/budget/{CategoryName}"
@page "/admin/budget/{CategoryName}/{Section}"
@inject NavigationManager Navigation
@inject IUserAccessService UserAccess
@inject IJSRuntime JS
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@rendermode RenderMode.InteractiveServer

<PageTitle>Budget Management - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (checkingAccess)
        {
            <div class="m-2 flex items-center justify-center gap-2 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-xs text-slate-500">
                <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
                <span>Checking budget permissions…</span>
            </div>
        }
        else if (!canAccess)
        {
            <div role="alert" class="m-2 rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/40 p-6 text-xs text-amber-900 dark:text-amber-200">
                You do not have permission to access Budget Management.
            </div>
        }
        else
        {
            <section class="w-full min-w-0 p-2 flex flex-col gap-3 text-slate-900 dark:text-slate-100">
                <!-- Compact Transparent Borderless Header (always full width) -->
                <header class="staff-overview-no-print bg-transparent flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">Budget Management</h1>
                            <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                                <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                                Public Finance &amp; Emoluments
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            @(activeItem?.Description ?? "Manage state budget execution, fiscal year allocations, virements, and payroll budget solvency.")
                        </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <button type="button"
                                class="app-button app-button-neutral app-button-sm"
                                title="@(isFullWidth ? "Shrink to standard layout" : "Expand to full page width")"
                                @onclick="ToggleFullWidthAsync">
                            <AppIcon Name="@(isFullWidth ? "fullscreen_exit" : "fullscreen")" Class="text-xs" />
                            <span>@(isFullWidth ? "Shrink View" : "Full Width")</span>
                        </button>
                        <button type="button"
                                class="app-button app-button-secondary app-button-sm"
                                @onclick="RefreshActiveView">
                            <AppIcon Name="refresh" Class="text-xs" />
                            <span>Refresh</span>
                        </button>
                    </div>
                </header>

                <!-- Full-Width Folder Navigation Tabs -->
                <div class="org-workspace-tabs my-workspace-tabs w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
                    <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Budget Management Sections">
                        @foreach (var item in budgetItems)
                        {
                            var isActive = activeItem?.Key == item.Key;
                            <button type="button"
                                    aria-current="@(isActive ? "page" : null)"
                                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r inline-flex items-center gap-1.5 @(isActive ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                    @onclick="() => SelectItem(item)">
                                <i class="bi @item.Icon text-xs" aria-hidden="true"></i>
                                <span>@item.Title</span>
                            </button>
                        }
                    </nav>
                </div>

                <!-- Content Shell (shrinks in Shrink View; header & tabs remain full width) -->
                <div class="budget-ws-shell @(isFullWidth ? "budget-ws-shell-full" : "budget-ws-shell-standard")">
                    @if (activeItem?.ComponentType != null)
                    {
                        <DynamicComponent @key="(activeItem.Key, refreshKey)" Type="@activeItem.ComponentType" />
                    }
                </div>
            </section>

            <style>
                .budget-ws-shell {
                    width: 100%;
                    min-width: 0;
                    display: flex;
                    flex-direction: column;
                    gap: 0.75rem;
                    transition: max-width 200ms ease;
                }

                .budget-ws-shell-standard {
                    max-width: 80rem;
                    margin-left: auto;
                    margin-right: auto;
                }

                .budget-ws-shell-full {
                    max-width: none;
                }
            </style>
        }
    </Authorized>

    <NotAuthorized>
        <div class="p-6 text-center mt-12">
            <p class="text-slate-500 text-sm">
                Please log in to view the budget dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FullWidthStorageKey = "hrm.budget.full-width";

    [Parameter] public string CategoryName { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }

    private record SubItem(string Key, string Title, string Icon, string Description, Type ComponentType);

    private static readonly List<SubItem> budgetItems = new()
    {
        new("overview", "Overview & Execution Reports", "bi-pie-chart", "High-level summary of budget allocations, personal emoluments, and MoF CSV/PDF exports.", typeof(HRM.Components.Admin.Budget.BudgetOverviewPanel)),
        new("manage", "Budget Operations & Fiscal Years", "bi-bank", "Configure Fiscal Years, Allocations, MoF Economic Codes, Virements, and Ledger Transactions.", typeof(HRM.Components.Admin.Budget.BudgetManagementHub)),
        new("payroll-bridge", "Payroll Budget Bridge", "bi-link-45deg", "Pre-payroll budget solvency check and MoF COA component mappings.", typeof(HRM.Components.Admin.Budget.PayrollBudgetBridgePanel))
    };

    private SubItem? activeItem;
    private bool isFullWidth;
    private int refreshKey;
    private bool checkingAccess = true;
    private bool canAccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await UserAccess.RequireContextAsync();
            var isAdmin = actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Admin");
            var isHr = await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head");
            canAccess = isAdmin || isHr || await UserAccess.HasPermissionAsync("Budget.View") || await UserAccess.HasPermissionAsync("Budget.Manage");
        }
        catch
        {
            canAccess = false;
        }
        finally
        {
            checkingAccess = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", FullWidthStorageKey);
                if (bool.TryParse(saved, out var parsed) && parsed != isFullWidth)
                {
                    isFullWidth = parsed;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    protected override void OnParametersSet()
    {
        var key = (Section ?? CategoryName ?? "overview").Trim().ToLowerInvariant();
        activeItem = key switch
        {
            "overview" or "reports" or "budget-overview" or "execution-statement" => budgetItems[0],
            "payroll-bridge" or "import" => budgetItems[2],
            "manage" or "transactions" or "operations-hub" or "allocations-config" or "virements-transfers" or "ledger-entries" => budgetItems[1],
            _ => budgetItems.FirstOrDefault(x => HRM.Helpers.SectionRoutes.Matches(key, x.Key) || HRM.Helpers.SectionRoutes.Matches(key, HRM.Helpers.SectionRoutes.Slug(x.Title)))
                 ?? budgetItems[0]
        };
    }

    private void SelectItem(SubItem item)
    {
        activeItem = item;
        Navigation.NavigateTo($"/admin/budget/{item.Key}");
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", FullWidthStorageKey, isFullWidth.ToString().ToLowerInvariant());
        }
        catch { }
    }

    private void RefreshActiveView() => refreshKey++;
}
