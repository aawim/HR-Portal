@page "/admin/hr/{CategoryName}"
@using HRM.Components.Admin.Hr.Group
@using HRM.Components.Admin.Hr.Items
@using HRM.Components.Admin.Hr.Transfers
@page "/admin/hr/{CategoryName}/{Section}"
@inject NavigationManager Navigation
@using HRM.Components.Admin.Hr.Individual
@using HRM.Components.Admin.Hr.Organisation
@using HRM.Components.Admin.Hr.Staff
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using Microsoft.AspNetCore.Components.Authorization



@inject HRM.Application.Contracts.Pages.ILeaveApplications LeaveService
@inject IUserAccessService UserAccess
@rendermode RenderMode.InteractiveServer

<PageTitle>@(CategoryName.Equals("requests", StringComparison.OrdinalIgnoreCase) ? "Received Requests - HR Portal" : CategoryName.Equals("supervisors", StringComparison.OrdinalIgnoreCase) ? "Supervisors Workspace - HR Portal" : "HR Portal")</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (checkingAccess)
        {
            <div class="m-4 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Checking HR permissions…</div>
        }
        else if (!canAccessCategory)
        {
            <div class="m-4 rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
                You do not have permission to access this HR section.
            </div>
        }
        else if (CategoryName.Equals("supervisors", StringComparison.OrdinalIgnoreCase))
        {
            <section class="org-workspace-page w-full min-w-0 p-2 flex flex-col gap-2 bg-slate-50/50 text-slate-900 transition-all duration-300">
                <div class="org-workspace-header flex flex-col gap-2 p-2">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-900">Supervisors Workspace</h1>
                                <span class="rounded-full bg-teal-100 px-2.5 py-0.5 text-xs font-semibold text-teal-800">
                                    HR Supervisors
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Assign department and team supervisors, manage team membership and reporting lines.
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/admin/hr"
                               class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition">
                                <span>←</span>
                                <span>Back to HR</span>
                            </a>
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
                                    @onclick="() => StateHasChanged()">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                <span>Refresh</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="org-workspace-tabs my-workspace-tabs w-full border-b-2 border-teal-700 dark:border-teal-600 overflow-x-auto">
                    <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Supervisors Workspace Sections">
                        @foreach (var item in GetSubItems(CategoryName).Where(x => x.ComponentType != null))
                        {
                            var isActive = activeItem?.Title == item.Title;
                            <button type="button"
                                    aria-current="@(isActive ? "page" : null)"
                                    class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r flex items-center gap-2 @(isActive ? "bg-teal-700 dark:bg-teal-600 text-white border-teal-700 dark:border-teal-600 shadow-sm" : "bg-[#86b0be]/30 text-slate-700 hover:text-slate-900 hover:bg-[#86b0be]/50 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                                    @onclick="() => SelectItem(item)">
                                <span>@item.Icon</span>
                                <span>@item.Title</span>
                            </button>
                        }
                    </nav>
                </div>

                <div class="w-full min-w-0 bg-white rounded-b-2xl rounded-tr-2xl border border-slate-200 p-2 shadow-xs">
                    @if (activeItem?.ComponentType != null)
                    {
                        <DynamicComponent @key="(CategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                    }
                    else
                    {
                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-center text-xs text-slate-500">
                            Select an item from the tabs above to view data.
                        </div>
                    }
                </div>
            </section>
        }
        else
        {
        <div class="max-w-12xl mx-auto py-0 px-4">
            <!-- Back Button -->
            @if (!CategoryName.Equals("departments", StringComparison.OrdinalIgnoreCase) && !CategoryName.Equals("groups", StringComparison.OrdinalIgnoreCase))
            {
            <a href="/admin/hr" class="text-slate-400 hover:text-slate-600 text-sm mb-2 flex items-center gap-1 transition-colors w-fit">
                <AppIcon Name="arrow_back" Class="w-4 h-4 text-base" />
                Back to HR
            </a>
            }

            <!-- Main Responsive Layout: Stacks vertically on mobile, side-by-side on md+ screens -->
            <div class="flex flex-col md:flex-row gap-1 items-start">
                <!-- LEFT: Sidebar Menu (Responsive width) -->
                <div class="flex-shrink-0 flex flex-col gap-1 transition-all duration-300 ease-in-out overflow-hidden @(isSidebarExpanded ? "w-full md:w-80" : "w-[60px]")">

                    <div class="flex items-center @(isSidebarExpanded ? "justify-between" : "justify-center") px-1 mb-3">

                        <h2 class="text-xl font-bold text-slate-800 capitalize truncate transition-opacity duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden")">
                            @(CategoryName.Equals("requests", StringComparison.OrdinalIgnoreCase) ? "Received Requests" : $"{CategoryName} Management")
                        </h2>

                        <button @onclick="ToggleSidebar" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-blue-600 transition-colors flex-shrink-0" title="@(isSidebarExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                            <AppIcon Name="menu" Class="w-6 h-6 transition-transform duration-300 text-2xl " />
                        </button>
                    </div>

                    @foreach (var item in GetSubItems(CategoryName).Where(x => x.ComponentType != null))
                    {
                        <button @onclick="() => SelectItem(item)"
                                title="@(!isSidebarExpanded ? item.Title : null)"
                                class="text-left p-1 rounded-xl border shadow-sm transition-all duration-200 group flex items-center gap-3 overflow-hidden
                                 @(activeItem?.Title == item.Title ? "bg-blue-50 border-blue-200 ring-1 ring-blue-500/20" : "bg-white border-slate-200 hover:shadow-md hover:border-blue-200 hover:bg-slate-50")">
                       
                                <div class="w-10 h-12 flex items-center justify-center rounded-lg text-xl flex-shrink-0 transition-colors duration-300 mx-auto">
                                   @item.Icon
                                </div>

                            <div class="flex-grow min-w-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 w-auto" : "opacity-0 w-0 hidden")">
                                <h3 class="font-bold text-sm mb-0.5 truncate @(activeItem?.Title == item.Title ? "text-blue-800" : "text-slate-800 group-hover:text-blue-700")">
                                    @item.Title
                                </h3>
                                <p class="text-slate-500 text-xs leading-tight line-clamp-2">
                                    @item.Description
                                </p>
                            </div>

                            <div class="flex-shrink-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden") @(activeItem?.Title == item.Title ? "text-blue-600" : "text-slate-300 group-hover:text-blue-600")">
                                <AppIcon Name="chevron_right" Class="w-5 h-5 text-xl" />
                            </div>
                        </button>
                    }
                </div>

                <!-- RIGHT: Dynamic Data Display -->
                <div class="w-full md:w-2/3 lg:w-3/4 flex-grow bg-white rounded-2xl border border-slate-200 shadow-sm p-2 md:p-8 min-h-[600px] mt-[40px]">
                    @if (activeItem == null)
                    {
                        <div class="h-full flex flex-col items-center justify-center text-slate-400 opacity-60 min-h-[400px]">
                            <div class="text-6xl mb-4">👈</div>
                            <p class="text-lg font-medium">Select an item from the menu to view data.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Dynamic Component Rendering -->
                        <div class="mt-4">
                            @if (activeItem.ComponentType != null)
                            {
                                <DynamicComponent @key="(CategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                            }
                            else
                            {
                                <div class="bg-slate-50 border border-slate-100 rounded-xl p-8 text-center text-slate-500">
                                    <p><strong>@activeItem.Title</strong> is not available yet. Return to the section menu to choose an available feature.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="p-6 text-center mt-12">
            <p class="text-slate-500 text-lg">
                Please log in to view the settings dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string CategoryName { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "organisationId")] public int? QueryOrganisationId { get; set; }
    private IDictionary<string, object>? SelectedParameters => activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationTeamSettings)
        ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)QueryOrganisationId! } : activeItem?.ComponentType == typeof(ManageGroupsGrid) ? new Dictionary<string, object> { ["RequestedTab"] = "groups" } : null;
    protected override void OnParametersSet()
    {
        if(CategoryName.Equals("individuals",StringComparison.OrdinalIgnoreCase) || CategoryName.Equals("staff",StringComparison.OrdinalIgnoreCase) && Section is "add-individual" or "search-individuals" or "staff-onboarding")
        {
            var uri=new Uri(Navigation.Uri);
            var target="/admin/my/workspace/onboarding"+uri.Query;
            var tab=Section is "add-new" or "add" or "add-individual" ? "add-individual" : Section=="staff-onboarding" ? "requests" : "individuals";
            Navigation.NavigateTo(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(target,"tab",tab)+uri.Fragment,replace:true);return;
        }
        if(CategoryName.Equals("departments",StringComparison.OrdinalIgnoreCase)){Navigation.NavigateTo("/admin/my/workspace/organisation",replace:true);return;}
        if(CategoryName.Equals("leave-sets",StringComparison.OrdinalIgnoreCase)){Navigation.NavigateTo("/admin/settings/leaves/manage-leave-sets",replace:true);return;}
        if(CategoryName.Equals("staff",StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(Section))
        {
            var current=new Uri(Navigation.Uri);
            Navigation.NavigateTo("/admin/hr/staff/manage"+current.Query+current.Fragment,replace:true);return;
        }
        if(CategoryName.Equals("staff",StringComparison.OrdinalIgnoreCase) && Section is "transfers" or "separations" or "certificates" or "document-centre")
        {
            var target = Section switch
            {
                "transfers" => "/admin/hr/staff-transfers",
                "separations" => "/admin/hr/separations",
                "certificates" => "/admin/hr/certificates",
                _ => "/admin/hr/documents"
            };
            Navigation.NavigateTo(target,replace:true);return;
        }
        if(CategoryName.Equals("requests",StringComparison.OrdinalIgnoreCase) && Section is "transfers" or "certificate-requests" or "document-requests")
        {
            var target = Section switch
            {
                "transfers" => "/admin/hr/staff-transfers",
                "certificate-requests" => "/admin/hr/certificates",
                _ => "/admin/hr/documents"
            };
            Navigation.NavigateTo(target,replace:true);return;
        }
        if(CategoryName.Equals("groups",StringComparison.OrdinalIgnoreCase) && Section == "group-type")
        {
            Navigation.NavigateTo("/admin/settings/org/group-types"+new Uri(Navigation.Uri).Query,replace:true);return;
        }
        if(CategoryName.Equals("groups",StringComparison.OrdinalIgnoreCase) && Section is not "management")
        {
            var current=new Uri(Navigation.Uri);
            var target="/admin/hr/groups/management"+current.Query;
            if(Section is "group-types" or "manage-group-types")target="/admin/settings/org/group-types"+current.Query;
            Navigation.NavigateTo(target+current.Fragment,replace:true);return;
        }
        activeItem = string.IsNullOrWhiteSpace(Section) ? GetSubItems(CategoryName).FirstOrDefault() :
            GetSubItems(CategoryName).FirstOrDefault(x => HRM.Helpers.SectionRoutes.Matches(Section, ItemSlug(x)));
    }

    private record SubItem(string Title, string Icon, string Description, Type? ComponentType = null);

    private static string ItemSlug(SubItem item) => item.Title switch
    {
        "Manage Staff" => "manage",
        "Staff Transfers" => "transfers",
        "Staff Separation" => "separations",
        "Departments Management" => "management",
        "Received Requests" => "received",
        "Supervisors Management" => "management",
        "Groups Management" => "management",
        "Staff Enrollment" => "enrollment",
        _ => HRM.Helpers.SectionRoutes.Slug(item.Title)
    };

    private SubItem? activeItem;

    private void SelectItem(SubItem item)
    {
        activeItem = item;
        Navigation.NavigateTo($"/admin/hr/{CategoryName.ToLowerInvariant()}/{ItemSlug(item)}");
    }
    private bool isSidebarExpanded = true;

    private void ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
    }
    private List<SubItem> GetSubItems(string cat) => cat.ToLower() switch
    {
        "staff" => new() {
            new("Manage Staff", "👥", "Manage staff records, departments, groups, and profiles.", typeof(HRM.Components.Admin.Hr.Staff.StaffManagementPage)),
            new("Search", "🔍", "Find active and past employee records.", typeof(StaffSearchGrid)),
            new("Former Staff", "📁", "Read-only staff history and attendance.",typeof(FormerStaff)),
            new("Staff Enrollment", "🪪", "Manage organisation staff enrollment numbers.", typeof(HRM.Components.Admin.Settings.Users.StaffEnrollmentNumberGrid)),
            new("Employee Bulk Upload", "📤", "Import multiple employee records using a spreadsheet.", typeof(EmployeeBulkUpload))
        },

        "departments" => new() {
            new("Departments Management", "🏢", "View approved departments, supervisors and staff.", typeof(HRM.Components.Admin.Hr.Group.DepartmentManagement)),
            new("Department Matrix", "📊", "Department status, workforce capacity and leave overview.", typeof(HRM.Components.Admin.Hr.Group.DepartmentMatrix)),
        },
        "requests" => new() {
            new("Received Requests", "📥", "Received requests grouped by Request Type.", typeof(HRM.Components.Admin.Hr.Group.HrRequestsInbox)),
        },
        "supervisors" => new() {
            new("Supervisors Management", "👥", "Assign department and team supervisors.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationTeamSettings)),
        },
        "groups" => new() {
            new("Groups Management", "👥", "Manage operational groups and related information.", typeof(ManageGroupsGrid)),
        },

        "items" => new() {
            new("Item Catalogue", "📦", "Manage item categories, asset inventory units and consumable stock.", typeof(ItemCataloguePage)),
            new("Staff Items", "📋", "Requisitions, approval and issued items.", typeof(HRM.Components.Admin.Hr.Items.ItemStaffRequestsPage)),
            new("Asset Custody", "🛡️", "Staff asset assignment, handover verification, custody and returns.", typeof(HRM.Components.Admin.Hr.Items.StaffAssetManagementPage)),
        },

        "viuga" => new() {
            new("Staff Fetch", "🔄", "Synchronize staff data with the central Civil Service database.", null),
            new("Classifications", "🗂️", "Map and manage official Civil Service classifications.", null),
            new("Designations", "🎖️", "Manage official job titles and rank designations.", null),
            new("Job Types", "📝", "Define employment types (e.g., Permanent, Contract, Wage).", null),
            new("Offices", "🏛️", "Sync official government office locations and details.", null)
        },

        "others" => new() {
            new("Requests", "📥", "Review and process pending system or HR requests.", null),
            new("Requests Overview", "📊", "View a high-level dashboard of all request statuses.", null),
        },

        _ => new() {
            new("General Configuration", "🔧", "System-level management and core settings.", null)
        }
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<HRM.DTOs.Leave.JobLeaveTypeDto>? leaveBalances;
    private bool checkingAccess = true;
    private bool canAccessCategory;
    private string? checkedCategory;

    private static string[] GetCategoryPermissions(string category) => category.Trim().ToLowerInvariant() switch
    {
        "staff" => ["Admin", "Employee.View", "Staff.Details"],
        "departments" => ["Admin", "Organisation.View", "Employee.View"],
        "requests" => ["Admin", "Requests.View", "Employee.View"],
        "supervisors" => ["Admin", "Organisation.Manage", "Team.Manage"],
        "groups" => ["Admin", "Groups.Manage", "Employee.View"],
        "items" => ["Admin", "Items.View", "Items.Manage"],
        _ => ["Admin", "Employee.View"]
    };

    protected override async Task OnParametersSetAsync()
    {
        var category = (CategoryName ?? string.Empty).Trim().ToLowerInvariant();
        if (string.Equals(checkedCategory, category, StringComparison.OrdinalIgnoreCase))
            return;

        checkingAccess = true;
        canAccessCategory = false;
        try
        {
            var actor = await UserAccess.RequireContextAsync();
            var isAdmin = actor.IsSuperAdministrator || await UserAccess.HasPermissionAsync("Admin");
            var isHr = await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head");
            if (isAdmin || isHr)
            {
                canAccessCategory = true;
            }
            else
            {
                foreach (var perm in GetCategoryPermissions(category))
                {
                    if (await UserAccess.HasPermissionAsync(perm))
                    {
                        canAccessCategory = true;
                        break;
                    }
                }
            }
            checkedCategory = category;
        }
        catch
        {
            canAccessCategory = false;
        }
        finally
        {
            checkingAccess = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            leaveBalances = await LeaveService.GetMyLeaveBalancesAsync();
        }
        catch
        {
            leaveBalances = new();
        }
    }
}
