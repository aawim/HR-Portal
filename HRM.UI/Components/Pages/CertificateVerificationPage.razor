@page "/verify/certificate"
@page "/verify/certificate/{Token}"
@namespace HRM.Components.Pages
@using HRM.DTOs.Certificates
@using HRM.Services.Contracts
@rendermode RenderMode.InteractiveServer

@inject CertificateServiceContracts.IOperations CertificateService
@inject NavigationManager Navigation
@inject ILogger<CertificateVerificationPage> Logger

<PageTitle>Certificate Authenticity Verification - Digital HR</PageTitle>

<div class="min-h-screen bg-slate-50 py-10 px-4 flex flex-col items-center">
    <div class="w-full max-w-2xl space-y-6">
        <!-- Verification Header -->
        <div class="text-center space-y-2">
            <div class="inline-flex items-center gap-2 rounded-full bg-teal-50 border border-teal-200 px-3 py-1 text-xs font-bold text-teal-800">
                <svg class="w-3.5 h-3.5 text-teal-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Maldives Digital HR • Document Verification Service</span>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900">Official Certificate Verification</h1>
            <p class="text-xs text-slate-500 max-w-md mx-auto">
                Authenticate official employment and work experience certificates issued across government agencies and institutions.
            </p>
        </div>

        <!-- Search Input Box -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm space-y-3">
            <label class="block text-xs font-semibold text-slate-700">Certificate Reference or Verification Token</label>
            <div class="flex gap-2">
                <input type="text"
                       placeholder="e.g. CERT-2026-00001 or 32-character digital verification token"
                       class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-xs text-slate-900 placeholder:text-slate-400 font-mono focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
                       @bind="tokenInput"
                       @onkeydown="HandleKeyDown" />
                <button type="button"
                        class="rounded-xl bg-teal-700 hover:bg-teal-800 px-5 py-2.5 text-xs font-bold text-white shadow-xs transition"
                        disabled="@isVerifying"
                        @onclick="VerifyAsync">
                    @(isVerifying ? "Verifying..." : "Verify Certificate")
                </button>
            </div>
        </div>

        <!-- Verification Results -->
        @if (hasSearched && result != null)
        {
            @if (result.Status == "Active")
            {
                <!-- AUTHENTIC & VALID RESULT -->
                <div class="rounded-2xl border border-emerald-200 bg-white p-6 shadow-md space-y-5">
                    <!-- Status Header Banner -->
                    <div class="flex items-start gap-3 border-b border-emerald-100 pb-4">
                        <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="rounded-full bg-emerald-100 text-emerald-800 px-2.5 py-0.5 text-[11px] font-bold inline-block mb-1">
                                ✓ Authenticated &amp; Valid Record
                            </span>
                            <h2 class="text-lg font-bold text-slate-900">Verified HR Credential</h2>
                            <p class="text-xs text-slate-500">
                                This credential was issued by an authorized Human Resources authority and confirmed authentic in official records.
                            </p>
                        </div>
                    </div>

                    <!-- Verified Details Table (Public & Safe, No NID/Salary) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Certificate Reference:</span>
                            <span class="font-mono font-bold text-slate-900 text-sm">@result.CertificateNumber</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Certificate Classification:</span>
                            <span class="font-semibold text-slate-900">@result.CertificateType</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Employee Full Name:</span>
                            <span class="font-bold text-slate-900">@result.EmployeeFullName</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Issuing Organisation:</span>
                            <span class="font-semibold text-slate-900">@result.OrganisationName</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Substantive Designation:</span>
                            <span class="font-medium text-slate-800">@result.PrimaryJobTitle</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Employment Status:</span>
                            <span class="font-semibold text-emerald-700">@result.EmploymentStatus</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Commencement Date:</span>
                            <span class="text-slate-800">@(result.EmploymentStartDate?.ToString("dd MMMM yyyy") ?? "—")</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Cumulative Verified Service:</span>
                            <span class="font-semibold text-teal-800">@result.FormattedDuration</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Official Date of Issue:</span>
                            <span class="text-slate-800">@(result.IssueDate?.ToString("dd MMMM yyyy") ?? "—")</span>
                        </div>
                        <div class="space-y-1">
                            <span class="text-slate-500 block">Authorised Signatory:</span>
                            <span class="font-medium text-slate-800">@result.SignatoryName (@result.SignatoryTitle)</span>
                        </div>
                    </div>

                    <!-- Footer Security Seal -->
                    <div class="rounded-xl bg-slate-50 border border-slate-200 p-3 text-[11px] text-slate-500 flex items-center justify-between gap-2 flex-wrap">
                        <span>Digital Verification Timestamp: <strong>@result.VerificationTimestamp.ToString("dd MMM yyyy HH:mm:ss") UTC</strong></span>
                        <span class="text-emerald-700 font-bold">● System Verification Confirmed</span>
                    </div>
                </div>
            }
            else if (result.Status == "Revoked")
            {
                <!-- REVOKED CERTIFICATE ALERT -->
                <div class="rounded-2xl border border-rose-300 bg-white p-6 shadow-md space-y-4">
                    <div class="flex items-start gap-3 border-b border-rose-100 pb-4">
                        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        </div>
                        <div>
                            <span class="rounded-full bg-rose-100 text-rose-800 px-2.5 py-0.5 text-[11px] font-bold inline-block mb-1">
                                ✕ Certificate Revoked
                            </span>
                            <h2 class="text-lg font-bold text-slate-900">Credential No Longer Valid</h2>
                            <p class="text-xs text-rose-700">
                                This certificate was officially revoked by the issuing authority on @result.RevokedAt?.ToString("dd MMMM yyyy").
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2 text-xs">
                        <div>
                            <span class="text-slate-500 block">Certificate Reference:</span>
                            <span class="font-mono font-bold text-slate-900">@result.CertificateNumber</span>
                        </div>
                        <div>
                            <span class="text-slate-500 block">Employee:</span>
                            <span class="font-semibold text-slate-900">@result.EmployeeFullName</span>
                        </div>
                        <div>
                            <span class="text-slate-500 block">Issuing Authority:</span>
                            <span class="text-slate-800">@result.OrganisationName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(result.RevokedReason))
                        {
                            <div class="rounded-lg bg-rose-50 p-2.5 text-rose-800">
                                <span class="font-semibold block">Revocation Note:</span>
                                <span>@result.RevokedReason</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (result.Status == "Superseded")
            {
                <!-- SUPERSEDED CERTIFICATE ALERT -->
                <div class="rounded-2xl border border-amber-300 bg-white p-6 shadow-md space-y-4">
                    <div class="flex items-start gap-3 border-b border-amber-100 pb-4">
                        <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div>
                            <span class="rounded-full bg-amber-100 text-amber-800 px-2.5 py-0.5 text-[11px] font-bold inline-block mb-1">
                                ⚠ Certificate Superseded
                            </span>
                            <h2 class="text-lg font-bold text-slate-900">Document Replaced by Revised Issuance</h2>
                            <p class="text-xs text-amber-800">
                                This certificate has been superseded by a newer official version.
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2 text-xs">
                        <div>
                            <span class="text-slate-500 block">Original Reference:</span>
                            <span class="font-mono font-bold text-slate-900">@result.CertificateNumber</span>
                        </div>
                        <div>
                            <span class="text-slate-500 block">Employee:</span>
                            <span class="font-semibold text-slate-900">@result.EmployeeFullName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(result.SupersededByCertificateNumber))
                        {
                            <div>
                                <span class="text-slate-500 block">Superseded by Replacement:</span>
                                <span class="font-mono font-bold text-teal-800">@result.SupersededByCertificateNumber</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- NOT FOUND -->
                <div class="rounded-2xl border border-dashed border-rose-300 bg-white p-8 text-center text-xs space-y-3">
                    <div class="w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Unrecognized Certificate Reference</h3>
                        <p class="text-slate-500 max-w-sm mx-auto mt-1">
                            No authentic credential in government records matches the reference or token provided. Please check the code and ensure all characters are entered correctly.
                        </p>
                    </div>
                </div>
            }
        }

        <!-- Information Notice -->
        <div class="text-center text-[11px] text-slate-400 max-w-md mx-auto">
            Authorized by the Civil and Public Service Human Resource Directorate of the Republic of Maldives.
            In compliance with data protection laws, sensitive national identification numbers and internal salary records are excluded from public verification queries.
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Token { get; set; }

    private string tokenInput = "";
    private bool isVerifying;
    private bool hasSearched;
    private CertificateVerificationResultDto? result;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Token))
        {
            tokenInput = Token.Trim();
            await VerifyAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Token) && Token != tokenInput)
        {
            tokenInput = Token.Trim();
            await VerifyAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyAsync();
        }
    }

    private async Task VerifyAsync()
    {
        if (string.IsNullOrWhiteSpace(tokenInput)) return;

        isVerifying = true;
        hasSearched = false;
        result = null;

        try
        {
            result = await CertificateService.VerifyCertificateAsync(tokenInput.Trim());
            hasSearched = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Verification lookup failed for token {Token}", tokenInput);
            result = new CertificateVerificationResultDto { IsValid = false, Status = "NotFound" };
            hasSearched = true;
        }
        finally
        {
            isVerifying = false;
        }
    }
}
