@page "/online/my-payslips"
@page "/online/payslips"
@rendermode RenderMode.InteractiveServer
@using HRM.Application.Contracts.Pages
@using HRM.DTOs
@using HRM.Models.Payroll
@inject IEnterprisePayroll Payroll
@inject HRM.Services.ToastService Toasts

<PageTitle>My Payslips</PageTitle>

<section class="mypayslips-page w-full min-w-0 p-2 flex flex-col gap-3">

    <!-- Header complying with HRM.UI Design Standard -->
    <header class="sticky top-0 z-30 m-0 flex w-full min-w-0 flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-4 py-3.5 shadow-sm rounded-xl">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-lg font-bold text-slate-900">My Payslips</h1>
                <span class="rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-xs font-semibold text-blue-800">
                    Self Service
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">
                View and download itemized monthly salary breakdowns, pension statements, and payment details.
            </p>
        </div>

        <button type="button"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
                @onclick="LoadPayslipsAsync">
            <AppIcon Name="refresh" Class="h-3.5 w-3.5 text-slate-600 text-sm " />
            <span>Refresh</span>
        </button>
    </header>

    @if (isLoading)
    {
        <div class="p-8 text-center text-slate-400 text-xs">
            Loading your payslip history...
        </div>
    }
    else if (payslips.Count == 0)
    {
        <div class="p-12 text-center text-slate-400 text-xs border border-dashed border-slate-200 rounded-xl bg-white">
            No published payslips found for your account. Payslips are published following payroll finalisation and approval.
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            @foreach (var p in payslips)
            {
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between gap-3">
                    <div class="flex items-start justify-between border-b border-slate-100 pb-2.5">
                        <div>
                            <div class="text-xs font-bold text-slate-900">@GetMonthName(p.PeriodMonth) @p.PeriodYear</div>
                            <div class="text-[11px] text-slate-400">Paid on: @p.PaymentDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">
                            Paid
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs py-1">
                        <div>
                            <div class="text-[10px] uppercase font-bold text-slate-400">Gross Earnings</div>
                            <div class="font-extrabold text-emerald-700">@p.GrossEarnings.ToString("N2") <span class="text-[10px] font-normal text-slate-500">MVR</span></div>
                        </div>
                        <div>
                            <div class="text-[10px] uppercase font-bold text-slate-400">Deductions</div>
                            <div class="font-extrabold text-amber-700">@p.TotalDeductions.ToString("N2") <span class="text-[10px] font-normal text-slate-500">MVR</span></div>
                        </div>
                        <div class="col-span-2 pt-1 border-t border-slate-100">
                            <div class="text-[10px] uppercase font-bold text-blue-600">Net Take-Home Pay</div>
                            <div class="text-base font-black text-blue-700">@p.NetSalary.ToString("N2") <span class="text-xs font-normal text-slate-500">MVR</span></div>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-[11px] text-slate-400">Ref: @p.PaymentReference</span>
                        <button type="button"
                                class="rounded-lg bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100 transition-colors"
                                @onclick="() => selectedPayslip = p">
                            View Payslip
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</section>

<!-- PAYSLIP MODAL / PRINT VIEW -->
@if (selectedPayslip != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
        <div class="w-full max-w-2xl rounded-2xl bg-white p-6 shadow-2xl border border-slate-200 flex flex-col gap-4 max-h-[90vh] overflow-y-auto">
            <!-- Payslip Top Header -->
            <div class="flex items-start justify-between border-b border-slate-200 pb-4">
                <div>
                    <h2 class="text-base font-black text-slate-900 uppercase tracking-wide">@selectedPayslip.OrganisationName</h2>
                    <div class="text-xs text-slate-500">OFFICIAL SALARY PAYSLIP · @GetMonthName(selectedPayslip.PeriodMonth) @selectedPayslip.PeriodYear</div>
                    <div class="text-[11px] text-slate-400 mt-0.5">Pay Date: @selectedPayslip.PaymentDate.ToString("dd MMMM yyyy")</div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 font-bold" @onclick="() => selectedPayslip = null">✕</button>
            </div>

            <!-- Employee Info Block -->
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400">Employee</div>
                    <div class="font-bold text-slate-900">@selectedPayslip.EmployeeName</div>
                    <div class="text-[11px] text-slate-500">@selectedPayslip.EmployeeNumber</div>
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400">Position</div>
                    <div class="font-semibold text-slate-800">@selectedPayslip.PositionTitle</div>
                    <div class="text-[11px] text-slate-500">@selectedPayslip.DepartmentName</div>
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400">Grade / Step</div>
                    <div class="font-semibold text-slate-800">@(selectedPayslip.GradeCode ?? "Standard")</div>
                    <div class="text-[11px] text-slate-500">Step @(selectedPayslip.StepNumber?.ToString() ?? "1")</div>
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400">Bank Destination</div>
                    <div class="font-semibold text-slate-800">@selectedPayslip.BankName</div>
                    <div class="text-[11px] text-slate-500 font-mono">@selectedPayslip.BankAccountNumber</div>
                </div>
            </div>

            <!-- Earnings Table -->
            <div>
                <div class="text-xs font-bold text-slate-900 mb-1 flex items-center justify-between">
                    <span>Earnings</span>
                    <span class="text-emerald-700">Gross: @selectedPayslip.GrossEarnings.ToString("N2") MVR</span>
                </div>
                <div class="rounded-lg border border-slate-200 overflow-hidden">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-slate-50 font-semibold text-slate-600 border-b border-slate-200">
                            <tr>
                                <th class="p-2">Description</th>
                                <th class="p-2 text-right">Amount (MVR)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var e in selectedPayslip.Earnings)
                            {
                                <tr>
                                    <td class="p-2 text-slate-800">@e.ComponentName</td>
                                    <td class="p-2 text-right font-semibold text-emerald-700">@e.CalculatedAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Deductions Table -->
            <div>
                <div class="text-xs font-bold text-slate-900 mb-1 flex items-center justify-between">
                    <span>Deductions</span>
                    <span class="text-amber-700">Total Deductions: @selectedPayslip.TotalDeductions.ToString("N2") MVR</span>
                </div>
                <div class="rounded-lg border border-slate-200 overflow-hidden">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-slate-50 font-semibold text-slate-600 border-b border-slate-200">
                            <tr>
                                <th class="p-2">Description</th>
                                <th class="p-2 text-right">Amount (MVR)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var d in selectedPayslip.Deductions)
                            {
                                <tr>
                                    <td class="p-2 text-slate-800">@d.ComponentName</td>
                                    <td class="p-2 text-right font-semibold text-amber-700">@d.CalculatedAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Net Salary Summary Box -->
            <div class="rounded-xl bg-blue-50 border border-blue-200 p-4 flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-blue-900 uppercase tracking-wide">Net Salary Payable</div>
                    <div class="text-[11px] text-blue-700">Transferred via bank instruction · Ref: @selectedPayslip.PaymentReference</div>
                </div>
                <div class="text-xl font-black text-blue-800">
                    @selectedPayslip.NetSalary.ToString("N2") <span class="text-xs font-semibold">MVR</span>
                </div>
            </div>

            <!-- Footer Action -->
            <div class="flex justify-end gap-2 border-t border-slate-100 pt-3">
                <button type="button" class="rounded-lg border border-slate-300 px-4 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" @onclick="() => selectedPayslip = null">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<PayslipRow> payslips = new();
    private PayslipRow? selectedPayslip;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayslipsAsync();
    }

    private async Task LoadPayslipsAsync()
    {
        isLoading = true;
        try
        {
            payslips = await Payroll.GetMyPayslipsAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Could not load payslips: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetMonthName(int month) => month switch
    {
        1 => "January", 2 => "February", 3 => "March", 4 => "April",
        5 => "May", 6 => "June", 7 => "July", 8 => "August",
        9 => "September", 10 => "October", 11 => "November", 12 => "December",
        _ => $"Month {month}"
    };
}
