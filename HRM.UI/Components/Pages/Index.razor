@page "/online"
@page "/"




@using HRM.DTOs
@using HRM.Models
@using HRM.Services
@using HRM.DTOs.Attendance
@using HRM.DTOs.UserContext
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.AppovalWF
@using HRM.Services.Interfaces.Leave
@using HRM.Components.Pages.Online.Dashboard
@using HRM.Services.Attendance.AttendancePlan
@using Microsoft.AspNetCore.Components.Authorization

@inject IJobService JobService
@inject IIndividual _individual
@inject IUserAccessService _access
@inject HRM.Application.Contracts.Pages.ILeaveApplications LeaveService
@inject IAttendanceService AttendanceService
@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService
@inject IAttendancePlanService AttendancePlanService


<PageTitle>Dashboard</PageTitle>



<AuthorizeView>

    <Authorized>
        @if (loading)
        {
            <div class="flex items-center justify-center ">
                <div class="text-center">

                    <div class="w-14 h-14 border-4 border-blue-600 border-t-transparent rounded-full animate-spin mx-auto"></div>

                    <p class="mt-4 text-slate-500">
                        Loading Dashboard...
                    </p>

                </div>
            </div>
        }
        else if (contextUnavailable)
        {
            <div role="alert" class="rounded-xl border bg-white p-4">
                <p class="font-semibold">Your employee session is unavailable.</p>
                <p class="mt-1 text-sm">Please sign in again. If this continues, contact your organisation administrator to check your account access.</p>
                <a href="/Online/Auth/NoAccessLogout" class="app-button app-button-secondary mt-3">Sign in again</a>
            </div>
        }
        else
        {
            <div class="dashboard-layout w-full space-y-2">
                <!-- Header -->
                <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-slate-800">
                            User Dashboard
                        </h1>
                    </div>
                </div>

                <!-- GRID -->

                <div class="grid grid-cols-1 items-start xl:grid-cols-12 gap-2">
                    <!-- LEFT -->
                    <div class="xl:col-span-2 min-w-0 space-y-2">
                        <ProfileCard UserName="@UserName" />

                        <TimeClockCard

                             OnClock="RefreshAttendanceAfterClock" />

                        @if (allowTestClock)
                        {
                        <TestTimeClockCard
                            TodayCheckIn="TodayCheckIn"
                            TodayCheckOut="TodayCheckOut"
                            OnClock="RefreshAttendanceAfterClock" />
                        }

                        <TodaysAttendanceLogCard RefreshKey="attendanceRefreshKey" />
                        <UnevenLogsCard />
                    </div>

                    <!-- CENTER -->

                    <div class="xl:col-span-7 min-w-0 space-y-2">

                            <YearlyAttendanceGridCard
                                ShowExports="false"
                                Days="yearlyAttendanceDays"
                                IsLoading="loadingYearlyAttendance"
                                YearChanged="LoadYearlyAttendance" />



                        <AttendanceSummaryCard WeeklyLogs="weeklyLogs" Days="yearlyAttendanceDays" ShowExports="false" />

                        <RecentLeaveRequestsCard />

                    </div>

                     <!-- RIGHT -->

                    <div class="xl:col-span-3 min-w-0 space-y-2">
                        <HRM.Components.Pages.Online.Leave.Cards.LeaveCalendarCard IncludeTeam="true" />
                        <TodaysWorkPlanCard RefreshKey="attendanceRefreshKey" />

                        <WeeklyWorkedHoursCard RefreshKey="attendanceRefreshKey" />

                        <WorkHandoverInboxCard />
                        <LeaveBalanceCard />

                    </div>

                </div>

            </div>

        }

    </Authorized>

    <NotAuthorized>

        <section class="welcome-shell" aria-labelledby="welcome-title">
            <div class="welcome-hero">
                <div class="welcome-brand">
                    <span class="welcome-mark" aria-hidden="true">HR</span>
                    <span><strong>Government HR Platform</strong><small>Secure workforce services</small></span>
                </div>

                <div class="welcome-copy">
                    <span class="welcome-eyebrow">Enterprise human resource management</span>
                    <h1 id="welcome-title">One trusted workspace for every government organisation.</h1>
                    <p>Manage people, attendance, leave, work schedules and approvals through a tenant-aware platform designed for accountable public service.</p>
                </div>

                <div class="welcome-trust-row" aria-label="Platform characteristics">
                    <span>Organisation isolated</span><span>Role based access</span><span>Auditable workflows</span>
                </div>
            </div>

            <aside class="welcome-signin" aria-labelledby="signin-title">
                <div class="welcome-secure"><span aria-hidden="true"></span>Government digital identity</div>
                <h2 id="signin-title">Access your organisation</h2>
                <p>Use your eFaas account to verify your identity and open the HR workspace assigned by your organisation.</p>
                <a class="welcome-efaas-button" href="/Online/Auth/login">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 5 6v5c0 4.6 2.9 8.1 7 10 4.1-1.9 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Continue with eFaas<small>National Digital Identity</small></span>
                    <svg class="welcome-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 18 6-6-6-6"/></svg>
                </a>
                <div class="welcome-help">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/><path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-2.9 2-2.9 4M12 18h.01"/></svg>
                    <p><strong>HR access is assigned by your organisation.</strong> If eFaas sign-in succeeds but no workspace is available, contact your organisation's HR team.</p>
                </div>
            </aside>

            <div class="welcome-capabilities" aria-label="HR platform capabilities">
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><div><h3>Workforce administration</h3><p>Staff records, positions, organisational structures and controlled administrative access.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><h3>Time and attendance</h3><p>Official schedules, duty rosters, clock events, corrections and attendance reporting.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v15H3V6a2 2 0 0 1 2-2Z"/><path d="m8 16 2 2 5-5"/></svg></span><div><h3>Leave and employee services</h3><p>Entitlements, applications, handovers, receipts and configurable approval journeys.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7l-8-4Z"/><path d="M9 12h6M12 9v6"/></svg></span><div><h3>Governance by design</h3><p>Tenant configuration, permission limits, state transitions and traceable decisions.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h10M7 13h4M15 13h2M7 17h3"/></svg></span><div><h3>Payroll administration</h3><p>Payroll preparation, approved overtime, allowances and controlled processing records.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="9" cy="7" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 11h5M18.5 8.5v5"/></svg></span><div><h3>Recruitment and onboarding</h3><p>Candidate intake, appointment requests and structured employee onboarding workflows.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 5h10a2 2 0 0 1 2 2v12H9M5 5h.01M5 12h.01M5 19h.01"/><path d="m12 10 2 2 4-4"/></svg></span><div><h3>Task management</h3><p>Assign responsibilities, coordinate work handovers and track accountable completion.</p></div></article>
                <article><span class="welcome-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/><path d="m4 7 5-4 6 6 6-6"/></svg></span><div><h3>Employee performance</h3><p>Goals, reviews and performance insights aligned with organisational responsibilities.</p></div></article>
            </div>

            <footer class="welcome-footer"><span>Government HR Platform</span><span>Secure access through eFaas</span></footer>
        </section>


    </NotAuthorized>

</AuthorizeView>



@code{



    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }
    private AttendanceLogDto? TodayCheckIn;
    private AttendanceLogDto? TodayCheckOut;

    private int attendanceRefreshKey = 0;


    private bool loading = true;
    private bool contextUnavailable;


    private string UserName = "";

    private List<YearlyAttendanceDayDto> yearlyAttendanceDays = [];

    private bool loadingYearlyAttendance;
    private int selectedAttendanceYear = DateTime.Today.Year;



    private List<HRM.DTOs.Leave.JobLeaveTypeDto>? leaveBalances;

    private List<AttendanceLogDto>? weeklyLogs;

    private List<AttendanceLogDto>? unevenLogs;

    private List<JobDto>? jobHistory;

    private ActiveJobDto? activeJob;

    private AttendanceLogDto? todayCheckIn;

    private AttendanceLogDto? todayCheckOut;

    private List<HRM.DTOs.Contracts.LeafDto>? leaveRequests;

    private AttendanceWorkPlanDto? _attendancePlan;


    private bool allowTestClock;
    protected override async Task OnInitializedAsync()
    {


         
          
        // var workflowInstanceId = await WorkFlowEngine.StartAsync(23600, 915);



        if (AuthState == null) { ClearDashboardContext(); return; }
        var auth = await AuthState;

        if (!auth.User.Identity?.IsAuthenticated ?? true)
        {
            // User isn't authenticated yet.
            return;
        }
        allowTestClock = await AttendanceLogService.CanUseTestClockAsync();
        await LoadDisplayNameAsync();
        if (contextUnavailable) return;
        await LoadAttendance();
        if (contextUnavailable) return;
        await LoadYearlyAttendance(DateTime.Today.Year);
        loading = false;
    }


    private async Task LoadYearlyAttendance(int year)
    {
        selectedAttendanceYear = year;
        try
        {
            loadingYearlyAttendance = true;

            yearlyAttendanceDays =
                await AttendanceService
                    .GetMyYearlyAttendanceAsync(year);
        }
        catch (UnauthorizedAccessException) { ClearDashboardContext(); }
        finally
        {
            loadingYearlyAttendance = false;
        }
   


    }
    private async Task RefreshAttendanceAfterClock()
    {
        await LoadAttendance();
        if (contextUnavailable) return;
        await LoadYearlyAttendance(selectedAttendanceYear);

        attendanceRefreshKey++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshDashboardAsync()
    {
        if (AuthState == null)
            return;

        var auth = await AuthState;

        if (auth.User.Identity?.IsAuthenticated != true)
            return;

        await LoadDisplayNameAsync();
        if (contextUnavailable) return;

        try
        {
            await LoadAttendance();
            if (contextUnavailable) return;
            await Task.WhenAll(LoadLeaveBalances(), LoadJobHistory());
        }
        catch (UnauthorizedAccessException) { ClearDashboardContext(); }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDisplayNameAsync()
    {
        var context = await _access.GetContextAsync();
        if (context == null) { ClearDashboardContext(); return; }
        contextUnavailable = false;
        UserName = !string.IsNullOrWhiteSpace(context.FullName) ? context.FullName.Trim()
            : !string.IsNullOrWhiteSpace(context.Username) ? context.Username.Trim() : "Employee";
    }

    private void ClearDashboardContext()
    {
        contextUnavailable = true; loading = false; UserName = "";
        weeklyLogs = []; yearlyAttendanceDays = []; leaveBalances = []; jobHistory = []; leaveRequests = []; unevenLogs = [];
        todayCheckIn = null; todayCheckOut = null; TodayCheckIn = null; TodayCheckOut = null; activeJob = null; _attendancePlan = null;
    }

    private async Task LoadAttendance()
    {
        var context = await _access.GetContextAsync();
        if (context == null) { ClearDashboardContext(); return; }
        try
        {
        weeklyLogs = await AttendanceService.GetMyWeeklyAttendanceAsync() ?? [];

        var today = weeklyLogs
            .Where(x => x.Date.Date == DateTime.Today)
            .OrderBy(x => x.Date)
            .ToList();

        var result = await AttendanceService.GetTodayStatusAsync(context.IndividualId);
        todayCheckIn = today.FirstOrDefault(x => x.InOutModeID == 1);
        todayCheckOut = today.FirstOrDefault(x => x.InOutModeID == 2);

        TodayCheckIn = result.checkIn;
        TodayCheckOut = result.checkOut;

        _attendancePlan = null;
        if (context.ActiveJob != null)
        {
            _attendancePlan =
                await AttendancePlanService
                    .GetOrGenerateAsync(
                        context.IndividualId,
                        context.ActiveJob.JobId,
                        context.ActiveJob.OrganisationId,
                        DateTime.UtcNow.AddHours(5).Date);
        }

        StateHasChanged(); // IMPORTANT
        }
        catch (UnauthorizedAccessException) { ClearDashboardContext(); }

    }

    private async Task LoadLeaveBalances()
    {
        leaveBalances = await LeaveService.GetMyLeaveBalancesAsync();
    }
 

    private async Task LoadJobHistory()
    {

        jobHistory = await JobService.GetMyJobHistoryAsync();
    }

    private async Task LoadActiveJob()
    {

        activeJob = await JobService.GetMyActiveJobAsync();
    }

}
