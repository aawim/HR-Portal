@page "/verify"
@page "/verify/{Code}"
@layout HRM.Components.Layout.ReceiptLayout
@rendermode RenderMode.InteractiveServer
@using HRM.Application.Contracts.Signatures
@inject HRM.UI.Services.Signatures.IDocumentSignatureApiClient SignatureApi

<PageTitle>Verify Document Signature - GHR Platform</PageTitle>

<div class="min-h-screen bg-slate-100 py-10 px-4 flex flex-col items-center">
    <div class="w-full max-w-xl bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
            <div style="background-color:#075985; color:#ffffff;" class="w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
            </div>
            <div>
                <h1 class="text-base font-bold text-slate-900">GHR Digital Signature Verification</h1>
                <p class="text-xs text-slate-500">Verify the authenticity and integrity of an electronically signed HRM document.</p>
            </div>
        </div>

        <div class="flex gap-2">
            <input class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-mono uppercase text-slate-900 focus:border-[#075985] focus:outline-none"
                   placeholder="Enter verification code (e.g. SIG-2026-A1B2C3D4)"
                   @bind="lookupCode"
                   @bind:event="oninput" />
            <button type="button"
                    style="background-color:#075985; color:#ffffff;"
                    class="rounded-lg px-4 py-2 text-xs font-semibold shadow-xs hover:opacity-90 disabled:opacity-50"
                    disabled="@(loading || string.IsNullOrWhiteSpace(lookupCode))"
                    @onclick="LookupAsync">
                @(loading ? "Checking..." : "Verify")
            </button>
        </div>

        @if (searched && result is null)
        {
            <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-900 flex items-start gap-2.5">
                <i class="bi bi-x-circle-fill text-rose-600 text-base shrink-0" aria-hidden="true"></i>
                <div>
                    <div class="font-bold">Signature Record Not Found</div>
                    <p class="mt-0.5">No digital signature matching <strong class="font-mono">@lookupCode.Trim().ToUpperInvariant()</strong> exists in GHR.</p>
                </div>
            </div>
        }
        else if (result is not null)
        {
            @if (result.IsValid)
            {
                <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-xs text-emerald-950 flex items-start gap-2.5">
                    <i class="bi bi-patch-check-fill text-emerald-600 text-lg shrink-0" aria-hidden="true"></i>
                    <div>
                        <div class="font-bold text-sm">Verified Authentic Signature</div>
                        <p class="mt-0.5 text-emerald-800">This signature was electronically applied in GHR and has not been revoked.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="rounded-xl border border-rose-300 bg-rose-50 p-4 text-xs text-rose-950 flex items-start gap-2.5">
                    <i class="bi bi-exclamation-octagon-fill text-rose-600 text-lg shrink-0" aria-hidden="true"></i>
                    <div>
                        <div class="font-bold text-sm">Signature Revoked</div>
                        @if (!string.IsNullOrWhiteSpace(result.RevokeReason))
                        {
                            <p class="mt-0.5 text-rose-800">Reason: @result.RevokeReason</p>
                        }
                    </div>
                </div>
            }

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-1">
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Verification Code</dt>
                    <dd class="mt-0.5 font-mono font-bold text-slate-900">@result.VerificationCode</dd>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Signed Timestamp (MVT)</dt>
                    <dd class="mt-0.5 font-semibold text-slate-900">@result.SignedAtUtc.AddHours(5).ToString("dd MMM yyyy, HH:mm:ss")</dd>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Signed By</dt>
                    <dd class="mt-0.5 font-semibold text-slate-900">@result.SignerName</dd>
                    @if (!string.IsNullOrWhiteSpace(result.SignerPosition))
                    {
                        <dd class="text-[11px] text-slate-600">@result.SignerPosition</dd>
                    }
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Organisation</dt>
                    <dd class="mt-0.5 font-semibold text-slate-900">@(result.OrganisationName ?? "—")</dd>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Document</dt>
                    <dd class="mt-0.5 font-semibold text-slate-900">@result.DocumentType (#@result.DocumentId)</dd>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Role / Slot</dt>
                    <dd class="mt-0.5 font-semibold text-slate-900">@result.SlotLabel</dd>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3 sm:col-span-2">
                    <dt class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Document Content SHA-256 Hash</dt>
                    <dd class="mt-0.5 font-mono text-[11px] break-all text-slate-700">@result.DocumentContentHash</dd>
                </div>
            </dl>
        }
    </div>
</div>

@code {
    [Parameter] public string? Code { get; set; }

    private string lookupCode = "";
    private VerifySignatureDto? result;
    private bool loading, searched;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Code) && !string.Equals(lookupCode, Code, StringComparison.OrdinalIgnoreCase))
        {
            lookupCode = Code.Trim().ToUpperInvariant();
            await LookupAsync();
        }
    }

    private async Task LookupAsync()
    {
        if (loading || string.IsNullOrWhiteSpace(lookupCode)) return;
        loading = true;
        searched = false;
        try
        {
            result = await SignatureApi.VerifySignatureAsync(lookupCode.Trim());
            searched = true;
        }
        catch
        {
            result = null;
            searched = true;
        }
        finally
        {
            loading = false;
        }
    }
}
