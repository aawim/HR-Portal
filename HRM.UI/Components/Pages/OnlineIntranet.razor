@page "/online/dhr-connect"
@rendermode InteractiveServer

<div class="min-h-screen bg-slate-50">
    <div class="w-full p-2 space-y-2">
        <div class="bg-white border border-slate-200 rounded-xl p-4 mb-4">
            <div class="text-sm text-slate-500">Monday, 12 November 2026 · Organisation</div>
            <h1 class="text-2xl font-bold mt-1">Good Morning!</h1>
            <p class="text-slate-600 mt-1">Here's what's happening in your organisation today.</p>
            <div class="mt-3 flex gap-2 flex-wrap">
                <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">3 new announcements</span>
                <span class="px-3 py-1 rounded-full bg-green-50 text-green-700 text-xs font-medium">2 new joiners this week</span>
                <span class="px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-medium">1 event today</span>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <aside class="lg:col-span-3 space-y-3">
                <div class="bg-white border border-slate-200 rounded-xl p-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-300"></div>
                        <div>
                            <div class="font-semibold text-sm">Employee</div>
                            <div class="text-xs text-slate-500">Department</div>
                        </div>
                    </div>
                </div>
                <div class="bg-white border border-slate-200 rounded-xl p-4">
                    <h3 class="font-semibold text-sm mb-2">Quick Links</h3>
                    <div class="space-y-1 text-sm">
                        <a class="block px-2 py-1 rounded hover:bg-slate-50" href="#">HR Portal</a>
                        <a class="block px-2 py-1 rounded hover:bg-slate-50" href="#">IT Helpdesk</a>
                        <a class="block px-2 py-1 rounded hover:bg-slate-50" href="#">Policies</a>
                    </div>
                </div>
            </aside>

            <main class="lg:col-span-6 space-y-3">
                <div class="bg-white border border-slate-200 rounded-xl p-4">
                    <input class="w-full px-4 py-2 rounded-full border border-slate-200 bg-slate-50 text-sm" placeholder="Share an update with your colleagues..." />
                </div>
                <div class="bg-white border border-slate-200 rounded-xl p-4">
                    <div class="font-semibold text-sm">HR Department <span class="ml-1 px-2 py-0.5 rounded bg-blue-100 text-blue-700 text-xs">Official</span></div>
                    <div class="text-xs text-slate-500">2 hours ago · All staff</div>
                    <p class="mt-3 text-sm">Please welcome our new colleague joining the IT Department.</p>
                    <div class="flex gap-4 mt-3 text-sm text-slate-500 border-t border-slate-100 pt-3">
                        <button class="hover:text-blue-700"><i class="fa-regular fa-thumbs-up mr-1"></i>24</button>
                        <button class="hover:text-blue-700"><i class="fa-regular fa-comment mr-1"></i>8</button>
                        <button class="hover:text-blue-700"><i class="fa-regular fa-bookmark mr-1"></i>Save</button>
                    </div>
                </div>
            </main>

            <aside class="lg:col-span-3 space-y-3">
                <div class="bg-white border border-slate-200 rounded-xl p-4">
                    <h3 class="font-semibold text-sm mb-2">Upcoming Events</h3>
                    <div class="space-y-2">
                        <div class="p-2 rounded-lg bg-slate-50">
                            <div class="text-xs text-blue-700 font-semibold">20 Nov</div>
                            <div class="text-sm font-medium">Staff Town Hall</div>
                        </div>
                    </div>
                </div>
                <div class="bg-white border border-slate-200 rounded-xl p-4">
                    <h3 class="font-semibold text-sm mb-2">New Joiners</h3>
                    <div class="space-y-2 text-sm text-slate-600">
                        <div>Sara Al-Mansoori</div>
                        <div>Omar Faisal</div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>