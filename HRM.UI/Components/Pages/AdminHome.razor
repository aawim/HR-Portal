@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HRM.DTOs
@using HRM.Services
@inject HRM.Services.Interfaces.IUserContext UserContext
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject HRM.Services.Contracts.OrganisationWorkspaceServiceContracts.IOperations Workspace
@inject HRM.Services.Contracts.HrRequestInboxServiceContracts.IOperations Requests
@inject ILogger<AdminHome> Logger

<PageTitle>Organisation Overview</PageTitle>
<section class="space-y-3" aria-busy="@busy">
    <header class="flex flex-wrap items-center justify-between gap-2">
        <div><h1 class="text-xl font-semibold">Organisation Overview</h1><p class="text-sm text-slate-500">@(organisation?.Name ?? "Current organisation") · @DateTime.UtcNow.AddHours(5).ToString("dd MMM yyyy")</p></div>
        <button type="button" class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Refresh</button>
    </header>
    @if(error != null) { <p role="alert" class="rounded border p-3">@error</p> }
    @if(busy && organisation == null) { <p role="status">Loading organisation overview…</p> }
    @if(organisation != null)
    {
        <div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
            <article class="rounded-lg border bg-white p-3"><h2 class="text-sm">Active staff</h2><strong class="text-2xl">@organisation.StaffCount</strong><p class="text-xs text-slate-500">Approved current employment</p></article>
            <article class="rounded-lg border bg-white p-3"><h2 class="text-sm">Approved structures</h2><strong class="text-2xl">@organisation.Departments.Count</strong></article>
            <article class="rounded-lg border bg-white p-3"><h2 class="text-sm">Active teams</h2><strong class="text-2xl">@organisation.Teams.Count</strong></article>
            <article class="rounded-lg border bg-white p-3"><h2 class="text-sm">Processing requests</h2><strong class="text-2xl">@(inbox == null ? "—" : inbox.Groups.Sum(g => g.Processing).ToString())</strong><p class="text-xs text-slate-500">@(inbox?.OrganisationWide == true ? "Organisation requests" : "Requests received or assigned to you")</p></article>
        </div>
        <div class="grid items-start gap-3 xl:grid-cols-3">
            <section class="min-w-0 overflow-hidden rounded-lg border bg-white xl:col-span-2">
                <header class="flex flex-wrap items-center justify-between gap-2 border-b px-3 py-2"><h2 class="font-semibold">Departments and teams</h2><label><span class="visually-hidden">Filter units</span><input type="search" class="rounded border bg-transparent px-2 py-1 text-sm" placeholder="Filter units…" @bind="search" @bind:event="oninput" /></label></header>
                <div class="overflow-auto" style="max-height:32rem"><table class="w-full text-left text-sm"><thead><tr class="border-b"><th class="px-3 py-2">Unit</th><th class="px-3 py-2">Type</th><th class="px-3 py-2">Active staff</th></tr></thead><tbody>
                @foreach(var unit in Units)
                { <tr class="border-b"><td class="px-3 py-2">@unit.Name</td><td class="px-3 py-2">@unit.Kind</td><td class="px-3 py-2">@unit.Members</td></tr> }
                @if(!Units.Any()) { <tr><td colspan="3" class="p-3">No matching units.</td></tr> }
                </tbody></table></div>
                <p class="px-3 py-2 text-xs text-slate-500">Staff may belong to multiple teams; team totals are not headcount.</p>
            </section>
            <section class="min-w-0 rounded-lg border bg-white">
                <header class="flex flex-wrap justify-between gap-2 border-b px-3 py-2"><h2 class="font-semibold">Processing by request type</h2><a class="text-sm underline" href="/admin/hr/requests">View requests</a></header>
                @if(requestError != null) { <p role="alert" class="p-3">@requestError</p> }
                else if(inbox != null)
                {
                    @foreach(var group in inbox.Groups.Where(g => g.Processing > 0).OrderByDescending(g => g.Processing))
                    { <div class="flex justify-between gap-2 border-b px-3 py-2 text-sm"><span>@group.Name</span><strong>@group.Processing</strong></div> }
                    @if(!inbox.Groups.Any(g => g.Processing > 0)) { <p class="p-3 text-sm">No processing requests in your permitted scope.</p> }
                }
            </section>
        </div>
    }
</section>

@code {
    private OrganisationWorkspaceData? organisation;
    private HrInboxData? inbox;
    private bool busy;
    private string? error, requestError;
    private string search = "";
    private IEnumerable<(string Name, string Kind, int Members)> Units =>
        (organisation?.Departments ?? []).Select(d => (d.Name, Kind: "Structure", d.Members))
        .Concat((organisation?.Teams ?? []).Select(t => (t.Name, Kind: "Team", t.Members)))
        .Where(u => u.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderBy(u => u.Name);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if(busy) return;
        busy = true; error = null; requestError = null;
        organisation = null; inbox = null;
        try
        {
            var session = await UserContext.GetSessionAsync();
            if(session?.CanAccessAdminPortal != true) throw new UnauthorizedAccessException();
            var organisationId = await Access.GetCurrentOrganisationIdAsync();
            await Task.WhenAll(LoadOrganisationAsync(organisationId), LoadRequestsAsync());
        }
        catch(Exception ex) { Logger.LogError(ex,"Loading organisation overview"); error="The organisation overview could not be loaded. Refresh or contact your HR administrator."; }
        finally { busy = false; }
    }
    private async Task LoadOrganisationAsync(int organisationId) => organisation = await Workspace.LoadAsync(organisationId);
    private async Task LoadRequestsAsync()
    {
        try { inbox = await Requests.LoadAsync(status: "processing"); }
        catch(Exception ex) { Logger.LogWarning(ex,"Loading overview request totals"); requestError="Request totals are temporarily unavailable."; }
    }
}
