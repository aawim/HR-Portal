@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HRM.DTOs
@using HRM.Services
@inject HRM.Services.Interfaces.IUserContext UserContext
@inject HRM.Services.Interfaces.IUserAccessService Access
@inject HRM.Services.Contracts.OrganisationWorkspaceServiceContracts.IOperations Workspace
@inject HRM.Services.Contracts.HrRequestInboxServiceContracts.IOperations Requests
@inject ILogger<AdminHome> Logger

<PageTitle>Organisation Overview</PageTitle>
<section class="executive-dashboard" aria-busy="@busy">
    <header class="executive-heading">
        <div><span class="eyebrow">Government HR Platform · People analytics</span><h1>Organisation Overview</h1><p>@(organisation?.Name ?? "Current organisation")</p></div>
        <div class="heading-actions"><span class="sync-label">@(loadedAt?.ToString("dd MMM yyyy · HH:mm") ?? "Not refreshed")</span><button type="button" disabled="@busy" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button></div>
    </header>
    <div class="executive-toolbar">
        <label>Department / structure<select @bind="selectedDepartment"><option value="0">All approved structures</option>@foreach(var d in organisation?.Departments ?? []) { <option value="@d.Id">@d.Name (@d.Members)</option> }</select></label>
        <label>Find unit<input type="search" placeholder="Search departments or teams" @bind="search" @bind:event="oninput" /></label>
        <label>Work type<select @bind="selectedJobType"><option value="0">All job types</option>@foreach(var type in (organisation?.Workforce ?? []).DistinctBy(s=>s.JobTypeId).OrderBy(s=>s.JobType)) { <option value="@type.JobTypeId">@type.JobType</option> }</select></label>
        <label>Work modality<select @bind="selectedModality"><option value="all">All staff</option><option value="home">Work from home</option><option value="onsite">On site</option><option value="leave">On leave</option></select></label>
        <span class="scope-label">Current workforce · @DateTime.UtcNow.AddHours(5).ToString("dd MMM yyyy")</span>
    </div>
    @if(error != null) { <p role="alert" class="dashboard-alert">@error</p> }
    @if(busy && organisation == null) { <p role="status">Loading organisation overview…</p> }
    @if(organisation != null)
    {
        <section class="executive-kpis" aria-label="Executive summary">
            @foreach(var metric in Metrics)
            {
                <article class="executive-card kpi"><div class="kpi-label"><span>@metric.Label</span><i class="@metric.Icon" aria-hidden="true"></i></div><strong>@metric.Value</strong><small>@metric.Note</small></article>
            }
        </section>


      


        <section class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-2.5 mb-5" aria-label="Executive summary">
            @foreach (var metric in Metrics)
            {
                <article class="bg-white border border-slate-200 rounded-lg p-2.5 flex flex-col justify-between min-h-[76px] shadow-sm hover:border-slate-300 transition-colors">
                    <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <span class="truncate">@metric.Label</span>
                        <i class="@metric.Icon text-slate-400 text-sm shrink-0 ml-1" aria-hidden="true"></i>
                    </div>

                    <div class="flex items-baseline justify-between mt-1">
                        <strong class="text-xl font-bold text-slate-900 leading-tight">@metric.Value</strong>
                        <small class="text-[11px] text-slate-400 truncate ml-2 text-right">@metric.Note</small>
                    </div>
                </article>
            }
        </section>



        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

            <!-- Column 1: Request Activity -->
            <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex flex-col justify-between">
                <header class="flex items-start justify-between gap-4 mb-4 pb-3 border-b border-slate-100">
                    <div>
                        <h2 class="text-base font-semibold text-slate-800">Request activity</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Processing requests by type within your permitted scope</p>
                    </div>
                    <a href="/admin/hr/requests" class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:underline shrink-0">
                        View all <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </header>

                <div class="flex-1">
                    @if (requestError != null)
                    {
                        <div class="p-3 rounded-lg bg-red-50 text-red-700 text-xs" role="alert">
                            @requestError
                        </div>
                    }
                    else if (inbox != null && inbox.Groups.Count > 0)
                    {
                        <div class="space-y-3">
                            @foreach (var g in inbox.Groups.OrderByDescending(g => g.Processing))
                            {
                                <div class="flex items-center gap-3 text-xs">
                                    <span class="w-32 font-medium text-slate-600 truncate" title="@g.Name">@g.Name</span>
                                    <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
                                        <div class="bg-blue-600 h-full rounded-full transition-all duration-300"
                                             style="width: @((g.Processing / (double)Math.Max(1, inbox.Groups.Max(x => x.Processing)) * 100).ToString("0.##"))%;">
                                        </div>
                                    </div>
                                    <strong class="w-8 text-right font-semibold text-slate-800 shrink-0">@g.Processing</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-slate-400 text-center">
                            <i class="bi bi-inbox text-3xl mb-2" aria-hidden="true"></i>
                            <p class="text-xs">No processing requests in your permitted scope.</p>
                        </div>
                    }
                </div>
            </section>

            <!-- Column 2: Department Headcount -->
            <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex flex-col justify-between">
                <header class="mb-4 pb-3 border-b border-slate-100">
                    <div>
                        <h2 class="text-base font-semibold text-slate-800">Department headcount</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Active staff assignments across approved structures</p>
                    </div>
                </header>

                <div class="flex-1">
                    <div class="space-y-3">
                        @foreach (var d in FilteredDepartments.OrderByDescending(d => d.Members))
                        {
                            <div class="flex items-center gap-3 text-xs">
                                <span class="w-32 font-medium text-slate-600 truncate" title="@d.Name">@d.Name</span>
                                <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
                                    <div class="bg-emerald-600 h-full rounded-full transition-all duration-300"
                                         style="width: @((d.Members / (double)Math.Max(1, organisation.StaffCount) * 100).ToString("0.##"))%;">
                                    </div>
                                </div>
                                <strong class="w-8 text-right font-semibold text-slate-800 shrink-0">@d.Members</strong>
                            </div>
                        }
                        @if (!FilteredDepartments.Any())
                        {
                            <p class="text-xs text-slate-400 text-center py-8">No matching structures.</p>
                        }
                    </div>
                </div>
            </section>

            <!-- Column 3: Executive Summary Metrics -->
            <section class="bg-white border border-slate-200 rounded-xl p-2 shadow-sm flex flex-col" aria-label="Executive summary">
                <header class="mb-4 pb-3 border-b border-slate-100">
                    <h2 class="text-base font-semibold text-slate-800">Key metrics</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Quick status &amp; operational distribution</p>
                </header>

                <div class="grid grid-cols-1 gap-2 max-h-[380px] overflow-y-auto pr-1">
                    @foreach (var metric in Metrics)
                    {
                        <article class="bg-slate-50 border border-slate-100 rounded-lg p-2.5 flex flex-col justify-between hover:bg-slate-100/80 transition-colors">
                            <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
                                <span class="truncate" title="@metric.Label">@metric.Label</span>
                                <i class="@metric.Icon text-slate-400 text-xs shrink-0 ml-1" aria-hidden="true"></i>
                            </div>

                            <div class="flex items-baseline justify-between mt-1.5">
                                <strong class="text-base font-bold text-slate-900 leading-tight">@metric.Value</strong>
                                <small class="text-[10px] text-slate-400 truncate ml-1 text-right" title="@metric.Note">@metric.Note</small>
                            </div>
                        </article>
                    }
                </div>
            </section>

        </div>









