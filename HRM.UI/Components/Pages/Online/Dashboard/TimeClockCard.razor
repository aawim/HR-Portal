    private DateTime _Date = DateTime.Today;
    private TimeOnly? _Time = TimeOnly.FromDateTime(DateTime.Now);

    private DateTime GetAttendanceTimestamp()
    {
        if (!_useTime)
            return DateTime.UtcNow.AddHours(5);

        if (!_Time.HasValue)
        {
            throw new InvalidOperationException(
                "Please select a test time.");
        }

        var time = _Time.Value;

        return new DateTime(
            _Date.Year,
            _Date.Month,
            _Date.Day,
            time.Hour,
            time.Minute,
            time.Second);
    }

    private async Task HandleClock()
    {
        ProcessingClock = true;

        try
        {
            var context = await UserAccessService.RequireContextAsync();

            await AttendanceLogService.AddClockEventAsync(context.IndividualId);

            if (OnClock.HasDelegate)
            {
                await OnClock.InvokeAsync();
            }
        }
        finally
        {
            ProcessingClock = false;
        }
    }







