    private bool ProcessingClock;
    private bool checkingLocation;
    private bool canClock;
    private List<WorkTypeGeofenceDto> activeGeofences = [];
    private string? locationStatusText;
    private bool locationWithinBoundary;
    private bool _useTime = false;
    private AttendanceLogDto? todayCheckIn;
    private AttendanceLogDto? todayCheckOut;
    private string? feedbackMessage;
    private bool feedbackIsError;

    private string StatusLabel =>
        todayCheckIn == null ? "Not Clocked In" :
        todayCheckOut == null ? "Clocked In" : "Clocked Out";

    private string StatusBadgeClass =>
        todayCheckIn == null ? "bg-amber-50 text-amber-700 border border-amber-200" :
        todayCheckOut == null ? "bg-emerald-50 text-emerald-700 border border-emerald-200" :
        "bg-slate-100 text-slate-700 border border-slate-200";

    private string PrimaryActionLabel =>
        todayCheckIn == null ? "Clock In" :
        todayCheckOut == null ? "Clock Out / Event" : "Record Clock Event";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            canClock = await WorkTypes.CanClockAsync();
        }
        catch
        {
            canClock = false;
        }

        if (canClock)
        {
            try { activeGeofences = await WorkTypes.GetActiveClockGeofencesAsync(); }
            catch { activeGeofences = []; }
        }

        await RefreshTodayStatusAsync();
    }

    private async Task CheckLocationAsync()
    {
        if (checkingLocation || activeGeofences.Count == 0) return;
        checkingLocation = true;
        try
        {
            var pos = await JS.InvokeAsync<GeoPositionResult>("hrmGeoMap.getCurrentPosition");
            if (pos is not { Ok: true })
            {
                locationWithinBoundary = false;
                locationStatusText = pos?.Error ?? "Could not resolve your current GPS location.";
                return;
            }

            var closest = activeGeofences
                .Select(g => new
                {
                    Geofence = g,
                    Distance = WorkTypeGeofenceHelper.DistanceMeters(pos.Lat, pos.Lng, g.Latitude, g.Longitude)
                })
                .OrderBy(x => x.Distance)
                .First();

            locationWithinBoundary = closest.Distance <= closest.Geofence.RadiusMeters;
            var distRounded = Math.Round(closest.Distance);
            locationStatusText = locationWithinBoundary
                ? $"Inside boundary · {distRounded:N0} m from {closest.Geofence.Label} ({pos.Lat:F5}, {pos.Lng:F5} ±{pos.Accuracy} m)"
                : $"Outside boundary · {distRounded:N0} m from {closest.Geofence.Label} (allowed: {closest.Geofence.RadiusMeters} m; your GPS: {pos.Lat:F5}, {pos.Lng:F5})";
        }
        catch
        {
            locationWithinBoundary = false;
            locationStatusText = "Could not access browser location.";
        }
        finally
        {
            checkingLocation = false;
        }
    }

    private async Task RefreshTodayStatusAsync()
    {
        try
        {
            var ctx = await UserAccessService.GetContextAsync();
            if (ctx?.IndividualId > 0)
            {
                var status = await AttendanceService.GetTodayStatusAsync(ctx.IndividualId);
                todayCheckIn = status.checkIn;
                todayCheckOut = status.checkOut;
            }
        }
        catch
        {
            // Keep UI resilient if status lookup is unavailable in test or offline contexts.
        }
    }

    private DateTime _Date = DateTime.Today;
    private TimeOnly? _Time = TimeOnly.FromDateTime(DateTime.Now);

    private DateTime GetAttendanceTimestamp()
    {
        if (!_useTime)
            return DateTime.UtcNow.AddHours(5);

        if (!_Time.HasValue)
        {
            throw new InvalidOperationException(
                "Please select a test time.");
        }

        var time = _Time.Value;

        return new DateTime(
            _Date.Year,
            _Date.Month,
            _Date.Day,
            time.Hour,
            time.Minute,
            time.Second);
    }

    private async Task HandleClock()
    {
        ProcessingClock = true;
        feedbackMessage = null;
        feedbackIsError = false;

        try
        {
            var context = await UserAccessService.RequireContextAsync();
            try { activeGeofences = await WorkTypes.GetActiveClockGeofencesAsync(); }
            catch { }

            if (activeGeofences.Count > 0)
            {
                var pos = await JS.InvokeAsync<GeoPositionResult>("hrmGeoMap.getCurrentPosition");
                if (pos is not { Ok: true })
                {
                    feedbackIsError = true;
                    feedbackMessage = pos?.Error ?? "Location access is required to clock in for your Geo Location work type.";
                    ToastService.Error(feedbackMessage);
                    return;
                }

                var closest = activeGeofences
                    .Select(g => new
                    {
                        Geofence = g,
                        Distance = WorkTypeGeofenceHelper.DistanceMeters(pos.Lat, pos.Lng, g.Latitude, g.Longitude)
                    })
                    .OrderBy(x => x.Distance)
                    .First();

                if (closest.Distance > closest.Geofence.RadiusMeters)
                {
                    locationWithinBoundary = false;
                    locationStatusText = $"Outside boundary · {Math.Round(closest.Distance):N0} m from {closest.Geofence.Label} (allowed: {closest.Geofence.RadiusMeters} m; GPS: {pos.Lat:F5}, {pos.Lng:F5})";
                    feedbackIsError = true;
                    feedbackMessage = $"Outside allowed clock-in boundary: you are {Math.Round(closest.Distance):N0} m away from {closest.Geofence.Label} (allowed radius: {closest.Geofence.RadiusMeters} m).";
                    ToastService.Error(feedbackMessage);
                    return;
                }

                locationWithinBoundary = true;
                locationStatusText = $"Verified inside {closest.Geofence.Label} · {Math.Round(closest.Distance):N0} m from center ({pos.Lat:F5}, {pos.Lng:F5})";
                await AttendanceLogService.AddClockEventWithLocationAsync(context.IndividualId, pos.Lat, pos.Lng);
            }
            else
            {
                await AttendanceLogService.AddClockEventAsync(context.IndividualId);
            }

            await RefreshTodayStatusAsync();
            feedbackMessage = activeGeofences.Count > 0 && !string.IsNullOrWhiteSpace(locationStatusText)
                ? $"Clock event recorded at {DateTime.UtcNow.AddHours(5):HH:mm} ({locationStatusText})."
                : $"Clock event recorded at {DateTime.UtcNow.AddHours(5):HH:mm}.";
            ToastService.Success(feedbackMessage);

            if (OnClock.HasDelegate)
            {
                await OnClock.InvokeAsync();
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            feedbackIsError = true;
            feedbackMessage = ex.Message;
            ToastService.Error(feedbackMessage);
        }
        catch (InvalidOperationException ex)
        {
            feedbackIsError = true;
            feedbackMessage = ex.Message;
            ToastService.Error(feedbackMessage);
        }
        catch
        {
            feedbackIsError = true;
            feedbackMessage = "Could not record your clock event right now. Please try again.";
            ToastService.Error(feedbackMessage);
        }
        finally
        {
            ProcessingClock = false;
        }
    }

    private sealed class GeoPositionResult
    {
        public bool Ok { get; set; }
        public double Lat { get; set; }
        public double Lng { get; set; }
        public int Accuracy { get; set; }
        public string? Error { get; set; }
    }







