@using HRM.Components.Tools
@using HRM.DTOs.Attendance
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces

@inject IUserAccessService UserAccessService
@* @inject IAttendance AttendanceLogService *@
@inject IAttendanceService AttendanceService
@inject IWorkTypeService WorkTypes

@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService


<div class="time-clock-card bg-white dark:bg-slate-900 rounded-2xl shadow-xs border border-slate-200 dark:border-slate-800">

    <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">
            Time Clock
        </h3>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold @StatusBadgeClass">
            @StatusLabel
        </span>
    </div>

    <AnalogClock />

    @if (todayCheckIn != null || todayCheckOut != null)
    {
        <div class="mt-3 grid grid-cols-2 gap-2 rounded-xl border border-slate-100 bg-slate-50/80 p-2.5 text-center text-xs dark:border-slate-800 dark:bg-slate-800/50">
            <div>
                <span class="block text-[11px] text-slate-500">First In</span>
                <strong class="font-semibold tabular-nums @(todayCheckIn != null ? "text-emerald-700" : "text-slate-400")">
                    @(todayCheckIn?.Date.ToString("HH:mm") ?? "--:--")
                </strong>
            </div>
            <div>
                <span class="block text-[11px] text-slate-500">Last Out</span>
                <strong class="font-semibold tabular-nums @(todayCheckOut != null ? "text-blue-700" : "text-slate-400")">
                    @(todayCheckOut?.Date.ToString("HH:mm") ?? "--:--")
                </strong>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <p role="@(feedbackIsError ? "alert" : "status")"
           class="mt-3 rounded-lg border px-3 py-2 text-xs font-medium @(feedbackIsError ? "border-rose-200 bg-rose-50 text-rose-700" : "border-emerald-200 bg-emerald-50 text-emerald-700")">
            @feedbackMessage
        </p>
    }

    @if (canClock)
    {
        <div class="mt-4 flex flex-col gap-2">
            <button type="button"
                    @onclick="HandleClock"
                    disabled="@ProcessingClock"
                    class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm py-2.5 px-4 shadow-xs hover:shadow-sm transition-all duration-150 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">

                @if (ProcessingClock)
                {
                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    <span>Processing...</span>
                }
                else
                {
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@PrimaryActionLabel</span>
                }
            </button>
            <p class="text-center text-[11px] text-slate-500">
                Smart clock automatically matches your shift, break, or duty event.
                <a href="/online/attendance/my-clock-events" class="font-semibold text-blue-600 hover:underline">View events</a>
            </p>
        </div>
    }
    else
    {
        <p class="mt-3 text-center text-xs text-slate-500">
            Online clocking is not enabled for your current work type.
            <a href="/online/attendance/my-clock-events" class="font-semibold text-blue-600 hover:underline">View events</a>
        </p>
    }

</div>

