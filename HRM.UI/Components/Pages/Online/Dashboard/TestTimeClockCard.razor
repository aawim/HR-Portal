@using HRM.Components.Tools
@using HRM.DTOs.Attendance
@using HRM.Enum
@using HRM.Models
@using HRM.Services
@using HRM.Services.Attendance.Abstraction
@using HRM.Services.Attendance.AttendancePlan
@using HRM.Services.Interfaces

@inject IUserAccessService UserAccessService
@* @inject IAttendance AttendanceLogService *@
@inject IAttendanceService AttendanceService



@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService



<div class="bg-white dark:bg-slate-900 rounded-2xl shadow-xs border border-slate-200 dark:border-slate-800 p-4">

        <div class="flex items-center justify-between gap-3">
            <div>
                <div class="font-bold text-amber-700 dark:text-amber-400 text-sm">
                    Test Attendance Time
                </div>

                <div class="text-xs text-slate-500 dark:text-slate-400">
                    Use a custom date/time instead of the current time.
                </div>
            </div>

            <label class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
                <input type="checkbox"
                @bind="_useTestTime"
                class="rounded border-slate-300 dark:border-slate-600 text-amber-600 focus:ring-amber-500" />

                Enable
            </label>
        </div>

        @if (_useTestTime)
        {
            <div class="mt-4 grid gap-3 sm:grid-cols-2">

                <div>
                    <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">
                        Date
                    </label>

                    <InputDate @bind-Value="_testDate"
                    class="w-full rounded-lg border border-slate-300 dark:border-slate-700
                                  bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100" />
                </div>

                <div>
                    <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">
                        Time (24-hour)
                    </label>
                    <input type="time"
                    step="1"
                    @bind="_testTime"
                    class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100" />
                </div>

                @if (_testTime.HasValue)
                {
                <p class="text-xs text-slate-700 dark:text-slate-300 sm:col-span-2">Selected punch: <strong>@GetAttendanceTimestamp().ToString("dd MMM yyyy HH:mm:ss")</strong> (@GetAttendanceTimestamp().ToString("hh:mm:ss tt", System.Globalization.CultureInfo.InvariantCulture))</p>
                }
                <p class="text-[11px] text-slate-500 dark:text-slate-400 sm:col-span-2">10:00 = 10 AM · 22:00 = 10 PM. The scheduled event determines check-in or check-out.</p>
                <div class="sm:col-span-2 flex gap-1">

                    <button type="button"
                    @onclick="HandleClock"
                    disabled="@(ProcessingClock || !_testTime.HasValue)"
                    class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm py-2.5 px-4 shadow-xs hover:shadow-sm transition-all duration-150 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">

                        @if (ProcessingClock)
                        {
                            <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Clock</span>
                        }

                    </button>

                </div>




            </div>
        }




    @* Only for testing ends *@





</div>

@code {




    // Only for tetsing
    private bool _useTestTime = false;

    private DateTime _testDate = DateTime.UtcNow.AddHours(5).Date;

    private TimeOnly? _testTime = TimeOnly.FromDateTime(DateTime.UtcNow.AddHours(5));

    private DateTime GetAttendanceTimestamp()
    {
        if (!_useTestTime)
            return DateTime.UtcNow.AddHours(5);

        if (!_testTime.HasValue)
        {
            throw new InvalidOperationException(
                "Please select a test time.");
        }

        var time = _testTime.Value;

        return new DateTime(
            _testDate.Year,
            _testDate.Month,
            _testDate.Day,
            time.Hour,
            time.Minute,
            time.Second);
    }



    // only for testing ends



 

 

    [Parameter]
    public EventCallback OnClock { get; set; }



    [Parameter]
    public AttendanceLogDto? TodayCheckIn { get; set; }

    [Parameter]
    public AttendanceLogDto? TodayCheckOut { get; set; }

    // [Parameter]
    // public EventCallback OnClockIn { get; set; }

    // [Parameter]
    // public EventCallback OnClockOut { get; set; }

    private bool ProcessingClock;

    protected override async Task OnInitializedAsync()
    {
        var attendanceTime = GetAttendanceTimestamp();

        var context = await UserAccessService.RequireContextAsync();
 

        var result = await AttendanceService.GetTodayStatusAsync(context.IndividualId);
        TodayCheckIn = result.checkIn;
        TodayCheckOut = result.checkOut;
    }

 
    private async Task HandleClock()
    {
        ProcessingClock = true;

        try
        {
            var context =
                await UserAccessService.RequireContextAsync();

            var timestamp =
                GetAttendanceTimestamp();

            await AttendanceLogService.AddClockEventAsync(
                context.IndividualId,
                timestamp);

            if (OnClock.HasDelegate)
            {
                await OnClock.InvokeAsync();
            }
        }
        finally
        {
            ProcessingClock = false;
        }
    }

 

}
