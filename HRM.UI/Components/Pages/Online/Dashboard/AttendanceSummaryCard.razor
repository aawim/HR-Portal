@using HRM.DTOs.Attendance
@using HRM.Enum

<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-2">

        <div>
            <h3 class="text-base font-semibold text-slate-800">
                Attendance Summary
            </h3>

            <p class="mt-0.5 text-xs text-slate-500">
                @WeekStart.ToString("dd MMM") - @WeekEnd.ToString("dd MMM yyyy")
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-green-500"></span>
                Attended
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                Late
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-pink-700"></span>
                Missing Clock
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
                Absent
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-purple-600"></span>
                Holiday
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
                Upcoming
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-slate-600"></span>
                Unresolved
            </span>
        </div>

    </div>

    @if (ShowExports)
    {
        <HRM.Components.Shared.AttendanceExportButtons CreateReport="BuildExport" Disabled="@(Days == null)" />
    }

    <!-- ============================================================
         BODY
         ============================================================ -->
    <div class="p-4">

        @if (WeeklyLogs == null)
        {
            <!-- Loading -->
            <div class="flex   items-center justify-center text-sm text-slate-500">
                Loading attendance...
            </div>
        }
        else
        {
            <!-- ====================================================
                 SUNDAY -> SATURDAY
                 ==================================================== -->
            <div class="grid grid-cols-7 gap-2">

                @for (int i = 0; i < 7; i++)
                {
                    var day = WeekStart.AddDays(i);
                    var now = DateTime.UtcNow.AddHours(5);
                    var isToday = day.Date == now.Date;
                    var isFutureDay = day.Date > now.Date;

                    var dayLogs = WeeklyLogs?
                        .Where(x => x.Date.Date == day.Date)
                        .OrderBy(x => x.Date)
                        .ToList() ?? [];

                    var checkIn = dayLogs.FirstOrDefault(x => x.IsCheckIn);
                    var checkOut = dayLogs.OrderByDescending(x => x.Date).FirstOrDefault(x => x.IsCheckOut);

                    var hasResolvedAttendance = checkIn != null || checkOut != null;
                    var hasLogs = dayLogs.Count > 0;
                    var isUnresolvedDay = hasLogs && !hasResolvedAttendance;

                    var overview = Days?.FirstOrDefault(x => x.Date.Date == day.Date);
                    if (overview != null)
                    {
                        isUnresolvedDay = overview.IsUnresolved;
                    }

                    var displayedCheckIn = overview != null ? overview.FirstCheckIn : checkIn?.Date;
                    var displayedCheckOut = overview != null ? overview.LastCheckOut : checkOut?.Date;
                    var isHoliday = overview?.IsHoliday == true;
                    var isWeekend = overview?.IsRestDay ?? (day.DayOfWeek == DayOfWeek.Friday || day.DayOfWeek == DayOfWeek.Saturday);
                    var isOnLeave = overview?.IsOnLeave == true;

                    var hasCheckIn = displayedCheckIn != null;
                    var hasCheckOut = displayedCheckOut != null;

                    // Determine IN and OUT display strings
                    string inDisplay;
                    string outDisplay;

                    if (hasCheckIn && displayedCheckIn.HasValue)
                    {
                        inDisplay = displayedCheckIn.Value.ToString("HH:mm");
                    }
                    else if (isFutureDay)
                    {
                        inDisplay = "--";
                    }
                    else if (isToday)
                    {
                        var checkinDeadline = overview?.ScheduledStart ?? day.Date.AddHours(8).AddMinutes(30);
                        inDisplay = now > checkinDeadline ? "Missing" : "Pending";
                    }
                    else
                    {
                        inDisplay = "Missing";
                    }

                    if (hasCheckOut && displayedCheckOut.HasValue)
                    {
                        outDisplay = displayedCheckOut.Value.ToString("HH:mm");
                    }
                    else if (isFutureDay)
                    {
                        outDisplay = "--";
                    }
                    else if (isToday)
                    {
                        var checkoutDeadline = overview?.ScheduledEnd ?? day.Date.AddHours(14);
                        outDisplay = now < checkoutDeadline ? "Pending" : "Missing";
                    }
                    else
                    {
                        outDisplay = "Missing";
                    }

                    // Classification:
                    // - If both IN and OUT are missing after scheduled working period, classify as Absent.
                    // - If either IN or OUT is missing, classify as Missing Clock.
                    // - When a card contains both Late and Missing Clock conditions, Missing Clock takes colour priority.
                    // - Authorised leave, holidays, exempted periods are never Missing Clock.
                    var isExempt = isHoliday || isWeekend || isOnLeave || isFutureDay;

                    var isAbsentDay = !isExempt && !isUnresolvedDay &&
                                      (overview?.IsAbsent == true || (inDisplay == "Missing" && outDisplay == "Missing"));

                    var isMissingClock = !isExempt && !isUnresolvedDay && !isAbsentDay &&
                                         (overview?.IsMissingClock == true || inDisplay == "Missing" || outDisplay == "Missing");

                    var isLate = !isExempt && !isUnresolvedDay && !isAbsentDay && !isMissingClock &&
                                 overview?.IsLate == true;

                    var isAttended = !isExempt && !isUnresolvedDay && !isAbsentDay && !isMissingClock && !isLate &&
                                     (hasCheckIn || overview?.IsPresent == true);

                    var stateClass = isFutureDay
                        ? (isHoliday ? "bg-purple-100 text-purple-800 border border-purple-200" : isWeekend ? "bg-slate-100 text-slate-600 border border-slate-200" : "bg-slate-100 text-slate-600 border border-slate-200")
                        : isHoliday
                        ? "bg-purple-600 text-white"
                        : isOnLeave
                        ? "bg-blue-500 text-white"
                        : isUnresolvedDay
                        ? "bg-slate-600 text-white"
                        : isAbsentDay
                        ? "bg-red-500 text-white"
                        : isMissingClock
                        ? "bg-pink-700 text-white"
                        : isLate
                        ? "bg-amber-500 text-slate-900"
                        : isAttended
                        ? "bg-green-500 text-white"
                        : isWeekend
                        ? "bg-slate-100 text-slate-700 border border-slate-200"
                        : overview?.EligibilityMessage != null
                        ? "bg-slate-100 text-slate-700 border border-slate-200"
                        : "bg-slate-100 text-slate-700 border border-slate-200";

                    var tooltip = isMissingClock
                        ? (overview?.IsLate == true ? $"Missing Clock (Late {overview.LateMinutes} min)" : "Missing Clock")
                        : isLate
                        ? $"Late {overview?.LateMinutes} min"
                        : isAbsentDay
                        ? "Absent"
                        : isHoliday
                        ? "Holiday"
                        : isOnLeave
                        ? $"Leave · {overview?.LeaveTypeName ?? "Approved"}"
                        : isAttended
                        ? "Attended"
                        : null;

                    <div class="flex min-w-0 flex-col items-center">

                        <!-- Day Card: Uniform height across all 7 days -->
                        <div class="@stateClass h-20 w-full flex flex-col items-center justify-center text-center gap-0.5 px-1 py-1 rounded-md transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md cursor-default" title="@tooltip">

                            <!-- Date -->
                            <span class="text-xs font-bold leading-tight">
                                @day.ToString("dd MMM")
                            </span>

                            @if (isFutureDay)
                            {
                                @if (isHoliday)
                                {
                                    <span class="text-xs font-semibold leading-tight">Holiday</span>
                                    <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                                }
                                else if (isWeekend)
                                {
                                    <span class="text-xs font-semibold leading-tight">Happy Week End</span>
                                    <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                                }
                                else
                                {
                                    <span class="text-xs font-semibold leading-tight opacity-90">Upcoming</span>
                                    <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                                }
                            }
                            else if (isHoliday)
                            {
                                <span class="text-xs font-semibold leading-tight">Holiday</span>
                                <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                            }
                            else if (isOnLeave)
                            {
                                <span class="text-xs font-semibold leading-tight">Leave</span>
                                <span class="text-[10px] font-medium leading-tight opacity-90 truncate max-w-full">
                                    @(string.IsNullOrWhiteSpace(overview?.LeaveTypeName) ? "--" : overview.LeaveTypeName)
                                </span>
                            }
                            else if (isWeekend && !hasCheckIn && !hasCheckOut)
                            {
                                <span class="text-xs font-semibold leading-tight">Happy Week End</span>
                                <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                            }
                            else if (isUnresolvedDay)
                            {
                                <span class="text-xs font-semibold leading-tight">Unresolved</span>
                                <span class="text-[10px] font-medium leading-tight opacity-80">@dayLogs.Count event@(dayLogs.Count == 1 ? "" : "s")</span>
                            }
                            else if (isAbsentDay)
                            {
                                <span class="text-xs font-semibold leading-tight">Absent</span>
                                <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                            }
                            else if (overview?.EligibilityMessage is string eligibilityMessage && !hasCheckIn && !hasCheckOut)
                            {
                                <span class="text-xs font-semibold leading-tight">@eligibilityMessage</span>
                                <span class="text-[10px] font-medium leading-tight opacity-80">--</span>
                            }
                            else
                            {
                                <!-- Compact vertically stacked check-in & check-out -->
                                <span class="text-xs font-medium leading-tight">IN: @inDisplay</span>
                                <span class="text-xs font-medium leading-tight">OUT: @outDisplay</span>
                            }

                        </div>

                        <!-- Day Name -->
                        <span class="mt-1 text-xs font-medium @(isToday ? "text-blue-600 font-bold" : isFutureDay ? "text-slate-400" : "text-slate-600")">
                            @day.ToString("ddd")
                        </span>

                        <!-- Today indicator -->
                        @if (isToday)
                        {
                            <span class="text-[10px] font-medium text-blue-500">
                                Today
                            </span>
                        }

                    </div>
                }

            </div>


            <!-- ====================================================
                 WEEK SUMMARY
                 ==================================================== -->
            @* <div class="mt-6 grid grid-cols-3 divide-x divide-slate-200
                        rounded-lg border border-slate-200 bg-slate-50 py-3">

                <!-- Present -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @PresentDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Attended
                    </div>

                </div>


                <!-- Absent -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @AbsentDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Absent
                    </div>

                </div>


                <!-- Unresolved -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @UnresolvedDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Unresolved
                    </div>

                </div>

            </div> *@
        }

    </div>

</div>


@code {
    [Parameter] public bool ShowExports { get; set; } = true;
    private AttendanceExportReport BuildExport() => new("Weekly attendance summary", $"{WeekStart:dd MMM yyyy} – {WeekEnd:dd MMM yyyy}", [AttendanceReportExport.Daily((Days ?? []).Where(d => d.Date.Date >= WeekStart.Date && d.Date.Date <= WeekEnd.Date))]);

    // ==============================================================
    // PARAMETERS
    // ==============================================================

    [Parameter]
    public List<AttendanceLogDto>? WeeklyLogs { get; set; }

    [Parameter]
    public List<YearlyAttendanceDayDto>? Days { get; set; }


    // ==============================================================
    // CURRENT WEEK
    //
    // Sunday -> Saturday
    // ==============================================================

    private DateTime WeekStart
    {
        get
        {
            var today = DateTime.Today;

            return today.AddDays(
                -(int)today.DayOfWeek);
        }
    }


    private DateTime WeekEnd =>
        WeekStart.AddDays(6);


    // ==============================================================
    // PRESENT DAYS
    //
    // Present only when there is a resolved Check In.
    //
    // Future days are ignored.
    // ==============================================================

    private int PresentDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => WeekStart.AddDays(i).Date)
                .Where(day =>
                    day <= DateTime.Today)
                .Count(day => Days?.FirstOrDefault(x => x.Date.Date == day)?.IsPresent ??
                    WeeklyLogs.Any(x => x.Date.Date == day && x.IsCheckIn));
        }
    }


    // ==============================================================
    // UNRESOLVED DAYS
    //
    // Logs exist, but no resolved CheckIn or CheckOut.
    // ==============================================================

    private int UnresolvedDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => WeekStart.AddDays(i).Date)
                .Where(day =>
                    day <= DateTime.Today)
                .Count(day =>
                {
                    var logs = WeeklyLogs
                        .Where(x =>
                            x.Date.Date == day)
                        .ToList();

                    if (logs.Count == 0)
                        return false;

                    var overview = Days?.FirstOrDefault(x => x.Date.Date == day);
                    if (overview != null) return overview.IsUnresolved;

                    return !logs.Any(x =>
                        x.IsCheckIn ||
                        x.IsCheckOut);
                });
        }
    }


    // ==============================================================
    // ABSENT DAYS
    //
    // Only count days from Sunday through today.
    //
    // Future days are NOT counted as absent.
    //
    // IMPORTANT:
    // Eventually this should use WorkPlan so OFF / REST days
    // are not counted as absent.
    // ==============================================================

    private int AbsentDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => WeekStart.AddDays(i).Date)
                .Where(day =>
                    day <= DateTime.Today)
                .Count(day =>
                {
                    var logs = WeeklyLogs
                        .Where(x =>
                            x.Date.Date == day)
                        .ToList();

                    var overview = Days?.FirstOrDefault(x => x.Date.Date == day);
                    if (overview != null) return overview.IsAbsent;
                    // A missing clock event alone never proves an absence.
                    return false;
                });
        }
    }
}
