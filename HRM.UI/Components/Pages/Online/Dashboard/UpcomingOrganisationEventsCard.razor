@using HRM.DTOs.Calendar
@inject HRM.Services.Calendar.Contracts.OrganisationEventServiceContracts.IOperations EventService

<div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xs space-y-2">
    <div class="flex items-center justify-between pb-1.5 border-b border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-2">
            <span class="text-sm">📅</span>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Upcoming Organisation Events
            </h4>
        </div>
        <span class="rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 px-2 py-0.5 text-[10px] font-semibold">
            @events.Count
        </span>
    </div>

    @if (busy)
    {
        <p class="text-xs text-slate-400 italic py-1 text-center">Loading upcoming events…</p>
    }
    else if (events.Count == 0)
    {
        <p class="text-xs text-slate-400 italic py-1 text-center">No upcoming organisation events scheduled.</p>
    }
    else
    {
        <div class="space-y-1.5 max-h-72 overflow-y-auto pr-1">
            @foreach (var ev in events.Take(5))
            {
                var daysRemaining = (ev.StartDateTime.Date - DateTime.Today).Days;
                <div class="p-2 rounded-lg border border-slate-200/80 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 text-xs space-y-1 transition hover:border-slate-300 dark:hover:border-slate-700">
                    <div class="flex items-start justify-between gap-1">
                        <span class="font-bold text-slate-900 dark:text-slate-100">
                            @ev.Title
                        </span>
                        <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold @(daysRemaining == 0 ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400")">
                            @(daysRemaining == 0 ? "Today" : daysRemaining == 1 ? "Tomorrow" : $"In {daysRemaining} days")
                        </span>
                    </div>

                    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                        <span>🗓 @ev.StartDateTime.ToString("ddd, dd MMM yyyy")</span>
                        @if (!ev.IsAllDay)
                        {
                            <span>⏰ @ev.StartDateTime.ToString("HH:mm") – @ev.EndDateTime.ToString("HH:mm")</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ev.VenueName))
                    {
                        <div class="text-[11px] text-slate-600 dark:text-slate-300">
                            📍 @ev.VenueName
                        </div>
                    }

                    <div class="flex items-center justify-between pt-1 border-t border-slate-200/50 dark:border-slate-700/50 text-[10px]">
                        <span class="text-slate-500 font-medium">@ev.Category</span>
                        @if (ev.CalendarImpactType != "None")
                        {
                            <span class="text-amber-700 dark:text-amber-400 font-semibold">⚑ @ev.CalendarImpactType</span>
                        }
                        else
                        {
                            <span class="text-slate-400">Informational</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<OrganisationEventDto> events = [];
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        busy = true;
        try
        {
            events = await EventService.ListAsync(DateTime.Today, DateTime.Today.AddMonths(3), null, "Published", null, null, true);
        }
        catch
        {
            events = [];
        }
        finally
        {
            busy = false;
        }
    }
}
