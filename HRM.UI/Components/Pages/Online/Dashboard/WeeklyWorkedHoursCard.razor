@using HRM.DTOs.Attendance
@using HRM.Services.Interfaces
@inject IAttendanceService AttendanceService

<section class="min-w-0 overflow-hidden rounded-xl border bg-white shadow-sm" aria-label="Worked Hours">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2">
        <div><h3 class="font-semibold">Worked Hours</h3><p class="mt-1 text-xs text-slate-500">Weekly attendance hours</p></div>
    </div>
    <div class="space-y-2 px-4 py-2">
        @if(isLoading){<p role="status" class="text-sm text-slate-500">Calculating worked hours...</p>}
        else if(errorMessage!=null){<p role="alert" class="text-sm text-amber-700 dark:text-amber-400">@errorMessage</p>}
        else if(workedHours==null){<p class="text-sm text-slate-500">No attendance information available.</p>}
        else
        {
            <section aria-label="This week">
                <h4 class="text-sm font-semibold">This week</h4>
                <p class="mt-1 text-xs text-slate-500">@workedHours.WeekStart.ToString("dd MMM") – @workedHours.WeekEnd.ToString("dd MMM yyyy")</p>
                <dl class="mt-1 divide-y">
                    <DashboardDetailRow Label="Worked" Value="@FormatHours(workedHours.CurrentWeekHours)" Tone="primary" />
                    @if(workedHours.HasWorkingHoursRule)
                    {
                        <DashboardDetailRow Label="Required" Value="@FormatHours(workedHours.RequiredWeekHours)" />
                        <DashboardDetailRow Label="Remaining" Value="@FormatHours(workedHours.RemainingWeekHours)" Tone="@(workedHours.RemainingWeekHours>0?"negative":"positive")" />
                        <DashboardDetailRow Label="Official hours" Value="@FormatHours(workedHours.OfficialHours)" />
                        <DashboardDetailRow Label="Duty hours" Value="@FormatHours(workedHours.DutyHours)" />
                        @if(workedHours.AmendmentCreditHours>0){<DashboardDetailRow Label="Organisation time waived" Value="@FormatHours(workedHours.AmendmentCreditHours)" />}
                        @if(workedHours.LeaveCreditHours>0){<DashboardDetailRow Label="Approved leave credit" Value="@FormatHours(workedHours.LeaveCreditHours)" />}
                        <DashboardDetailRow Label="Potential overtime" Value="@FormatHours(workedHours.PotentialOvertimeHours)" />
                        @if(workedHours.ExceptionCreditHours>0){<DashboardDetailRow Label="Approved exception credit" Value="@FormatHours(workedHours.ExceptionCreditHours)" />}
                    }
                </dl>
                @if(!workedHours.HasWorkingHoursRule){<p role="status" class="mt-2 text-sm text-slate-500">@workedHours.ConfigurationMessage</p>}
                else
                {
                    @if(workedHours.DutyHours>0){<p class="mt-2 text-xs text-slate-500">@(workedHours.DutyCountsTowardWeek?"Duty contributes to the weekly total; overlap counts once.":"Duty is recorded separately and does not contribute to the weekly total.")</p>}
                    <p class="mt-2 text-xs text-slate-500">Overlapping duty and official time count once. Potential overtime does not approve overtime pay.</p>
                }
            </section>
            @if(workedHours.ApprovedEarlyCheckoutShortfallHours>0)
            {
                <section class="border-t pt-2" aria-label="Make-up time this week">
                    <h4 class="text-sm font-semibold">Make-up time this week</h4>
                    <dl class="mt-1 divide-y">
                        <DashboardDetailRow Label="Early check-out shortfall" Value="@FormatHours(workedHours.ApprovedEarlyCheckoutShortfallHours)" />
                        <DashboardDetailRow Label="Made up" Value="@FormatHours(workedHours.MakeupCompletedHours)" />
                        <DashboardDetailRow Label="Remaining" Value="@FormatHours(workedHours.MakeupRemainingHours)" Tone="@(workedHours.MakeupRemainingHours>0?"negative":"positive")" />
                    </dl>
                </section>
            }
            <section class="border-t pt-2" aria-label="Last week">
                <h4 class="text-sm font-semibold">Last week</h4>
                <p class="mt-1 text-xs text-slate-500">@workedHours.WeekStart.AddDays(-7).ToString("dd MMM") – @workedHours.WeekEnd.AddDays(-7).ToString("dd MMM yyyy")</p>
                <dl class="mt-1 divide-y">
                    <DashboardDetailRow Label="Worked" Value="@FormatHours(workedHours.PreviousWeekHours)" Tone="primary" />
                </dl>
            </section>
            <section class="border-t pt-2" aria-label="Weekly comparison">
                <h4 class="text-sm font-semibold">Weekly comparison</h4>
                <dl class="mt-1 divide-y">
                    <DashboardDetailRow Label="Difference" Value="@(GetDifferencePrefix()+FormatHours(Math.Abs(workedHours.DifferenceHours)))" Tone="@(workedHours.DifferenceHours>0?"positive":workedHours.DifferenceHours<0?"negative":"muted")" />
                </dl>
            </section>
        }
    </div>
</section>
@code {

    private WeeklyWorkedHoursDto? workedHours;

    private bool isLoading = true;
    [Parameter] public int RefreshKey { get; set; }
    private int lastRefreshKey = -1;
    private string? errorMessage;


    protected override async Task OnParametersSetAsync()
    {
        if (lastRefreshKey == RefreshKey) return;
        lastRefreshKey = RefreshKey;
        try
        {
            isLoading = true;
            errorMessage = null;

            workedHours =
                await AttendanceService
                    .GetMyWeeklyWorkedHoursAsync();
        }
        catch
        {
            workedHours = null;
            errorMessage = "Worked hours could not be loaded. Please refresh the page.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private static string FormatHours(decimal hours)
    {
        var totalMinutes =
            (int)Math.Round(hours * 60);

        var hour =
            totalMinutes / 60;

        var minute =
            totalMinutes % 60;

        return $"{hour}h {minute}m";
    }


    private string GetDifferencePrefix()
    {
        if (workedHours == null)
            return "";

        if (workedHours.DifferenceHours > 0)
            return "+";

        if (workedHours.DifferenceHours < 0)
            return "-";

        return "";
    }


}
