@using HRM.DTOs.Attendance
@using HRM.Services.Interfaces
@inject IAttendanceService AttendanceService

<section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm" aria-label="Worked Hours">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 px-3 py-2">
        <div>
            <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Worked Hours</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Weekly attendance hours</p>
        </div>
        <button type="button"
                class="inline-flex items-center justify-center rounded-md p-1.5 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 disabled:opacity-50 transition"
                disabled="@isLoading"
                @onclick="LoadAsync"
                aria-label="Refresh worked hours">
            <i class="bi bi-arrow-clockwise @(isLoading ? "animate-spin" : "")" aria-hidden="true"></i>
        </button>
    </div>

    <!-- Main Content Container with p-2 space-y-2 -->
    <div class="p-2 space-y-2">
        @if (isLoading)
        {
            <p role="status" class="text-xs text-slate-500 dark:text-slate-400 py-2 text-center">Calculating worked hours...</p>
        }
        else if (errorMessage != null)
        {
            <p role="alert" class="text-xs text-amber-700 dark:text-amber-400 py-1 text-center">@errorMessage</p>
        }
        else if (workedHours == null)
        {
            <p class="text-xs text-slate-500 dark:text-slate-400 py-2 text-center">No attendance information available.</p>
        }
        else
        {
            <!-- Two-Column Weekly Comparison -->
            <div class="grid grid-cols-2 gap-2">
                <!-- Left Column: This Week -->
                <div class="flex flex-col justify-between rounded-lg border border-slate-200 dark:border-slate-800 p-2 space-y-1 bg-white dark:bg-slate-900 shadow-2xs">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800 dark:text-slate-100">This Week</span>
                            <span class="text-[10px] font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-1.5 py-0.2 rounded border border-blue-200 dark:border-blue-900/40">Current</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            @workedHours.WeekStart.ToString("dd MMM") – @workedHours.WeekEnd.ToString("dd MMM yyyy")
                        </p>
                        <div class="mt-1 text-lg font-bold tabular-nums text-slate-900 dark:text-slate-100">
                            @FormatHours(workedHours.CurrentWeekHours)
                        </div>
                    </div>

                    <div class="pt-1.5 border-t border-slate-100 dark:border-slate-800 space-y-0.5 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-slate-500 dark:text-slate-400">Required</span>
                            <span class="text-xs font-semibold tabular-nums text-slate-800 dark:text-slate-200">
                                @(workedHours.HasWorkingHoursRule ? FormatHours(workedHours.RequiredWeekHours) : "—")
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-slate-500 dark:text-slate-400">Remaining</span>
                            <span class="text-xs font-semibold tabular-nums @(workedHours.HasWorkingHoursRule && workedHours.RemainingWeekHours > 0 ? "text-amber-600 dark:text-amber-400" : "text-slate-800 dark:text-slate-200")">
                                @(workedHours.HasWorkingHoursRule ? FormatHours(workedHours.RemainingWeekHours) : "—")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Last Week -->
                <div class="flex flex-col justify-between rounded-lg border border-slate-200 dark:border-slate-800 p-2 space-y-1 bg-white dark:bg-slate-900 shadow-2xs">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800 dark:text-slate-100">Last Week</span>
                            <span class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.2 rounded border border-slate-200 dark:border-slate-700">Past</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            @workedHours.WeekStart.AddDays(-7).ToString("dd MMM") – @workedHours.WeekEnd.AddDays(-7).ToString("dd MMM yyyy")
                        </p>
                        <div class="mt-1 text-lg font-bold tabular-nums text-slate-900 dark:text-slate-100">
                            @FormatHours(workedHours.PreviousWeekHours)
                        </div>
                    </div>

                    <div class="pt-1.5 border-t border-slate-100 dark:border-slate-800 space-y-0.5 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-slate-500 dark:text-slate-400">Required</span>
                            <span class="text-xs font-semibold tabular-nums text-slate-500 dark:text-slate-400">—</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-slate-500 dark:text-slate-400">Remaining</span>
                            <span class="text-xs font-semibold tabular-nums text-slate-500 dark:text-slate-400">—</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Calculation & Summary -->
            <div class="rounded-lg border border-slate-200 dark:border-slate-800 p-2 space-y-2 bg-slate-50/50 dark:bg-slate-900/40">
                <h4 class="text-xs font-semibold text-slate-800 dark:text-slate-100">Calculation &amp; Summary</h4>

                <div class="grid grid-cols-2 gap-2">
                    <div class="flex items-center justify-between p-1.5 rounded bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700/60 shadow-2xs">
                        <span class="text-xs text-slate-500 dark:text-slate-400">Official hours</span>
                        <span class="text-xs font-semibold tabular-nums text-slate-800 dark:text-slate-200">@FormatHours(workedHours.OfficialHours)</span>
                    </div>
                    <div class="flex items-center justify-between p-1.5 rounded bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700/60 shadow-2xs">
                        <span class="text-xs text-slate-500 dark:text-slate-400">Duty hours</span>
                        <span class="text-xs font-semibold tabular-nums text-slate-800 dark:text-slate-200">@FormatHours(workedHours.DutyHours)</span>
                    </div>
                    <div class="flex items-center justify-between p-1.5 rounded bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700/60 shadow-2xs">
                        <span class="text-xs text-slate-500 dark:text-slate-400">Organisation time waived</span>
                        <span class="text-xs font-semibold tabular-nums text-slate-800 dark:text-slate-200">@FormatHours(workedHours.AmendmentCreditHours)</span>
                    </div>
                    <div class="flex items-center justify-between p-1.5 rounded bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700/60 shadow-2xs">
                        <span class="text-xs text-slate-500 dark:text-slate-400">Potential overtime</span>
                        <span class="text-xs font-semibold tabular-nums text-slate-800 dark:text-slate-200">@(workedHours.HasWorkingHoursRule ? FormatHours(workedHours.PotentialOvertimeHours) : "—")</span>
                    </div>
                </div>

                <!-- Weekly Difference -->
                <div class="flex items-center justify-between border-t border-slate-200 dark:border-slate-800 pt-1.5 px-0.5">
                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Weekly Difference</span>
                    <span class="text-xs font-bold tabular-nums @DifferenceClass">@DifferenceFormatted</span>
                </div>
            </div>

            @if (!workedHours.HasWorkingHoursRule && !string.IsNullOrWhiteSpace(workedHours.ConfigurationMessage))
            {
                <p role="status" class="text-[11px] text-slate-500 dark:text-slate-400 px-1">
                    @workedHours.ConfigurationMessage
                </p>
            }
        }
    </div>
</section>

@code {
    private WeeklyWorkedHoursDto? workedHours;
    private bool isLoading = true;
    [Parameter] public int RefreshKey { get; set; }
    private int lastRefreshKey = -1;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (lastRefreshKey == RefreshKey) return;
        lastRefreshKey = RefreshKey;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            workedHours = await AttendanceService.GetMyWeeklyWorkedHoursAsync();
        }
        catch
        {
            workedHours = null;
            errorMessage = "Worked hours could not be loaded. Please refresh the page.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatHours(decimal hours)
    {
        var totalMinutes = (int)Math.Round(hours * 60m);
        var hour = totalMinutes / 60;
        var minute = totalMinutes % 60;
        return $"{hour}h {minute}m";
    }

    private int ThisWeekMinutes => workedHours != null ? (int)Math.Round(workedHours.CurrentWeekHours * 60m) : 0;
    private int LastWeekMinutes => workedHours != null ? (int)Math.Round(workedHours.PreviousWeekHours * 60m) : 0;
    private int DifferenceMinutes => ThisWeekMinutes - LastWeekMinutes;

    private string DifferenceFormatted
    {
        get
        {
            if (workedHours == null) return "—";
            var diff = DifferenceMinutes;
            if (diff > 0)
            {
                var h = diff / 60;
                var m = diff % 60;
                return $"+{h}h {m}m";
            }
            if (diff < 0)
            {
                var abs = Math.Abs(diff);
                var h = abs / 60;
                var m = abs % 60;
                return $"-{h}h {m}m";
            }
            return "0h 0m";
        }
    }

    private string DifferenceClass
    {
        get
        {
            if (workedHours == null) return "text-slate-500";
            if (DifferenceMinutes > 0) return "text-emerald-600 dark:text-emerald-400";
            if (DifferenceMinutes < 0) return "text-rose-600 dark:text-rose-400";
            return "text-slate-600 dark:text-slate-400";
        }
    }
}
