@using HRM.DTOs.Attendance
@using HRM.Enum
@using HRM.Services.Attendance.Abstraction
@using HRM.Services.Interfaces
@inject IUserAccessService UserAccessService
@inject IAttendanceService AttendanceService

<section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-base font-semibold text-slate-800">Today's Attendance</h2>
        <p class="mt-1 text-xs text-slate-500">@DateTime.Today.ToString("dddd, dd MMM yyyy")</p>
    </header>
    <div class="space-y-4 p-4">
        @if (_isLoading)
        {
            <p role="status" class="py-6 text-center text-sm text-slate-500">Loading attendance...</p>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <p role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-700">@_errorMessage</p>
        }
        else if (_evaluation is not null)
        {
            <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-sm text-slate-500">Attendance status</span>
                <span class="@(_attendanceDay?.IsLate == true ? "rounded-full bg-amber-100 px-2.5 py-1 text-xs text-amber-700" : GetStatusClass(_evaluation.Status))">@(_attendanceDay != null ? HRM.Helpers.AttendancePresentation.Status(_attendanceDay) : GetStatusText(_evaluation.Status))</span>
            </div>
            <dl class="space-y-3 text-sm">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
                    <dt class="text-slate-500">Scheduled</dt>
                    <dd class="m-0 font-medium tabular-nums text-slate-800">
                        @if (_evaluation.RequiresAttendance)
                        {
                            <span>@FormatTime(_evaluation.PlannedStart) – @FormatTime(_evaluation.PlannedEnd)</span>
                        }
                        else { <span>Not required</span> }
                    </dd>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="min-w-0 rounded-lg bg-slate-50 p-3">
                        <dt class="text-xs text-slate-500">Check in</dt>
                        <dd class="mb-0 mt-2 font-semibold tabular-nums text-slate-800">@FormatTime(_evaluation.FirstCheckIn)</dd>
                    </div>
                    <div class="min-w-0 rounded-lg bg-slate-50 p-3">
                        <dt class="text-xs text-slate-500">Check out</dt>
                        <dd class="mb-0 mt-2 font-semibold tabular-nums text-slate-800">@FormatTime(_evaluation.LastCheckOut)</dd>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3">
                    <dt class="text-slate-500">Time worked</dt>
                    <dd class="m-0 text-xl font-semibold tabular-nums text-slate-900">@FormatMinutes(_evaluation.WorkedMinutes)</dd>
                </div>
            </dl>
            @if (ArrivalLateMinutes > 0 || _evaluation.EarlyDepartureMinutes > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @if (ArrivalLateMinutes > 0) { <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs text-amber-700">Late @ArrivalLateMinutes min</span> }
                    @if (_evaluation.EarlyDepartureMinutes > 0) { <span class="rounded-full bg-orange-100 px-2.5 py-1 text-xs text-orange-700">Early @_evaluation.EarlyDepartureMinutes min</span> }
                </div>
            }
            @if (_evaluation.Issues.Count > 0)
            {
                <ul class="m-0 space-y-2 p-0">
                    @foreach (var issue in _evaluation.Issues)
                    {
                        <li class="flex items-start gap-2 text-xs leading-5 text-slate-600">
                            <span aria-hidden="true" class="@GetIssueDotClass(issue.Severity)"></span><span>@issue.Message</span>
                        </li>
                    }
                </ul>
            }
        }
        else { <p class="py-4 text-sm text-slate-500">Attendance evaluation is not available.</p> }
    </div>
</section>
@code {

    // ==============================================================
    // PARAMETERS
    // ==============================================================

    [Parameter]
    public int RefreshKey { get; set; }


    // ==============================================================
    // STATE
    // ==============================================================
 

    private AttendanceDailyEvaluationDto? _evaluation;


    private bool _isLoading = true;
    private YearlyAttendanceDayDto? _attendanceDay;
    private int ArrivalLateMinutes => _attendanceDay?.LateMinutes ?? _evaluation?.LateMinutes ?? 0;

    private string? _errorMessage;

    private int _lastRefreshKey = -1;


    // ==============================================================
    // COMPONENT LIFECYCLE
    //
    // Do NOT also load in OnInitializedAsync.
    //
    // OnParametersSetAsync runs during the initial render and whenever
    // RefreshKey changes.
    // ==============================================================

    protected override async Task OnParametersSetAsync()
    {
        if (_lastRefreshKey == RefreshKey)
            return;

        _lastRefreshKey = RefreshKey;

        await LoadAttendanceAsync();
    }


    // ==============================================================
    // LOAD TODAY'S ATTENDANCE
    // ==============================================================

    private async Task LoadAttendanceAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var context = await UserAccessService.RequireContextAsync();
            if (context.ActiveJob == null)
            {
                _evaluation = null;
                _errorMessage = "No active job is available for today's attendance.";
                return;
            }

            /*
            * This card represents TODAY.
                 *
            * Do not use the TimeClockCard test timestamp here.
                 * The TimeClockCard is responsible for creating clock events.
                 * This component only displays today's attendance.
            */
                            var attendanceTime = DateTime.UtcNow.AddHours(5);

      

            // Evaluated attendance state
            var evaluation =
                                await AttendanceService.GetEvaluationAsync(
                                    context.IndividualId,
                                    context.ActiveJob.JobId,
                                    context.ActiveJob.OrganisationId,
                                    attendanceTime.Date);


 
            _evaluation = evaluation;
            _attendanceDay = (await AttendanceService.GetStaffAttendanceRangeAsync(context.IndividualId, attendanceTime.Date, attendanceTime.Date)).FirstOrDefault();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
 

             _evaluation = null;


            _errorMessage =
                "Today's attendance could not be loaded. Please refresh or contact HR.";
        }
        finally
        {
            _isLoading = false;
        }
    }

 


    private static string FormatTime(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToString("hh:mm tt")
            : "--";
    }


    private static string FormatMinutes(int minutes)
    {
        if (minutes <= 0)
            return "--";

        var hours =
            minutes / 60;

        var remainingMinutes =
            minutes % 60;

        if (hours == 0)
            return $"{remainingMinutes}m";

        if (remainingMinutes == 0)
            return $"{hours}h";

        return $"{hours}h {remainingMinutes}m";
    }


    private static string GetStatusText(
        AttendanceDailyStatus status)
    {
        return status switch
        {
            AttendanceDailyStatus.NoActiveSchedule => "No active schedule found",
            AttendanceDailyStatus.BeforePositionApproval => "Awaiting job position approval",
            AttendanceDailyStatus.Present =>
                "Present",

            AttendanceDailyStatus.Absent =>
                "Absent",

            AttendanceDailyStatus.InProgress =>
                "In Progress",

            AttendanceDailyStatus.Incomplete =>
                "Incomplete",

            AttendanceDailyStatus.Partial =>
                "Partial",

            AttendanceDailyStatus.RestDay =>
                "Rest Day",

            AttendanceDailyStatus.Leave =>
                "On Leave",

            AttendanceDailyStatus.Holiday =>
                "Holiday",

            AttendanceDailyStatus.Future =>
                "Upcoming",

            _ =>
                "Unknown"
        };
    }


    private static string GetStatusClass(
        AttendanceDailyStatus status)
    {
        const string baseClass =
            "inline-flex items-center rounded-full px-2.5 py-1 " +
            "text-xs font-medium ";

        return status switch
        {
            AttendanceDailyStatus.Present =>
                baseClass +
                "bg-green-100 text-green-700",

            AttendanceDailyStatus.InProgress =>
                baseClass +
                "bg-blue-100 text-blue-700",

            AttendanceDailyStatus.Absent =>
                baseClass +
                "bg-red-100 text-red-700",

            AttendanceDailyStatus.Incomplete =>
                baseClass +
                "bg-amber-100 text-amber-700",

            AttendanceDailyStatus.Partial =>
                baseClass +
                "bg-amber-100 text-amber-700",

            AttendanceDailyStatus.RestDay =>
                baseClass +
                "bg-slate-100 text-slate-600",

            AttendanceDailyStatus.Leave =>
                baseClass +
                "bg-blue-100 text-blue-700",

            AttendanceDailyStatus.Holiday =>
                baseClass +
                "bg-purple-100 text-purple-700",

            AttendanceDailyStatus.Future =>
                baseClass +
                "bg-slate-100 text-slate-500",

            _ =>
                baseClass +
                "bg-slate-100 text-slate-600"
        };
    }

        private static string GetIssueDotClass(
        AttendanceEvaluationIssueSeverity severity)
        {
            const string baseClass =
            "mt-1 h-2 w-2 shrink-0 rounded-full ";

            return severity switch
            {
                AttendanceEvaluationIssueSeverity.Error =>
                baseClass + "bg-red-500",

                AttendanceEvaluationIssueSeverity.Warning =>
                baseClass + "bg-amber-500",

                _ =>
                baseClass + "bg-blue-500"
            };
        }
}
