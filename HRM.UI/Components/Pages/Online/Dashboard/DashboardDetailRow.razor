<div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 py-1 text-sm">
    <dt class="min-w-0 break-words">@Label</dt>
    <dd class="flex min-w-0 flex-wrap items-baseline gap-2">
        <span aria-hidden="true" class="text-slate-400">–</span>
        <span class="@ValueClass">@Value</span>
    </dd>
</div>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "muted";
    private string ValueClass => Tone switch {
        "primary" => "font-semibold tabular-nums text-blue-600 dark:text-blue-400",
        "positive" => "font-semibold tabular-nums text-emerald-700 dark:text-emerald-400",
        "negative" => "font-semibold tabular-nums text-amber-700 dark:text-amber-400",
        _ => "text-xs tabular-nums text-slate-500" };
}
