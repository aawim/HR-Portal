@using HRM.DTOs.Leave
@using HRM.Services.Leave
@inject HRM.Services.Leave.Contracts.LeaveHandoverServiceContracts.IOperations Handovers
@inject HRM.Services.ToastService Toast
@inject ILogger<WorkHandoverInboxCard> Logger

@if (loading || items.Count > 0 || loadFailed)
{
<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm space-y-4">
    <div class="flex items-start justify-between gap-3">
        <div><h3 class="text-lg font-semibold">Work handovers assigned to you</h3><p class="text-sm text-slate-500">Tasks awaiting your approval.</p></div>
        <button type="button" disabled="@Busy" class="text-sm text-blue-700 disabled:opacity-50" @onclick="LoadAsync">Refresh</button>
    </div>
    @if (message != null) { <p role="status" class="rounded border p-2 text-sm">@message</p> }
    @if (loading) { <p role="status" class="text-sm text-slate-500">Loading assigned handovers…</p> }

    <div class="max-h-[36rem] space-y-3 overflow-y-auto">
    @foreach (var item in items.Take(5))
    {
        <section @key="item.LeaveId" class="rounded-lg border p-3 space-y-3">
            <div>
                <a class="text-sm font-semibold text-blue-700" href="@($"/online/leave-handovers/{item.LeaveId}?assigned=true")">@item.Reference · @item.Applicant</a>
                <p class="mt-1 text-xs text-slate-500">@item.Dates</p>
                <a class="app-button app-button-secondary mt-2 text-xs" href="@($"/online/leave-handovers/{item.LeaveId}?assigned=true")">View work handover</a>
            </div>
            @foreach (var task in item.Tasks)
            {
                <div @key="task.Id" class="rounded bg-slate-50 p-3 space-y-2">
                    @if (item.CanSupervise) { <p class="text-xs text-slate-500">@task.Employee · @task.Decision</p> }
                    <p class="whitespace-pre-wrap break-words text-sm text-slate-800">@task.Tasks</p>
                    @if (task.CanDecide)
                    {
                        <div class="flex flex-wrap gap-2">
                            <button type="button" disabled="@Busy" class="rounded bg-blue-600 px-3 py-1.5 text-xs text-white disabled:opacity-50" @onclick="() => Choose(item, task.Id, true)">Approve task</button>
                            <button type="button" disabled="@Busy" class="rounded border px-3 py-1.5 text-xs text-amber-800 disabled:opacity-50" @onclick="() => Choose(item, task.Id, false)">Return</button>
                        </div>
                    }
                </div>
            }
            @if (item.CanSupervise)
            {
                <p class="text-xs text-slate-500">All tasks are approved. Your supervisor approval is required.</p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" disabled="@Busy" class="rounded bg-blue-600 px-3 py-1.5 text-xs text-white disabled:opacity-50" @onclick="() => Choose(item, null, true)">Approve handover</button>
                    <button type="button" disabled="@Busy" class="rounded border px-3 py-1.5 text-xs text-amber-800 disabled:opacity-50" @onclick="() => Choose(item, null, false)">Return</button>
                </div>
            }
            @if (decision?.LeaveId == item.LeaveId)
            {
                <div class="rounded border border-blue-200 p-3 space-y-2">
                    <p class="text-sm font-medium">@(approve ? "Confirm approval" : "Return for correction")</p>
                    @if (taskId.HasValue) { <p class="whitespace-pre-wrap break-words text-xs text-slate-600">@item.Tasks.FirstOrDefault(x => x.Id == taskId)?.Tasks</p> }
                    <label class="block text-xs">Comment @(approve ? "(optional)" : "(required)")
                        <textarea disabled="@Busy" class="mt-1 w-full rounded border p-2 text-sm" rows="2" maxlength="250" @bind="comment" @bind:event="oninput"></textarea>
                    </label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" disabled="@(Busy || (!approve && string.IsNullOrWhiteSpace(comment)))" class="rounded bg-blue-600 px-3 py-1.5 text-xs text-white disabled:opacity-50" @onclick="SaveAsync">@(saving ? "Saving…" : approve ? "Confirm approval" : "Confirm return")</button>
                        <button type="button" disabled="@Busy" class="rounded border px-3 py-1.5 text-xs" @onclick="CloseDecision">Cancel</button>
                    </div>
                </div>
            }
        </section>
    }
    </div>
    @if (items.Count > 0) { <a class="app-button app-button-secondary text-sm" href="/online/leave-handovers?assigned=true">View all assigned handovers (@items.Count)</a> }
</div>

}

@code {
    private List<LeaveHandoverInboxItem> items = [];
    private LeaveHandoverInboxItem? decision;
    private int? taskId;
    private bool loading, saving, approve, loadFailed;
    private bool Busy => loading || saving;
    private string? comment, message;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        if (Busy) return;
        loading = true; decision = null; loadFailed = false;
        try { items = await Handovers.GetAssignedInboxAsync(); }
        catch (Exception ex) { loadFailed = true; Logger.LogError(ex, "Could not load assigned work handovers."); items.Clear(); message = "Your assigned handovers could not be loaded. Please refresh to try again."; }
        finally { loading = false; }
    }
    private void Choose(LeaveHandoverInboxItem item, int? id, bool approval)
    {
        if (Busy) return;
        decision = item; taskId = id; approve = approval; comment = null; message = null;
    }
    private void CloseDecision() { if (!Busy) decision = null; }
    private async Task SaveAsync()
    {
        if (Busy || decision == null || (!approve && string.IsNullOrWhiteSpace(comment))) return;
        saving = true;
        try
        {
            var result = await Handovers.DecideAsync(decision.LeaveId, decision.Revision, taskId, approve, comment);
            message = result.Message;
            if (result.Success) Toast.Success(result.Message); else Toast.Warning(result.Message);
        }
        catch (Exception ex) { Logger.LogError(ex, "Could not save assigned handover decision."); message = "The decision could not be saved. Refresh to check the current status."; Toast.Error(message); }
        finally { saving = false; await LoadAsync(); }
    }
}
