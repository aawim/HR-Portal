@page "/online/chat/{ConversationId:long}/requests/{RequestId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HRM.Services.Contracts.StaffChatServiceContracts.IOperations Chat
@inject ILogger<ChatRequestDetails> Logger

<section class="w-full min-w-0 p-2 flex flex-col gap-2 text-slate-900 dark:text-slate-100">
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">Referenced Request</h1>
                @if (details != null)
                {
                    <span class="font-mono text-[11px] font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 px-2 py-0.5 rounded-md">
                        @details.Reference
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Read-only summary of the request attached in Staff Chat.</p>
        </div>
        <a href="@($"/online/chat?conversationId={ConversationId}")" class="app-button app-button-secondary app-button-sm">
            <AppIcon Name="arrow_back" Class="text-xs" />
            <span>Back to Chat</span>
        </a>
    </header>

    <div class="max-w-4xl w-full mx-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
        @if (error != null)
        {
            <div role="alert" class="flex items-center gap-2 rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 p-3 text-xs text-rose-800 dark:text-rose-200">
                <AppIcon Name="exclamation" Class="text-sm shrink-0" />
                <span>@error</span>
            </div>
        }
        else if (details == null)
        {
            <p class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">Loading request details…</p>
        }
        else
        {
            <dl class="grid gap-3 sm:grid-cols-2">
                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Reference</dt>
                    <dd class="mt-0.5 text-xs font-mono font-bold text-slate-900 dark:text-slate-100">@details.Reference</dd>
                </div>
                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Status</dt>
                    <dd class="mt-1">
                        <span class="inline-flex rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 px-2.5 py-0.5 text-[11px] font-semibold text-teal-800 dark:text-teal-300">
                            @details.Status
                        </span>
                    </dd>
                </div>
                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Request type</dt>
                    <dd class="mt-0.5 text-xs font-semibold text-slate-800 dark:text-slate-100">@details.Type</dd>
                </div>
                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Requesting staff member</dt>
                    <dd class="mt-0.5 text-xs font-semibold text-slate-800 dark:text-slate-100">@details.Applicant</dd>
                </div>
                <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                    <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Submitted</dt>
                    <dd class="mt-0.5 text-xs text-slate-800 dark:text-slate-100">@details.AppliedAtUtc.AddHours(5).ToString("dd MMM yyyy HH:mm")</dd>
                </div>
                @if (details.EffectiveDate.HasValue)
                {
                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Effective date</dt>
                        <dd class="mt-0.5 text-xs text-slate-800 dark:text-slate-100">@details.EffectiveDate.Value.ToString("dd MMM yyyy")</dd>
                    </div>
                }
                @foreach (var field in details.Details)
                {
                    <div class="rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-3">
                        <dt class="text-[11px] font-medium text-slate-500 dark:text-slate-400">@field.Label</dt>
                        <dd class="mt-0.5 whitespace-pre-wrap break-words text-xs text-slate-800 dark:text-slate-100">@field.Value</dd>
                    </div>
                }
            </dl>
        }
    </div>
</section>

@code {
    [Parameter] public long ConversationId { get; set; }
    [Parameter] public int RequestId { get; set; }
    private HRM.Services.ChatRequestDetails? details;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        details = null;
        error = null;
        try { details = await Chat.GetRequestDetailsAsync(ConversationId, RequestId); }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Opening request from chat");
            error = ex is UnauthorizedAccessException ? ex.Message : "Request details could not be loaded. Please try again.";
        }
    }
}
