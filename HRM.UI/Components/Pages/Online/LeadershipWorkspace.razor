@page "/online/leadership"
@using HRM.DTOs.Leadership
@inject HRM.Services.Contracts.LeadershipAuthorityServiceContracts.IOperations Leadership
@rendermode InteractiveServer
<PageTitle>Leadership Workspace</PageTitle>
<section class="leadership-workspace w-full min-w-0 p-2 space-y-4">
 @if (loading) { <div class="rounded-xl border border-slate-200 bg-white p-6 text-xs text-slate-500">Loading authorised organisations...</div> }
 else if (!string.IsNullOrWhiteSpace(error)) { <div class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">@error <button class="app-button app-button-secondary app-button-sm" @onclick="LoadAsync">Retry</button></div> }
 else { <header class="sticky top-0 z-30 m-0 border-b border-slate-200 bg-white/95 px-3 py-3 shadow-xs backdrop-blur-xs"><div class="flex flex-wrap items-center justify-between gap-2"><div><h1 class="text-lg font-bold text-slate-900">Leadership Workspace</h1><p class="mt-0.5 text-xs text-slate-500">Only organisations and permissions authorised by your active appointment are shown.</p></div><button class="app-button app-button-secondary app-button-sm" @onclick="LoadAsync">Refresh</button></div></header>
 <div class="page-panels page-panels-standard"><div class="page-panel-left min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><h2 class="font-bold text-slate-800 p-1">Authorised organisations</h2>@if (organisations.Count==0){<div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">No active leadership authority is assigned.</div>}else{<div class="overflow-x-auto rounded-xl border border-slate-200"><table class="w-full text-left text-xs"><thead class="border-b border-slate-200 bg-slate-50 font-semibold text-slate-700"><tr><th class="p-2.5">Organisation</th><th class="p-2.5">Permissions</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var org in organisations){<tr class="hover:bg-slate-50/50"><td class="p-2.5 font-semibold">@org.OrganisationName</td><td class="p-2.5">@foreach(var permission in org.Permissions){<span class="mr-1 inline-block rounded-md border border-blue-200 bg-blue-50 px-2 py-0.5 font-mono text-[11px] font-semibold text-blue-700">@permission</span>}</td></tr>}</tbody></table></div>}</div><aside class="page-panel-right min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><h2 class="font-bold text-slate-800 p-1">Security boundary</h2><p class="p-1 text-xs text-slate-600">This workspace does not switch your general organisation access. Each leadership operation is independently checked against its appointment, organisation, permission, and effective dates.</p></aside></div> }
</section>
@code { private bool loading=true; private string? error; private List<LeadershipOrganisationAccessDto> organisations=[]; protected override Task OnInitializedAsync()=>LoadAsync(); private async Task LoadAsync(){loading=true;error=null;try{organisations=(await Leadership.GetCurrentOrganisationAccessAsync()).ToList();}catch(Exception){error="The leadership workspace could not be loaded.";}finally{loading=false;}} }
