@page "/online/leadership"
@using HRM.DTOs.Leadership
@inject HRM.Services.Contracts.LeadershipAuthorityServiceContracts.IOperations Leadership
@inject Microsoft.JSInterop.IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Leadership Workspace</PageTitle>

<section class="leadership-workspace w-full min-w-0 p-2 space-y-4">
    <!-- Full-Width Sticky Header -->
    <header class="sticky top-0 z-30 m-0 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-3 py-3 shadow-xs rounded-2xl flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">Leadership Portal</span>
                <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">Scoped Authority</span>
            </div>
            <h1 class="text-lg font-bold text-slate-900 truncate mt-0.5">Leadership Workspace</h1>
            <p class="mt-0.5 text-xs text-slate-500">Only organisations and permissions authorised by your active appointment are shown.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition-colors"
                    @onclick="ToggleWidthAsync">
                @(isFullWidth ? "Shrink View" : "Full Width")
            </button>
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition-colors"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </div>
    </header>

    @if (loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 text-xs text-slate-500 shadow-xs @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl")">
            Loading authorised organisations...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div role="alert" class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl")">
            <span>@error</span>
            <button type="button" class="rounded-lg border border-rose-300 bg-white px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else
    {
        <div class="grid items-start gap-4 lg:grid-cols-12 @(isFullWidth ? "max-w-none" : "mx-auto max-w-7xl")">
            <div class="lg:col-span-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-900">Authorised Organisations</h2>
                    <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">@organisations.Count</span>
                </div>
                @if (organisations.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-xs text-slate-500">
                        No active leadership authority is assigned.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-200">
                        <table class="w-full text-left text-xs">
                            <thead class="border-b border-slate-200 bg-slate-50 text-[11px] font-semibold uppercase tracking-wide text-slate-600">
                                <tr>
                                    <th class="p-2.5">Organisation</th>
                                    <th class="p-2.5">Permissions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var org in organisations)
                                {
                                    <tr class="hover:bg-slate-50/70">
                                        <td class="p-2.5 font-semibold text-slate-900">@org.OrganisationName</td>
                                        <td class="p-2.5">
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var permission in org.Permissions)
                                                {
                                                    <span class="rounded-md border border-blue-200 bg-blue-50 px-2 py-0.5 font-mono text-[11px] font-semibold text-blue-700">@permission</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <aside class="lg:col-span-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs space-y-2">
                <h2 class="text-sm font-bold text-slate-900">Security Boundary</h2>
                <p class="text-xs leading-relaxed text-slate-600">
                    This workspace does not switch your general organisation access. Each leadership operation is independently checked against its appointment, organisation, permission, and effective dates.
                </p>
            </aside>
        </div>
    }
</section>

@code {
    private bool loading = true;
    private bool isFullWidth;
    private string? error;
    private List<LeadershipOrganisationAccessDto> organisations = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isFullWidth = await JS.InvokeAsync<string?>("localStorage.getItem", "hrm.online-leadership.full-width") == "true";
            StateHasChanged();
        }
    }

    private async Task ToggleWidthAsync()
    {
        isFullWidth = !isFullWidth;
        await JS.InvokeVoidAsync("localStorage.setItem", "hrm.online-leadership.full-width", isFullWidth ? "true" : "false");
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            organisations = (await Leadership.GetCurrentOrganisationAccessAsync()).ToList();
        }
        catch (Exception)
        {
            error = "The leadership workspace could not be loaded.";
        }
        finally
        {
            loading = false;
        }
    }
}
