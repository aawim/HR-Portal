@page "/online/staff-transfers"
@namespace HRM.Components.Pages.Online
@using HRM.Components.Admin.Hr.Transfers
@using HRM.DTOs
@using HRM.Enums
@using HRM.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer
@inject HRM.Services.Contracts.StaffTransferServiceContracts.IOperations Transfers
@inject ToastService Toasts
@inject ILogger<StaffTransfersPage> Logger

<PageTitle>My Internal Transfers &amp; Confirmations - Portal</PageTitle>

<div class="mx-auto max-w-6xl space-y-6 px-3 py-5">
    <!-- Page Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-4">
        <div>
            <span class="rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-blue-700">
                Staff Confirmation &amp; Transfer Notice
            </span>
            <h1 class="mt-1 text-2xl font-extrabold text-slate-900">Internal Staff Transfer Review &amp; Confirmation</h1>
            <p class="text-sm text-slate-500">
                Review your proposed department reassignment, position, work schedule, reporting instructions, and access arrangements before final approval.
            </p>
        </div>

        <button type="button"
                @onclick="LoadAsync"
                class="rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50">
            ↻ Refresh
        </button>
    </div>

    @if (printableDocument is not null)
    {
        <div class="rounded-2xl border-2 border-blue-200 bg-white p-5 shadow-lg">
            <StaffTransferPrintableView Document="printableDocument"
                                        AllowVariantSwitch="false"
                                        OnClose="() => printableDocument = null" />
        </div>
    }

    <!-- Transfer Selector List -->
    @if (dashboard?.Rows.Count > 0)
    {
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            @foreach (var row in dashboard.Rows)
            {
                var isSelected = selectedDetail?.StaffTransferId == row.StaffTransferId;
                <div @onclick="() => SelectTransferAsync(row.StaffTransferId)"
                     class="cursor-pointer rounded-xl border p-4 transition @(isSelected ? "border-blue-500 bg-blue-50/40 ring-2 ring-blue-500/20" : "border-slate-200 bg-white hover:border-blue-300")">
                    <div class="flex items-center justify-between">
                        <span class="font-mono text-xs font-bold text-slate-800">@row.TransferReferenceNo · v@row.CurrentVersion</span>
                        <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold @(row.IsConfirmedForCurrentVersion ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                            @(row.IsConfirmedForCurrentVersion ? $"Confirmed (v{row.ConfirmedVersion})" : $"Action Required (v{row.CurrentVersion})")
                        </span>
                    </div>
                    <div class="mt-1.5 text-sm font-bold text-slate-900">
                        @row.SourceOrganisationName → <span class="text-blue-700">@row.DestinationOrganisationName</span>
                    </div>
                    <div class="mt-1 flex flex-wrap items-center justify-between text-xs text-slate-600">
                        <span>@row.EmployeeFullName (#@row.EmployeeStaffNumber)</span>
                        <span>Effective: <strong>@row.EffectiveDate.ToString("dd MMM yyyy")</strong></span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center text-sm text-slate-500">
            You have no active or historical internal staff transfer requests at this time.
        </div>
    }

    <!-- Read-Only Side-by-Side Summary & Formal Confirmation Step -->
    @if (selectedDetail is not null)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-4">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-lg font-extrabold text-slate-900">
                            Transfer Summary — @selectedDetail.TransferReferenceNo (Version v@selectedDetail.CurrentVersion)
                        </h2>
                        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">
                            @selectedDetail.Status
                        </span>
                    </div>
                    <p class="text-xs text-slate-500">
                        Please review all sections carefully before submitting your formal confirmation, correction request, or clarification.
                    </p>
                </div>

                <button type="button"
                        @onclick="() => OpenPrintPreviewAsync(selectedDetail.StaffTransferId)"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-800 hover:bg-slate-50">
                    <span>🖨️</span>
                    <span>Print Preview / Save Notice PDF</span>
                </button>
            </div>

            <!-- Side-by-Side Current vs Proposed Comparison -->
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Current Assignment (Sending Department)</div>
                    <dl class="mt-3 space-y-2 text-xs">
                        <div class="flex justify-between"><dt class="text-slate-500">Employee</dt><dd class="font-semibold text-slate-900">@selectedDetail.EmployeeFullName (#@selectedDetail.EmployeeStaffNumber)</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Department / Unit</dt><dd class="font-semibold text-slate-900">@selectedDetail.SourceOrganisationName @(string.IsNullOrWhiteSpace(selectedDetail.SourceDepartmentUnit) ? "" : $"({selectedDetail.SourceDepartmentUnit})")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Position</dt><dd class="font-semibold text-slate-900">@selectedDetail.Job.ExistingPositionTitle</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Matrix / Grade</dt><dd class="text-slate-800">@(selectedDetail.Job.ExistingPositionMatrixCode ?? "—") · @(selectedDetail.Job.ExistingGradeLevel ?? "—")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Work Location</dt><dd class="text-slate-800">@(selectedDetail.Work.CurrentWorkLocation ?? "—")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Current Supervisor</dt><dd class="text-slate-800">@(selectedDetail.CurrentSupervisorName ?? "—")</dd></div>
                    </dl>
                </div>

                <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-4">
                    <div class="text-xs font-bold uppercase tracking-wider text-blue-800">Proposed Assignment (Receiving Department)</div>
                    <dl class="mt-3 space-y-2 text-xs">
                        <div class="flex justify-between"><dt class="text-slate-600">Transfer Type</dt><dd class="font-semibold text-blue-900">@selectedDetail.TransferType (@selectedDetail.AppointmentMode)</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-600">Receiving Department</dt><dd class="font-bold text-blue-900">@selectedDetail.DestinationOrganisationName @(string.IsNullOrWhiteSpace(selectedDetail.DestinationDepartmentUnit) ? "" : $"({selectedDetail.DestinationDepartmentUnit})")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-600">Proposed Position</dt><dd class="font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(selectedDetail.Job.DestinationPositionTitle) ? selectedDetail.Job.ExistingPositionTitle : selectedDetail.Job.DestinationPositionTitle)</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-600">Proposed Matrix / Grade</dt><dd class="text-slate-800">@(selectedDetail.Job.DestinationPositionMatrixCode ?? selectedDetail.Job.ExistingPositionMatrixCode ?? "—") · @(selectedDetail.Job.DestinationGradeLevel ?? selectedDetail.Job.ExistingGradeLevel ?? "—")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-600">Proposed Work Location</dt><dd class="font-semibold text-slate-900">@(selectedDetail.Work.ProposedWorkLocation ?? selectedDetail.DestinationOrganisationName)</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-600">New Reporting Supervisor</dt><dd class="font-semibold text-slate-900">@(selectedDetail.Job.NewReportingSupervisorName ?? selectedDetail.Reporting.ReportingToOfficerName ?? "—")</dd></div>
                    </dl>
                </div>
            </div>

            <!-- Schedule, Reporting & Handover Summary -->
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 p-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Work Schedule &amp; Attendance</h3>
                    <dl class="mt-2.5 space-y-1.5 text-xs">
                        <div class="flex justify-between"><dt class="text-slate-500">Schedule / Template</dt><dd class="font-semibold text-slate-900">@(selectedDetail.Work.OfficialWorkingSchedule ?? selectedDetail.Work.ProposedWorkTemplateName ?? "Standard")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Shift / Roster</dt><dd class="text-slate-800">@(selectedDetail.Work.ShiftOrRosterName ?? "Standard Day")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Working Days &amp; Hours</dt><dd class="text-slate-800">@(selectedDetail.Work.WorkingDaysPattern ?? "Sun–Thu") · @(selectedDetail.Work.StandardStartTime ?? "08:00")–@(selectedDetail.Work.StandardEndTime ?? "14:00")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Attendance Method</dt><dd class="text-slate-800">@(selectedDetail.Work.RequiredAttendanceMethod ?? "Biometric") @(string.IsNullOrWhiteSpace(selectedDetail.Work.AttendanceDeviceOrLocation) ? "" : $"({selectedDetail.Work.AttendanceDeviceOrLocation})")</dd></div>
                    </dl>
                </div>

                <div class="rounded-xl border border-slate-200 p-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Reporting &amp; Handover Instructions</h3>
                    <dl class="mt-2.5 space-y-1.5 text-xs">
                        <div class="flex justify-between"><dt class="text-slate-500">Effective Transfer Date</dt><dd class="font-bold text-slate-900">@selectedDetail.EffectiveDate.ToString("dd MMM yyyy")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Reporting Date &amp; Time</dt><dd class="font-bold text-blue-900">@selectedDetail.Reporting.ReportingDate.ToString("dd MMM yyyy") @(selectedDetail.Reporting.ReportingTime ?? "08:00")</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Reporting Location</dt><dd class="font-semibold text-slate-900">@(selectedDetail.Reporting.ReportingLocation ?? selectedDetail.DestinationOrganisationName)</dd></div>
                        <div class="flex justify-between"><dt class="text-slate-500">Handover Required</dt><dd class="text-slate-800">@(selectedDetail.Reporting.HandoverRequired ? $"Yes (by {selectedDetail.Reporting.HandoverDeadline?.ToString("dd MMM yyyy") ?? "Effective Date"})" : "No")</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(selectedDetail.Reporting.SpecialInstructions))
                    {
                        <div class="mt-2 rounded bg-slate-50 p-2 text-xs text-slate-700">
                            <strong>Special Instructions:</strong> @selectedDetail.Reporting.SpecialInstructions
                        </div>
                    }
                </div>
            </div>

            <!-- Access & Door Summary -->
            @if (selectedDetail.AccessChanges.Count > 0 || selectedDetail.DoorAccessItems.Count > 0)
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="rounded-xl border border-slate-200 p-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Organizational Access Changes</h3>
                        <ul class="mt-2 space-y-1.5 text-xs">
                            @foreach (var acc in selectedDetail.AccessChanges)
                            {
                                <li class="flex items-center justify-between rounded bg-slate-50 px-2.5 py-1.5">
                                    <span class="font-medium text-slate-800">@acc.AccessArea</span>
                                    <span class="font-semibold text-blue-800">@acc.ProposedAction → @(acc.ProposedAccessSummary ?? "Reviewed")</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="rounded-xl border border-slate-200 p-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Physical Door Access</h3>
                        <ul class="mt-2 space-y-1.5 text-xs">
                            @foreach (var door in selectedDetail.DoorAccessItems)
                            {
                                <li class="flex items-center justify-between rounded bg-slate-50 px-2.5 py-1.5">
                                    <span class="font-medium text-slate-800">@door.BuildingName @(string.IsNullOrWhiteSpace(door.FloorName) ? "" : $"/ {door.FloorName}") @(string.IsNullOrWhiteSpace(door.RoomOrZoneName) ? "" : $"/ {door.RoomOrZoneName}")</span>
                                    <span class="text-slate-600">@(door.ProposedAccessGroups ?? "Standard Access") (@door.ProvisioningState)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Formal Auditable Staff Confirmation Box -->
            <div class="rounded-2xl border-2 @(selectedDetail.IsConfirmedForCurrentVersion ? "border-emerald-300 bg-emerald-50/40" : "border-blue-300 bg-blue-50/30") p-5">
                <h3 class="text-sm font-extrabold text-slate-900">
                    Tab 07 — Formal Staff Confirmation (Version v@selectedDetail.CurrentVersion)
                </h3>

                <label class="mt-3 flex items-start gap-2.5 rounded-xl border border-slate-200 bg-white p-3.5 text-xs text-slate-800 shadow-sm">
                    <input type="checkbox"
                           @bind="acknowledgedStatement"
                           class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600" />
                    <span class="leading-relaxed">
                        @StaffTransferValidator.DefaultConfirmationStatement
                    </span>
                </label>

                <div class="mt-3">
                    <label class="block text-xs font-semibold text-slate-700">
                        Employee Remarks / Correction Details / Clarification Notes
                        <span class="font-normal text-slate-500">(Required when requesting correction or submitting clarification)</span>
                    </label>
                    <textarea rows="2"
                              @bind="employeeRemarks"
                              placeholder="Enter any remarks, handover notes, or specific fields requiring correction..."
                              class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs"></textarea>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                    <div class="text-xs text-slate-600">
                        @if (selectedDetail.IsConfirmedForCurrentVersion)
                        {
                            <span class="font-semibold text-emerald-800">
                                ✓ You confirmed version v@selectedDetail.ConfirmedVersion on @selectedDetail.ConfirmedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm").
                            </span>
                        }
                        else
                        {
                            <span>Confirmation acknowledges the reviewed information and unlocks Receiving Department final approval.</span>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button"
                                disabled="@isSubmitting"
                                @onclick="() => SubmitConfirmationResponseAsync(StaffTransferConfirmationResponses.RequestCorrection)"
                                class="rounded-xl border border-rose-300 bg-white px-3.5 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50">
                            Request Correction
                        </button>

                        <button type="button"
                                disabled="@isSubmitting"
                                @onclick="() => SubmitConfirmationResponseAsync(StaffTransferConfirmationResponses.SubmitClarification)"
                                class="rounded-xl border border-amber-300 bg-white px-3.5 py-2 text-xs font-semibold text-amber-800 hover:bg-amber-50">
                            Submit Clarification
                        </button>

                        <button type="button"
                                disabled="@(isSubmitting || !acknowledgedStatement)"
                                @onclick="() => SubmitConfirmationResponseAsync(StaffTransferConfirmationResponses.ConfirmInformation)"
                                class="rounded-xl bg-emerald-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50">
                            ✓ Confirm Information (v@selectedDetail.CurrentVersion)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "transferId")]
    public int? QueryTransferId { get; set; }

    private StaffTransferDashboardDto? dashboard;
    private StaffTransferDetailDto? selectedDetail;
    private StaffTransferPrintableDocumentDto? printableDocument;
    private bool acknowledgedStatement = true;
    private string employeeRemarks = string.Empty;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            dashboard = await Transfers.LoadDashboardAsync();
            if (QueryTransferId.HasValue && QueryTransferId.Value > 0)
            {
                await SelectTransferAsync(QueryTransferId.Value);
            }
            else if (dashboard?.Rows.Count > 0)
            {
                await SelectTransferAsync(dashboard.Rows[0].StaffTransferId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load online staff transfers.");
            Toasts.Show("Failed to load transfer requests.", ToastType.Error);
        }
    }

    private async Task SelectTransferAsync(int staffTransferId)
    {
        printableDocument = null;
        selectedDetail = await Transfers.LoadDetailAsync(staffTransferId);
    }

    private async Task SubmitConfirmationResponseAsync(StaffTransferConfirmationResponses responseType)
    {
        if (selectedDetail is null)
            return;

        if (responseType == StaffTransferConfirmationResponses.ConfirmInformation && !acknowledgedStatement)
        {
            Toasts.Show("Please check the confirmation statement box before confirming.", ToastType.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            var input = new StaffTransferConfirmationInput
            {
                StaffTransferId = selectedDetail.StaffTransferId,
                VersionNumber = selectedDetail.CurrentVersion,
                ResponseType = responseType,
                AcknowledgedStatement = acknowledgedStatement,
                ConfirmationStatement = StaffTransferValidator.DefaultConfirmationStatement,
                Remarks = employeeRemarks
            };

            var res = await Transfers.SubmitEmployeeConfirmationAsync(input);
            if (res.Succeeded)
            {
                employeeRemarks = string.Empty;
                Toasts.Show(res.Message, ToastType.Success);
                await LoadAsync();
                await SelectTransferAsync(selectedDetail.StaffTransferId);
            }
            else
            {
                Toasts.Show(res.Message, ToastType.Error);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OpenPrintPreviewAsync(int staffTransferId)
    {
        printableDocument = await Transfers.GetPrintableDocumentAsync(staffTransferId, StaffTransferDocumentVariants.EmployeeNotice);
    }
}
