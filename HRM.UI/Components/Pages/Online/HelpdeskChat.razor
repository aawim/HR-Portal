@page "/online/helpdesk"
@page "/admin/helpdesk"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@using HRM.DTOs.Helpdesk
@using HRM.Models
@inject HRM.Services.Contracts.HelpdeskServiceContracts.IOperations Helpdesk
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<HelpdeskChat> Logger

<section class="w-full min-w-0 p-2 flex flex-col gap-2 text-slate-900 dark:text-slate-100">
    <!-- Compact, Transparent, Borderless Header (Never Shrinks) -->
    <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">GHR Helpdesk</h1>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800 px-2 py-0.5 text-[10px] font-semibold text-teal-700 dark:text-teal-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                    Bot + Live Officers
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Get instant help from our Helpdesk Assistant — a real Helpdesk Officer takes over automatically whenever needed.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            <a href="@StaffChatRoute" class="app-button app-button-secondary app-button-sm">
                <AppIcon Name="chat" Class="text-xs" />
                <span>Staff Chat</span>
            </a>
            <button type="button" class="app-button app-button-neutral app-button-sm" @onclick="ToggleFullWidthAsync">
                <AppIcon Name="@(isFullWidth ? "fullscreen_exit" : "fullscreen")" Class="text-xs" />
                <span>@(isFullWidth ? "Shrink View" : "Full Width")</span>
            </button>
            <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="RefreshAsync">
                <AppIcon Name="refresh" Class="text-xs" />
                <span>Refresh</span>
            </button>
            <button type="button" class="app-button app-button-primary app-button-sm" disabled="@busy" @onclick="StartNewView">
                <AppIcon Name="add" Class="text-xs" />
                <span>New Helpdesk Chat</span>
            </button>
        </div>
    </header>

    @if (error != null)
    {
        <div role="alert" class="flex items-center justify-between gap-2 rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 px-3 py-2 text-xs text-rose-800 dark:text-rose-200">
            <div class="flex items-center gap-2 min-w-0">
                <AppIcon Name="exclamation" Class="text-sm shrink-0" />
                <span class="truncate">@error</span>
            </div>
            <button type="button" class="app-button app-button-ghost app-button-sm app-button-icon shrink-0" aria-label="Dismiss error" @onclick="() => error = null">
                <AppIcon Name="close" Class="text-xs" />
            </button>
        </div>
    }

    <div class="hd-shell-wrap @(isFullWidth ? "hd-shell-full" : "hd-shell-standard")">
        <div class="hd-app-shell">
            <!-- LEFT SIDEBAR: My Helpdesk Tickets -->
            <aside class="hd-sidebar @(!mobileShowList ? "hd-hidden-mobile" : "")" aria-label="My Helpdesk Tickets">
                <div class="p-3 border-b border-slate-200 dark:border-slate-800 flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-2">
                        <h2 class="text-xs font-bold text-slate-900 dark:text-slate-100">My Support Tickets</h2>
                        <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-300">@tickets.Count</span>
                    </div>
                    <div class="relative flex items-center">
                        <span class="pointer-events-none absolute left-2.5 text-slate-400">
                            <AppIcon Name="search" Class="text-xs" />
                        </span>
                        <input type="search"
                               @bind="ticketSearch"
                               @bind:event="oninput"
                               placeholder="Search tickets..."
                               class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 pl-8 pr-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 focus:border-teal-500 focus:bg-white dark:focus:bg-slate-800 focus:outline-none" />
                    </div>
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto hd-scroll">
                    @if (FilteredTickets.Count == 0)
                    {
                        <div class="p-6 text-center flex flex-col items-center gap-2">
                            <div class="h-10 w-10 rounded-full bg-teal-50 dark:bg-teal-950/60 flex items-center justify-center text-teal-700 dark:text-teal-300">
                                <AppIcon Name="bi-headset" Class="text-base" />
                            </div>
                            <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">No support chats yet</p>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">Start a chat with our Helpdesk Assistant anytime.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in FilteredTickets)
                        {
                            var isActive = activeTicket?.Ticket.Id == item.Id;
                            <button type="button"
                                    @key="item.Id"
                                    class="hd-ticket-item @(isActive ? "hd-ticket-item-active" : "")"
                                    disabled="@busy"
                                    @onclick="() => OpenTicketAsync(item.Id)">
                                <div class="flex items-center justify-between gap-2 w-full">
                                    <span class="font-mono text-[10px] font-bold text-blue-700 dark:text-blue-300">@item.TicketNumber</span>
                                    <span class="text-[10px] text-slate-400">@FormatRelativeTime(item.UpdatedAtUtc)</span>
                                </div>
                                <p class="text-xs font-semibold text-slate-900 dark:text-slate-100 truncate w-full">@item.Subject</p>
                                <div class="flex items-center justify-between gap-2 w-full">
                                    <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-semibold @StatusBadgeClass(item.Status)">
                                        @StatusLabel(item.Status)
                                    </span>
                                    @if (item.UnreadCount > 0)
                                    {
                                        <span class="rounded-full bg-teal-700 px-1.5 py-0.5 text-[10px] font-bold text-white">@item.UnreadCount</span>
                                    }
                                </div>
                            </button>
                        }
                    }
                </div>
            </aside>

            <!-- CENTER WORKSPACE -->
            <section class="hd-main @(mobileShowList ? "hd-hidden-mobile" : "")" aria-label="Helpdesk Conversation">
                @if (activeTicket == null)
                {
                    <!-- Start New Helpdesk Chat Panel -->
                    <div class="flex-1 overflow-y-auto hd-scroll p-4 sm:p-6 flex flex-col items-center justify-center">
                        <div class="w-full max-w-2xl rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs flex flex-col gap-4">
                            <div class="flex items-start gap-3">
                                <div class="h-11 w-11 rounded-2xl bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 flex items-center justify-center text-teal-700 dark:text-teal-300 shrink-0">
                                    <AppIcon Name="bi-robot" Class="text-xl" />
                                </div>
                                <div class="min-w-0">
                                    <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">Hi! I'm the GHR Helpdesk Assistant.</h2>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                        Choose a topic below or describe your question. I'll answer immediately — and if I can't solve it, a real Helpdesk Officer will take over seamlessly.
                                    </p>
                                </div>
                            </div>

                            <!-- Quick Topic Selector -->
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                @foreach (var topic in QuickTopics)
                                {
                                    var selectedTopic = newCategory == topic.Category;
                                    <button type="button"
                                            class="rounded-xl border p-2.5 text-left transition flex flex-col gap-1 @(selectedTopic ? "border-teal-600 bg-teal-50/80 dark:bg-teal-950/40 ring-1 ring-teal-500" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 hover:border-teal-400")"
                                            @onclick="() => SelectQuickTopic(topic)">
                                        <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-100">
                                            <AppIcon Name="@topic.Icon" Class="text-teal-700 dark:text-teal-300 text-xs" />
                                            <span class="truncate">@topic.Category</span>
                                        </div>
                                        <span class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">@topic.Hint</span>
                                    </button>
                                }
                            </div>

                            <div class="flex flex-col gap-2">
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                    Subject (optional)
                                    <input @bind="newSubject"
                                           maxlength="200"
                                           placeholder="Brief summary of your question..."
                                           class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                </label>
                                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                    How can we help you today?
                                    <textarea @bind="newMessage"
                                              @bind:event="oninput"
                                              rows="3"
                                              maxlength="4000"
                                              placeholder="Type your question or issue here..."
                                              class="mt-1 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"></textarea>
                                </label>
                            </div>

                            <div class="flex items-center justify-between gap-2 pt-1">
                                <span class="text-[11px] text-slate-500 dark:text-slate-400">Topic: <strong>@newCategory</strong></span>
                                <button type="button"
                                        class="app-button app-button-primary app-button-sm"
                                        disabled="@(busy || string.IsNullOrWhiteSpace(newMessage))"
                                        @onclick="CreateTicketAsync">
                                    <AppIcon Name="bi-send-fill" Class="text-xs" />
                                    <span>@(busy ? "Starting..." : "Start Helpdesk Chat")</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    var t = activeTicket.Ticket;

                    <!-- Pinned Ticket Header -->
                    <div class="shrink-0 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 sm:px-4 py-2.5">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <button type="button"
                                    class="lg:hidden app-button app-button-ghost app-button-sm app-button-icon shrink-0"
                                    aria-label="Back to tickets"
                                    @onclick="() => mobileShowList = true">
                                <AppIcon Name="arrow_back" Class="text-sm" />
                            </button>

                            <div class="h-9 w-9 rounded-full flex items-center justify-center shrink-0 @(t.Status == HelpdeskTicketStatuses.AgentAssigned ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300" : "bg-blue-50 text-blue-700 dark:bg-blue-950/70 dark:text-blue-300")">
                                <AppIcon Name="@(t.Status == HelpdeskTicketStatuses.AgentAssigned ? "bi-headset" : "bi-robot")" Class="text-base" />
                            </div>

                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="font-mono text-[11px] font-bold text-blue-700 dark:text-blue-300">@t.TicketNumber</span>
                                    <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">@t.Subject</h2>
                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @StatusBadgeClass(t.Status)">@StatusLabel(t.Status)</span>
                                </div>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                                    @t.OrganisationName · @t.Category
                                    @if (!string.IsNullOrWhiteSpace(t.AssignedAgentName))
                                    {
                                        <span> · Live Officer: <strong class="text-slate-700 dark:text-slate-200">@t.AssignedAgentName</strong></span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-1.5 shrink-0">
                            @if (activeTicket.CanEscalate)
                            {
                                <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="EscalateAsync">
                                    <AppIcon Name="bi-headset" Class="text-xs" />
                                    <span>Talk to a Real Person</span>
                                </button>
                            }
                            @if (activeTicket.CanResolve)
                            {
                                <button type="button" class="app-button app-button-success app-button-sm" disabled="@busy" @onclick="() => ResolveAsync(5)">
                                    <AppIcon Name="check_circle" Class="text-xs" />
                                    <span>That Solved It</span>
                                </button>
                            }
                            else if (t.Status == HelpdeskTicketStatuses.Resolved)
                            {
                                <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="ReopenAsync">
                                    <AppIcon Name="refresh" Class="text-xs" />
                                    <span>Reopen</span>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Status Banner when Waiting for Human Handover -->
                    @if (t.Status == HelpdeskTicketStatuses.WaitingForAgent)
                    {
                        <div class="shrink-0 flex items-center gap-2 border-b border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/40 px-4 py-2 text-xs text-amber-900 dark:text-amber-200">
                            <AppIcon Name="bi-hourglass-split" Class="text-xs shrink-0" />
                            <span>You are in the live Helpdesk queue. A real Helpdesk Officer will take over here shortly — feel free to add more details while you wait.</span>
                        </div>
                    }

                    <!-- Message Timeline -->
                    <div @ref="messageList" class="hd-messages-canvas hd-scroll" aria-label="Helpdesk messages" aria-live="polite">
                        @foreach (var msg in activeTicket.Messages)
                        {
                            var localTime = msg.SentAtUtc.AddHours(5);
                            if (msg.SenderType == HelpdeskSenderTypes.System)
                            {
                                <div @key="msg.Id" class="my-1 flex justify-center">
                                    <div class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700 bg-white/95 dark:bg-slate-800/95 px-3 py-1 text-[11px] font-medium text-slate-600 dark:text-slate-300 shadow-2xs">
                                        <AppIcon Name="info" Class="text-xs text-teal-600 dark:text-teal-400" />
                                        <span>@msg.Body</span>
                                        <span class="text-[10px] text-slate-400">· @localTime.ToString("HH:mm")</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                var isUser = msg.SenderType == HelpdeskSenderTypes.User;
                                var isBot = msg.SenderType == HelpdeskSenderTypes.Bot;
                                <article @key="msg.Id" class="hd-row @(isUser ? "hd-row-mine" : "hd-row-other")">
                                    @if (!isUser)
                                    {
                                        <div class="h-7 w-7 rounded-full flex items-center justify-center text-xs shrink-0 @(isBot ? "bg-blue-100 text-blue-700 dark:bg-blue-950/80 dark:text-blue-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300")">
                                            <AppIcon Name="@(isBot ? "bi-robot" : "bi-headset")" Class="text-xs" />
                                        </div>
                                    }

                                    <div class="hd-bubble-col @(isUser ? "hd-bubble-col-mine" : "hd-bubble-col-other")">
                                        @if (!isUser)
                                        {
                                            <div class="mb-0.5 ml-1 flex items-center gap-1.5">
                                                <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">@msg.SenderName</span>
                                                <span class="rounded-full px-1.5 py-0.2 text-[9px] font-bold uppercase tracking-wide @(isBot ? "bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800" : "bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800")">
                                                    @(isBot ? "Bot" : "Officer")
                                                </span>
                                            </div>
                                        }

                                        <div class="hd-bubble @(isUser ? "hd-bubble-user" : isBot ? "hd-bubble-bot" : "hd-bubble-agent")">
                                            <p class="whitespace-pre-wrap break-words">@msg.Body</p>
                                            <div class="mt-1 flex items-center justify-end gap-1 text-[10px] @(isUser ? "text-teal-100/90" : "text-slate-400")">
                                                <time>@localTime.ToString("dd MMM HH:mm")</time>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }
                        }
                    </div>

                    <!-- Quick Rating Bar after Resolution -->
                    @if (t.Status == HelpdeskTicketStatuses.Resolved && !t.Rating.HasValue)
                    {
                        <div class="shrink-0 flex flex-wrap items-center justify-between gap-2 border-t border-emerald-200 dark:border-emerald-800 bg-emerald-50/70 dark:bg-emerald-950/30 px-4 py-2 text-xs">
                            <span class="font-semibold text-emerald-900 dark:text-emerald-200">How helpful was this support session?</span>
                            <div class="flex items-center gap-1">
                                @for (var s = 1; s <= 5; s++)
                                {
                                    var star = s;
                                    <button type="button" class="app-button app-button-secondary app-button-sm" disabled="@busy" @onclick="() => ResolveAsync(star)">
                                        @star ★
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <!-- Pinned Composer -->
                    <fieldset disabled="@busy" class="shrink-0 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 sm:px-4 py-2.5 flex flex-col gap-1.5">
                        <div class="hd-composer-shell">
                            <label for="hd-user-reply" class="sr-only">Message</label>
                            <textarea id="hd-user-reply"
                                      @ref="composerInput"
                                      @bind="replyBody"
                                      @bind:event="oninput"
                                      rows="1"
                                      maxlength="4000"
                                      placeholder="@(t.Status == HelpdeskTicketStatuses.Resolved ? "Send a reply to reopen this ticket..." : "Write a message… (Enter to send, Shift+Enter for new line)")"
                                      class="hd-composer-input"></textarea>
                            <button type="button"
                                    class="hd-send-btn"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(replyBody))"
                                    @onclick="SendReplyAsync">
                                <AppIcon Name="bi-send-fill" Class="text-xs" />
                                <span class="hidden sm:inline">Send</span>
                            </button>
                        </div>
                        <div class="flex items-center justify-between px-1 text-[10px] text-slate-400">
                            <span>@(t.Status == HelpdeskTicketStatuses.BotActive ? "Bot is assisting · Click 'Talk to a Real Person' anytime for human handover" : t.Status == HelpdeskTicketStatuses.AgentAssigned ? "Connected with a live Helpdesk Officer" : "Enter to send · Shift + Enter for new line")</span>
                            <span>@replyBody.Length.ToString("N0") / 4,000</span>
                        </div>
                    </fieldset>
                }
            </section>
        </div>
    </div>
</section>

@code {
    private const string FullWidthStorageKey = "hrm.helpdesk.full-width";
    private sealed record QuickTopic(string Category, string Icon, string Hint, string StarterPrompt);

    private static readonly QuickTopic[] QuickTopics =
    [
        new("Leave & Attendance", "calendar", "Apply/cancel leave, missed punch, late check-in, OT.", "I need help with leave or attendance: "),
        new("Payroll & Payslips", "payments", "Monthly payslips, allowances, deductions, loans.", "I have a question about my payslip or payroll: "),
        new("Requests & Approvals", "document", "Item requests, certificates, pending approvals.", "I need help with an HR request or certificate: "),
        new("Account & Access", "bi-shield-lock", "Portal permissions, roles, wrong organisation.", "I have an account or portal access issue: "),
        new("Technical Issue", "exclamation", "System error, page not loading, bug report.", "I encountered a technical issue: "),
        new("General", "chat", "Any other HR or platform support question.", "")
    ];

    [SupplyParameterFromQuery(Name = "ticketId")] public long? TicketId { get; set; }

    private List<HelpdeskTicketSummaryDto> tickets = [];
    private HelpdeskTicketDetailDto? activeTicket;
    private string ticketSearch = "";
    private string newCategory = "General", newSubject = "", newMessage = "", replyBody = "";
    private string? error;
    private bool busy, disposed, isFullWidth, scroll, forceScroll, mobileShowList = true;
    private long composerBoundForId;

    private ElementReference messageList;
    private ElementReference composerInput;
    private DotNetObjectReference<HelpdeskChat>? dotNetRef;
    private readonly CancellationTokenSource stop = new();
    private Task? watching;

    private string BaseRoute => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase) ? "/admin/helpdesk" : "/online/helpdesk";
    private string StaffChatRoute => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase) ? "/admin/chat" : "/online/chat";

    private List<HelpdeskTicketSummaryDto> FilteredTickets => tickets
        .Where(t => string.IsNullOrWhiteSpace(ticketSearch)
            || t.Subject.Contains(ticketSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || t.TicketNumber.Contains(ticketSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || t.Category.Contains(ticketSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tickets = await Helpdesk.GetMyTicketsAsync();
            if (TicketId is > 0)
                await OpenTicketAsync(TicketId.Value, navigate: false);
        }
        catch (Exception ex) { Fail(ex); }
        watching = WatchAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", FullWidthStorageKey);
                if (string.Equals(saved, "true", StringComparison.OrdinalIgnoreCase))
                {
                    isFullWidth = true;
                    StateHasChanged();
                }
            }
            catch { }
        }

        if (scroll && activeTicket != null)
        {
            scroll = false;
            try { await JS.InvokeVoidAsync("hrmChat.scrollToLatest", messageList, forceScroll); } catch { }
            forceScroll = false;
        }

        if (activeTicket != null && composerBoundForId != activeTicket.Ticket.Id)
        {
            composerBoundForId = activeTicket.Ticket.Id;
            dotNetRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("hrmChat.bindComposer", composerInput, dotNetRef); }
            catch { composerBoundForId = 0; }
        }
        else if (activeTicket == null)
        {
            composerBoundForId = 0;
        }
    }

    private async Task ToggleFullWidthAsync()
    {
        isFullWidth = !isFullWidth;
        try { await JS.InvokeVoidAsync("localStorage.setItem", FullWidthStorageKey, isFullWidth ? "true" : "false"); } catch { }
    }

    private void StartNewView()
    {
        activeTicket = null;
        composerBoundForId = 0;
        mobileShowList = false;
        error = null;
        Navigation.NavigateTo(BaseRoute, replace: true);
    }

    private void SelectQuickTopic(QuickTopic topic)
    {
        newCategory = topic.Category;
        if (string.IsNullOrWhiteSpace(newMessage) && !string.IsNullOrEmpty(topic.StarterPrompt))
            newMessage = topic.StarterPrompt;
    }

    private async Task CreateTicketAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(newMessage)) return;
        busy = true;
        error = null;
        try
        {
            activeTicket = await Helpdesk.CreateTicketAsync(newCategory, newSubject, newMessage);
            newSubject = "";
            newMessage = "";
            mobileShowList = false;
            tickets = await Helpdesk.GetMyTicketsAsync();
            scroll = forceScroll = true;
            Navigation.NavigateTo($"{BaseRoute}?ticketId={activeTicket.Ticket.Id}", replace: true);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task OpenTicketAsync(long id, bool navigate = true)
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            activeTicket = await Helpdesk.GetTicketAsync(id);
            mobileShowList = false;
            replyBody = "";
            composerBoundForId = 0;
            tickets = await Helpdesk.GetMyTicketsAsync();
            scroll = forceScroll = true;
            if (navigate) Navigation.NavigateTo($"{BaseRoute}?ticketId={id}", replace: true);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    [JSInvokable]
    public async Task SubmitFromKeyboardAsync()
    {
        if (disposed || busy || activeTicket == null || string.IsNullOrWhiteSpace(replyBody)) return;
        await InvokeAsync(async () =>
        {
            await SendReplyAsync();
            StateHasChanged();
        });
    }

    private async Task SendReplyAsync()
    {
        if (busy || activeTicket == null || string.IsNullOrWhiteSpace(replyBody)) return;
        busy = true;
        error = null;
        try
        {
            activeTicket = await Helpdesk.SendUserMessageAsync(activeTicket.Ticket.Id, replyBody);
            replyBody = "";
            try { await JS.InvokeVoidAsync("hrmChat.resetComposerHeight", composerInput); } catch { }
            tickets = await Helpdesk.GetMyTicketsAsync();
            scroll = forceScroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task EscalateAsync()
    {
        if (busy || activeTicket == null) return;
        busy = true;
        error = null;
        try
        {
            activeTicket = await Helpdesk.EscalateToAgentAsync(activeTicket.Ticket.Id, "Requester clicked 'Talk to a Real Person'.");
            tickets = await Helpdesk.GetMyTicketsAsync();
            scroll = forceScroll = true;
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task ResolveAsync(int rating)
    {
        if (busy || activeTicket == null) return;
