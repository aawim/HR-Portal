    }

    private async Task RefreshAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try { await PollCoreAsync(); }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task PollCoreAsync()
    {
        tickets = await Helpdesk.GetMyTicketsAsync();
        if (activeTicket != null)
        {
            var prevCount = activeTicket.Messages.Count;
            activeTicket = await Helpdesk.GetTicketAsync(activeTicket.Ticket.Id);
            if (activeTicket.Messages.Count > prevCount) scroll = true;
        }
    }

    private async Task WatchAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (busy || disposed) return;
                    try { await PollCoreAsync(); StateHasChanged(); }
                    catch { }
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private static string StatusLabel(string status) => status switch
    {
        HelpdeskTicketStatuses.BotActive => "Bot Assisting",
        HelpdeskTicketStatuses.WaitingForAgent => "Waiting for Officer",
        HelpdeskTicketStatuses.AgentAssigned => "Live Officer",
        HelpdeskTicketStatuses.Resolved => "Resolved",
        _ => status
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        HelpdeskTicketStatuses.BotActive => "bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800",
        HelpdeskTicketStatuses.WaitingForAgent => "bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800",
        HelpdeskTicketStatuses.AgentAssigned => "bg-emerald-100 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800",
        HelpdeskTicketStatuses.Resolved => "bg-slate-100 text-slate-600 border border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700",
        _ => "bg-slate-100 text-slate-700"
    };

    private static string FormatRelativeTime(DateTime utc)
    {
        var local = utc.AddHours(5);
        var today = DateTime.UtcNow.AddHours(5).Date;
        if (local.Date == today) return local.ToString("HH:mm");
        if (local.Date == today.AddDays(-1)) return "Yesterday";
        return local.ToString("dd MMM");
    }

    private void Fail(Exception ex)
    {
        Logger.LogWarning(ex, "Helpdesk chat operation failed");
        error = ex is UnauthorizedAccessException or InvalidOperationException
            ? ex.Message
            : "Helpdesk is temporarily unavailable. Please try again.";
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await stop.CancelAsync();
        if (watching != null) await watching;
        stop.Dispose();
        dotNetRef?.Dispose();
    }
}
