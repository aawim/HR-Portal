@page "/online/signature"
@rendermode RenderMode.InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>My Digital Signature</PageTitle>

<div class="w-full max-w-4xl mx-auto px-4 py-6 space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-4">
        <div>
            <div class="flex items-center gap-2">
                <div style="background-color:#075985; color:#ffffff;" class="flex h-9 w-9 items-center justify-center rounded-xl shadow-xs">
                    <i class="bi bi-pen text-base" aria-hidden="true"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900">Digital Signature &amp; Signing Style</h1>
                    <p class="text-xs text-slate-500">Switch between Canvas drawing, PNG image upload, or QR Code Seal and manage your Signing PIN.</p>
                </div>
            </div>
        </div>
        <a href="/profile"
           class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">
            <i class="bi bi-person-circle" aria-hidden="true"></i>
            <span>My Profile</span>
        </a>
    </div>

    <HRM.Components.Shared.SignaturePadCard />

    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 text-xs text-slate-600 space-y-1.5">
        <div class="font-bold text-slate-800 flex items-center gap-1.5">
            <i class="bi bi-info-circle text-blue-600" aria-hidden="true"></i>
            <span>How Signing Styles Work</span>
        </div>
        <ul class="list-disc pl-5 space-y-1 text-[11px]">
            <li><strong>Canvas (Draw):</strong> Draw your handwritten signature directly on the pad; attached with a QR verification code when signing documents.</li>
            <li><strong>PNG Image:</strong> Upload a transparent PNG (or WebP/JPG) of your signature to stamp on official HRM documents.</li>
            <li><strong>QR Code Seal:</strong> Sign documents with a verified cryptographic QR seal (no handwritten image required) displaying your name, position, timestamp, and verification code.</li>
        </ul>
    </div>
</div>
