@using HRM.Services.State
@if (!LeaveState.HasLeaveType)
{
    <div class="bg-yellow-50 border border-yellow-300 rounded-lg p-4">Please select a Leave Type.</div>
}
else
{
    <LeaveApplicationForm LeaveState="LeaveState" />
}
@code {
    [Parameter] public LeaveApplicationState LeaveState { get; set; } = default!;
}
