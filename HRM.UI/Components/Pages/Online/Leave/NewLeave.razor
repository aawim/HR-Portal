@* @page "/online/leave/application" *@
@* @page "/online/leaves/{Page}" *@
@using System.ComponentModel.DataAnnotations
@using HRM.Components.Pages.Online.Leave.Cards
@using HRM.Components.Pages.Online.Leave.Forms
@using HRM.Components.Shared
@using HRM.DTOs.Leave
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Services.State
@using HRM.Services.Stores

@* @inject IUserService UserService *@
@inject HRM.Application.Contracts.Pages.ILeaveApplications LeaveService
@inject LeaveStore LeaveStore
@inject ToastService ToastService

<div class="leave-application">
<div class="border-b px-1 pb-3">
    <h2 class="text-2xl font-bold text-slate-800">Leave Application</h2>
    <p class="text-sm text-gray-500">@(LeaveState.ApplicantJobId.HasValue ? "HR application on behalf of the selected staff member. The normal approval flow applies." : "Apply for leave and manage details")</p>

</div>

<div class="leave-application-grid">
       <!-- HEADER -->
   
    <!-- LEFT COLUMN (Flexible) -->
    <div class="leave-application-main space-y-4">

        <!-- Top: Equal two columns -->
        <div class="leave-application-calendars">
            <div class="p-1 rounded">
                <LeaveCalendarCard ApplicantJobId="LeaveState.ApplicantJobId" RefreshKey="calendarRefresh" OnChanged="CalendarChanged" OnPlanSelected="UsePlan" />
            </div>

            <div class="p-1 rounded">
                <LeaveCalendarCard ApplicantJobId="LeaveState.ApplicantJobId" MonthOffset="1" RefreshKey="calendarRefresh" OnChanged="CalendarChanged" OnPlanSelected="UsePlan" />
            </div>
        </div>


        <!-- Bottom: Left bigger than right -->
        <div class="leave-application-details">

            <div class="leave-application-form">
                <EditForm Model="LeaveState.Model" OnValidSubmit="Submit" class="w-full">
                    <DataAnnotationsValidator />

                    @if (activeTab == "LeaveInfo")
                    {
                        <DynamicComponent Type="@LeaveState.SelectedFormComponent"
                                          Parameters="@FormParameters" />
                    }
                    else
                    {
                        <p>Test</p>
                    }

                </EditForm>
            </div>

            <div class="leave-application-address">
                <LeaveAddressCard LeaveState="LeaveState" OnAddressSelected="AddressSelected" />
            </div>

        </div>

    </div>


    <!-- RIGHT COLUMN (Fixed 350px) -->
    <div class="leave-application-balances">
        <LeaveBalanceCard LeaveState="LeaveState" RefreshKey="calendarRefresh"
                          OnLeaveTypeSelected="LoadLeaveForm" />
    </div>

</div>
</div>


 








 
@code {
    [Parameter] 
    public LeaveApplicationState LeaveState { get; set; } = default!;

     // ===== TAB CONTROL =====
    private int calendarRefresh;
    private void CalendarChanged() => calendarRefresh++;
    private void UsePlan(LeaveCalendarEntry plan)
    {
        LeaveState.Model.FromDate = plan.From; LeaveState.Model.ToDate = plan.To;
        LeaveState.Model.Duration = (plan.To.Date - plan.From.Date).Days + 1;
    }
    private string activeTab = "LeaveInfo";
    // private int jobId = await HRM.Services.Contracts.UserServiceContracts.GetJobID();

    private Dictionary<string, object> FormParameters => new() { ["LeaveState"] = LeaveState };
    private Task AddressSelected() => InvokeAsync(StateHasChanged);

        protected override async Task OnInitializedAsync()
    {
        if (LeaveState.ApplicantJobId.HasValue)
        {
            var balances = await LeaveService.GetApplicantLeaveBalancesAsync(LeaveState.ApplicantJobId.Value);
            LeaveState.JobLeaveTypes = balances;
            return;
        }
        if (!LeaveStore.JobLeaveTypes.Any())
        {
            await LeaveStore.LoadAsync();
        }

        LeaveState.JobLeaveTypes = LeaveStore.JobLeaveTypes;
        // LeaveState.Reasons = LeaveStore.;
    }


    private async Task LoadLeaveForm()
    {
        // The balance card has already resolved the mapped legacy type and reasons.
        if (LeaveState.Model.JobLeaveTypeId.HasValue)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var selected = LeaveState.JobLeaveTypes
            .FirstOrDefault(x =>
                x.LeaveTypeId == LeaveState.Model.LeaveTypeId);


        if (selected == null)
        {
            LeaveState.SelectedFormComponent =
                typeof(DefaultLeaveForm);

            await InvokeAsync(StateHasChanged);

            return;
        }

        LeaveState.ResolveForm(selected.LeaveTypeName);

        LeaveState.Reasons =
            await LeaveService.GetReasonsByLeaveType(
                LeaveState.Model.LeaveTypeId);


        await InvokeAsync(StateHasChanged);
    }


    // ===== EVENTS =====
     private async Task OnLeaveTypeChanged()
    {
        var selected = LeaveState.JobLeaveTypes.FirstOrDefault(x => x.LeaveTypeId == LeaveState.Model.LeaveTypeId);

        if (selected != null)
        {
            LeaveState.RemainingDays = selected.RemainingDays;
        }

        LeaveState.Reasons = await LeaveService.GetReasonsByLeaveType(LeaveState.Model.LeaveTypeId);

        LeaveState.Model.LeaveReasonId = 0;
      
        await LoadLeaveForm();

        await InvokeAsync(StateHasChanged);
   }


   private async Task ApplyLeaveType(JobLeaveTypeDto leave)
   {
        LeaveState.Model.LeaveTypeId = leave.LeaveTypeId;
        LeaveState.RemainingDays = leave.RemainingDays;
        LeaveState.Reasons = await LeaveService.GetReasonsByLeaveType(leave.LeaveTypeId);
        LeaveState.Model.LeaveReasonId = 0;
        
         await LoadLeaveForm();

        await InvokeAsync(StateHasChanged);
    }

 

    private async Task Submit()
    {
        if (LeaveState.IsSubmitting) return;
        if (!LeaveState.HasReason)
        {
            ToastService.Warning("Select a reason before submitting your leave application.");
            return;
        }

        LeaveState.IsSubmitting = true;

        try
        {
            var result = await LeaveService.SubmitLeave(LeaveState.Model, LeaveState.ApplicantJobId);

            if (!result.Success)
            {
                ToastService.Warning(result.Message);
                return;
            }

            ToastService.Success(result.Message);
            calendarRefresh++;

            // Optional: reset form after successful submission
            // LeaveState.Model = new LeaveApplicationDto();

        }
        catch (Exception ex)
        {
            ToastService.Error("An unexpected error occurred while submitting leave.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            LeaveState.IsSubmitting = false;
        }
    }
}
