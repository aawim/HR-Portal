@using HRM.Components.Shared.Forms
@using HRM.DTOs
@using HRM.Models
@using HRM.Models.Archives
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Services.State

@inject HRM.Application.Contracts.Pages.IEmployeeAddresses AddressService
@inject ToastService ToastService

<div class="bg-white rounded-xl border border-slate-200 shadow-sm">

    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
        <div>
            <h3 class="text-sm font-semibold text-slate-800">
                Leave Addresses
            </h3>

            <p class="text-xs text-slate-500">
                Saved contact locations
            </p>
        </div>
        <button class="w-9 h-9 rounded-lg
                   bg-blue-600 text-white
                   hover:bg-blue-700
                   transition"
                @onclick="OpenDrawer">

            <i class="fas fa-plus"></i>

        </button>

        <i class="fas fa-map-marker-alt text-blue-500"></i>
    </div>

    <div class="p-3">

        @if (isLoading)
        {
            <div class="text-center py-6 text-slate-500">
                Loading addresses...
            </div>
        }
        else if (!Addresses.Any())
        {
            <div class="text-center py-6 text-slate-500">
                No addresses found.
            </div>
        }
        else
        {
            <div class="space-y-3">

                @foreach (var address in Addresses)
                {
                    <button type="button"
                            @onclick="() => SelectAddress(address)"
                            disabled="@selectingAddress"
                            aria-pressed="@(LeaveState.SelectedAddressLocationId == address.LocationId ? "true" : "false")"
                            class="w-full text-left rounded-xl border bg-white
                                p-4 hover:border-blue-300 hover:shadow-md
                                focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500
                                disabled:opacity-50 transition-all duration-200
                                @(LeaveState.SelectedAddressLocationId == address.LocationId ? "border-blue-500 ring-1 ring-blue-500" : "border-slate-200")">

                        <!-- Header -->
                        <div class="flex items-start justify-between">

                            <div class="flex items-center gap-3">

                                <div class="w-10 h-10 rounded-lg bg-blue-50
                                            flex items-center justify-center">

                                    <i class="fas fa-home text-blue-600"></i>

                                </div>

                                <div>

                                    <h4 class="text-sm font-semibold text-slate-800">
                                        @address.Address
                                    </h4>

                                    <p class="text-xs text-slate-500">
                                        @address.LocationType
                                    </p>

                                </div>

                            </div>

                            <div class="flex gap-1">
                                @if (LeaveState.SelectedAddressLocationId == address.LocationId)
                                {
                                    <span class="px-2 py-1 rounded-full bg-blue-100 text-blue-700 text-[11px]">Selected</span>
                                }

                                @if (address.IsCurrent)
                                {
                                    <span class="px-2 py-1 rounded-full
                                                 bg-green-100 text-green-700
                                                 text-[11px]">
                                        Current
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="border-t border-slate-100 my-3"></div>

                        <div class="space-y-2 text-sm">

                            <div class="flex gap-2">
                                <i class="fas fa-map-marker-alt text-slate-400 w-4 mt-1"></i>

                                <span>
                                    @address.Address
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(address.Floor))
                            {
                                <div class="flex gap-2">
                                    <i class="fas fa-building text-slate-400 w-4"></i>

                                    <span>
                                        Floor @address.Floor
                                    </span>
                                </div>
                            }

                            <div class="flex gap-2">
                                <i class="fas fa-location-arrow text-slate-400 w-4"></i>

                                <span>
                                    @address.Island,
                                    @address.Atoll
                                </span>
                            </div>

                            <div class="flex gap-2">
                                <i class="fas fa-globe text-slate-400 w-4"></i>

                                <span>
                                    @address.Country
                                </span>
                            </div>

                            @foreach (var contact in address.Contacts)
                            {
                                <div class="flex gap-2 break-all">
                                    <i class="fas @(contact.ContactInformationTypeId == 4 ? "fa-envelope" : "fa-phone") text-slate-400 w-4" aria-hidden="true"></i>
                                    <span><span class="text-slate-500">@contact.ContactTypeName:</span> @contact.Value</span>
                                </div>
                            }
                            @if (address.Contacts.Count == 0)
                            {
                                <p class="text-xs text-slate-500">No contact details saved.</p>
                            }

                        </div>

                    </button>
                }

            </div>
        }

    </div>

</div>



@if (ShowDrawer)
{
    <div class="fixed inset-0 z-50">

        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/30"
             @onclick="CloseDrawer">
        </div>

        <!-- Drawer -->
        <div class="absolute right-0 top-0 h-full
                    w-full max-w-full sm:w-[420px]
                    bg-white shadow-2xl
                    flex flex-col">

            <div class="flex items-center justify-between
                        px-6 py-4 border-b">

                <div>

                    <h2 class="font-semibold text-lg">
                        New Address
                    </h2>

                    <p class="text-sm text-slate-500">
                        Add a new leave address
                    </p>

                </div>

                <button @onclick="CloseDrawer">

                    <i class="fas fa-times"></i>

                </button>

            </div>

            <div class="flex-1 overflow-y-auto p-6">

                <EditForm Model="Model"
                          OnValidSubmit="SaveAddress">

                    <DataAnnotationsValidator />

                   <AddressForm Model="Model"
                        Countries="Countries"
                        Atolls="Atolls"
                        Islands="Islands"
                        AddressTypes="AddressTypes"
                        AddressBaseTypes="AddressBaseTypes"
                        LocationTypes="LocationTypes"
                        OnAtollChanged="LoadIslands"

                                 OnSave="SaveAddress" />

                </EditForm>

            </div>

        </div>

    </div>
}



@code {
       

        private List<Country> Countries = new();
        private List<Atoll> Atolls = new();
        private List<Island> Islands = new();
        private List<AddressInstanceType> AddressTypes = new();
    private List<AddressBaseType> AddressBaseTypes = new();
        private List<BusinessEntityLocationType> LocationTypes = new();

    

    [Parameter]
    public LeaveApplicationState LeaveState { get; set; } = default!;
    [Parameter] public EventCallback OnAddressSelected { get; set; }
    private bool selectingAddress;

    private List<AddressCardDto> Addresses = new();

    private bool isLoading = true;

    private async Task SelectAddress(AddressCardDto address)
    {
        if (selectingAddress) return;
        selectingAddress = true;
        try
        {
            var islands = address.AtollId.HasValue
                ? await IslandOptions(address.AtollId.Value)
                : new List<Island>();

            LeaveState.Countries = Countries.ToList();
            LeaveState.Atolls = Atolls.ToList();
            LeaveState.Islands = islands;
            LeaveState.Model.CountryId = address.CountryId;
            LeaveState.Model.AtollId = address.AtollId ?? 0;
            LeaveState.Model.IslandId = address.IslandId;
            LeaveState.Model.Country = address.Country;
            LeaveState.Model.Atoll = address.Atoll;
            LeaveState.Model.Island = address.Island;
            LeaveState.Model.Phone = address.Phone;
            LeaveState.Model.ContactEmail = address.Email;
            LeaveState.Model.Address = string.IsNullOrWhiteSpace(address.Floor)
                ? address.Address : $"{address.Address}, Floor {address.Floor}";
            LeaveState.SelectedAddressLocationId = address.LocationId;
            await OnAddressSelected.InvokeAsync();
        }
        finally
        {
            selectingAddress = false;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        var directory = await AddressService.GetDirectoryAsync();
        Countries = directory.Countries.Select(x => new Country { CountryId = x.Id, NameEnglish = x.Name }).ToList();
        Atolls = directory.Atolls.Select(x => new Atoll { AtollId = x.Id, NameEnglish = x.Name }).ToList();
        AddressTypes = directory.InstanceTypes.Select(x => new AddressInstanceType { AddressInstanceTypeId = x.Id, TypeName = x.Name }).ToList();
        LocationTypes = directory.LocationTypes.Select(x => new BusinessEntityLocationType { BusinessEntityLocationTypeId = x.Id, TypeName = x.Name }).ToList();
        AddressBaseTypes = directory.BaseTypes.Select(x => new AddressBaseType { AddressBaseTypeId = x.Id, TypeName = x.Name }).ToList();
        Addresses = await AddressService.GetLeaveAddressesAsync(LeaveState.ApplicantJobId);

        isLoading = false;
    }
    

    private async Task<List<Island>> IslandOptions(int atollId) => (await AddressService.GetDirectoryAsync(atollId)).Islands.Select(x => new Island { IslandId = x.Id, AtollId = atollId, NameEnglish = x.Name }).ToList();
    private async Task LoadIslands(int atollId)
    {
        Islands = await IslandOptions(atollId);

        await InvokeAsync(StateHasChanged);
    }

    private bool ShowDrawer;

    private AddressCreateDto Model = new();

    private void OpenDrawer()
    {
        Model = new AddressCreateDto();
        ShowDrawer = true;
    }

    private void CloseDrawer()
    {
        ShowDrawer = false;
    }

    private async Task SaveAddress()
    {
        var result = await AddressService.CreateAddressAsync(Model, LeaveState.ApplicantJobId);

        if (!result.Success)
        {
            ToastService.Warning(result.Message);
            return;
        }

        ToastService.Success("Address added successfully.");

        Addresses = await AddressService.GetLeaveAddressesAsync(LeaveState.ApplicantJobId);

        ShowDrawer = false;
    }
}
