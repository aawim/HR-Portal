@page "/online/documents"
@namespace HRM.Components.Pages.Online
@using System.IO
@using HRM.Application.Contracts.Positions
@using HRM.DTOs.Documents
@using HRM.Services
@using HRM.Services.Contracts
@using HRM.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer

@inject DocumentManagementServiceContracts.IOperations DmsService
@inject HRM.UI.Services.Positions.IPositionContractApiClient ContractApi
@inject NavigationManager Navigation
@inject IUserAccessService Access
@inject ToastService Toasts
@inject IJSRuntime JS
@inject ILogger<MyDocumentsPortalPage> Logger

<PageTitle>My Documents &amp; Publications - Digital HR</PageTitle>

<div class="mx-auto min-w-7xl max-w-full p-2 flex flex-col gap-2">
    <section class="online-dms-page w-full min-w-0 p-2 space-y-4">
        <!-- Compact, Transparent, Borderless Header (UI_DESIGN_STANDARD §3) -->
        <header class="flex flex-wrap items-center justify-between gap-2 px-1 py-0.5">
            <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 truncate">My Documents, Official Requests &amp; Publications</h1>
                    <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 border border-teal-200/80 px-2 py-0.5 text-[10px] font-semibold text-teal-700">
                        <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                        DHR-DMS Self-Service
                    </span>
                </div>
                <p class="text-xs text-slate-500">Access your authorised personal dossier, submit official letter/certificate requests, sign awaiting documents, and browse organisation policies.</p>
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
                <button type="button"
                        class="app-button app-button-neutral app-button-sm"
                        @onclick="ToggleFullWidth">
                    <AppIcon Name="@(isFullWidth ? "fullscreen_exit" : "fullscreen")" />
                    <span>@(isFullWidth ? "Shrink View" : "Full Width")</span>
                </button>

                <button type="button"
                        class="app-button app-button-secondary app-button-sm"
                        @onclick="LoadPortalDataAsync">
                    <AppIcon Name="arrow-clockwise" />
                    <span>Refresh</span>
                </button>

                <button type="button"
                        class="app-button app-button-secondary app-button-sm"
                        @onclick="OpenUploadModal">
                    <AppIcon Name="bi-upload" />
                    <span>Upload Credential</span>
                </button>

                <button type="button"
                        class="app-button app-button-primary app-button-sm"
                        @onclick="OpenRequestModal">
                    <AppIcon Name="add" />
                    <span>Request Official Document</span>
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">
                <span>@errorMessage</span>
                <button type="button" class="font-bold text-rose-700" @onclick="() => errorMessage = null">✕</button>
            </div>
        }

        <!-- Solid Folder Navigation Tabs -->
        <div class="online-workspace-tabs staff-overview-no-print w-full border-b-2 border-blue-600 dark:border-blue-500 overflow-x-auto">
            <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Document Tabs">
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "my-docs" ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SwitchTab("my-docs")'>
                    <span>My Documents</span>
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "my-docs" ? "bg-white/20 text-white" : "bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300")">
                        @myDocuments.Count
                    </span>
                </button>
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "contracts" ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SwitchTab("contracts")'>
                    <span>Position Contracts</span>
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "contracts" ? "bg-white/20 text-white" : PendingContractActionsCount > 0 ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : "bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300")">
                        @(PendingContractActionsCount > 0 ? $"{PendingContractActionsCount} action" : myPositionContracts.Count.ToString())
                    </span>
                </button>
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "my-requests" ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SwitchTab("my-requests")'>
                    <span>My Certificate &amp; Letter Requests</span>
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "my-requests" ? "bg-white/20 text-white" : "bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300")">
                        @myRequests.Count
                    </span>
                </button>
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "my-issued" ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SwitchTab("my-issued")'>
                    <span>My Issued Official Records</span>
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "my-issued" ? "bg-white/20 text-white" : "bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300")">
                        @MyIssuedDocuments.Count
                    </span>
                </button>
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "awaiting" ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SwitchTab("awaiting")'>
                    <span>Documents Awaiting My Action</span>
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "awaiting" ? "bg-white/20 text-white" : "bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300")">
                        @DocumentsAwaitingMyAction.Count
                    </span>
                </button>
                <button type="button"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(activeTab == "publications" ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")"
                        @onclick='() => SwitchTab("publications")'>
                    <span>Organisation Publications</span>
                    <span class="ml-1.5 rounded-full px-2 py-0.5 text-xs font-bold @(activeTab == "publications" ? "bg-white/20 text-white" : "bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300")">
                        @orgPublications.Count
                    </span>
                </button>
            </nav>
        </div>

        <!-- 2-Panel Grid System -->
        <div class="page-panels @(isFullWidth ? "page-panels-full" : "page-panels-standard")">
            <!-- LEFT PANEL: Request Form, Upload Form, or Selected Document Preview & Metadata -->
            <div class="page-panel-left min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex flex-col gap-3">
                @if (showRequestModal)
                {
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <div>
                            <h2 class="text-sm font-bold text-slate-800 p-1">Request Official Letter or Certificate</h2>
                            <p class="text-xs text-slate-500 px-1">HR will review, approve, and issue your requested document using verified HRM records.</p>
                        </div>
                        <button type="button" class="text-xs text-slate-500 hover:text-slate-800" @onclick="() => showRequestModal = false">✕ Cancel</button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-800 p-1">Official Document Template *</label>
                            <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs"
                                    @bind="requestInput.DocumentTemplateId" @bind:after="OnRequestTemplateChanged">
                                @foreach (var tpl in requestableTemplates)
                                {
                                    <option value="@tpl.DocumentTemplateId">@tpl.Name (v@(tpl.VersionNumber))</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-800 p-1">Addressed To *</label>
                            <input type="text" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs" @bind="requestInput.AddressedTo" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-800 p-1">Purpose of Request *</label>
                        <input type="text"
                               class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs"
                               placeholder="e.g. Bank Housing Loan / Embassy Visa Application / University Admission"
                               @bind="requestInput.Purpose" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-800 p-1">Additional Notes for HR</label>
                        <textarea rows="2" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs" @bind="requestInput.EmployeeNotes"></textarea>
                    </div>

                    <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                        <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700" @onclick="() => showRequestModal = false">Cancel</button>
                        <button type="button" class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700" @onclick="SubmitOfficialRequestAsync">Submit Request to HR</button>
                    </div>
                }
                else if (showUploadModal)
                {
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <div>
                            <h2 class="text-sm font-bold text-slate-800 p-1">Upload Personal Qualification, Certificate or ID Document</h2>
                            <p class="text-xs text-slate-500 px-1">Uploaded files undergo security scanning and are routed to HR for credential verification.</p>
                        </div>
                        <button type="button" class="text-xs text-slate-500 hover:text-slate-800" @onclick="() => showUploadModal = false">✕ Cancel</button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-800 p-1">Document Type *</label>
                            <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs" @bind="uploadInput.DmsDocumentTypeId">
                                @foreach (var dt in employeeUploadableTypes)
                                {
                                    <option value="@dt.DmsDocumentTypeId">@dt.Name (@dt.PermittedExtensions)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-800 p-1">Document Title *</label>
                            <input type="text" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 text-xs" placeholder="e.g. BSc Computer Science Degree" @bind="uploadInput.Title" />
                        </div>
                    </div>

                    <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-3 flex flex-col gap-2">
                        <label class="block text-xs font-bold text-slate-800 p-1">Select File *</label>
                        <InputFile OnChange="HandleEmployeeFileSelected" class="text-xs text-slate-700" />
                    </div>

                    <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                        <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700" @onclick="() => showUploadModal = false">Cancel</button>
                        <button type="button" class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700" @onclick="SubmitEmployeeUploadAsync">Upload Document</button>
                    </div>
                }
                else if (activeTab == "contracts" && selectedContract != null)
                {
                    <!-- SELECTED POSITION CONTRACT WORKFLOW PANEL -->
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3 flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md">@selectedContract.DocumentNumber</span>
                                <span class="rounded-full border px-2.5 py-0.5 text-[11px] font-semibold @ContractStatusBadgeClass(selectedContract.WorkflowStatus)">
                                    @ContractStatusLabel(selectedContract.WorkflowStatus)
                                </span>
                            </div>
                            <h2 class="text-base font-bold text-slate-900 mt-1">@selectedContract.Title</h2>
                            <p class="text-xs text-slate-500">Position: <strong>@selectedContract.PositionName</strong> • v@(selectedContract.CurrentVersionNumber).0 • Uploaded @selectedContract.CreatedAtUtc.AddHours(5).ToString("dd MMM yyyy")</p>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50"
                                    disabled="@loadingContractPreview"
                                    @onclick="() => OpenContractModalAsync(selectedContract)">
                                <i class="bi bi-eye text-xs" aria-hidden="true"></i>
                                <span>View Contract</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                    @onclick="() => DownloadDocAsync(selectedContract.DocumentId)">
                                <i class="bi bi-download text-xs" aria-hidden="true"></i>
                                <span>Download</span>
                            </button>
                        </div>
                    </div>

                    @if (string.Equals(selectedContract.WorkflowStatus, "PendingAcceptance", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="rounded-xl border border-amber-300 bg-amber-50/70 p-4 space-y-3 text-xs">
                            <div class="font-bold text-amber-900">Action Required: Review &amp; Accept Your Position Contract</div>
                            <p class="text-amber-800">
                                Please review the attached contract above. Once you accept it, the contract will be <strong>finalised and locked</strong> so it cannot be changed by HR without your explicit unlock approval.
                            </p>
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"
                                        disabled="@contractActionBusy"
                                        @onclick="() => AcceptContractAsync(selectedContract.DocumentId)">
                                    <i class="bi bi-check2-circle text-xs" aria-hidden="true"></i>
                                    <span>@(contractActionBusy ? "Finalising…" : "Accept & Finalise Contract")</span>
                                </button>
                            </div>
                        </div>
                    }
                    else if (string.Equals(selectedContract.WorkflowStatus, "UnlockRequested", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="rounded-xl border border-orange-300 bg-orange-50/70 p-4 space-y-3 text-xs">
                            <div class="font-bold text-orange-900">HR Requested Permission to Edit Your Finalised Contract</div>
                            <div class="rounded-lg border border-orange-200 bg-white p-3 space-y-1">
                                <div class="text-[11px] text-slate-500">
                                    Requested by <strong>@(selectedContract.UnlockRequestedByName ?? "HR")</strong>@(selectedContract.UnlockRequestedAtUtc.HasValue ? $" on {selectedContract.UnlockRequestedAtUtc.Value.AddHours(5):dd MMM yyyy HH:mm}" : "")
                                </div>
                                <div class="text-xs font-semibold text-slate-900">Reason: @selectedContract.UnlockRequestReason</div>
                            </div>
                            <label class="block text-[11px] font-semibold text-slate-700">
                                Optional Note for HR
                                <input type="text"
                                       maxlength="300"
                                       class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900"
                                       placeholder="Add an optional comment…"
                                       @bind="contractDecisionNote"
                                       @bind:event="oninput" />
                            </label>
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50"
                                        disabled="@contractActionBusy"
                                        @onclick="() => RespondUnlockAsync(selectedContract.DocumentId, true)">
                                    <i class="bi bi-unlock text-xs" aria-hidden="true"></i>
                                    <span>@(contractActionBusy ? "Processing…" : "Unlock for HR Edit")</span>
                                </button>
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-rose-300 bg-white px-3.5 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50 disabled:opacity-50"
                                        disabled="@contractActionBusy"
                                        @onclick="() => RespondUnlockAsync(selectedContract.DocumentId, false)">
                                    <i class="bi bi-lock text-xs" aria-hidden="true"></i>
                                    <span>Decline &amp; Keep Locked</span>
                                </button>
                            </div>
                        </div>
                    }
                    else if (string.Equals(selectedContract.WorkflowStatus, "Finalised", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-4 text-xs text-emerald-900 space-y-1">
                            <div class="font-bold inline-flex items-center gap-1.5">
                                <i class="bi bi-shield-lock-fill text-emerald-600" aria-hidden="true"></i>
                                <span>Finalised &amp; Locked</span>
                            </div>
                            <p class="text-emerald-800">
                                Accepted by <strong>@(selectedContract.AcceptedByName ?? "You")</strong>@(selectedContract.AcceptedAtUtc.HasValue ? $" on {selectedContract.AcceptedAtUtc.Value.AddHours(5):dd MMM yyyy HH:mm}" : ""). HR cannot change this contract without sending you an unlock request.
                            </p>
                        </div>
                    }
                    else if (string.Equals(selectedContract.WorkflowStatus, "UnlockedForEdit", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-4 text-xs text-blue-900 space-y-1">
                            <div class="font-bold inline-flex items-center gap-1.5">
                                <i class="bi bi-unlock-fill text-blue-600" aria-hidden="true"></i>
                                <span>Unlocked for HR Revision</span>
                            </div>
                            <p class="text-blue-800">
                                You unlocked this contract@(selectedContract.UnlockedAtUtc.HasValue ? $" on {selectedContract.UnlockedAtUtc.Value.AddHours(5):dd MMM yyyy HH:mm}" : ""). Once HR attaches the updated contract, it will appear here for your acceptance.
                            </p>
                        </div>
                    }
                    else if (string.Equals(selectedContract.WorkflowStatus, "Superseded", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-700">
                            This contract version has been superseded by a newer revision.
                        </div>
                    }
                }
                else if (selectedDetail != null)
                {
                    <!-- SELECTED DOCUMENT DETAIL & PREVIEW -->
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3 flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md">@selectedDetail.Summary.DocumentNumber</span>
                                <span class="rounded-full bg-emerald-100 text-emerald-800 px-2.5 py-0.5 text-[11px] font-semibold">@selectedDetail.Summary.Status</span>
                                @if (selectedDetail.Summary.IsVerified)
                                {
                                    <span class="rounded-full bg-blue-50 text-blue-700 px-2 py-0.5 text-[11px] font-semibold">✓ HR Verified</span>
                                }
                            </div>
                            <h2 class="text-base font-bold text-slate-900 mt-1">@selectedDetail.Summary.Title</h2>
                            <p class="text-xs text-slate-500">@selectedDetail.Summary.CategoryName • @selectedDetail.Summary.DocumentTypeName • v@(selectedDetail.Summary.CurrentVersionNumber).0</p>
                        </div>

                        <div class="flex items-center gap-2">
                            @if (selectedDetail.EffectivePermissions.CanPreview)
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                        @onclick="() => PreviewDocAsync(selectedDetail.Summary.DocumentId)">
                                    👁 Preview
                                </button>
                            }
                            @if (selectedDetail.EffectivePermissions.CanDownload)
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700"
                                        @onclick="() => DownloadDocAsync(selectedDetail.Summary.DocumentId)">
                                    ⬇ Download
                                </button>
                            }
                            @if (selectedDetail.EffectivePermissions.CanSign && selectedDetail.Signatures.All(s => s.SignerUserId != currentUserId))
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700"
                                        @onclick="AcknowledgeAndSignDocumentAsync">
                                    ✍ Acknowledge &amp; Sign
                                </button>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(previewDataUrl))
                    {
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-slate-800">Preview: @selectedDetail.Summary.CurrentFileName</span>
                                <button type="button" class="text-xs text-slate-500 hover:text-slate-900" @onclick="() => previewDataUrl = null">✕ Close</button>
                            </div>
                            @if (selectedDetail.Summary.CurrentContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                            {
                                <img src="@previewDataUrl" alt="Document preview" class="max-h-96 mx-auto rounded-lg border border-slate-200" />
                            }
                            else if (selectedDetail.Summary.CurrentContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <iframe src="@previewDataUrl" class="w-full h-96 rounded-lg border border-slate-200 bg-white"></iframe>
                            }
                        </div>
                    }

                    <!-- Version History Table -->
                    <div class="space-y-1.5">
                        <h3 class="text-xs font-bold text-slate-800 p-1">Version History (@selectedDetail.Versions.Count)</h3>
                        <div class="overflow-x-auto rounded-xl border border-slate-200">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                                    <tr>
                                        <th class="p-2.5">Version</th>
                                        <th class="p-2.5">File</th>
                                        <th class="p-2.5">SHA-256</th>
                                        <th class="p-2.5">Date</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var v in selectedDetail.Versions)
                                    {
                                        <tr class="hover:bg-slate-50/50">
                                            <td class="p-2.5 font-mono font-semibold text-blue-700">@v.VersionLabel</td>
                                            <td class="p-2.5 text-slate-800">@v.OriginalFileName</td>
                                            <td class="p-2.5 font-mono text-[11px] text-slate-500">@v.Sha256Hash[..Math.Min(14, v.Sha256Hash.Length)]...</td>
                                            <td class="p-2.5 text-slate-500">@v.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-xs text-slate-500">
                        Select a document or request from the right panel to preview, download, or inspect version history.
                    </div>
                }
            </div>

            <!-- RIGHT PANEL: List of Documents or Requests for Active Tab -->
            <aside class="page-panel-right min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex flex-col gap-3">
                @if (activeTab == "contracts")
                {
                    <h3 class="text-xs font-bold text-slate-800 p-1">My Position Contracts (@myPositionContracts.Count)</h3>
                    @if (myPositionContracts.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                            No position contracts have been attached to your positions yet.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2 max-h-[600px] overflow-y-auto pr-1">
                            @foreach (var c in myPositionContracts)
                            {
                                var isSel = selectedContract?.DocumentId == c.DocumentId;
                                <div class="rounded-xl border p-2.5 text-xs transition cursor-pointer hover:shadow-xs flex flex-col gap-1 @(isSel ? "border-blue-500 bg-blue-50/70 ring-1 ring-blue-500" : "border-slate-200 bg-white hover:border-slate-300")"
                                     @onclick="() => SelectContract(c)">
                                    <div class="flex items-center justify-between gap-1.5 flex-wrap">
                                        <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md">@c.DocumentNumber</span>
                                        <span class="rounded-full border px-2 py-0.5 text-[10px] font-semibold @ContractStatusBadgeClass(c.WorkflowStatus)">
                                            @ContractStatusLabel(c.WorkflowStatus)
                                        </span>
                                    </div>
                                    <div class="font-bold text-slate-900 mt-0.5">@c.Title</div>
                                    <div class="text-[11px] text-slate-500">@c.PositionName • v@(c.CurrentVersionNumber).0 • @c.CreatedAtUtc.AddHours(5).ToString("dd MMM yyyy")</div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (activeTab == "my-requests")
                {
                    <h3 class="text-xs font-bold text-slate-800 p-1">My Official Document Requests (@myRequests.Count)</h3>
                    @if (myRequests.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                            You have not submitted any official document requests yet.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var req in myRequests)
                            {
                                <div class="rounded-xl border border-slate-200 bg-white p-3 text-xs space-y-1.5">
                                    <div class="flex items-center justify-between">
                                        <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md">@req.ReferenceNumber</span>
                                        <span class="rounded-full bg-amber-100 text-amber-800 px-2.5 py-0.5 text-[11px] font-semibold">@req.Status</span>
                                    </div>
                                    <div class="font-bold text-slate-900">@req.RequestKind</div>
                                    <div class="text-slate-600">Purpose: @req.Purpose • Addressed to: @req.AddressedTo</div>
                                    @if (req.IssuedDocumentId.HasValue)
                                    {
                                        <button type="button"
                                                class="mt-1 inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-semibold text-white hover:bg-emerald-700"
                                                @onclick="() => SelectDocAsync(req.IssuedDocumentId.Value)">
                                            View &amp; Download Issued PDF (@req.IssuedDocumentNumber)
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    var currentList = GetCurrentDocumentList();
                    <h3 class="text-xs font-bold text-slate-800 p-1">Documents (@currentList.Count)</h3>
                    @if (currentList.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
                            No documents available in this view.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2 max-h-[600px] overflow-y-auto pr-1">
                            @foreach (var doc in currentList)
                            {
                                var isSel = selectedDetail?.Summary.DocumentId == doc.DocumentId;
                                <div class="rounded-xl border p-2.5 text-xs transition cursor-pointer hover:shadow-xs flex flex-col gap-1 @(isSel ? "border-blue-500 bg-blue-50/70 ring-1 ring-blue-500" : "border-slate-200 bg-white hover:border-slate-300")"
                                     @onclick="() => SelectDocAsync(doc.DocumentId)">
                                    <div class="flex items-center justify-between">
                                        <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md">@doc.DocumentNumber</span>
                                        <span class="rounded-full bg-slate-100 text-slate-700 px-2 py-0.5 text-[11px] font-medium">@doc.CategoryName</span>
                                    </div>
                                    <div class="font-bold text-slate-900 mt-0.5">@doc.Title</div>
                                    <div class="text-[11px] text-slate-500">@doc.DocumentTypeName • v@(doc.CurrentVersionNumber).0 • @doc.CreatedAtUtc.ToString("dd MMM yyyy")</div>
                                </div>
                            }
                        </div>
                    }
                }
            </aside>
        </div>
    </section>

    @if (modalContract != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-2 sm:p-3"
             role="dialog"
             aria-modal="true"
             aria-label="Position contract preview"
             @onclick="CloseContractModal">
            <div class="my-contract-preview-modal w-full max-w-6xl rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden flex flex-col"
                 @onclick:stopPropagation="true">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50/90 px-4 py-2.5 shrink-0">
                    <div class="min-w-0">
                        <h4 class="text-sm font-bold text-slate-900 truncate">@modalContract.Title</h4>
                        <p class="text-[11px] text-slate-500 font-mono">
                            @modalContract.DocumentNumber · @modalContract.PositionName · v@(modalContract.CurrentVersionNumber).0@(string.IsNullOrWhiteSpace(modalFileName) ? "" : $" · {modalFileName}")
                        </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        @if (!loadingContractPreview && string.IsNullOrWhiteSpace(modalPreviewError) && (IsModalPdf || IsModalImage))
                        {
                            <div class="inline-flex items-center rounded-lg border border-slate-300 bg-white overflow-hidden">
                                <button type="button" class="px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100 disabled:opacity-40" title="Zoom out" disabled="@(modalZoom <= 50)" @onclick="ModalZoomOut">
                                    <i class="bi bi-zoom-out" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="px-2 py-1 text-[11px] font-mono font-semibold text-slate-700 border-x border-slate-200 hover:bg-slate-100" title="Reset zoom" @onclick="ModalResetZoom">
                                    @modalZoom%
                                </button>
                                <button type="button" class="px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100 disabled:opacity-40" title="Zoom in" disabled="@(modalZoom >= 250)" @onclick="ModalZoomIn">
                                    <i class="bi bi-zoom-in" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                        <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" @onclick="() => DownloadDocAsync(modalContract.DocumentId)">
                            <i class="bi bi-download text-xs" aria-hidden="true"></i> Download
                        </button>
                        <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" @onclick="CloseContractModal">
                            Close
                        </button>
                    </div>
                </div>
                <div class="my-contract-preview-body p-3 overflow-auto flex-1 bg-slate-100/70">
                    @if (loadingContractPreview)
                    {
                        <div class="flex items-center justify-center gap-2 py-16 text-xs text-slate-500">
                            <span class="h-4 w-4 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
                            <span>Loading contract preview…</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(modalPreviewError))
                    {
                        <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-800">@modalPreviewError</div>
                    }
                    else if (IsModalPdf && !string.IsNullOrWhiteSpace(modalPreviewDataUrl))
                    {
                        <div class="my-contract-preview-stage" style="width: @(modalZoom)%; height: @(Math.Max(100, modalZoom))%;">
                            <iframe @key="@($"my-pdf-{modalContract.DocumentId}-{modalZoom}")"
                                    src="@($"{modalPreviewDataUrl}#zoom={modalZoom}")"
                                    title="@modalContract.Title"
                                    class="w-full h-full rounded-lg border border-slate-200 bg-white"></iframe>
                        </div>
                    }
                    else if (IsModalImage && !string.IsNullOrWhiteSpace(modalPreviewDataUrl))
                    {
                        <div class="flex justify-center">
                            <img src="@modalPreviewDataUrl" alt="@modalContract.Title" style="width: @(modalZoom)%; max-width: none;" class="rounded-lg border border-slate-200 shadow-sm bg-white" />
                        </div>
                    }
                    else
                    {
                        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-xs text-slate-600 space-y-3">
                            <p class="font-semibold text-slate-800">Inline preview is not available for this file format (@modalContentType).</p>
                            <button type="button" class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700" @onclick="() => DownloadDocAsync(modalContract.DocumentId)">Download File</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .my-contract-preview-modal {
        height: calc(100vh - 1.5rem);
        max-height: calc(100vh - 1.5rem);
    }

    .my-contract-preview-body {
        min-height: 0;
    }

    .my-contract-preview-stage {
        min-width: 100%;
        min-height: 100%;
    }
</style>

@code {
    private const string FullWidthStorageKey = "hrm.online-dms.full-width";
    private bool isFullWidth;
    private string activeTab = "my-docs";
    private string? errorMessage;
    private int currentIndividualId;
    private int currentUserId;

    private List<DmsDocumentSummaryDto> myDocuments = [];
    private List<PositionContractDto> myPositionContracts = [];
    private List<DmsDocumentSummaryDto> orgPublications = [];
    private List<DmsDocumentRequestDto> myRequests = [];
    private List<DmsDocumentTemplateDto> requestableTemplates = [];
    private List<DmsDocumentTypeDto> employeeUploadableTypes = [];

    private DmsDocumentDetailDto? selectedDetail;
    private PositionContractDto? selectedContract;
    private PositionContractDto? modalContract;
    private string? previewDataUrl;
    private string? modalPreviewDataUrl, modalContentType, modalFileName, modalPreviewError;
    private int modalZoom = 100;
    private bool loadingContractPreview;
    private bool contractActionBusy;
    private string contractDecisionNote = "";

    private int PendingContractActionsCount =>
        myPositionContracts.Count(c =>
            string.Equals(c.WorkflowStatus, "PendingAcceptance", StringComparison.OrdinalIgnoreCase)
            || string.Equals(c.WorkflowStatus, "UnlockRequested", StringComparison.OrdinalIgnoreCase));

    private bool IsModalPdf =>
        string.Equals(modalContentType, "application/pdf", StringComparison.OrdinalIgnoreCase)
        || (modalFileName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true);

    private bool IsModalImage =>
        modalContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    private bool showRequestModal;
    private bool showUploadModal;
    private DmsDocumentRequestSubmitInput requestInput = new();
    private DmsDocumentUploadInput uploadInput = new();

    private List<DmsDocumentSummaryDto> MyIssuedDocuments =>
        myDocuments.Where(d => d.IsOfficialRecord || d.Status is "OfficialRecord" or "Published").ToList();

    private List<DmsDocumentSummaryDto> DocumentsAwaitingMyAction =>
        myDocuments.Where(d => d.Status is "Draft" or "PendingVerification" || (!d.IsOfficialRecord && d.SignaturesCount == 0)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var part in query)
            {
                var kv = part.Split('=', 2);
                if (kv.Length == 2 && string.Equals(kv[0], "tab", StringComparison.OrdinalIgnoreCase))
                {
                    var tabVal = Uri.UnescapeDataString(kv[1]).Trim().ToLowerInvariant();
                    if (tabVal is "contracts" or "my-docs" or "my-requests" or "my-issued" or "awaiting" or "publications")
                    {
                        activeTab = tabVal;
                    }
                }
            }
        }

        var ctx = await Access.GetContextAsync();
        currentIndividualId = ctx?.IndividualId ?? 0;
        currentUserId = ctx?.UserId ?? 0;
        await LoadPortalDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", FullWidthStorageKey);
                if (bool.TryParse(saved, out var parsed) && parsed != isFullWidth)
                {
                    isFullWidth = parsed;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleFullWidth()
    {
        isFullWidth = !isFullWidth;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", FullWidthStorageKey, isFullWidth.ToString().ToLowerInvariant());
        }
        catch { }
    }

    private async Task LoadPortalDataAsync()
    {
        try
        {
            errorMessage = null;
            if (currentIndividualId > 0)
            {
                myDocuments = await DmsService.GetStaffDocumentsAsync(currentIndividualId);
            }
            try
            {
                myPositionContracts = await ContractApi.GetMyContractsAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error loading position contracts for employee.");
            }
            if (selectedContract != null)
            {
                selectedContract = myPositionContracts.FirstOrDefault(c => c.DocumentId == selectedContract.DocumentId)
                    ?? myPositionContracts.FirstOrDefault();
            }
            else if (myPositionContracts.Count > 0)
            {
                selectedContract = myPositionContracts.FirstOrDefault(c =>
                        string.Equals(c.WorkflowStatus, "PendingAcceptance", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(c.WorkflowStatus, "UnlockRequested", StringComparison.OrdinalIgnoreCase))
                    ?? myPositionContracts[0];
            }
            orgPublications = await DmsService.GetOrganisationLibraryAsync();
            myRequests = await DmsService.GetMyDocumentRequestsAsync();
            var allTemplates = await DmsService.GetTemplatesAsync();
            requestableTemplates = allTemplates.Where(t => t.IsEmployeeRequestable).ToList();
            var allTypes = await DmsService.GetDocumentTypesAsync();
            employeeUploadableTypes = allTypes.Where(t => t.AllowEmployeeUpload && t.IsActive).ToList();

            var list = GetCurrentDocumentList();
            if (selectedDetail == null && list.Count > 0)
            {
                selectedDetail = await DmsService.GetDocumentDetailAsync(list[0].DocumentId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employee DMS portal.");
            errorMessage = ex.Message;
        }
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        showRequestModal = false;
        showUploadModal = false;
        previewDataUrl = null;
        if (tab == "contracts" && selectedContract == null && myPositionContracts.Count > 0)
        {
            selectedContract = myPositionContracts.FirstOrDefault(c =>
                    string.Equals(c.WorkflowStatus, "PendingAcceptance", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(c.WorkflowStatus, "UnlockRequested", StringComparison.OrdinalIgnoreCase))
                ?? myPositionContracts[0];
        }
    }

    private void SelectContract(PositionContractDto contract)
    {
        showRequestModal = false;
        showUploadModal = false;
        selectedContract = contract;
        contractDecisionNote = "";
    }

    private async Task AcceptContractAsync(long documentId)
    {
        if (contractActionBusy) return;
        contractActionBusy = true;
        errorMessage = null;
        try
        {
            var res = await ContractApi.AcceptAsync(documentId);
            if (res.Success)
            {
                Toasts.Success(res.Message);
                await LoadPortalDataAsync();
            }
            else
            {
                errorMessage = res.Message;
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error accepting position contract {DocumentId}", documentId);
            errorMessage = "Could not finalise contract. Please try again.";
        }
        finally
        {
            contractActionBusy = false;
        }
    }

    private async Task RespondUnlockAsync(long documentId, bool approve)
    {
        if (contractActionBusy) return;
        contractActionBusy = true;
        errorMessage = null;
        try
        {
            var res = await ContractApi.RespondUnlockAsync(new RespondContractUnlockInput(documentId, approve, string.IsNullOrWhiteSpace(contractDecisionNote) ? null : contractDecisionNote.Trim()));
            if (res.Success)
            {
                Toasts.Success(res.Message);
                contractDecisionNote = "";
                await LoadPortalDataAsync();
            }
            else
            {
                errorMessage = res.Message;
                Toasts.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error responding to contract unlock {DocumentId}", documentId);
            errorMessage = "Could not process unlock response. Please try again.";
        }
        finally
        {
            contractActionBusy = false;
        }
    }

    private async Task OpenContractModalAsync(PositionContractDto contract)
    {
        modalContract = contract;
        modalPreviewDataUrl = null;
        modalContentType = null;
        modalFileName = null;
        modalPreviewError = null;
        modalZoom = 100;
        loadingContractPreview = true;
        try
        {
            var dl = await DmsService.DownloadDocumentVersionAsync(contract.DocumentId, null, isPreview: true);
            if (!dl.Success)
            {
                modalPreviewError = dl.ErrorMessage ?? "Contract preview could not be loaded.";
                return;
            }
            modalFileName = dl.FileName;
            modalContentType = string.IsNullOrWhiteSpace(dl.ContentType) ? "application/octet-stream" : dl.ContentType;
            if (dl.Content.Length > 0)
            {
                modalPreviewDataUrl = $"data:{modalContentType};base64,{Convert.ToBase64String(dl.Content)}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Previewing contract {DocumentId}", contract.DocumentId);
            modalPreviewError = "Contract preview could not be loaded. Try downloading instead.";
        }
        finally
        {
            loadingContractPreview = false;
        }
    }

    private void ModalZoomIn() => modalZoom = Math.Min(250, modalZoom + 25);
    private void ModalZoomOut() => modalZoom = Math.Max(50, modalZoom - 25);
    private void ModalResetZoom() => modalZoom = 100;

    private void CloseContractModal()
    {
        modalContract = null;
        modalPreviewDataUrl = null;
        modalContentType = null;
        modalFileName = null;
        modalPreviewError = null;
        modalZoom = 100;
        loadingContractPreview = false;
    }

    private static string ContractStatusLabel(string status) => status switch
    {
        "PendingAcceptance" => "Awaiting Your Acceptance",
        "Finalised" => "Finalised & Locked",
        "UnlockRequested" => "HR Unlock Requested",
        "UnlockedForEdit" => "Unlocked for HR Edit",
        "Superseded" => "Superseded",
        _ => status
    };

    private static string ContractStatusBadgeClass(string status) => status switch
    {
        "PendingAcceptance" => "bg-amber-50 text-amber-800 border-amber-200",
        "Finalised" => "bg-emerald-50 text-emerald-800 border-emerald-200",
        "UnlockRequested" => "bg-orange-50 text-orange-800 border-orange-200",
        "UnlockedForEdit" => "bg-blue-50 text-blue-800 border-blue-200",
        "Superseded" => "bg-slate-100 text-slate-600 border-slate-200",
        _ => "bg-slate-100 text-slate-700 border-slate-200"
    };

    private List<DmsDocumentSummaryDto> GetCurrentDocumentList() => activeTab switch
    {
        "my-issued" => MyIssuedDocuments,
        "awaiting" => DocumentsAwaitingMyAction,
        "publications" => orgPublications,
        _ => myDocuments
    };

    private async Task SelectDocAsync(long documentId)
    {
        showRequestModal = false;
        showUploadModal = false;
        previewDataUrl = null;
        selectedDetail = await DmsService.GetDocumentDetailAsync(documentId);
    }

    private void OpenRequestModal()
    {
        showUploadModal = false;
        requestInput = new DmsDocumentRequestSubmitInput
        {
            AddressedTo = "To Whom It May Concern",
            RequestKind = "EmploymentVerificationLetter"
        };
        if (requestableTemplates.Count > 0)
        {
            requestInput.DocumentTemplateId = requestableTemplates[0].DocumentTemplateId;
            requestInput.DmsDocumentTypeId = requestableTemplates[0].DmsDocumentTypeId;
            requestInput.RequestKind = requestableTemplates[0].Name;
        }
        showRequestModal = true;
    }

    private void OnRequestTemplateChanged()
    {
        var tpl = requestableTemplates.FirstOrDefault(t => t.DocumentTemplateId == requestInput.DocumentTemplateId);
        if (tpl != null)
        {
            requestInput.DmsDocumentTypeId = tpl.DmsDocumentTypeId;
            requestInput.RequestKind = tpl.Name;
        }
    }

    private async Task SubmitOfficialRequestAsync()
    {
        var res = await DmsService.SubmitDocumentRequestAsync(requestInput);
        if (res.Success)
        {
            Toasts.Success(res.Message);
            showRequestModal = false;
            activeTab = "my-requests";
            await LoadPortalDataAsync();
        }
        else errorMessage = res.Message;
    }

    private void OpenUploadModal()
    {
        showRequestModal = false;
        uploadInput = new DmsDocumentUploadInput
        {
            SubjectIndividualId = currentIndividualId,
            DmsDocumentTypeId = employeeUploadableTypes.FirstOrDefault()?.DmsDocumentTypeId ?? 0
        };
        showUploadModal = true;
    }

    private async Task HandleEmployeeFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
        uploadInput.FileName = file.Name;
        uploadInput.ContentType = file.ContentType;
        uploadInput.FileContent = ms.ToArray();
        if (string.IsNullOrWhiteSpace(uploadInput.Title))
        {
            uploadInput.Title = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    private async Task SubmitEmployeeUploadAsync()
    {
        var res = await DmsService.UploadDocumentAsync(uploadInput);
        if (res.Success)
        {
            Toasts.Success(res.Message);
            showUploadModal = false;
            activeTab = "my-docs";
            await LoadPortalDataAsync();
        }
        else errorMessage = res.Message;
    }

    private async Task PreviewDocAsync(long documentId)
    {
        var dl = await DmsService.DownloadDocumentVersionAsync(documentId, null, isPreview: true);
        if (dl.Success)
        {
            previewDataUrl = $"data:{dl.ContentType};base64,{Convert.ToBase64String(dl.Content)}";
        }
        else errorMessage = dl.ErrorMessage;
    }

    private async Task DownloadDocAsync(long documentId)
    {
        var dl = await DmsService.DownloadDocumentVersionAsync(documentId, null, isPreview: false);
        if (!dl.Success)
        {
            errorMessage = dl.ErrorMessage;
            return;
        }
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
        using var stream = new MemoryStream(dl.Content);
        using var reference = new DotNetStreamReference(stream);
        await module.InvokeVoidAsync("download", dl.FileName, dl.ContentType, reference);
    }

    private async Task AcknowledgeAndSignDocumentAsync()
    {
        if (selectedDetail is null) return;
        var res = await DmsService.ExecuteLifecycleActionAsync(new DmsDocumentLifecycleActionInput
        {
            DocumentId = selectedDetail.Summary.DocumentId,
            Action = "Sign",
            SignatureRole = "EmployeeAcknowledgement",
            Comments = "Acknowledged and digitally signed by employee."
        });
        if (res.Success)
        {
            Toasts.Success(res.Message);
            await SelectDocAsync(selectedDetail.Summary.DocumentId);
        }
        else errorMessage = res.Message;
    }
}
