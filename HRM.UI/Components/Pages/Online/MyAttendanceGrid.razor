@* @page "/admin/attendance/manage-attendance/my-attendance" *@
@page "/online/attendance/my-attendance"
@page "/online/attendance/my-attendance/{TabSection}"
@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Components.Shared
@inject NavigationManager Navigation

@rendermode RenderMode.InteractiveServer

@inject HRM.Services.Interfaces.IMyAttendanceSupportService AttendanceSupport
@inject HRM.Services.Contracts.AttendanceLogServiceContracts.IOperations AttendanceLogService
@inject IIndividual _individual
@inject IAttendanceService AttendanceService


<div class="mx-auto min-w-7xl max-w-full p-2 flex flex-col gap-2">
    <!-- Full-Width Sticky Header Matching Admin Workspace Standard -->
    <header class="sticky top-0 z-30 m-0 border-b border-slate-200 bg-white/95 backdrop-blur-xs px-3 py-3 shadow-xs rounded-2xl flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2">
                <a href="/online/attendance" class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors">
                    <AppIcon Name="arrow_back" Class="w-3.5 h-3.5" />
                    <span>Attendance Hub</span>
                </a>
                <span class="text-slate-300">/</span>
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">Employee Attendance</span>
            </div>
            <h1 class="text-lg font-bold text-slate-900 truncate mt-0.5">My Attendance</h1>
            <p class="text-xs text-slate-500 mt-0.5">Review your personal attendance logs, history, and metrics.</p>
        </div>

        <!-- Filter Controls - Clean Inline Toolbar (Panel Removed) -->
        <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs shadow-2xs">
                <input type="date" @bind="startDate" class="text-xs text-slate-700 bg-transparent focus:outline-none" />
                <span class="text-slate-400 px-1.5 text-xs font-medium">to</span>
                <input type="date" @bind="endDate" class="text-xs text-slate-700 bg-transparent focus:outline-none" />
            </div>
            <button type="button" @onclick="() => SearchCustomPeriod()" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white shadow-2xs hover:bg-blue-700 transition-colors">
                <AppIcon Name="search" Class="w-3.5 h-3.5" />
                <span>Search</span>
            </button>
            <button type="button" @onclick="ResetToCurrentPeriod" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 transition-colors">
                <span>Reset</span>
            </button>
            <AttendanceExportButtons CreateReport="BuildExport" Disabled="@(isLoading || !exportReady)" />
        </div>
    </header>

    <!-- Solid Folder Navigation Tabs (Matching Admin Workspace with Online Portal Blue) -->
    <div class="online-workspace-tabs staff-overview-no-print w-full border-b-2 border-blue-600 dark:border-blue-500 overflow-x-auto">
        <nav class="flex items-end gap-1 min-w-max pb-0" aria-label="Attendance Tabs">
            @foreach (var tab in Tabs)
            {
                var isTabActive = activeTab == tab;
                <button type="button"
                        @onclick="() => SetActiveTab(tab)"
                        class="rounded-t-xl px-4 py-2 font-bold text-xs md:text-sm transition-all border-t border-l border-r @(isTabActive ? "bg-blue-600 dark:bg-blue-600 text-white border-blue-600 dark:border-blue-500 shadow-sm" : "bg-blue-50/70 text-slate-700 hover:text-slate-900 hover:bg-blue-100/70 dark:bg-slate-800/90 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700 border-slate-300 dark:border-slate-700")">
                    <span>@tab</span>
                </button>
            }
        </nav>
    </div>

    <!-- Tab Content Area -->
    <div class="w-full flex flex-col gap-2 p-1">
        <div class="animate-in fade-in duration-300">
            @switch (activeTab)
            {
                case "Attendance":
                    <div class="flex flex-col gap-3">
                        <!-- Restyled Executive Bar Chart Card -->
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs flex flex-col gap-3">
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2">
                                <div>
                                    <h3 class="text-sm font-bold text-slate-800">Period Attendance Breakdown</h3>
                                    <p class="text-xs text-slate-500">Summary metrics for period: @startDate.ToString("dd MMM yyyy") – @endDate.ToString("dd MMM yyyy")</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center gap-1 rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 border border-blue-200">
                                        Total Required: @dailyRecords.Count(r => r.RequiresAttendance) days
                                    </span>
                                </div>
                            </div>

                            <!-- Bar Chart -->
                            <div class="w-full pt-2 pb-1">
                                <div class="h-40 w-full flex items-end justify-around gap-2 sm:gap-4 md:gap-8 px-2 border-b border-slate-200">
                                    @foreach (var stat in attendanceStats)
                                    {
                                        int heightPercentage = Math.Clamp(stat.Percentage, 0, 100);
                                        var barColor = stat.Label switch
                                        {
                                            "To Attend" => "bg-slate-400 hover:bg-slate-500",
                                            "Absent" => "bg-rose-500 hover:bg-rose-600",
                                            "Attended late" => "bg-amber-500 hover:bg-amber-600",
                                            "Perfectly attended" => "bg-emerald-500 hover:bg-emerald-600",
                                            "Attended" => "bg-blue-600 hover:bg-blue-700",
                                            "Leaves" => "bg-sky-400 hover:bg-sky-500",
                                            _ => stat.ColorClass
                                        };

                                        <div class="relative flex flex-col items-center flex-1 max-w-[90px] h-full justify-end group">
                                            <!-- Value on top of bar -->
                                            <div class="mb-1 text-center">
                                                <span class="text-xs font-bold text-slate-700">@stat.Days</span>
                                                <span class="text-[10px] text-slate-400 block font-medium">@stat.Percentage%</span>
                                            </div>

                                            <!-- Track & Bar -->
                                            <div class="w-full h-24 bg-slate-100 rounded-t-lg overflow-hidden flex flex-col justify-end p-0.5">
                                                <div class="w-full @barColor rounded-t-md transition-all duration-500 ease-out shadow-xs min-h-[4px]"
                                                     style="height: @(Math.Max(4, heightPercentage))%"
                                                     title="@stat.Label: @stat.Days Days (@stat.Percentage%)">
                                                </div>
                                            </div>

                                            <!-- Label below baseline -->
                                            <div class="mt-2 text-center">
                                                <span class="text-xs font-semibold text-slate-600 truncate block max-w-full" title="@stat.Label">@stat.Label</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Compact Attendance Logs Table with p-2 padding -->
                        <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-xs bg-white">
                            <table class="w-full text-left border-collapse whitespace-nowrap text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 text-[11px] uppercase tracking-wider font-bold">
                                        <th class="p-2 text-center">#</th>
                                        <th class="p-2">Date</th>
                                        <th class="p-2">Day</th>
                                        <th class="p-2">Clock In</th>
                                        <th class="p-2">Break Out</th>
                                        <th class="p-2">Break In</th>
                                        <th class="p-2">Clock Out</th>
                                        <th class="p-2">Status</th>
                                        <th class="p-2">Details</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @if (isLoading)
                                    {
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <tr class="animate-pulse hover:bg-slate-50/70 transition-colors">
                                                <td class="p-2 text-center"><div class="h-3 bg-slate-200 rounded w-4 mx-auto"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-24"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-16"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-12"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-12"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-12"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-12"></div></td>
                                                <td class="p-2"><div class="h-5 bg-slate-200 rounded w-16"></div></td>
                                                <td class="p-2"><div class="h-3 bg-slate-200 rounded w-full max-w-[100px]"></div></td>
                                            </tr>
                                        }
                                    }
                                    else if (dailyRecords != null && dailyRecords.Any())
                                    {
                                        int index = 1;
                                        @foreach (var record in dailyRecords)
                                        {
                                            <tr class="hover:bg-slate-50/70 transition-colors text-xs text-slate-700">
                                                <td class="p-2 text-center text-slate-400 text-xs">@index</td>
                                                <td class="p-2 font-medium">@record.Date.ToString("dd MMM yyyy")</td>
                                                <td class="p-2 text-slate-500">@record.Date.ToString("dddd")</td>

                                                <td class="p-2 font-semibold @(record.ClockIn == "--:--" ? "text-slate-300" : "text-emerald-600")">@record.ClockIn</td>
                                                <td class="p-2 text-amber-600">@record.BreakOut</td>
                                                <td class="p-2 text-amber-600">@record.BreakIn</td>
                                                <td class="p-2 font-semibold @(record.ClockOut == "--:--" ? "text-slate-300" : "text-rose-600")">@record.ClockOut</td>

                                                <td class="p-2">
                                                    @{
                                                        string statusBg = record.IsLate && record.IsPresent ? "bg-amber-50 text-amber-800 border-amber-200" : record.IsPresent ? "bg-emerald-50 text-emerald-700 border-emerald-200" :
                                                        record.Status == "Absent" ? "bg-rose-50 text-rose-700 border-rose-200" :
                                                        record.Status == "Weekend" ? "bg-slate-100 text-slate-500 border-slate-200" :
                                                        "bg-blue-50 text-blue-700 border-blue-200";
                                                    }
                                                    <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-semibold border @statusBg">
                                                        @record.Status
                                                    </span>
                                                </td>

                                                <td class="p-2 text-xs text-slate-500 truncate max-w-[150px]" title="@record.Details">
                                                    @(string.IsNullOrEmpty(record.Details) ? "-" : record.Details)
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="p-6 text-center text-slate-500 text-xs">
                                                No attendance records found for this period.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    break;

                case "Summary":
                    <div>
                        <h3 class="text-lg font-bold text-slate-800 mb-4">Attendance Summary</h3>

                        @if (lateRecords.Any())
                        {

                            int totalMinutes = lateRecords.Sum(x => x.MinutesLate);
                            int hours = totalMinutes / 60;
                            int remainingMinutes = totalMinutes % 60;

                            <!-- Added Summary Stats Bar -->
                        @*     <div class="flex gap-4 mb-6">
                                <div class="bg-rose-50 border border-rose-100 rounded-lg p-4 flex-1">
                                    <p class="text-rose-600 text-xs font-bold uppercase">Total Late Occurrences</p>
                                    <p class="text-2xl font-black text-rose-900">@lateRecords.Count</p>
                                </div>
                                <div class="bg-amber-50 border border-amber-100 rounded-lg p-4 flex-1">
                                    <p class="text-amber-600 text-xs font-bold uppercase">Total Minutes Lost</p>
                                    <p class="text-2xl font-black text-amber-900">@lateRecords.Sum(x => x.MinutesLate)</p>
                                </div>
                            </div> *@
                            <div class="flex gap-4 mb-6">
                                <div class="bg-rose-50 border border-rose-100 rounded-lg p-4 flex-1">
                                    <p class="text-rose-600 text-xs font-bold uppercase">Total Late Occurrences</p>
                                    <p class="text-2xl font-black text-rose-900">@lateRecords.Count</p>
                                </div>
                                <div class="bg-amber-50 border border-amber-100 rounded-lg p-4 flex-1">
                                    <p class="text-amber-600 text-xs font-bold uppercase">Total Time Lost</p>
                                    <p class="text-2xl font-black text-amber-900">
                                        @if (hours > 0)
                                        {
                                            <span>@hours hr </span>
                                        }
                                        @remainingMinutes min
                                    </p>
                                </div>
                            </div>

                            <!-- Existing Late Records Grid -->
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

                                @foreach (var late in lateRecords)
                                {
                                    <div class="bg-white p-4 rounded-xl border border-rose-100 shadow-sm hover:shadow-md transition-shadow">
                                        <div class="flex justify-between items-start mb-3">
                                            <div>
                                                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">@late.Date.ToString("dd MMM, dddd")</p>
                                                <p class="text-lg font-bold text-slate-800">@late.ActualTime.ToString(@"hh\:mm")</p>
                                            </div>
                                            <span class="bg-rose-100 text-rose-700 px-2 py-1 rounded-md text-xs font-bold">
                                                @late.MinutesLate min
                                            </span>
                                        </div>
                                        <div class="bg-slate-50 p-2 rounded-lg text-xs text-slate-500">
                                            Scheduled: <span class="font-bold text-slate-700">@late.ScheduledTime.ToString(@"hh\:mm")</span>
                                        </div>
                                    </div>
                                
                                }

                            </div>
                        }
                        else
                        {
                            <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 p-6 rounded-xl text-center font-medium italic">
                                No late records found. Great job maintaining your schedule!
                            </div>
                        }
                    </div>
                    break;

                case "Break Late":
                    <div>
                        <h3 class="text-lg font-bold text-amber-800 mb-2">Late from Break</h3>
                        <p class="text-slate-500 text-sm mb-6">Records of extended break durations and delayed returns.</p>

                        @if (breakLateRecords.Any())
                        {
                            <!-- Break Summary Stats Bar -->
                            <div class="flex gap-4 mb-6">
                                <div class="bg-amber-50 border border-amber-100 rounded-lg p-4 flex-1">
                                    <p class="text-amber-600 text-xs font-bold uppercase">Extended Breaks</p>
                                    <p class="text-2xl font-black text-amber-900">@breakLateRecords.Count</p>
                                </div>
                                <div class="bg-orange-50 border border-orange-100 rounded-lg p-4 flex-1">
                                    <p class="text-orange-600 text-xs font-bold uppercase">Total Extra Minutes</p>
                                    <p class="text-2xl font-black text-orange-900">@breakLateRecords.Sum(x => x.OvertimeMinutes)</p>
                                </div>
                            </div>

                            <!-- Break Late Cards Grid -->
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var record in breakLateRecords)
                                {
                                    <div class="bg-white p-4 rounded-xl border border-amber-200 shadow-sm hover:shadow-md transition-shadow">
                                        <div class="flex justify-between items-start mb-3">
                                            <div>
                                                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">@record.Date.ToString("dd MMM, dddd")</p>
                                                <p class="text-lg font-bold text-slate-800">
                                                    @record.BreakOutTime.ToString(@"hh\:mm") - @record.BreakInTime.ToString(@"hh\:mm")
                                                </p>
                                            </div>
                                            <span class="bg-amber-100 text-amber-700 px-2 py-1 rounded-md text-xs font-bold">
                                                +@record.OvertimeMinutes min
                                            </span>
                                        </div>

                                        <div class="bg-slate-50 p-2 rounded-lg text-xs flex justify-between text-slate-500">
                                            <span>Allowed: @allowedBreakDuration.TotalMinutes min</span>
                                            <span class="font-bold text-slate-700">Actual: @(record.OvertimeMinutes + allowedBreakDuration.TotalMinutes) min</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 p-6 rounded-xl text-center font-medium italic">
                                No extended breaks recorded during this period.
                            </div>
                        }
                    </div>
                    break;

                case "Absent":
                    <div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2">Absenteeism</h3>
                        <div class="mt-6">
                            <h3 class="text-lg font-bold text-slate-800 mb-4">Absence Overview</h3>

                            <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 flex items-center justify-between">
                                <div>
                                    <p class="text-slate-600 text-xs font-bold uppercase">Total Days Absent</p>
                                    <p class="text-3xl font-black text-slate-900">@TotalAbsentDays</p>
                                </div>
                                <div class="text-slate-400">
                                    <AppIcon Name="calendar_month" Class="w-10 h-10" />
                                </div>
                            </div>

                            @if (AbsentRecords.Any())
                            {
                                <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-2">
                                    @foreach (var absent in AbsentRecords)
                                    {
                                        <div class="bg-white border border-slate-100 p-2 rounded text-center">
                                            <p class="text-[10px] text-slate-400 uppercase font-bold">@absent.Date.ToString("MMM dd")</p>
                                            <p class="text-xs font-semibold text-slate-700">@absent.Date.ToString("ddd")</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case "Overtime":
                    <div>
                        <h3 class="text-lg font-bold text-emerald-800 mb-2">Over-time Tracking</h3>
                        <p class="text-slate-500 text-sm mb-6">Review and approve extra hours worked beyond the standard shift.</p>
                    </div>
                    break;

                case "Help":
                    <div class="bg-blue-50 border border-blue-100 rounded-xl p-6">
                        <h3 class="text-lg font-bold text-blue-900 mb-2 flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Help & Guidelines
                        </h3>
                        <p class="text-blue-800 text-sm">
                            Need assistance understanding attendance policies? Review the company rulebook or contact HR for support.
                        </p>
                    </div>
                    break;

                case "My Clock Events":
                    <MyClockEventsPanel />
                    break;
            }
        </div>
    </div>
 
 
</div>


@code {
    private bool exportReady;
    private DateTime exportedFrom, exportedTo;
    private AttendanceExportReport BuildExport() => new("My attendance", $"{exportedFrom:dd MMM yyyy} – {exportedTo:dd MMM yyyy}",
        [AttendanceReportExport.Daily(attendanceDays), new("Break records", ["Date", "Break out", "Break in"],
            dailyRecords.Select(d => new object?[] { d.Date.ToString("yyyy-MM-dd"), d.BreakOut, d.BreakIn }).ToList())]);

    private bool isLoading = true;


    // --- Tab Navigation State ---
    // private string activeTab = "Attendance";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    public string? activeTab { get; set; } = "Attendance";
    private List<LateRecord> lateRecords = new();


    private readonly string[] Tabs = new[]
    {
        "Attendance",
        "My Clock Events",
        "Summary",
        "Break Late",
        "Absent",
        "Overtime",
        "Help"
    };

    // --- Search & UI State ---
    private DateTime startDate;
    private DateTime endDate;


    private TimeSpan shiftStart = new TimeSpan(8, 30, 0);
    private TimeSpan allowedBreakDuration = TimeSpan.FromMinutes(60);

    // --- Data Models ---
    private List<ChartStat> attendanceStats = new();
    private List<DailyAttendanceRow> dailyRecords = new();
    private List<HRM.DTOs.Contracts.AttendanceLogDto>? rawLogs;
    private List<BreakLateRecord> breakLateRecords = new();


    // This will give you the total count of absent days
    private int TotalAbsentDays => dailyRecords.Count(r => r.Status == "Absent");

    // If you need a list of the specific days to show in a UI
    private List<DailyAttendanceRow> AbsentRecords => dailyRecords.Where(r => r.Status == "Absent").ToList();

    protected override async Task OnParametersSetAsync()
    {
        activeTab = HRM.Helpers.SectionRoutes.Tab(Tabs, TabSection ?? QueryTab, "Attendance");

        await SearchDefaultPeriod();
        LoadChartData();
        CalculateLateRecords();
    }


    protected override async Task OnInitializedAsync()
    {
        // Calculate the current salary period
        DateTime today = DateTime.Today;

        if (today.Day >= 15)
        {
            // If today is the 15th or later, the period started THIS month
            startDate = new DateTime(today.Year, today.Month, 15);
        }
        else
        {
            // If today is before the 15th, the period started LAST month
            startDate = new DateTime(today.Year, today.Month, 15).AddMonths(-1);
        }

        // Set the end date to the 16th of the following month
        endDate = startDate.AddMonths(1).AddDays(1);



        await SearchDefaultPeriod();
        LoadChartData();
        CalculateLateRecords();

    }

    private async Task ResetToCurrentPeriod()
    {
        DateTime today = DateTime.Today;

        if (today.Day >= 15)
        {
            startDate = new DateTime(today.Year, today.Month, 15);
        }
        else
        {
            startDate = new DateTime(today.Year, today.Month, 15).AddMonths(-1);
        }

        endDate = startDate.AddMonths(1).AddDays(1);

        // Auto-fetch the data so the user doesn't have to click "Search" after resetting
        await FetchAttendanceData(startDate, endDate);
    }


    private List<HRM.DTOs.Attendance.YearlyAttendanceDayDto> attendanceDays = [];
    private void CalculateLateRecords()
    {
        lateRecords = attendanceDays.Where(d => d.IsPresent && d.IsLate && d.FirstCheckIn.HasValue && d.ScheduledStart.HasValue)
            .Select(d => new LateRecord { Date = d.Date, ActualTime = d.FirstCheckIn!.Value.TimeOfDay,
                ScheduledTime = d.ScheduledStart!.Value.TimeOfDay, MinutesLate = d.LateMinutes }).ToList();
    }

    private void SetActiveTab(string tabName)
    {
        activeTab = tabName;
        HRM.Helpers.SectionRoutes.NavigateTab(Navigation, "/online/attendance/my-attendance", tabName);
    }
    [Parameter] public string? TabSection { get; set; }

    // private void SetDefaultSalaryPeriod()
    // {
    //     // 15th of the previous month to the 16th of the current month
    //     DateTime today = DateTime.Today;
    //     DateTime startMonthTarget = today.Day <= 15 ? today.AddMonths(-2) : today.AddMonths(-1);

    //     startDate = new DateTime(startMonthTarget.Year, startMonthTarget.Month, 15);
    //     endDate = startDate.AddMonths(1).AddDays(1); // One month + 1 day = 16th
    // }

    private void LoadChartData()
    {
        var requiredDays = dailyRecords.Count(r => r.RequiresAttendance);
        var totalDays = Math.Max(1, requiredDays);
        var leaveDays = dailyRecords.Count(r => r.Status == "Leave");
        attendanceStats = new List<ChartStat>
        {
            new ChartStat { Label = "To Attend", Days = requiredDays, Percentage = requiredDays > 0 ? 100 : 0, ColorClass = "bg-slate-400" },
            new ChartStat { Label = "Absent", Days = TotalAbsentDays, Percentage = (int)Math.Round(100d * TotalAbsentDays / totalDays), ColorClass = "bg-rose-500" },
            new ChartStat { Label = "Attended late", Days = dailyRecords.Count(r => r.IsLate), Percentage = (int)Math.Round(100d * dailyRecords.Count(r => r.IsLate) / totalDays), ColorClass = "bg-amber-400" },
            new ChartStat { Label = "Perfectly attended", Days = dailyRecords.Count(r => r.IsPerfect), Percentage = (int)Math.Round(100d * dailyRecords.Count(r => r.IsPerfect) / totalDays), ColorClass = "bg-emerald-400" },
            new ChartStat { Label = "Attended", Days = dailyRecords.Count(r => r.IsPresent && !r.IsLate && !r.IsPerfect), Percentage = (int)Math.Round(100d * dailyRecords.Count(r => r.IsPresent && !r.IsLate && !r.IsPerfect) / totalDays), ColorClass = "bg-blue-500" },
            new ChartStat { Label = "Leaves", Days = leaveDays, Percentage = (int)Math.Round(100d * leaveDays / totalDays), ColorClass = "bg-blue-400" }
        };
    }
  
    // Status = (day.DayOfWeek == System.DayOfWeek.Friday || day.DayOfWeek == System.DayOfWeek.Saturday) ? "Weekend" : "Absent",

 private async Task FetchAttendanceData(DateTime start, DateTime end)
    {

        isLoading = true;
        exportReady = false;
        StateHasChanged();

        try
        {

        dailyRecords.Clear();
        lateRecords.Clear();
        breakLateRecords.Clear(); // Clears correctly

            int individualID = await _individual.GetIndividualID();
        attendanceDays = await AttendanceService.GetStaffAttendanceRangeAsync(individualID, start, end);
        rawLogs = await AttendanceLogService.GetAttendanceLogsAsync(individualID, start, end);
        var support = await AttendanceSupport.LoadAsync(start.Date, end.Date);
        var restDays = support.RestDays;
        var eligibility = support.Eligibility;
        var approvedLeaves = support.ApprovedLeaves;

        // Define rules
        // var shiftStart = new TimeSpan(8, 30, 0);
        // var allowedBreakDuration = TimeSpan.FromMinutes(60);

        for (var day = start.Date; day <= end.Date; day = day.AddDays(1))
        {
            var dayLogs = rawLogs.Where(l => l.Date.Date == day.Date).ToList();
            var dayLeaves = approvedLeaves
                .Where(l => l.FromDate.Date <= day && l.ToDate.Date >= day)
                .ToList();
            var isOnLeave = dayLeaves.Count > 0;

            var row = new DailyAttendanceRow
                {
                    Date = day,
                    RequiresAttendance = eligibility[day.Date].CanBeAbsent && !isOnLeave,
                    Status = eligibility[day.Date].Message ?? (!eligibility[day.Date].IsScheduledDay ? "Weekend" : day.Date > DateTime.UtcNow.AddHours(5).Date ? "Upcoming" : eligibility[day.Date].CanBeAbsent ? "Absent" : "Attendance not required"),
                    Details = ""
                };

            if (isOnLeave)
            {
                row.Status = "Leave";
                row.Details = string.Join(", ", dayLeaves
                    .Select(l => string.IsNullOrWhiteSpace(l.Type) ? "Leave" : l.Type)
                    .Distinct());
            }

            if (dayLogs.Any())
            {
                if (!isOnLeave && eligibility[day.Date].HasApprovedPosition && eligibility[day.Date].HasActiveSchedule)
                    row.Status = "Present";

                // Clock In/Out (Official Priority: do not treat Duty check-out or OfficialBreakOut as Official final check-out)
                var clockIn = dayLogs.FirstOrDefault(l =>
                    l.AttendanceLogResolutions.Any(r => r.IsValid && r.AttendanceClockTypeId == 1 && !string.Equals(r.SchedulePurpose, "Duty", StringComparison.OrdinalIgnoreCase) && r.LogicalEventType != "OfficialBreakIn") ||
                    (!l.AttendanceLogResolutions.Any(r => r.IsValid) && l.InOutModeId == 1));
                var clockOut = dayLogs.LastOrDefault(l =>
                    l.AttendanceLogResolutions.Any(r => r.IsValid && r.AttendanceClockTypeId == 2 && !string.Equals(r.SchedulePurpose, "Duty", StringComparison.OrdinalIgnoreCase) && r.LogicalEventType != "OfficialBreakOut") ||
                    (!l.AttendanceLogResolutions.Any(r => r.IsValid) && l.InOutModeId == 2));
                var breakOut = dayLogs.LastOrDefault(l =>
                    l.AttendanceLogResolutions.Any(r => r.IsValid && (r.AttendanceClockTypeId == (int)HRM.Enum.AttendanceClockType.BreakOut || r.LogicalEventType == "OfficialBreakOut")) ||
                    (l.InOutModeId == 3 && !l.AttendanceLogResolutions.Any(r => r.IsValid)));
                var breakIn = dayLogs.LastOrDefault(l =>
                    l.AttendanceLogResolutions.Any(r => r.IsValid && (r.AttendanceClockTypeId == (int)HRM.Enum.AttendanceClockType.BreakIn || r.LogicalEventType == "OfficialBreakIn")) ||
                    l.InOutModeId == 4);

                row.ClockIn = clockIn != null ? clockIn.Date.ToString("HH:mm") : "--:--";
                row.ClockOut = clockOut != null ? clockOut.Date.ToString("HH:mm") : "--:--";
                row.BreakOut = breakOut != null ? breakOut.Date.ToString("HH:mm") : "--:--";
                row.BreakIn = breakIn != null ? breakIn.Date.ToString("HH:mm") : "--:--";

                // 1. Calculate Late Arrival
                if (!isOnLeave && eligibility[day.Date].CanBeAbsent && clockIn != null && clockIn.Date.TimeOfDay > shiftStart)
                {
                    lateRecords.Add(new LateRecord
                        {
                            Date = day,
                            ActualTime = clockIn.Date.TimeOfDay,
                            ScheduledTime = shiftStart,
                            MinutesLate = (int)(clockIn.Date.TimeOfDay - shiftStart).TotalMinutes
                        });
                }

                // 2. Calculate Break Overtime
                if (!isOnLeave && breakOut != null && breakIn != null)
                {
                    TimeSpan actualBreak = breakIn.Date - breakOut.Date;
                    if (actualBreak > allowedBreakDuration)
                    {
                        int overtime = (int)(actualBreak - allowedBreakDuration).TotalMinutes;

                        // Updates the string for the main table
                        row.Details += $"Overtime: {overtime}m";

                        // MISSING LOGIC ADDED HERE: Populates the Break Late tab
                        breakLateRecords.Add(new BreakLateRecord
                            {
                                Date = day,
                                BreakOutTime = breakOut.Date.TimeOfDay,
                                BreakInTime = breakIn.Date.TimeOfDay,
                                OvertimeMinutes = overtime
                            });
                    }
                }
            }
            var overview = attendanceDays.FirstOrDefault(d => d.Date.Date == day.Date);
            if (overview != null)
            {
                row.Status = overview.IsOnLeave ? "Leave" : HRM.Helpers.AttendancePresentation.Status(overview);
                row.IsPresent = overview.IsPresent; row.IsLate = overview.IsPresent && overview.IsLate;
                row.IsPerfect = overview.IsPerfectlyAttended;
                row.ClockIn = overview.FirstCheckIn?.ToString("HH:mm") ?? "--:--";
                row.ClockOut = overview.LastCheckOut?.ToString("HH:mm") ?? "--:--";
            }
            dailyRecords.Add(row);
        }
        CalculateLateRecords();
        LoadChartData();
        exportedFrom = start.Date; exportedTo = end.Date; exportReady = true;
        StateHasChanged(); // Refresh the UI

        }
        finally
        {
            // 3. Turn off the loading animation even if there was an error
            isLoading = false;
            StateHasChanged(); // Refresh UI to show the real data (or empty state)
        }



    }
    // 2. Default: Called on page load
    public async Task SearchDefaultPeriod()
    {
        DateTime today = DateTime.Today;
        DateTime start = new DateTime(today.Year, today.Month, 15);
        DateTime end = start.AddMonths(1); // Ends on the 15th of the next month

        await FetchAttendanceData(start, end);
    }

