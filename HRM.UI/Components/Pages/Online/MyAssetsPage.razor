@code {
    private bool loading = true;
    private MyAssetsPortalData? portalData;
    private string activeTab = "pending";

    // Draft decisions per issuance and line: issuanceId -> lineId -> decision object
    private Dictionary<string, StaffAssetLineDecisionInput> draftDecisions = new();
    private Dictionary<int, bool> statementConfirmedMap = new();

    // Modals
    private bool showReturnModal;
    private int selectedCustodyIdToReturn;
    private string returnType = AssetReturnTypes.StandardReturn;
    private string returnNotes = "";

    private bool showPrintModal;
    private AssetPrintableDocumentDto? printableDoc;

    protected override async Task OnInitializedAsync()
    {
        await LoadPortalDataAsync();
    }

    private async Task LoadPortalDataAsync()
    {
        loading = true;
        try
        {
            portalData = await AssetService.LoadMyAssetsPortalAsync();
            if (portalData.PendingIssuances.Count == 0 && portalData.ActiveCustodies.Count > 0)
            {
                activeTab = "current";
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to load employee property: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private StaffAssetLineDecisionInput GetOrCreateDraftDecision(int issuanceId, int lineId, int version)
    {
        var key = $"{issuanceId}_{lineId}";
        if (!draftDecisions.TryGetValue(key, out var decision))
        {
            decision = new StaffAssetLineDecisionInput
            {
                AssetIssuanceItemId = lineId,
                ExpectedVersion = version,
                Decision = AssetStaffDecisions.Accepted,
                RejectionReasonCode = AssetRejectionReasons.NotPhysicallyReceived
            };
            draftDecisions[key] = decision;
        }
        return decision;
    }

    private async Task SubmitStaffDecisionBatchAsync(int issuanceId)
    {
        if (!statementConfirmedMap.TryGetValue(issuanceId, out var confirmed) || !confirmed)
        {
            Toasts.Error("You must check the confirmation statement to acknowledge receipt of property.");
            return;
        }

        var issuance = portalData?.PendingIssuances.FirstOrDefault(i => i.AssetIssuanceId == issuanceId);
        if (issuance == null) return;

        var lineDecisions = new List<StaffAssetLineDecisionInput>();
        foreach (var line in issuance.Lines.Where(l => l.Status == AssetIssuanceLineStatuses.HandedOver))
        {
            var key = $"{issuanceId}_{line.AssetIssuanceItemId}";
            if (draftDecisions.TryGetValue(key, out var dec))
            {
                lineDecisions.Add(dec);
            }
        }

        var batch = new StaffAssetDecisionBatchInput
        {
            AssetIssuanceId = issuanceId,
            ExplicitStatementConfirmed = true,
            Decisions = lineDecisions
        };

        var res = await AssetService.SubmitStaffDecisionsAsync(batch);
        if (res.Success)
        {
            Toasts.Success("Your asset acknowledgement has been recorded successfully.");
            await LoadPortalDataAsync();
        }
        else
        {
            Toasts.Error(res.Message);
        }
    }

    private void OpenInitiateReturnModal()
    {
        selectedCustodyIdToReturn = portalData?.ActiveCustodies.FirstOrDefault()?.AssetCustodyId ?? 0;
        returnType = AssetReturnTypes.StandardReturn;
        returnNotes = "";
        showReturnModal = true;
    }

    private void RequestReturnForCustody(AssetCustodyRowDto c)
    {
        selectedCustodyIdToReturn = c.AssetCustodyId;
        returnType = AssetReturnTypes.StandardReturn;
        returnNotes = "";
        showReturnModal = true;
    }

    private async Task SubmitReturnRequestAsync()
    {
        if (selectedCustodyIdToReturn <= 0)
        {
            Toasts.Error("Select an item to return.");
            return;
        }

        var input = new AssetReturnCreateInput
        {
            OrganisationId = portalData?.ActiveCustodies.FirstOrDefault(c => c.AssetCustodyId == selectedCustodyIdToReturn)?.OrganisationId ?? 0,
            ReturnType = returnType,
            Notes = returnNotes,
            AssetCustodyIds = [selectedCustodyIdToReturn]
        };

        var res = await AssetService.CreateReturnAsync(input);
        if (res.Success)
        {
            Toasts.Success("Return request submitted. Please hand over the physical equipment to the asset officer.");
            showReturnModal = false;
            await LoadPortalDataAsync();
        }
        else
        {
            Toasts.Error(res.Message);
        }
    }

    private async Task ViewPrintableDocumentAsync(int assetIssuanceId)
    {
        try
        {
            printableDoc = await AssetService.GetPrintableDocumentAsync(assetIssuanceId, AssetDocumentVariants.StandardHandoverRecord);
            showPrintModal = true;
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to load document: {ex.Message}");
        }
    }

    // Lifecycle Modals & State
    private bool showFaultModal;
    private int faultCustodyId;
    private string faultTitle = "";
    private string faultDescription = "";
    private string faultPriority = "Standard";

    private bool showUpgradeModal;
    private int upgradeCustodyId;
    private string upgradeComponentType = AssetComponentTypes.RAM;
    private string upgradeRequirement = "";

    private bool showConfigModal;
    private AssetConfigurationTimelineDto? configTimeline;

    private AssetClearanceCheckDto? clearanceCheck;
    private bool showServicePrintModal;
    private AssetServicePrintableDocumentDto? servicePrintDoc;

    private void OpenFaultReportModal(AssetCustodyRowDto? c = null)
    {
        faultCustodyId = c?.AssetCustodyId ?? portalData?.ActiveCustodies.FirstOrDefault()?.AssetCustodyId ?? 0;
        faultTitle = "";
        faultDescription = "";
        faultPriority = "Standard";
        showFaultModal = true;
    }

    private async Task SubmitFaultReportAsync()
    {
        var custody = portalData?.ActiveCustodies.FirstOrDefault(c => c.AssetCustodyId == faultCustodyId);
        if (custody == null)
        {
            Toasts.Error("Select an asset to report.");
            return;
        }

        if (string.IsNullOrWhiteSpace(faultTitle) || string.IsNullOrWhiteSpace(faultDescription))
        {
            Toasts.Error("Provide a title and detailed description of the equipment fault.");
            return;
        }

        var input = new AssetServiceRequestCreateInput
        {
            IndividualId = custody.IndividualId,
            JobId = custody.JobId,
            OrganisationId = custody.OrganisationId,
            StructureId = custody.StructureId,
            RequestType = AssetServiceRequestTypes.FaultCorrective,
            Priority = faultPriority,
            Title = faultTitle.Trim(),
            Description = faultDescription.Trim(),
            Items =
            [
                new AssetServiceRequestItemInput
                {
                    AssetItemId = custody.AssetItemId,
                    AssetCustodyId = custody.AssetCustodyId,
                    ItemRequestType = AssetServiceRequestTypes.FaultCorrective,
                    ReportedFaultOrRequirement = faultDescription.Trim()
                }
            ]
        };

        var res = await AssetService.CreateServiceRequestAsync(input);
        if (res.Success)
        {
            Toasts.Success("Equipment fault reported. The IT workshop will triage and assign a technician.");
            showFaultModal = false;
            activeTab = "service";
            await LoadPortalDataAsync();
        }
        else
        {
            Toasts.Error(res.Message);
        }
    }

    private void OpenUpgradeRequestModal(AssetCustodyRowDto? c = null)
    {
        upgradeCustodyId = c?.AssetCustodyId ?? portalData?.ActiveCustodies.FirstOrDefault()?.AssetCustodyId ?? 0;
        upgradeComponentType = AssetComponentTypes.RAM;
        upgradeRequirement = "";
        showUpgradeModal = true;
    }

    private async Task SubmitUpgradeRequestAsync()
    {
        var custody = portalData?.ActiveCustodies.FirstOrDefault(c => c.AssetCustodyId == upgradeCustodyId);
        if (custody == null)
        {
            Toasts.Error("Select an asset to upgrade.");
            return;
        }

        if (string.IsNullOrWhiteSpace(upgradeRequirement))
        {
            Toasts.Error("Please specify the upgrade requirement (e.g. 16GB DDR4 RAM or 1TB NVMe SSD).");
            return;
        }

        var input = new AssetServiceRequestCreateInput
        {
            IndividualId = custody.IndividualId,
            JobId = custody.JobId,
            OrganisationId = custody.OrganisationId,
            StructureId = custody.StructureId,
            RequestType = AssetServiceRequestTypes.HardwareUpgrade,
            Priority = "Standard",
            Title = $"Hardware Upgrade Request: {upgradeComponentType} for {custody.AssetCode}",
            Description = upgradeRequirement.Trim(),
            Items =
            [
                new AssetServiceRequestItemInput
                {
                    AssetItemId = custody.AssetItemId,
                    AssetCustodyId = custody.AssetCustodyId,
                    ItemRequestType = AssetServiceRequestTypes.HardwareUpgrade,
                    ReportedFaultOrRequirement = upgradeRequirement.Trim(),
                    TargetComponentCategory = upgradeComponentType,
                    TargetSpecification = upgradeRequirement.Trim()
                }
            ]
        };

        var res = await AssetService.CreateServiceRequestAsync(input);
        if (res.Success)
        {
            Toasts.Success("Hardware upgrade requested. Active custody will be preserved while parts are installed.");
            showUpgradeModal = false;
            activeTab = "service";
            await LoadPortalDataAsync();
        }
        else
        {
            Toasts.Error(res.Message);
        }
    }

    private async Task ViewConfigurationHistoryAsync(int assetItemId)
    {
        try
        {
            configTimeline = await AssetService.GetAssetConfigurationHistoryAsync(assetItemId);
            showConfigModal = true;
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to load configuration history: {ex.Message}");
        }
    }

    private async Task LoadClearanceStatusAsync()
    {
        try
        {
            var indId = portalData?.ActiveCustodies.FirstOrDefault()?.IndividualId ?? 0;
            if (indId > 0)
            {
                clearanceCheck = await AssetService.CheckStaffAssetClearanceAsync(indId);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to evaluate clearance: {ex.Message}");
        }
    }

    private async Task ViewServicePrintableDocumentAsync(long id, string type)
    {
        try
        {
            servicePrintDoc = await AssetService.GetServicePrintableDocumentAsync(id, type);
            showServicePrintModal = true;
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to load document: {ex.Message}");
        }
    }
}
