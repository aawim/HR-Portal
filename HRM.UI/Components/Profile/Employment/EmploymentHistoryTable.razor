@using HRM.DTOs

<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold text-slate-900">Job History</h2>
        <p class="mt-1 text-xs text-slate-500">Current and previous employment records</p>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-600">
                <tr><th class="px-4 py-3">Organisation</th><th class="px-4 py-3">Department</th><th class="px-4 py-3">Job type</th><th class="px-4 py-3">Joined</th><th class="px-4 py-3">Ended</th><th class="px-4 py-3">Status</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var job in Jobs.OrderByDescending(x => x.JoinedDate).ThenByDescending(x => x.JobID))
                {
                    <tr @key="job.JobID" class="hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-800">@job.OrganisationName</td>
                        <td class="px-4 py-3 text-slate-600">@job.OrganisationStructureName</td>
                        <td class="px-4 py-3 text-slate-600">@job.JobTypeName</td>
                        <td class="px-4 py-3 whitespace-nowrap">@job.JoinedDate.ToString("dd MMM yyyy")</td>
                        <td class="px-4 py-3 whitespace-nowrap">@(job.TerminatedDate?.ToString("dd MMM yyyy") ?? (job.IsActive && job.JoinedDate <= DateTime.Today ? "Present" : "—"))</td>
                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700">@job.JobStateName</span></td>
                    </tr>
                }
                @if (Jobs.Count == 0)
                {
                    <tr><td colspan="6" class="px-4 py-6 text-center text-slate-500">No employment records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<JobDto> Jobs { get; set; } = Array.Empty<JobDto>();
}
