@using HRM.DTOs.Profile

<div class="p-2 space-y-3">
    <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <h3 class="text-sm font-bold text-slate-800">My Central Personnel Documents</h3>
        <a href="/online/documents" class="inline-flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700">
            Open Document Centre
        </a>
    </div>

    @if (Documents == null || Documents.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs text-slate-500">
            No central personnel documents linked yet.
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                    <tr>
                        <th class="p-2.5">Doc No</th>
                        <th class="p-2.5">Title</th>
                        <th class="p-2.5">Category &amp; Type</th>
                        <th class="p-2.5">Version</th>
                        <th class="p-2.5">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var doc in Documents)
                    {
                        <tr class="hover:bg-slate-50/50">
                            <td class="p-2.5 font-mono text-[11px] font-semibold text-blue-700">@doc.DocumentNumber</td>
                            <td class="p-2.5 font-semibold text-slate-900">@doc.Title</td>
                            <td class="p-2.5 text-slate-600">@doc.CategoryName • @doc.DocumentTypeName</td>
                            <td class="p-2.5 font-mono text-slate-700">v@(doc.CurrentVersionNumber).0</td>
                            <td class="p-2.5">
                                <span class="rounded-full bg-emerald-100 text-emerald-800 px-2 py-0.5 text-[11px] font-semibold">@doc.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnUpload { get; set; }
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public List<ProfileDocumentDto>? Documents { get; set; }
}
