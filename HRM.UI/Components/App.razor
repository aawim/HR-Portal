<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script src="js/theme.js"></script>
    <script src="js/font-size.js?v=20261026-1"></script>
    <script src="js/chat.js?v=20261026-1"></script>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/tailwind.css?v=20261025-1" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="@(typeof(App).Assembly.GetName().Name + ".styles.css")" />
    <link rel="stylesheet" href="css/theme.css?v=20261026-dropdown-1" />
    <link rel="stylesheet" href="css/buttons.css" />
    <link rel="stylesheet" href="css/layout.css?v=20261022-2" />
    <link rel="stylesheet" href="css/toasts.css?v=20261022-2" />
    <link rel="stylesheet" href="css/leave-application.css?v=20261022-1" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    @* Load account context and dashboard data once, after the interactive circuit starts. *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script type="module" src="js/notification-copy.js?v=20261022-1"></script>

</body>

</html>


