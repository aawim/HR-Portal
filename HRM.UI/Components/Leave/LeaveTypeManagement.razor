

@using HRM.DTOs.Leave
@using HRM.DTOs.LeaveTypes
@using HRM.Services.Interfaces.LeaveType
@using HRM.Services.Interfaces.Leave

@inject ILeaveTypeCatalogueService LeaveTypeCatalogueService
@inject ILogger<LeaveTypeManagement> Logger

<PageTitle>Leave Types</PageTitle>

<div class="space-y-3">

    <div class="w-full">

        <div class="mb-6 flex flex-col gap-4
                    sm:flex-row sm:items-center
                    sm:justify-between">

            <div>
                <h1 class="text-xl font-bold text-slate-900">
                    Leave Type Management
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Manage leave types and their availability.
                </p>
            </div>

            <button type="button"
                    @onclick="StartCreate"
                    class="inline-flex items-center justify-center
                           gap-2 rounded-xl bg-indigo-600
                           px-4 py-2.5 text-sm font-semibold
                           text-white hover:bg-indigo-700">

               @*  <span class="material-symbols-rounded text-[18px]">
                    add
                </span> *@

                New Leave Type

            </button>

        </div>

        @if (_message != null) { <p role="status" class="rounded border p-3 text-sm">@_message</p> }
        <div class="grid grid-cols-1 gap-3 xl:grid-cols-12">

            <!-- Form -->
            <div class="xl:col-span-7">

                <LeaveTypeForm
                    Model="@_model"
                    RequestTypes="@_requestTypes"
                    IsEdit="@_isEdit"
                    IsSaving="@_saving"
                    OnSave="@SaveAsync"
                    OnCancel="@StartCreate" />
                @if(_selectedId.HasValue){<div class="mt-3"><LeaveSubtypeEditor LeaveTypeId="_selectedId.Value" @key="_selectedId" /></div>}

            </div>

            <!-- List -->
            <div class="xl:col-span-5">

                <LeaveTypeList
                    Types="@_types"
                    IsLoading="@_loading"
                    SelectedId="@_selectedId"
                    OnSelected="@SelectAsync" />

            </div>

        </div>

    </div>

</div>

@code {
    private List<LeaveTypeCatalogueDto> _types = [];
    private List<LeaveRequestTypeOption> _requestTypes = [];
    private string? _message;

    private LeaveTypeCatalogueSaveRequest _model = new();

    private int? _selectedId;

    private bool _loading;
    private bool _saving;
    private bool _isEdit;

    protected override async Task OnInitializedAsync()
    {
        StartCreate();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _requestTypes = await LeaveTypeCatalogueService.GetRequestTypesAsync();

            _types =
                await LeaveTypeCatalogueService
                    .GetManagementAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartCreate()
    {
        _selectedId = null;
        _isEdit = false;

        _model =
            new LeaveTypeCatalogueSaveRequest
            {
                IsActive = true
            };
    }

    private async Task SelectAsync(
        LeaveTypeCatalogueDto definition)
    {
        var detail =
            await LeaveTypeCatalogueService
                .GetByIdAsync(
                    definition.LeaveTypeId);

        if (detail is null)
        {
            return;
        }

        _selectedId =
            detail.LeaveTypeId;

        _isEdit = true;

        _model =
            new LeaveTypeCatalogueSaveRequest
            {
                LeaveTypeId =
                    detail.LeaveTypeId,

                RequestTypeId = detail.RequestTypeId,
                Code =
                    detail.Code,

                Name =
                    detail.Name,

                NameDhivehi =
                    detail.NameDhivehi,

                Description =
                    detail.Description,

                IsGlobal =
                    detail.IsGlobal,

                IsSystemType =
                    detail.IsSystemType,

                IsActive =
                    detail.IsActive
            };
    }

    private async Task SaveAsync()
    {
        _saving = true; _message = null;
        try
        {
            var result = _isEdit ? await LeaveTypeCatalogueService.UpdateAsync(_model) : await LeaveTypeCatalogueService.CreateAsync(_model);
            _message = result.Message;
            if (!result.Success) return;
            StartCreate(); await LoadAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Leave type save failed"); _message = "Leave type could not be saved. Please try again."; }
        finally { _saving = false; }
    }

}
