@using HRM.DTOs.Leave
@using HRM.DTOs.LeaveTypes
@using HRM.Services.Interfaces.LeaveType
@using HRM.Services.Interfaces.Leave

@inject ILeaveTypeCatalogueService LeaveTypeCatalogueService
@inject ILogger<LeaveTypeManagement> Logger

<PageTitle>Leave Types</PageTitle>

<section class="w-full min-w-0 space-y-3">
    <!-- Primary Hero Card -->
    <header class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-1.5 mb-1">
                <span class="inline-flex items-center rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200/80 dark:border-indigo-800 px-2 py-0.5 text-[10px] font-semibold text-indigo-700 dark:text-indigo-300">
                    Leave Catalogue
                </span>
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/80 dark:border-emerald-800 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    @ActiveCount active
                </span>
            </div>
            <h1 class="text-base font-bold text-slate-900 dark:text-slate-100">Leave Type Management</h1>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                Manage leave type definitions, request type mappings, availability, and subtypes.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="app-button app-button-secondary app-button-sm"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                <AppIcon Name="refresh" Class="@(_loading ? "animate-spin text-xs" : "text-xs")" />
                <span>Refresh</span>
            </button>
            <button type="button"
                    class="app-button app-button-primary app-button-sm"
                    @onclick="StartCreate">
                <AppIcon Name="add" Class="text-xs" />
                <span>New Leave Type</span>
            </button>
        </div>
    </header>

    <!-- Narrow Sub-Navigation & Inline KPI Bar -->
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex flex-wrap items-center gap-1" role="tablist" aria-label="Leave type filter">
            <button type="button" role="tab" aria-selected="@(_scopeTab == "all")"
                    class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(_scopeTab == "all" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                    @onclick='() => _scopeTab = "all"'>
                <span>All</span>
                <span class="rounded-full bg-amber-100 dark:bg-amber-900/50 px-1.5 py-0.2 text-[10px] font-bold text-amber-800 dark:text-amber-200">@_types.Count</span>
            </button>
            <button type="button" role="tab" aria-selected="@(_scopeTab == "active")"
                    class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(_scopeTab == "active" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                    @onclick='() => _scopeTab = "active"'>
                <span>Active</span>
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.2 text-[10px] font-bold text-slate-600 dark:text-slate-300">@ActiveCount</span>
            </button>
            <button type="button" role="tab" aria-selected="@(_scopeTab == "global")"
                    class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(_scopeTab == "global" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                    @onclick='() => _scopeTab = "global"'>
                <span>Global</span>
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.2 text-[10px] font-bold text-slate-600 dark:text-slate-300">@GlobalCount</span>
            </button>
            <button type="button" role="tab" aria-selected="@(_scopeTab == "system")"
                    class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold transition-colors @(_scopeTab == "system" ? "bg-teal-50 dark:bg-teal-950/50 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent")"
                    @onclick='() => _scopeTab = "system"'>
                <span>System</span>
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-1.5 py-0.2 text-[10px] font-bold text-slate-600 dark:text-slate-300">@SystemCount</span>
            </button>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
            <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>Total: <strong class="text-slate-800 dark:text-slate-100">@_types.Count</strong></span>
            <span>·</span>
            <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Active: <strong class="text-slate-800 dark:text-slate-100">@ActiveCount</strong></span>
            <span>·</span>
            <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>Global: <strong class="text-slate-800 dark:text-slate-100">@GlobalCount</strong></span>
            <span>·</span>
            <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-violet-500"></span>System: <strong class="text-slate-800 dark:text-slate-100">@SystemCount</strong></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div role="status" class="flex items-center justify-between gap-2 rounded-xl border px-3 py-2 text-xs @(_messageIsError ? "border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-200" : "border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-200")">
            <span>@_message</span>
            <button type="button" class="font-bold opacity-70 hover:opacity-100" @onclick="() => _message = null">✕</button>
        </div>
    }

    <!-- 2-Column Enterprise Layout -->
    <div class="leave-type-panels">
        <aside class="min-w-0 lg:sticky lg:top-3">
            <LeaveTypeList
                Types="@FilteredTypes"
                IsLoading="@_loading"
                SelectedId="@_selectedId"
                OnSelected="@SelectAsync" />
        </aside>

        <div class="min-w-0 space-y-3">
            <LeaveTypeForm
                Model="@_model"
                RequestTypes="@_requestTypes"
                IsEdit="@_isEdit"
                IsSaving="@_saving"
                OnSave="@SaveAsync"
                OnCancel="@StartCreate" />
            @if (_selectedId.HasValue)
            {
                <LeaveSubtypeEditor LeaveTypeId="_selectedId.Value" @key="_selectedId" />
            }
        </div>
    </div>
</section>

<style>
    .leave-type-panels {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 0.75rem;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    @@media (min-width: 1024px) {
        .leave-type-panels {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }
    }
</style>

@code {
    private List<LeaveTypeCatalogueDto> _types = [];
    private List<LeaveRequestTypeOption> _requestTypes = [];
    private string? _message;
    private bool _messageIsError;
    private string _scopeTab = "all";

    private LeaveTypeCatalogueSaveRequest _model = new();
    private int? _selectedId;
    private bool _loading;
    private bool _saving;
    private bool _isEdit;

    private int ActiveCount => _types.Count(t => t.IsActive);
    private int GlobalCount => _types.Count(t => t.IsGlobal);
    private int SystemCount => _types.Count(t => t.IsSystemType);

    private IReadOnlyList<LeaveTypeCatalogueDto> FilteredTypes => _scopeTab switch
    {
        "active" => _types.Where(t => t.IsActive).ToList(),
        "global" => _types.Where(t => t.IsGlobal).ToList(),
        "system" => _types.Where(t => t.IsSystemType).ToList(),
        _ => _types
    };

    protected override async Task OnInitializedAsync()
    {
        StartCreate();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _requestTypes = await LeaveTypeCatalogueService.GetRequestTypesAsync();
            _types = await LeaveTypeCatalogueService.GetManagementAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartCreate()
    {
        _selectedId = null;
        _isEdit = false;
        _model = new LeaveTypeCatalogueSaveRequest { IsActive = true };
    }

    private async Task SelectAsync(LeaveTypeCatalogueDto definition)
    {
        var detail = await LeaveTypeCatalogueService.GetByIdAsync(definition.LeaveTypeId);
        if (detail is null) return;

        _selectedId = detail.LeaveTypeId;
        _isEdit = true;
        _model = new LeaveTypeCatalogueSaveRequest
        {
            LeaveTypeId = detail.LeaveTypeId,
            RequestTypeId = detail.RequestTypeId,
            Code = detail.Code,
            Name = detail.Name,
            NameDhivehi = detail.NameDhivehi,
            Description = detail.Description,
            IsGlobal = detail.IsGlobal,
            IsSystemType = detail.IsSystemType,
            IsActive = detail.IsActive
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        _messageIsError = false;
        try
        {
            var result = _isEdit
                ? await LeaveTypeCatalogueService.UpdateAsync(_model)
                : await LeaveTypeCatalogueService.CreateAsync(_model);
            _message = result.Message;
            _messageIsError = !result.Success;
            if (!result.Success) return;
            StartCreate();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Leave type save failed");
            _message = "Leave type could not be saved. Please try again.";
            _messageIsError = true;
        }
        finally
        {
            _saving = false;
        }
    }
}
