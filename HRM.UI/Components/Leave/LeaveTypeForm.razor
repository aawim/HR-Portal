@using HRM.DTOs.Leave
@using HRM.DTOs.LeaveTypes

<section class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 px-4 py-3">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                    @(IsEdit ? "Edit Leave Type" : "Create Leave Type")
                </h2>
                <span class="inline-flex rounded-full border px-2 py-0.5 text-[10px] font-semibold @(IsEdit ? "border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300" : "border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300")">
                    @(IsEdit ? "Editing" : "New")
                </span>
            </div>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                Define the identity of the leave type. Rules and entitlement are configured separately through policies.
            </p>
        </div>
    </div>

    <EditForm Model="@Model" OnValidSubmit="@SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="mx-4 mt-3 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700" />

        <div class="space-y-3.5 p-4">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">Code</label>
                    <InputText @bind-Value="Model.Code"
                               disabled="@IsEdit"
                               class="mt-0.5 h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:bg-slate-50 dark:disabled:bg-slate-800/60 disabled:text-slate-500" />
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">Name</label>
                    <InputText @bind-Value="Model.Name"
                               class="mt-0.5 h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>
            </div>

            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">Name in Dhivehi</label>
                    <InputText @bind-Value="Model.NameDhivehi"
                               dir="rtl"
                               class="mt-0.5 h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1" for="leave-type-request">Application request type</label>
                    <InputSelect id="leave-type-request"
                                 class="mt-0.5 h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                 @bind-Value="Model.RequestTypeId"
                                 disabled="@IsSaving">
                        <option value="">Select request type</option>
                        @foreach (var option in RequestTypes)
                        {
                            <option value="@option.Id">@option.Name</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 p-1">Description</label>
                <InputTextArea @bind-Value="Model.Description"
                               rows="3"
                               class="mt-0.5 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-2 text-xs text-slate-900 dark:text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
            </div>

            <!-- Inset Options Strip -->
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-2.5 grid grid-cols-1 gap-2 sm:grid-cols-3">
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200">
                    <InputCheckbox @bind-Value="Model.IsActive" class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                    <span>Active</span>
                </label>

                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200">
                    <InputCheckbox @bind-Value="Model.IsGlobal" class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                    <span>Global</span>
                </label>

                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200">
                    <InputCheckbox @bind-Value="Model.IsSystemType" class="h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                    <span>System</span>
                </label>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 border-t border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 px-4 py-3">
            <button type="button"
                    @onclick="CancelAsync"
                    class="app-button app-button-neutral app-button-sm">
                Cancel
            </button>

            <button type="submit"
                    disabled="@IsSaving"
                    class="app-button app-button-primary app-button-sm">
                @(IsSaving ? "Saving…" : IsEdit ? "Save Changes" : "Create Leave Type")
            </button>
        </div>
    </EditForm>
</section>

@code {
    [Parameter] public IReadOnlyList<LeaveRequestTypeOption> RequestTypes { get; set; } = [];
    [Parameter, EditorRequired] public LeaveTypeCatalogueSaveRequest Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task SaveAsync() => OnSave.InvokeAsync();
    private Task CancelAsync() => OnCancel.InvokeAsync();
}
