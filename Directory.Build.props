<Project>
  <PropertyGroup>
    <!-- Prevent offline/restricted-network NuGet vulnerability feed lookup (NU1900) from failing restore or build. -->
    <NuGetAudit>false</NuGetAudit>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
</Project>
