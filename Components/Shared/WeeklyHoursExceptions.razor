@inject HRM.Services.WeeklyHourExceptionService Requests
@inject HRM.Services.ToastService Toasts
@inject ILogger<WeeklyHoursExceptions> Logger

<section class="space-y-3 rounded-xl border p-4">
    <div class="flex flex-wrap items-center justify-between gap-2"><h3 class="font-semibold">@(PendingOnly ? "Pending weekly hours exceptions" : "Weekly hours exception requests")</h3><button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Refresh</button></div>
    @if (!PendingOnly)
    {
        <p class="text-sm text-slate-500">Request approval to excuse a weekly shortfall. Approval follows your organisation's configured request flow. Approved exceptions reduce hours owed and cannot create overtime.</p>
        <div class="flex flex-wrap items-end gap-3"><label class="text-sm">Week containing<InputDate @bind-Value="week" class="mt-1 block rounded border bg-transparent p-2" /></label><label class="text-sm">Hours to excuse<input type="number" min="0.25" max="168" step="0.25" @bind="hours" class="mt-1 block rounded border bg-transparent p-2" /></label></div>
        <label class="block text-sm">Reason<textarea @bind="reason" rows="2" maxlength="1000" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label>
        <button class="app-button app-button-primary" disabled="@busy" @onclick="SubmitAsync">Submit for approval</button>
    }
    @if (error != null) { <p role="alert" class="text-sm">@error</p> }
    @if (busy) { <p role="status" class="text-sm">Loading…</p> }
    @foreach (var row in rows)
    {
        <article class="space-y-2 border-t pt-3 text-sm" @key="row.Id">
            <p class="font-semibold">@row.Reference · @row.Staff</p>
            <p>Week of @row.WeekStart.ToString("dd MMM yyyy") · @((row.Minutes / 60m).ToString("0.##")) hours</p><p>@row.Reason</p><p class="font-medium">@row.Status</p>
            @if (row.CanApprove || row.CanCancel)
            {
                <label class="block">Action comment<textarea @bind="comments[row.Id]" rows="2" maxlength="2000" class="mt-1 block w-full rounded border bg-transparent p-2"></textarea></label>
                <div class="flex flex-wrap gap-2">@if (row.CanApprove) { <button class="app-button app-button-primary" disabled="@busy" @onclick='() => ActAsync(row, "Approve")'>Approve stage</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='() => ActAsync(row, "Reject")'>Reject</button> } @if (row.CanCancel) { <button class="app-button app-button-secondary" disabled="@busy" @onclick='() => ActAsync(row, "Cancel")'>Cancel request</button> }</div>
            }
        </article>
    }
    @if (!busy && rows.Count == 0 && error == null) { <p class="text-sm text-slate-500">No weekly hours exception requests.</p> }
</section>

@code {
    [Parameter] public bool PendingOnly { get; set; }
    private List<HRM.Services.WeeklyHourExceptionRow> rows = [];
    private Dictionary<int, string?> comments = [];
    private DateTime week = DateTime.UtcNow.AddHours(5).Date;
    private decimal hours;
    private string reason = "";
    private string? error;
    private bool busy;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { busy = true; error = null; try { rows = await Requests.LoadAsync(PendingOnly); foreach (var r in rows) comments.TryAdd(r.Id, null); } catch (Exception ex) { Logger.LogError(ex, "Weekly exceptions could not load"); error = "Requests could not be loaded. Please refresh or contact HR."; } finally { busy = false; } }
    private async Task SubmitAsync() { if (busy) return; if (hours is < 0.25m or > 168m) { error = "Enter hours between 0.25 and 168."; return; } busy = true; error = null; var saved = false; try { var result = await Requests.SubmitAsync(week, (int)Math.Round(hours * 60), reason); saved = result.Success; if (saved) { Toasts.Success(result.Message); reason = ""; hours = 0; } else error = result.Message; } catch (Exception ex) { Logger.LogError(ex, "Weekly exception submission failed"); error = "Your request could not be submitted. Please contact HR."; } finally { busy = false; } if (saved) await LoadAsync(); }
    private async Task ActAsync(HRM.Services.WeeklyHourExceptionRow row, string action) { if (busy) return; busy = true; error = null; var saved = false; try { var result = await Requests.ActAsync(row.Id, row.StateId, action, comments.GetValueOrDefault(row.Id)); saved = result.Success; if (saved) Toasts.Success(result.Message); else error = result.Message; } catch (Exception ex) { Logger.LogError(ex, "Weekly exception action failed"); error = "This action could not be completed. Refresh and try again."; } finally { busy = false; } if (saved) await LoadAsync(); }
}
