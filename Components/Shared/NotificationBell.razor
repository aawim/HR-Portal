@implements IDisposable
@inject HRM.Services.RequestNotificationService Notifications
@inject NavigationManager Navigation
@inject ILogger<NotificationBell> Logger

<div class="relative" @onkeydown="OnKeyDown">
    <button type="button" class="relative z-50 rounded-lg p-2 text-slate-600 hover:bg-slate-50"
            aria-label="@(error != null ? "Notifications unavailable, open to retry" : $"Notifications, {inbox.UnreadCount} unread")" aria-expanded="@open.ToString().ToLowerInvariant()"
            aria-controls="notification-inbox" @onclick="ToggleAsync">
        <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
        @if (inbox.UnreadCount > 0)
        {
            <span aria-hidden="true" class="absolute -right-1 -top-1 min-w-5 rounded-full bg-red-600 px-1 py-0.5 text-center text-xs font-semibold text-white">@(inbox.UnreadCount > 99 ? "99+" : inbox.UnreadCount.ToString())</span>
        }
        else if (error != null)
        {
            <span aria-hidden="true" class="absolute -right-1 -top-1 rounded-full bg-amber-500 px-1.5 text-xs font-semibold text-white">!</span>
        }
    </button>
    <span class="sr-only" role="status" aria-live="polite">@inbox.UnreadCount unread notifications</span>
    @if (open)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
        <section id="notification-inbox" aria-label="Request notifications" class="absolute right-0 top-full z-50 mt-2 w-[min(24rem,calc(100vw-2rem))] overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 p-4">
                <h2 class="text-sm font-semibold text-slate-900">Notifications</h2>
                @if (inbox.UnreadCount > 0)
                {
                    <button type="button" class="text-xs text-blue-700 disabled:opacity-50" disabled="@saving" @onclick="MarkAllAsync">Mark all as read</button>
                }
            </div>
            @if (error != null)
            {
                <div role="alert" class="p-4 text-sm text-red-700">@error <button type="button" class="underline" @onclick="RefreshAsync">Retry</button></div>
            }
            else if (loading && inbox.Items.Count == 0) { <p class="p-4 text-sm text-slate-500">Loading notifications…</p> }
            else if (inbox.Items.Count == 0) { <p class="p-4 text-sm text-slate-500">No notifications yet. Assigned actions and request status changes will appear here.</p> }
            else
            {
                <ul class="m-0 max-h-96 list-none divide-y divide-slate-100 overflow-y-auto p-0">
                    @foreach (var item in inbox.Items)
                    {
                        <li @key="item.Id">
                            <div class="w-full select-text p-4 text-left @(item.IsRead ? "" : "bg-blue-50")">
                                <span class="flex items-start justify-between gap-2">
                                    <span class="text-sm font-semibold text-slate-900">@item.Reference</span>
                                    @if (!item.IsRead) { <span class="shrink-0 rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-700">New</span> }
                                </span>
                                @if (item.Message != null)
                                {
                                    <span class="mt-1 block text-sm text-slate-700">@item.Message</span>
                                    <span class="mt-1 block text-xs text-slate-500">@item.ToState</span>
                                }
                                else if (item.ActionStage != null)
                                {
                                    <span class="mt-1 block text-sm font-semibold text-blue-700">Action required · @item.ActionStage</span>
                                    <span class="mt-1 block text-sm text-slate-700">@item.ToState</span>
                                }
                                else
                                {
                                    <span class="mt-1 block text-sm text-slate-700">@item.FromState → @item.ToState</span>
                                }
                                <time class="mt-2 block text-xs text-slate-500" datetime="@item.CreatedAtUtc.ToString("O")">@item.CreatedAtUtc.AddHours(5).ToString("dd MMM yyyy, HH:mm") · Maldives</time>
                                <div class="mt-3 flex flex-wrap items-center gap-3">
                                    <button type="button" disabled="@saving" class="rounded border px-2 py-1 text-xs text-blue-700 disabled:opacity-50" @onclick="() => OpenAsync(item)">Open notification</button>
                                    <button type="button" class="rounded border px-2 py-1 text-xs text-slate-700" data-notification-copy="@CopyText(item)" aria-label="Copy notification message">Copy message</button>
                                    <span data-notification-copy-status role="status" aria-live="polite" class="text-xs text-slate-600"></span>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <p class="m-0 border-t border-slate-100 px-4 py-2 text-xs text-slate-500">Latest 30 updates · Open a notification to view details</p>
            }
        </section>
    }
</div>

@code {
    private HRM.Services.RequestNotificationInbox inbox = new(0, []);
    private readonly CancellationTokenSource cancellation = new();
    private bool open, loading, saving, disposed;
    private string? error;
    private static string CopyText(HRM.Services.RequestNotificationItem item) => string.Join("\n",
        new[] { item.Reference, item.Message, item.ActionStage,
            string.IsNullOrWhiteSpace(item.FromState) ? item.ToState : $"{item.FromState} → {item.ToState}",
            item.CreatedAtUtc.AddHours(5).ToString("dd MMM yyyy, HH:mm") + " · Maldives" }
        .Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAsync();
        if (!disposed) { StateHasChanged(); _ = WatchAsync(); }
    }

    private async Task WatchAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
                await InvokeAsync(async () => { await RefreshAsync(); if (!disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { Logger.LogError(ex, "Notification refresh stopped"); }
    }

    private async Task RefreshAsync()
    {
        if (loading || disposed) return;
        loading = true;
        try { inbox = await Notifications.GetInboxAsync(cancellation.Token); error = null; }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex)
        {
            inbox = new(0, []);
            error = "Notifications could not be loaded.";
            Logger.LogWarning(ex, "Could not load request notifications");
        }
        finally { loading = false; }
    }

    private async Task ToggleAsync() { open = !open; if (open) await RefreshAsync(); }
    private void Close() => open = false;
    private void OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") Close(); }
    private async Task MarkAllAsync()
    {
        if (saving) return;
        saving = true;
        try { await Notifications.MarkReadAsync(token: cancellation.Token); await RefreshAsync(); }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex) { error = "Could not mark notifications as read. Please try again."; Logger.LogWarning(ex, "Could not mark notifications read"); }
        finally { saving = false; }
    }
    private async Task OpenAsync(HRM.Services.RequestNotificationItem item)
    {
        if (saving) return;
        saving = true;
        try
        {
            await Notifications.MarkReadAsync(item.Id, cancellation.Token);
            await RefreshAsync();
            Close();
            Navigation.NavigateTo(item.Url);
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex) { error = "Could not open this notification. Please try again."; Logger.LogWarning(ex, "Could not open notification"); }
        finally { saving = false; }
    }
    public void Dispose() { disposed = true; cancellation.Cancel(); }
}
