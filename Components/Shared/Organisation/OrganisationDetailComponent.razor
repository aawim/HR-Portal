<HRM.Components.Shared.LegacyCrudRedirect Url="@Target" Label="Organisation management" />
@code {
    [Parameter] public int BusinessEntityId { get; set; }
    [Parameter] public EventCallback<int> OnDetailsSaved { get; set; }
    private string Target => BusinessEntityId > 0 ? $"/admin/settings/org/manage/{BusinessEntityId}/edit" : "/admin/settings/org/manage";
}
