<HRM.Components.Shared.LegacyCrudRedirect Url="@Target" Label="Organisation address management" />
@code {
    [Parameter] public int BusinessEntityId { get; set; }
    [Parameter] public EventCallback OnAddressSaved { get; set; }
    private string Target => BusinessEntityId > 0 ? $"/admin/settings/org/manage/{BusinessEntityId}/address" : "/admin/settings/org/locations";
}
