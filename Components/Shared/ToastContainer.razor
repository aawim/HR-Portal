@implements IDisposable
@using HRM.Services
@inject ToastService ToastService

<div class="app-toast-region" aria-label="Notifications">
    @foreach (var item in items)
    {
        <div @key="item" class="app-toast app-toast--@item.Message.Type.ToString().ToLowerInvariant()"
             role="@(item.Message.Type == ToastType.Error ? "alert" : "status")" aria-atomic="true"
             @onmouseenter="() => Pause(item)" @onmouseleave="() => Resume(item)"
             @onfocusin="() => Pause(item)" @onfocusout="() => Resume(item)">
            <span class="app-toast-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    @if (item.Message.Type == ToastType.Success)
                    {
                        <circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" />
                    }
                    else if (item.Message.Type == ToastType.Warning)
                    {
                        <path d="m12 3 10 18H2L12 3Z" /><path d="M12 9v4m0 4h.01" />
                    }
                    else if (item.Message.Type == ToastType.Error)
                    {
                        <circle cx="12" cy="12" r="9" /><path d="m9 9 6 6m0-6-6 6" />
                    }
                    else
                    {
                        <circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10h.01" />
                    }
                </svg>
            </span>
            <div class="app-toast-content">
                <div class="app-toast-title">@item.Message.Title</div>
                <p class="app-toast-message">@item.Message.Message</p>
            </div>
            <button type="button" class="app-toast-close" aria-label="Dismiss notification" @onclick="() => Dismiss(item)">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M6 18 18 6" /></svg>
            </button>
        </div>
    }
</div>

@code {
    private sealed class VisibleToast(ToastMessage message)
    {
        public ToastMessage Message { get; } = message;
        public CancellationTokenSource? Timer { get; set; }
    }

    private readonly List<VisibleToast> items = new();
    private bool disposed;

    protected override void OnInitialized() => ToastService.OnShow += ShowToast;

    private void ShowToast(ToastMessage message)
    {
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            if (items.Count >= 5) Dismiss(items[0]);
            var item = new VisibleToast(message);
            items.Add(item);
            Resume(item);
            StateHasChanged();
        });
    }

    private void Pause(VisibleToast item)
    {
        item.Timer?.Cancel();
        item.Timer?.Dispose();
        item.Timer = null;
    }

    private void Resume(VisibleToast item)
    {
        if (disposed || !items.Contains(item)) return;
        Pause(item);
        item.Timer = new CancellationTokenSource();
        _ = ExpireAsync(item, item.Timer.Token);
    }

    private async Task ExpireAsync(VisibleToast item, CancellationToken token)
    {
        try
        {
            await Task.Delay(item.Message.Type is ToastType.Error or ToastType.Warning ? 10000 : 6000, token);
            await InvokeAsync(() =>
            {
                if (disposed || token.IsCancellationRequested) return;
                Dismiss(item);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
    }

    private void Dismiss(VisibleToast item)
    {
        Pause(item);
        items.Remove(item);
    }

    public void Dispose()
    {
        disposed = true;
        ToastService.OnShow -= ShowToast;
        foreach (var item in items) Pause(item);
        items.Clear();
    }
}
