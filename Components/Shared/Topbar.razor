@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HRM.Models.HrmTeContext> DbFactory
@inject ILogger<Topbar> Logger
<header class="h-16 bg-white shadow-sm flex items-center justify-between px-6 relative z-50">

    <!-- LEFT SIDE: Search Bar -->
    <AuthorizeView>
        <Authorized>
            <div class="flex-1 max-w-md hidden sm:block">
                <div class="relative">
                    @* <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </span> *@
                    @* <input type="text" class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-slate-50" placeholder="Search employees, documents..." /> *@
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="flex-1"></div>
        </NotAuthorized>
    </AuthorizeView>

    <!-- RIGHT SIDE: Actions & Auth -->
    <div class="flex items-center gap-4 pl-4 w-full sm:w-auto justify-end">
        <ThemeToggle />

        <div class="text-sm text-slate-500 hidden lg:block">
            @DateTime.Now.ToString("dddd, yyyy-MM-dd h:mm tt")
        </div>

        <AuthorizeView>
            <Authorized>
                @if (HasSystemAccess)
                {
                <NotificationBell />

                <!-- Profile Dropdown Container -->
                <div class="relative border-l border-slate-200 pl-4 ml-2">

                    <!-- Trigger Button -->
                    <button type="button" @onclick="ToggleProfileMenu" aria-label="Employee menu" aria-expanded="@isProfileMenuOpen.ToString().ToLowerInvariant()" aria-controls="employee-menu" class="flex items-center gap-3 focus:outline-none hover:bg-slate-50 p-1 pr-2 rounded-lg transition-colors relative z-50">
                        <img src="https://i.pravatar.cc/150?img=32" alt="Profile" class="w-9 h-9 rounded-full border-2 border-blue-100 object-cover" />
                        <div class="hidden md:block text-left">
                            <p class="max-w-[16rem] truncate text-sm font-semibold text-slate-700" title="@UserName">Hello, @UserName!</p>
                            <p class="max-w-[16rem] truncate text-xs text-slate-500" title="@UserGroupLabel">@UserGroupLabel</p>
                        </div>
                        <svg class="w-4 h-4 text-slate-400 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <!-- Dropdown Menu -->
                    @if (isProfileMenuOpen)
                    {
                        <!-- Invisible Backdrop to catch clicks -->
                        <div class="fixed inset-0 z-40 cursor-default" @onclick="CloseProfileMenu"></div>

                        <!-- Menu Box -->
                        @* <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-slate-100 py-1 z-50 relative"> *@
                        <div id="employee-menu" class="absolute right-0 top-full mt-2 w-48 bg-white rounded-lg shadow-lg border border-slate-100 py-1 z-50">
                            <div class="border-b border-slate-100 px-4 py-2 md:hidden"><p class="break-words text-sm font-semibold text-slate-700">@UserName</p><p class="mt-1 break-words text-xs text-slate-500">@UserGroupLabel</p></div>
                            <a href="/profile" @onclick="CloseProfileMenu" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                My Profile
                            </a>
                            <a href="/settings" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /></svg>
                                Settings
                            </a>

                            <div class="border-t border-slate-100 my-1"></div>

                            <form action="/Online/Auth/Logout" method="post" class="m-0">
                                <AntiforgeryToken />
                                <button type="submit" class="w-full flex items-center gap-2 px-4 py-2 text-sm text-rose-600 hover:bg-rose-50 transition-colors text-left">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                    Log Out
                                </button>
                            </form>
                        </div>
                    }
                </div>
                }
                else
                {
                    <a href="/Online/Auth/NoAccessLogout" class="text-sm underline">Sign out</a>
                }
            </Authorized>

            <NotAuthorized>
                <a href="/Online/Auth/login" class="text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg shadow-sm transition-colors">Log In</a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</header>

@code {
    [Parameter] public bool HasSystemAccess { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string UserName = "";
    private List<string> userGroups = [];
    private string UserGroupLabel => userGroups.Count == 0 ? "Employee" : string.Join(" · ", userGroups);
    private (string Username, bool Access)? loadedIdentity;
    private int groupLoadVersion;
    private bool isProfileMenuOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            var username = user.Identity?.IsAuthenticated == true ? user.FindFirst("idnumber")?.Value ?? "" : "";
            UserName = user.Identity?.IsAuthenticated == true ? user.FindFirst("full_name")?.Value ?? user.Identity.Name ?? "User" : "";
            var identity = (username, HasSystemAccess);
            if (loadedIdentity == identity) return;
            loadedIdentity = identity;
            var version = ++groupLoadVersion;
            userGroups = [];
            if (HasSystemAccess && !string.IsNullOrWhiteSpace(username))
            {
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var groups = await db.UserAssignedUserGroups.AsNoTracking()
                        .Where(g => g.User.Username == username && g.User.IsActive && g.User.LocalUserStateId == 1 &&
                            (g.UserGroup.IsGlobal || g.UserGroup.UserOrganisationId == g.User.UserOrganisationId))
                        .Select(g => g.UserGroup.GroupName).Distinct().OrderBy(g => g).ToListAsync();
                    if (version == groupLoadVersion) userGroups = groups;
                }
                catch (Exception ex) { Logger.LogWarning(ex, "Could not load current user's group labels"); }
            }
        }
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    private void CloseProfileMenu()
    {
        isProfileMenuOpen = false;
    }
}
