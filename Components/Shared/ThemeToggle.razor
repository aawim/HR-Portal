@inject HRM.Services.UserPreferenceService Preferences
@inject IJSRuntime JS
@inject ILogger<ThemeToggle> Logger

<div class="relative">
    <button type="button" data-theme-toggle class="theme-toggle" disabled="@(!_ready || _saving)"
            @onclick="ToggleAsync" aria-label="Switch colour theme" title="Switch colour theme" aria-describedby="@(_error == null ? null : "theme-error")">
        <svg class="theme-icon-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
        <svg class="theme-icon-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" />
        </svg>
    </button>
    @if (_error != null)
    {
        <div id="theme-error" role="alert" class="absolute right-0 top-full mt-2 w-64 rounded border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700 z-50">
            @_error
            @if (!_ready) { <button type="button" class="underline ml-2" @onclick="LoadAsync">Retry</button> }
        </div>
    }
</div>

@code {
    private int? _userId;
    private bool _ready, _saving;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await LoadAsync(); StateHasChanged(); }
    }

    private async Task LoadAsync()
    {
        try
        {
            var settings = await Preferences.GetThemeAsync();
            _userId = settings.UserId;
            await JS.InvokeVoidAsync("hrmTheme.initialize", settings.ThemeMode, _userId);
            _ready = true;
            _error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load theme preference");
            _error = "Your theme setting could not be loaded.";
        }
    }

    private async Task ToggleAsync()
    {
        if (!_ready || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            var current = await JS.InvokeAsync<string>("hrmTheme.get");
            var next = current == "dark" ? "light" : "dark";
            if (_userId.HasValue) await Preferences.SaveThemeAsync(next, _userId.Value);
            await JS.InvokeVoidAsync("hrmTheme.set", next);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save theme preference");
            _error = "Your theme setting could not be saved. Please try again or reload the page.";
        }
        finally { _saving = false; }
    }
}
