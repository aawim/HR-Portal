@implements IDisposable

@using HRM.Services
@using HRM.Services.Interfaces

@inject IUserContext UserContext
@inject PortalContext PortalContext
@inject NavigationManager NavManager

@if (CanAccessAdminPortal && PortalContext.CanAccessAdminPortal)
{
    <div class="portal-switch-container">
        <button type="button" role="switch" class="portal-switch"
                aria-label="Admin portal" aria-checked="@(PortalContext.IsAdminPortal ? "true" : "false")"
                title="@(PortalContext.IsAdminPortal ? "Switch to Self" : "Switch to Admin")"
                disabled="@switching" @onclick="TogglePortalAsync">
            <span class="portal-label @(!PortalContext.IsAdminPortal ? "selected" : "")">Self</span>
            <span class="portal-track @(PortalContext.IsAdminPortal ? "admin" : "")" aria-hidden="true"><span class="portal-thumb"></span></span>
            <span class="portal-label @(PortalContext.IsAdminPortal ? "selected" : "")">Admin</span>
        </button>
    </div>
}

@code
{
    [Parameter] public bool CanAccessAdminPortal { get; set; }
    private bool switching;
    private async Task TogglePortalAsync()
    {
        if (switching || !CanAccessAdminPortal || !PortalContext.CanAccessAdminPortal) return;
        switching = true;
        try
        {
            if (PortalContext.IsAdminPortal) SwitchToSelf();
            else await SwitchToOrganisation();
        }
        finally { switching = false; }
    }
    protected override async Task OnInitializedAsync()
    {
        var session = await UserContext.GetSessionAsync();
        PortalContext.Initialize(session?.OrganisationId, session?.OrganisationName ?? "", session?.CanAccessAdminPortal == true);

        DetermineContextFromUrl();

        PortalContext.OnChange += Refresh;
    }

    private void DetermineContextFromUrl()
    {
        var path = new Uri(NavManager.Uri).AbsolutePath.ToLower();

        if (path == "/admin" || path.StartsWith("/admin/"))
            PortalContext.SwitchToAdmin();
        else
            PortalContext.SwitchToEmployee();
    }

    private void SwitchToSelf()
    {
        PortalContext.SwitchToEmployee();

        NavManager.NavigateTo("/", forceLoad: true);
    }

    private async Task SwitchToOrganisation()
    {
        if (!CanAccessAdminPortal) return;
        var session = await UserContext.GetSessionAsync();
        PortalContext.Initialize(session?.OrganisationId, session?.OrganisationName ?? "", session?.CanAccessAdminPortal == true);
        if (!PortalContext.CanAccessAdminPortal) return;
        PortalContext.SwitchToAdmin();

        NavManager.NavigateTo("/admin", forceLoad: true);
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PortalContext.OnChange -= Refresh;
    }
}
