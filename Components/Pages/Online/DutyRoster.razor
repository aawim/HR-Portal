@page "/online/duty-roster"
@page "/admin/work-planning/duty-roster"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HRM.DTOs.WorkPlanning
@inject HRM.WorkPlanning.Services.DutyRosterService Duties

<PageTitle>Duty roster</PageTitle>
<div class="space-y-4 p-4">
    <header class="flex flex-wrap items-center justify-between gap-3">
        <div><h1 class="text-xl font-semibold">Duty roster</h1><p class="text-sm text-slate-500">View dated duties and arrange transfers or swaps.</p></div>
        <div class="flex flex-wrap items-center gap-2">
            <label>Date <InputDate @bind-Value="date" class="rounded border bg-transparent p-2" /></label>
            <button class="app-button app-button-secondary" disabled="@busy" @onclick="TodayAsync">Today</button>
            <button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadAsync">Show roster</button>
        </div>
    </header>
    @if (message != null) { <p role="status" class="rounded border p-3">@message</p> }
    <section class="rounded-xl border p-4">
        <label class="block mb-3">Search staff, department or duty <input @bind="search" @bind:event="oninput" class="rounded border bg-transparent p-2" /></label>
        <div class="overflow-x-auto"><table class="w-full text-left text-sm">
            <thead><tr class="border-b"><th class="p-2">Staff / Department</th><th class="p-2">Duty</th><th class="p-2">Time</th><th class="p-2">Clock events</th><th class="p-2">Actions</th></tr></thead>
            <tbody>@foreach (var row in roster.Where(x => string.IsNullOrWhiteSpace(search) || $"{x.Staff} {x.Department} {x.Duty}".Contains(search, StringComparison.OrdinalIgnoreCase)))
            {
                <tr class="border-b"><td class="p-2">@row.Staff<div class="text-xs text-slate-500">@row.Department</div></td><td class="p-2">@row.Duty</td>
                    <td class="p-2 whitespace-nowrap">@row.Start.ToString("dd MMM HH:mm") – @row.End.ToString("dd MMM HH:mm")</td>
                    <td class="p-2">@(row.RequiresAttendance ? "Check in" : "No mandatory check in") @(row.RequiresCheckout ? " · Check out" : "")</td>
                    <td class="p-2">@if(row.CanRequest) { <button class="app-button app-button-secondary" disabled="@busy" @onclick="() => Select(row)">Transfer / Swap</button> }</td></tr>
            }</tbody>
        </table></div>
        @if (roster.Count == 0) { <p class="py-3">No duties for this date.</p> }
    </section>
    @if (selected != null)
    {
        <section class="space-y-3 rounded-xl border p-4" aria-label="Arrange duty change">
            <h2 class="font-semibold">Change @selected.Staff’s @selected.Duty · @selected.Start.ToString("dd MMM HH:mm")</h2>
            <p class="text-sm">Both staff members must accept separately. The supervisor then approves the final roster change.</p>
            <div class="flex flex-wrap gap-3">
                <label>Request <select @bind="kind" class="block rounded border bg-transparent p-2"><option>Transfer</option><option>Swap</option></select></label>
                <label>Receiving staff <select @bind="targetJob" class="block rounded border bg-transparent p-2"><option value="0">Select staff</option>
                    @foreach(var p in partners.Where(x => x.IndividualId != selected.IndividualId)) { <option value="@p.JobId">@p.Name</option> }</select></label>
                @if(kind == "Swap")
                {
                    <label>Other duty date <InputDate @bind-Value="swapDate" class="block rounded border bg-transparent p-2" /></label>
                    <button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadSwapAsync">Find duties</button>
                    <label>Duty to exchange <select @bind="swapId" class="block rounded border bg-transparent p-2"><option value="0">Select duty</option>
                        @foreach(var r in swaps.Where(x => x.JobId == targetJob && x.Start > DateTime.UtcNow.AddHours(5)))
                        { <option value="@r.AssignmentId">@r.Duty · @r.Start.ToString("dd MMM HH:mm")–@r.End.ToString("HH:mm")</option> }</select></label>
                }
            </div>
            <label class="block">Reason <textarea @bind="reason" maxlength="500" class="block w-full rounded border bg-transparent p-2"></textarea></label>
            <div class="flex flex-wrap gap-2"><button class="app-button app-button-primary" disabled="@(busy || targetJob == 0 || string.IsNullOrWhiteSpace(reason) || (kind == "Swap" && swapId == 0))" @onclick="SubmitAsync">Send for acceptance</button>
                <button class="app-button app-button-secondary" disabled="@busy" @onclick="() => selected = null">Close</button></div>
        </section>
    }
    <section class="space-y-3 rounded-xl border p-4" id="requests">
        <h2 class="font-semibold">Duty requests</h2>
        <p class="text-sm text-slate-500">Your requests and requests assigned to you. Completed requests remain visible.</p>
        <label class="block">Action comment (required where configured) <input @bind="comment" maxlength="2000" class="rounded border bg-transparent p-2" /></label>
        @foreach(var request in requests)
        {
            <article class="space-y-2 rounded border p-3" @key="request.Id">
                <div class="flex flex-wrap justify-between gap-2"><strong>@request.Reference · @request.Kind</strong><span>@request.Status</span></div>
                <p>@request.Source → @request.Target · @request.Start.ToString("dd MMM yyyy HH:mm")–@request.End.ToString("HH:mm")</p>
                @if(request.SwapStart.HasValue) { <p>In exchange: @request.SwapStart.Value.ToString("dd MMM yyyy HH:mm")–@request.SwapEnd?.ToString("HH:mm")</p> }
                <p class="text-sm">@request.Source: @request.SourceAcceptance · @request.Target: @request.TargetAcceptance
                    @if(request.Stage != null) { <span> · Approval: @request.Stage</span> }</p><p class="text-sm">@request.Reason</p>
                <div class="flex flex-wrap gap-2">
                    @if(request.CanAccept) { <button class="app-button app-button-primary" disabled="@busy" @onclick='() => ActAsync(request, "Accept")'>Accept</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='() => ActAsync(request, "Decline")'>Decline</button> }
                    @if(request.CanApprove) { <button class="app-button app-button-primary" disabled="@busy" @onclick='() => ActAsync(request, "Approve")'>Approve</button><button class="app-button app-button-secondary" disabled="@busy" @onclick='() => ActAsync(request, "Reject")'>Reject</button> }
                    @if(request.CanCancel) { <button class="app-button app-button-secondary" disabled="@busy" @onclick='() => ActAsync(request, "Cancel")'>Cancel request</button> }
                </div>
            </article>
        }
        @if(requests.Count == 0) { <p>No duty requests.</p> }
    </section>
</div>

@code {
    DateTime date = DateTime.UtcNow.AddHours(5).Date, swapDate = DateTime.UtcNow.AddHours(5).Date;
    bool busy; string? message; string search = "", kind = "Transfer", reason = "", comment = "";
    int targetJob; long swapId; DutyRosterRow? selected;
    List<DutyRosterRow> roster = [], swaps = []; List<DutyPartner> partners = []; List<DutyRequestRow> requests = [];
    protected override Task OnInitializedAsync() => LoadAsync();
    async Task LoadAsync() { busy = true; try { roster = await Duties.GetRosterAsync(date); partners = await Duties.GetPartnersAsync(); requests = await Duties.GetRequestsAsync(); }
        catch(Exception ex) when(ex is InvalidOperationException or UnauthorizedAccessException) { message = ex.Message; }
        catch(Exception) { message = "The roster could not be loaded. Please try again."; } finally { busy = false; } }
    async Task TodayAsync() { date = DateTime.UtcNow.AddHours(5).Date; await LoadAsync(); }
    void Select(DutyRosterRow row) { selected = row; targetJob = 0; swapId = 0; swaps = []; reason = ""; kind = "Transfer"; swapDate = row.Start.Date; }
    async Task LoadSwapAsync() { busy = true; try { swaps = await Duties.GetRosterAsync(swapDate); swapId = 0; } catch(Exception) { message = "Could not load duties for exchange."; } finally { busy = false; } }
    async Task SubmitAsync() { if(selected == null || busy) return; busy = true;
        try { var result = await Duties.SubmitAsync(new(selected.AssignmentId, targetJob, kind == "Swap" ? swapId : null, reason)); message = result.Message; if(result.Success) selected = null; }
        catch(Exception) { message = "The request could not be saved. Refresh and try again."; } finally { busy = false; } await LoadAsync(); }
    async Task ActAsync(DutyRequestRow row, string action) { if(busy) return; busy = true;
        try { var result = await Duties.ActAsync(row.Id, row.StateId, action, comment); message = result.Message; comment = ""; }
        catch(Exception) { message = "The action could not be saved. Refresh and try again."; } finally { busy = false; } await LoadAsync(); }
}
