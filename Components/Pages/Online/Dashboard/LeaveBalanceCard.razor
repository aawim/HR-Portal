@using HRM.Models
@using HRM.Services
@using HRM.DTOs.Leave
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Services.Interfaces.JobLeaveTypes
@inject ILeaveService LeaveService
@inject IJobLeaveTypeService JobLeaveTypeService

<section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div>
            <h2 class="text-base font-semibold text-slate-800">Leave Balance</h2>
            <p class="mt-0.5 text-xs text-slate-500">Available leave days</p>
        </div>
        <div aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
            <i class="fas fa-calendar-alt"></i>
        </div>
    </div>
    @if (isLoading)
    {
        <p role="status" class="px-5 py-6 text-center text-sm text-slate-500">Loading leave balances...</p>
    }
    else if (jobTypes.Count == 0)
    {
        <p class="px-5 py-6 text-center text-sm text-slate-500">No leave balances found.</p>
    }
    else
    {
        <div class="max-h-[32rem] divide-y divide-slate-100 overflow-y-auto">
            @foreach (var balance in jobTypes)
            {
                var processing = processingLeaves.Where(x => x.LeaveTypeId == balance.LeaveTypeId).ToList();
                <div class="space-y-2 px-5 py-4">
                    <div class="flex items-start justify-between gap-3">
                        <h3 class="min-w-0 break-words text-sm font-semibold text-slate-800">@balance.LeaveTypeName</h3>
                        <span class="shrink-0 rounded-lg bg-blue-50 px-2.5 py-1 text-sm font-semibold tabular-nums text-blue-700">@balance.RemainingDays <span class="text-xs font-normal">days</span></span>
                    </div>
                    <dl class="grid grid-cols-2 gap-2 text-xs">
                        <div><dt class="text-slate-500">Last taken</dt><dd class="mt-0.5 text-slate-700">@(balance.LastLeaveTakenDate?.ToString("dd MMM yyyy") ?? "Never")</dd></div>
                        <div><dt class="text-slate-500">Renewed</dt><dd class="mt-0.5 text-slate-700">@(balance.RenewedDate?.ToString("dd MMM yyyy") ?? "N/A")</dd></div>
                    </dl>
                    @if (processing.Count > 0)
                    {
                        <div class="space-y-2">
                            @foreach (var request in processing)
                            {
                                <div class="rounded-lg bg-amber-50 p-2 text-xs text-amber-800">
                                    <p class="font-medium">@(string.IsNullOrWhiteSpace(request.StateName) ? "Processing" : request.StateName)</p>
                                    <p class="mt-0.5">@request.FromDate?.ToString("dd MMM yyyy") – @request.ToDate?.ToString("dd MMM yyyy")</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>
@code {

    private List<JobLeaveTypeDto> jobTypes = new();

    private List<ProcessingLeaveDto> processingLeaves = new();

    private bool isLoading = true;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var balances =
                await JobLeaveTypeService.GetJobLeaveType();

            // Only show active balances where
            // leave information has been updated.
            jobTypes = balances
                .Where(x =>
                    x.IsValid == true &&
                    x.IsLeaveInfoUpdated == true)
                .ToList();


            processingLeaves =
                await LeaveService.GetMyProcessingLeavesAsync();
        }
        finally
        {
            isLoading = false;
        }
    }
}