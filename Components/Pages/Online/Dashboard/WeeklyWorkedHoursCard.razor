@using HRM.DTOs.Attendance
@using HRM.Services.Interfaces
@inject IAttendanceService AttendanceService

<section class="flex min-w-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div>
            <h2 class="text-base font-semibold text-slate-800">Worked Hours</h2>
            <p class="mt-0.5 text-xs text-slate-500">Weekly attendance hours</p>
        </div>
        <div aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
            <i class="fas fa-clock"></i>
        </div>
    </div>
    <div class="flex flex-col gap-4 p-4">
        @if (isLoading)
        {
            <div role="status" class="flex min-h-40 flex-1 items-center justify-center gap-2 text-sm text-slate-500">
                <i aria-hidden="true" class="fas fa-spinner fa-spin text-blue-600"></i>
                Calculating worked hours...
            </div>
        }
        else if (errorMessage != null)
        {
            <p role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-700">@errorMessage</p>
        }
        else if (workedHours == null)
        {
            <p class="py-10 text-center text-sm text-slate-500">No attendance information available.</p>
        }
        else
        {
            <div class="rounded-lg bg-blue-50 p-4">
                <p class="text-xs font-medium text-slate-500">This week</p>
                <p class="mt-2 text-3xl font-bold tabular-nums tracking-tight text-slate-900">@FormatHours(workedHours.CurrentWeekHours)</p>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm text-slate-500">Last week</p>
                <p class="text-sm font-semibold tabular-nums text-slate-800">@FormatHours(workedHours.PreviousWeekHours)</p>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-4">
                <span class="text-xs text-slate-500">Weekly difference</span>
                <span class="flex items-center gap-1.5">
                    <i aria-hidden="true" class="@GetDifferenceIcon()"></i>
                    <span class="@GetDifferenceClass()">@(GetDifferencePrefix() + FormatHours(Math.Abs(workedHours.DifferenceHours)))</span>
                </span>
            </div>
        }
    </div>
</section>
@code {

    private WeeklyWorkedHoursDto? workedHours;

    private bool isLoading = true;
    [Parameter] public int RefreshKey { get; set; }
    private int lastRefreshKey = -1;
    private string? errorMessage;


    protected override async Task OnParametersSetAsync()
    {
        if (lastRefreshKey == RefreshKey) return;
        lastRefreshKey = RefreshKey;
        try
        {
            isLoading = true;
            errorMessage = null;

            workedHours =
                await AttendanceService
                    .GetMyWeeklyWorkedHoursAsync();
        }
        catch
        {
            workedHours = null;
            errorMessage = "Worked hours could not be loaded. Please refresh the page.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private static string FormatHours(decimal hours)
    {
        var totalMinutes =
            (int)Math.Round(hours * 60);

        var hour =
            totalMinutes / 60;

        var minute =
            totalMinutes % 60;

        return $"{hour}h {minute}m";
    }


    private string GetDifferencePrefix()
    {
        if (workedHours == null)
            return "";

        if (workedHours.DifferenceHours > 0)
            return "+";

        if (workedHours.DifferenceHours < 0)
            return "-";

        return "";
    }


    private string GetDifferenceClass()
    {
        if (workedHours == null)
            return "text-sm font-semibold text-slate-500";

        if (workedHours.DifferenceHours > 0)
        {
            return "text-sm font-semibold text-green-600";
        }

        if (workedHours.DifferenceHours < 0)
        {
            return "text-sm font-semibold text-red-600";
        }

        return "text-sm font-semibold text-slate-500";
    }


    private string GetDifferenceIcon()
    {
        if (workedHours == null)
            return "fas fa-minus text-slate-400 text-xs";

        if (workedHours.DifferenceHours > 0)
        {
            return "fas fa-arrow-up text-green-500 text-xs";
        }

        if (workedHours.DifferenceHours < 0)
        {
            return "fas fa-arrow-down text-red-500 text-xs";
        }

        return "fas fa-minus text-slate-400 text-xs";
    }
}
