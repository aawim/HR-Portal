@using HRM.DTOs.Attendance
@using HRM.Enum
@using HRM.Services.Attendance.Abstraction
@using HRM.Services.Interfaces

@inject IUserAccessService UserAccessService
@inject IAttendanceService AttendanceService


<section class="min-w-0 overflow-hidden rounded-xl border bg-white shadow-sm" aria-label="Clock Events">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2">
        <div><h3 class="font-semibold">Clock Events</h3><p class="mt-1 text-xs text-slate-500">Physical attendance events recorded today</p></div>
        <span class="text-xs text-slate-500">@_attendanceLogs.Count @(_attendanceLogs.Count==1?"event":"events")</span>
    </div>
    <div class="space-y-2 px-4 py-2">
        @if(_isLoading){<p role="status" class="text-sm text-slate-500">Loading attendance...</p>}
        else if(!string.IsNullOrWhiteSpace(_errorMessage)){<p role="alert" class="text-sm text-amber-700 dark:text-amber-400">@_errorMessage</p>}
        else if(_attendanceLogs.Count==0){<p class="text-sm text-slate-500">No clock events yet. Today's clock events will appear here.</p>}
        else
        {
            <div class="divide-y space-y-2">
                @foreach(var group in _attendanceLogs.GroupBy(x=>new{Purpose=x.SchedulePurpose??"Unassigned",x.WorkAssignmentId,x.ScheduleName})
                    .OrderBy(g=>g.Key.Purpose=="Official"?0:g.Key.Purpose=="Duty"?1:2).ThenBy(g=>g.Min(x=>x.ScheduledStart??x.LogDateTime)))
                {
                    <section class="pt-2 first:pt-0" aria-label="@(group.Key.ScheduleName??group.Key.Purpose)">
                        <h4 class="break-words text-sm font-semibold">@(group.Key.ScheduleName??(group.Key.Purpose=="Unassigned"?"Unmatched events":group.Key.Purpose))</h4>
                        <ol class="mt-1 divide-y">
                            @foreach(var log in group.OrderByDescending(x=>x.LogDateTime))
                            {
                                <AttendanceEventRow Timestamp="log.LogDateTime" Event="@ClockEventName(log)" Condition="@ClockCondition(log)"
                                    Tone="@ClockTone(log)" Description="@(log.ClockType==AttendanceClockType.Unresolved?log.ResolutionMessage:null)" />
                            }
                        </ol>
                    </section>
                }
            </div>
        }
    </div>
</section>
@code {

    // ==============================================================
    // PARAMETERS
    // ==============================================================

    [Parameter]
    public int RefreshKey { get; set; }


    // ==============================================================
    // STATE
    // ==============================================================

    private static string ClockEventName(AttendanceRawLogDto log) => log.ClockType switch {
        AttendanceClockType.CheckIn => "Clock in", AttendanceClockType.CheckOut => "Clock out",
        _ => "Clock event" };
    private static string ClockCondition(AttendanceRawLogDto log) => log.ClockType switch {
        AttendanceClockType.CheckIn when log.LateMinutes > 0 => $"Late by {log.LateMinutes} {(log.LateMinutes == 1 ? "minute" : "minutes")}",
        AttendanceClockType.CheckIn when log.ScheduledStart.HasValue => "On time",
        AttendanceClockType.CheckIn or AttendanceClockType.CheckOut => "Recorded",
        AttendanceClockType.Ignored => "Ignored", _ => "Unresolved" };
    private static string ClockTone(AttendanceRawLogDto log) => log.ClockType switch {
        AttendanceClockType.CheckIn when log.LateMinutes > 0 => "late",
        AttendanceClockType.CheckIn => "success", AttendanceClockType.CheckOut => "info", _ => "muted" };

    private List<AttendanceRawLogDto> _attendanceLogs = [];

 


    private bool _isLoading = true;

    private string? _errorMessage;

    private int _lastRefreshKey = -1;


    // ==============================================================
    // COMPONENT LIFECYCLE
    //
    // Do NOT also load in OnInitializedAsync.
    //
    // OnParametersSetAsync runs during the initial render and whenever
    // RefreshKey changes.
    // ==============================================================

    protected override async Task OnParametersSetAsync()
    {
        if (_lastRefreshKey == RefreshKey)
            return;

        _lastRefreshKey = RefreshKey;

        await LoadAttendanceAsync();
    }


    // ==============================================================
    // LOAD TODAY'S ATTENDANCE
    // ==============================================================

    private async Task LoadAttendanceAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var context = await UserAccessService.RequireContextAsync();
            if (context.ActiveJob == null)
            {
                _errorMessage = "No active job is available for today's clock events.";
                return;
            }

            /*
            * This card represents TODAY.
                 *
            * Do not use the TimeClockCard test timestamp here.
                 * The TimeClockCard is responsible for creating clock events.
                 * This component only displays today's attendance.
            */
                            var attendanceTime = DateTime.UtcNow.AddHours(5);

            var logs =
                                await AttendanceService.GetLogsAsync(
                                    context.IndividualId,
                                    context.ActiveJob.JobId,
                                    attendanceTime);
 



            _attendanceLogs = logs?
                                .OrderBy(x => x.LogDateTime)
                                .ToList()
                                ?? [];
 
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _attendanceLogs = [];

        


            _errorMessage =
                "Clock events could not be loaded. Please refresh or contact HR.";
        }
        finally
        {
            _isLoading = false;
        }
    }


    // ==============================================================
    // FIRST CLOCK
    // ==============================================================

    private string FirstClockTime
    {
        get
        {
            if (_attendanceLogs.Count == 0)
                return "--";

            return _attendanceLogs
                .MinBy(x => x.LogDateTime)?
                .LogDateTime
                .ToString("hh:mm:ss tt")
                ?? "--";
        }
    }


    // ==============================================================
    // LATEST CLOCK
    // ==============================================================

    private string LatestClockTime
    {
        get
        {
            if (_attendanceLogs.Count == 0)
                return "--";

            return _attendanceLogs
                .MaxBy(x => x.LogDateTime)?
                .LogDateTime
                .ToString("hh:mm:ss tt")
                ?? "--";
        }
    }


    private static string FormatTime(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToString("hh:mm tt")
            : "--";
    }


    private static string FormatMinutes(int minutes)
    {
        if (minutes <= 0)
            return "--";

        var hours =
            minutes / 60;

        var remainingMinutes =
            minutes % 60;

        if (hours == 0)
            return $"{remainingMinutes}m";

        if (remainingMinutes == 0)
            return $"{hours}h";

        return $"{hours}h {remainingMinutes}m";
    }


 


    private static string GetStatusClass(
        AttendanceDailyStatus status)
    {
        const string baseClass =
            "inline-flex items-center rounded-full px-2.5 py-1 " +
            "text-xs font-medium ";

        return status switch
        {
            AttendanceDailyStatus.Present =>
                baseClass +
                "bg-green-100 text-green-700",

            AttendanceDailyStatus.InProgress =>
                baseClass +
                "bg-blue-100 text-blue-700",

            AttendanceDailyStatus.Absent =>
                baseClass +
                "bg-red-100 text-red-700",

            AttendanceDailyStatus.Incomplete =>
                baseClass +
                "bg-amber-100 text-amber-700",

            AttendanceDailyStatus.Partial =>
                baseClass +
                "bg-amber-100 text-amber-700",

            AttendanceDailyStatus.RestDay =>
                baseClass +
                "bg-slate-100 text-slate-600",

            AttendanceDailyStatus.Leave =>
                baseClass +
                "bg-blue-100 text-blue-700",

            AttendanceDailyStatus.Holiday =>
                baseClass +
                "bg-purple-100 text-purple-700",

            AttendanceDailyStatus.Future =>
                baseClass +
                "bg-slate-100 text-slate-500",

            _ =>
                baseClass +
                "bg-slate-100 text-slate-600"
        };
    }

        private static string GetIssueDotClass(
        AttendanceEvaluationIssueSeverity severity)
        {
            const string baseClass =
            "mt-1 h-2 w-2 shrink-0 rounded-full ";

            return severity switch
            {
                AttendanceEvaluationIssueSeverity.Error =>
                baseClass + "bg-red-500",

                AttendanceEvaluationIssueSeverity.Warning =>
                baseClass + "bg-amber-500",

                _ =>
                baseClass + "bg-blue-500"
            };
        }
}
