@using HRM.DTOs.Attendance
@using HRM.Enum
@using HRM.Services.Attendance.Abstraction
@using HRM.Services.Interfaces

@inject IUserAccessService UserAccessService
@inject IAttendanceService AttendanceService


<div class="h-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
 
    <div class="p-2">

        @if (_isLoading)
        {
            <!-- Loading -->
            <div class="flex   items-center justify-center">

                <div class="text-center">

                    <div class="mx-auto h-5 w-5 animate-spin
                            rounded-full border-2 border-slate-300
                            border-t-blue-600">
                    </div>

                    <div class="mt-2 text-xs text-slate-500">
                        Loading attendance...
                    </div>

                </div>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <!-- Error -->
            <div class="rounded-lg border border-red-200
                    bg-red-50 p-2">

                <div class="text-sm font-medium text-red-700">
                    Unable to load attendance
                </div>

                <div class="mt-1 text-xs text-red-600">
                    @_errorMessage
                </div>

            </div>
        }
        else
        {
     
            <!-- ====================================================
                 CLOCK EVENTS
                 ==================================================== -->

            <div class="">

                <div class="mb-3 flex items-center justify-between">

                    <div>
                        <div class="text-sm font-semibold text-slate-700">
                            Clock Events
                        </div>

                        <div class="mt-0.5 text-xs text-slate-500">
                            Physical attendance events recorded today
                        </div>
                    </div>

                    <span class="rounded-full bg-slate-100
                             px-2.5 py-1 text-xs font-medium
                             text-slate-600">

                        @_attendanceLogs.Count

                    </span>

                </div>


                @if (_attendanceLogs.Count == 0)
                {
                    <!-- No physical clock events -->

                    <div class="rounded-lg border border-dashed
                            border-slate-200 px-2 py-2">

                        <div class="text-center">

                            <div class="mx-auto flex h-9 w-9
                                    items-center justify-center
                                    rounded-full bg-slate-100">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="1.5"
                                     stroke="currentColor"
                                     class="h-5 w-5 text-slate-400">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0
                                         9 9 0 0 1 18 0Z" />

                                </svg>

                            </div>

                            <div class="mt-2 text-sm font-medium
                                    text-slate-600">
                                No clock events yet
                            </div>

                            <div class="mt-1 text-xs text-slate-400">
                                Today's clock events will appear here.
                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <!-- Physical Clock Events -->

                    <div class="space-y-2">

                        @foreach (var log in _attendanceLogs
                       .OrderByDescending(x => x.LogDateTime))
                        {
                            <div class="rounded-lg border border-slate-200
                                    bg-white px-2 py-3">

                                <div class="flex items-start
                                        justify-between gap-4">

                                    <!-- Left -->
                                    <div class="min-w-0">

                                        <div class="flex items-center gap-2">

                                            <span class="text-base font-semibold
                                                     text-slate-800">

                                                @(log.LogDateTime.ToString("hh:mm:ss tt"))

                                            </span>

                                        </div>


                                        <!-- Segment -->
                                        <div class="mt-1 text-xs text-slate-500">

                                            @if (!string.IsNullOrWhiteSpace(
                                           log.SegmentName))
                                            {
                                                <span>
                                                    @log.SegmentName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="italic
                                                         text-slate-400">
                                                    No matching segment
                                                </span>
                                            }

                                        </div>


                                        <!-- Resolution -->
                                        @if (!string.IsNullOrWhiteSpace(
                                       log.ResolutionMessage))
                                        {
                                            <div class="mt-2 text-xs
                                                    text-slate-500">

                                                @log.ResolutionMessage

                                            </div>
                                        }

                                    </div>


                                    <!-- Clock Type -->
                                    <div class="shrink-0">

                                        @if (log.ClockType ==
                                       AttendanceClockType.CheckIn)
                                        {
                                            <span class="inline-flex items-center
                                                     gap-1.5 rounded-full
                                                     bg-green-100 px-2.5 py-1
                                                     text-xs font-medium
                                                     text-green-700">

                                                <span class="h-1.5 w-1.5
                                                         rounded-full
                                                         bg-green-500">
                                                </span>

                                                Check In

                                            </span>
                                        }
                                        else if (log.ClockType ==
                                        AttendanceClockType.CheckOut)
                                        {
                                            <span class="inline-flex items-center
                                                     gap-1.5 rounded-full
                                                     bg-blue-100 px-2.5 py-1
                                                     text-xs font-medium
                                                     text-blue-700">

                                                <span class="h-1.5 w-1.5
                                                         rounded-full
                                                         bg-blue-500">
                                                </span>

                                                Check Out

                                            </span>
                                        }
                                        else if (log.ClockType ==
                                        AttendanceClockType.Ignored)
                                        {
                                            <span class="inline-flex items-center
                                                     gap-1.5 rounded-full
                                                     bg-amber-100 px-2.5 py-1
                                                     text-xs font-medium
                                                     text-amber-700">

                                                Ignored

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center
                                                     gap-1.5 rounded-full
                                                     bg-slate-100 px-2.5 py-1
                                                     text-xs font-medium
                                                     text-slate-600">

                                                Unresolved

                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        }

    </div>

</div>
@code {

    // ==============================================================
    // PARAMETERS
    // ==============================================================

    [Parameter]
    public int RefreshKey { get; set; }


    // ==============================================================
    // STATE
    // ==============================================================

    private List<AttendanceRawLogDto> _attendanceLogs = [];

 


    private bool _isLoading = true;

    private string? _errorMessage;

    private int _lastRefreshKey = -1;


    // ==============================================================
    // COMPONENT LIFECYCLE
    //
    // Do NOT also load in OnInitializedAsync.
    //
    // OnParametersSetAsync runs during the initial render and whenever
    // RefreshKey changes.
    // ==============================================================

    protected override async Task OnParametersSetAsync()
    {
        if (_lastRefreshKey == RefreshKey)
            return;

        _lastRefreshKey = RefreshKey;

        await LoadAttendanceAsync();
    }


    // ==============================================================
    // LOAD TODAY'S ATTENDANCE
    // ==============================================================

    private async Task LoadAttendanceAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var context = await UserAccessService.RequireContextAsync();

            /*
            * This card represents TODAY.
                 *
            * Do not use the TimeClockCard test timestamp here.
                 * The TimeClockCard is responsible for creating clock events.
                 * This component only displays today's attendance.
            */
                            var attendanceTime = DateTime.Now;

            var logs =
                                await AttendanceService.GetLogsAsync(
                                    context.IndividualId,
                                    context.ActiveJob.JobId,
                                    attendanceTime);
 



            _attendanceLogs = logs?
                                .OrderBy(x => x.LogDateTime)
                                .ToList()
                                ?? [];
 
        }
        catch (Exception ex)
        {
            _attendanceLogs = [];

        


            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }


    // ==============================================================
    // FIRST CLOCK
    // ==============================================================

    private string FirstClockTime
    {
        get
        {
            if (_attendanceLogs.Count == 0)
                return "--";

            return _attendanceLogs
                .MinBy(x => x.LogDateTime)?
                .LogDateTime
                .ToString("hh:mm:ss tt")
                ?? "--";
        }
    }


    // ==============================================================
    // LATEST CLOCK
    // ==============================================================

    private string LatestClockTime
    {
        get
        {
            if (_attendanceLogs.Count == 0)
                return "--";

            return _attendanceLogs
                .MaxBy(x => x.LogDateTime)?
                .LogDateTime
                .ToString("hh:mm:ss tt")
                ?? "--";
        }
    }


    private static string FormatTime(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToString("hh:mm tt")
            : "--";
    }


    private static string FormatMinutes(int minutes)
    {
        if (minutes <= 0)
            return "--";

        var hours =
            minutes / 60;

        var remainingMinutes =
            minutes % 60;

        if (hours == 0)
            return $"{remainingMinutes}m";

        if (remainingMinutes == 0)
            return $"{hours}h";

        return $"{hours}h {remainingMinutes}m";
    }


 


    private static string GetStatusClass(
        AttendanceDailyStatus status)
    {
        const string baseClass =
            "inline-flex items-center rounded-full px-2.5 py-1 " +
            "text-xs font-medium ";

        return status switch
        {
            AttendanceDailyStatus.Present =>
                baseClass +
                "bg-green-100 text-green-700",

            AttendanceDailyStatus.InProgress =>
                baseClass +
                "bg-blue-100 text-blue-700",

            AttendanceDailyStatus.Absent =>
                baseClass +
                "bg-red-100 text-red-700",

            AttendanceDailyStatus.Incomplete =>
                baseClass +
                "bg-amber-100 text-amber-700",

            AttendanceDailyStatus.Partial =>
                baseClass +
                "bg-amber-100 text-amber-700",

            AttendanceDailyStatus.RestDay =>
                baseClass +
                "bg-slate-100 text-slate-600",

            AttendanceDailyStatus.Leave =>
                baseClass +
                "bg-blue-100 text-blue-700",

            AttendanceDailyStatus.Holiday =>
                baseClass +
                "bg-purple-100 text-purple-700",

            AttendanceDailyStatus.Future =>
                baseClass +
                "bg-slate-100 text-slate-500",

            _ =>
                baseClass +
                "bg-slate-100 text-slate-600"
        };
    }

        private static string GetIssueDotClass(
        AttendanceEvaluationIssueSeverity severity)
        {
            const string baseClass =
            "mt-1 h-2 w-2 shrink-0 rounded-full ";

            return severity switch
            {
                AttendanceEvaluationIssueSeverity.Error =>
                baseClass + "bg-red-500",

                AttendanceEvaluationIssueSeverity.Warning =>
                baseClass + "bg-amber-500",

                _ =>
                baseClass + "bg-blue-500"
            };
        }
}