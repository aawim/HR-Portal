@using HRM.DTOs.UserContext
@using HRM.Services.Interfaces
@inject IUserAccessService Access
@inject ILogger<ProfileCard> Logger

<div class="relative flex flex-col items-center overflow-hidden rounded-xl border border-slate-100 bg-white p-6 shadow-sm">
    <div class="absolute left-0 top-0 h-24 w-full bg-gradient-to-r from-blue-500 to-blue-600 opacity-10"></div>
    <div aria-hidden="true" class="z-10 flex h-20 w-20 items-center justify-center rounded-full border-4 border-white bg-blue-100 text-2xl font-bold text-blue-700 shadow-md">@Initial</div>
    <h2 class="mt-3 text-lg font-bold text-slate-800">@DisplayName</h2>
    @if (!string.IsNullOrWhiteSpace(user?.ActiveJob?.PositionName)) { <p class="mb-4 text-sm font-medium text-blue-600">@user.ActiveJob.PositionName</p> }
    <dl class="mt-4 w-full space-y-2 text-sm">
        <div class="flex justify-between gap-3 border-b border-slate-50 pb-1"><dt class="text-slate-500">Emp Number</dt><dd class="font-medium text-slate-700">@Display(user?.ActiveJob?.EmployeeNumber)</dd></div>
        <div class="flex justify-between gap-3 border-b border-slate-50 pb-1"><dt class="text-slate-500">SAP Number</dt><dd class="font-medium text-slate-700">@Display(user?.ActiveJob?.SAPNumber)</dd></div>
        <div class="flex justify-between gap-3 border-b border-slate-50 pb-1"><dt class="text-slate-500">Department</dt><dd class="text-right font-medium text-slate-700">@Display(user?.ActiveJob?.OrganisationStructureName)</dd></div>
        <div class="flex justify-between gap-3 pb-1"><dt class="text-slate-500">Status</dt><dd class="rounded-full bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-700">@(user?.ActiveJob?.IsActive == true ? "Active" : Display(user?.ActiveJob?.JobStateName))</dd></div>
    </dl>
</div>

@code {
    [Parameter] public string UserName { get; set; } = "";
    private UserContextDto? user;
    private string DisplayName => !string.IsNullOrWhiteSpace(user?.FullName) ? user.FullName.Trim() : !string.IsNullOrWhiteSpace(UserName) ? UserName : "Profile";
    private string Initial => DisplayName.Substring(0, 1).ToUpperInvariant();
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    protected override async Task OnInitializedAsync()
    {
        try { user = await Access.GetContextAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load profile employment details."); }
    }
}
