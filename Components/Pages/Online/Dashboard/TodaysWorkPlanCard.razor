@using HRM.DTOs.Attendance
@using HRM.Services.Interfaces
@using HRM.Services.Attendance.AttendancePlan
@inject IUserAccessService UserAccess
@inject IAttendancePlanService Plans
@inject IAttendanceService Attendance
@inject ILogger<TodaysWorkPlanCard> Logger

<section class="min-w-0 overflow-hidden rounded-xl border bg-white shadow-sm" aria-label="Today's Work Plan">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b p-4">
        <div><h3 class="font-semibold">Today's Work Plan</h3><p class="mt-1 text-xs text-slate-500">@today.ToString("dd MMM yyyy")</p></div>
        <button type="button" class="app-button app-button-secondary" disabled="@loading" @onclick="LoadAsync" aria-label="Refresh today's work plan"><i class="fas fa-sync" aria-hidden="true"></i></button>
    </div>
    <div class="space-y-3 p-4">
        <a href="/online/duty-roster" class="app-button app-button-secondary">Today's duty roster</a>
        @if (loading) { <p role="status" class="text-sm text-slate-500">Loading today's work plan...</p> }
        else if (error != null) { <p role="alert" class="text-sm text-amber-700">@error</p> }
        else if (plan == null || (plan.Assignments.Count == 0 && plan.Segments.Count == 0)) { <p class="text-sm text-slate-500">@scheduleMessage</p> }
        else
        {
            @foreach (var assignment in plan.Assignments.Where(x => x.IsValid).OrderBy(x => x.SchedulePurpose).ThenBy(x => x.StartDateTime))
            {
                <div class="rounded-lg border p-3">
                    <p class="text-xs font-medium text-slate-500">@assignment.SchedulePurpose schedule</p>
                    <p class="mt-1 break-words text-sm font-semibold">@assignment.Name</p>
                    <p class="mt-1 text-sm tabular-nums">@Time(ScheduledStart(assignment))–@Time(ScheduledEnd(assignment))</p>
                </div>
            }
            <ol class="divide-y">
                @foreach (var item in plan.Segments.OrderBy(x => x.StartDateTime).ThenBy(x => x.SequenceNumber))
                {
                    <li class="flex items-start gap-3 py-3">
                        <time class="shrink-0 text-sm font-semibold tabular-nums" datetime="@item.StartDateTime.ToString("O")">@Time(item.StartDateTime)</time>
                        <div class="min-w-0 flex-1">
                            <p class="break-words text-sm font-medium">@EventName(item.Name)</p>
                            <p class="mt-1 text-xs text-slate-500">@item.SchedulePurpose
                                @if (!IsClockEvent(item.Name) && item.EndDateTime > item.StartDateTime) { <span> · until @Time(item.EndDateTime)</span> }
                            </p>
                            @if (IsClockEvent(item.Name) && item.IsMandatory && item.RequiresAttendance)
                            { <span class="mt-1 inline-block text-xs font-semibold text-blue-600">Required</span> }
                        </div>
                    </li>
                }
            </ol>
            @if (plan.Segments.Count == 0) { <p class="text-sm text-slate-500">No events are configured for this plan.</p> }
        }
    </div>
</section>

@code {
    private string scheduleMessage = "No active schedule found";
    [Parameter] public int RefreshKey { get; set; }
    private int loadedKey = int.MinValue;
    private DateTime today = DateTime.UtcNow.AddHours(5).Date;
    private bool loading;
    private string? error;
    private AttendanceWorkPlanDto? plan;
    protected override async Task OnParametersSetAsync()
    {
        if (loadedKey == RefreshKey) return;
        loadedKey = RefreshKey;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        loading = true; error = null; today = DateTime.UtcNow.AddHours(5).Date;
        try
        {
            var context = await UserAccess.RequireContextAsync();
            plan = context.ActiveJob == null ? null : await Plans.GetOrGenerateAsync(context.IndividualId,
                context.ActiveJob.JobId, context.ActiveJob.OrganisationId, today);
            scheduleMessage = "No active schedule found";
            if (context.ActiveJob != null && (plan == null || (plan.Assignments.Count == 0 && plan.Segments.Count == 0)))
            {
                var evaluation = await Attendance.GetEvaluationAsync(context.IndividualId, context.ActiveJob.JobId, context.ActiveJob.OrganisationId, today);
                scheduleMessage = evaluation.Status switch
                {
                    HRM.Enum.AttendanceDailyStatus.RestDay => "No scheduled work today (rest day)",
                    HRM.Enum.AttendanceDailyStatus.BeforePositionApproval => "Attendance starts from job position approval",
                    HRM.Enum.AttendanceDailyStatus.NoActiveSchedule => "No active schedule found",
                    _ => "No work plan found for the active schedule"
                };
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Loading today's work plan"); error = "Today's work plan could not be loaded. Please try refreshing."; plan = null; }
        finally { loading = false; }
    }
    private static string Time(DateTime value) => value.ToString("HH:mm");
    // Older assignments include their late clocking window in EndDateTime.
    // Show the scheduled boundary rather than that permitted clocking limit.
    private DateTime ScheduledStart(AttendanceWorkAssignmentDto assignment) => plan!.Segments
        .Where(x => x.SchedulePurpose == assignment.SchedulePurpose && EventName(x.Name) == "Check in")
        .Select(x => x.StartDateTime).DefaultIfEmpty(assignment.StartDateTime).Min();
    private DateTime ScheduledEnd(AttendanceWorkAssignmentDto assignment) => plan!.Segments
        .Where(x => x.SchedulePurpose == assignment.SchedulePurpose && EventName(x.Name) == "Check out")
        .Select(x => x.StartDateTime).DefaultIfEmpty(assignment.EndDateTime).Max();
    private static string EventName(string value)
    {
        var name = value.Split(" · ").Last();
        var normalized = string.Concat(name.Where(char.IsLetterOrDigit)).ToUpperInvariant();
        return normalized switch { "CHECKIN" or "CLOCKIN" or "DUTYCHECKIN" => "Check in", "CHECKOUT" or "CLOCKOUT" or "DUTYCHECKOUT" => "Check out", _ => name };
    }
    private static bool IsClockEvent(string value) => EventName(value) is "Check in" or "Check out";
}
