@using HRM.DTOs.Leave
@using HRM.Components.Pages.Online.Leave
@using HRM.Components.Shared
@using HRM.Helpers
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Services.Interfaces.AppovalWF
@using Microsoft.EntityFrameworkCore

@inject IWorkflowEngine WorkflowEngine
@inject ToastService ToastService
@inject ILeaveService LeaveService
@inject ILeaveChangeService Applications
@inject IUserAccessService UserAccess

@inject IDbContextFactory<HrmTeContext> DbFactory
@inject ILogger<RecentLeaveRequestsCard> Logger
@implements IAsyncDisposable

<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4">

    <div class="flex justify-between items-center mb-4">
        <div>
            <h3 class="text-lg font-semibold text-slate-800">
                @(ShowAll ? "All Leave Requests" : "Recent Leave Requests")
            </h3>
            <p class="text-sm text-slate-500">
                @(ShowAll ? "Search your leave history by status and leave dates." : "Your 10 most recent leave applications")
            </p>
        </div>

        <div class="flex items-center gap-4">
            @if (!ShowAll) { <a class="text-sm text-blue-600 underline" href="/online/leaves/all-requests">View all</a> }
            <button type="button" disabled="@(IsLoading || _processing || editingRequestId.HasValue)"
                    class="text-sm text-blue-600 disabled:opacity-50" @onclick="RefreshAsync">Refresh</button>
        </div>
    </div>

    @if (ShowAll)
    {
        <div class="mb-4 grid gap-3 rounded-lg bg-slate-50 p-3 sm:grid-cols-3">
            <label class="text-sm text-slate-600">Status
                <select id="leave-history-status" @bind="selectedStatusId" class="mt-1 w-full rounded border p-2" disabled="@IsLoading">
                    <option value="0">All statuses</option>
                    @foreach (var state in availableStatuses) { <option value="@state.LeaveStateId">@state.StateName</option> }
                </select>
            </label>
            <label class="text-sm text-slate-600">Leave date from
                <input id="leave-history-from" type="date" @bind="filterFrom" class="mt-1 w-full rounded border p-2" disabled="@IsLoading" />
            </label>
            <label class="text-sm text-slate-600">Leave date to
                <input id="leave-history-to" type="date" @bind="filterTo" class="mt-1 w-full rounded border p-2" disabled="@IsLoading" />
            </label>
            <p class="text-xs text-slate-500 sm:col-span-3">Matches leave periods that overlap the selected dates.</p>
            <div class="flex gap-3 sm:col-span-3">
                <button type="button" @onclick="SearchAsync" disabled="@(IsLoading || _processing || editingRequestId.HasValue)" class="rounded bg-blue-600 px-4 py-2 text-sm text-white disabled:opacity-50">Search</button>
                <button type="button" @onclick="ResetSearchAsync" disabled="@(IsLoading || _processing || editingRequestId.HasValue)" class="rounded border px-4 py-2 text-sm disabled:opacity-50">Reset filters</button>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(loadError)) { <p role="alert" class="mb-3 rounded bg-red-50 p-3 text-sm text-red-800">@loadError</p> }

    @if (IsLoading)
    {
        <div class="py-6 text-center text-slate-500">
            Loading leave requests...
        </div>
    }
    else if (LeaveRequests == null || !LeaveRequests.Any())
    {
        <div class="py-6 text-center text-slate-500">
            No leave requests found.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">

            <table class="min-w-full divide-y divide-slate-200">

                <thead class="bg-slate-50">
                    <tr>

                        <th class="px-3 py-3 text-left text-xs font-semibold uppercase">
                            Type
                        </th>

                        <th class="px-3 py-3 text-left text-xs font-semibold uppercase">
                            From
                        </th>

                        <th class="px-3 py-3 text-left text-xs font-semibold uppercase">
                            To
                        </th>

                        <th class="px-3 py-3 text-center text-xs font-semibold uppercase">
                            Days
                        </th>

                         <th class="px-3 py-3 text-center text-xs font-semibold uppercase">
                            Status
                        </th>


                        <th class="px-3 py-3 text-center text-xs font-semibold uppercase">
                            Action
                        </th>

                       


                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">

                    @foreach (var leave in LeaveRequests)
                    {
                        <tr class="hover:bg-slate-50">

                            <td class="px-3 py-3">
                                @(leave.LeaveType?.Name ?? "Leave")
                            </td>

                            <td class="px-3 py-3">
                                @leave.FromDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="px-3 py-3">
                                @leave.ToDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="px-3 py-3 text-center">
                                @leave.Duration
                            </td>

                            <td class="px-3 py-3 text-center">

                                @{
                                    var requestId = GetWorkflowRequestId(leave.LeaveId);
                                }

                                    <div class="flex flex-col items-center gap-1">

                                        <span class="px-2 py-1 rounded-full text-xs font-medium @StatusClass(leave.LeaveStateId)">
                                            @GetDisplayStatus(leave)
                                        </span>

                                        @if (LeaveHelper.CanCancel(leave.LeaveStateId) && requestId.HasValue && IsWorkflowActive(requestId.Value) &&
                                            RequestStatuses.TryGetValue(requestId.Value, out var requestStatus))
                                        {
                                            <span class="text-xs text-amber-700">Processing · @requestStatus</span>
                                        }
                                        @if (LeaveHelper.CanCancel(leave.LeaveStateId) && requestId.HasValue && IsWorkflowActive(requestId.Value) && WorkflowInfo.TryGetValue(requestId.Value, out var workflow))
                                        {
                                            <span class="text-xs text-slate-500">@workflow.WorkflowStatus</span>
                                            <span class="text-xs text-slate-500">@workflow.StageName</span>
                                        }

                                    </div>

                            </td>
                       













                            <td class="px-3 py-3 text-center gap-2">
                                <div class="flex flex-wrap items-center justify-center gap-2">
                                @if (leave.LeaveStateId == SharedConfig.LeaveStates.APPROVED)
                                {
                                    <a class="app-button app-button-secondary text-xs" href="@($"/online/leaves/{leave.LeaveId}/receipt")">View receipt</a>
                                }
                                @if (HandoverLeaveIds.Contains(leave.LeaveId))
                                {
                                    <a class="app-button app-button-secondary text-xs"
                                       href="@($"/online/leave-handovers/{leave.LeaveId}")"
                                       title="View work handover for this leave request">
                                        <i class="bi bi-hand-index-thumb" aria-hidden="true"></i>
                                        <span>Work handover</span>
                                    </a>
                                }
                                @if (GetWorkflowRequestId(leave.LeaveId) is int correctionRequestId &&
                                    ReturnReasons.ContainsKey(correctionRequestId) && OwnedRequestIds.Contains(correctionRequestId) &&
                                    leave.LeaveStateId == SharedConfig.LeaveStates.INCOMPLETE &&
                                    WorkflowInfo.TryGetValue(correctionRequestId, out var returnedWorkflow) && returnedWorkflow.WorkflowStatus == "Returned")
                                {
                                    <button type="button" class="mb-2 rounded-md bg-blue-600 px-3 py-2 text-xs text-white disabled:opacity-50"
                                            disabled="@(IsLoading || _processing || editingRequestId.HasValue)" @onclick="() => OpenCorrectionAsync(leave.LeaveId)">
                                        Edit and resubmit
                                    </button>
                                }

                               
                                    @* <button class="px-3 py-1 rounded-md text-xs
                                       bg-slate-200 text-slate-500
                                       hover:bg-slate-300 text-slate-700"
                                    @onclick="() => OpenCancelDialog(leave.LeaveId)">
                                        <i class="fas fa-times me-1"></i>
                                        Cancel
                                    </button> *@

                                @if (LeaveHelper.CanCancel(leave.LeaveStateId))
                                {
                                <button type="button"
                                        disabled="@(_processing || editingRequestId.HasValue)"
                                        @onclick="() => OpenCancelDialog(leave.LeaveId)"
                                        class="px-3 py-1 rounded-md text-xs
                                           bg-red-50 text-red-700
                                           hover:bg-red-100
                                           disabled:opacity-50">
                                    <i class="fas fa-times me-1"></i>
                                    Cancel
                                </button>
                                }




                                <button type="button" class="app-button app-button-secondary text-xs"
                                @onclick="() => ShowDetail(leave.LeaveId)">
                                    View
                                </button>
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
@if (selectedDetails != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
        <section role="dialog" aria-modal="true" aria-labelledby="recent-leave-detail-title" tabindex="-1"
                 class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-xl bg-white p-6 shadow-xl"
                 @onkeydown="HandleDetailKey">
            <div class="mb-4 flex items-start justify-between gap-4">
                <div>
                    <h2 id="recent-leave-detail-title" class="text-lg font-semibold">Leave request details</h2>
                    <p class="text-sm text-slate-500">@selectedDetails.Reference · @selectedDetails.LeaveType</p>
                </div>
                <button type="button" autofocus disabled="@editingRequestId.HasValue" class="rounded border px-3 py-2 text-sm disabled:opacity-50"
                        @onclick="CloseDetails">Close</button>
            </div>
            @if (editingRequestId.HasValue)
            {
                <MyLeaveApplications @key="editingRequestId.Value" EditorOnly="true" EditRequestId="editingRequestId"
                                     OnSaved="CorrectionSavedAsync" OnClose="CloseCorrection" />
            }
            else
            {
                <p class="mb-4 text-sm">@selectedDetails.FromDate.ToString("dd MMM yyyy") – @selectedDetails.ToDate.ToString("dd MMM yyyy") · @selectedDetails.Duration days · @selectedDetails.Status</p>
                @if (selectedDetails.HasHandover) { <a class="app-button app-button-secondary mb-4 inline-block text-sm text-blue-700 underline" href="@($"/online/leave-handovers/{selectedDetails.LeaveId}")">View work handover</a> }
                @if (selectedDetails.ReturnReason != null || selectedDetails.CanEdit)
                {
                    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-amber-900">
                        <h3 class="font-semibold">Reason for return</h3>
                        <p class="mt-1 whitespace-pre-wrap break-words text-sm">@(string.IsNullOrWhiteSpace(selectedDetails.ReturnReason) ? "No return reason was recorded. Contact the reviewer for details." : selectedDetails.ReturnReason)</p>
                    </div>
                }
                <dl class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
                    <div><dt class="font-medium text-slate-500">Leave reason</dt><dd>@DisplayDetail(selectedDetails.Reason)</dd></div>
                    <div><dt class="font-medium text-slate-500">Contact</dt><dd>@DisplayDetail(selectedDetails.ContactNumber)</dd></div>
                    <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Explanation</dt><dd class="whitespace-pre-wrap break-words">@DisplayDetail(selectedDetails.Explanation)</dd></div>
                    <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Leave address</dt><dd class="whitespace-pre-wrap break-words">@DisplayDetail(selectedDetails.Address)</dd></div>
                </dl>
                @if (selectedDetails.CanEdit && OwnedRequestIds.Contains(selectedDetails.RequestId))
                {
                    <button type="button" class="mt-5 rounded bg-blue-600 px-4 py-2 text-sm text-white"
                            @onclick="BeginCorrection">Edit and resubmit</button>
                }
            }
        </section>
    </div>
}
@if (ShowCancelConfirm)
{
    <ConfirmDialog ActionType="ConfirmAction.Cancel"
    Title="Cancel Leave Request"
    Message="Are you sure you want to cancel this leave request?"
    ConfirmText="Yes, Cancel"
    OnConfirm="ConfirmCancelLeave"
    OnCancel="CloseCancelDialog" />
}


@code {
    [Parameter] public bool ShowAll { get; set; }
    private int selectedStatusId;
    private DateTime? filterFrom, filterTo;
    private List<LeaveState> availableStatuses = [];
    private string? loadError;
    private string GetDisplayStatus(Leaf leave)
    {
        var leaveStatus = leave.LeaveState?.StateName;
        if (!string.IsNullOrWhiteSpace(leaveStatus)) return leaveStatus;
        var id = GetWorkflowRequestId(leave.LeaveId);
        return id.HasValue && RequestStatuses.TryGetValue(id.Value, out var status) ? status : "Unknown";
    }
    private static string StatusClass(int state) => state switch
    {
        SharedConfig.LeaveStates.APPROVED => "bg-green-100 text-green-700",
        SharedConfig.LeaveStates.REJECTED => "bg-red-100 text-red-700",
        SharedConfig.LeaveStates.CANCELLED => "bg-slate-100 text-slate-600",
        _ => "bg-blue-100 text-blue-700"
    };
    private Task SearchAsync() => RefreshAsync();
    private async Task ResetSearchAsync()
    {
        selectedStatusId = 0;
        filterFrom = filterTo = null;
        await RefreshAsync();
    }
    private readonly CancellationTokenSource refreshStop = new();
    private Task? refreshLoop;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) refreshLoop = RefreshPeriodicallyAsync();
        return Task.CompletedTask;
    }

    private async Task RefreshPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshStop.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (IsLoading || _processing || ShowCancelConfirm || selectedDetails != null || editingRequestId.HasValue || refreshStop.IsCancellationRequested) return;
                    try { await RefreshAsync(); }
                    catch (Exception ex) { Logger.LogWarning(ex, "Could not refresh recent leave request statuses."); }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (refreshStop.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        await refreshStop.CancelAsync();
        if (refreshLoop != null) await refreshLoop;
        refreshStop.Dispose();
    }

    private bool _processing;
    private int? editingRequestId;
    private MyLeaveApplicationDto? selectedDetails;
    private HashSet<int> OwnedRequestIds = new();
    private HashSet<int> HandoverLeaveIds = new();
    private Dictionary<int, string?> ReturnReasons = new();
    private void CloseCorrection() => editingRequestId = null;
    private async Task CorrectionSavedAsync()
    {
        editingRequestId = null;
        await RefreshAsync();
        if (selectedDetails != null) selectedDetails = await Applications.GetMyApplicationDetailsAsync(selectedDetails.RequestId);
    }

    private Dictionary<int, int> LeaveRequestIds = new();

    private Dictionary<int, WorkflowCardInfo> WorkflowInfo = new();
    private Dictionary<int, string> RequestStatuses = new();
    private Dictionary<int, bool> ProcessingRequests = new();

    private bool IsWorkflowActive(int requestId) =>
        ProcessingRequests.TryGetValue(requestId, out var processing) && processing;


    private int? GetWorkflowRequestId(int leaveId)
{
    return LeaveRequestIds.TryGetValue(leaveId, out var requestId)
        ? requestId
        : null;
}


  



    [Parameter]
    public bool IsLoading { get; set; }

    private List<Leaf>? LeaveRequests;
    private bool ShowCancelConfirm;
    private int SelectedLeaveId;


    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        loadError = null;
        if (ShowAll && filterFrom.HasValue && filterTo.HasValue && filterFrom.Value.Date > filterTo.Value.Date)
        {
            loadError = "From date must be on or before To date.";
            return;
        }
        IsLoading = true;

        try
        {
            if (ShowAll && availableStatuses.Count == 0)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                availableStatuses = await db.LeaveStates.AsNoTracking().OrderBy(x => x.StateName).ToListAsync();
            }
            LeaveRequests =
                await LeaveService.GetMyLeaveRequestsAsync(ShowAll ? selectedStatusId : null,
                    ShowAll ? filterFrom : null, ShowAll ? filterTo : null, ShowAll ? null : 10);

            await LoadWorkflowInfoAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load leave request history.");
            loadError = "Leave requests could not be loaded. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
        // LeaveRequests = await LeaveService.GetMyLeaveRequestsAsync();
        // IsLoading = false;

    }


  


    private void OpenCancelDialog(int leaveId)
    {
        SelectedLeaveId = leaveId;
        ShowCancelConfirm = true;
    }

    private void CloseCancelDialog()
    {
        ShowCancelConfirm = false;
    }

    private async Task ConfirmCancelLeave()
    {
        ShowCancelConfirm = false;

        var result = await LeaveService
            .CancelLeaveAsync(SelectedLeaveId);


        if (!result.Success)
        {
            ToastService.Warning(result.Message);
            return;
        }

        ToastService.Success("Leave cancelled successfully.");

        await InvokeAsync(StateHasChanged);



        await RefreshAsync();
    }

    private async Task CancelLeave(int leaveId)
    {
        var result = await LeaveService.CancelLeaveAsync(leaveId);

        if (!result.Success)
        {
            ToastService.Warning(result.Message);
            return;
        }

        ToastService.Success("Leave cancelled successfully.");

        await InvokeAsync(StateHasChanged);



        await RefreshAsync();
    }

    private static string DisplayDetail(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    private void CloseDetails()
    {
        if (!editingRequestId.HasValue) selectedDetails = null;
    }
    private void HandleDetailKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseDetails();
    }
    private void BeginCorrection()
    {
        if (selectedDetails?.CanEdit == true && OwnedRequestIds.Contains(selectedDetails.RequestId))
            editingRequestId = selectedDetails.RequestId;
    }
    private async Task OpenCorrectionAsync(int leaveId)
    {
        var requestId = GetWorkflowRequestId(leaveId);
        if (!requestId.HasValue || !OwnedRequestIds.Contains(requestId.Value)) return;
        await ShowDetail(leaveId);
        BeginCorrection();
    }
    private async Task ShowDetail(int leaveId)
    {
        if (_processing || editingRequestId.HasValue) return;
        var requestId = GetWorkflowRequestId(leaveId);
        if (!requestId.HasValue)
        {
            var leave = LeaveRequests?.FirstOrDefault(x => x.LeaveId == leaveId);
            if (leave != null) selectedDetails = new()
            {
                LeaveId = leave.LeaveId, Reference = $"Leave #{leave.LeaveId}", LeaveType = leave.LeaveType?.Name ?? "Leave",
                FromDate = leave.FromDate, ToDate = leave.ToDate, Duration = leave.Duration, Status = GetDisplayStatus(leave)
            };
            return;
        }
        _processing = true;
        try
        {
            selectedDetails = await Applications.GetMyApplicationDetailsAsync(requestId.Value);
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            selectedDetails = null;
            ToastService.Warning(ex.Message);
        }
        catch (Exception ex)
        {
            selectedDetails = null;
            Logger.LogError(ex, "Could not load leave request details.");
            ToastService.Error("Leave request details could not be loaded. Please try again.");
        }
        finally { _processing = false; }
    }


    private async Task LoadWorkflowInfoAsync()
    {
        LeaveRequestIds.Clear();
        WorkflowInfo.Clear();
        RequestStatuses.Clear();
        ProcessingRequests.Clear();
        ReturnReasons.Clear();
        OwnedRequestIds.Clear();
        HandoverLeaveIds.Clear();

        if (LeaveRequests == null || LeaveRequests.Count == 0)
            return;

        var leaveIds = LeaveRequests
            .Select(x => x.LeaveId)
            .ToArray();

        await using var db =
            await DbFactory.CreateDbContextAsync();

        var mappings = await db.LeaveRequests
            .AsNoTracking()
            .Where(x => leaveIds.Contains(x.LeaveId))
            .Select(x => new
            {
                x.LeaveId,
                x.RequestId,
                Status = x.Request.RequestState.StateName,
                IsProcessing = x.Request.RequestState.IsProcessingState && !x.Request.RequestState.IsFinalState,
                StateId = x.Request.RequestStateId,
                ReturnReason = x.Request.StateChangeRemarks,
                OwnerPersonId = x.Leave.Job.IndividualID,
                HasHandover = db.LeaveHandoverReviews.Any(r => r.LeaveId == x.LeaveId)
            })
            .ToListAsync();

        HandoverLeaveIds = mappings.Where(x => x.HasHandover).Select(x => x.LeaveId).ToHashSet();
        var user = await UserAccess.RequireContextAsync();
        var person = user.IndividualId > 0 ? user.IndividualId : user.BusinessEntityId;
        OwnedRequestIds = mappings.Where(x => person > 0 && x.OwnerPersonId == person).Select(x => x.RequestId).ToHashSet();

        LeaveRequestIds = mappings
            .GroupBy(x => x.LeaveId)
            .ToDictionary(
                x => x.Key,
                x => x.First().RequestId
            );
        RequestStatuses = mappings.GroupBy(x => x.RequestId)
            .ToDictionary(x => x.Key, x => x.First().Status);
        ProcessingRequests = mappings.GroupBy(x => x.RequestId)
            .ToDictionary(x => x.Key, x => x.First().IsProcessing);

        ReturnReasons = mappings.Where(x => x.StateId == SharedConfig.RequestStates.INCOMPLETE)
            .GroupBy(x => x.RequestId).ToDictionary(x => x.Key, x => x.First().ReturnReason);

        if (LeaveRequestIds.Count == 0)
            return;

        var requestIds = LeaveRequestIds.Values
            .Distinct()
            .ToArray();

        var workflows = await (
            from wi in db.WfRequestInstances.AsNoTracking()

            join si in db.WfRequestStageInstances.AsNoTracking()
                on wi.CurrentRequestStageInstanceId
                equals (long?)si.RequestStageInstanceId
                into stageJoin

            from si in stageJoin.DefaultIfEmpty()

            join ws in db.WfWorkflowStages.AsNoTracking()
                on si.WorkflowStageId equals ws.WorkflowStageId
                into definitionJoin

            from ws in definitionJoin.DefaultIfEmpty()

            where requestIds.Contains(wi.RequestId)

            select new
            {
                wi.RequestId,
                wi.WorkflowRequestInstanceId,
                wi.WorkflowStatus,
                wi.CompletedAt,
                StageName = ws != null
                    ? ws.StageName
                    : null
            }
        ).ToListAsync();

        WorkflowInfo = workflows
            .GroupBy(x => x.RequestId)
            .ToDictionary(
                x => x.Key,
                x =>
                {
                    var workflow = x
                        .OrderByDescending(y => y.WorkflowRequestInstanceId)
                        .First();

                    return new WorkflowCardInfo
                        {
                            WorkflowInstanceId =
                                workflow.WorkflowRequestInstanceId,

                            WorkflowStatus =
                                workflow.WorkflowStatus,
                            Completed = workflow.CompletedAt.HasValue,

                            StageName =
                                workflow.StageName ?? "No active stage"
                        };
                });
    }





    private sealed class WorkflowCardInfo
    {
        public long WorkflowInstanceId { get; set; }
        public string WorkflowStatus { get; set; } = "";
        public bool Completed { get; set; }
        public string StageName { get; set; } = "";
        public string? ApproverName { get; set; }
    }

}
