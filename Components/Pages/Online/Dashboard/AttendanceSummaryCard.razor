@using HRM.DTOs.Attendance
@using HRM.Enum

<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-2">

        <div>
            <h3 class="text-base font-semibold text-slate-800">
                Attendance Summary
            </h3>

            <p class="mt-0.5 text-xs text-slate-500">
                @WeekStart.ToString("dd MMM") - @WeekEnd.ToString("dd MMM yyyy")
            </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-green-500"></span>
                Present
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
                Absent
            </span>

              <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-gray-300"></span>
                Upcomming
            </span>


            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-gray-600"></span>
                Unresolved
            </span>

        </div>

    </div>


    <!-- ============================================================
         BODY
         ============================================================ -->
    <div class="p-4">

        @if (WeeklyLogs == null)
        {
            <!-- Loading -->
            <div class="flex   items-center justify-center text-sm text-slate-500">
                Loading attendance...
            </div>
        }
        else
        {
            <!-- ====================================================
                 SUNDAY -> SATURDAY
                 ==================================================== -->
            <div class="grid grid-cols-7 gap-2">

                @for (int i = 0; i < 7; i++)
                {
                    var day = WeekStart.AddDays(i);

                    var dayLogs = WeeklyLogs
                    .Where(x => x.Date.Date == day.Date)
                    .OrderBy(x => x.Date)
                    .ToList();


                    // ------------------------------------------------
                    // Resolved Check In
                    // ------------------------------------------------
                    var checkIn = dayLogs
                    .Where(x => x.IsCheckIn)
                    .OrderBy(x => x.Date)
                    .FirstOrDefault();


                    // ------------------------------------------------
                    // Resolved Check Out
                    // ------------------------------------------------
                    var checkOut = dayLogs
                    .Where(x => x.IsCheckOut)
                    .OrderByDescending(x => x.Date)
                    .FirstOrDefault();


                    // ------------------------------------------------
                    // Attendance state
                    // ------------------------------------------------
                    var hasResolvedAttendance =
                    checkIn != null ||
                    checkOut != null;

                    var hasLogs =
                    dayLogs.Count > 0;

                    var isUnresolvedDay =
                    hasLogs &&
                    !hasResolvedAttendance;

                    var isPresent =
                    checkIn != null;


                    // ------------------------------------------------
                    // Future day
                    // ------------------------------------------------
                    var isFutureDay =
                    day.Date > DateTime.Today;


                    // ------------------------------------------------
                    // Display state
                    // ------------------------------------------------
                    var stateClass =
                    isFutureDay
                    ? "bg-slate-100 text-slate-400"
                    : isPresent
                    ? "bg-green-500 text-white"
                    : isUnresolvedDay
                    ? "bg-slate-500 text-white"
                    : "bg-red-500 text-white";


                    <div class="flex min-w-0 flex-col items-center">

                        <!-- Day Card -->
                        <div class="
                            @stateClass
                            relative flex h-28 w-full
                            flex-col items-center justify-center
                            rounded-lg px-2 text-center
                            transition-all duration-200
                            hover:-translate-y-0.5 hover:shadow-md">


                            <!-- Date -->
                            <div class="mb-2 text-[11px] font-medium opacity-90">
                                @day.ToString("dd MMM")
                            </div>


                            @if (isFutureDay)
                            {
                                <!-- Future day -->

                                <span class="text-sm font-semibold">
                                    --
                                </span>

                                <span class="mt-1 text-[10px] opacity-80">
                                    Upcoming
                                </span>
                            }
                            else if (isPresent)
                            {
                                <!-- Check In -->
                                <div class="flex items-center justify-center gap-1">

                                    <span class="text-[10px] uppercase opacity-75">
                                        In
                                    </span>

                                    <span class="text-sm font-semibold">
                                        @checkIn!.Date.ToString("HH:mm")
                                    </span>

                                </div>


                                <!-- Check Out -->
                                <div class="mt-1 flex items-center justify-center gap-1">

                                    <span class="text-[10px] uppercase opacity-75">
                                        Out
                                    </span>

                                    @if (checkOut != null)
                                    {
                                        <span class="text-sm font-medium">
                                            @checkOut.Date.ToString("HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-sm opacity-80">
                                            --
                                        </span>
                                    }

                                </div>
                            }
                            else if (isUnresolvedDay)
                            {
                                <!-- Logs exist but no useful resolution -->

                                <span class="text-sm font-semibold">
                                    Unresolved
                                </span>

                                <span class="mt-1 text-[10px] opacity-80">
                                    @dayLogs.Count event@(dayLogs.Count == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <!-- No attendance logs -->

                                <span class="text-sm font-semibold">
                                    Absent
                                </span>

                                <span class="mt-1 text-xs opacity-80">
                                    --
                                </span>
                            }

                        </div>


                        <!-- Day Name -->
                        <span class="
                            mt-2 text-xs font-medium
                            @(day.Date == DateTime.Today
                                ? "text-blue-600"
                                : isFutureDay
                                    ? "text-slate-400"
                                    : "text-slate-600")">

                            @day.ToString("ddd")

                        </span>


                        <!-- Today indicator -->
                        @if (day.Date == DateTime.Today)
                        {
                            <span class="mt-0.5 text-[10px] font-medium text-blue-500">
                                Today
                            </span>
                        }
                        else
                        {
                            <!-- Keeps row height consistent -->
                            <span class="mt-0.5 text-[10px]">
                                &nbsp;
                            </span>
                        }

                    </div>
                }

            </div>


            <!-- ====================================================
                 WEEK SUMMARY
                 ==================================================== -->
            @* <div class="mt-6 grid grid-cols-3 divide-x divide-slate-200
                        rounded-lg border border-slate-200 bg-slate-50 py-3">

                <!-- Present -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @PresentDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Present
                    </div>

                </div>


                <!-- Absent -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @AbsentDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Absent
                    </div>

                </div>


                <!-- Unresolved -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @UnresolvedDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Unresolved
                    </div>

                </div>

            </div> *@
        }

    </div>

</div>


@code {

    // ==============================================================
    // PARAMETERS
    // ==============================================================

    [Parameter]
    public List<AttendanceLogDto>? WeeklyLogs { get; set; }


    // ==============================================================
    // CURRENT WEEK
    //
    // Sunday -> Saturday
    // ==============================================================

    private DateTime WeekStart
    {
        get
        {
            var today = DateTime.Today;

            return today.AddDays(
                -(int)today.DayOfWeek);
        }
    }


    private DateTime WeekEnd =>
        WeekStart.AddDays(6);


    // ==============================================================
    // PRESENT DAYS
    //
    // Present only when there is a resolved Check In.
    //
    // Future days are ignored.
    // ==============================================================

    private int PresentDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => WeekStart.AddDays(i).Date)
                .Where(day =>
                    day <= DateTime.Today)
                .Count(day =>
                    WeeklyLogs.Any(x =>
                        x.Date.Date == day &&
                        x.IsCheckIn));
        }
    }


    // ==============================================================
    // UNRESOLVED DAYS
    //
    // Logs exist, but no resolved CheckIn or CheckOut.
    // ==============================================================

    private int UnresolvedDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => WeekStart.AddDays(i).Date)
                .Where(day =>
                    day <= DateTime.Today)
                .Count(day =>
                {
                    var logs = WeeklyLogs
                        .Where(x =>
                            x.Date.Date == day)
                        .ToList();

                    if (logs.Count == 0)
                        return false;

                    return !logs.Any(x =>
                        x.IsCheckIn ||
                        x.IsCheckOut);
                });
        }
    }


    // ==============================================================
    // ABSENT DAYS
    //
    // Only count days from Sunday through today.
    //
    // Future days are NOT counted as absent.
    //
    // IMPORTANT:
    // Eventually this should use WorkPlan so OFF / REST days
    // are not counted as absent.
    // ==============================================================

    private int AbsentDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => WeekStart.AddDays(i).Date)
                .Where(day =>
                    day <= DateTime.Today)
                .Count(day =>
                {
                    var logs = WeeklyLogs
                        .Where(x =>
                            x.Date.Date == day)
                        .ToList();

                    // Unresolved is handled separately.
                    if (logs.Count > 0 &&
                        !logs.Any(x =>
                            x.IsCheckIn ||
                            x.IsCheckOut))
                    {
                        return false;
                    }

                    return !logs.Any(x =>
                        x.IsCheckIn);
                });
        }
    }
}