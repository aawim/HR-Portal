@using HRM.DTOs.Attendance
@using HRM.Enum

<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">

        <div>
            <h3 class="text-base font-semibold text-slate-800">
                Attendance Summary
            </h3>

            <p class="mt-0.5 text-xs text-slate-500">
                Your attendance activity for the last 7 days
            </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-green-500"></span>
                Present
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
                Absent
            </span>

            <span class="flex items-center gap-1">
                <span class="h-2.5 w-2.5 rounded-full bg-gray-600"></span>
                Unresolved
            </span>

        </div>

    </div>


    <!-- ============================================================
         BODY
         ============================================================ -->
    <div class="p-5">

        @if (WeeklyLogs == null)
        {
            <!-- Loading -->
            <div class="flex min-h-28 items-center justify-center text-sm text-slate-500">
                Loading attendance...
            </div>
        }
        else
        {
            <div class="grid grid-cols-7 gap-2">

                @for (int i = 6; i >= 0; i--)
                {
                    var day = DateTime.Today.AddDays(-i);

                    var dayLogs = WeeklyLogs
                    .Where(x => x.Date.Date == day.Date)
                    .OrderBy(x => x.Date)
                    .ToList();


                    // ------------------------------------------------
                    // Resolved Check In
                    // ------------------------------------------------
                    var checkIn = dayLogs
                    .Where(x => x.IsCheckIn)
                    .OrderBy(x => x.Date)
                    .FirstOrDefault();


                    // ------------------------------------------------
                    // Resolved Check Out
                    // ------------------------------------------------
                    var checkOut = dayLogs
                    .Where(x => x.IsCheckOut)
                    .OrderByDescending(x => x.Date)
                    .FirstOrDefault();

                    var hasResolvedAttendance =
                        checkIn != null ||
                        checkOut != null;


                    var hasLogs =
                    dayLogs.Count > 0;

                    // Only call the DAY unresolved when there are logs,
                    // but none of them produced useful resolved attendance.
                    var isUnresolvedDay =
                        hasLogs &&
                        !hasResolvedAttendance;



                    // ------------------------------------------------
                    // Resolution information
                    // ------------------------------------------------
                    var unresolvedCount = dayLogs
                    .Count(x =>
                    !x.IsResolved &&
                    !x.IsIgnored);


                    var ignoredCount = dayLogs
                    .Count(x => x.IsIgnored);


                    // Presence is based on a successfully resolved
                    // Check In, NOT the old InOutModeID.
                    var isPresent =
                    checkIn != null;


                    // ------------------------------------------------
                    // Determine display state
                    //
                    // Late/On-Time will later come from WorkPlan.
                    // Do NOT hard-code 08:00 here.
                    // ------------------------------------------------
                    var stateClass =
                        isPresent
                        ? "bg-green-500 text-white"
                        : dayLogs.Count > 0
                        ? "bg-slate-500 text-white"
                        : "bg-red-500 text-white";


                    <div class="flex min-w-0 flex-col items-center">

                        <!-- Day Card -->
                        <div class="
                            @stateClass
                            relative flex h-28 w-full
                            flex-col items-center justify-center
                            rounded-lg px-2 text-center
                            transition-all duration-200
                            hover:-translate-y-0.5 hover:shadow-md">


                            <!-- Date -->
                            <div class="mb-2 text-[11px] font-medium opacity-90">
                                @day.ToString("dd MMM")
                            </div>


                            @if (isPresent)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <span class="text-[10px] uppercase opacity-75">
                                        In
                                    </span>

                                    <span class="text-sm font-semibold">
                                        @checkIn!.Date.ToString("HH:mm")
                                    </span>
                                </div>

                                <div class="mt-1 flex items-center justify-center gap-1">
                                    <span class="text-[10px] uppercase opacity-75">
                                        Out
                                    </span>

                                    @if (checkOut != null)
                                    {
                                        <span class="text-sm font-medium">
                                            @checkOut.Date.ToString("HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-sm opacity-80">
                                            --
                                        </span>
                                    }
                                </div>


                                <!-- Unresolved indicator -->
                                @if (isUnresolvedDay)
                                {
                                    <span class="text-sm font-semibold">
                                        Unresolved
                                    </span>

                                    <span class="mt-1 text-[10px] opacity-80">
                                        No resolved attendance
                                    </span>
                                }
                            }
                            else if (dayLogs.Count > 0)
                            {
                                <!-- Logs exist but none resolved as Check In -->

                                <span class="text-sm font-semibold">
                                    Unresolved

                                </span>

                                <span class="mt-1 text-[10px] opacity-80">
                                    @dayLogs.Count event@(dayLogs.Count == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <!-- No attendance logs -->

                                <span class="text-sm font-semibold">
                                    Absent
                                </span>

                                <span class="mt-1 text-xs opacity-80">
                                    --
                                </span>
                            }

                        </div>


                        <!-- Day Name -->
                        <span class="
                            mt-2 text-xs font-medium
                            @(day.Date == DateTime.Today
                                ? "text-blue-600"
                                : "text-slate-600")">

                            @day.ToString("ddd")

                        </span>


                        <!-- Today indicator -->
                        @if (day.Date == DateTime.Today)
                        {
                            <span class="mt-0.5 text-[10px] font-medium text-blue-500">
                                Today
                            </span>
                        }

                    </div>
                }

            </div>


            <!-- ====================================================
                 WEEK SUMMARY
                 ==================================================== -->
            <div class="mt-6 grid grid-cols-3 divide-x divide-slate-200
                        rounded-lg border border-slate-200 bg-slate-50 py-3">

                <!-- Present -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @PresentDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Present
                    </div>

                </div>


                <!-- Absent -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @AbsentDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Absent
                    </div>

                </div>


                <!-- Unresolved -->
                <div class="text-center">

                    <div class="text-lg font-semibold text-slate-800">
                        @UnresolvedDays
                    </div>

                    <div class="text-xs text-slate-500">
                        Unresolved
                    </div>

                </div>

            </div>
        }

    </div>

</div>


@code {

    // ==============================================================
    // PARAMETERS
    // ==============================================================

    [Parameter]
    public List<AttendanceLogDto>? WeeklyLogs { get; set; }


    // ==============================================================
    // PRESENT DAYS
    //
    // A day is Present only when there is a resolved Check In.
    // ==============================================================

    private int PresentDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i =>
                    DateTime.Today.AddDays(-i).Date)
                .Count(day =>
                    WeeklyLogs.Any(x =>
                        x.Date.Date == day &&
                        x.IsCheckIn));
        }
    }


    // ==============================================================
    // ABSENT DAYS
    //
    // Currently:
    // No resolved Check In = absent.
    //
    // IMPORTANT:
    // Later this should use WorkPlan so OFF DAYS / REST DAYS
    // are not incorrectly counted as absent.
    // ==============================================================

    private int AbsentDays
    {
        get
        {
            return 7 - PresentDays;
        }
    }


    // ==============================================================
    // UNRESOLVED CLOCK EVENTS
    // ==============================================================

    private int UnresolvedDays
    {
        get
        {
            if (WeeklyLogs == null)
                return 0;

            return Enumerable
                .Range(0, 7)
                .Select(i => DateTime.Today.AddDays(-i).Date)
                .Count(day =>
                {
                    var logs = WeeklyLogs
                        .Where(x => x.Date.Date == day)
                        .ToList();

                    if (logs.Count == 0)
                        return false;

                    return !logs.Any(x =>
                        x.IsCheckIn ||
                        x.IsCheckOut);
                });
        }
    }
}