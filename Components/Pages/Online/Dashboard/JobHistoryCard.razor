@using HRM.DTOs
@using HRM.Services.Interfaces
@using HRM.Components.Profile.Employment
@inject IJobService JobService

@if (isLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-6 text-center text-slate-500">Loading job history...</div>
}
else if (error != null)
{
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-6 text-rose-700" role="alert">@error</div>
}
else
{
    <EmploymentHistoryTable Jobs="@jobs" />
}

@code {
    private List<JobDto> jobs = new();
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { jobs = await JobService.GetMyJobHistoryAsync(); }
        catch { error = "Job history could not be loaded. Please reload the page."; }
        finally { isLoading = false; }
    }
}
