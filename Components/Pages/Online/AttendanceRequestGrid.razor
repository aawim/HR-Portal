@page "/online/attendance/attendance-request"
@using HRM.Components.Shared
@page "/online/attendance/attendance-request/{TabSection}"
@using HRM.DTOs
@using HRM.DTOs.Attendance
@using HRM.DTOs.Leave
@using HRM.Helpers
@using HRM.Services.Interfaces.Leave
@using HRM.Models
@using HRM.Models.Archives
@using HRM.Services
@using HRM.Services.Interfaces
@using Microsoft.EntityFrameworkCore

@rendermode RenderMode.InteractiveServer
@inject HrmTeContext DbContext
@inject IOrganisationService OrganisationService
@inject IIndividual _individual
@inject IAttendanceRequestService AttendanceRequests
@inject IAttendanceService Attendance
@inject ILeaveChangeService LeaveChanges


<BackButton Url="/online/attendance" Text="Back to Attendance Hub" />

<div class="px-2 sm:px-4 md:px-6 lg:px-6">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-b border-slate-100 mb-2 mt-[-10px] gap-4">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Attendance Requests</h2>
            <p class="text-sm text-slate-500 mt-1">Review and manage manual attendance log modifications.</p>
        </div>
        @if (activeTab is not ("late-check-in" or "early-check-out"))
        {
        <button @onclick="OpenAddPanel" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-colors flex items-center gap-2 mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Request
        </button>
        }
    </div>

    <nav class="mb-4 flex flex-wrap gap-2 border-b pb-3" aria-label="Attendance request categories">
        @foreach (var tab in RequestTabs)
        {
            <a href="@($"/online/attendance/attendance-request/{tab.Key}")" aria-current="@(activeTab == tab.Key ? "page" : null)"
               class="app-button @(activeTab == tab.Key ? "bg-blue-600 text-white" : "app-button-secondary")">@tab.Label</a>
        }
    </nav>
    @if (activeTab == "late-check-in")
    {
        <LateCheckInRequests @key="activeTab" />
    }
    @if (activeTab == "early-check-out") { <LateCheckInRequests @key="activeTab" Kind="EarlyCheckOut" /> }

    @if (!string.IsNullOrWhiteSpace(requestSuccess))
    {
        <div role="status" class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">
            @requestSuccess
            @if (submittedLeaveChange)
            {
                <a class="ml-2 underline" href="/online/leaves/leave-change-request">View leave change requests</a>
            }
        </div>
    }

    @if (activeTab == "uneven-log-correction")
    {
    <section class="mb-4 rounded-xl border border-slate-200 bg-white p-4">
        <h3 class="font-semibold text-slate-800">Uneven-log corrections</h3>
        <p class="mb-3 text-sm text-slate-500">Request a correction to an uneven clock event. Your original event stays unchanged while the request is pending.</p>
        @if (unevenLogs.Count == 0)
        {
            <p class="text-sm text-slate-500">No uneven clock events in the current salary period.</p>
        }
        @foreach (var log in unevenLogs)
        {
            <div class="flex items-center justify-between gap-3 border-t border-slate-100 py-2">
                <span class="text-sm">@log.Date.ToString("dd MMM yyyy HH:mm:ss")</span>
                @if (CanRequestCorrection(log.AttendanceLogID))
                {
                    <button class="rounded-md bg-blue-50 px-3 py-2 text-sm text-blue-700" @onclick="() => OpenCorrection(log)">Request correction</button>
                }
                else
                {
                    <span class="max-w-md text-xs text-slate-500">@(correctionEligibility.GetValueOrDefault(log.AttendanceLogID)?.Message ?? "Correction unavailable")</span>
                }
            </div>
        }
    </section>
    }

    @if (activeTab is not ("late-check-in" or "early-check-out"))
    {
    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm mb-6">
        @if (isDataLoaded && requestsList.Count > 0 && selectedOrgId != 0)
        {
            <label class="block text-xs font-bold text-slate-500 uppercase mb-3">Summary of the Search</label>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-auto-fit gap-4 mb-6">
            </div>
            <hr class="border-slate-100 mb-6" />
        }

        <div class="grid grid-cols-12 gap-4 mb-4">

            @if (activeTab != "uneven-log-correction")
            {
            <div class="col-span-12 md:col-span-5 lg:col-span-5">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Organisation</label>
                <select @bind="selectedOrgId" disabled class="w-full h-10 px-3 text-sm text-slate-700 bg-slate-100 border border-slate-200 rounded-md focus:outline-none cursor-not-allowed opacity-80">
                    <option value="0">-- All Organisations --</option>
                    @foreach (var org in organisations)
                    {
                        <option value="@org.Id">@org.Name</option>
                    }
                </select>
            </div>

            }
            <div class="col-span-12 @(activeTab == "uneven-log-correction" ? "md:col-span-8" : "md:col-span-3 lg:col-span-3")">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Request Status</label>
                <select @bind="selectedStatusId" class="w-full h-10 px-3 text-sm text-slate-700 bg-slate-50 border border-slate-200 rounded-md focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all cursor-pointer">
                    <option value="0">-- All Statuses --</option>
                    @foreach (var state in requestStates)
                    {
                        <option value="@state.RequestStateId">@state.StateName</option>
                    }
                </select>
            </div>

            <div class="col-span-6 md:col-span-2 lg:col-span-2">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">From</label>
                <input type="date" @bind="startDate" class="w-full h-10 px-3 text-sm text-slate-700 bg-slate-50 border border-slate-200 rounded-md focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" />
            </div>

            <div class="col-span-6 md:col-span-2 lg:col-span-2">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">To</label>
                <input type="date" @bind="endDate" class="w-full h-10 px-3 text-sm text-slate-700 bg-slate-50 border border-slate-200 rounded-md focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" />
            </div>
        </div>

        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100 mt-[-20px]">
            <button @onclick="ResetFilters" class="bg-slate-100 hover:bg-slate-200 text-slate-600 px-6 py-2 rounded-md text-sm font-bold transition-colors border border-slate-200">
                Reset
            </button>
            <button @onclick="ExecuteSearch" disabled="@isLoading" class="bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 text-white px-6 py-2 rounded-md text-sm font-bold transition-colors shadow-sm flex items-center gap-2">
                @if (isLoading)
                {
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    <span>Searching...</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <span>Search</span>
                }
            </button>
        </div>
    </div>

    @if (isDataLoaded)
    {
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">
            @if (VisibleRequests.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-slate-600">
                        <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th scope="col" class="px-6 py-3">Ref No</th>
                                <th scope="col" class="px-6 py-3">Staff</th>
                                <th scope="col" class="px-6 py-3">Date & Time</th>
                                <th scope="col" class="px-6 py-3">Request / Mode</th>
                                <th scope="col" class="px-6 py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in VisibleRequests)
                            {
                                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                    <td class="px-6 py-4 font-medium text-slate-900">@req.ReferenceNo</td>
                                    <td class="px-6 py-4">@req.StaffName</td>
                                    <td class="px-6 py-4">
                                        <div class="font-medium text-slate-700">@req.LogDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-xs text-slate-500">@req.LogTime</div>
                                    </td>
                                    <td class="px-6 py-4 font-medium"><div>@req.Kind</div><div class="text-xs text-slate-500">@req.Mode</div></td>
                                    <td class="px-6 py-4">
                                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full @GetStateColorClass(req.RequestState)">
                                            @req.RequestState
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-10 text-center flex flex-col items-center justify-center">
                    <svg class="w-12 h-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <h3 class="text-lg font-medium text-slate-900">No requests found</h3>
                    <p class="text-sm text-slate-500 mt-1">Try adjusting your filters or date range.</p>
                </div>
            }
        </div>
    }

    }
</div> 


<div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 transition-opacity duration-300 ease-in-out @(showAddPanel ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none")"
            @onclick="CloseAddPanel"></div>

<div class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white shadow-2xl flex flex-col transition-transform duration-300 ease-in-out transform @(showAddPanel ? "translate-x-0" : "translate-x-full")">

    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-lg font-bold text-slate-800">@(isLeaveChange ? "New Leave Change Request" : isCorrection ? "New Uneven Log Correction Request" : "New Attendance Request")</h3>
        <button @onclick="CloseAddPanel" class="text-slate-400 hover:text-slate-600 transition-colors bg-white hover:bg-slate-100 rounded-full p-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6 space-y-5">
        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Staff Member <span class="text-rose-500">*</span></label>
            <select disabled class="w-full h-10 px-3 text-sm text-slate-700 bg-slate-50 border border-slate-200 rounded-md">
                <option>Myself</option>
            </select>
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Request type</label>
            <select @bind="requestKind" @bind:after="RequestKindChanged" disabled="@isSubmitting" class="w-full border rounded-md p-2">
                @if (activeTab == "uneven-log-correction")
                {
                    <option value="correction">Uneven-log correction</option>
                }
                else
                {
                    <option value="attendance">Missing attendance</option>
                    <option value="leave">Leave change</option>
                }
            </select>
        </div>
        @if (isLeaveChange)
        {
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Approved leave</label>
                <select @bind="leaveChange.LeaveId" @bind:after="LeaveSelectionChanged" disabled="@(isSubmitting || loadingLeaves)" class="w-full border rounded-md p-2">
                    <option value="0">Select leave</option>
                    @foreach (var leave in approvedLeaves)
                    {
                        <option value="@leave.LeaveId" disabled="@leave.HasPendingChange">
                            @leave.LeaveType: @leave.FromDate.ToString("dd MMM yyyy") – @leave.ToDate.ToString("dd MMM yyyy") (@leave.Duration days) @(leave.HasPendingChange ? "— change pending" : "")
                        </option>
                    }
                </select>
                @if (loadingLeaves) { <p class="mt-2 text-sm text-slate-500">Loading approved leave...</p> }
                else if (approvedLeaves.Count == 0) { <p class="mt-2 text-sm text-slate-500">You have no approved leave to change.</p> }
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Change type</label>
                <select @bind="leaveChange.Kind" @bind:after="LeaveSelectionChanged" disabled="@isSubmitting" class="w-full border rounded-md p-2">
                    <option value="@LeaveChangeKind.Extension">Extension</option>
                    <option value="@LeaveChangeKind.EarlyReturn">Early return</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">@(leaveChange.Kind == LeaveChangeKind.Extension ? "New leave end date" : "Return-to-work date")</label>
                <input type="date" @bind="leaveChange.Date" disabled="@isSubmitting" class="w-full border rounded-md p-2" />
            </div>
            @if (SelectedLeave != null)
            {
                <div role="status" class="rounded-lg bg-blue-50 p-3 text-sm text-blue-900">
                    @if (LeavePreviewError != null) { <p>@LeavePreviewError</p> }
                    else
                    {
                        var preview = LeaveChangePreview;
                        @if (preview.Duration == 0) { <p>The full leave period will be cancelled upon approval.</p> }
                        else { <p>Requested leave: @SelectedLeave.FromDate.ToString("dd MMM yyyy") – @preview.EndDate.ToString("dd MMM yyyy") (@preview.Duration days).</p> }
                        <p>@(preview.BalanceAdjustment >= 0 ? $"{preview.BalanceAdjustment} unused leave days will return to your balance after approval." : $"{-preview.BalanceAdjustment} additional leave days will be deducted from your balance after approval.")</p>
                    }
                </div>
            }
        }
        @if (isCorrection)
        {
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Uneven clock event</label>
                <select @bind="newRequest.OriginalLogId" @bind:after="OriginalLogChanged" disabled="@isSubmitting" class="w-full border rounded-md p-2">
                    <option value="">Select a clock event</option>
                    @foreach (var log in unevenLogs.Where(x => CanRequestCorrection(x.AttendanceLogID)))
                    {
                        <option value="@log.AttendanceLogID">@log.Date.ToString("dd MMM yyyy HH:mm:ss")</option>
                    }
                </select>
            </div>
        }

        @if (!isLeaveChange)
        {
        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">In/Out Mode <span class="text-rose-500">*</span></label>
            <select @bind="newRequest.InOutModeId" disabled="@(isSubmitting || requestDateInfo?.IsEarlyReturn == true)" class="w-full h-10 px-3 text-sm text-slate-700 bg-white border border-slate-200 rounded-md focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                <option value="0">-- Select Mode --</option>
                <option value="1">Clock In</option>
                <option value="2">Clock Out</option>
                <option value="3">Break Out</option>
                <option value="4">Break In</option>
            </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                @if (isCorrection)
                {
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Clock event date</label>
                    <p class="flex h-10 items-center rounded-md border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700">
                        @(newRequest.OriginalLogId.HasValue ? newRequest.Date.ToString("dd MMM yyyy") : "Select an uneven clock event above")
                    </p>
                }
                else
                {
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Date <span class="text-rose-500">*</span></label>
                    <input type="date" @bind="newRequest.Date" @bind:after="RefreshDateInfo" disabled="@isSubmitting" class="w-full h-10 px-3 text-sm text-slate-700 bg-white border border-slate-200 rounded-md focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
                }
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Time <span class="text-rose-500">*</span></label>
                <input type="time" @bind="newRequest.Time" disabled="@(isSubmitting || requestDateInfo?.IsEarlyReturn == true)" class="w-full h-10 px-3 text-sm text-slate-700 bg-white border border-slate-200 rounded-md focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
            </div>
        </div>
        }

        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Comments / Reason</label>
            <textarea @bind="newRequest.Comments" rows="4" maxlength="250" disabled="@isSubmitting" placeholder="Explain the reason for your request (required)..." class="w-full p-3 text-sm text-slate-700 bg-white border border-slate-200 rounded-md focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 resize-none"></textarea>
        </div>
        @if (!isLeaveChange && checkingDate) { <p class="text-sm text-slate-500">Checking leave for this date...</p> }
        @if (!isLeaveChange && !string.IsNullOrWhiteSpace(requestDateInfo?.Message))
        {
            <div role="status" class="rounded-lg bg-blue-50 p-3 text-sm text-blue-900">@requestDateInfo.Message</div>
        }
        @if (!string.IsNullOrWhiteSpace(requestError))
        {
            <div role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-800">@requestError</div>
        }
    </div>

    <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
        <button @onclick="CloseAddPanel" class="px-4 py-2 bg-white border border-slate-300 rounded-md text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors shadow-sm">
            Cancel
        </button>
        <button @onclick="SubmitNewRequest" disabled="@(isSubmitting || (isLeaveChange ? loadingLeaves || LeavePreviewError != null : checkingDate || requestDateInfo?.CanSubmit != true || (isCorrection && !newRequest.OriginalLogId.HasValue)))" class="px-6 py-2 bg-blue-600 text-white rounded-md text-sm font-bold hover:bg-blue-700 transition-colors shadow-sm disabled:opacity-50">
            @(isSubmitting ? "Submitting..." : isLeaveChange ? leaveChange.Kind == LeaveChangeKind.Extension ? "Request extension" : "Request early return" : requestDateInfo?.IsEarlyReturn == true ? "Request early return" : "Submit request")
        </button>
    </div>
</div>

@code {
    [Parameter] public string? TabSection { get; set; }
    private string activeTab = "attendance";
    private static readonly (string Key, string Label)[] RequestTabs =
    [ ("attendance", "Attendance Requests"), ("late-check-in", "Late check in request"), ("early-check-out", "Early check out request"), ("uneven-log-correction", "Uneven log correction request") ];
    private IEnumerable<AttendanceRequestDto> VisibleRequests => requestsList.Where(r => activeTab == "uneven-log-correction" ? r.Kind == "Uneven-log correction" : r.Kind == "Attendance");
    protected override void OnParametersSet()
    {
        activeTab = RequestTabs.Any(t => t.Key == TabSection) ? TabSection! : "attendance";
        showAddPanel = false;
    }
    // Filter Bindings
    private int selectedOrgId = 0;
    private int selectedStatusId = 0;
    private DateTime startDate;
    private DateTime endDate;

    // UI State
    private bool isDataLoaded = false;
    private bool isLoading = false;

    // Data Collections
    private List<DropdownItem> organisations = new();
    private List<AttendanceRequestDto> requestsList = new();
    private List<RequestState> requestStates = new();
    private Dictionary<string, int> stateStatistics = new();
    private string activeCardFilter = string.Empty;

    // --- Panel State ---
    private bool showAddPanel = false;
    private AttendanceRequestApplicationDto newRequest = new();
    private List<AttendanceLogDto> unevenLogs = [];
    private readonly Dictionary<int, AttendanceRequestDateInfoDto> correctionEligibility = [];
    private bool CanRequestCorrection(int logId) => correctionEligibility.TryGetValue(logId, out var info) && info.CanSubmit && !info.IsEarlyReturn;
    private AttendanceRequestDateInfoDto? requestDateInfo;
    private bool isSubmitting, checkingDate, submittedLeaveChange, loadingLeaves;
    private List<LeaveChangeLeaveDto> approvedLeaves = [];
    private LeaveChangeApplicationDto leaveChange = new();
    private bool isLeaveChange => requestKind == "leave";
    private LeaveChangeLeaveDto? SelectedLeave => approvedLeaves.FirstOrDefault(x => x.LeaveId == leaveChange.LeaveId);
    private (DateTime EndDate, int Duration, int BalanceAdjustment) LeaveChangePreview => LeaveChangeRules.Calculate(
        SelectedLeave!.FromDate, SelectedLeave.ToDate, SelectedLeave.Duration, leaveChange.Kind, leaveChange.Date, SelectedLeave.IncludeHolidays);
    private string? LeavePreviewError
    {
        get
        {
            if (SelectedLeave == null) return "Select an approved leave.";
            if (SelectedLeave.HasPendingChange) return "This leave already has a pending change request.";
            if (leaveChange.Kind == LeaveChangeKind.EarlyReturn && leaveChange.Date.Date <= DateTime.Today)
                return "Choose a future return-to-work date.";
            try { _ = LeaveChangePreview; return null; }
            catch (InvalidOperationException ex) { return ex.Message; }
        }
    }
    private string requestKind = "attendance";
    private bool isCorrection
    {
        get => requestKind == "correction";
        set => requestKind = value ? "correction" : "attendance";
    }
    private int dateCheckVersion;
    private string? requestError, requestSuccess;

    // --- Panel Methods ---
    private async Task OpenAddPanel()
    {
        newRequest = new();
        leaveChange = new();
        isCorrection = activeTab == "uneven-log-correction";
        requestError = null;
        showAddPanel = true;
        await RefreshDateInfo();
    }

    private async Task OpenCorrection(AttendanceLogDto log)
    {
        if (!CanRequestCorrection(log.AttendanceLogID)) return;
        newRequest = new() { OriginalLogId = log.AttendanceLogID, Date = DateOnly.FromDateTime(log.Date), Time = TimeOnly.FromDateTime(log.Date) };
        isCorrection = true;
        requestError = null;
        showAddPanel = true;
        await RefreshDateInfo();
    }

    private async Task RequestKindChanged()
    {
        newRequest.OriginalLogId = null;
        requestError = null;
        if (isLeaveChange)
        {
            dateCheckVersion++;
            checkingDate = false;
            requestDateInfo = null;
            loadingLeaves = true;
            try { approvedLeaves = await LeaveChanges.GetMyLeavesAsync(); }
            catch { approvedLeaves = []; requestError = "Approved leave could not be loaded. Please try again."; }
            finally { loadingLeaves = false; }
            return;
        }
        await RefreshDateInfo();
    }

    private void LeaveSelectionChanged()
    {
        requestError = null;
        if (SelectedLeave == null) return;
        leaveChange.Date = leaveChange.Kind == LeaveChangeKind.Extension
            ? (SelectedLeave.ToDate.Date >= DateTime.Today ? SelectedLeave.ToDate.Date.AddDays(1) : DateTime.Today)
            : (SelectedLeave.FromDate.Date > DateTime.Today ? SelectedLeave.FromDate.Date : DateTime.Today.AddDays(1));
    }

    private async Task OriginalLogChanged()
    {
        var log = unevenLogs.FirstOrDefault(x => x.AttendanceLogID == newRequest.OriginalLogId && CanRequestCorrection(x.AttendanceLogID));
        if (log == null)
        {
            newRequest.OriginalLogId = null;
            requestDateInfo = null;
            requestError = "Select a clock event that is eligible for correction.";
            return;
        }
        if (log != null)
        {
            newRequest.Date = DateOnly.FromDateTime(log.Date);
            newRequest.Time = TimeOnly.FromDateTime(log.Date);
        }
        await RefreshDateInfo();
    }

    private async Task RefreshDateInfo()
    {
        var date = newRequest.Date;
        var version = ++dateCheckVersion;
        checkingDate = true;
        requestDateInfo = null;
        requestError = null;
        try
        {
            var info = await AttendanceRequests.GetDateInfoAsync(date, isCorrection ? newRequest.OriginalLogId : null);
            if (version == dateCheckVersion)
            {
                if (isCorrection && info.IsEarlyReturn)
                {
                    info.CanSubmit = false;
                    info.IsEarlyReturn = false;
                    info.Message = "An uneven-log correction cannot move an event onto approved leave. Choose Missing attendance to request a future early return.";
                }
                requestDateInfo = info;
            }
        }
        catch { if (version == dateCheckVersion) requestError = "Leave availability could not be checked. Please try again."; }
        finally { if (version == dateCheckVersion) checkingDate = false; }
    }

    private void CloseAddPanel()
    {
        if (isSubmitting) return;
        showAddPanel = false;
    }

    private async Task SubmitNewRequest()
    {
        if (isSubmitting || (isLeaveChange ? loadingLeaves : checkingDate)) return;
        if (isLeaveChange && LeavePreviewError != null) { requestError = LeavePreviewError; return; }
        if (isCorrection && !newRequest.OriginalLogId.HasValue) { requestError = "Select an uneven clock event."; return; }
        isSubmitting = true;
        requestError = null;
        try
        {
            var result = isLeaveChange
                ? await LeaveChanges.SubmitAsync(new LeaveChangeApplicationDto
                {
                    LeaveId = leaveChange.LeaveId, Kind = leaveChange.Kind, Date = leaveChange.Date, Reason = newRequest.Comments
                })
                : await AttendanceRequests.SubmitAsync(newRequest);
            if (!result.Success) { requestError = result.Message; return; }
            requestSuccess = result.Message;
            submittedLeaveChange = isLeaveChange || requestDateInfo?.IsEarlyReturn == true;
            showAddPanel = false;
            try
            {
                if (submittedLeaveChange) approvedLeaves = await LeaveChanges.GetMyLeavesAsync();
                else
                {
                    await RefreshUnevenLogs();
                    await ExecuteSearch();
                }
            }
            catch { requestSuccess += " The request was saved, but the list could not refresh. Use Search to reload it."; }
        }
        catch { requestError = "The request could not be submitted. Please try again."; }
        finally { isSubmitting = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        SetCurrentSalaryPeriod();
        activeCardFilter = string.Empty;

        organisations = await OrganisationService.GetAllOrganisationsAsync();
        requestStates = await DbContext.RequestStates.ToListAsync();

        await SetDefaultOrganisationAsync();
        await RefreshUnevenLogs();
    }

    private async Task RefreshUnevenLogs()
    {
        unevenLogs = await Attendance.GetMyUnevenLogsAsync();
        await LoadCorrectionEligibility();
    }

    private async Task LoadCorrectionEligibility()
    {
        correctionEligibility.Clear();
        foreach (var group in unevenLogs.GroupBy(x => x.Date.Date))
        {
            AttendanceRequestDateInfoDto info;
            try
            {
                info = await AttendanceRequests.GetDateInfoAsync(DateOnly.FromDateTime(group.Key), group.First().AttendanceLogID);
                if (info.IsEarlyReturn) info.Message = "Use a leave change request for this future leave date.";
            }
            catch
            {
                info = new() { CanSubmit = false, Message = "Correction availability could not be checked. Reload the page to try again." };
            }
            foreach (var log in group) correctionEligibility[log.AttendanceLogID] = info;
        }
    }

    private void FilterByCard(string status)
    {
        activeCardFilter = status;
    }

    private async Task SetDefaultOrganisationAsync()
    {
        try
        {
            int currentIndividualId = await _individual.GetIndividualID();

            var userJob = await DbContext.Jobs
                .Where(j => j.IndividualID == currentIndividualId
                         && (j.TerminatedDate == null || j.TerminatedDate > DateTime.Today))
                .FirstOrDefaultAsync();

            if (userJob != null)
            {
                selectedOrgId = userJob.OrganisationID;
            }
        }
        catch
        {
            selectedOrgId = 0;
        }
    }

    private void SetCurrentSalaryPeriod()
    {
        DateTime today = DateTime.Today;
        startDate = today.Day >= 15
            ? new DateTime(today.Year, today.Month, 15)
            : new DateTime(today.Year, today.Month, 15).AddMonths(-1);
        endDate = startDate.AddMonths(1).AddDays(1);
    }

    private async Task ExecuteSearch()
    {
        isLoading = true;
        isDataLoaded = false;
        requestsList.Clear();
        StateHasChanged();

        try
        {
            // USING LEFT JOINS to prevent missing data from hiding records
            int currentIndividualId = await _individual.GetIndividualID();
            var links = DbContext.AttendanceLogRequests.Select(x => new { x.RequestId, x.AttendanceLogId, x.Comments })
                .Concat(DbContext.AttendanceLogChangeRequests.Select(x => new { x.RequestId, x.AttendanceLogId, x.Comments }));
            var query = from req in links
                        join r in DbContext.Requests on req.RequestId equals r.RequestId
                        join log in DbContext.AttendanceLogs on req.AttendanceLogId equals log.AttendanceLogId

                        join rs in DbContext.RequestStates on r.RequestStateId equals rs.RequestStateId into rsGroup
                        from rs in rsGroup.DefaultIfEmpty()

                        join ind in DbContext.Individuals on log.IndividualId equals ind.BusinessEntityId into indGroup
                        from ind in indGroup.DefaultIfEmpty()

                        join org in DbContext.Organisations on log.OrganisationId equals org.BusinessEntityID into orgGroup
                        from org in orgGroup.DefaultIfEmpty()

                        where log.IndividualId == currentIndividualId && log.Date >= startDate.Date && log.Date < endDate.Date.AddDays(1)
                              && (r.RequestTypeId == SharedConfig.RequestTypes.ATTENDANCE_LOG_REQUEST || r.RequestTypeId == SharedConfig.RequestTypes.ATTENDANCE_LOG_CHANGE_REQUEST)
                        select new { req, r, rs, log, ind, org };

            // Apply Filters
            if (selectedOrgId > 0)
            {
                query = query.Where(q => q.log.OrganisationId == selectedOrgId);
            }

            if (selectedStatusId > 0)
            {
                query = query.Where(q => q.r.RequestStateId == selectedStatusId);
            }

            requestsList = await query
                .OrderByDescending(q => q.log.Date)
                .Select(q => new AttendanceRequestDto
                    {
                        RequestId = q.req.RequestId,
                        ReferenceNo = q.r.ReferenceNumber ?? "N/A",
                        Kind = q.r.RequestTypeId == SharedConfig.RequestTypes.ATTENDANCE_LOG_CHANGE_REQUEST ? "Uneven-log correction" : "Attendance",
                        LogDate = q.log.Date,
                        LogTime = q.log.Date.ToString("HH:mm"),

                    // Added null checks to safely handle the left joins
                        OrganisationName = q.org != null ? q.org.OrganisationName : "Unknown",
                        StaffName = q.ind != null ? (q.ind.FirstNameEnglish + " " + q.ind.MiddleNameEnglish + " " + q.ind.LastNameEnglish).Trim() : "Unknown Staff",

                        Mode = q.log.InOutModeId == 1 ? "In" :
                                   q.log.InOutModeId == 2 ? "Out" :
                                   q.log.InOutModeId == 3 ? "Break Out" :
                                   q.log.InOutModeId == 4 ? "Break In" : q.log.InOutModeId.ToString(),
                        Comments = q.req.Comments,
                        RequestState = q.rs != null ? q.rs.StateName : "Unknown"
                    })
                .ToListAsync();

            stateStatistics = requestsList
                .GroupBy(r => r.RequestState)
                .ToDictionary(g => g.Key, g => g.Count());

            isDataLoaded = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilters()
    {
        selectedStatusId = 0;
        SetCurrentSalaryPeriod();
        isDataLoaded = false;
        requestsList.Clear();
        stateStatistics.Clear();

        await SetDefaultOrganisationAsync();
    }

    // --- DTO for Table Rows ---
    public class AttendanceRequestDto
    {
        public int RequestId { get; set; }
        public string ReferenceNo { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
        public DateTime LogDate { get; set; }
        public string LogTime { get; set; } = string.Empty;
        public string OrganisationName { get; set; } = string.Empty;
        public string StaffName { get; set; } = string.Empty;
        public string Mode { get; set; } = string.Empty;
        public string? Comments { get; set; }
        public string RequestState { get; set; } = string.Empty;
    }

    // Helpers
    private string GetStateColorClass(string state)
    {
        if (string.IsNullOrEmpty(state)) return "bg-slate-100 text-slate-600";

        return state.Trim().ToLower() switch
        {
            "approved" => "bg-emerald-100 text-emerald-800",
            "rejected" => "bg-rose-100 text-rose-800",
            "pending verification" => "bg-amber-100 text-amber-800",
            "pending approval" => "bg-blue-100 text-blue-800",
            "incomplete" => "bg-orange-100 text-orange-800",
            "pending" => "bg-amber-100 text-amber-800",
            _ => "bg-slate-100 text-slate-600"
        };
    }
}
