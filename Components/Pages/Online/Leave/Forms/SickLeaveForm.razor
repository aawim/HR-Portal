@using HRM.Services.State
<LeaveApplicationForm LeaveState="LeaveState" ExplanationLabel="Medical explanation">
    <AdditionalFields>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm mb-1" for="leave-certificate">Medical Certificate No</label>
                <InputText id="leave-certificate" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.MedicalCertificateNo" />
            </div>
            <div>
                <label class="block text-sm mb-1" for="leave-hospital">Hospital or Clinic</label>
                <InputText id="leave-hospital" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.HospitalName" />
            </div>
        </div>
    </AdditionalFields>
</LeaveApplicationForm>
@code {
    [Parameter] public LeaveApplicationState LeaveState { get; set; } = default!;
}
