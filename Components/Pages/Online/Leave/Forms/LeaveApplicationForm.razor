@using HRM.Services.State
@using HRM.Services.Interfaces
@using HRM.Helpers
@inject IGeographyService GeographyService
@inject HRM.Services.Interfaces.Leave.ILeaveService LeaveService
@inject ILogger<LeaveApplicationForm> Logger

<div class="bg-white rounded-lg border border-slate-200 p-6 space-y-4">
    <h3 class="text-lg font-semibold text-slate-800">@Title</h3>
    <div class="rounded-lg bg-blue-50 p-3 text-sm text-blue-900">Available balance: <strong>@LeaveState.RemainingDays days</strong></div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
            <label class="block text-sm mb-1" for="leave-from">From Date *</label>
            <InputDate id="leave-from" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.FromDate" @bind-Value:after="FromChanged" />
        </div>
        <div>
            <label class="block text-sm mb-1" for="leave-to">To Date *</label>
            <InputDate id="leave-to" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.ToDate" @bind-Value:after="ToChanged" />
        </div>
        <div>
            <label class="block text-sm mb-1" for="leave-duration">Days *</label>
            <InputNumber id="leave-duration" class="w-full border rounded-md p-2" min="1" @bind-Value="LeaveState.Model.Duration" @bind-Value:after="DurationChanged" />
        </div>
    </div>
    @if (LeaveState.Model.ToDate < LeaveState.Model.FromDate)
    {
        <p class="text-sm text-red-700" role="alert">The end date must be on or after the start date.</p>
    }
    @if (LeaveState.Model.Duration > LeaveState.RemainingDays)
    {
        <p class="text-sm text-red-700" role="alert">The requested days exceed your available balance.</p>
    }
    <div>
        <label class="block text-sm mb-1" for="leave-reason">Reason *</label>
        <InputSelect id="leave-reason" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.LeaveReasonId" aria-required="true">
            <option value="0">-- Select Reason --</option>
            @foreach (var reason in LeaveState.Reasons)
            {
                <option value="@reason.Id">@reason.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => LeaveState.Model.LeaveReasonId" />
        @if (LeaveState.Reasons.Count == 0)
        {
            <p class="mt-1 text-sm text-amber-700" role="alert">No reasons are configured for this leave type. Contact HR before applying.</p>
        }
    </div>
    @if (handoverError != null) { <p role="alert" class="text-sm text-red-700">@handoverError</p> }
    @if (LeaveState.IsWorkHandoverRequired)
    {
        <section class="space-y-3 rounded-lg border border-indigo-200 bg-indigo-50/40 p-4">
            <h4 class="text-sm font-semibold text-slate-800">Work handover required</h4>
            <p class="text-sm text-slate-600">Your leave policy requires handover for leave longer than @LeaveState.WorkHandoverAfterDays days.</p>
            <p class="text-sm text-slate-600">Assign each task to an employee. Every task needs their verification and approval, followed by approval from any one team or department supervisor, before HR can approve your leave.</p>
            <HRM.Components.Pages.Online.Leave.HandoverTaskEditor Tasks="LeaveState.Model.HandoverTasks" Recipients="handoverRecipients" OnChanged="StateHasChanged" />
            @if (handoverRecipients.Count == 0) { <p class="text-sm text-amber-700">No eligible employees are available. Contact HR before applying.</p> }
        </section>
    }
    @AdditionalFields
    <div>
        <label class="block text-sm mb-1" for="leave-explanation">@ExplanationLabel</label>
        <InputTextArea id="leave-explanation" class="w-full border rounded-md p-2" rows="4" @bind-Value="LeaveState.Model.Explanation" />
        <p class="text-xs text-slate-500 mt-1">Explanation and additional details: @DetailsLength / 250 characters</p>
        @if (DetailsLength > 250)
        {
            <p class="text-sm text-red-700" role="alert">Shorten your explanation or additional details to 250 characters.</p>
        }
    </div>
    <details class="border rounded-lg p-3" open="@LeaveState.SelectedAddressLocationId.HasValue">
        <summary class="cursor-pointer text-sm font-medium">Contact and location during leave</summary>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            <div>
                <label class="block text-sm mb-1" for="leave-country">Country</label>
                <InputSelect id="leave-country" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.CountryId" @bind-Value:after="CountryChanged">
                    <option value="0">Select Country</option>
                    @foreach (var country in LeaveState.Countries) { <option value="@country.CountryId">@country.NameEnglish</option> }
                </InputSelect>
            </div>
            <div>
                <label class="block text-sm mb-1" for="leave-atoll">Atoll</label>
                <InputSelect id="leave-atoll" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.AtollId" @bind-Value:after="AtollChanged">
                    <option value="0">Select Atoll</option>
                    @foreach (var atoll in LeaveState.Atolls) { <option value="@atoll.AtollId">@atoll.NameEnglish</option> }
                </InputSelect>
            </div>
            <div>
                <label class="block text-sm mb-1" for="leave-island">Island</label>
                <InputSelect id="leave-island" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.IslandId">
                    <option value="0">Select Island</option>
                    @foreach (var island in LeaveState.Islands) { <option value="@island.IslandId">@island.NameEnglish</option> }
                </InputSelect>
            </div>
            <div>
                <label class="block text-sm mb-1" for="leave-phone">Phone</label>
                <InputText id="leave-phone" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.Phone" />
            </div>
            <div>
                <label class="block text-sm mb-1" for="leave-email">Contact Email</label>
                <InputText id="leave-email" type="email" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.ContactEmail" />
                <ValidationMessage For="() => LeaveState.Model.ContactEmail" />
            </div>
        </div>
        <label class="block text-sm mt-3 mb-1" for="leave-address">Address</label>
        <InputText id="leave-address" class="w-full border rounded-md p-2" @bind-Value="LeaveState.Model.Address" />
    </details>
    <button type="submit" disabled="@(!CanSubmit)" class="bg-blue-600 text-white px-4 py-2 rounded disabled:opacity-50">
        @(LeaveState.IsSubmitting ? "Submitting..." : "Submit Application")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public LeaveApplicationState LeaveState { get; set; } = default!;
    [Parameter] public string ExplanationLabel { get; set; } = "Explanation";
    [Parameter] public RenderFragment? AdditionalFields { get; set; }
    private string Title => string.IsNullOrWhiteSpace(LeaveState.SelectedLeaveTypeName)
        ? "Leave Information" : $"{LeaveState.SelectedLeaveTypeName} Information";
    private int? currentBalanceId;
    private List<HRM.DTOs.Leave.LeaveHandoverRecipient> handoverRecipients = [];
    private string? handoverError;
    private bool loadingHandover;
    private int handoverLoadVersion;
    private bool HasHandover => !LeaveState.IsWorkHandoverRequired ||
        (LeaveState.Model.HandoverTasks.Count is > 0 and <= 50 && LeaveState.Model.HandoverTasks.All(task =>
            handoverRecipients.Any(x => x.JobId == task.JobId) && !string.IsNullOrWhiteSpace(task.Tasks) && task.Tasks.Trim().Length <= 250));
    private int DetailsLength => LeaveApplicationDetails.Build(LeaveState.Model).Length;
    private bool CanSubmit => LeaveState.CanSubmit && !LeaveState.IsSubmitting && !loadingHandover && handoverError == null && HasHandover &&
        LeaveState.Model.ToDate >= LeaveState.Model.FromDate && LeaveState.Model.Duration <= LeaveState.RemainingDays && DetailsLength <= 250;

    protected override async Task OnInitializedAsync()
    {
        if (LeaveState.Countries.Count == 0) LeaveState.Countries = await GeographyService.GetCountriesAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (currentBalanceId == LeaveState.Model.JobLeaveTypeId && LeaveState.Model.FromDate != default) return;
        if (currentBalanceId.HasValue && currentBalanceId != LeaveState.Model.JobLeaveTypeId)
        {
            LeaveState.Model.HandoverJobId = null;
            LeaveState.Model.HandoverNotes = null;
            LeaveState.Model.HandoverTasks.Clear();
        }
        currentBalanceId = LeaveState.Model.JobLeaveTypeId;
        if (LeaveState.Model.FromDate == default) LeaveState.Model.FromDate = DateTime.Today;
        if (LeaveState.Model.Duration < 1) LeaveState.Model.Duration = 1;
        DurationChanged();
        await LoadHandoverAsync();
    }
    private async Task FromChanged() { DurationChanged(); await LoadHandoverAsync(); }
    private async Task LoadHandoverAsync()
    {
        var version = ++handoverLoadVersion;
        loadingHandover = true; handoverError = null;
        try
        {
            if (!LeaveState.Model.JobLeaveTypeId.HasValue) throw new InvalidOperationException("Select a leave balance first.");
            var rules = await LeaveService.GetHandoverRulesAsync(LeaveState.Model.JobLeaveTypeId.Value, LeaveState.Model.FromDate);
            if (version != handoverLoadVersion) return;
            LeaveState.WorkHandoverAfterDays = rules.AfterDays;
            handoverRecipients = rules.Recipients;
            foreach (var task in LeaveState.Model.HandoverTasks.Where(t => !handoverRecipients.Any(x => x.JobId == t.JobId))) task.JobId = null;
            if (!handoverRecipients.Any(x => x.JobId == LeaveState.Model.HandoverJobId)) LeaveState.Model.HandoverJobId = null;
        }
        catch (Exception ex) { Logger.LogError(ex, "Could not load handover policy"); if (version == handoverLoadVersion) handoverError = "The leave handover policy could not be loaded. Please select the leave type again."; }
        finally { if (version == handoverLoadVersion) loadingHandover = false; }
    }
    private void ToChanged() => LeaveState.Model.Duration = LeaveApplicationDates.Count(
        LeaveState.Model.FromDate, LeaveState.Model.ToDate, LeaveState.IncludeHolidays);
    private void DurationChanged()
    {
        if (LeaveState.Model.Duration < 1) return;
        LeaveState.Model.ToDate = LeaveApplicationDates.EndDate(
            LeaveState.Model.FromDate, LeaveState.Model.Duration, LeaveState.IncludeHolidays);
    }
    private async Task CountryChanged()
    {
        LeaveState.Model.AtollId = 0;
        LeaveState.Model.IslandId = null;
        LeaveState.Islands.Clear();
        LeaveState.Atolls = LeaveState.Model.CountryId > 0 ? await GeographyService.GetAtollsAsync() : new();
    }
    private async Task AtollChanged()
    {
        LeaveState.Model.IslandId = null;
        LeaveState.Islands = LeaveState.Model.AtollId > 0 ? await GeographyService.GetIslandsAsync(LeaveState.Model.AtollId) : new();
    }
}
