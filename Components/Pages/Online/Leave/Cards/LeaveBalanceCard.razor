@using HRM.DTOs.Leave
@using HRM.Models
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using HRM.Services.State

@inject ILeaveService LeaveService
@inject ToastService ToastService


<div class="w-full">

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm max-h-[820px] overflow-y-auto">

        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">

            <div>
                <h3 class="text-sm font-semibold text-slate-800">
                    Leave Balance
                </h3>

                <p class="text-xs text-slate-500">
                    Available days
                </p>
            </div>

            <i class="fas fa-calendar-check text-blue-500"></i>
        </div>



        <!-- List -->
        <div class="divide-y divide-slate-100">


            @if (jobTypes != null && jobTypes.Any())
            {
                @foreach (var leave in jobTypes)
                {
                    <div class="flex items-center justify-between
                                px-4 py-3
                                hover:bg-slate-50 transition">

                        <!-- Leave Information -->
                        <div class="flex items-center gap-3 min-w-0">


                            <div class="shrink-0 w-9 h-9 rounded-lg
                                        bg-blue-50
                                        flex items-center justify-center">

                                <i class="fas fa-plane-departure
                                          text-blue-600 text-sm">
                                </i>

                            </div>



                            <div class="truncate">


                                <div class="text-sm font-medium
                                            text-slate-800 truncate">

                                    @(leave.LeaveType?.Name
                                        ?? leave.LeaveType?.Name
                                        ?? "Unknown Leave Type")

                                </div>



                                <div class="flex items-center gap-1">

                                    <span class="text-xl font-bold text-slate-900">
                                        @leave.RemainingDays
                                    </span>


                                    <span class="text-xs text-slate-500">
                                        days
                                    </span>

                                </div>


                            </div>
                        </div>

                        <!-- Action -->
                        @if (leave.RemainingDays > 0 && leave.IsLeaveInfoUpdated == true)
                        {
                           <button type="button"
                                    @onclick="() => ApplyLeaveType(leave)"
                                    class="shrink-0 inline-flex items-center gap-1
                                           px-3 py-1.5
                                           text-xs font-medium
                                           text-white
                                           bg-blue-600
                                           rounded-lg
                                           hover:bg-blue-700
                                           transition">


                                <i class="fas fa-plus text-xs"></i>

                                Apply

                            </button>

                        }
                        else
                        {

                            <span class="shrink-0 px-2 py-1
                                         text-xs font-medium
                                         rounded-full
                                         bg-red-50
                                         text-red-600">

                                Empty

                            </span>

                        }


                    </div>

                }

            }
            else
            {

                <div class="p-4 text-center text-sm text-slate-500">
                    No leave balance found.
                </div>

            }


        </div>


    </div>

</div>



@code {
    [Parameter]
    public EventCallback OnLeaveTypeSelected { get; set; }

    [Parameter]
    public LeaveApplicationState LeaveState { get; set; } = default!;
    [Parameter] public int RefreshKey { get; set; }
    private int? lastRefresh;
    private List<JobLeaveType> jobTypes = new();
    private List<ProcessingLeaveDto> processingLeaves = new();



    protected override async Task OnParametersSetAsync()
    {
        if (lastRefresh == RefreshKey) return;
        lastRefresh = RefreshKey;
        jobTypes = LeaveState.ApplicantJobId.HasValue
            ? await LeaveService.GetApplicantLeaveBalancesAsync(LeaveState.ApplicantJobId.Value)
            : await LeaveService.GetMyLeaveBalancesAsync();
        if (LeaveState.Model.JobLeaveTypeId.HasValue)
            LeaveState.RemainingDays = jobTypes.FirstOrDefault(x => x.JobLeaveTypeId == LeaveState.Model.JobLeaveTypeId)?.RemainingDays ?? 0;

    }

    private async Task ApplyLeaveType(JobLeaveType leave)
    {

        var applicationType = await LeaveService.GetApplicationLeaveTypeAsync(leave.JobLeaveTypeId, LeaveState.ApplicantJobId);
        if (applicationType == null)
        {
            ToastService.Warning("This leave type is unavailable. Please refresh or contact HR.");
            return;
        }

        LeaveState.Model.JobLeaveTypeId = applicationType.JobLeaveTypeId;
        LeaveState.Model.LeaveTypeId = applicationType.LeaveTypeId;
        LeaveState.RemainingDays = applicationType.RemainingDays;
        LeaveState.IncludeHolidays = applicationType.IncludeHolidays;
        LeaveState.Reasons = applicationType.Reasons;
        LeaveState.Model.LeaveReasonId = 0;
        LeaveState.Model.MedicalCertificateNo = null;
        LeaveState.Model.HospitalName = null;
        LeaveState.Model.Destination = null;
        LeaveState.Model.Purpose = null;
        LeaveState.ResolveForm(applicationType.LeaveTypeName);
       
        // Notify parent
        await OnLeaveTypeSelected.InvokeAsync();

    }

}
