@using HRM.Components.Shared
@using HRM.DTOs.Leave
@using HRM.Services.Interfaces.LeaveType
@using HRM.Services.Interfaces
@inject ILeaveTypeService LeaveTypeService
@inject IUserAccessService UserAccessService




<div class="w-full">

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">

        <!-- LEFT: CREATE / EDIT FORM -->
        <section class="min-w-0 xl:col-span-8">

            <div class="overflow-hidden rounded-2xl
                        border border-slate-200
                        bg-white shadow-sm">

                <!-- Form Header -->
                <div class="flex flex-col gap-3
                            border-b border-slate-200
                            px-5 py-4
                            sm:flex-row
                            sm:items-center
                            sm:justify-between">

                    <div class="flex items-center gap-3">

                        <div class="flex h-11 w-11
                                    shrink-0 items-center
                                    justify-center rounded-xl
                                    bg-indigo-50
                                    text-indigo-600">

                            <span class="material-symbols-rounded">
                                @(_isEditMode
                                    ? "edit_note"
                                    : "add_circle")
                            </span>

                        </div>

                        <div>

                            <h2 class="text-sm font-semibold
                                       text-slate-900">

                                @(_isEditMode
                                    ? "Edit Leave Type"
                                    : "Create Leave Type")

                            </h2>

                            <p class="mt-0.5 text-xs
                                      text-slate-500">

                                @(_isEditMode
                                    ? "Update the selected leave type."
                                    : "Create a new organisation leave type.")

                            </p>

                        </div>

                    </div>

                    @if (_isEditMode)
                    {
                        <button type="button"
                                disabled="@_isSaving"
                                @onclick="StartCreate"
                                class="inline-flex items-center
                                       justify-center gap-2
                                       rounded-xl border
                                       border-slate-200
                                       bg-white px-3.5 py-2
                                       text-sm font-semibold
                                       text-slate-700
                                       transition
                                       hover:bg-slate-50">

                            <span class="material-symbols-rounded
                                         text-[18px]">
                                add
                            </span>

                            New Leave Type

                        </button>
                    }

                </div>

                <EditForm Model="@_model"
                          OnValidSubmit="@SaveAsync">

                    <DataAnnotationsValidator />

                    <div class="space-y-6 p-5">

                        @if (!string.IsNullOrWhiteSpace(
                            _formMessage))
                        {
                            <div class="@GetMessageClass()">

                                <span class="material-symbols-rounded
                                             text-[19px]">
                                    @(_saveSucceeded
                                        ? "check_circle"
                                        : "error")
                                </span>

                                <span>
                                    @_formMessage
                                </span>

                            </div>
                        }

                        <!-- Names -->
                        <div class="grid grid-cols-1 gap-5
                                    lg:grid-cols-2">

                            <div>
                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Name
                                    <span class="text-red-500">*</span>
                                </label>

                                <InputText
                                    @bind-Value="_model.Name"
                                    disabled="@FormDisabled"
                                    class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none transition
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100
                                           disabled:bg-slate-100" />

                                <ValidationMessage
                                    For="@(() => _model.Name)" />
                            </div>

                            <div>
                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Name in Dhivehi
                                </label>

                                <InputText
                                    @bind-Value="_model.NameDhivehi"
                                    disabled="@FormDisabled"
                                    dir="rtl"
                                    class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none transition
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100
                                           disabled:bg-slate-100" />
                            </div>

                        </div>

                        <!-- Numeric -->
                        <div class="grid grid-cols-1 gap-5
                                    sm:grid-cols-2
                                    xl:grid-cols-4">

                            <div>
                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Duration
                                </label>

                                <InputNumber
                                    @bind-Value="_model.Duration"
                                    disabled="@FormDisabled"
                                    class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />
                            </div>

                            <div>
                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Service Months
                                </label>

                                <InputNumber
                                    @bind-Value="_model.ServiceDurationMonths"
                                    disabled="@FormDisabled"
                                    class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />
                            </div>

                            <div>
                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Request Type ID
                                </label>

                                <InputNumber
                                    @bind-Value="_model.RequestTypeId"
                                    disabled="@FormDisabled"
                                    class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />
                            </div>

                            @if (_model.IncludePay)
                            {
                                <div>
                                    <label class="mb-1.5 block
                                                  text-xs font-semibold
                                                  text-slate-700">
                                        Pay %
                                    </label>

                                    <InputNumber
                                        @bind-Value="_model.PayPercentage"
                                        disabled="@FormDisabled"
                                        class="w-full rounded-xl
                                               border border-slate-300
                                               px-3 py-2.5 text-sm
                                               outline-none
                                               focus:border-indigo-500
                                               focus:ring-2
                                               focus:ring-indigo-100" />
                                </div>
                            }

                        </div>

                        <!-- Behaviour -->
                        <div>

                            <h3 class="text-xs font-semibold
                                       uppercase tracking-wide
                                       text-slate-500">
                                Leave Behaviour
                            </h3>

                            <div class="mt-3 grid grid-cols-1
                                        gap-3 sm:grid-cols-2
                                        xl:grid-cols-3">

                            @*    <ToggleOption Title="Include Holidays"
                                    Description="Holidays count toward duration."
                                    @bind-Value="_model.IncludeHolidays"
                                    Disabled="@FormDisabled"
                                    /> *@



                                <ToggleOption Title="Include Holidays"
                                    Description="Holidays count toward duration."
                                    @bind-Value="_model.IncludeHolidays"
 
                                    />

                                <ToggleOption Title="Include Pay"
                                    Description="Leave is eligible for pay."
                                    @bind-Value="_model.IncludePay"
                                   
                                    />

                                <ToggleOption Title="Public"
                                    Description="Visible as a public leave type."
                                    @bind-Value="_model.IsPublic"
                                   

                                    />

                                <ToggleOption Title="Location Required"
                                    Description="Location is required when applying."
                                    @bind-Value="_model.IsLocationRequired"
                                  
                                    
                                    />

                                <ToggleOption Title="Staff Wide"
                                    Description="Available to all eligible staff."
                                    @bind-Value="_model.IsStaffWideAvailable"
                                   

                                    />

                                <ToggleOption Title="Renewed"
                                    Description="Leave entitlement renews periodically."
                                    @bind-Value="_model.IsRenewed"
                                  
                                    />

                            </div>

                        </div>

                        @if (_model.IsRenewed)
                        {
                            <div class="rounded-xl border
                                        border-indigo-100
                                        bg-indigo-50/50 p-4">

                                <h3 class="text-sm font-semibold
                                           text-indigo-900">
                                    Renewal Settings
                                </h3>

                                <div class="mt-4 grid
                                            grid-cols-1 gap-4
                                            sm:grid-cols-2">

                                    <div>
                                        <label class="mb-1.5 block
                                                      text-xs font-semibold
                                                      text-slate-700">
                                            Start in Month
                                        </label>

                                        <InputNumber
                                            @bind-Value="_model.StartInMonth"
                                            disabled="@FormDisabled"
                                            class="w-full rounded-xl
                                                   border border-slate-300
                                                   bg-white px-3 py-2.5
                                                   text-sm outline-none" />
                                    </div>

                                    <div>
                                        <label class="mb-1.5 block
                                                      text-xs font-semibold
                                                      text-slate-700">
                                            Repeat Every (Months)
                                        </label>

                                        <InputNumber
                                            @bind-Value="_model.RepeatedEveryInMonth"
                                            disabled="@FormDisabled"
                                            class="w-full rounded-xl
                                                   border border-slate-300
                                                   bg-white px-3 py-2.5
                                                   text-sm outline-none" />
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <!-- Footer -->
                    <div class="flex flex-col-reverse gap-3
                                border-t border-slate-200
                                bg-slate-50 px-5 py-4
                                sm:flex-row
                                sm:justify-end">

                        <button type="button"
                                disabled="@_isSaving"
                                @onclick="ResetForm"
                                class="rounded-xl border
                                       border-slate-200 bg-white
                                       px-4 py-2.5 text-sm
                                       font-semibold text-slate-700
                                       hover:bg-slate-100">
                            Cancel
                        </button>

                        <button type="submit"
                                disabled="@FormDisabled"
                                class="inline-flex items-center
                                       justify-center gap-2
                                       rounded-xl bg-indigo-600
                                       px-5 py-2.5 text-sm
                                       font-semibold text-white
                                       transition
                                       hover:bg-indigo-700
                                       disabled:cursor-not-allowed
                                       disabled:bg-slate-300">

                            @if (_isSaving)
                            {
                                <span class="material-symbols-rounded
                                             animate-spin text-[18px]">
                                    progress_activity
                                </span>

                                <span>
                                    Saving...
                                </span>
                            }
                            else
                            {
                                <span class="material-symbols-rounded
                                             text-[18px]">
                                    save
                                </span>

                                <span>
                                    @(_isEditMode
                                        ? "Save Changes"
                                        : "Create Leave Type")
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </section>

        <!-- RIGHT: LEAVE TYPE LIST -->
        <aside class="min-w-0 xl:col-span-4">

            <div class="overflow-hidden rounded-2xl
                        border border-slate-200
                        bg-white shadow-sm">

                <div class="border-b border-slate-200
                            px-5 py-4">

                    <div class="flex items-center
                                justify-between gap-3">

                        <div>

                            <h2 class="text-sm font-semibold
                                       text-slate-900">
                                Leave Types
                            </h2>

                            <p class="mt-0.5 text-xs
                                      text-slate-500">
                                @_leaveTypes.Count configured
                            </p>

                        </div>

                        <button type="button"
                                @onclick="StartCreate"
                                class="flex h-9 w-9
                                       items-center
                                       justify-center
                                       rounded-lg
                                       bg-indigo-600
                                       text-white
                                       hover:bg-indigo-700"
                                title="Add leave type">

                            <span class="material-symbols-rounded
                                         text-[19px]">
                                add
                            </span>

                        </button>

                    </div>

                    <div class="relative mt-4">

                        <span class="material-symbols-rounded
                                     absolute left-3 top-1/2
                                     -translate-y-1/2
                                     text-[18px]
                                     text-slate-400">
                            search
                        </span>

                        <input type="text"
                               value="@_searchText"
                               @oninput="HandleSearch"
                               placeholder="Search leave types..."
                               class="w-full rounded-xl
                                      border border-slate-200
                                      bg-slate-50 py-2.5
                                      pl-10 pr-3 text-sm
                                      outline-none
                                      focus:border-indigo-300
                                      focus:bg-white
                                      focus:ring-2
                                      focus:ring-indigo-100" />

                    </div>

                </div>

                <div class="max-h-[680px] overflow-y-auto">

                    @if (_isLoading)
                    {
                        <div class="space-y-2 p-4">

                            @for (var i = 0; i < 6; i++)
                            {
                                <div class="animate-pulse
                                            rounded-xl
                                            border border-slate-200
                                            p-3">

                                    <div class="h-4 w-36 rounded
                                                bg-slate-200">
                                    </div>

                                    <div class="mt-2 h-3 w-20
                                                rounded bg-slate-100">
                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else if (FilteredLeaveTypes.Count == 0)
                    {
                        <div class="px-5 py-12 text-center">

                            <span class="material-symbols-rounded
                                         text-4xl text-slate-300">
                                event_busy
                            </span>

                            <p class="mt-2 text-sm font-semibold
                                      text-slate-700">
                                No leave types found
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="divide-y
                                    divide-slate-100">

                            @foreach (var leaveType
                                in FilteredLeaveTypes)
                            {
                                <button type="button"
                                        @onclick="() =>
                                            SelectLeaveTypeAsync(
                                                leaveType)"
                                        class="@GetLeaveTypeItemClass(
                                            leaveType)">

                                    <div class="min-w-0 flex-1">

                                        <div class="flex flex-wrap
                                                    items-center
                                                    gap-2">

                                            <p class="truncate
                                                      text-sm
                                                      font-semibold
                                                      text-slate-800">
                                                @leaveType.Name
                                            </p>

                                            @if (leaveType.IsSystemType)
                                            {
                                                <span class="rounded-full
                                                             bg-violet-50
                                                             px-2 py-0.5
                                                             text-[10px]
                                                             font-semibold
                                                             text-violet-700">
                                                    System
                                                </span>
                                            }

                                            @if (leaveType.IsGlobal)
                                            {
                                                <span class="rounded-full
                                                             bg-blue-50
                                                             px-2 py-0.5
                                                             text-[10px]
                                                             font-semibold
                                                             text-blue-700">
                                                    Global
                                                </span>
                                            }

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            leaveType.NameDhivehi))
                                        {
                                            <p class="mt-1 truncate
                                                      text-xs
                                                      text-slate-500"
                                               dir="rtl">
                                                @leaveType.NameDhivehi
                                            </p>
                                        }

                                        <div class="mt-2 flex
                                                    flex-wrap gap-2">

                                            @if (leaveType.Duration.HasValue)
                                            {
                                                <span class="text-[11px]
                                                             text-slate-500">
                                                    @leaveType.Duration days
                                                </span>
                                            }

                                            @if (leaveType.IncludePay)
                                            {
                                                <span class="text-[11px]
                                                             text-emerald-600">
                                                    Paid
                                                </span>
                                            }

                                            @if (leaveType.IsRenewed)
                                            {
                                                <span class="text-[11px]
                                                             text-indigo-600">
                                                    Renewable
                                                </span>
                                            }

                                        </div>

                                    </div>

                                    <span class="material-symbols-rounded
                                                 shrink-0 text-[18px]
                                                 text-slate-300">
                                        chevron_right
                                    </span>

                                </button>
                            }

                        </div>
                    }

                </div>

            </div>

        </aside>

    </div>

</div>

@code {
    private List<LeaveTypeDto> _leaveTypes = [];

    private LeaveTypeSaveRequest _model =
        new();

    private int? _selectedLeaveTypeId;

    private bool _isLoading;

    private bool _isSaving;

    private bool _isEditMode;

    private bool _saveSucceeded;

    private string? _formMessage;

    private string _searchText =
        string.Empty;

    private bool _isSuperAdmin;

    private bool FormDisabled =>
        _isSaving ||
        SelectedLeaveTypeIsReadOnly;

    private bool SelectedLeaveTypeIsReadOnly
    {
        get
        {
            if (!_isEditMode ||
                !_selectedLeaveTypeId.HasValue)
            {
                return false;
            }

            var selected =
                _leaveTypes.FirstOrDefault(x =>
                    x.LeaveTypeId ==
                    _selectedLeaveTypeId.Value);

            if (selected is null)
            {
                return false;
            }

            /*
            * Super Administrator can edit everything.
                 */
            if (_isSuperAdmin)
            {
                return false;
            }

            /*
            * Normal organisation users cannot edit
                 * system/global leave types.
                 */
            return selected.IsSystemType ||
                   selected.IsGlobal;
        }
    }




    private List<LeaveTypeDto> FilteredLeaveTypes
    {
        get
        {
            IEnumerable<LeaveTypeDto> query =
                _leaveTypes;

            if (!string.IsNullOrWhiteSpace(
                _searchText))
            {
                var search =
                    _searchText.Trim();

                query =
                    query.Where(x =>
                        x.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                        (
                            x.NameDhivehi != null &&
                            x.NameDhivehi.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        ));
            }

            return query
                .OrderByDescending(x =>
                    x.IsSystemType)
                .ThenByDescending(x =>
                    x.IsGlobal)
                .ThenBy(x =>
                    x.Name)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var context = await UserAccessService.GetContextAsync();

        // false when in development, in production MUST be true
        _isSuperAdmin = context?.IsSuperAdministrator == false;


        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;

            _leaveTypes =
                await LeaveTypeService
                    .GetOrganisationLeaveTypesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartCreate()
    {
        _selectedLeaveTypeId =
            null;

        _isEditMode =
            false;

        _formMessage =
            null;

        _saveSucceeded =
            false;

        _model =
            new LeaveTypeSaveRequest
            {
                IncludePay = true,
                PayPercentage = 100,
                IsStaffWideAvailable = true
            };
    }

    private async Task SelectLeaveTypeAsync(
        LeaveTypeDto leaveType)
    {
        _selectedLeaveTypeId =
            leaveType.LeaveTypeId;

        _isEditMode =
            true;

        _formMessage =
            null;

        _saveSucceeded =
            false;

        var detail =
            await LeaveTypeService.GetByIdAsync(
                leaveType.LeaveTypeId);

        if (detail is null)
        {
            _formMessage =
                "The selected leave type could not be loaded.";

            return;
        }

        _model =
            new LeaveTypeSaveRequest
            {
                LeaveTypeId =
                    detail.LeaveTypeId,

                Name =
                    detail.Name,

                NameDhivehi =
                    detail.NameDhivehi,

                Duration = 
                    detail.Duration ,

                IncludeHolidays =
                    detail.IncludeHolidays,

                IncludePay =
                    detail.IncludePay,

                IsPublic =
                    detail.IsPublic,

                IsLocationRequired =
                    detail.IsLocationRequired,

                ServiceDurationMonths =
                    detail.ServiceDurationMonths,

                    RequestTypeId = detail.RequestTypeId,

                IsRenewed =
                    detail.IsRenewed,

                IsStaffWideAvailable =
                    detail.IsStaffWideAvailable,

                    PayPercentage = detail.PayPercentage,

                StartInMonth = detail.StartInMonth,

                RepeatedEveryInMonth =
                    detail.RepeatedEveryInMonth
            };
    }

    private async Task SaveAsync()
    {
        if (FormDisabled)
        {
            return;
        }

        try
        {
            _isSaving =
                true;

            _formMessage =
                null;

            _saveSucceeded =
                false;

            LeaveTypeSaveResult result;

            if (_isEditMode)
            {
                result =
                    await LeaveTypeService
                        .UpdateAsync(
                            _model);
            }
            else
            {
                result =
                    await LeaveTypeService
                        .CreateAsync(
                            _model);
            }

            _formMessage =
                result.Message;

            _saveSucceeded =
                result.Success;

            if (!result.Success)
            {
                return;
            }

            await LoadAsync();

            if (result.LeaveTypeId.HasValue)
            {
                var saved =
                    _leaveTypes
                        .FirstOrDefault(x =>
                            x.LeaveTypeId ==
                                result.LeaveTypeId.Value);

                if (saved is not null)
                {
                    await SelectLeaveTypeAsync(
                        saved);
                }
            }
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private void ResetForm()
    {
        StartCreate();
    }

    private void HandleSearch(
        ChangeEventArgs args)
    {
        _searchText =
            args.Value?.ToString() ??
            string.Empty;
    }

    private string GetLeaveTypeItemClass(
        LeaveTypeDto leaveType)
    {
        const string baseClass =
            "flex w-full items-center gap-3 " +
            "px-4 py-3 text-left transition ";

        if (_selectedLeaveTypeId ==
            leaveType.LeaveTypeId)
        {
            return baseClass +
                   "bg-indigo-50";
        }

        return baseClass +
               "bg-white hover:bg-slate-50";
    }

    private string GetMessageClass()
    {
        return _saveSucceeded
            ? "flex items-center gap-2 rounded-xl " +
              "border border-emerald-200 bg-emerald-50 " +
              "px-4 py-3 text-sm text-emerald-700"
            : "flex items-center gap-2 rounded-xl " +
              "border border-red-200 bg-red-50 " +
              "px-4 py-3 text-sm text-red-700";
    }
}