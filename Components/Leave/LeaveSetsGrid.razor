@using HRM.Models.Archives
@using HRM.Services
@inject LeaveSetConfigurationService Settings
@inject ToastService Toasts
@inject ILogger<LeaveSetsGrid> Logger
<section class="space-y-3">
    <header class="flex flex-wrap items-center justify-between gap-2"><div><h2 class="text-base font-semibold">Leave Set Management</h2>@if(data!=null){<p class="text-xs text-slate-500">@data.Organisations.FirstOrDefault()?.OrganisationName</p>}</div><div class="flex flex-wrap gap-2"><button class="app-button app-button-secondary" disabled="@busy" @onclick="LoadData">Refresh</button><button class="app-button app-button-primary" disabled="@(busy||data==null)" @onclick="New">New set</button></div></header>
    @if(error!=null){<p role="alert" class="rounded border p-3 text-sm">@error</p>}
    @if(editing&&data!=null)
    {
        <fieldset disabled="@busy" class="space-y-3 rounded-xl border p-3">
            <h3 class="text-sm font-semibold">@(model.LeaveSetId==0?"New leave set":"Edit leave set")</h3>
            <label class="block text-sm">Name<input class="mt-1 w-full rounded border bg-transparent p-2" maxlength="250" @bind="model.Name" /></label>
            @if(data.IsSuperAdmin){<div class="flex flex-wrap gap-4 text-sm"><label><input type="checkbox" @bind="model.IsPublic" /> Public</label><label><input type="checkbox" @bind="model.IsGlobal" /> Global</label></div>}
            <div class="flex flex-wrap gap-2"><button class="app-button app-button-primary" disabled="@string.IsNullOrWhiteSpace(model.Name)" @onclick="Save">Save</button><button class="app-button app-button-secondary" @onclick="()=>editing=false">Cancel</button></div>
        </fieldset>
    }
    @if(deleting!=null){<div role="alert" class="space-y-2 rounded-xl border p-3 text-sm"><p>Delete “@deleting.Name”?</p><div class="flex gap-2"><button class="app-button app-button-primary" disabled="@busy" @onclick="Delete">Confirm delete</button><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>deleting=null">Cancel</button></div></div>}
    @if(contentsSetId.HasValue){<LeaveSetContents LeaveSetId="contentsSetId.Value" OnClose="CloseContents" OnChanged="LoadData" @key="contentsSetId" />}
    @if(data!=null)
    {
        <label class="block text-sm">Search<input type="search" class="mt-1 w-full rounded border bg-transparent p-2 sm:max-w-sm" placeholder="Leave set name…" @bind="search" @bind:event="oninput" /></label>
        <div class="overflow-x-auto rounded-lg border"><table class="w-full text-left text-sm"><thead><tr><th class="px-3 py-2">Name</th><th class="px-3 py-2">Leave types</th><th class="px-3 py-2">Scope</th><th class="px-3 py-2">Actions</th></tr></thead><tbody>
            @foreach(var row in Filtered)
            {
                <tr class="border-t" @key="row.LeaveSetId"><td class="px-3 py-2 font-medium">@row.Name</td><td class="px-3 py-2">@row.LeaveSetLeaveTypes.Select(t=>t.LeaveTypeId).Distinct().Count()</td><td class="px-3 py-2">@(row.IsGlobal?"Global":row.IsPublic?"Public":"Organisation")</td><td class="px-3 py-2"><div class="flex flex-wrap gap-2"><button class="app-button app-button-secondary" disabled="@busy" @onclick="()=>OpenContents(row.LeaveSetId)">Leave types</button><button class="app-button app-button-secondary" disabled="@(busy||!CanEdit(row))" @onclick="()=>Edit(row)">Edit</button><button class="app-button app-button-secondary" disabled="@(busy||!CanEdit(row))" @onclick="()=>BeginDelete(row)">Delete</button></div></td></tr>
            }
        </tbody></table>@if(!Filtered.Any()){<p class="p-3 text-sm text-slate-500">No matching leave sets.</p>}</div>
    }
    else if(busy){<p role="status" class="text-sm text-slate-500">Loading leave sets…</p>}
</section>
@code {
    private LeaveSetConfigurationData? data;
    private LeaveSet model=new();private LeaveSet? deleting;
    private string search="";private string? error;private bool busy,editing;private int? contentsSetId;
    private IEnumerable<LeaveSet> Filtered=>data?.Sets.Where(s=>s.Name.Contains(search,StringComparison.OrdinalIgnoreCase))??[];
    private bool CanEdit(LeaveSet row)=>data?.IsSuperAdmin==true||!row.IsGlobal&&!row.IsPublic;
    protected override Task OnInitializedAsync()=>LoadData();
    private async Task LoadData(){busy=true;error=null;try{data=await Settings.LoadAsync();editing=false;deleting=null;if(contentsSetId.HasValue&&!data.Sets.Any(s=>s.LeaveSetId==contentsSetId))contentsSetId=null;}catch(Exception ex){data=null;Fail(ex);}finally{busy=false;}}
    private void New(){if(data==null)return;model=new(){OrganisationId=data.Organisations.Single().BusinessEntityID};editing=true;deleting=null;contentsSetId=null;error=null;}
    private void Edit(LeaveSet row){model=new(){LeaveSetId=row.LeaveSetId,OrganisationId=row.OrganisationId,Name=row.Name,IsPublic=row.IsPublic,IsGlobal=row.IsGlobal,OperationLogId=row.OperationLogId};editing=true;deleting=null;contentsSetId=null;error=null;}
    private void BeginDelete(LeaveSet row){deleting=row;editing=false;contentsSetId=null;error=null;}
    private void OpenContents(int id){contentsSetId=id;editing=false;deleting=null;error=null;}
    private async Task CloseContents(){contentsSetId=null;await LoadData();}
    private Task Save()=>Act(()=>Settings.SaveAsync(model),"Leave set saved.");
    private Task Delete()=>deleting==null?Task.CompletedTask:Act(()=>Settings.DeleteAsync(deleting),"Leave set deleted.");
    private async Task Act(Func<Task> action,string message){if(busy)return;busy=true;error=null;var saved=false;try{await action();saved=true;Toasts.Success(message);}catch(Exception ex){Fail(ex);}finally{busy=false;}if(saved)await LoadData();}
    private void Fail(Exception ex){Logger.LogError(ex,"Leave set management");error=ex is UnauthorizedAccessException or InvalidOperationException?ex.Message:"Leave sets could not be loaded or saved. Refresh and try again.";}
}
