
@using HRM.DTOs.LeaveTypePolicy
@using HRM.Enum
@* @using HRM.Services.Interfaces.Leave *@
@using HRM.Services.Interfaces.Policy

@inject ILeavePolicyAccrualRuleService AccrualRuleService

<section class="overflow-hidden
                rounded-xl
                border border-indigo-200
                bg-white">

    <!-- Header -->
    <div class="flex flex-col gap-3
                border-b border-slate-200
                px-4 py-3
                sm:flex-row
                sm:items-center
                sm:justify-between">

        <div class="flex items-center gap-3">

            <div class="flex h-9 w-9
                        items-center justify-center
                        rounded-lg bg-indigo-50
                        text-indigo-600">

                <span class="material-symbols-rounded
                             text-[19px]">
                    autorenew
                </span>

            </div>

            <div>

                <h3 class="text-sm font-semibold
                           text-slate-900">
                    Accrual Rules
                </h3>

                <p class="mt-0.5 text-xs
                          text-slate-500">
                    Configure how leave balances
                    are granted and renewed.
                </p>

            </div>

        </div>

        <button type="button"
        @onclick="CloseAsync"
        class="flex h-8 w-8
                       items-center
                       justify-center
                       rounded-lg
                       text-slate-400
                       hover:bg-slate-100
                       hover:text-slate-700">

            <span class="material-symbols-rounded
                         text-[18px]">
                close
            </span>

        </button>

    </div>

    <div class="p-4">

        @if (_isLoading)
        {
            <div class="animate-pulse
                        space-y-3">

                <div class="h-10 rounded-xl
                            bg-slate-100">
                </div>

                <div class="h-10 rounded-xl
                            bg-slate-100">
                </div>

                <div class="h-20 rounded-xl
                            bg-slate-100">
                </div>

            </div>
        }
        else
        {
            <EditForm Model="@_model"
            OnValidSubmit="@SaveAsync">

                <DataAnnotationsValidator />

                <div class="space-y-5">

                    @if (!string.IsNullOrWhiteSpace(
                       _message))
                    {
                        <div class="@GetMessageClass()">

                            <span class="material-symbols-rounded
                                         text-[18px]">
                                @(_saveSucceeded
                                        ? "check_circle"
                                        : "error")
                            </span>

                            <span>
                                @_message
                            </span>

                        </div>
                    }

                    <!-- Accrual Type -->
                    <div>

                        <label class="mb-1.5 block
                                      text-xs font-semibold
                                      text-slate-700">
                            Accrual Type
                        </label>

                        <InputSelect
                        @bind-Value="_model.AccrualType"
                        disabled="@_isSaving"
                        class="w-full rounded-xl
                                   border border-slate-300
                                   bg-white px-3 py-2.5
                                   text-sm outline-none
                                   focus:border-indigo-500
                                   focus:ring-2
                                   focus:ring-indigo-100">

                            @foreach (var type
                           in Enum.GetValues<LeaveAccrualType>())
                            {
                                <option value="@type">
                                    @GetAccrualTypeName(type)
                                </option>
                            }

                        </InputSelect>

                    </div>

                    @if (_model.AccrualType !=
                        LeaveAccrualType.None &&
                       _model.AccrualType !=
                        LeaveAccrualType.NoBalance)
                    {
                        <div class="grid grid-cols-1
                                    gap-4
                                    sm:grid-cols-2">

                            <!-- Accrual Amount -->
                            <div>

                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Accrual Amount
                                </label>

                                <InputNumber
                                @bind-Value="_model.AccrualAmount"
                                disabled="@_isSaving"
                                class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />

                            </div>

                            <!-- Interval -->
                            <div>

                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Interval (Months)
                                </label>

                                <InputNumber
                                @bind-Value="_model.AccrualIntervalMonths"
                                disabled="@_isSaving"
                                class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />

                            </div>

                            <!-- Start Month -->
                            <div>

                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Start Month
                                </label>

                                <InputNumber
                                @bind-Value="_model.AccrualStartMonth"
                                disabled="@_isSaving"
                                class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />

                            </div>

                            <!-- Max Balance -->
                            <div>

                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Maximum Balance
                                </label>

                                <InputNumber
                                @bind-Value="_model.MaximumBalance"
                                disabled="@_isSaving"
                                class="w-full rounded-xl
                                           border border-slate-300
                                           px-3 py-2.5 text-sm
                                           outline-none
                                           focus:border-indigo-500
                                           focus:ring-2
                                           focus:ring-indigo-100" />

                            </div>

                        </div>
                    }

                    <!-- Carry Forward -->
                    <div class="rounded-xl
                                border border-slate-200
                                bg-slate-50 p-4">

                        <label class="flex items-start gap-3">

                            <InputCheckbox
                            @bind-Value="_model.CarryForwardAllowed" />

                            <div>

                                <p class="text-sm font-semibold
                                          text-slate-800">
                                    Allow Carry Forward
                                </p>

                                <p class="mt-0.5 text-xs
                                          text-slate-500">
                                    Unused leave may be moved
                                    into the next entitlement period.
                                </p>

                            </div>

                        </label>

                        @if (_model.CarryForwardAllowed)
                        {
                            <div class="mt-4">

                                <label class="mb-1.5 block
                                              text-xs font-semibold
                                              text-slate-700">
                                    Maximum Carry Forward
                                </label>

                                <InputNumber
                                @bind-Value="_model.MaximumCarryForward"
                                disabled="@_isSaving"
                                class="w-full max-w-xs
                                           rounded-xl
                                           border border-slate-300
                                           bg-white
                                           px-3 py-2.5 text-sm
                                           outline-none" />

                            </div>
                        }

                    </div>

                    <!-- Expiry -->
                    <div>

                        <label class="mb-1.5 block
                                      text-xs font-semibold
                                      text-slate-700">
                            Expire After (Months)
                        </label>

                        <InputNumber
                        @bind-Value="_model.ExpiresAfterMonths"
                        disabled="@_isSaving"
                        class="w-full max-w-xs
                                   rounded-xl
                                   border border-slate-300
                                   px-3 py-2.5 text-sm
                                   outline-none
                                   focus:border-indigo-500
                                   focus:ring-2
                                   focus:ring-indigo-100" />

                        <p class="mt-1 text-xs
                                  text-slate-400">
                            Leave blank if the balance
                            does not expire automatically.
                        </p>

                    </div>

                    <!-- Active -->
                    <label class="flex items-start gap-3
                                  rounded-xl border
                                  border-slate-200 p-3">

                        <InputCheckbox
                        @bind-Value="_model.IsActive" />

                        <div>

                            <p class="text-sm font-semibold
                                      text-slate-800">
                                Active Rule
                            </p>

                            <p class="mt-0.5 text-xs
                                      text-slate-500">
                                Use this accrual rule for
                                the selected leave policy.
                            </p>

                        </div>

                    </label>

                </div>

                <!-- Footer -->
                <div class="mt-5 flex flex-col-reverse
                            gap-3 border-t
                            border-slate-200 pt-4
                            sm:flex-row
                            sm:justify-end">

                    <button type="button"
                    @onclick="CloseAsync"
                    disabled="@_isSaving"
                    class="rounded-xl border
                                   border-slate-200
                                   bg-white px-4 py-2.5
                                   text-sm font-semibold
                                   text-slate-700
                                   hover:bg-slate-50">
                        Cancel
                    </button>

                    <button type="submit"
                    disabled="@_isSaving"
                    class="inline-flex items-center
                                   justify-center gap-2
                                   rounded-xl
                                   bg-indigo-600
                                   px-5 py-2.5
                                   text-sm font-semibold
                                   text-white
                                   hover:bg-indigo-700
                                   disabled:bg-slate-300">

                        @if (_isSaving)
                        {
                            <span class="material-symbols-rounded
                                         animate-spin
                                         text-[18px]">
                                progress_activity
                            </span>

                            <span>
                                Saving...
                            </span>
                        }
                        else
                        {
                            <span class="material-symbols-rounded
                                         text-[18px]">
                                save
                            </span>

                            <span>
                                @(_isEditMode
                                        ? "Save Rule"
                                        : "Create Rule")
                            </span>
                        }

                    </button>

                </div>

            </EditForm>
        }

    </div>

</section>

@code {
    [Parameter, EditorRequired]
    public int LeavePolicyId { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private LeavePolicyAccrualRuleSaveRequest _model = new();

    private bool _isLoading;

    private bool _isSaving;

    private bool _isEditMode;

    private bool _saveSucceeded;

    private string? _message;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (LeavePolicyId <= 0)
        {
            return;
        }

        try
        {
            _isLoading = true;
            _message = null;

            var rules =
                await AccrualRuleService
                    .GetByPolicyIdAsync(
                        LeavePolicyId);

            /*
             * For now we use one active accrual rule
             * per leave policy.
             */
            var rule =
                rules
                    .Where(x => x.IsActive)
                    .OrderByDescending(x =>
                        x.LeavePolicyAccrualRuleId)
                    .FirstOrDefault();

            if (rule is null)
            {
                _isEditMode =
                    false;

                _model =
                    new LeavePolicyAccrualRuleSaveRequest
                    {
                        LeavePolicyId =
                            LeavePolicyId,

                        AccrualType =
                            LeaveAccrualType.AnnualGrant,

                        CarryForwardAllowed =
                            false,

                        IsActive =
                            true
                    };

                return;
            }

            _isEditMode =
                true;

            _model =
                new LeavePolicyAccrualRuleSaveRequest
                {
                    LeavePolicyAccrualRuleId =
                        rule.LeavePolicyAccrualRuleId,

                    LeavePolicyId =
                        rule.LeavePolicyId,

                    AccrualType =
                        rule.AccrualType,

                    AccrualAmount =
                        rule.AccrualAmount,

                    AccrualIntervalMonths =
                        rule.AccrualIntervalMonths,

                    AccrualStartMonth =
                        rule.AccrualStartMonth,

                    MaximumBalance =
                        rule.MaximumBalance,

                    CarryForwardAllowed =
                        rule.CarryForwardAllowed,

                    MaximumCarryForward =
                        rule.MaximumCarryForward,

                    ExpiresAfterMonths =
                        rule.ExpiresAfterMonths,

                    IsActive =
                        rule.IsActive
                };
        }
        catch (Exception exception)
        {
            _message =
                exception.Message;

            _saveSucceeded =
                false;

            Console.Error.WriteLine(
                exception.ToString());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving ||
            LeavePolicyId <= 0)
        {
            return;
        }

        try
        {
            _isSaving = true;

            _message = null;

            _saveSucceeded = false;

            _model.LeavePolicyId =
                LeavePolicyId;

            var result =
                _isEditMode
                    ? await AccrualRuleService
                        .UpdateAsync(
                            _model)
                    : await AccrualRuleService
                        .CreateAsync(
                            _model);

            _message =
                result.Message;

            _saveSucceeded =
                result.Success;

            if (!result.Success)
            {
                return;
            }

            await LoadAsync();
        }
        catch (Exception exception)
        {
            _saveSucceeded = false;

            _message =
                "Unable to save the accrual rule.";

            Console.Error.WriteLine(
                exception.ToString());
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task CloseAsync()
    {
        return OnClose.InvokeAsync();
    }

    private string GetMessageClass()
    {
        return _saveSucceeded
            ? "flex items-center gap-2 rounded-xl " +
              "border border-emerald-200 " +
              "bg-emerald-50 px-4 py-3 " +
              "text-sm text-emerald-700"
            : "flex items-center gap-2 rounded-xl " +
              "border border-red-200 " +
              "bg-red-50 px-4 py-3 " +
              "text-sm text-red-700";
    }

    private static string GetAccrualTypeName(
        LeaveAccrualType type)
    {
        return type switch
        {
            LeaveAccrualType.AnnualGrant =>
                "Annual Grant",

            LeaveAccrualType.MonthlyAccrual =>
                "Monthly Accrual",

            LeaveAccrualType.QuarterlyAccrual =>
                "Quarterly Accrual",

            LeaveAccrualType.OneTime =>
                "One-Time Grant",

            LeaveAccrualType.Manual =>
                "Manual",

            LeaveAccrualType.NoBalance =>
                "No Balance",

            _ =>
                "None"
        };
    }
}