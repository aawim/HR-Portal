@using HRM.DTOs.LeaveTypes
@using HRM.Models.LeaveTypes
@using HRM.Services.Interfaces.LeaveType

@inject ILeavePolicyService LeavePolicyService
@inject ILeaveDefinitionService LeaveDefinitionService

<div class="w-full">

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">

        <!-- =====================================================
        LEFT - POLICY EDITOR
        ===================================================== -->
        <section class="min-w-0 xl:col-span-8">

            <div class="overflow-hidden rounded-2xl
                        border border-slate-200
                        bg-white shadow-sm">

                <!-- Header -->
                <div class="flex flex-col gap-3
                            border-b border-slate-200
                            px-5 py-4
                            sm:flex-row
                            sm:items-center
                            sm:justify-between">

                    <div class="flex items-center gap-3">

                        <div class="flex h-11 w-11
                                    shrink-0 items-center
                                    justify-center rounded-xl
                                    bg-indigo-50
                                    text-indigo-600">

                            <span class="material-symbols-rounded">
                                @(_isEditMode
                                        ? "edit_note"
                                        : "policy")
                            </span>

                        </div>

                        <div>

                            <h2 class="text-sm font-semibold
                                       text-slate-900">

                                @(_isEditMode
                                        ? "Edit Leave Policy"
                                        : "Create Leave Policy")

                            </h2>

                            <p class="mt-0.5 text-xs
                                      text-slate-500">

                                Configure organisation-specific
                                entitlement and leave rules.

                            </p>

                        </div>

                    </div>

                    @if (_isEditMode)
                    {
                        <button type="button"
                        disabled="@_isSaving"
                        @onclick="StartCreate"
                        class="inline-flex items-center
                                       justify-center gap-2
                                       rounded-xl border
                                       border-slate-200
                                       bg-white px-3.5 py-2
                                       text-sm font-semibold
                                       text-slate-700
                                       transition
                                       hover:bg-slate-50">

                            <span class="material-symbols-rounded
                                         text-[18px]">
                                add
                            </span>

                            New Policy

                        </button>
                    }

                </div>

                <EditForm Model="@_model"
                OnValidSubmit="@SaveAsync">

                    <DataAnnotationsValidator />

                    <div class="space-y-6 p-5">

                        <!-- Result message -->
                        @if (!string.IsNullOrWhiteSpace(
                           _message))
                        {
                            <div class="@GetMessageClass()">

                                <span class="material-symbols-rounded
                                             text-[19px]">

                                    @(_saveSucceeded
                                            ? "check_circle"
                                            : "error")

                                </span>

                                <span>
                                    @_message
                                </span>

                            </div>
                        }

                        <!-- =================================================
                        LEAVE DEFINITION
                        ================================================= -->
                        <div>

                            <label class="mb-1.5 block
                                          text-xs font-semibold
                                          text-slate-700">
                                Leave Type
                                <span class="text-red-500">*</span>
                            </label>

                            <InputSelect
                            @bind-Value="_model.LeaveDefinitionId"
                            disabled="@_isSaving"
                            class="w-full rounded-xl
                                       border border-slate-300
                                       bg-white px-3 py-2.5
                                       text-sm outline-none
                                       transition
                                       focus:border-indigo-500
                                       focus:ring-2
                                       focus:ring-indigo-100">

                                <option value="0">
                                    Select leave type
                                </option>

                                @foreach (var definition
                                   in AvailableDefinitions)
                                {
                                    <option value="@definition.LeaveDefinitionId">
                                        @definition.Name
                                        (@definition.Code)
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage
                            For="@(() => _model.LeaveDefinitionId)" />

                        </div>

                        <!-- =================================================
                        POLICY NAME
                        ================================================= -->
                        <div>

                            <label class="mb-1.5 block
                                          text-xs font-semibold
                                          text-slate-700">
                                Policy Name
                            </label>

                            <InputText
                            @bind-Value="_model.Name"
                            disabled="@_isSaving"
                            placeholder="Example: Annual Leave Policy 2026"
                            class="w-full rounded-xl
                                       border border-slate-300
                                       px-3 py-2.5 text-sm
                                       outline-none transition
                                       focus:border-indigo-500
                                       focus:ring-2
                                       focus:ring-indigo-100" />

                            <p class="mt-1 text-xs text-slate-400">
                                Optional administrative name for
                                this policy version.
                            </p>

                        </div>

                        <!-- =================================================
                        ENTITLEMENT
                        ================================================= -->
                        <div>

                            <div class="mb-3">

                                <h3 class="text-xs font-semibold
                                           uppercase tracking-wide
                                           text-slate-500">
                                    Entitlement
                                </h3>

                                <p class="mt-1 text-xs text-slate-400">
                                    Define the default entitlement
                                    and eligibility requirements.
                                </p>

                            </div>

                            <div class="grid grid-cols-1 gap-5
                                        sm:grid-cols-2">

                                <div>

                                    <label class="mb-1.5 block
                                                  text-xs font-semibold
                                                  text-slate-700">
                                        Default Entitlement Days
                                    </label>

                                    <InputNumber
                                    @bind-Value="_model.DefaultEntitlementDays"
                                    disabled="@_isSaving"
                                    class="w-full rounded-xl
                                               border border-slate-300
                                               px-3 py-2.5 text-sm
                                               outline-none
                                               focus:border-indigo-500
                                               focus:ring-2
                                               focus:ring-indigo-100" />

                                </div>

                                <div>

                                    <label class="mb-1.5 block
                                                  text-xs font-semibold
                                                  text-slate-700">
                                        Minimum Service Months
                                    </label>

                                    <InputNumber
                                    @bind-Value="_model.MinimumServiceMonths"
                                    disabled="@_isSaving"
                                    class="w-full rounded-xl
                                               border border-slate-300
                                               px-3 py-2.5 text-sm
                                               outline-none
                                               focus:border-indigo-500
                                               focus:ring-2
                                               focus:ring-indigo-100" />

                                </div>

                            </div>

                        </div>

                        <!-- =================================================
                        EFFECTIVE PERIOD
                        ================================================= -->
                        <div>

                            <h3 class="mb-3 text-xs font-semibold
                                       uppercase tracking-wide
                                       text-slate-500">
                                Effective Period
                            </h3>

                            <div class="grid grid-cols-1 gap-5
                                        sm:grid-cols-2">

                                <div>

                                    <label class="mb-1.5 block
                                                  text-xs font-semibold
                                                  text-slate-700">
                                        Effective From
                                    </label>

                                    <InputDate
                                    @bind-Value="_model.EffectiveFrom"
                                    disabled="@_isSaving"
                                    class="w-full rounded-xl
                                               border border-slate-300
                                               px-3 py-2.5 text-sm
                                               outline-none
                                               focus:border-indigo-500
                                               focus:ring-2
                                               focus:ring-indigo-100" />

                                </div>

                                <div>

                                    <label class="mb-1.5 block
                                                  text-xs font-semibold
                                                  text-slate-700">
                                        Effective To
                                    </label>

                                    <InputDate
                                    @bind-Value="_model.EffectiveTo"
                                    disabled="@_isSaving"
                                    class="w-full rounded-xl
                                               border border-slate-300
                                               px-3 py-2.5 text-sm
                                               outline-none
                                               focus:border-indigo-500
                                               focus:ring-2
                                               focus:ring-indigo-100" />

                                    <p class="mt-1 text-xs text-slate-400">
                                        Leave blank for an ongoing policy.
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- =================================================
                        POLICY OPTIONS
                        ================================================= -->
                        <div>

                            <h3 class="mb-3 text-xs font-semibold
                                       uppercase tracking-wide
                                       text-slate-500">
                                Policy Rules
                            </h3>

                            <div class="grid grid-cols-1 gap-3
                                        md:grid-cols-2">

                                <PolicyToggle
                                Label="Include Holidays"
                                Description="Public holidays are counted as leave days."
                                @bind-Value="_model.IncludeHolidays"
                                Disabled="@_isSaving" />

                                <PolicyToggle
                                Label="Include Pay"
                                Description="Staff continue to receive pay while on leave."
                                @bind-Value="_model.IncludePay"
                                Disabled="@_isSaving" />

                                <PolicyToggle
                                Label="Location Required"
                                Description="Application requires location information."
                                @bind-Value="_model.IsLocationRequired"
                                Disabled="@_isSaving" />

                                <PolicyToggle
                                Label="Staff Wide"
                                Description="Automatically available to eligible organisation staff."
                                @bind-Value="_model.IsStaffWideAvailable"
                                Disabled="@_isSaving" />

                                <PolicyToggle
                                Label="Active"
                                Description="Policy can currently be used."
                                @bind-Value="_model.IsActive"
                                Disabled="@_isSaving" />

                            </div>

                        </div>

                        <!-- =================================================
                        PAY
                        ================================================= -->
                        @if (_model.IncludePay)
                        {
                            <div class="rounded-xl
                                        border border-emerald-100
                                        bg-emerald-50/50 p-4">

                                <div class="flex items-center gap-2">

                               @*      <span class="material-symbols-rounded
                                                 text-[18px]
                                                 text-emerald-600">
                                        payments
                                    </span> *@

                                    <h3 class="text-sm font-semibold
                                               text-emerald-900">
                                        Pay Configuration
                                    </h3>

                                </div>

                                <div class="mt-4 max-w-xs">

                                    <label class="mb-1.5 block
                                                  text-xs font-semibold
                                                  text-slate-700">
                                        Pay Percentage
                                    </label>

                                    <div class="relative">

                                        <InputNumber
                                        @bind-Value="_model.PayPercentage"
                                        disabled="@_isSaving"
                                        class="w-full rounded-xl
                                                   border border-slate-300
                                                   bg-white
                                                   px-3 py-2.5 pr-10
                                                   text-sm outline-none
                                                   focus:border-emerald-500
                                                   focus:ring-2
                                                   focus:ring-emerald-100" />

                                        <span class="absolute right-3
                                                     top-1/2
                                                     -translate-y-1/2
                                                     text-sm
                                                     text-slate-400">
                                            %
                                        </span>

                                    </div>

                                </div>

                            </div>
                        }

                        <!-- =================================================
                        REQUEST TYPE
                        ================================================= -->
                        <div>

                            <label class="mb-1.5 block
                                          text-xs font-semibold
                                          text-slate-700">
                                Request Type ID
                            </label>

                            <InputNumber
                            @bind-Value="_model.RequestTypeId"
                            disabled="@_isSaving"
                            class="w-full max-w-xs
                                       rounded-xl
                                       border border-slate-300
                                       px-3 py-2.5 text-sm
                                       outline-none
                                       focus:border-indigo-500
                                       focus:ring-2
                                       focus:ring-indigo-100" />

                            <p class="mt-1 text-xs text-slate-400">
                                This should later be replaced with
                                a Request Type dropdown.
                            </p>

                        </div>

                        <!-- =================================================
                        ACCRUAL PLACEHOLDER
                        ================================================= -->
                        @if (_isEditMode)
                        {
                            <div class="rounded-xl
                border border-dashed
                border-indigo-200
                bg-indigo-50/40
                p-4">

                                <div class="flex flex-col gap-3
                    sm:flex-row
                    sm:items-center
                    sm:justify-between">

                                    <div class="flex items-start gap-3">

                                        <span class="material-symbols-rounded
                             mt-0.5
                             text-indigo-600">
                                            autorenew
                                        </span>

                                        <div>

                                            <p class="text-sm font-semibold
                              text-indigo-900">
                                                Accrual Rules
                                            </p>

                                            <p class="mt-1 text-xs
                              text-indigo-700">
                                                Configure accrual,
                                                renewal, balance caps
                                                and carry-forward rules.
                                            </p>

                                        </div>

                                    </div>

                                    <button type="button"
                                            @onclick="OpenAccrualRules"
                                            class="inline-flex items-center
                           justify-center gap-2
                           rounded-xl border
                           border-indigo-200
                           bg-white
                           px-3 py-2
                           text-xs font-semibold
                           text-indigo-700
                           hover:bg-indigo-50">

                                        <span class="material-symbols-rounded
                             text-[17px]">
                                            tune
                                        </span>

                                        Configure

                                    </button>

                                </div>

                                @if (_showAccrualRules &&
                               _accrualPolicyId.HasValue)
                                {
                                    <div class="mt-4">

                                        <LeavePolicyAccrualRules LeavePolicyId="@_accrualPolicyId.Value"
                                                                 OnClose="@CloseAccrualRules" />

                                    </div>
                                }

                            </div>
                        }



                    </div>

                    <!-- =====================================================
                    FOOTER
                    ===================================================== -->
                    <div class="flex flex-col-reverse gap-3
                                border-t border-slate-200
                                bg-slate-50
                                px-5 py-4
                                sm:flex-row
                                sm:justify-between">

                        <div>

                            @if (_isEditMode)
                            {
                                <button type="button"
                                disabled="@_isSaving"
                                @onclick="DeactivateAsync"
                                class="inline-flex w-full
                                               items-center
                                               justify-center gap-2
                                               rounded-xl border
                                               border-red-200
                                               bg-white
                                               px-4 py-2.5
                                               text-sm font-semibold
                                               text-red-600
                                               hover:bg-red-50
                                               disabled:opacity-50
                                               sm:w-auto">

                                    <span class="material-symbols-rounded
                                                 text-[18px]">
                                        block
                                    </span>

                                    Deactivate

                                </button>
                            }

                        </div>

                        <div class="flex flex-col-reverse
                                    gap-3 sm:flex-row">

                            <button type="button"
                            disabled="@_isSaving"
                            @onclick="StartCreate"
                            class="rounded-xl border
                                           border-slate-200
                                           bg-white
                                           px-4 py-2.5
                                           text-sm font-semibold
                                           text-slate-700
                                           hover:bg-slate-100">

                                Cancel

                            </button>

                            <button type="submit"
                            disabled="@_isSaving"
                            class="inline-flex items-center
                                           justify-center gap-2
                                           rounded-xl
                                           bg-indigo-600
                                           px-5 py-2.5
                                           text-sm font-semibold
                                           text-white
                                           hover:bg-indigo-700
                                           disabled:cursor-not-allowed
                                           disabled:bg-slate-300">

                                @if (_isSaving)
                                {
                                    <span class="material-symbols-rounded
                                                 animate-spin
                                                 text-[18px]">
                                        progress_activity
                                    </span>

                                    <span>
                                        Saving...
                                    </span>
                                }
                                else
                                {
                                    <span class="material-symbols-rounded
                                                 text-[18px]">
                                        save
                                    </span>

                                    <span>
                                        @(_isEditMode
                                                ? "Save Changes"
                                                : "Create Policy")
                                    </span>
                                }

                            </button>

                        </div>

                    </div>

                </EditForm>

            </div>

        </section>

        <!-- =====================================================
        RIGHT - POLICY LIST
        ===================================================== -->
        <aside class="min-w-0 xl:col-span-4">

            <div class="overflow-hidden rounded-2xl
                        border border-slate-200
                        bg-white shadow-sm">

                <!-- Header -->
                <div class="border-b border-slate-200
                            px-5 py-4">

                    <div class="flex items-center
                                justify-between gap-3">

                        <div>

                            <h2 class="text-sm font-semibold
                                       text-slate-900">
                                Leave Policies
                            </h2>

                            <p class="mt-0.5 text-xs
                                      text-slate-500">
                                @_policies.Count configured
                            </p>

                        </div>

                        <button type="button"
                        @onclick="StartCreate"
                        title="Create policy"
                        class="flex h-9 w-9
                                       items-center
                                       justify-center
                                       rounded-lg
                                       bg-indigo-600
                                       text-white
                                       hover:bg-indigo-700">

                            <span class="material-symbols-rounded
                                         text-[19px]">
                                add
                            </span>

                        </button>

                    </div>

                    <!-- Search -->
                    <div class="relative mt-4">

                    @*     <span class="material-symbols-rounded
                                     absolute left-3 top-1/2
                                     -translate-y-1/2
                                     text-[18px]
                                     text-slate-400">
                            search
                        </span> *@

                        <input type="text"
                        value="@_searchText"
                        @oninput="HandleSearch"
                        placeholder="Search policies..."
                        class="w-full rounded-xl
                                      border border-slate-200
                                      bg-slate-50
                                      py-2.5 pl-10 pr-3
                                      text-sm outline-none
                                      focus:border-indigo-300
                                      focus:bg-white
                                      focus:ring-2
                                      focus:ring-indigo-100" />

                    </div>

                </div>

                <!-- List -->
                <div class="max-h-[760px]
                            overflow-y-auto">

                    @if (_isLoading)
                    {
                        <div class="space-y-3 p-4">

                            @for (var i = 0; i < 5; i++)
                            {
                                <div class="animate-pulse
                                            rounded-xl
                                            border border-slate-200
                                            p-4">

                                    <div class="h-4 w-36
                                                rounded bg-slate-200">
                                    </div>

                                    <div class="mt-2 h-3 w-24
                                                rounded bg-slate-100">
                                    </div>

                                    <div class="mt-3 h-3 w-40
                                                rounded bg-slate-100">
                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else if (FilteredPolicies.Count == 0)
                    {
                        <div class="px-5 py-12 text-center">

                            <span class="material-symbols-rounded
                                         text-4xl
                                         text-slate-300">
                                policy
                            </span>

                            <p class="mt-2 text-sm font-semibold
                                      text-slate-700">
                                No policies found
                            </p>

                            <p class="mt-1 text-xs
                                      text-slate-500">
                                Create a policy for one of
                                your leave definitions.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="divide-y
                                    divide-slate-100">

                            @foreach (var policy
                               in FilteredPolicies)
                            {
                                <button type="button"
                                @onclick="() =>
                                            SelectPolicyAsync(policy)"
                                class="@GetPolicyClass(policy)">

                                    <div class="min-w-0 flex-1">

                                        <div class="flex flex-wrap
                                                    items-center gap-2">

                                            <p class="truncate
                                                      text-sm
                                                      font-semibold
                                                      text-slate-800">
                                                @policy.LeaveTypeName
                                            </p>

                                            @if (policy.IsActive)
                                            {
                                                <span class="rounded-full
                                                             bg-emerald-50
                                                             px-2 py-0.5
                                                             text-[10px]
                                                             font-semibold
                                                             text-emerald-700">
                                                    Current
                                                </span>
                                            }
                                            else if (!policy.IsActive)
                                            {
                                                <span class="rounded-full
                                                             bg-slate-100
                                                             px-2 py-0.5
                                                             text-[10px]
                                                             font-semibold
                                                             text-slate-500">
                                                    Inactive
                                                </span>
                                            }

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                           policy.Name))
                                        {
                                            <p class="mt-1 truncate
                                                      text-xs
                                                      text-slate-600">
                                                @policy.Name
                                            </p>
                                        }

                                        <div class="mt-2 flex
                                                    flex-wrap
                                                    gap-x-4 gap-y-1
                                                    text-[11px]
                                                    text-slate-500">

                                            @if (policy.DefaultEntitlementDays.HasValue)
                                            {
                                                <span class="inline-flex
                                                             items-center
                                                             gap-1">

                                                    <span class="material-symbols-rounded
                                                                 text-[14px]">
                                                        @* calendar_month *@
                                                    </span>

                                                    @FormatDays(
                                                                 policy.DefaultEntitlementDays.Value)
                                                    days

                                                </span>
                                            }

                                            <span class="inline-flex
                                                         items-center
                                                         gap-1">

                                                <span class="material-symbols-rounded
                                                             text-[14px]">
                                                    @* date_range *@
                                                </span>

                                                @GetPeriodText(policy)

                                            </span>

                                        </div>

                                        <div class="mt-2
                                                    flex flex-wrap
                                                    gap-1.5">

                                            @if (policy.IncludePay)
                                            {
                                                <span class="rounded
                                                             bg-emerald-50
                                                             px-1.5 py-0.5
                                                             text-[10px]
                                                             font-medium
                                                             text-emerald-700">
                                                    Paid
                                                </span>
                                            }

                                            @if (policy.IncludeHolidays)
                                            {
                                                <span class="rounded
                                                             bg-blue-50
                                                             px-1.5 py-0.5
                                                             text-[10px]
                                                             font-medium
                                                             text-blue-700">
                                                    Holidays Included
                                                </span>
                                            }

                                            @if (policy.IsStaffWideAvailable)
                                            {
                                                <span class="rounded
                                                             bg-indigo-50
                                                             px-1.5 py-0.5
                                                             text-[10px]
                                                             font-medium
                                                             text-indigo-700">
                                                    Staff Wide
                                                </span>
                                            }

                                        </div>

                                    </div>

                                    <span class="material-symbols-rounded
                                                 shrink-0 text-[18px]
                                                 text-slate-300">
                                        @* chevron_right *@
                                    </span>

                                </button>
                            }

                        </div>
                    }

                </div>

            </div>

        </aside>

    </div>

</div>

@code {

    private bool _showAccrualRules;

    private int? _accrualPolicyId;


    private List<LeavePolicyDto> _policies = [];

    private List<LeaveDefinitionDto> _definitions = [];

    private LeavePolicySaveRequest _model = new();

    private int? _selectedPolicyId;

    private bool _isLoading;

    private bool _isSaving;

    private bool _isEditMode;

    private bool _saveSucceeded;

    private string? _message;

    private string _searchText =
        string.Empty;

    private IEnumerable<LeaveDefinitionDto>
        AvailableDefinitions =>
            _definitions
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name);

    private List<LeavePolicyDto> FilteredPolicies
    {
        get
        {
            IEnumerable<LeavePolicyDto> query =
                _policies;

            if (!string.IsNullOrWhiteSpace(
                _searchText))
            {
                var search =
                    _searchText.Trim();

                query =
                    query.Where(x =>
                        x.LeaveTypeName.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                        (
                            x.Name != null &&
                            x.Name.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        ) ||

                        x.LeaveTypeCode.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x =>
                    x.IsActive)
                .ThenByDescending(x =>
                    x.IsActive)
                .ThenBy(x =>
                    x.LeaveTypeName)
                .ThenByDescending(x =>
                    x.EffectiveFrom)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        StartCreate();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;

            var policyTask =
                LeavePolicyService
                    .GetOrganisationPoliciesAsync();

            var definitionTask =
                LeaveDefinitionService
                    .GetAvailableAsync();

            await Task.WhenAll(
                policyTask,
                definitionTask);

            _policies =
                await policyTask;

            _definitions =
                await definitionTask;
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            // "Unable to load leave policy data.";

            _saveSucceeded =
                false;

            Console.Error.WriteLine(
                exception);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartCreate()
    {

        _showAccrualRules = false;
        _accrualPolicyId = null;


        _selectedPolicyId =
            null;

        _isEditMode =
            false;

        _message =
            null;

        _saveSucceeded =
            false;

        _model =
            new LeavePolicySaveRequest
            {
                EffectiveFrom =
                    DateTime.Today,

                IncludePay =
                    true,

                PayPercentage =
                    100,

                IsActive =
                    true
            };
    }

    private async Task SelectPolicyAsync(LeavePolicyDto policy)
    {
         _showAccrualRules = false;
        _accrualPolicyId = null;


        _message =
            null;

        _saveSucceeded =
            false;

        var detail =
            await LeavePolicyService
                .GetByIdAsync(
                    policy.LeavePolicyId);

        if (detail is null)
        {
            _message =
                "The selected leave policy could not be loaded.";

            return;
        }

        _selectedPolicyId =
            detail.LeavePolicyId;

        _isEditMode =
            true;

        _model =
            new LeavePolicySaveRequest
            {
                LeavePolicyId =
                    detail.LeavePolicyId,

                LeaveDefinitionId =
                    detail.LeaveDefinitionId,

                Name =
                    detail.Name,

                DefaultEntitlementDays =
                    detail.DefaultEntitlementDays,

                IncludeHolidays =
                    detail.IncludeHolidays,

                IncludePay =
                    detail.IncludePay,

                PayPercentage =
                    detail.PayPercentage,

                IsLocationRequired =
                    detail.IsLocationRequired,

                IsStaffWideAvailable =
                    detail.IsStaffWideAvailable,

                MinimumServiceMonths =
                    detail.MinimumServiceMonths,

                RequestTypeId =
                    detail.RequestTypeId,

                EffectiveFrom =
                    detail.EffectiveFrom,

                EffectiveTo =
                    detail.EffectiveTo,

                IsActive =
                    detail.IsActive
            };
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        try
        {
            _isSaving =
                true;

            _message =
                null;

            _saveSucceeded =
                false;

            var result =
                _isEditMode
                    ? await LeavePolicyService
                        .UpdateAsync(
                            _model)
                    : await LeavePolicyService
                        .CreateAsync(
                            _model);

            _message =
                result.Message;

            _saveSucceeded =
                result.Success;

            if (!result.Success)
            {
                return;
            }

            var savedPolicyId =
                result.Data;

            await LoadAsync();

            if (savedPolicyId > 0)
            {
                var saved =
                    _policies.FirstOrDefault(x =>
                        x.LeavePolicyId ==
                            savedPolicyId);

                if (saved is not null)
                {
                    await SelectPolicyAsync(
                        saved);
                }
            }
        }
        catch (Exception exception)
        {
            _saveSucceeded =
                false;

            _message =
                "An unexpected error occurred while saving the policy.";

            Console.Error.WriteLine(
                exception);
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private async Task DeactivateAsync()
    {
        if (!_selectedPolicyId.HasValue ||
            _isSaving)
        {
            return;
        }

        try
        {
            _isSaving =
                true;

            var result =
                await LeavePolicyService
                    .DeactivateAsync(
                        _selectedPolicyId.Value);

            _message =
                result.Message;

            _saveSucceeded =
                result.Success;

            if (!result.Success)
            {
                return;
            }

            await LoadAsync();

            StartCreate();
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private void HandleSearch(
        ChangeEventArgs args)
    {
        _searchText =
            args.Value?.ToString() ??
            string.Empty;
    }

    private void OpenAccrualRules()
    {
        if (!_selectedPolicyId.HasValue ||
            _selectedPolicyId.Value <= 0)
        {
            return;
        }

        _accrualPolicyId =
            _selectedPolicyId.Value;

        _showAccrualRules =
            true;
    }

    private void CloseAccrualRules()
{
    _showAccrualRules =
        false;

    _accrualPolicyId =
        null;
}


    private string GetPolicyClass(
        LeavePolicyDto policy)
    {
        const string baseClass =
            "flex w-full items-center gap-3 " +
            "px-4 py-3 text-left transition ";

        return _selectedPolicyId ==
               policy.LeavePolicyId
            ? baseClass +
              "bg-indigo-50"
            : baseClass +
              "bg-white hover:bg-slate-50";
    }

    private string GetMessageClass()
    {
        return _saveSucceeded
            ? "flex items-center gap-2 rounded-xl " +
              "border border-emerald-200 " +
              "bg-emerald-50 px-4 py-3 " +
              "text-sm text-emerald-700"
            : "flex items-center gap-2 rounded-xl " +
              "border border-red-200 " +
              "bg-red-50 px-4 py-3 " +
              "text-sm text-red-700";
    }

    private static string FormatDays(
        decimal days)
    {
        return days == decimal.Truncate(days)
            ? $"{days:0}"
            : $"{days:0.##}";
    }

    private static string GetPeriodText(
        LeavePolicyDto policy)
    {
        return policy.EffectiveTo.HasValue
            ? $"{policy.EffectiveFrom:dd MMM yyyy} – " +
              $"{policy.EffectiveTo.Value:dd MMM yyyy}"
            : $"{policy.EffectiveFrom:dd MMM yyyy} – Present";
    }
}