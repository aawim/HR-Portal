@using HRM.DTOs.LeaveTypes

<div class="overflow-hidden rounded-xl border
            border-blue-200 bg-white shadow-sm">

    <!-- Header -->
    <div class="border-b border-blue-100 bg-blue-50 p-4">

        <div class="flex items-center justify-between">

            <div>
                <h3 class="font-semibold text-slate-800">
                    New Leave Definitions
                </h3>

                <p class="mt-1 text-xs text-slate-500">
                    @FilteredDefinitions.Count available
                </p>
            </div>

            <span class="rounded-full bg-blue-100
                         px-2.5 py-1 text-xs
                         font-medium text-blue-700">
                New
            </span>
        </div>
    </div>

    <!-- Search -->
    <div class="border-b border-slate-100 p-3">

        <div class="relative">

            <input class="w-full rounded-lg border border-slate-300
                          px-3 py-2 pr-9 text-sm
                          focus:border-blue-500
                          focus:outline-none
                          focus:ring-2 focus:ring-blue-200"
                   placeholder="Search new definitions..."
                   disabled="@IsProcessing"
                   @bind="_search"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button type="button"
                        class="absolute inset-y-0 right-0
                               flex items-center px-3
                               text-lg text-slate-400
                               hover:text-slate-700"
                        title="Clear search"
                        @onclick="ClearSearch">
                    ×
                </button>
            }
        </div>
    </div>

    <!-- List -->
    <div class="max-h-[560px] min-h-[100px]
                overflow-y-auto p-3">

        @if (Definitions.Count == 0)
        {
            <div class="py-8 text-center text-sm text-slate-500">
                No new leave definitions are available.
            </div>
        }
        else if (FilteredDefinitions.Count == 0)
        {
            <div class="py-8 text-center text-sm text-slate-500">
                No leave definitions match your search.
            </div>
        }
        else
        {
            @foreach (var definition in FilteredDefinitions)
            {
                <button type="button"
                        @key="definition.LeaveDefinitionId"
                        class="mb-2 block w-full rounded-lg
                               border p-3 text-left
                               transition-colors
                               @GetButtonClass(definition)"
                        disabled="@IsProcessing"
                        @onclick="() => SelectDefinition(definition)">

                    <div class="flex items-start
                                justify-between gap-3">

                        <div class="min-w-0 flex-1">

                            <div class="font-semibold text-slate-800">
                                @(string.IsNullOrWhiteSpace(definition.Name)
                                    ? "Unnamed leave definition"
                                    : definition.Name)
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                           definition.NameDhivehi))
                            {
                                <div class="mt-0.5 text-xs
                                            text-slate-500">
                                    @definition.NameDhivehi
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(definition.Code))
                            {
                                <div class="mt-1 text-xs text-slate-500">
                                    Code:
                                    <span class="font-medium">
                                        @definition.Code
                                    </span>
                                </div>
                            }
                        </div>

                        @if (IsSelected(definition))
                        {
                            <span class="shrink-0 rounded-full
                                         bg-blue-600 px-2 py-0.5
                                         text-xs font-medium
                                         text-white">
                                Selected
                            </span>
                        }
                    </div>
                </button>
            }
        }
    </div>

    <!-- Footer -->
    <div class="border-t border-slate-100 p-4">

        @if (_selectedDefinition is not null)
        {
            <div class="mb-3 rounded-lg bg-blue-50
                        p-2 text-xs text-blue-700">

                Selected:

                <span class="font-semibold">
                    @_selectedDefinition.Name
                </span>
            </div>
        }

        <button type="button"
                class="w-full rounded-lg bg-blue-600
                       px-4 py-2 text-sm font-medium
                       text-white transition-colors
                       hover:bg-blue-700
                       disabled:cursor-not-allowed
                       disabled:bg-slate-300"
                disabled="@CannotAssign"
                @onclick="AssignDefinitionAsync">

            @if (IsProcessing)
            {
                <span>Assigning...</span>
            }
            else
            {
                <span>Assign New Leave Definition</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LeaveDefinitionDto> Definitions { get; set; }
        = Array.Empty<LeaveDefinitionDto>();

    [Parameter]
    public EventCallback<LeaveDefinitionDto> OnAssign { get; set; }

    [Parameter]
    public bool IsProcessing { get; set; }

    private string _search = string.Empty;

    private LeaveDefinitionDto? _selectedDefinition;

    private List<LeaveDefinitionDto> FilteredDefinitions
    {
        get
        {
            IEnumerable<LeaveDefinitionDto> query =
                Definitions ?? Array.Empty<LeaveDefinitionDto>();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var search = _search.Trim();

                query = query.Where(x =>
                    (
                        !string.IsNullOrWhiteSpace(x.Name) &&
                        x.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                    ||
                    (
                        !string.IsNullOrWhiteSpace(x.NameDhivehi) &&
                        x.NameDhivehi.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                    ||
                    (
                        !string.IsNullOrWhiteSpace(x.Code) &&
                        x.Code.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    ));
            }

            return query
                .OrderBy(x => x.Name)
                .ToList();
        }
    }

    private bool CannotAssign =>
        _selectedDefinition is null ||
        IsProcessing ||
        !OnAssign.HasDelegate;

    protected override void OnParametersSet()
    {
        if (_selectedDefinition is null)
        {
            return;
        }

        // Clear the selection if the parent reloads the list
        // and the selected definition is no longer available.
        var selectionStillAvailable =
            Definitions.Any(x =>
                x.LeaveDefinitionId ==
                _selectedDefinition.LeaveDefinitionId);

        if (!selectionStillAvailable)
        {
            _selectedDefinition = null;
        }
    }

    private void SelectDefinition(
        LeaveDefinitionDto definition)
    {
        if (IsProcessing)
        {
            return;
        }

        _selectedDefinition = definition;
    }

    private async Task AssignDefinitionAsync()
    {
        if (CannotAssign ||
            _selectedDefinition is null)
        {
            return;
        }

        await OnAssign.InvokeAsync(
            _selectedDefinition);
    }

    private void ClearSearch()
    {
        _search = string.Empty;
    }

    private bool IsSelected(
        LeaveDefinitionDto definition)
    {
        return _selectedDefinition?.LeaveDefinitionId ==
            definition.LeaveDefinitionId;
    }

    private string GetButtonClass(
        LeaveDefinitionDto definition)
    {
        return IsSelected(definition)
            ? "border-blue-500 bg-blue-50 ring-1 ring-blue-400"
            : "border-slate-200 bg-white hover:bg-slate-50";
    }
}