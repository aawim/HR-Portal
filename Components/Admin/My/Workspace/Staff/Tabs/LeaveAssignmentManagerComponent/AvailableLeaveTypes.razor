@using HRM.DTOs.LeaveTypes

<div class="overflow-hidden rounded-xl border
            border-blue-200 bg-white shadow-sm">

    <!-- Header -->
    <div class="border-b border-blue-100 bg-blue-50 p-4">

        <div class="flex items-center justify-between">

            <div>
                <h3 class="font-semibold text-slate-800">
                    Available Leave Types
                </h3>

                <p class="mt-1 text-xs text-slate-500">
                    @FilteredTypes.Count available
                </p>
            </div>

            <span class="rounded-full bg-blue-100
                         px-2.5 py-1 text-xs
                         font-medium text-blue-700">
                New
            </span>
        </div>
    </div>

    <!-- Search -->
    <div class="border-b border-slate-100 p-3">

        <div class="relative">

            <input class="w-full rounded-lg border border-slate-300
                          px-3 py-2 pr-9 text-sm
                          focus:border-blue-500
                          focus:outline-none
                          focus:ring-2 focus:ring-blue-200"
                   placeholder="Search leave types..."
                   disabled="@IsProcessing"
                   @bind="_search"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button type="button"
                        class="absolute inset-y-0 right-0
                               flex items-center px-3
                               text-lg text-slate-400
                               hover:text-slate-700"
                        title="Clear search"
                        @onclick="ClearSearch">
                    ×
                </button>
            }
        </div>
    </div>

    <!-- List -->
    <div class="max-h-[560px] min-h-[100px]
                overflow-y-auto p-3">

        @if (Types.Count == 0)
        {
            <div class="py-8 text-center text-sm text-slate-500">
                No leave types are available.
            </div>
        }
        else if (FilteredTypes.Count == 0)
        {
            <div class="py-8 text-center text-sm text-slate-500">
                No leave types match your search.
            </div>
        }
        else
        {
            @foreach (var type in FilteredTypes)
            {
                <button type="button"
                        @key="type.LeaveTypeId"
                        class="mb-2 block w-full rounded-lg
                               border p-3 text-left
                               transition-colors
                               @GetButtonClass(type)"
                        disabled="@IsProcessing"
                        @onclick="() => SelectType(type)">

                    <div class="flex items-start
                                justify-between gap-3">

                        <div class="min-w-0 flex-1">

                            <div class="font-semibold text-slate-800">
                                @(string.IsNullOrWhiteSpace(type.Name)
                                    ? "Unnamed leave type"
                                    : type.Name)
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                           type.NameDhivehi))
                            {
                                <div class="mt-0.5 text-xs
                                            text-slate-500">
                                    @type.NameDhivehi
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(type.Code))
                            {
                                <div class="mt-1 text-xs text-slate-500">
                                    Code:
                                    <span class="font-medium">
                                        @type.Code
                                    </span>
                                </div>
                            }
                        </div>

                        @if (IsSelected(type))
                        {
                            <span class="shrink-0 rounded-full
                                         bg-blue-600 px-2 py-0.5
                                         text-xs font-medium
                                         text-white">
                                Selected
                            </span>
                        }
                    </div>
                </button>
            }
        }
    </div>

    <!-- Footer -->
    <div class="border-t border-slate-100 p-4">

        @if (_selectedType is not null)
        {
            <div class="mb-3 rounded-lg bg-blue-50
                        p-2 text-xs text-blue-700">

                Selected:

                <span class="font-semibold">
                    @_selectedType.Name
                </span>
            </div>
        }

        <button type="button"
                class="w-full rounded-lg bg-blue-600
                       px-4 py-2 text-sm font-medium
                       text-white transition-colors
                       hover:bg-blue-700
                       disabled:cursor-not-allowed
                       disabled:bg-slate-300"
                disabled="@CannotAssign"
                @onclick="AssignTypeAsync">

            @if (IsProcessing)
            {
                <span>Assigning...</span>
            }
            else
            {
                <span>Assign New Leave Definition</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LeaveTypeCatalogueDto> Types { get; set; }
        = Array.Empty<LeaveTypeCatalogueDto>();

    [Parameter]
    public EventCallback<LeaveTypeCatalogueDto> OnAssign { get; set; }

    [Parameter]
    public bool IsProcessing { get; set; }

    private string _search = string.Empty;

    private LeaveTypeCatalogueDto? _selectedType;

    private List<LeaveTypeCatalogueDto> FilteredTypes
    {
        get
        {
            IEnumerable<LeaveTypeCatalogueDto> query =
                Types ?? Array.Empty<LeaveTypeCatalogueDto>();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var search = _search.Trim();

                query = query.Where(x =>
                    (
                        !string.IsNullOrWhiteSpace(x.Name) &&
                        x.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                    ||
                    (
                        !string.IsNullOrWhiteSpace(x.NameDhivehi) &&
                        x.NameDhivehi.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                    ||
                    (
                        !string.IsNullOrWhiteSpace(x.Code) &&
                        x.Code.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    ));
            }

            return query
                .OrderBy(x => x.Name)
                .ToList();
        }
    }

    private bool CannotAssign =>
        _selectedType is null ||
        IsProcessing ||
        !OnAssign.HasDelegate;

    protected override void OnParametersSet()
    {
        if (_selectedType is null)
        {
            return;
        }

        // Clear the selection if the parent reloads the list
        // and the selected type is no longer available.
        var selectionStillAvailable =
            Types.Any(x =>
                x.LeaveTypeId ==
                _selectedType.LeaveTypeId);

        if (!selectionStillAvailable)
        {
            _selectedType = null;
        }
    }

    private void SelectType(
        LeaveTypeCatalogueDto type)
    {
        if (IsProcessing)
        {
            return;
        }

        _selectedType = type;
    }

    private async Task AssignTypeAsync()
    {
        if (CannotAssign ||
            _selectedType is null)
        {
            return;
        }

        await OnAssign.InvokeAsync(
            _selectedType);
    }

    private void ClearSearch()
    {
        _search = string.Empty;
    }

    private bool IsSelected(
        LeaveTypeCatalogueDto type)
    {
        return _selectedType?.LeaveTypeId ==
            type.LeaveTypeId;
    }

    private string GetButtonClass(
        LeaveTypeCatalogueDto type)
    {
        return IsSelected(type)
            ? "border-blue-500 bg-blue-50 ring-1 ring-blue-400"
            : "border-slate-200 bg-white hover:bg-slate-50";
    }
}