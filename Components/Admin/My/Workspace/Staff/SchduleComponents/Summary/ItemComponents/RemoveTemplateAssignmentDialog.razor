@using HRM.DTOs.Job.JobWorkTemplateAssignment
@using HRM.DTOs.StaffSchedule
@using HRM.WorkPlanning.Abstractions.JobWorkTemplateAssignment
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations;

@inject IJobWorkTemplateAssignmentService AssignmentService

@if (IsOpen && Assignment is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">

        <div class="absolute inset-0 bg-slate-950/40"
             @onclick="HandleCloseAsync">
        </div>

        <div class="relative w-full max-w-md overflow-hidden
                    rounded-xl bg-white shadow-2xl">

            <div class="border-b border-slate-200 px-6 py-5">

                <div class="flex items-start gap-4">

                    <div class="flex h-11 w-11 shrink-0 items-center
                                justify-center rounded-full bg-red-100
                                text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.5"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M12 9v3.75m9-.75a9 9 0 1
                                     1-18 0 9 9 0 0 1 18 0Zm-9
                                     3.75h.008v.008H12v-.008Z" />

                        </svg>

                    </div>

                    <div>

                        <h2 class="text-lg font-semibold text-slate-900">
                            Remove Work Template
                        </h2>

                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Remove the currently assigned template from
                            this staff job.
                        </p>

                    </div>

                </div>

            </div>

            <EditForm Model="@model"
                      OnValidSubmit="HandleRemoveAsync">

                <DataAnnotationsValidator />

                <div class="space-y-5 px-6 py-5">

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="rounded-lg border border-red-200
                                    bg-red-50 p-4">

                            <p class="text-sm text-red-700">
                                @errorMessage
                            </p>

                        </div>
                    }

                    <div class="rounded-lg border border-slate-200
                                bg-slate-50 p-4">

                        <p class="text-xs font-medium uppercase
                                  tracking-wide text-slate-500">
                            Current Template
                        </p>

                        <p class="mt-1 text-sm font-semibold
                                  text-slate-900">
                            @Assignment.TemplateName
                        </p>

                        <p class="mt-1 text-xs text-slate-500">
                            Effective from
                            @Assignment.EffectiveFrom.ToString(
                                     "dd MMM yyyy")
                        </p>

                    </div>

                    <div>

                        <label class="mb-1.5 block text-sm font-medium
                                      text-slate-700">
                            Remove effective from
                            <span class="text-red-500">*</span>
                        </label>

                        <InputDate @bind-Value="model.EffectiveDate"
                                   disabled="@isSaving"
                                   class="w-full rounded-lg border
                                          border-slate-300 px-3 py-2.5
                                          text-sm outline-none transition
                                          focus:border-red-500
                                          focus:ring-2 focus:ring-red-100
                                          disabled:bg-slate-100" />

                        <ValidationMessage For="@(() => model.EffectiveDate)"
                                           class="mt-1 block text-xs text-red-600" />

                        <p class="mt-1 text-xs leading-5 text-slate-500">
                            The template assignment will remain in history
                            until the day before this date.
                        </p>

                    </div>

                    <div class="rounded-lg border border-amber-200
                                bg-amber-50 p-4">

                        <p class="text-sm font-medium text-amber-800">
                            Existing generated assignments are not deleted
                        </p>

                        <p class="mt-1 text-xs leading-5 text-amber-700">
                            Removing the template only stops it from being
                            used as the staff member's recurring schedule.
                            Existing work plans remain unchanged.
                        </p>

                    </div>

                </div>

                <div class="flex items-center justify-end gap-3
                            border-t border-slate-200 bg-slate-50
                            px-6 py-4">

                    <button type="button"
                            disabled="@isSaving"
                            @onclick="HandleCloseAsync"
                            class="rounded-lg border border-slate-300
                                   bg-white px-4 py-2.5 text-sm
                                   font-medium text-slate-700
                                   hover:bg-slate-100
                                   disabled:cursor-not-allowed
                                   disabled:opacity-50">
                        Cancel
                    </button>

                    <button type="submit"
                            disabled="@(!CanRemove)"
                            class="rounded-lg bg-red-600 px-4 py-2.5
                                   text-sm font-medium text-white
                                   hover:bg-red-700
                                   disabled:cursor-not-allowed
                                   disabled:bg-slate-300">

                        @(isSaving
                            ? "Removing..."
                            : "Remove Template")

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public int JobId { get; set; }

    [Parameter]
    public CurrentWorkTemplateAssignmentDto? Assignment
    {
        get;
        set;
    }

    [Parameter]
    public EventCallback OnRemoved { get; set; }

    private RemoveJobWorkTemplateDto model = new();

    private bool wasOpen;

    private bool isSaving;

    private string? errorMessage;

    private bool CanRemove =>
        !isSaving &&
        Assignment is not null &&
        model.JobWorkTemplateAssignmentId > 0 &&
        model.JobId > 0 &&
        model.EffectiveDate != default &&
        model.EffectiveDate.Date >=
            Assignment.EffectiveFrom.Date;

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            InitialiseModel();
        }

        wasOpen = IsOpen;
    }

    private void InitialiseModel()
    {
        errorMessage = null;

        model = new RemoveJobWorkTemplateDto
            {
                JobWorkTemplateAssignmentId =
                    Assignment?.JobWorkTemplateAssignmentId ?? 0,

                JobId =
                    JobId,

                EffectiveDate =
                    DateTime.Today
            };
    }

    private async Task HandleRemoveAsync()
    {
        if (!CanRemove)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;

            var result =
                await AssignmentService.RemoveAsync(model);

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            if (OnRemoved.HasDelegate)
            {
                await OnRemoved.InvokeAsync();
            }

            await SetOpenAsync(false);
        }
        catch
        {
            errorMessage =
                "An unexpected error occurred while removing the template.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleCloseAsync()
    {
        if (isSaving)
        {
            return;
        }

        await SetOpenAsync(false);
    }

    private async Task SetOpenAsync(bool value)
    {
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(value);
        }
    }
}