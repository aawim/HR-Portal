@using HRM.DTOs.WorkPlanning
@using HRM.DTOs.StaffSchedule
@using HRM.DTOs.Job.JobWorkTemplateAssignment
@using HRM.WorkPlanning.Abstractions.JobWorkTemplateAssignment
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations;

@inject IJobWorkTemplateAssignmentService AssignmentService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50">

        <div class="absolute inset-0 bg-slate-950/40"
             @onclick="HandleCloseAsync">
        </div>

        <aside class="absolute inset-y-0 right-0 flex w-full
                      max-w-xl flex-col bg-white shadow-2xl">

            <!-- Header -->
            <div class="flex items-start justify-between border-b
                        border-slate-200 px-6 py-5">

                <div>
                    <p class="text-xs font-medium uppercase tracking-wide
                              text-blue-600">
                        Work Template
                    </p>

                    <h2 class="mt-1 text-lg font-semibold text-slate-900">
                        @DrawerTitle
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Select the recurring schedule for this staff job.
                    </p>
                </div>

                <button type="button"
                        disabled="@isSaving"
                        @onclick="HandleCloseAsync"
                        class="rounded-lg p-2 text-slate-400
                               hover:bg-slate-100 hover:text-slate-700
                               disabled:cursor-not-allowed
                               disabled:opacity-50">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.5"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M6 18 18 6M6 6l12 12" />
                    </svg>

                </button>

            </div>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto px-6 py-5">

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="mb-5 rounded-lg border border-red-200
                                bg-red-50 p-4">

                        <p class="text-sm font-medium text-red-800">
                            Unable to save assignment
                        </p>

                        <p class="mt-1 text-sm text-red-700">
                            @errorMessage
                        </p>

                    </div>
                }

                <EditForm Model="@model"
                          OnValidSubmit="HandleSaveAsync">

                    <DataAnnotationsValidator />

                    <div class="space-y-6">

                        <!-- Search -->
                        <div>
                            <label class="mb-1.5 block text-sm
                                          font-medium text-slate-700">
                                Search work templates
                            </label>

                            <div class="relative">

                                <input type="search"
                                       value="@searchText"
                                       @oninput="HandleSearchInputAsync"
                                       disabled="@isSaving"
                                       placeholder="Search by name, code or description"
                                       class="w-full rounded-lg border
                                              border-slate-300 px-3 py-2.5
                                              pr-10 text-sm outline-none
                                              transition focus:border-blue-500
                                              focus:ring-2 focus:ring-blue-100
                                              disabled:bg-slate-100" />

                                <div class="pointer-events-none absolute
                                            inset-y-0 right-0 flex items-center
                                            pr-3 text-slate-400">

                                    @if (isSearching)
                                    {
                                        <span class="h-4 w-4 animate-spin
                                                     rounded-full border-2
                                                     border-slate-300
                                                     border-t-slate-700">
                                        </span>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.5"
                                             stroke="currentColor"
                                             class="h-4 w-4">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="m21 21-4.35-4.35m2.1-5.4a7.5
                                                     7.5 0 1 1-15 0 7.5
                                                     7.5 0 0 1 15 0Z" />
                                        </svg>
                                    }

                                </div>

                            </div>
                        </div>

                        <!-- Template results -->
                        <div>
                            <label class="mb-2 block text-sm
                                          font-medium text-slate-700">
                                Work template
                                <span class="text-red-500">*</span>
                            </label>

                            @if (isSearching)
                            {
                                <div class="rounded-lg border
                                            border-slate-200 bg-slate-50
                                            p-5 text-center text-sm
                                            text-slate-500">
                                    Searching templates...
                                </div>
                            }
                            else if (templates.Count == 0)
                            {
                                <div class="rounded-lg border
                                            border-dashed border-slate-300
                                            bg-slate-50 p-5 text-center">

                                    <p class="text-sm font-medium
                                              text-slate-700">
                                        No templates found
                                    </p>

                                    <p class="mt-1 text-xs text-slate-500">
                                        Try another search term or confirm
                                        that active templates exist for
                                        this organisation.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="max-h-72 space-y-2 overflow-y-auto
                                            rounded-lg border border-slate-200
                                            p-2">

                                    @foreach (var template in templates)
                                    {
                                        var isSelected =
                                        model.WorkTemplateId ==
                                        template.WorkTemplateId;

                                        <button type="button"
                                                disabled="@isSaving"
                                                @onclick="() => SelectTemplate(template)"
                                                class="@GetTemplateRowClass(isSelected)">

                                            <div class="flex items-start
                                                        justify-between gap-4">

                                                <div class="text-left">

                                                    <p class="text-sm
                                                              font-semibold
                                                              text-slate-900">
                                                        @template.Name
                                                    </p>

                                                    <div class="mt-1 flex
                                                                flex-wrap gap-2">

                                                        @if (!string.IsNullOrWhiteSpace(
                                                       template.Code))
                                                        {
                                                            <span class="rounded-full
                                                                         bg-slate-100
                                                                         px-2 py-0.5
                                                                         text-xs
                                                                         text-slate-600">
                                                                @template.Code
                                                            </span>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(
                                                       template.TemplateTypeName))
                                                        {
                                                            <span class="rounded-full
                                                                         bg-blue-50
                                                                         px-2 py-0.5
                                                                         text-xs
                                                                         text-blue-700">
                                                                @template.TemplateTypeName
                                                            </span>
                                                        }

                                                    </div>

                                                    <p class="mt-2 text-xs
                                                              text-slate-500">
                                                        @GetTemplateScheduleText(
                                                                 template)
                                                    </p>

                                                </div>

                                                <span class="@GetSelectionIndicatorClass(isSelected)">
                                                    @if (isSelected)
                                                    {
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             fill="none"
                                                             viewBox="0 0 24 24"
                                                             stroke-width="2"
                                                             stroke="currentColor"
                                                             class="h-4 w-4">

                                                            <path stroke-linecap="round"
                                                                  stroke-linejoin="round"
                                                                  d="m4.5 12.75 6 6 9-13.5" />
                                                        </svg>
                                                    }
                                                </span>

                                            </div>

                                        </button>
                                    }

                                </div>
                            }

                            <ValidationMessage For="@(() => model.WorkTemplateId)"
                                               class="mt-1 block text-xs text-red-600" />
                        </div>

                        <!-- Effective dates -->
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                            <div>
                                <label class="mb-1.5 block text-sm
                                              font-medium text-slate-700">
                                    Effective from
                                    <span class="text-red-500">*</span>
                                </label>

                                <InputDate @bind-Value="model.EffectiveFrom"
                                           disabled="@isSaving"
                                           class="w-full rounded-lg border
                                                  border-slate-300 px-3 py-2.5
                                                  text-sm outline-none
                                                  transition focus:border-blue-500
                                                  focus:ring-2 focus:ring-blue-100
                                                  disabled:bg-slate-100" />

                                <ValidationMessage For="@(() => model.EffectiveFrom)"
                                                   class="mt-1 block text-xs text-red-600" />
                            </div>

                            <div>
                                <label class="mb-1.5 block text-sm
                                              font-medium text-slate-700">
                                    Effective to
                                </label>

                                <InputDate @bind-Value="model.EffectiveTo"
                                           disabled="@isSaving"
                                           class="w-full rounded-lg border
                                                  border-slate-300 px-3 py-2.5
                                                  text-sm outline-none
                                                  transition focus:border-blue-500
                                                  focus:ring-2 focus:ring-blue-100
                                                  disabled:bg-slate-100" />

                                <ValidationMessage For="@(() => model.EffectiveTo)"
                                                   class="mt-1 block text-xs text-red-600" />
                            </div>

                        </div>

                        @if (SelectedTemplate is not null)
                        {
                            <div class="rounded-lg border border-blue-100
                                        bg-blue-50 p-4">

                                <p class="text-xs font-medium uppercase
                                          tracking-wide text-blue-600">
                                    Selected Template
                                </p>

                                <p class="mt-1 text-sm font-semibold
                                          text-slate-900">
                                    @SelectedTemplate.Name
                                </p>

                                <p class="mt-1 text-xs text-slate-600">
                                    @GetTemplateScheduleText(
                                             SelectedTemplate)
                                </p>

                            </div>
                        }

                        <button type="submit"
                                class="hidden">
                            Submit
                        </button>

                    </div>

                </EditForm>

            </div>

            <!-- Footer -->
            <div class="flex items-center justify-end gap-3 border-t
                        border-slate-200 bg-slate-50 px-6 py-4">

                <button type="button"
                        disabled="@isSaving"
                        @onclick="HandleCloseAsync"
                        class="rounded-lg border border-slate-300 bg-white
                               px-4 py-2.5 text-sm font-medium text-slate-700
                               hover:bg-slate-100 disabled:cursor-not-allowed
                               disabled:opacity-50">
                    Cancel
                </button>

                <button type="button"
                        disabled="@(!CanSave)"
                        @onclick="HandleSaveAsync"
                        class="rounded-lg bg-blue-600 px-4 py-2.5
                               text-sm font-medium text-white hover:bg-blue-700
                               disabled:cursor-not-allowed
                               disabled:bg-slate-300">

                    @(isSaving
                        ? "Saving..."
                        : SaveButtonText)

                </button>

            </div>

        </aside>

    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public int StaffId { get; set; }

    [Parameter]
    public int JobId { get; set; }

    [Parameter]
    public int OrganisationBusinessEntityId { get; set; }

    [Parameter]
    public CurrentWorkTemplateAssignmentDto? CurrentAssignment
    {
        get;
        set;
    }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private AssignJobWorkTemplateDto model = new();

    private List<WorkTemplateLookupDto> templates = [];

    private string searchText = string.Empty;

    private string? errorMessage;

    private bool isSearching;

    private bool isSaving;

    private bool wasOpen;

    private CancellationTokenSource? searchCancellation;

    private string DrawerTitle =>
        CurrentAssignment is null
            ? "Assign Work Template"
            : "Change Work Template";

    private string SaveButtonText =>
        CurrentAssignment is null
            ? "Assign Template"
            : "Change Template";

    private bool CanSave =>
        !isSaving &&
        model.WorkTemplateId > 0 &&
        model.JobId > 0 &&
        model.IndividualId > 0 &&
        model.OrganisationBusinessEntityId > 0 &&
        model.EffectiveFrom != default &&
        (!model.EffectiveTo.HasValue ||
         model.EffectiveTo.Value.Date >=
         model.EffectiveFrom.Date);

    private WorkTemplateLookupDto? SelectedTemplate =>
        templates.FirstOrDefault(
            x => x.WorkTemplateId ==
                 model.WorkTemplateId);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !wasOpen)
        {
            InitialiseModel();

            await SearchTemplatesAsync();
        }

        wasOpen = IsOpen;
    }

    private void InitialiseModel()
    {
        model = new AssignJobWorkTemplateDto
            {
                IndividualId =
                    StaffId,

                JobId =
                    JobId,

                OrganisationBusinessEntityId =
                    OrganisationBusinessEntityId,

                WorkTemplateId =
                    CurrentAssignment?.WorkTemplateId ?? 0,

                EffectiveFrom =
                    CurrentAssignment is null
                        ? DateTime.Today
                        : DateTime.Today,

                EffectiveTo =
                    null
            };

        searchText = string.Empty;
        errorMessage = null;
    }

    private async Task HandleSearchInputAsync(
        ChangeEventArgs args)
    {
        searchText =
            args.Value?.ToString()?.Trim()
            ?? string.Empty;

        searchCancellation?.Cancel();
        searchCancellation?.Dispose();

        searchCancellation =
            new CancellationTokenSource();

        try
        {
            await Task.Delay(
                300,
                searchCancellation.Token);

            await SearchTemplatesAsync(
                searchCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // User continued typing.
        }
    }

    private async Task SearchTemplatesAsync(
        CancellationToken cancellationToken = default)
    {
        if (OrganisationBusinessEntityId <= 0)
        {
            templates = [];
            return;
        }

        try
        {
            isSearching = true;
            errorMessage = null;

            templates =
                await AssignmentService.SearchTemplatesAsync(
                    OrganisationBusinessEntityId,
                    searchText,
                    cancellationToken);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            templates = [];

            errorMessage =
                "Unable to load work templates.";
        }
        finally
        {
            isSearching = false;
        }
    }

    private void SelectTemplate(
        WorkTemplateLookupDto template)
    {
        if (isSaving)
        {
            return;
        }

        model.WorkTemplateId =
            template.WorkTemplateId;
    }

    private async Task HandleSaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;

            var result =
                await AssignmentService.AssignAsync(
                    model);

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }

            await SetOpenAsync(false);
        }
        catch (Exception)
        {
            errorMessage =
                "An unexpected error occurred while assigning the template.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleCloseAsync()
    {
        if (isSaving)
        {
            return;
        }

        await SetOpenAsync(false);
    }

    private async Task SetOpenAsync(
        bool value)
    {
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(value);
        }
    }

    private static string GetTemplateRowClass(
        bool selected)
    {
        const string baseClass =
            "w-full rounded-lg border p-3 text-left transition " +
            "disabled:cursor-not-allowed disabled:opacity-50 ";

        return selected
            ? baseClass +
              "border-blue-500 bg-blue-50 ring-1 ring-blue-500"
            : baseClass +
              "border-slate-200 bg-white hover:border-blue-300 hover:bg-blue-50/40";
    }

    private static string GetSelectionIndicatorClass(
        bool selected)
    {
        const string baseClass =
            "flex h-6 w-6 shrink-0 items-center justify-center " +
            "rounded-full border ";

        return selected
            ? baseClass +
              "border-blue-600 bg-blue-600 text-white"
            : baseClass +
              "border-slate-300 bg-white text-transparent";
    }

    private static string GetTemplateScheduleText(WorkTemplateLookupDto template)
            {
                if (!template.DefaultStartTime.HasValue ||
                    !template.DefaultEndTime.HasValue)
                {
                    return "Flexible schedule";
                }

                var start =
                    template.DefaultStartTime.Value
                        .ToString("HH:mm");

                var end =
                    template.DefaultEndTime.Value
                        .ToString("HH:mm");

                return template.EndsNextDay
                    ? $"{start} – {end} (+1 day)"
                    : $"{start} – {end}";
            }

    public void Dispose()
    {
        searchCancellation?.Cancel();
        searchCancellation?.Dispose();
    }
}