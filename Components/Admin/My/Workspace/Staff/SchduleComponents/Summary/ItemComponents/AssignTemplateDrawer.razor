@using HRM.DTOs.WorkPlanning
@using HRM.DTOs.StaffSchedule
@using HRM.DTOs.Job.JobWorkTemplateAssignment
@using HRM.WorkPlanning.Abstractions.JobWorkTemplateAssignment
@inject IJobWorkTemplateAssignmentService AssignmentService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50">
        <div class="absolute inset-0 bg-slate-950/40" @onclick="CloseAsync"></div>
        <aside role="dialog" aria-modal="true" aria-labelledby="schedule-form-title" class="absolute inset-y-0 right-0 flex w-full max-w-xl flex-col border-l bg-white shadow-xl">
            <header class="flex items-start justify-between gap-3 border-b p-5">
                <div><h2 id="schedule-form-title" class="text-xl font-semibold">@(CurrentAssignment == null ? "Add" : "Change") @SchedulePurpose.ToLowerInvariant() schedule</h2>
                    <p class="mt-1 text-sm text-slate-500">@StaffName</p></div>
                <button type="button" class="app-button app-button-secondary" disabled="@saving" @onclick="CloseAsync" aria-label="Close schedule form">✕</button>
            </header>
            <div class="flex-1 space-y-5 overflow-y-auto p-5">
                @if (error != null) { <p role="alert" class="rounded-lg border p-3 text-sm text-red-600">@error</p> }
                <fieldset disabled="@saving" class="space-y-5">
                    <section class="space-y-3">
                        <h3 class="font-semibold">1. @(SchedulePurpose == "Duty" ? "Duty details" : "Working hours")</h3>
                        @if (SchedulePurpose == "Duty")
                        {
                            <label class="block text-sm">Duty name<input class="mt-1 w-full rounded-lg border p-2.5" maxlength="100" @bind="name" placeholder="e.g. Service desk duty" /></label>
                            <div class="grid grid-cols-2 gap-3">
                                <label class="text-sm">Start time<input type="time" class="mt-1 w-full rounded-lg border p-2.5" @bind="start" /></label>
                                <label class="text-sm">End time<input type="time" class="mt-1 w-full rounded-lg border p-2.5" @bind="end" /></label>
                            </div>
                            @if (start == end) { <p class="text-xs text-red-600">Choose different start and end times.</p> }
                            @if (end < start) { <p class="text-xs text-slate-500">Ends the following day.</p> }
                        }
                        else
                        {
                            <label class="block text-sm">Working pattern<select class="mt-1 w-full rounded-lg border p-2.5" @bind="scheduleMode"><option value="Standard">Normal staff · Sunday–Thursday</option><option value="Weekly">Shift · selected weekdays</option><option value="Rotation">Rotating shifts · repeating cycle</option></select></label>
                            @if (scheduleMode == "Weekly")
                            {
                                <div class="flex flex-wrap gap-3">
                                @for (var n = 0; n < 7; n++)
                                {
                                    var index = n;
                                    <label class="flex items-center gap-1 text-sm"><input type="checkbox" @bind="weekdays[index]" />@((DayOfWeek)index)</label>
                                }
                                </div>
                            }
                            @if (scheduleMode == "Rotation")
                            {
                                <label class="block text-sm">Cycle day 1 date<InputDate class="mt-1 w-full rounded-lg border p-2.5" @bind-Value="anchor" /></label>
                                <p class="text-xs text-slate-500">The cycle repeats from this date, including Fridays and Saturdays. Add shifts or rest days in order.</p>
                                @for (var n = 0; n < rotation.Count; n++)
                                {
                                    var index = n;
                                    <div class="flex items-center gap-2"><label class="flex-1 text-sm">Day @(index + 1)<select class="ml-2 rounded-lg border p-2" @bind="rotation[index]"><option value="0">Rest day</option>@foreach (var item in templates) { <option value="@item.WorkTemplateId">@item.Name · @item.DefaultStartTime?.ToString("HH:mm")–@item.DefaultEndTime?.ToString("HH:mm")</option> }</select></label><button type="button" class="app-button app-button-secondary" @onclick="() => rotation.RemoveAt(index)" aria-label="Remove cycle day">Remove</button></div>
                                }
                                <button type="button" class="app-button app-button-secondary" disabled="@(rotation.Count >= 90)" @onclick="() => rotation.Add(0)">Add cycle day</button>
                            }
                            else
                            {
                            <label class="block text-sm">Choose working hours<select class="mt-1 w-full rounded-lg border p-2.5" @bind="templateId">
                                <option value="0">Select a schedule</option>
                                @foreach (var item in templates) { <option value="@item.WorkTemplateId">@item.Name · @item.DefaultStartTime?.ToString("HH:mm")–@item.DefaultEndTime?.ToString("HH:mm")</option> }
                            </select></label>
                            }
                            @if (templates.Count == 0) { <p class="text-sm text-slate-500">No working hours are available. Ask HR to add a schedule in Settings.</p> }
                        }
                    </section>
                    <section class="space-y-3">
                        <h3 class="font-semibold">2. When does it apply?</h3>
                        <label class="block text-sm">Duration<select class="mt-1 w-full rounded-lg border p-2.5" @bind="period"><option value="OneDay">One day</option><option value="DateRange">Date range</option><option value="Ongoing">Ongoing</option></select></label>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <label class="text-sm">@(period == "OneDay" ? "Date" : "From")<InputDate class="mt-1 w-full rounded-lg border p-2.5" @bind-Value="from" /></label>
                            @if (period == "DateRange") { <label class="text-sm">Until<InputDate class="mt-1 w-full rounded-lg border p-2.5" @bind-Value="to" /></label> }
                        </div>
                        @if (period == "DateRange" && to < from) { <p class="text-xs text-red-600">The end date must be on or after the start date.</p> }
                    </section>
                    @if (SchedulePurpose == "Duty")
                    {
                        <section class="space-y-3">
                            <h3 class="font-semibold">3. Required clock events</h3>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" @bind="checkIn" />Check in at @start.ToString("HH:mm")</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" @bind="checkOut" />Check out at @end.ToString("HH:mm")</label>
                            <p class="text-xs text-slate-500">These are separate from the official schedule's check-ins.</p>
                        </section>
                    }
                    <section class="space-y-2 rounded-lg border p-4" aria-label="Schedule summary">
                        <h3 class="font-semibold">Summary</h3>
                        <p class="text-sm">@(SchedulePurpose == "Duty" ? string.IsNullOrWhiteSpace(name) ? "New duty" : name : Selected?.Name ?? "Choose working hours") · @Hours</p>
                        <p class="text-sm">@Dates</p>
                        @if (SchedulePurpose == "Official") { <p class="text-sm">@(scheduleMode == "Rotation" ? $"Repeats every {rotation.Count} days from {anchor:dd MMM yyyy}" : scheduleMode == "Weekly" ? "Attendance follows the selected weekdays" : "Friday and Saturday are weekends")</p> }
                        @if (SchedulePurpose == "Duty" && OfficialSchedule != null)
                        {
                            <p class="text-xs text-slate-500">Official hours: @OfficialSchedule.DefaultStartTime?.ToString("HH:mm")–@OfficialSchedule.DefaultEndTime?.ToString("HH:mm").</p>
                            @if (Coverage is { HasOfficialSchedule: true } coverage)
                            {
                                <p class="text-sm">@Minutes(coverage.DutyWithinOfficialMinutes) within official hours · @Minutes(coverage.PotentialOvertimeMinutes) outside official hours.</p>
                                @if (coverage.PotentialOvertimeMinutes > 0) { <p class="text-xs text-amber-700">Outside hours need a separate OT request and approval.</p> }
                            }
                        }
                    </section>
                </fieldset>
            </div>
            <footer class="flex flex-wrap justify-end gap-2 border-t p-5">
                <button type="button" class="app-button app-button-secondary" disabled="@saving" @onclick="CloseAsync">Cancel</button>
                <button type="button" class="app-button app-button-primary" disabled="@(!CanSave)" @onclick="SaveAsync">@(saving ? "Saving..." : "Save schedule")</button>
            </footer>
        </aside>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int StaffId { get; set; }
    [Parameter] public int JobId { get; set; }
    [Parameter] public int OrganisationBusinessEntityId { get; set; }
    [Parameter] public string StaffName { get; set; } = "";
    [Parameter] public string SchedulePurpose { get; set; } = "Official";
    [Parameter] public CurrentWorkTemplateAssignmentDto? CurrentAssignment { get; set; }
    [Parameter] public CurrentWorkTemplateAssignmentDto? OfficialSchedule { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    private List<WorkTemplateLookupDto> templates = [];
    private bool wasOpen, saving;
    private string? error;
    private string name = "", period = "OneDay";
    private TimeOnly start = new(10, 0), end = new(12, 0);
    private DateTime from = DateTime.UtcNow.AddHours(5).Date, to = DateTime.UtcNow.AddHours(5).Date;
    private int templateId;
    private string scheduleMode = "Standard";
    private bool[] weekdays = [true, true, true, true, true, false, false];
    private List<int> rotation = [0];
    private DateTime anchor = DateTime.UtcNow.AddHours(5).Date;
    private bool checkIn = true, checkOut = true;
    private WorkTemplateLookupDto? Selected => templates.FirstOrDefault(x => x.WorkTemplateId == templateId);
    private bool CanSave => !saving && from != default && (period != "DateRange" || to >= from) &&
        (SchedulePurpose == "Duty" ? !string.IsNullOrWhiteSpace(name) && name.Trim().Length <= 100 && start != end : scheduleMode == "Rotation" ? rotation.Any(x => x > 0) && anchor != default : templateId > 0 && (scheduleMode != "Weekly" || weekdays.Any(x => x)));
    private string Hours => SchedulePurpose == "Duty" ? $"{start:HH:mm}–{end:HH:mm}" : $"{Selected?.DefaultStartTime:HH:mm}–{Selected?.DefaultEndTime:HH:mm}";
    private string Dates => period == "OneDay" ? from.ToString("dd MMM yyyy") : period == "Ongoing" ? $"From {from:dd MMM yyyy}, ongoing" : $"{from:dd MMM yyyy}–{to:dd MMM yyyy}";
    private static string Minutes(int n) => $"{n / 60}h {n % 60:00}m";
    private HRM.Helpers.WorkHourCoverageResult? Coverage
    {
        get
        {
            if (OfficialSchedule?.DefaultStartTime == null || OfficialSchedule.DefaultEndTime == null) return null;
            var officeStart = from.Date.Add(OfficialSchedule.DefaultStartTime.Value.TimeOfDay);
            var officeEnd = from.Date.Add(OfficialSchedule.DefaultEndTime.Value.TimeOfDay);
            if (OfficialSchedule.EndsNextDay || officeEnd <= officeStart) officeEnd = officeEnd.AddDays(1);
            var dutyStart = from.Date.Add(start.ToTimeSpan());
            var dutyEnd = from.Date.Add(end.ToTimeSpan());
            if (end < start) dutyEnd = dutyEnd.AddDays(1);
            return HRM.Helpers.WorkHourCoverage.Calculate([(officeStart, officeEnd)], [(dutyStart, dutyEnd)]);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !wasOpen)
        {
            from = to = DateTime.UtcNow.AddHours(5).Date; error = null;
            period = SchedulePurpose == "Duty" ? "OneDay" : "Ongoing";
            if (CurrentAssignment != null)
            {
                if (CurrentAssignment.EffectiveFrom.Date > from) from = CurrentAssignment.EffectiveFrom.Date;
                to = CurrentAssignment.EffectiveTo?.Date ?? from;
                period = !CurrentAssignment.EffectiveTo.HasValue ? "Ongoing" : CurrentAssignment.EffectiveFrom.Date == CurrentAssignment.EffectiveTo.Value.Date ? "OneDay" : "DateRange";
            }
            name = CurrentAssignment?.TemplateName ?? "";
            start = CurrentAssignment?.DefaultStartTime is { } a ? TimeOnly.FromDateTime(a) : new(10, 0);
            end = CurrentAssignment?.DefaultEndTime is { } b ? TimeOnly.FromDateTime(b) : new(12, 0);
            checkIn = CurrentAssignment == null || CurrentAssignment.MandatoryCheckInOffsets.Count > 0;
            checkOut = CurrentAssignment == null || CurrentAssignment.MandatoryCheckOutOffsets.Count > 0;
            templateId = CurrentAssignment?.WorkTemplateId ?? 0;
            scheduleMode = CurrentAssignment?.ScheduleMode ?? "Standard";
            anchor = CurrentAssignment?.RotationAnchorDate ?? from;
            weekdays = Enumerable.Range(0, 7).Select(n => ((CurrentAssignment?.WorkingDaysMask ?? 31) & (1 << n)) != 0).ToArray();
            rotation = HRM.Helpers.StaffScheduleCalendar.Parse(CurrentAssignment?.RotationTemplateIds);
            if (rotation.Count == 0) rotation.Add(0);
            if (SchedulePurpose == "Official")
            {
                try { templates = (await AssignmentService.SearchTemplatesAsync(OrganisationBusinessEntityId, null)).Where(x => !(x.Code?.StartsWith("DUTY-", StringComparison.OrdinalIgnoreCase) ?? false)).ToList(); }
                catch { error = "Working hours could not be loaded. Close and try again."; templates = []; }
            }
        }
        wasOpen = IsOpen;
    }
    private async Task SaveAsync()
    {
        if (!CanSave) return;
        saving = true; error = null;
        try
        {
            var result = SchedulePurpose == "Duty"
                ? await AssignmentService.AssignDutyAsync(new() { JobId = JobId, IndividualId = StaffId, OrganisationBusinessEntityId = OrganisationBusinessEntityId,
                    Name = name, StartTime = start, EndTime = end, FromDate = from, ToDate = to, Period = period, RequireCheckIn = checkIn, RequireCheckOut = checkOut })
                : await AssignmentService.AssignAsync(new() { JobId = JobId, IndividualId = StaffId, OrganisationBusinessEntityId = OrganisationBusinessEntityId,
                    WorkTemplateId = scheduleMode == "Rotation" ? rotation.First(x => x > 0) : templateId, SchedulePurpose = "Official",
                    ScheduleMode = scheduleMode, WorkingDaysMask = scheduleMode == "Weekly" ? Enumerable.Range(0, 7).Where(n => weekdays[n]).Sum(n => 1 << n) : 31,
                    RotationAnchorDate = anchor, RotationTemplateIds = rotation.ToList(),
                    EffectiveFrom = from, EffectiveTo = period == "OneDay" ? from : period == "DateRange" ? to : null });
            if (!result.Success) { error = result.Message; return; }
            await OnSaved.InvokeAsync(); await IsOpenChanged.InvokeAsync(false);
        }
        catch { error = "The schedule could not be saved. Please try again."; }
        finally { saving = false; }
    }
    private Task CloseAsync() => saving ? Task.CompletedTask : IsOpenChanged.InvokeAsync(false);
}
