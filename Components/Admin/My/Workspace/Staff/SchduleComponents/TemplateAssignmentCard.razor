@using HRM.DTOs.StaffSchedule
<section class="min-w-0 rounded-xl border bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold">@(SchedulePurpose == "Official" ? "Official working hours" : "Duty schedule")</h3>
        <button type="button" class="app-button app-button-secondary" disabled="@IsDisabled" @onclick="() => OnAssignRequested.InvokeAsync()">
            @(CurrentAssignment == null ? SchedulePurpose == "Duty" ? "Add duty" : "Set working hours" : "Change")
        </button>
    </div>
    @if (CurrentAssignment is { } current)
    {
        @if (current.ScheduleMode == "Rotation")
        {
            <p class="mt-4 font-semibold">Rotating shifts · @HRM.Helpers.StaffScheduleCalendar.Parse(current.RotationTemplateIds).Count-day cycle</p>
            <p class="mt-1 text-sm">Cycle day 1: @current.RotationAnchorDate?.ToString("dd MMM yyyy"). View or change the cycle using Change.</p>
        }
        else
        {
        <p class="mt-4 text-xl font-semibold tabular-nums">@current.DefaultStartTime?.ToString("HH:mm")–@current.DefaultEndTime?.ToString("HH:mm") @if (current.EndsNextDay) { <span class="text-xs font-normal">next day</span> }</p>
        @if (SchedulePurpose == "Official") { <p class="text-xs text-slate-500">Working days: @string.Join(", ", Enumerable.Range(0, 7).Where(n => (current.WorkingDaysMask & (1 << n)) != 0).Select(n => ((DayOfWeek)n).ToString()))</p> }
        }
        <p class="mt-1 break-words text-sm">@current.TemplateName</p>
        <p class="mt-2 text-xs text-slate-500">@current.EffectiveFrom.ToString("dd MMM yyyy") @(current.EffectiveTo.HasValue ? $"through {current.EffectiveTo:dd MMM yyyy}" : "onwards")</p>
        <div class="mt-3 space-y-1 text-sm">
            @if (current.DefaultStartTime.HasValue && current.ScheduleMode != "Rotation")
            {
                @foreach (var offset in current.MandatoryCheckInOffsets) { <p>Check in at <strong>@current.DefaultStartTime.Value.AddMinutes(offset).ToString("HH:mm")</strong> · required</p> }
                @foreach (var offset in current.MandatoryCheckOutOffsets) { <p>Check out at <strong>@current.DefaultStartTime.Value.AddMinutes(offset).ToString("HH:mm")</strong> · required</p> }
            }
        </div>
        <div class="mt-4 flex flex-wrap gap-2"><button type="button" class="app-button app-button-secondary" disabled="@IsDisabled" @onclick="() => OnRemoveRequested.InvokeAsync(current)">End schedule</button></div>
    }
    else
    {
        <p class="mt-4 text-sm text-slate-500">@(SchedulePurpose == "Duty" ? "No duty assigned. Add one when the staff member has an extra responsibility." : "Set the staff member's regular working hours.")</p>
    }
    @if (History.Count > 0)
    {
        <details class="mt-4 border-t pt-3">
            <summary class="cursor-pointer text-sm text-slate-500">Schedule history (@History.Count)</summary>
            <ul class="mt-3 space-y-3">
                @foreach (var row in History.OrderByDescending(x => x.EffectiveFrom))
                {
                    <li class="border-b pb-2 text-sm"><p class="font-medium">@row.TemplateName</p><p class="mt-1 text-xs text-slate-500">@row.EffectiveFrom.ToString("dd MMM yyyy")–@(row.EffectiveTo?.ToString("dd MMM yyyy") ?? "Ongoing") · @(row.IsCurrent ? "Current" : !row.IsActive ? "Removed" : row.EffectiveFrom.Date > DateTime.UtcNow.AddHours(5).Date ? "Scheduled" : "Ended")</p></li>
                }
            </ul>
        </details>
    }
</section>
@code {
    [Parameter] public int StaffId { get; set; }
    [Parameter] public int JobId { get; set; }
    [Parameter] public int OrganisationBusinessEntityId { get; set; }
    [Parameter] public string SchedulePurpose { get; set; } = "Official";
    [Parameter] public CurrentWorkTemplateAssignmentDto? CurrentAssignment { get; set; }
    [Parameter] public IReadOnlyList<JobWorkTemplateAssignmentHistoryDto> History { get; set; } = [];
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnAssignRequested { get; set; }
    [Parameter] public EventCallback<CurrentWorkTemplateAssignmentDto> OnRemoveRequested { get; set; }
}
