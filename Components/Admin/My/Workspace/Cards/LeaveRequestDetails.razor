@using HRM.Components.Cards
@using HRM.Components.Pages.Online.Leave
@using HRM.DTOs.Leave

<BaseCard Title="Leave Request Details">
    <section aria-label="Leave request details" aria-busy="@Busy" class="p-6 space-y-5">
        <div class="flex flex-wrap justify-between items-start gap-3">
            <div>
                <h2 class="text-lg font-semibold text-slate-800">@Item.Applicant</h2>
                <p class="text-sm text-slate-500">@Item.Reference · @Item.LeaveType</p>
            </div>
            <button type="button" disabled="@Busy" class="border rounded px-3 py-2 text-sm disabled:opacity-50" @onclick="OnClose">Close details</button>
        </div>
        <div class="rounded-lg border bg-slate-50 p-4 space-y-1">
            <p class="font-medium">@Item.FromDate.ToString("dd MMM yyyy") – @Item.ToDate.ToString("dd MMM yyyy") · @Item.Duration days</p>
            <p class="text-sm text-amber-700">@Item.Status</p>
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div><dt class="font-medium text-slate-500">Reason</dt><dd class="mt-1">@Display(Item.Reason)</dd></div>
            <div><dt class="font-medium text-slate-500">Contact</dt><dd class="mt-1">@Display(Item.Contact)</dd></div>
            <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Additional details</dt><dd class="mt-1 whitespace-pre-wrap break-words">@Display(Item.Explanation)</dd></div>
            <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Leave address</dt><dd class="mt-1 whitespace-pre-wrap break-words">@Display(Item.Address)</dd></div>
            <div class="sm:col-span-2"><dt class="font-medium text-slate-500">Work handover</dt><dd class="mt-1">@Item.HandoverStatus
                @if (Item.HasHandover) { <a class="mt-1 block text-blue-700 underline" href="@($"/online/leave-handovers/{Item.LeaveId}")">View work handover</a> }
            </dd></div>
        </dl>
        <div class="border-t pt-4 space-y-3">
            <h3 class="font-semibold">Request actions</h3>
            @if (Message != null) { <p role="status" class="text-sm">@Message</p> }
            @if (Busy) { <p role="status" class="text-sm text-slate-500">Saving status change…</p> }
            @if (Item.Actions.Count > 0 && Item.ActionsMessage != null) { <p role="status" class="text-sm text-amber-700">@Item.ActionsMessage</p> }
            <RequestActionButtons @key="Item.RequestId" Actions="Item.Actions" EmptyMessage="Item.ActionsMessage" Disabled="Busy" OnExecute="OnExecute" />
        </div>
    </section>
</BaseCard>

@code {
    [Parameter, EditorRequired] public PendingLeaveRequestDto Item { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RequestActionSubmissionDto> OnExecute { get; set; }
    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
}
