@using HRM.DTOs
@using HRM.Services.Interfaces
@inject ITeam TeamService
@inject ILogger<MyTeamCard> Logger
@rendermode RenderMode.InteractiveServer

<section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-2 border-b border-slate-100 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-800">My teams</h2>
        <button type="button" disabled="@loading" class="text-xs text-blue-700 disabled:opacity-50" @onclick="FetchData">Refresh</button>
    </div>
    @if (loading)
    {
        <p role="status" class="p-4 text-xs text-slate-500">Loading team members…</p>
    }
    else if (error != null)
    {
        <p role="alert" class="p-4 text-xs text-red-700">@error</p>
    }
    else if (teams.Count == 0)
    {
        <p class="p-4 text-xs text-slate-500">You are not assigned as a supervisor for an active team.</p>
    }
    else
    {
        <div class="max-h-[32rem] space-y-2 overflow-y-auto p-2">
            @foreach (var team in teams)
            {
                <section @key="team.TeamId" class="overflow-hidden rounded-lg border border-slate-100">
                    <div class="bg-slate-50 px-3 py-2">
                        <h3 class="break-words text-xs font-semibold text-slate-800">@team.Name</h3>
                        <p class="mt-1 text-xs text-slate-500">@team.Staffs.Count @(team.Staffs.Count == 1 ? "member" : "members")</p>
                        @if (!string.IsNullOrWhiteSpace(team.NameDhivehi)) { <p lang="dv" dir="rtl" class="mt-1 text-xs text-slate-500">@team.NameDhivehi</p> }
                    </div>
                    <ul class="divide-y divide-slate-100">
                        @foreach (var member in team.Staffs)
                        {
                            <li @key="member.StaffId" class="px-3 py-2">
                                <p class="break-words text-sm font-medium text-slate-800">@member.FullName</p>
                                <p class="mt-0.5 text-xs text-slate-500">@(member.IsSuperVisor ? "Supervisor" : "Team member")</p>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</section>

@code {
    private List<TeamDto> teams = [];
    private bool loading = true;
    private string? error;
    protected override async Task OnInitializedAsync() => await FetchData();
    private async Task FetchData()
    {
        loading = true; error = null;
        try { teams = await TeamService.GetMyTeamsAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Could not load supervised teams."); error = "Team members could not be loaded. Please refresh."; }
        finally { loading = false; }
    }
}
