@using HRM.Components.Cards
@using HRM.DTOs.Leave

@if (Loading || Items.Count > 0 || !string.IsNullOrWhiteSpace(Message))
{
<BaseCard Title="Pending Leave Requests">
    <div class="px-4 py-3 space-y-3">
        @if (Message != null) { <p role="status" class="text-sm">@Message</p> }
        @if (Loading) { <p>Loading requests…</p> }

        @foreach (var item in (showAll ? Items : Items.Take(5)))
        {
            <button type="button" disabled="@(Busy || Loading)" aria-pressed="@(SelectedRequestId == item.RequestId)"
                    class="w-full text-left border-b rounded px-2 py-3 hover:bg-slate-50 disabled:opacity-50 @(SelectedRequestId == item.RequestId ? "bg-blue-50 ring-1 ring-blue-200" : "")"
                    @onclick="() => OnSelected.InvokeAsync(item)">
                <div class="flex justify-between gap-3"><strong>@item.Applicant</strong><span class="text-xs text-amber-700">@item.Status</span></div>
                <div class="text-sm text-slate-500">@item.LeaveType · @item.FromDate.ToString("dd MMM yyyy") – @item.ToDate.ToString("dd MMM yyyy") (@item.Duration days)</div>
                <span class="text-xs text-blue-600">@item.Reference · View details</span>
            </button>
        }
        <div class="flex flex-wrap justify-between gap-3 text-sm">
            <span>@Items.Count pending requests</span>
            @if (Items.Count > 5) { <button type="button" disabled="@(Busy || Loading)" @onclick="() => showAll = !showAll">@(showAll ? "Show fewer" : "View all")</button> }
            <button type="button" disabled="@(Busy || Loading)" @onclick="OnRefresh">Refresh</button>
        </div>
    </div>
</BaseCard>
}

@code {
    [Parameter] public List<PendingLeaveRequestDto> Items { get; set; } = new();
    [Parameter] public int? SelectedRequestId { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback<PendingLeaveRequestDto> OnSelected { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    private bool showAll;
}
