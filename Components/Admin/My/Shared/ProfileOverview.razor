@using HRM.DTOs.Profile
@using HRM.Components.Profile.Employment
@using HRM.Components.Profile
@using Services.Interfaces.Profile

@inject NavigationManager NavigationManager
@inject IProfileService ProfileService



<PageTitle>@(_profile?.FullName ?? "Staff Profile")</PageTitle>

@if (_loading)
{
    <div class="min-h-screen bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

            <div class="animate-pulse rounded-2xl border border-slate-200 bg-white p-6">
                <div class="flex items-center gap-5">

                    <div class="h-24 w-24 rounded-2xl bg-slate-200"></div>

                    <div class="flex-1">
                        <div class="h-7 w-64 rounded bg-slate-200"></div>
                        <div class="mt-3 h-4 w-40 rounded bg-slate-100"></div>
                        <div class="mt-4 h-4 w-80 max-w-full rounded bg-slate-100"></div>
                    </div>

                </div>
            </div>

        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="min-h-screen bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

            <div class="rounded-2xl border border-red-200 bg-red-50 p-6">

                <div class="flex items-start gap-3">

                    <span class="material-symbols-rounded mt-0.5 text-red-600">
                        error
                    </span>

                    <div>
                        <h2 class="font-semibold text-red-900">
                            Unable to load profile
                        </h2>

                        <p class="mt-1 text-sm text-red-700">
                            @_errorMessage
                        </p>

                        <button type="button"
                                class="mt-4 rounded-xl bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800"
                                @onclick="LoadProfileAsync">
                            Try again
                        </button>
                    </div>

                </div>

            </div>

        </div>
    </div>
}
else if (_profile is null)
{
    <div class="min-h-screen bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

            <div class="rounded-2xl border border-slate-200 bg-white px-6 py-12 text-center shadow-sm">

                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                    <span class="material-symbols-rounded text-[28px]">
                        person_off
                    </span>
                </div>

                <h2 class="mt-4 font-semibold text-slate-900">
                    Profile not found
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    The requested staff profile could not be found.
                </p>

                <button type="button"
                        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
                        @onclick="GoBack">
                    <span class="material-symbols-rounded text-[18px]">
                        arrow_back
                    </span>

                    Back to workspace
                </button>

            </div>

        </div>
    </div>
}
else
{
    <div class="min-h-screen bg-slate-50">

        <ProfileHeader Profile="_profile"
                       ShowBackButton="true"
                       ShowPrintButton="true"
                       ShowEditButton="true"
                       ShowActionsButton="true"
                       OnBack="GoBack"
                       OnPrint="PrintProfile"
                       OnEdit="EditProfile"
                       OnActions="OpenProfileActions" />

        <div class="space-y-6">

            <ProfileActiveJob Job="@_profile.ActiveJob"
                              IsLoading="false"
                              Message="@_activeJobMessage" />

            <div class="rounded-2xl border border-dashed border-slate-300
                bg-white p-10 text-center">

                <span class="material-symbols-rounded text-4xl text-slate-300">
                    dashboard
                </span>

                <h2 class="mt-3 font-semibold text-slate-900">
                    More profile information
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Contacts, addresses, leave types, positions and education
                    will be added here.
                </p>

            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public int StaffId { get; set; }

    [Parameter]
    public int JobId { get; set; }

    private ProfileOverviewDto? _profile;

    private bool _loading = true;

    private string? _errorMessage;

    private string? _activeJobMessage;

    private int _loadedStaffId;

    public List<ProfileContactDto> Contacts { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        if (StaffId <= 0)
        {
            _profile = null;
            _errorMessage = "A valid staff ID is required.";
            _activeJobMessage = null;
            _loading = false;

            return;
        }

        /*
        * Avoid reloading when the parent component renders again
        * with the same staff member.
                 */
        if (_loadedStaffId == StaffId &&
            _profile is not null)
        {
            return;
        }

        _loadedStaffId = StaffId;

        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            _activeJobMessage = null;
            _profile = null;

            _profile =
                await ProfileService.GetProfileAsync(
                    StaffId);

            if (_profile is null)
            {
                _errorMessage =
                    "The requested staff profile could not be found.";

                return;
            }

            if (_profile.ActiveJob is null)
            {
                _activeJobMessage =
                    "This staff member does not have an active approved job.";
            }
        }
        catch (Exception ex)
        {
            _profile = null;

            _errorMessage =
                "An unexpected error occurred while loading the profile.";

            Console.Error.WriteLine(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/admin/my/workspace");
    }

    private void PrintProfile()
    {
        // JavaScript print interop will be added later.
    }

    private void EditProfile()
    {
        // Open profile edit drawer or modal.
    }

    private void OpenProfileActions()
    {
        // Open profile actions dropdown.
    }
}