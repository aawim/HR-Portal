@page "/admin/settings/leave-flows"
@page "/admin/settings/leaves/approval-flows"
@page "/admin/settings/requests/approval-flows"
@attribute [Authorize]
@rendermode InteractiveServer
@using HRM.DTOs.Leave
@using HRM.Services.Leave
@inject LeaveFlowConfigurationService Configuration
@inject ILogger<LeaveFlowSettings> Logger
@inject HRM.Services.Interfaces.IUserAccessService UserAccess

<PageTitle>Request approval flows</PageTitle>
<div class="mx-auto max-w-5xl space-y-5 p-4">
    <a href="/admin/settings/leaves" class="text-sm text-blue-700 underline">Back to Leaves Management</a>
    <h1 class="text-2xl font-semibold">Request approval flows</h1>
    @if (message != null) { <p role="status" class="whitespace-pre-line rounded border bg-slate-50 p-3">@message</p> }
    @if (loading) { <p role="status">Loading configuration…</p> }
    else if (data == null) { <button type="button" class="rounded border px-4 py-2" @onclick="ReloadAsync">Try again</button> }
    else if (data != null)
    {
        <p class="text-slate-600">Organisation: <strong>@data.Organisation</strong>. Select a Job Type and Request Type. This flow applies automatically to all staff whose job has that Job Type.</p>
        <h2 class="font-semibold">1. Select the staff group and request</h2>
        <fieldset disabled="@busy" class="space-y-4 rounded-xl border bg-white p-5">
            <div class="grid gap-4 sm:grid-cols-3">
                <label>Job Type<select id="flow-job-type" class="mt-1 w-full rounded border p-2" @bind="jobType" @bind:after="LoadFlowAsync"><option value="0">Select Job Type</option>@foreach (var x in data.JobTypes) { <option value="@x.Id">@x.Name</option> }</select></label>
                <label>Request Type<select id="flow-request-type" class="mt-1 w-full rounded border p-2" @bind="requestType" @bind:after="RequestTypeChangedAsync"><option value="0">Select Request Type</option>@foreach (var x in data.RequestTypes) { <option value="@x.Id">@x.Name</option> }</select></label>
            </div>
            @if (model != null)
            {
                <h2 class="text-lg font-semibold">2. Add approval stages and assign User Groups</h2>
                <p class="text-sm text-slate-500">@(model.Version == 0 ? "Not configured — new submissions are blocked until a flow is saved." : $"Configured version {model.Version}")</p>
                @if (model.ImportedFromLegacy)
                {
                    <p class="rounded bg-blue-50 p-3 text-sm text-blue-900">Loaded your previous approval flow as a draft. Early Return drafts use Pending HR Approval where available. Review each processing status and save to apply this flow to new requests for the selected Job Type.</p>
                }
                @if (model.Version > 0 && model.Stages!.Any(x => x.UserGroupId == 0))
                {
                    <p class="rounded bg-amber-50 p-3 text-sm text-amber-900">This saved flow uses older approver rules. Select a User Group for each stage and save a new version.</p>
                }
                <label class="block">Approval level<select id="flow-level" class="mt-1 w-full rounded border p-2" @bind="level" @bind:after="ResizeStages">
                    <option value="0">Level 0 — reserved for future automatic approval</option>
                    @for (var i = 1; i <= 20; i++) { <option value="@i">Level @i — @i approval @(i == 1 ? "stage" : "stages")</option> }
                </select></label>
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-blue-200 bg-blue-50 p-3">
                    <p class="text-sm text-blue-900">Level @level = @level approval @(level == 1 ? "stage" : "stages"). Select a User Group in each stage below.</p>
                    <button id="flow-add-stage" type="button" @onclick="AddStage" disabled="@(level >= 20)" class="rounded bg-blue-600 px-4 py-2 font-medium text-white disabled:opacity-50">+ Add approval stage</button>
                </div>
                @if (level == 0)
                {
                    <p role="status" class="rounded bg-amber-50 p-3 text-amber-900">Level 0 is reserved for future AI or condition-based automatic approval. It cannot be enabled yet. Your saved flow stays unchanged.</p>
                }
                else
                {
                    <div class="rounded-lg bg-blue-50 p-4 font-medium text-blue-900">Staff → @string.Join(" → ", model.Stages!.Select(x => $"{x.Name} ({data.States.FirstOrDefault(s => s.Id == x.StateId)?.Name.Trim() ?? x.StateId.ToString()})")) → Approved</div>
                    @for (var i = 0; i < model.Stages!.Count; i++)
                    {
                        var index = i;
                        var stage = model.Stages[index];
                        <section @key="stage" class="space-y-3 rounded-lg border p-4">
                            <div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-semibold">Stage @(index + 1)</h2><div class="flex gap-2">
                                <button type="button" disabled="@(index == 0)" @onclick="() => MoveStage(index, -1)" class="rounded border px-2 py-1 disabled:opacity-50">Move up</button>
                                <button type="button" disabled="@(index == model.Stages.Count - 1)" @onclick="() => MoveStage(index, 1)" class="rounded border px-2 py-1 disabled:opacity-50">Move down</button>
                                <button type="button" @onclick="() => RemoveStage(index)" class="rounded border border-red-200 px-2 py-1 text-red-700">Remove stage</button>
                            </div></div>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label>Stage name<input id="@($"flow-stage-name-{index}")" class="mt-1 w-full rounded border p-2" maxlength="150" @bind="stage.Name" /></label>
                                <label>User Group<select id="@($"flow-stage-group-{index}")" class="mt-1 w-full rounded border p-2" @bind="stage.UserGroupId"><option value="0">Select User Group</option>@foreach (var group in data.UserGroups) { <option value="@group.Id">@group.Name</option> }</select></label>
                                <label>Processing status<select id="@($"flow-stage-state-{index}")" class="mt-1 w-full rounded border p-2" @bind="stage.StateId"><option value="0">Select processing status</option>@foreach (var state in data.States) { <option value="@state.Id">@state.Name</option> }</select></label>
                                <label>Eligible reviewers<select id="@($"flow-stage-scope-{index}")" class="mt-1 w-full rounded border p-2" @bind="stage.ApplicantSupervisorOnly"><option value="false">Staff in this User Group within the organisation</option><option value="true">Applicant's team / department supervisors in this User Group</option></select></label>
                            </div>
                        </section>
                    }
                }
                <p class="text-sm text-slate-600">Stages run in the displayed order. Any one eligible assigned reviewer completes a stage. A supervisor stage requires both the selected User Group and a supervisor relationship to the applicant. Staff cannot verify or approve their own requests.</p>
                <button type="button" @onclick="SaveAsync" disabled="@(level == 0 || model.Stages!.Any(x => x.UserGroupId == 0 || x.StateId == 0))" class="rounded bg-blue-600 px-4 py-2 text-white disabled:opacity-50">@(busy ? "Saving…" : "Save approval flow")</button>
            }
            else
            {
                <p role="status" class="rounded-lg border border-blue-200 bg-blue-50 p-4 text-blue-900">Select both a Job Type and a Request Type above to display the approval level, Add approval stage button, and User Group selector for each stage.</p>
            }
        </fieldset>
        <p class="text-sm text-slate-500">Extensions begin with the applicant's supervisor and continue to HR. Early returns use one HR stage. Each stage needs a distinct processing status. Each save creates a new version; existing requests retain their original flow. Submission checks every stage has an eligible approver.</p>
        <a class="text-sm text-blue-700 underline" href="/admin/settings/org/teams">Configure teams and supervisors</a>
        <a class="ml-4 text-sm text-blue-700 underline" href="/admin/settings/states">Configure allowed state transitions</a>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "issueOrganisationId")] public int? IssueOrganisationId { get; set; }
    [SupplyParameterFromQuery(Name = "jobTypeId")] public int? RequestedJobTypeId { get; set; }
    [SupplyParameterFromQuery(Name = "requestTypeId")] public int? RequestedRequestTypeId { get; set; }
    private string? loadedAlert;
    private LeaveFlowSettingsData? data;
    private LeaveFlowConfigurationDto? model;
    private int jobType, requestType, level;
    private bool loading = true, busy;
    private string? message;
    protected override Task OnInitializedAsync() => ReloadAsync();
    protected override async Task OnParametersSetAsync()
    {
        if (data == null || !IssueOrganisationId.HasValue) return;
        var key = $"{IssueOrganisationId}:{RequestedJobTypeId}:{RequestedRequestTypeId}";
        if (loadedAlert == key) return;
        loadedAlert = key;
        try
        {
            if (await UserAccess.GetCurrentOrganisationIdAsync() != IssueOrganisationId)
            {
                model = null;
                message = "This alert concerns another organisation. Open that organisation's approved admin context before reviewing its approval flow.";
                return;
            }
            if (data.JobTypes.Any(x => x.Id == RequestedJobTypeId) && data.RequestTypes.Any(x => x.Id == RequestedRequestTypeId))
            {
                jobType = RequestedJobTypeId!.Value;
                requestType = RequestedRequestTypeId!.Value;
                await LoadFlowAsync();
            }
        }
        catch (Exception ex) { Handle(ex); }
    }
    private async Task ReloadAsync()
    {
        loading = true;
        message = null;
        try { data = await Configuration.LoadAsync(); }
        catch (Exception ex) { Handle(ex); }
        finally { loading = false; }
    }
    private async Task LoadFlowAsync()
    {
        model = null;
        message = null;
        if (jobType <= 0 || requestType <= 0) return;
        busy = true;
        try { model = await Configuration.GetAsync(jobType, requestType); level = model.Stages!.Count; }
        catch (Exception ex) { Handle(ex); }
        finally { busy = false; }
    }
    private async Task RequestTypeChangedAsync()
    {
        await LoadFlowAsync();
    }
    private async Task SaveAsync()
    {
        if (model == null || busy) return;
        busy = true;
        try { var result = await Configuration.SaveAsync(model); message = result.Message; }
        catch (Exception ex) { Handle(ex); }
        finally { busy = false; }
    }
    private void ResizeStages()
    {
        if (model == null || data == null) return;
        var stages = model.Stages!;
        while (stages.Count > level) stages.RemoveAt(stages.Count - 1);
        while (stages.Count < level)
        {
            var state = data.States.FirstOrDefault(x => stages.All(s => s.StateId != x.Id));
            stages.Add(new() { Name = $"Approval stage {stages.Count + 1}", StateId = state?.Id ?? 0 });
        }
    }
    private void AddStage()
    {
        if (level >= 20) return;
        level++;
        ResizeStages();
    }
    private void RemoveStage(int index)
    {
        model!.Stages!.RemoveAt(index);
        level = model.Stages.Count;
    }
    private void MoveStage(int index, int direction)
    {
        var stages = model!.Stages!;
        var target = index + direction;
        if (target < 0 || target >= stages.Count) return;
        (stages[index], stages[target]) = (stages[target], stages[index]);
    }
    private void Handle(Exception ex)
    {
        Logger.LogError(ex, "Leave flow configuration failed.");
        message = ex is UnauthorizedAccessException ? ex.Message : "Configuration could not be loaded or saved. Please try again.";
    }
}
