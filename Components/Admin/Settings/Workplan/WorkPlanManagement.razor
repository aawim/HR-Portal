    private void ClearFilters()
    {
        searchText = string.Empty;
        filterFromDate = DateTime.Today.AddDays(-7);
        filterToDate = DateTime.Today.AddDays(30);
    }

    private static string GetDurationText(
        WorkPlanSegmentDto segment)
    {
        var duration =
            segment.EndDateTime -
            segment.StartDateTime;

        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        }

        return $"{Math.Max(0, duration.Minutes)}m";
    }

    private static string GetStatusText(
        WorkPlanDto plan)
    {
        if (plan.IsFinalized)
            return "Finalized";

        if (plan.IsGenerated)
            return "Generated";

        return "Draft";
    }

    private static string GetStatusClass(
        WorkPlanDto plan)
    {
        if (plan.IsFinalized)
        {
            return "rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700";
        }

        if (plan.IsGenerated)
        {
            return "rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700";
        }

        return "rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600";
    }
