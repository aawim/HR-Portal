@page "/admin/work-planning/plans"

@using HRM.DTOs.WorkPlanning
@using HRM.Enum
@using HRM.WorkPlanning.Abstractions
@using HRM.Components.Admin.Settings.Workplan.Components.Plan

@inject IWorkPlanService WorkPlanService

<div class="min-h-screen bg-slate-50">

    <WorkPlanPageHeader OnCreateClicked="OpenCreatePanel" />

    <div class="p-6">

        <WorkPlanFilters SearchText="@searchText"
                         SearchTextChanged="OnSearchTextChanged"
                         FromDate="@filterFromDate"
                         FromDateChanged="OnFromDateChanged"
                         ToDate="@filterToDate"
                         ToDateChanged="OnToDateChanged"
                         OnSearch="LoadPlansAsync"
                         OnClear="ClearFilters" />

        <WorkPlanList Plans="@FilteredPlans"
                      IsLoading="@isLoading"
                      OnPlanSelected="OpenDetailsPanelAsync" />

    </div>
</div>

<WorkPlanDrawer IsOpen="@showPlanPanel"
                IsLoading="@isLoadingPlan"
                IsSaving="@isSaving"
                Model="@planEditModel"
                SelectedPlan="@selectedPlan"
                Templates="@templates"
                PlanningProviders="@planningProviders"
                Segments="@planSegments"
                EmployeeDisplayName="@employeeSearchText"
                OnClose="ClosePlanPanel"
                OnGenerate="GeneratePlanAsync"
                OnViewSegments="OpenSegmentPanel"
                OnEmployeeSelected="SelectEmployee" />

@* <WorkPlanSegmentsDrawer IsOpen="@showSegmentPanel"
                        IsLoading="@isLoadingSegments"
                        IsPreviewMode="@isPreviewMode"
                        Segments="@DisplayedSegments"
                        TemplateName="@selectedPlan?.WorkTemplateName"
                        IsSaving="@isSaving"
                        OnClose="CloseSegmentPanel"
                        OnGenerate="GeneratePlanAsync" /> *@


<WorkPlanSegmentsDrawer IsOpen="@showSegmentPanel"
                        IsLoading="@isLoadingSegments"
                        IsPreviewMode="@isPreviewMode"
                        IsSaving="@isSaving"
                        Segments="@DisplayedSegments"
                        TemplateName="@selectedPlan?.WorkTemplateName"
                        OnClose="@(() => CloseSegmentPanel())"
                        OnGenerate="@(async () => await GeneratePlanAsync())" />



@code {
    private List<WorkPlanListDto> plans = [];
    private List<WorkTemplateLookupDto> templates = [];
    private List<PlanningProviderLookupDto> planningProviders = [];
    private List<WorkPlanSegmentDto> planSegments = [];
    private List<WorkPlanSegmentDto> previewSegments = [];

    private GenerateWorkPlanDto planEditModel = CreateEmptyModel();
    private WorkPlanListDto? selectedPlan;

    private string searchText = string.Empty;
    private string employeeSearchText = string.Empty;

    private DateTime filterFromDate = DateTime.Today.AddDays(-7);
    private DateTime filterToDate = DateTime.Today.AddDays(30);

    private bool isLoading;
    private bool isLoadingPlan;
    private bool isLoadingSegments;
    private bool isSaving;

    private bool showPlanPanel;
    private bool showSegmentPanel;
    private bool isPreviewMode;

    private IEnumerable<WorkPlanListDto> FilteredPlans
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
                return plans;

            return plans.Where(plan =>
                ContainsIgnoreCase(
                    plan.IndividualName,
                    searchText) ||
                ContainsIgnoreCase(
                    plan.WorkTemplateName,
                    searchText));
        }
    }

    private IEnumerable<WorkPlanSegmentDto> DisplayedSegments =>
        isPreviewMode
            ? previewSegments
            : planSegments;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadTemplatesAsync(),
            LoadPlanningProvidersAsync());

        await LoadPlansAsync();
    }

    private void CloseSegmentPanel()
    {
        showSegmentPanel = false;
        isPreviewMode = false;
    }

    private async Task GeneratePlanAsync()
    {
        try
        {
            isSaving = true;

            var result =
                await WorkPlanService.GenerateWorkPlanAsync(
                    planEditModel);

            if (!result.Success)
                return;

            showSegmentPanel = false;
            showPlanPanel = false;

            await LoadPlansAsync();
        }
        finally
        {
            isSaving = false;
        }
    }




    private async Task LoadPlansAsync()
    {
        try
        {
            isLoading = true;

            plans = await WorkPlanService.GetWorkPlansAsync(
                filterFromDate,
                filterToDate);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTemplatesAsync()
    {
        templates =
            await WorkPlanService.GetActiveTemplatesAsync();
    }

    private async Task LoadPlanningProvidersAsync()
    {
        planningProviders =
            await WorkPlanService.GetPlanningProvidersAsync();
    }

    private void OpenCreatePanel()
    {
        selectedPlan = null;

        planSegments = [];
        previewSegments = [];

        employeeSearchText = string.Empty;
        planEditModel = CreateEmptyModel();

        showPlanPanel = true;
    }

    private async Task OpenDetailsPanelAsync(int workPlanId)
    {
        try
        {
            showPlanPanel = true;
            isLoadingPlan = true;

            selectedPlan =
                await WorkPlanService.GetWorkPlanDetailAsync(workPlanId);

            if (selectedPlan == null)
            {
                ClosePlanPanel();
                return;
            }

            planEditModel = MapToEditModel(selectedPlan);

            employeeSearchText =
                selectedPlan.IndividualName;

            planSegments =
                selectedPlan.Segments ?? [];
        }
        finally
        {
            isLoadingPlan = false;
        }
    }

 

    private void SelectEmployee(WorkPlanEmployeeDto employee)
    {
        planEditModel.IndividualId =
            employee.IndividualId;

        planEditModel.JobId =
            employee.JobId;

        planEditModel.OrganisationBusinessEntityId =
            employee.OrganisationId;

        employeeSearchText =
            employee.Name;
    }

    private void OpenSegmentPanel()
    {
        isPreviewMode = false;
        showSegmentPanel = true;
    }

    // private void CloseSegmentPanel()
    // {
    //     showSegmentPanel = false;
    //     isPreviewMode = false;
    // }

    private void ClosePlanPanel()
    {
        if (showSegmentPanel)
            return;

        showPlanPanel = false;
        selectedPlan = null;
    }

    private async Task ClearFilters()
    {
        searchText = string.Empty;
        filterFromDate = DateTime.Today.AddDays(-7);
        filterToDate = DateTime.Today.AddDays(30);

        await LoadPlansAsync();
    }

    private Task OnSearchTextChanged(string value)
    {
        searchText = value;
        return Task.CompletedTask;
    }

    private Task OnFromDateChanged(DateTime value)
    {
        filterFromDate = value;
        return Task.CompletedTask;
    }

    private Task OnToDateChanged(DateTime value)
    {
        filterToDate = value;
        return Task.CompletedTask;
    }

    private static GenerateWorkPlanDto CreateEmptyModel()
    {
        return new GenerateWorkPlanDto
            {
                WorkDate = DateTime.Today,
                WorkPlanGenerationSource =
                    WorkPlanGenerationSource.Template
            };
    }

    private static GenerateWorkPlanDto MapToEditModel(
        WorkPlanListDto plan)
    {
        return new GenerateWorkPlanDto
            {
                WorkPlanId = (int)plan.WorkPlanId,
                IndividualId = plan.IndividualId,
                JobId = plan.JobId,

                OrganisationBusinessEntityId =
                    plan.OrganisationBusinessEntityId,

                WorkTemplateId =
                    plan.WorkTemplateId ?? 0,

                PlanningProviderId =
                    plan.PlanningProviderId,

                WorkDate =
                    plan.WorkDate,

                WorkPlanGenerationSource =
                    plan.GenerationSource,

                Remarks =
                    plan.Remarks
            };
    }

    private static bool ContainsIgnoreCase(
        string? value,
        string searchValue)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               value.Contains(
                   searchValue,
                   StringComparison.OrdinalIgnoreCase);
    }
}