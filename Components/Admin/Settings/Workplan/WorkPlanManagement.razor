    private void OpenCreatePanel()
    {
        selectedPlan = null;
        planSegments = [];
        previewSegments = [];

        employeeSearchText = string.Empty;
        

        planEditModel = CreateEmptyModel();

        showPlanPanel = true;
    }

    private async Task OpenDetailsPanelAsync(int workPlanId)
    {
        try
        {
            showPlanPanel = true;
            isLoadingPlan = true;

            selectedPlan =
                await WorkPlanService.GetWorkPlanAsync(workPlanId);

            if (selectedPlan == null)
            {
                ClosePlanPanel();
                return;
            }

            planEditModel = new GenerateWorkPlanDto
                {
                    WorkPlanId = (int)selectedPlan.WorkPlanId,
                    IndividualId = selectedPlan.IndividualId,
                    JobId = selectedPlan.JobId,

                    OrganisationBusinessEntityId =
                        selectedPlan.OrganisationBusinessEntityId,

                    WorkTemplateId =
                        selectedPlan.WorkTemplateId ?? 0,

                    WorkDate =
                        selectedPlan.WorkDate,

                    WorkPlanGenerationSource = selectedPlan.GenerationSource,

                    Remarks =
                        selectedPlan.Remarks
                };

            employeeSearchText =
                selectedPlan.IndividualName;

            planSegments =
                selectedPlan.Segments ?? [];
        }
        finally
        {
            isLoadingPlan = false;
        }
    }

