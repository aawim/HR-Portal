    private async Task GeneratePlanAsync()
    {
        try
        {
            isSaving = true;

            var result =
                await WorkPlanService.GenerateWorkPlanAsync(
                    planEditModel);

            if (!result.Success)
            {
                return;
            }

            showSegmentPanel = false;
            showPlanPanel = false;

            await LoadPlansAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task FinalizePlanAsync()
    {
        if (selectedPlan == null)
            return;

        try
        {
            isSaving = true;

            // await WorkPlanService.FinalizeWorkPlanAsync(selectedPlan.WorkPlanId);

            await OpenDetailsPanelAsync((int)selectedPlan.WorkPlanId);

            await LoadPlansAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OnEmployeeSearchChanged(ChangeEventArgs args)
    {
        employeeSearchText =
          args.Value?.ToString()?.Trim() ??
          string.Empty;

        // selectedEmployeePosition = string.Empty;

        planEditModel.IndividualId = 0;
        planEditModel.JobId = 0;
        planEditModel.OrganisationBusinessEntityId = 0;

        if (employeeSearchText.Length < 2)
        {
            employeeResults = [];
            showEmployeeResults = false;
            return;
        }

        employeeResults =
            await WorkPlanService.SearchEmployeesAsync(
                employeeSearchText);

        showEmployeeResults =
            employeeResults.Count > 0;
    }


    private void SelectEmployee(WorkPlanEmployeeDto employee)
    {
        planEditModel.IndividualId = employee.IndividualId;
        planEditModel.JobId = employee.JobId;

        planEditModel.OrganisationBusinessEntityId =
            employee.OrganisationId;

        employeeSearchText = employee.Name;

        showEmployeeResults = false;
    }

