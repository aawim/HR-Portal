@page "/admin/work-planning/plans"

@using Microsoft.AspNetCore.Components.Forms
@using HRM.DTOs.WorkPlanning
@using HRM.WorkPlanning.Abstractions
@using HRM.Enum

@inject IWorkPlanService WorkPlanService
@* @inject IWorkTemplateService WorkTemplateService *@
@inject NavigationManager NavigationManager

<div class="min-h-screen bg-slate-50">

    <!-- Page header -->
    <div class="border-b border-slate-200 bg-white px-6 py-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

            <div>
                <h1 class="text-xl font-semibold text-slate-900">
                    Work Plans
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Generate and manage employee work plans.
                </p>
            </div>

            <button type="button"
                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-800"
                    @onclick="OpenCreatePanel">

                <span class="text-lg leading-none">+</span>
                New Work Plan
            </button>

        </div>
    </div>

    <div class="p-6">

        <!-- Filters -->
        <div class="mb-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

            <div class="grid grid-cols-1 gap-4 md:grid-cols-4">

                <div class="md:col-span-2">
                    <label class="mb-1.5 block text-sm font-medium text-slate-700">
                        Search
                    </label>

                    <input type="text"
                           class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                           placeholder="Search employee or template..."
                           @bind="searchText"
                           @bind:event="oninput" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-700">
                        From date
                    </label>

                    <InputDate @bind-Value="filterFromDate"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-700">
                        To date
                    </label>

                    <InputDate @bind-Value="filterToDate"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200" />
                </div>

            </div>

            <div class="mt-4 flex justify-end gap-2">

                <button type="button"
                        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                        @onclick="ClearFilters">
                    Clear
                </button>

                <button type="button"
                        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
                        @onclick="LoadPlansAsync">
                    Search
                </button>

            </div>
        </div>

        <!-- Work plan list -->
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

            @if (isLoading)
            {
                <div class="flex min-h-64 items-center justify-center p-8 text-sm text-slate-500">
                    Loading work plans...
                </div>
            }
            else if (!FilteredPlans.Any())
            {
                <div class="flex min-h-64 flex-col items-center justify-center p-8 text-center">

                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-500">
                        📅
                    </div>

                    <h3 class="font-medium text-slate-900">
                        No work plans found
                    </h3>

                    <p class="mt-1 max-w-sm text-sm text-slate-500">
                        Generate a work plan by selecting an employee, template and work date.
                    </p>

                </div>
            }
            else
            {
                <div class="divide-y divide-slate-200">

                    @foreach (var plan in FilteredPlans)
                    {
                        <button type="button"
                                class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition hover:bg-slate-50"
                                @onclick="() => OpenDetailsPanelAsync((int)plan.WorkPlanId)">

                            <div class="min-w-0">

                                <div class="flex flex-wrap items-center gap-2">

                                    <p class="truncate font-medium text-slate-900">
                                        @plan.IndividualName
                                    </p>

                                    <span class="@GetStatusClass(plan)">
                                        @GetStatusText(plan)
                                    </span>

                                    @if (plan.IsManual)
                                    {
                                        <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                                            Manual
                                        </span>
                                    }
                                </div>

                                <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-500">

                                    <span>
                                        @plan.WorkDate.ToString("dd MMM yyyy")
                                    </span>

                                    <span>
                                        @plan.WorkTemplateName
                                    </span>

                                    <span>
                                        Version @plan.Version
                                    </span>

                                </div>
                            </div>

                            <div class="flex shrink-0 items-center gap-3">

                                <div class="hidden text-right sm:block">
                                    <p class="text-sm font-medium text-slate-700">
                                        @plan.GenerationSource
                                    </p>

                                    <p class="text-xs text-slate-400">
                                        Plan #@plan.WorkPlanId
                                    </p>
                                </div>

                                <span class="text-xl text-slate-400">
                                    ›
                                </span>

                            </div>
                        </button>
                    }

                </div>
            }

        </div>


        @if (showPlanPanel)
        {
            <div class="fixed inset-0 z-40 bg-slate-900/30"
                 @onclick="ClosePlanPanel">
            </div>

            <aside class="fixed inset-y-0 right-0 z-50 flex w-full max-w-2xl flex-col bg-white shadow-2xl">

                <!-- Drawer header -->
                <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">

                    <div>
                        <h2 class="text-lg font-semibold text-slate-900">
                            @(planEditModel.WorkPlanId == 0
                                ? "Generate Work Plan"
                                : "Work Plan Details")
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            @(planEditModel.WorkPlanId == 0
                                ? "Select the employee, template and work date."
                                : $"Plan #{planEditModel.WorkPlanId}")
                        </p>
                    </div>

                    <button type="button"
                            class="flex h-9 w-9 items-center justify-center rounded-lg text-xl text-slate-500 hover:bg-slate-100"
                            @onclick="ClosePlanPanel">
                        ×
                    </button>

                </div>

                <!-- Drawer content -->
                <div class="flex-1 overflow-y-auto p-6">

                    @if (isLoadingPlan)
                    {
                        <div class="flex min-h-64 items-center justify-center text-sm text-slate-500">
                            Loading work plan...
                        </div>
                    }
                    else
                    {
                        <EditForm Model="planEditModel"
                                  OnValidSubmit="GeneratePlanAsync">

                            <DataAnnotationsValidator />
                            <ValidationSummary class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" />

                            <div class="space-y-6">

                                <!-- Basic details -->
                                <section>
                                    <div class="mb-4">
                                        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">
                                            Plan details
                                        </h3>

                                        <p class="mt-1 text-sm text-slate-500">
                                            Define who the plan applies to and which template should be used.
                                        </p>
                                    </div>

                                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                                        <div class="sm:col-span-2">
                                            <label class="mb-1.5 block text-sm font-medium text-slate-700">
                                                Employee
                                            </label>

                                            <div class="relative">

                                                <input type="text"
                                                       class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                                                       placeholder="Search employee..."
                                                       value="@employeeSearchText"
                                                       @oninput="OnEmployeeSearchChanged"
                                                       disabled="@IsExistingPlan" />

                                                @if (showEmployeeResults)
                                                {
                                                    <div class="absolute z-20 mt-1 max-h-64 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg">

                                                        @foreach (var employee in employeeResults)
                                                        {
                                                            <button type="button"
                                                                    class="block w-full border-b border-slate-100 px-4 py-3 text-left hover:bg-slate-50"
                                                                    @onclick="() => SelectEmployee(employee)">

                                                                <p class="font-medium text-slate-900">
                                                                    @employee.Name
                                                                </p>

                                                                <p class="mt-0.5 text-xs text-slate-500">
                                                                    @employee.Description
                                                                </p>

                                                            </button>
                                                        }

                                                    </div>
                                                }
                                            </div>

                                            <ValidationMessage For="@(() => planEditModel.IndividualId)"
                                                               class="mt-1 text-xs text-red-600" />
                                        </div>

                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-slate-700">
                                                Planning provider
                                            </label>

                                            <InputSelect @bind-Value="planEditModel.PlanningProviderId"
                                                         disabled="@IsExistingPlan"
                                                         class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200">

                                                <option value="">Select planning provider</option>

                                                @foreach (var provider in planningProviders)
                                                {
                                                    <option value="@provider.PlanningProviderId">
                                                        @provider.Name
                                                    </option>
                                                }

                                            </InputSelect>

                                            <ValidationMessage For="@(() => planEditModel.PlanningProviderId)"
                                                               class="mt-1 text-xs text-red-600" />
                                        </div>

                                        <div>

                                           <label class="mb-1.5 block text-sm font-medium text-slate-700">
                                                Work template
                                            </label>

                                            <InputSelect @bind-Value="planEditModel.WorkTemplateId"
                                                         disabled="@IsExistingPlan"
                                                         class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200">

                                                <option value="0">Select template</option>

                                                @foreach (var template in templates)
                                                {
                                                    <option value="@template.WorkTemplateId">
                                                        @template.Name
                                                    </option>
                                                }

                                            </InputSelect>

                                            <ValidationMessage For="@(() => planEditModel.WorkTemplateId)"
                                                               class="mt-1 text-xs text-red-600" />
                                        </div>

                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-slate-700">
                                                Work date
                                            </label>

                                            <InputDate @bind-Value="planEditModel.WorkDate"
                                                       disabled="@IsExistingPlan"
                                                       class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200" />
                                        </div>

                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-slate-700">
                                                Generation source
                                            </label>

                                            <InputSelect @bind-Value="planEditModel.WorkPlanGenerationSource"
                                                         disabled="@IsExistingPlan"
                                                         class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200">

                                                <option value="@WorkPlanGenerationSource.Template">
                                                    Template
                                                </option>

                                                <option value="@WorkPlanGenerationSource.Manual">
                                                    Manual
                                                </option>

                                            </InputSelect>
                                        </div>

                                        <div class="sm:col-span-2">
                                            <label class="mb-1.5 block text-sm font-medium text-slate-700">
                                                Remarks
                                            </label>

                                            <InputTextArea @bind-Value="planEditModel.Remarks"
                                                           rows="3"
                                                           disabled="@(IsExistingPlan && selectedPlan?.IsFinalized == true)"
                                                           class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                                                           placeholder="Optional remarks..." />
                                        </div>

                                    </div>
                                </section>

                                @if (IsExistingPlan)
                                {
                                    <!-- Status -->
                                    <section class="border-t border-slate-200 pt-6">

                                        <div class="mb-4 flex items-center justify-between">

                                            <div>
                                                <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">
                                                    Plan status
                                                </h3>

                                                <p class="mt-1 text-sm text-slate-500">
                                                    Generation and finalization information.
                                                </p>
                                            </div>

                                            @if (selectedPlan != null)
                                            {
                                                <span class="@GetStatusClass(selectedPlan)">
                                                    @GetStatusText(selectedPlan)
                                                </span>
                                            }

                                        </div>

                                        <div class="grid grid-cols-2 gap-4 rounded-xl bg-slate-50 p-4 text-sm">

                                            <div>
                                                <p class="text-slate-500">Version</p>
                                                <p class="mt-1 font-medium text-slate-900">
                                                    @selectedPlan?.Version
                                                </p>
                                            </div>

                                            <div>
                                                <p class="text-slate-500">Generated</p>
                                                <p class="mt-1 font-medium text-slate-900">
                                                    @(selectedPlan?.GeneratedDate?.ToString("dd MMM yyyy HH:mm") ?? "Not generated")
                                                </p>
                                            </div>

                                            <div>
                                                <p class="text-slate-500">Source</p>
                                                <p class="mt-1 font-medium text-slate-900">
                                                    @selectedPlan?.GenerationSource
                                                </p>
                                            </div>

                                            <div>
                                                <p class="text-slate-500">Finalized</p>
                                                <p class="mt-1 font-medium text-slate-900">
                                                    @(selectedPlan?.IsFinalized == true ? "Yes" : "No")
                                                </p>
                                            </div>

                                        </div>
                                    </section>

                                    <!-- Generated segments -->
                                    <section class="border-t border-slate-200 pt-6">

                                        <div class="mb-4 flex items-center justify-between">

                                            <div>
                                                <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">
                                                    Plan segments
                                                </h3>

                                                <p class="mt-1 text-sm text-slate-500">
                                                    Actual dated segments generated from the template.
                                                </p>
                                            </div>

                                            <button type="button"
                                                    class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                                                    @onclick="OpenSegmentPanel">
                                                View segments
                                            </button>

                                        </div>

                                        @if (!planSegments.Any())
                                        {
                                            <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">
                                                No plan segments were generated.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="space-y-3">

                                                @foreach (var segment in planSegments.Take(4))
                                                {
                                                    <div class="flex items-center justify-between rounded-xl border border-slate-200 p-4">

                                                        <div>
                                                            <div class="flex items-center gap-2">

                                                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
                                                                    @segment.SequenceNumber
                                                                </span>

                                                                <p class="font-medium text-slate-900">
                                                                    @segment.Name
                                                                </p>

                                                            </div>

                                                            <p class="mt-1 pl-9 text-xs text-slate-500">
                                                                @segment.WorkSegmentTypeName
                                                            </p>
                                                        </div>

                                                        <div class="text-right">
                                                            <p class="text-sm font-medium text-slate-900">
                                                                @segment.StartDateTime.ToString("HH:mm")
                                                                –
                                                                @segment.EndDateTime.ToString("HH:mm")
                                                            </p>

                                                            <p class="mt-1 text-xs text-slate-500">
                                                                @GetDurationText(segment)
                                                            </p>
                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }
                                    </section>
                                }

                            </div>



                            @if (showSegmentPanel)
{
    <div class="fixed inset-0 z-[60] bg-slate-900/20"
         @onclick="CloseSegmentPanel">
    </div>

    <aside class="fixed inset-y-0 right-0 z-[70] flex w-full max-w-lg flex-col bg-white shadow-2xl">

        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">

            <div>
                <h2 class="text-lg font-semibold text-slate-900">
                    @(isPreviewMode ? "Plan Preview" : "Plan Segments")
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    @(isPreviewMode
                        ? "Review the generated times before saving."
                        : selectedPlan?.WorkTemplateName)
                </p>
            </div>

            <button type="button"
                    class="flex h-9 w-9 items-center justify-center rounded-lg text-xl text-slate-500 hover:bg-slate-100"
                    @onclick="CloseSegmentPanel">
                ×
            </button>

        </div>

        <div class="flex-1 overflow-y-auto p-6">

            @if (isLoadingSegments)
            {
                <div class="flex min-h-64 items-center justify-center text-sm text-slate-500">
                    Loading segments...
                </div>
            }
            else if (!DisplayedSegments.Any())
            {
                <div class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500">
                    No segments available.
                </div>
            }
            else
            {
                <div class="relative space-y-4">

                    @foreach (var segment in DisplayedSegments.OrderBy(x => x.SequenceNumber))
                    {
                        <div class="relative rounded-xl border border-slate-200 bg-white p-4">

                            <div class="flex items-start justify-between gap-4">

                                <div class="flex min-w-0 items-start gap-3">

                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold text-white">
                                        @segment.SequenceNumber
                                    </div>

                                    <div class="min-w-0">

                                        <div class="flex flex-wrap items-center gap-2">

                                            <h3 class="font-medium text-slate-900">
                                                @segment.Name
                                            </h3>

                                            @if (segment.IsMandatory)
                                            {
                                                <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">
                                                    Mandatory
                                                </span>
                                            }

                                            @if (segment.IsPaid)
                                            {
                                                <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                                                    Paid
                                                </span>
                                            }

                                        </div>

                                        <p class="mt-1 text-sm text-slate-500">
                                            @segment.WorkSegmentTypeName
                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(segment.Description))
                                        {
                                            <p class="mt-2 text-sm text-slate-600">
                                                @segment.Description
                                            </p>
                                        }

                                    </div>
                                </div>

                                <div class="shrink-0 text-right">

                                    <p class="font-semibold text-slate-900">
                                        @segment.StartDateTime.ToString("HH:mm")
                                        –
                                        @segment.EndDateTime.ToString("HH:mm")
                                    </p>

                                    <p class="mt-1 text-xs text-slate-500">
                                        @segment.StartDateTime.ToString("dd MMM yyyy")
                                    </p>

                                </div>

                            </div>

                            <div class="mt-4 grid grid-cols-2 gap-3 border-t border-slate-100 pt-4 text-xs text-slate-500">

                                <span>
                                    Grace before:
                                    <strong class="text-slate-700">
                                        @segment.GraceBeforeMinutes min
                                    </strong>
                                </span>

                                <span>
                                    Grace after:
                                    <strong class="text-slate-700">
                                        @segment.GraceAfterMinutes min
                                    </strong>
                                </span>

                                <span>
                                    Attendance:
                                    <strong class="text-slate-700">
                                        @(segment.RequiresAttendance ? "Required" : "Not required")
                                    </strong>
                                </span>

                                <span>
                                    Duration:
                                    <strong class="text-slate-700">
                                        @GetDurationText(segment)
                                    </strong>
                                </span>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

        @if (isPreviewMode)
        {
            <div class="flex justify-end gap-3 border-t border-slate-200 bg-white px-6 py-4">

                <button type="button"
                        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                        @onclick="CloseSegmentPanel">
                    Back
                </button>

                <button type="button"
                        disabled="@isSaving"
                        class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800 disabled:opacity-50"
                        @onclick="GeneratePlanAsync">
                    Generate Plan
                </button>

            </div>
        }

    </aside>
}



                            <!-- Drawer footer -->
                            <div class="sticky bottom-0 mt-8 flex justify-end gap-3 border-t border-slate-200 bg-white pt-4">

                                <button type="button"
                                        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                                        @onclick="ClosePlanPanel">
                                    Cancel
                                </button>

                                @if (!IsExistingPlan)
                                {
                           @*          <button type="button"
                                            class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                                            @onclick="PreviewPlanAsync">
                                        Preview
                                    </button> *@

                                    <button type="submit"
                                            disabled="@isSaving"
                                            class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50">

                                        @(isSaving ? "Generating..." : "Generate Plan")
                                    </button>
                                }
                         

                            </div>

                        </EditForm>
                    }

                </div>
            </aside>
        }
    
    </div>
</div>

@code {
    private List<WorkPlanDto> plans = [];
    private List<WorkTemplateLookupDto> templates = [];
    private List<WorkPlanSegmentDto> planSegments = [];
    private List<WorkPlanSegmentDto> previewSegments = [];

    private List<WorkPlanEmployeeDto> employeeResults = [];
    private List<PlanningProviderLookupDto>planningProviders = [];

    private GenerateWorkPlanDto planEditModel = CreateEmptyModel();
    private WorkPlanDto? selectedPlan;

    private string searchText = string.Empty;
    private string employeeSearchText = string.Empty;

    private DateTime filterFromDate = DateTime.Today.AddDays(-7);
    private DateTime filterToDate = DateTime.Today.AddDays(30);

    private bool isLoading;
    private bool isLoadingPlan;
    private bool isLoadingSegments;
    private bool isSaving;

    private bool showPlanPanel;
    private bool showSegmentPanel;
    private bool showEmployeeResults;
    private bool isPreviewMode;

    private bool IsExistingPlan =>
        planEditModel.WorkPlanId > 0;

    private IEnumerable<WorkPlanDto> FilteredPlans =>
        string.IsNullOrWhiteSpace(searchText)
            ? plans
            : plans.Where(x =>
                x.IndividualName.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase) ||
                x.WorkTemplateName.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase));

    private IEnumerable<WorkPlanSegmentDto> DisplayedSegments =>
        isPreviewMode
            ? previewSegments
            : planSegments;

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplatesAsync();
        await LoadPlanningProvidersAsync();
        await LoadPlansAsync();
    }
    private async Task LoadPlanningProvidersAsync()
    {
        planningProviders = await WorkPlanService.GetPlanningProvidersAsync();
    }


    private static GenerateWorkPlanDto CreateEmptyModel()
    {
        return new GenerateWorkPlanDto
            {
                WorkDate = DateTime.Today,
                WorkPlanGenerationSource =
                    WorkPlanGenerationSource.Template
            };
    }

    private async Task LoadPlansAsync()
    {
        try
