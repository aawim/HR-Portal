@using HRM.DTOs.WorkPlanning

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

    <div class="border-b border-slate-200 bg-slate-900 px-5 py-4 text-white">

        <h2 class="font-semibold">
            Assignment Preview
        </h2>

        <p class="mt-1 text-sm text-slate-300">
            Review the assignment before generation.
        </p>

    </div>

    <div class="p-5">

        @if (IsLoading)
        {
            <div class="flex min-h-48 items-center justify-center">

                <div class="text-center text-slate-500">

                    <div class="mx-auto h-6 w-6 animate-spin rounded-full border-2 border-slate-300 border-t-slate-800"></div>

                    <p class="mt-3 text-sm">
                        Calculating preview...
                    </p>

                </div>

            </div>
        }
        else if (Preview is null)
        {
            <div class="flex min-h-48 items-center justify-center rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6">

                <div class="text-center">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.5"
                         stroke="currentColor"
                         class="mx-auto h-9 w-9 text-slate-400">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5V6.75A3.75 3.75 0 0010.875 3h-4.5A1.875 1.875 0 004.5 4.875v14.25A1.875 1.875 0 006.375 21h11.25a1.875 1.875 0 001.875-1.875v-4.875z" />
                    </svg>

                    <p class="mt-3 text-sm font-medium text-slate-700">
                        Preview not available
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Select an employee, date and template.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="space-y-5">

                <div>

                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                        Employee
                    </p>

                    <p class="mt-1 font-medium text-slate-900">
                        @(SelectedJob?.EmployeeName ?? "Not selected")
                    </p>

                    <p class="text-sm text-slate-500">
                        @(SelectedJob?.PositionName ?? "")
                    </p>

                </div>

                <div class="grid grid-cols-2 gap-4">

                    <div>
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                            Work date
                        </p>

                        <p class="mt-1 text-sm font-medium text-slate-900">
                            @Model.WorkDate.ToString("dd MMM yyyy")
                        </p>
                    </div>

                    <div>
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                            Template
                        </p>

                        <p class="mt-1 text-sm font-medium text-slate-900">
                            @(SelectedTemplate?.TemplateName ?? Preview.TemplateName)
                        </p>
                    </div>

                    <div>
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                            Starts
                        </p>

                        <p class="mt-1 text-sm font-medium text-slate-900">
                            @Preview.StartDateTime.ToString("dd MMM, HH:mm")
                        </p>
                    </div>

                    <div>
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                            Ends
                        </p>

                        <p class="mt-1 text-sm font-medium text-slate-900">
                            @Preview.EndDateTime.ToString("dd MMM, HH:mm")
                        </p>
                    </div>

                </div>

                <div class="border-t border-slate-200 pt-4">

                    <div class="mb-3 flex items-center justify-between">

                        <p class="text-sm font-semibold text-slate-900">
                            Segments
                        </p>

                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                            @Preview.Segments.Count
                        </span>

                    </div>

                    <div class="space-y-3">

                        @foreach (var segment in Preview.Segments
                       .OrderBy(x => x.SequenceNumber))
                        {
                            <div class="rounded-lg border border-slate-200 p-3">

                                <div class="flex items-start justify-between gap-3">

                                    <div class="min-w-0">

                                        <p class="truncate text-sm font-medium text-slate-900">
                                            @segment.SequenceNumber.
                                            @segment.Name
                                        </p>

                                        <p class="mt-1 text-xs text-slate-500">
                                            @segment.StartDateTime.ToString("HH:mm")
                                            –
                                            @segment.EndDateTime.ToString("HH:mm")
                                        </p>

                                    </div>

                                    @if (segment.IsMandatory)
                                    {
                                        <span class="shrink-0 rounded-full bg-red-50 px-2 py-1 text-[11px] font-medium text-red-600">
                                            Mandatory
                                        </span>
                                    }

                                </div>

                                <div class="mt-2 flex flex-wrap gap-2">

                                    @if (segment.RequiresAttendance)
                                    {
                                        <span class="rounded bg-blue-50 px-2 py-1 text-[11px] text-blue-600">
                                            Attendance
                                        </span>
                                    }

                                    @if (segment.RequiresLocationValidation)
                                    {
                                        <span class="rounded bg-emerald-50 px-2 py-1 text-[11px] text-emerald-600">
                                            Location
                                        </span>
                                    }

                                    @if (segment.RequiresDeviceValidation)
                                    {
                                        <span class="rounded bg-violet-50 px-2 py-1 text-[11px] text-violet-600">
                                            Device
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {
    [Parameter, EditorRequired]
    public ManualWorkAssignmentRequest Model { get; set; } =
        null!;

    [Parameter]
    public ManualAssignmentJobDto? SelectedJob { get; set; }

    [Parameter]
    public AssignedWorkTemplateDto? SelectedTemplate { get; set; }

    [Parameter]
    public WorkAssignmentPreviewDto? Preview { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }
}