@using HRM.DTOs.WorkPlanning

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

    @if (IsLoading)
    {
        <div class="flex min-h-64 items-center justify-center p-8 text-sm text-slate-500">
            Loading work plans...
        </div>
    }
    else if (!Plans.Any())
    {
        <div class="flex min-h-64 flex-col items-center justify-center p-8 text-center">

            <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-500">
                📅
            </div>

            <h3 class="font-medium text-slate-900">
                No work plans found
            </h3>

            <p class="mt-1 max-w-sm text-sm text-slate-500">
                Generate a work plan by selecting an employee,
                template and work date.
            </p>

        </div>
    }
    else
    {
        <div class="divide-y divide-slate-200">

            @foreach (var plan in Plans)
            {
                <button type="button"
                        class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition hover:bg-slate-50"
                        @onclick="() => SelectPlan(plan)">

                    <div class="min-w-0">

                        <div class="flex flex-wrap items-center gap-2">

                            <p class="truncate font-medium text-slate-900">
                                @plan.IndividualName
                            </p>

                            <WorkPlanStatusBadge Plan="@plan" />

                            @if (plan.IsManual)
                            {
                                <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                                    Manual
                                </span>
                            }

                        </div>

                        <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-500">

                            <span>
                                @plan.WorkDate.ToString("dd MMM yyyy")
                            </span>

                            <span>
                                @plan.WorkTemplateName
                            </span>

                            <span>
                                Version @plan.Version
                            </span>

                        </div>

                    </div>

                    <div class="flex shrink-0 items-center gap-3">

                        <div class="hidden text-right sm:block">

                            <p class="text-sm font-medium text-slate-700">
                                @plan.GenerationSource
                            </p>

                            <p class="text-xs text-slate-400">
                                Plan #@plan.WorkPlanId
                            </p>

                        </div>

                        <span class="text-xl text-slate-400">
                            ›
                        </span>

                    </div>

                </button>
            }

        </div>
    }

</div>

@code {
    [Parameter]
    public IEnumerable<WorkPlanListDto> Plans { get; set; } =
        Enumerable.Empty<WorkPlanListDto>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<int> OnPlanSelected { get; set; }

    private Task SelectPlan(WorkPlanListDto plan)
    {
        return OnPlanSelected.InvokeAsync(
            (int)plan.WorkPlanId);
    }
}