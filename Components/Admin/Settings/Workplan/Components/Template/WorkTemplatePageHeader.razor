<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

    <div>
        <h1 class="text-2xl font-bold text-slate-900">
            Work Templates
        </h1>

        <p class="mt-1 text-sm text-slate-500">
            Configure reusable shifts, duties and work schedules.
        </p>
    </div>

    <button type="button"
            class="inline-flex items-center justify-center gap-2
                   rounded-lg bg-blue-600 px-4 py-2 text-sm
                   font-medium text-white shadow-sm transition
                   hover:bg-blue-700"
            @onclick="HandleCreateAsync">

        <span class="text-lg leading-none">+</span>
        New Template
    </button>

</div>

@code {
    [Parameter]
    public EventCallback OnCreateClicked { get; set; }

    private Task HandleCreateAsync()
    {
        return OnCreateClicked.InvokeAsync();
    }
}