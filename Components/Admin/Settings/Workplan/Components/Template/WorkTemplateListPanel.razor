@using Microsoft.AspNetCore.Components.Forms
@using HRM.DTOs.WorkPlanning

<div class="overflow-hidden rounded-xl border border-slate-200
            bg-white shadow-sm">

    <div class="flex flex-col gap-3 border-b border-slate-100
                px-5 py-4 sm:flex-row sm:items-center
                sm:justify-between">

        <div>
            <h2 class="font-semibold text-slate-800">
                Existing Templates
            </h2>

            <p class="mt-1 text-xs text-slate-500">
                @Templates.Count template(s)
            </p>
        </div>

        <label class="flex cursor-pointer items-center gap-2">

            <InputCheckbox TValue="bool"
                           Value="@ShowInactive"
                           ValueChanged="HandleShowInactiveChanged"
                           ValueExpression="@(() => ShowInactive)"
                           class="h-4 w-4 rounded border-slate-300
                                  text-blue-600 focus:ring-blue-500" />

            <span class="text-xs text-slate-600">
                Show inactive templates
            </span>

        </label>

    </div>

    <div class="border-b border-slate-100 p-4">

        <div class="relative">

            <span class="pointer-events-none absolute inset-y-0 left-0
                         flex items-center pl-3 text-slate-400">

                <svg class="h-5 w-5"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3.5-3.5"></path>

                </svg>

            </span>

            <input type="text"
                   value="@SearchText"
                   @oninput="HandleSearchChanged"
                   class="w-full rounded-lg border border-slate-300
                          py-2 pl-10 pr-3 text-sm outline-none
                          transition focus:border-blue-500
                          focus:ring-2 focus:ring-blue-100"
                   placeholder="Search templates..." />

        </div>

    </div>

    @if (Templates.Count == 0)
    {
        <div class="flex min-h-[450px] flex-col items-center
                    justify-center px-6 text-center">

            <div class="mb-4 flex h-16 w-16 items-center
                        justify-center rounded-full bg-slate-100
                        text-3xl">
                📋
            </div>

            <p class="font-medium text-slate-700">
                No templates found
            </p>

            <p class="mt-1 max-w-sm text-sm text-slate-400">
                Create a work template or change the current filters.
            </p>

            <button type="button"
                    class="mt-5 rounded-lg bg-blue-600 px-4 py-2
                           text-sm font-medium text-white transition
                           hover:bg-blue-700"
                    @onclick="HandleCreateAsync">
                Create Template
            </button>

        </div>
    }
    else
    {
        <div class="hidden overflow-x-auto md:block">

            <table class="min-w-full divide-y divide-slate-200">

                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-5 py-3 text-left text-xs font-semibold
                                   uppercase tracking-wide text-slate-500">
                            Template
                        </th>

                        <th class="px-5 py-3 text-left text-xs font-semibold
                                   uppercase tracking-wide text-slate-500">
                            Type
                        </th>

                        <th class="px-5 py-3 text-left text-xs font-semibold
                                   uppercase tracking-wide text-slate-500">
                            Schedule
                        </th>

                        <th class="px-5 py-3 text-left text-xs font-semibold
                                   uppercase tracking-wide text-slate-500">
                            Segments
                        </th>

                        <th class="px-5 py-3 text-left text-xs font-semibold
                                   uppercase tracking-wide text-slate-500">
                            Status
                        </th>

                        <th class="px-5 py-3 text-right text-xs font-semibold
                                   uppercase tracking-wide text-slate-500">
                            Action
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 bg-white">

                    @foreach (var template in Templates)
                    {
                        <tr class="transition hover:bg-slate-50">

                            <td class="px-5 py-4">

                                <div class="flex items-start gap-3">

                                    <div class="flex h-10 w-10 shrink-0
                                                items-center justify-center
                                                rounded-lg bg-slate-100 text-xl">
                                        @GetTemplateIcon(template.TemplateType)
                                    </div>

                                    <div class="min-w-0">

                                        <button type="button"
                                                class="text-left font-semibold
                                                       text-slate-800
                                                       hover:text-blue-600"
                                                @onclick="() => SelectTemplateAsync(template)">
                                            @template.Name
                                        </button>

                                        @if (!string.IsNullOrWhiteSpace(
                                            template.Description))
                                        {
                                            <p class="mt-1 max-w-sm truncate
                                                      text-xs text-slate-500">
                                                @template.Description
                                            </p>
                                        }

                                    </div>

                                </div>

                            </td>

                            <td class="px-5 py-4 text-sm text-slate-600">
                                @GetTemplateTypeName(template.TemplateType)
                            </td>

                            <td class="px-5 py-4 text-sm text-slate-600">
                                @GetTimeDescription(template)
                            </td>

                            <td class="px-5 py-4 text-sm text-slate-600">
                                @template.SegmentCount
                            </td>

                            <td class="px-5 py-4">
                                <WorkTemplateStatusBadge IsActive="@template.IsActive" />
                            </td>

                            <td class="px-5 py-4 text-right">

                                <button type="button"
                                        class="rounded-lg border border-slate-300
                                               bg-white px-3 py-1.5 text-xs
                                               font-medium text-slate-700
                                               transition hover:border-blue-300
                                               hover:bg-blue-50
                                               hover:text-blue-700"
                                        @onclick="() => SelectTemplateAsync(template)">
                                    View / Edit
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="divide-y divide-slate-100 md:hidden">

            @foreach (var template in Templates)
            {
                <button type="button"
                        class="w-full p-4 text-left transition
                               hover:bg-slate-50"
                        @onclick="() => SelectTemplateAsync(template)">

                    <div class="flex items-start gap-3">

                        <div class="flex h-10 w-10 shrink-0
                                    items-center justify-center
                                    rounded-lg bg-slate-100 text-xl">
                            @GetTemplateIcon(template.TemplateType)
                        </div>

                        <div class="min-w-0 flex-1">

                            <div class="flex items-start justify-between gap-3">

                                <p class="font-semibold text-slate-800">
                                    @template.Name
                                </p>

                                <WorkTemplateStatusBadge
                                    IsActive="@template.IsActive" />

                            </div>

                            <p class="mt-1 text-xs text-slate-500">
                                @GetTemplateTypeName(template.TemplateType)
                            </p>

                            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1
                                        text-xs text-slate-400">

                                <span>
                                    @GetTimeDescription(template)
                                </span>

                                <span>
                                    @template.SegmentCount segment(s)
                                </span>

                            </div>

                        </div>

                    </div>

                </button>
            }

        </div>
    }

</div>

@code {
    [Parameter]
    public IReadOnlyList<WorkTemplateDto> Templates { get; set; } =
        Array.Empty<WorkTemplateDto>();

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    [Parameter]
    public bool ShowInactive { get; set; }

    [Parameter]
    public EventCallback<bool> ShowInactiveChanged { get; set; }

    [Parameter]
    public EventCallback<WorkTemplateDto> OnTemplateSelected { get; set; }

    [Parameter]
    public EventCallback OnCreateClicked { get; set; }

    private Task HandleSearchChanged(
        ChangeEventArgs args)
    {
        return SearchTextChanged.InvokeAsync(
            args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleShowInactiveChanged(
        bool value)
    {
        return ShowInactiveChanged.InvokeAsync(value);
    }

    private Task SelectTemplateAsync(
        WorkTemplateDto template)
    {
        return OnTemplateSelected.InvokeAsync(template);
    }

    private Task HandleCreateAsync()
    {
        return OnCreateClicked.InvokeAsync();
    }

    private static string GetTemplateIcon(
        string? templateType)
    {
        return templateType switch
        {
            "RegularShift" => "🕘",
            "TemporaryDuty" => "🛠️",
            "SpecialEvent" => "🚀",
            "OnCall" => "📞",
            "Training" => "🎓",
            _ => "📋"
        };
    }

    private static string GetTemplateTypeName(
        string? templateType)
    {
        return templateType switch
        {
            "RegularShift" => "Regular Shift",
            "TemporaryDuty" => "Temporary Duty",
            "SpecialEvent" => "Special Event",
            "OnCall" => "On-call Duty",
            "Training" => "Training",
            _ => templateType ?? "Other"
        };
    }

    private static string GetTimeDescription(
        WorkTemplateDto template)
    {
        if (!template.DefaultStartTime.HasValue ||
            !template.DefaultEndTime.HasValue)
        {
            return "Flexible schedule";
        }

        var start =
            template.DefaultStartTime.Value;

        var end =
            template.DefaultEndTime.Value;

        var crossesMidnight =
            end <= start;

        var text =
            $"{start:HH\\:mm} - {end:HH\\:mm}";

        return crossesMidnight
            ? $"{text} · Next day"
            : text;
    }
}