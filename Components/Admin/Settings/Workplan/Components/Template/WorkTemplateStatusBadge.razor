@if (IsActive)
{
    <span class="inline-flex rounded-full bg-green-100
                 px-2.5 py-1 text-xs font-medium text-green-700">
        Active
    </span>
}
else
{
    <span class="inline-flex rounded-full bg-red-100
                 px-2.5 py-1 text-xs font-medium text-red-700">
        Inactive
    </span>
}

@code {
    [Parameter]
    public bool IsActive { get; set; }
}