@page "/admin/settings/leave-flows"
@page "/admin/settings/leaves/approval-flows"
@page "/admin/settings/requests/approval-flows"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Navigation

@code {
    protected override void OnParametersSet()
    {
        var current = new Uri(Navigation.Uri);
        Navigation.NavigateTo($"/admin/settings/config/approval-flows{current.Query}{current.Fragment}", replace: true);
    }
}
