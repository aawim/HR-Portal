@page "/admin/settings/{CategoryName}"
@using HRM.Components.Admin.Settings.Positions
@page "/admin/settings/{CategoryName}/{Section}"
@page "/admin/settings/org/organisations/{OrganisationId:int}/{OrganisationSection}"
@page "/admin/settings/org/manage/{OrganisationId:int}/{OrganisationSection}"
@page "/admin/settings/org/teams/{TeamSection}"
@inject NavigationManager Navigation
@using HRM.Components.Admin.Settings.Roles
@using HRM.Components.Admin.Settings.Users
@using HRM.Components.Admin.Settings.Workplan
@using HRM.Components.Leave
@using HRM.Components.Leave.Policy
@using HRM.Components.Shared
@using HRM.DTOs
@using HRM.Enum
@using HRM.Models
@using HRM.Services.Interfaces
@using HRM.Services.Interfaces.Leave
@using Microsoft.AspNetCore.Components.Authorization

@inject ILeaveService LeaveService
@inject IUserAccessService UserAccess
@rendermode RenderMode.InteractiveServer

<PageTitle>Settings - HR Portal</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="max-w-12xl mx-auto py-0 px-4">
            <!-- Back Button -->
            <a href="/admin/settings" class="text-slate-400 hover:text-slate-600 text-sm mb-2 flex items-center gap-1 transition-colors w-fit">
                <svg class="w-4 h-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Back to Settings Hub
            </a>

            <!-- Main Responsive Layout: Stacks vertically on mobile, side-by-side on md+ screens -->
            <div class="flex flex-col md:flex-row gap-1 items-start">
                <!-- LEFT: Sidebar Menu (Responsive width) -->
                <div class="flex-shrink-0 flex flex-col gap-1 transition-all duration-300 ease-in-out overflow-hidden @(isSidebarExpanded ? "w-full md:w-80" : "w-20")">

                    <div class="flex items-center @(isSidebarExpanded ? "justify-between" : "justify-center") px-1 mb-3">

                        <h2 class="text-xl font-bold text-slate-800 capitalize truncate transition-opacity duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden")">
                            @ResolvedCategoryName Management
                        </h2>

                        <button @onclick="ToggleSidebar" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-blue-600 transition-colors flex-shrink-0" title="@(isSidebarExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                            <svg class="w-6 h-6 transition-transform duration-300 @(isSidebarExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="flex flex-col gap-1 mb-4">
                        @foreach (var item in VisibleItems)
                        {
                            <button @onclick="() => SelectItem(item)"
                            title="@(!isSidebarExpanded ? item.Title : null)"
                            class="text-left p-1 rounded-xl border shadow-sm transition-all duration-200 group flex items-center gap-3 overflow-hidden
                       @(activeItem?.Title == item.Title ? "bg-blue-50 border-blue-50" : "bg-white border-slate-50 hover:shadow-md hover:border-blue-50 hover:bg-slate-50")">

                                @*      <div class="w-10 h-12 flex items-center justify-center rounded-lg text-xl flex-shrink-0 transition-colors duration-300 mx-auto
                        @(activeItem?.Title == item.Title ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-600 group-hover:bg-blue-100 group-hover:text-white")">
                                @item.Icon
                            </div> *@

                                <div class="w-10 h-12 flex items-center justify-center rounded-lg text-xl flex-shrink-0 transition-colors duration-300 mx-auto
                        @(activeItem?.Title == item.Title ? "bg-blue-600 text-white" : "bg-blue-50 text-blue-600 group-hover:bg-blue-100 group-hover:text-white")">
                                    @item.Icon
                                </div>

                                <div class="flex-grow min-w-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 w-auto" : "opacity-0 w-0 hidden")">
                                    <h3 class="font-bold text-sm mb-0.5 truncate @(activeItem?.Title == item.Title ? "text-blue-800" : "text-slate-800 group-hover:text-blue-700")">
                                        @item.Title
                                    </h3>
                                    <p class="text-slate-500 text-xs leading-tight line-clamp-2">
                                        @item.Description
                                    </p>
                                </div>

                                <div class="flex-shrink-0 transition-all duration-300 @(isSidebarExpanded ? "opacity-100 block" : "opacity-0 hidden") @(activeItem?.Title == item.Title ? "text-blue-600" : "text-slate-300 group-hover:text-blue-600")">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </div>
                            </button>
                        }
                    </div>
                </div>


             


                <div class="w-full md:flex-1">
            @*         @if (CategoryName == "user")
                    {

                        <div class="flex flex-col md:flex-row  justify-start items-start md:items-center gap-4">
                            <div class="relative w-full max-w-xl">
                                <WorkspaceSearch OnSelected="SelectItem" />
                            </div>
                            <div class="w-full md:w-auto md:flex-shrink-0 l-0 ">
                                <WorkspaceTabs EntityType="WorkspaceEntityType.User"
                                               ActiveTab="ActiveTab"
                                               ActiveTabChanged="OnTabChanged" />
                            </div>
                        </div>
                    } *@


                       <!-- RIGHT: Dynamic Data Display -->


                    <div class="flex flex-col lg:flex-row gap-2 mt-1">

                        <div class="flex-1 bg-white rounded-2xl border border-slate-200 shadow-sm p-2 min-h-[600px]">

                            @if (activeItem == null)
                            {
                                <div class="h-full flex flex-col items-center justify-center text-slate-400 opacity-60 min-h-[400px]">
                                    <div class="text-6xl mb-4">👈</div>
                                    <p class="text-lg font-medium">Select an item from the menu to view data.</p>
                                </div>
                            }
                            else
                            {
                                <!-- Header for the selected data -->
                                @*     <div class="border-b border-slate-100 pb-4 mb-6 flex justify-between items-end">
                            <div>
                                <h2 class="text-xl font-bold text-slate-800">@activeItem.Title</h2>
                                <p class="text-sm text-slate-500 mt-1">@activeItem.Description</p>
                            </div>
                            </div> *@

                                <!-- Dynamic Component Rendering -->
                                <div class="mt-2">
                                    @if (activeItem.ComponentType != null)
                                    {
                                        <DynamicComponent @key="(ResolvedCategoryName, Section)" Type="@activeItem.ComponentType" Parameters="SelectedParameters" />
                                    }
                                    else
                                    {
                                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-8 text-center text-slate-500">
                                            <p>Component not yet assigned for <strong>@activeItem.Title</strong>.</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                 @*        <div class="w-full lg:w-80 bg-white rounded-2xl border border-slate-200 shadow-sm p-2">
                            <!-- Right Panel --> <p>Right</p>
                        </div> *@

                    </div>


          
 
            </div>
         </div>
      
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="p-6 text-center mt-12">
            <p class="text-slate-500 text-lg">
                Please log in to view the settings dashboard.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string CategoryName { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }
    [Parameter] public int? OrganisationId { get; set; }
    [Parameter] public string? OrganisationSection { get; set; }
    [Parameter] public string? TeamSection { get; set; }
    private string ResolvedCategoryName => OrganisationSection != null || TeamSection != null
        ? "org" : (CategoryName ?? "").Trim().ToLowerInvariant();
    [SupplyParameterFromQuery(Name = "organisationId")] public int? QueryOrganisationId { get; set; }
    private IDictionary<string, object>? SelectedParameters => activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationTeamSettings)
        ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)(OrganisationId ?? QueryOrganisationId)!, ["InitialKind"] = TeamSection == "departments" ? "Department" : "Team" }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationSettingsEditor)
            ? new Dictionary<string, object> { ["InitialOrganisationId"] = (object?)OrganisationId!, ["InitialSection"] = OrganisationSection! }
        : activeItem?.ComponentType == typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)
            ? new Dictionary<string, object> { ["Kind"] = activeItem.Title switch {
                "Manage type" => HRM.DTOs.Organisation.OrganisationResourceKind.StructureTypes,
                "Calendar" => HRM.DTOs.Organisation.OrganisationResourceKind.Calendar,
                "Locations" => HRM.DTOs.Organisation.OrganisationResourceKind.Locations,
                "Location Types" => HRM.DTOs.Organisation.OrganisationResourceKind.LocationTypes,
                "Organisation Types" => HRM.DTOs.Organisation.OrganisationResourceKind.OrganisationTypes,
                "Structure Request Types" => HRM.DTOs.Organisation.OrganisationResourceKind.StructureRequestTypes,
                _ => HRM.DTOs.Organisation.OrganisationResourceKind.Requests } } : null;
    private IEnumerable<SubItem> VisibleItems => GetSubItems(CategoryName).Where(x =>
        (x.ComponentType != typeof(RequestStateTransitionSettings) || isDeveloper) &&
        (x.ComponentType != typeof(LeaveCarryForwardSettings) || canViewCarryForward));
    private string ItemSlug(SubItem item) => item.Title switch
    {
        "Teams and supervisors" => "teams", "Organisation Permissions" => "permissions", "Manage" => "manage", "Manage type" => "types",
        "Request Approval Flows" => "approval-flows", "Leave Accrual by Job Type" => "accrual", "Leave Carry Forward" => "carry-forward",
        _ => HRM.Helpers.SectionRoutes.Slug(item.Title)
    };

    // Fixed Record: Replaced 'Url' with 'ComponentType' to match your dynamic rendering goals
    private record SubItem(string Title, string Icon, string Description, Type? ComponentType = null);

     [Parameter]
    public WorkspaceEntityType EntityType { get; set; }

 


    private SubItem? activeItem;

    private void SelectItem(SubItem item)
    {
        activeItem = item;
        Navigation.NavigateTo($"/admin/settings/{ResolvedCategoryName}/{ItemSlug(item)}");
    }
    private bool isSidebarExpanded = true;

    private void ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
    }

    private List<SubItem> GetSubItems(string? cat) => (string.IsNullOrWhiteSpace(cat) ? ResolvedCategoryName : cat.Trim().ToLowerInvariant()) switch
    {
        "leaves" => new() {
            new("Request Approval Flows", "🔄", "Configure approvals for all staff by Job Type and Request Type.", typeof(LeaveFlowSettings)),
            new("Leave Accrual by Job Type", "📅", "Configure this tenant's accrual rates, waiting periods and carry-forward for every Job Type.", typeof(LeaveAccrualSettings)),
            new("Leave Carry Forward", "📅", "HR reviews unused days and processes carry-forward at service-year renewal.", typeof(LeaveCarryForwardSettings)),
            new("Manage Leave Types", "🌴", "Define leave accruals and policies.", typeof(LeaveTypesGrid)),
            new("Manage Leave Sets", "🗓️", "Group leave types into sets.", typeof(LeaveSetsGrid)),
            new("Manage Configurable", "⚙️", "Global leave system variables.", typeof(LeaveConfigGrid)),
            new("Manage New LT", "⚙️", "Global leave system variables.", typeof(LeaveTypeManagement)),
            new("Manage Leave Policy", "⚙️", "Global leave system variables.", typeof(LeavePolicyManagement)),

        },
        "user" => new() {
            new("Manage Account", "👤", "Edit user account details and account status.", typeof(AccountGrid)),
            new("Admin Portal Access", "🔐", "Explicitly grant or revoke access to the Admin portal.", typeof(AdminPortalAccess)),
            new("Manage Permissions", "🔐", "Assign account roles and direct permissions.", typeof(AccountPermissionsGrid)),
            new("Manage Staff Enrollment Number", "🪪", "Manage organisation staff enrollment numbers.", typeof(StaffEnrollmentNumberGrid)),
            new("Manage Staff", "👥", "Manage staff records and employee numbers.", typeof(StaffGrid)),
        },
        "org" => new() {
            new("Manage", "🏢", "Manage organisation details, addresses, contacts, teams and supervisors.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationSettingsEditor)),
            new("Manage type", "🏷️", "Manage Organisation Structure Types, such as departments and divisions.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Calendar", "📅", "View and assign organisation calendars.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Locations", "📍", "View organisation locations and manage their addresses.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Location Types", "🏷️", "Manage the shared location type catalogue.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Organisation Types", "🏛️", "Manage organisation classifications.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Structure Request Types", "📥", "Manage request types used for organisation structure changes.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationResources)),
            new("Organisation Permissions", "🔐", "Manage the permissions available to this organisation.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationPermissions)),
        },
        "payroll" => new() {
            new("Manage Period", "⏳", "Configure pay cycles and deadlines.", null),
            new("Manage Item Type", "📑", "Categorize payroll income and deductions.", null)
        },
        "roles" => new() {
            new("Permissions", "🔑", "Manage permissions grouped by area, such as Leave.", typeof(RoleGrid)),
            new("Roles", "🛡️", "Manage user groups and their assigned permissions.", typeof(HRM.Components.Admin.Settings.Roles.AccessRolesGrid)),
        },
        "requests" => new() {
           new("State Transitions", "🔄", "Configure allowed From State and To State for each Request Type.", typeof(RequestStateTransitionSettings)),
           new("Request Types", "📋", "Manage request types and default approval workflows.", typeof(HRM.Components.Admin.Settings.RequestTypes.RequestTypeConfiguration)),
        },
        "jobs" => new() {
           new("Job Types", "👥", "Manage job types and staff approval workflows.", typeof(HRM.Components.Admin.Settings.JobTypes.JobTypeConfiguration)),
        },
        "config" => new() {
           new("Manage Attendance Clients", "🖥️", "Configure attendance clients and devices.", null),
        },
        "positions" => new() {
           new("Overview", "📋", "View legacy positions and their assigned staff, with a separate area for new positions.", typeof(PositionOverview)),
           new("Manage Ranks", "🏅", "Configure attendance clients and devices.", typeof(RankGrid)),
           new("Manage Classiffications", "🏷️", "Configure attendance clients and devices.", typeof(ClassifficationGrid)),
           new("Manage Positions", "💼", "Configure attendance clients and devices.", typeof(PositionGrid)),
        },
        "workplaning" => new() {
           new("Duty roster", "📅", "View dated duties and arrange staff acceptance, transfers and swaps.", typeof(HRM.Components.Pages.Online.DutyRoster)),
           new("Templates", "💼", "Define working hours and required clock events using ordered segments.", typeof(WorkTemplateManagement)),
           new("Plans", "💼", "Generate assigned schedules or add manual duty to a staff member's daily plan.", typeof(WorkPlanManagement)),
           new("Segments", "💼", "Manage check-in, work, break and check-out events within templates.", typeof(Segments)),
           new("Manual Assignments", "💼", "Configure Assignemnts.", typeof(ManualAssignment)),
        },

        _ => new() { new("General Configuration", "🔧", "System level management.", null) }
    };

    // --- Authentication and Service Logic ---
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string UserName = "User";




    private WorkspaceSearchResult? SelectedItem;

    private WorkspaceTab ActiveTab = WorkspaceTab.Overview;

    private void SelectItem(WorkspaceSearchResult item)
    {
        SelectedItem = item;
        ActiveTab = WorkspaceTab.Overview;
    }

    private void ResetWorkspace()
    {
        SelectedItem = null;
        ActiveTab = WorkspaceTab.Overview;
    }

    private void OnTabChanged(WorkspaceTab tab)
    {
        ActiveTab = tab;
    }




    // Variables for Dashboard Data
    private List<JobLeaveType>? leaveBalances;

    private List<Leaf>? leaveRequests;
    private bool isDeveloper;
    private bool canViewCarryForward;
    protected override void OnParametersSet()
    {
        CategoryName = ResolvedCategoryName;
        if (OrganisationSection != null) { CategoryName = "org"; Section = "manage"; }
        if (TeamSection != null) { CategoryName = "org"; Section = "teams"; }
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "organisations") Section = "manage";
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "requests") Section = "structure-request-types";
        if (CategoryName.Equals("org", StringComparison.OrdinalIgnoreCase) && Section == "teams")
        {
            activeItem = new SubItem("Teams and supervisors", "👥", "Assign department and team supervisors.", typeof(HRM.Components.Admin.Settings.Organisations.OrganisationTeamSettings));
            return;
        }
        activeItem = string.IsNullOrWhiteSpace(Section) ? VisibleItems.FirstOrDefault() :
            VisibleItems.FirstOrDefault(x => HRM.Helpers.SectionRoutes.Matches(Section, ItemSlug(x)));
    }

    protected override async Task OnInitializedAsync()
    {
        isDeveloper = await UserAccess.HasUserGroupAsync("Developer");
        canViewCarryForward = await UserAccess.HasPermissionAsync(HRM.Services.Leave.LeaveCarryForwardPermissions.View) &&
            (await UserAccess.HasUserGroupAsync("Human Resource: Staff") || await UserAccess.HasUserGroupAsync("Human Resource :Head"));
    }
}
