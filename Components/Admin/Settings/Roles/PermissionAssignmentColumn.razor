@using HRM.DTOs.Roles

<section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white" aria-label="@Title">
    <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-semibold text-slate-800">@Title</h3>
            <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700">@Permissions.Count</span>
        </div>
        <input type="search" @bind="search" @bind:event="oninput" aria-label="Search @Title.ToLowerInvariant()"
               placeholder="Search name, key or area…"
               class="mt-3 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100" />
    </div>
    <div class="overflow-y-auto" style="max-height: 32rem; scrollbar-gutter: stable;" tabindex="0">
        @foreach (var group in Filtered.GroupBy(x => x.Group).OrderBy(x => x.Key))
        {
            <details class="border-b border-slate-100" open="@(Assigned || group.Key == "Leave" || !string.IsNullOrWhiteSpace(search))">
                <summary class="cursor-pointer bg-slate-50/50 px-4 py-3 text-xs font-semibold text-slate-700">@group.Key <span class="ml-1 font-normal text-slate-500">(@group.Count())</span></summary>
                <div class="divide-y divide-slate-100">
                    <div class="px-4 py-2 text-right">
                        <button type="button" class="text-xs font-medium text-indigo-600 hover:text-indigo-800"
                                @onclick="() => OnMoveGroup.InvokeAsync(group.Select(x => x.Id).ToList())">@ActionLabel displayed in @group.Key</button>
                    </div>
                    @foreach (var item in group)
                    {
                        <div @key="item.Id" class="flex items-start justify-between gap-2 px-4 py-3 hover:bg-slate-50">
                            <div class="min-w-0">
                                <p class="break-words text-sm font-medium text-slate-800">@item.Name</p>
                                <p class="mt-1 break-all text-xs text-slate-500">@item.Key</p>
                                @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="mt-1 break-words text-xs text-slate-500">@item.Description</p> }
                            </div>
                            <button type="button" class="shrink-0 rounded-lg border border-slate-200 px-2 py-1 text-xs font-medium text-indigo-700 hover:bg-indigo-50"
                                    aria-label="@ActionLabel @item.Name" @onclick="() => OnMove.InvokeAsync(item.Id)">@ActionLabel</button>
                        </div>
                    }
                </div>
            </details>
        }
        @if (!Filtered.Any())
        {
            <p class="px-4 py-10 text-center text-sm text-slate-500">@(Permissions.Count == 0
                ? Assigned ? "No permissions assigned to this role." : "All permissions are assigned."
                : "No permissions match your search.")</p>
        }
    </div>
</section>

@code {
    [Parameter] public bool Assigned { get; set; }
    [Parameter] public List<PermissionDefinitionDto> Permissions { get; set; } = new();
    [Parameter] public EventCallback<int> OnMove { get; set; }
    [Parameter] public EventCallback<List<int>> OnMoveGroup { get; set; }
    private string search = "";
    private string Title => Assigned ? "Assigned permissions" : "Unassigned permissions";
    private string ActionLabel => Assigned ? "Remove" : "Add";
    private IEnumerable<PermissionDefinitionDto> Filtered => Permissions.Where(x =>
        x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Key.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        x.Group.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Description.Contains(search, StringComparison.OrdinalIgnoreCase));
}
