@using HRM.DTOs.Roles
@using HRM.Services
@inject PermissionSettingsService Settings
@inject ToastService Toast
@inject ILogger<AccessSettingsEditor> Logger

<div class="w-full">
    @if (error != null) { <p role="alert" class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">@error</p> }
    @if (loading) { <p class="rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Loading access settings…</p> }
    else if (data != null)
    {
        <fieldset disabled="@busy">
            <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
                <section class="min-w-0 xl:col-span-8">
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
                            <div class="flex items-center gap-3">
                                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"><span class="material-symbols-rounded" aria-hidden="true">@(Editing ? "edit_note" : "add_circle")</span></div>
                                <div><h2 class="text-sm font-semibold text-slate-900">@(Editing ? "Edit" : "Create") @Singular</h2>
                                    <p class="mt-0.5 text-xs text-slate-500">@(GroupsMode ? "Roles are user groups that bundle permissions." : "Permissions are individual actions, grouped by application area.")</p></div>
                            </div>
                            @if (Editing) { <button type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-600" @onclick="NewItem">Cancel editing</button> }
                        </div>
                        <div class="space-y-5 p-5">
                            @if (GroupsMode)
                            {
                                <label class="block text-xs font-bold uppercase tracking-wide text-slate-700">Role name
                                    <input class="@InputClass" maxlength="250" @bind="role.Name" placeholder="For example Leave Approver" />
                                </label>
                                <p class="text-xs text-slate-500">Add or remove permissions below, then save the role to apply your changes.</p>
                                <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                                    <PermissionAssignmentColumn @key="(role.Id, true)" Assigned="true"
                                        Permissions="data.Permissions.Where(x => role.PermissionIds.Contains(x.Id)).ToList()"
                                        OnMove="id => TogglePermission(id, false)" OnMoveGroup="ids => MovePermissions(ids, false)" />
                                    <PermissionAssignmentColumn @key="(role.Id, false)" Assigned="false"
                                        Permissions="data.Permissions.Where(x => !role.PermissionIds.Contains(x.Id)).ToList()"
                                        OnMove="id => TogglePermission(id, true)" OnMoveGroup="ids => MovePermissions(ids, true)" />
                                </div>
                                @if (role.Id > 0)
                                {
                                    <section aria-label="Assigned staff" class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                                        <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
                                            <div class="flex items-center justify-between gap-3">
                                                <h3 class="text-sm font-semibold text-slate-800">Assigned staff</h3>
                                                <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700">@role.Members.Count</span>
                                            </div>
                                            <input type="search" class="@InputClass" aria-label="Search assigned staff" placeholder="Search staff name or username…" @bind="staffSearch" @bind:event="oninput" />
                                        </div>
                                        <div class="divide-y divide-slate-100 overflow-y-auto" style="max-height: 20rem;" tabindex="0">
                                            @foreach (var member in FilteredStaff)
                                            {
                                                <div @key="member.UserId" class="flex items-center justify-between gap-3 px-4 py-3">
                                                    <div class="min-w-0"><p class="break-words text-sm font-medium text-slate-800">@member.Name</p><p class="mt-1 break-all text-xs text-slate-500">@member.Username</p></div>
                                                    <span class="shrink-0 rounded-full px-2 py-1 text-xs @(member.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(member.IsActive ? "Active" : "Inactive")</span>
                                                </div>
                                            }
                                            @if (!FilteredStaff.Any())
                                            { <p class="px-4 py-8 text-center text-sm text-slate-500">@(role.Members.Count == 0 ? "No staff are assigned to this role." : "No assigned staff match your search.")</p> }
                                        </div>
                                    </section>
                                }
                            }
                            else
                            {
                                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                                    <label class="block text-xs font-bold uppercase tracking-wide text-slate-700">Permission key
                                        <input class="@InputClass" maxlength="100" readonly="@(permission.Id != 0)" @bind="permission.Key" @bind:event="oninput" placeholder="Leave.Approve" />
                                        <span class="mt-2 block text-xs font-normal normal-case text-slate-500">@(permission.Id == 0 ? $"Area: {permission.Group}. Keys determine grouping." : "Keys stay unchanged because application access checks use them.")</span>
                                    </label>
                                    <label class="block text-xs font-bold uppercase tracking-wide text-slate-700">Permission name<input class="@InputClass" maxlength="250" @bind="permission.Name" /></label>
                                    <label class="block text-xs font-bold uppercase tracking-wide text-slate-700 md:col-span-2">Description<textarea class="@InputClass" rows="3" maxlength="1000" @bind="permission.Description"></textarea></label>
                                    <label class="block text-xs font-bold uppercase tracking-wide text-slate-700">Context<select class="@InputClass" @bind="permission.ContextId">@foreach (var item in data.Contexts) { <option value="@item.Id">@item.Name</option> }</select></label>
                                    <label class="block text-xs font-bold uppercase tracking-wide text-slate-700">Module<select class="@InputClass" @bind="permission.ModuleId"><option value="">Not assigned</option>@foreach (var item in data.Modules) { <option value="@item.Id">@item.Name</option> }</select></label>
                                </div>
                                @if (permission.IsSystem) { <p class="rounded-lg bg-violet-50 p-3 text-xs text-violet-700">System permission. Its key and existing assignments are preserved.</p> }
                            }
                        </div>
                        <div class="flex gap-3 border-t border-slate-100 bg-slate-50/50 px-5 py-4">
                            <button type="button" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600" @onclick="NewItem">Cancel</button>
                            <button type="button" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50" @onclick="SaveAsync">@(busy ? "Saving…" : $"Save {Singular.ToLowerInvariant()}")</button>
                        </div>
                    </div>
                </section>
                <aside class="min-w-0 xl:col-span-4">
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <div class="border-b border-slate-200 px-5 py-4">
                            <div class="flex items-center justify-between gap-3"><div><h2 class="text-sm font-semibold text-slate-900">@(GroupsMode ? "Roles" : "Permissions")</h2><p class="mt-0.5 text-xs text-slate-500">@(GroupsMode ? data.Roles.Count : data.Permissions.Count) configured</p></div>
                                <button type="button" class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-white hover:bg-indigo-700" aria-label="Add @Singular" title="Add @Singular" @onclick="NewItem"><span class="material-symbols-rounded" aria-hidden="true">add</span></button></div>
                            <input type="search" class="mt-4 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-100" placeholder="Search…" aria-label="Search @(GroupsMode ? "roles" : "permissions")" @bind="search" @bind:event="oninput" />
                        </div>
                        <div class="overflow-y-auto" style="max-height: 680px; scrollbar-gutter: stable;" tabindex="0" aria-label="@(GroupsMode ? "Role list" : "Grouped permission list")">
                            @if (GroupsMode)
                            {
                                @foreach (var item in data.Roles.Where(x => x.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <button type="button" class="@ItemClass(role.Id == item.Id)" @onclick="() => SelectRole(item)"><span class="block text-sm font-semibold text-slate-800">@item.Name</span><span class="mt-1 block text-xs text-slate-500">@item.PermissionIds.Count permissions · @item.MemberCount members</span></button>
                                }
                            }
                            else
                            {
                                @foreach (var group in FilteredPermissions.GroupBy(x => x.Group).OrderBy(x => x.Key))
                                {
                                    <details open="@(group.Key == "Leave" || !string.IsNullOrWhiteSpace(search))" class="border-b border-slate-100">
                                        <summary class="cursor-pointer bg-slate-50 px-5 py-3 text-sm font-semibold text-slate-700">@group.Key <span class="ml-2 rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-600">@group.Count()</span></summary>
                                        @foreach (var item in group)
                                        {
                                            <button type="button" class="@ItemClass(permission.Id == item.Id)" @onclick="() => SelectPermission(item)"><span class="block text-sm font-semibold text-slate-800">@item.Name</span><span class="mt-1 block break-all text-xs text-slate-500">@item.Key</span></button>
                                        }
                                    </details>
                                }
                                @if (!FilteredPermissions.Any()) { <p class="px-5 py-12 text-center text-sm text-slate-500">No permissions found.</p> }
                            }
                        </div>
                    </div>
                </aside>
            </div>
        </fieldset>
    }
</div>

@code {
    [Parameter] public bool GroupsMode { get; set; }
    private PermissionSettingsData? data;
    private PermissionDefinitionDto permission = new();
    private AccessRoleDto role = new();
    private bool loading, busy;
    private string? error;
    private string search = "";
    private string staffSearch = "";
    private IEnumerable<RoleStaffDto> FilteredStaff => role.Members.Where(x =>
        x.Name.Contains(staffSearch, StringComparison.OrdinalIgnoreCase) || x.Username.Contains(staffSearch, StringComparison.OrdinalIgnoreCase));
    private string Singular => GroupsMode ? "Role" : "Permission";
    private bool Editing => GroupsMode ? role.Id > 0 : permission.Id > 0;
    private const string InputClass = "mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-normal normal-case outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 read-only:bg-slate-50";
    private static string ItemClass(bool selected) => "block w-full border-l-4 px-5 py-4 text-left transition-colors " + (selected ? "border-indigo-600 bg-indigo-50" : "border-transparent hover:bg-slate-50");
    private static bool Matches(PermissionDefinitionDto p, string query) => p.Key.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Name.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Group.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Description.Contains(query, StringComparison.OrdinalIgnoreCase);
    private IEnumerable<PermissionDefinitionDto> FilteredPermissions => data?.Permissions.Where(x => Matches(x, search)) ?? Enumerable.Empty<PermissionDefinitionDto>();
    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try { data = await Settings.LoadAsync(GroupsMode); }
        catch (Exception ex) { Fail(ex); }
        finally { loading = false; }
    }
    private void NewItem() { permission = new(); role = new(); error = null; staffSearch = ""; }
    private void SelectPermission(PermissionDefinitionDto p) { error = null; permission = new() { Id = p.Id, Key = p.Key, Name = p.Name, Description = p.Description, ContextId = p.ContextId, ModuleId = p.ModuleId, IsSystem = p.IsSystem }; }
    private void SelectRole(AccessRoleDto r) { error = null; staffSearch = ""; role = new() { Id = r.Id, Name = r.Name, MemberCount = r.MemberCount, PermissionIds = r.PermissionIds.ToList(), Members = r.Members.ToList() }; }
    private void TogglePermission(int id, bool selected) { if (selected && !role.PermissionIds.Contains(id)) role.PermissionIds.Add(id); else if (!selected) role.PermissionIds.Remove(id); }
    private void MovePermissions(List<int> ids, bool selected) { foreach (var id in ids) TogglePermission(id, selected); }
    private async Task SaveAsync()
    {
        busy = true; error = null;
        try
        {
            var result = GroupsMode ? await Settings.SaveRoleAsync(role) : await Settings.SavePermissionAsync(permission);
            if (!result.Success) { error = result.Message; Toast.Error(result.Message); return; }
            Toast.Success(result.Message); data = await Settings.LoadAsync(GroupsMode);
            if (GroupsMode && data.Roles.FirstOrDefault(x => x.Id == role.Id) is { } savedRole) SelectRole(savedRole);
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }
    private void Fail(Exception ex)
    {
        Logger.LogError(ex, "Could not load or save permission settings.");
        error = ex is UnauthorizedAccessException ? ex.Message : "Access settings could not be loaded or saved. Please try again.";
        Toast.Error(error);
    }
}
