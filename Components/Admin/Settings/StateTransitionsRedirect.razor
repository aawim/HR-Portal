@page "/admin/settings/states"
@page "/admin/setting/states"
@page "/admin/settings/state-transitions"
@page "/admin/settings/requests/state-transitions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Navigation

@code {
    protected override void OnParametersSet()
    {
        var current = new Uri(Navigation.Uri);
        Navigation.NavigateTo($"/admin/settings/config/state-transitions{current.Query}{current.Fragment}", replace: true);
    }
}
