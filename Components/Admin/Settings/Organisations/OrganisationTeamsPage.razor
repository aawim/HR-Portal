@page "/admin/settings/org/team"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Teams and supervisors - Settings</PageTitle>
<div class="space-y-4 p-4">
    <a class="text-sm text-blue-700" href="/admin/settings/org">Back to organisation settings</a>
    <OrganisationTeamSettings InitialOrganisationId="OrganisationId" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "organisationId")] public int? OrganisationId { get; set; }
}
