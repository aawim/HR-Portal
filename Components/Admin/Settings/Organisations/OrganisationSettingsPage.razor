@page "/admin/settings/org"
@using Microsoft.AspNetCore.Components.Authorization
@rendermode RenderMode.InteractiveServer

<PageTitle>Organisations - Settings</PageTitle>
<AuthorizeView>
    <Authorized>
        <div class="space-y-4 px-4 py-4">
            <a href="/admin/settings" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-indigo-700"><OrganisationIcon Name="Back" />Back to System Settings</a>
            <OrganisationSettingsEditor />
        </div>
    </Authorized>
    <NotAuthorized><p class="p-6 text-sm text-slate-500">Please sign in to manage organisations.</p></NotAuthorized>
</AuthorizeView>
