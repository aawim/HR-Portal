@using HRM.DTOs.Organisation
@using HRM.Services
@using Microsoft.JSInterop
@inject HRM.Services.OrganisationSettingsService Settings
@inject ILogger<OrganisationStaffPanel> Logger
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" aria-label="Organisation staff">
    <h3 class="text-sm font-semibold text-slate-900">Organisation staff</h3>
    <p class="mt-1 text-xs text-slate-500">Staff employment records for this organisation, including past employment.</p>
    @if (error != null) { <p role="alert" class="mt-4 text-sm text-red-600">@error</p> }
    else if (rows == null) { <p class="mt-4 text-sm text-slate-500">Loading staff…</p> }
    else
    {
        <p class="mt-4 text-sm font-semibold text-indigo-700" aria-live="polite">@OrganisationStaffExport.EmployeeCount(Filtered) of @OrganisationStaffExport.EmployeeCount(rows) employees <span class="font-normal text-slate-500">· @Filtered.Count() employment records</span></p>
        <div class="my-4 flex flex-wrap items-end gap-3">
            <label class="min-w-48 flex-1 text-xs font-semibold text-slate-600">Search staff<input type="search" placeholder="Name, employee number or department…" class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-normal" @bind="search" @bind:event="oninput" /></label>
            <label class="text-xs font-semibold text-slate-600">Job type<select class="mt-2 block rounded-lg border border-slate-200 px-3 py-2 text-sm font-normal" @bind="jobType"><option value="">All job types</option>@foreach (var type in rows.Select(x => x.JobType).Distinct().OrderBy(x => x)) { <option value="@type">@type</option> }</select></label>
            <button type="button" disabled="@(exporting || !Filtered.Any())" class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 disabled:opacity-40" @onclick="() => ExportAsync(false)">Export Excel</button>
            <button type="button" disabled="@(exporting || !Filtered.Any())" class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 disabled:opacity-40" @onclick="() => ExportAsync(true)">Export PDF</button>
        </div>
        @if (exportError != null) { <p role="alert" class="my-3 text-sm text-red-600">@exportError</p> }
        <div class="max-h-[640px] overflow-auto">
            <table class="w-full text-left text-sm"><thead><tr class="border-b border-slate-200 text-slate-500"><th class="p-3">Staff</th><th class="p-3">Employee number</th><th class="p-3">Department</th><th class="p-3">Job type</th><th class="p-3">Status</th></tr></thead><tbody>
                @foreach (var row in Filtered)
                { <tr @key="row.JobId" class="border-b border-slate-100"><td class="p-3 font-medium text-slate-800">@row.Name</td><td class="p-3">@row.EmployeeNumber</td><td class="p-3">@row.Department</td><td class="p-3">@row.JobType</td><td class="p-3">@row.Status</td></tr> }
            </tbody></table>
            @if (!Filtered.Any()) { <p class="p-5 text-sm text-slate-500">No staff found.</p> }
        </div>
    }
</section>
@code {
    [Parameter] public int OrganisationId { get; set; }
    [Parameter] public string OrganisationName { get; set; } = "Organisation";
    private List<OrganisationStaffRow>? rows;
    private string search = "";
    private string jobType = "";
    private bool exporting;
    private string? exportError;
    private string? error;
    private IEnumerable<OrganisationStaffRow> Filtered => Filter(rows ?? [], search, jobType);
    private static string Normalise(string? value) => string.Join(" ", (value??"").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
    public static IEnumerable<OrganisationStaffRow> Filter(IEnumerable<OrganisationStaffRow> source, string query, string type)
    {
        var needle=Normalise(query);
        return source.Where(x=>(string.IsNullOrEmpty(type)||x.JobType==type) &&
            (Normalise(x.Name).Contains(needle,StringComparison.OrdinalIgnoreCase) || Normalise(x.EmployeeNumber).Contains(needle,StringComparison.OrdinalIgnoreCase) || Normalise(x.Department).Contains(needle,StringComparison.OrdinalIgnoreCase)));
    }
    private async Task ExportAsync(bool pdf)
    {
        if (exporting) return;
        exporting = true; exportError = null;
        var query = search; var type = jobType;
        try
        {
            var current = Filter(await Settings.GetStaffAsync(OrganisationId), query, type).ToList();
            var filters = $"Job type: {(type.Length == 0 ? "All" : type)} | Search: {(query.Length == 0 ? "All" : query)}";
            var bytes = pdf ? OrganisationStaffExport.Pdf(OrganisationName, filters, current, Path.Combine(Environment.WebRootPath, "fonts", "Faruma.ttf")) : OrganisationStaffExport.Excel(OrganisationName, filters, current);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./organisationStaffExport.js");
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await module.InvokeVoidAsync("download", $"organisation-{OrganisationId}-staff-{DateTime.Now:yyyyMMdd-HHmmss}.{(pdf ? "pdf" : "xlsx")}", pdf ? "application/pdf" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", reference);
        }
        catch (Exception ex) { Logger.LogError(ex, "Organisation staff export failed"); exportError = "Export failed. Please try again."; }
        finally { exporting = false; }
    }
    private int loadedOrganisationId;
    protected override async Task OnParametersSetAsync()
    {
        if(loadedOrganisationId==OrganisationId)return;
        var requested=OrganisationId;loadedOrganisationId=requested;rows=null;error=null;exportError=null;search="";jobType="";
        try { var result=await Settings.GetStaffAsync(requested); if(OrganisationId==requested)rows=result; }
        catch (Exception ex) { Logger.LogError(ex, "Could not load organisation staff"); error = "Staff could not be loaded. Please try again."; }
    }
}
