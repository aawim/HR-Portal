@using HRM.DTOs.Organisation
@inject HRM.Services.OrganisationResourceSettingsService Settings
@inject HRM.Services.ToastService Toasts

<section class="space-y-4">
    <header class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-xl font-semibold">@Title</h2><p class="text-sm">@Description</p></div><button class="app-button app-button-secondary" disabled="@busy" @onclick="Refresh">Refresh</button></header>
    @if (error != null) { <p role="alert" class="rounded-xl border p-3">@error</p> }
    @if (data == null && error == null) { <p role="status">Loading…</p> }
    @if (data != null)
    {
        @if (!IsCatalogue)
        {
            @if (data.IsSuperAdmin)
            {
                <label class="block text-sm">Organisation<select class="form-select mt-1" value="@data.OrganisationId" disabled="@busy" @onchange="ChangeOrganisation">@foreach (var org in data.Organisations) { <option value="@org.Id">@org.Name</option> }</select></label>
            }
            else { <p class="font-medium">@data.OrganisationName</p> }
        }
        else { <p class="rounded-xl border p-3 text-sm">Shared reference catalogue. @(data.CanEdit ? "Changes apply across organisations." : "Super Admin manages these shared type names.")</p> }
        @if (IsCatalogue && data.CanEdit)
        {
            <div class="rounded-xl border p-4 space-y-3">
                <h3 class="font-semibold">@(editId == 0 ? "Add type" : "Edit type")</h3>
                <label class="block text-sm">Type name<input class="form-control mt-1" maxlength="250" @bind="name" disabled="@busy" /></label>
                <div class="flex flex-wrap gap-3"><button class="app-button app-button-primary" disabled="@(busy || string.IsNullOrWhiteSpace(name))" @onclick="SaveType">Save type</button><button class="app-button app-button-secondary" disabled="@busy" @onclick="Reset">Clear</button></div>
            </div>
        }
        @if (Kind == OrganisationResourceKind.Calendar && data.CanEdit)
        {
            <div class="rounded-xl border p-4 space-y-3">
                <h3 class="font-semibold">Assign calendar</h3>
                <label class="block text-sm">Calendar<select class="form-select mt-1" @bind="calendarId" disabled="@busy"><option value="0">Select a calendar</option>@foreach (var c in data.Calendars) { <option value="@c.Id">@c.Name</option> }</select></label>
                <div class="grid gap-3 sm:grid-cols-2"><label class="block text-sm">Effective from<input class="form-control mt-1" type="date" @bind="from" disabled="@busy" /></label><label class="block text-sm">Effective to (optional)<input class="form-control mt-1" type="date" @bind="to" disabled="@busy" /></label></div>
                <button class="app-button app-button-primary" disabled="@(busy || calendarId == 0)" @onclick="LinkCalendar">Assign calendar</button>
            </div>
        }
        @if (Kind == OrganisationResourceKind.Locations)
        {
            <a class="app-button app-button-secondary" href="@($"/admin/settings/org/manage/{data.OrganisationId}/address")">Manage organisation addresses</a>
        }
        <div class="flex flex-wrap items-end gap-3">
            <label class="block flex-1 text-sm">Search<input class="form-control mt-1" type="search" @bind="search" @bind:event="oninput" placeholder="Search name, reference or type…" /></label>
            @if (Kind == OrganisationResourceKind.Requests)
            {
                <label class="block text-sm">Status<select class="form-select mt-1" @bind="status"><option value="">All statuses</option>@foreach (var state in data.Rows.Select(r => r.Status).Distinct().Order()) { <option value="@state">@state</option> }</select></label>
            }
            <span class="text-sm">@Filtered.Count() records</span>
        </div>
        @if (Kind == OrganisationResourceKind.Requests) { <p class="text-sm">Showing the latest 100 requests in this organisation. Open a request to use its existing approval process.</p> }
        <div class="space-y-2">
            @foreach (var row in Filtered)
            {
                <article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border p-4" @key="row.Id">
                    <div class="min-w-0"><h3 class="font-medium">@row.Name</h3>@if (row.Detail != "") { <p class="text-sm">@row.Detail</p> }@if (row.Status != "") { <p class="text-sm">@row.Status</p> }</div>
                    @if (IsCatalogue && data.CanEdit) { <button class="app-button app-button-secondary" disabled="@busy" @onclick="() => Edit(row)">Edit</button> }
                    @if (row.Url != null) { <a class="app-button app-button-secondary" href="@row.Url">View</a> }
                </article>
            }
            @if (!Filtered.Any()) { <p class="rounded-xl border p-5 text-sm">No matching records found.</p> }
        </div>
    }
</section>
@code {
    [Parameter] public OrganisationResourceKind Kind { get; set; }
    private OrganisationResourceData? data;
    private OrganisationResourceKind? loadedKind;
    private bool busy;
    private int editId, calendarId;
    private string search = "", name = "", status = "";
    private string? expectedName, error;
    private DateTime from = DateTime.UtcNow.AddHours(5).Date;
    private DateTime? to;
    private bool IsCatalogue => HRM.Services.OrganisationResourceSettingsService.IsCatalogue(Kind);
    private string Title => Kind switch { OrganisationResourceKind.StructureTypes => "Manage type", OrganisationResourceKind.Calendar => "Calendar", OrganisationResourceKind.Locations => "Locations", OrganisationResourceKind.LocationTypes => "Location Types", OrganisationResourceKind.OrganisationTypes => "Organisation Types", OrganisationResourceKind.StructureRequestTypes => "Structure Request Types", _ => "Requests" };
    private string Description => Kind switch { OrganisationResourceKind.StructureTypes => "Organisation Structure Types, such as departments and divisions.", OrganisationResourceKind.Calendar => "Calendars assigned to the organisation and their effective periods.", OrganisationResourceKind.Locations => "Organisation locations and addresses, using the existing address editor.", OrganisationResourceKind.StructureRequestTypes => "Request types used for organisation structure changes.", OrganisationResourceKind.Requests => "Review requests belonging to the selected organisation.", _ => "Manage shared reference type names." };
    private IEnumerable<OrganisationResourceRow> Filtered => data?.Rows.Where(r => (status == "" || r.Status == status) && (r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Detail.Contains(search, StringComparison.OrdinalIgnoreCase))) ?? [];
    protected override async Task OnParametersSetAsync() { if (loadedKind != Kind) { loadedKind = Kind; search = status = ""; Reset(); await Load(); } }
    private async Task Refresh() => await Load(data?.OrganisationId);
    private async Task Load(int? org = null)
    {
        error = null;
        try { data = await Settings.LoadAsync(Kind, org); }
        catch (Exception ex) { data = null; error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "Organisation information could not be loaded. Please try again."; }
    }
    private async Task ChangeOrganisation(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var id)) { search = status = ""; calendarId = 0; await Load(id); } }
    private void Edit(OrganisationResourceRow row) { editId = row.Id; name = row.Name; expectedName = row.Name; }
    private void Reset() { editId = 0; name = ""; expectedName = null; }
    private Task SaveType() => Execute(() => Settings.SaveTypeAsync(Kind, editId, name, expectedName));
    private Task LinkCalendar() => Execute(() => Settings.LinkCalendarAsync(data!.OrganisationId, calendarId, from, to));
    private async Task Execute(Func<Task<HRM.DTOs.ServiceResult>> action)
    {
        if (busy) return; busy = true; error = null;
        try { var result = await action(); if (result.Success) { Toasts.Success(result.Message); Reset(); await Load(data?.OrganisationId); } else error = result.Message; }
        catch (Exception ex) { error = ex is UnauthorizedAccessException or InvalidOperationException ? ex.Message : "The change could not be saved. Please refresh and try again."; }
        finally { busy = false; }
    }
}
