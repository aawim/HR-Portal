@using HRM.Services
@inject FormerStaffService Records
@inject ILogger<FormerStaffRecord> Logger
<section class="space-y-3 p-3">
    @if(error!=null){<p role="alert">@error</p>}
    else if(report==null){<p role="status">Loading former staff record…</p>}
    else
    {
        <h2 class="text-xl font-semibold">@report.Title</h2>
        <p class="rounded border p-3 text-sm">@FormerStaffPolicy.ReadOnlyMessage</p>
        <nav class="flex flex-wrap gap-2" aria-label="Former staff record"><button class="app-button @(attendance?"app-button-secondary":"app-button-primary")" @onclick="()=>attendance=false">Staff information</button><button class="app-button @(attendance?"app-button-primary":"app-button-secondary")" @onclick="()=>attendance=true">Attendance</button><a class="app-button app-button-secondary" href="/admin/hr/staff/former-staff">Former staff search</a></nav>
        @if(attendance){<HRM.Components.Admin.My.Workspace.Staff.Tabs.StaffAttendance StaffId="StaffId" StaffName="@report.Title" ShowOverview="false" ReadOnly="true" />}
        else
        {
            <HRM.Components.Shared.AttendanceExportButtons CreateReport="()=>report" />
            @foreach(var table in report.Tables)
            {
                <details class="rounded-lg border" open="@(table.Name=="Personal information")"><summary class="cursor-pointer p-3 text-sm font-semibold">@table.Name (@table.Rows.Count)</summary><div class="overflow-x-auto p-3"><table class="w-full text-left text-sm"><thead><tr>@foreach(var head in table.Headers){<th class="whitespace-nowrap border-b p-2">@head</th>}</tr></thead><tbody>@foreach(var row in table.Rows){<tr class="border-b">@foreach(var cell in row){<td class="max-w-md p-2">@cell</td>}</tr>}@if(table.Rows.Count==0){<tr><td colspan="@table.Headers.Length" class="p-2">No records.</td></tr>}</tbody></table></div></details>
            }
        }
    }
</section>
@code {
    [Parameter]public int StaffId {get;set;}
    private AttendanceExportReport? report;private string? error;private bool attendance;private int version;
    protected override async Task OnParametersSetAsync(){var current=++version;report=null;error=null;try{var result=await Records.DetailAsync(StaffId);if(current==version)report=result;}catch(Exception ex){if(current==version){Logger.LogError(ex,"Former staff record");error=ex is UnauthorizedAccessException or InvalidOperationException?ex.Message:"Staff information could not be loaded.";}}}
}
