@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Services
@using HRM.Services.Interfaces
@using HRM.DTOs
@using HRM.Components.Shared

 
@inject IUserContext UserContext
@inject PortalContext PortalContext

<div class="flex h-screen bg-slate-50">

    <Sidebar HasSystemAccess="@(_session?.CanAccessSystem == true)" CanAccessAdminPortal="@(_session?.CanAccessAdminPortal == true)" />

    <div class="flex flex-col flex-1 overflow-hidden">

        <Topbar HasSystemAccess="@(_session?.CanAccessSystem == true)" @rendermode="RenderMode.InteractiveServer" />

        <main class="flex-1 overflow-x-hidden overflow-y-auto p-4">

           @if (_session?.CanAccessAdminPortal == true)
            {
                @Body
            }



            else
            {
                <p role="alert">You do not have access to the Admin portal.</p>
            }

        </main>
    </div>
</div>

@code {

    private UserSessionDto? _session;
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _session = null;
        _session = await UserContext.GetSessionAsync();
        PortalContext.Initialize(_session?.OrganisationId, _session?.OrganisationName ?? "", _session?.CanAccessAdminPortal == true);
        PortalContext.SwitchToAdmin();

    }

    public class UserSession
    {
        public int UserId { get; set; }
        public int IndividualId { get; set; }
        public int JobId { get; set; }

        public int? UserOrganisationId { get; set; }
        public string OrganisationName { get; set; } = "";

        public event Action? OnChange;

        public void Notify() => OnChange?.Invoke();
    }
}
