@inherits LayoutComponentBase



@using HRM.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Services
@using HRM.Components.Shared
@using HRM.Services.Interfaces
 
@inject ToastService ToastService
@inject NavigationManager Navigation

@inject IUserContext UserContext
@inject PortalContext PortalContext
@inject AuthenticationStateProvider AuthenticationProvider
@inject IUserContextService EmployeeContext

 
<div class="app-shell flex h-screen bg-slate-50">

    <Sidebar HasSystemAccess="HasSystemAccess" CanAccessAdminPortal="CanAccessAdminPortal" />

    <div class="app-shell-content flex flex-col flex-1 overflow-hidden">

        <Topbar HasSystemAccess="HasSystemAccess" />

        <main class="app-shell-main flex-1 overflow-x-hidden overflow-y-auto p-4">
            <SettingsHistoryBack />

            @if (_checkingAccess)
            {
                <p role="status">Checking account access…</p>
            }
            else if (_isAuthenticated && !HasSystemAccess)
            {
                <section role="alert" class="rounded-lg border p-6 space-y-3">
                    <h1 class="text-lg font-semibold">HRM access is not enabled for your account.</h1>
                    <p>You have signed in successfully through eFaas. Please contact your organisation’s HR team to set up or activate your employee account and grant the appropriate access.</p>
                    <p class="text-sm">The employee menu will remain disabled until your HRM access is enabled.</p>
                    <a href="/Online/Auth/NoAccessLogout" class="underline">Sign out</a>
                </section>
            }
            else if (IsAdminPortal && _session?.CanAccessAdminPortal != true)
            {
                <p role="alert">You do not have access to the Admin portal.</p>
                <a href="/online" class="mt-3 inline-block underline">Return to employee portal</a>
            }
            else
            {
                
                @Body
            }
        </main>
    </div>
</div>

@code {

    private UserSessionDto? _session;
    private bool _checkingAccess = true;
    private bool _isAuthenticated;
    private int _accessLoadVersion;
    private bool HasSystemAccess => !_checkingAccess && _session?.CanAccessSystem == true;
    private bool CanAccessAdminPortal => HasSystemAccess && _session?.CanAccessAdminPortal == true;
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsAdminPortal =>
     new Uri(Navigation.Uri).AbsolutePath
         .Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true;


    protected override async Task OnParametersSetAsync()
    {
        var version = ++_accessLoadVersion;
        _checkingAccess = _session == null;
        var authentication = await (AuthenticationState ?? AuthenticationProvider.GetAuthenticationStateAsync());
        if (version != _accessLoadVersion) return;
        _isAuthenticated = authentication.User.Identity?.IsAuthenticated == true;
        // Register the eFaas identity as an Individual even when HRM access is not enabled.
        // This does not create a User, employment record, or permission grant.
        var session = await UserContext.GetSessionAsync();
        if (version != _accessLoadVersion) return;
        if (_isAuthenticated && session == null)
            await EmployeeContext.GetCurrentAsync();
        if (version != _accessLoadVersion) return;
        _session = session;
        PortalContext.Initialize(_session?.OrganisationId, _session?.OrganisationName ?? "", _session?.CanAccessAdminPortal == true);
        if (IsAdminPortal) PortalContext.SwitchToAdmin();
        else PortalContext.SwitchToEmployee();
        _checkingAccess = false;

    }

 
}
