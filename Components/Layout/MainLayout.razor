@inherits LayoutComponentBase



@using HRM.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using HRM.Services
@using HRM.Components.Shared
@using HRM.Services.Interfaces
 
@inject ToastService ToastService
@inject NavigationManager Navigation

@inject IUserContext UserContext
@inject PortalContext PortalContext

 
<div class="flex h-screen bg-slate-50">

    <Sidebar />

    <div class="flex flex-col flex-1 overflow-hidden">

        <Topbar @rendermode="RenderMode.InteractiveServer" />

        <main class="flex-1 overflow-x-hidden overflow-y-auto p-4">

            @if (IsAdminPortal && _session?.CanAccessAdminPortal != true)
            {
                <p role="alert">You do not have access to the Admin portal.</p>
            }
            else
            {
                
                @Body
            }
        </main>
    </div>
</div>

<ToastContainer @rendermode="RenderMode.InteractiveServer" />
@code {

    private UserSessionDto? _session;
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsAdminPortal =>
     new Uri(Navigation.Uri).AbsolutePath
         .Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true;


    protected override async Task OnParametersSetAsync()
    {
        _session = null;
        _session = await UserContext.GetSessionAsync();
        PortalContext.Initialize(_session?.OrganisationId, _session?.OrganisationName ?? "", _session?.CanAccessAdminPortal == true);
        if (IsAdminPortal) PortalContext.SwitchToAdmin();
        else PortalContext.SwitchToEmployee();

    }

 
}
