@using HRM.DTOs.Profile.ProfileAccess

<section class="w-full overflow-hidden rounded-2xl
                border border-slate-200 bg-white shadow-sm">

    <div class="flex flex-col gap-3 border-b border-slate-200
                px-4 py-4 sm:flex-row sm:items-center
                sm:justify-between sm:px-5">

        <div class="flex min-w-0 items-center gap-3">

            <div class="flex h-11 w-11 shrink-0 items-center
                        justify-center rounded-xl bg-indigo-50
                        text-indigo-600">

      @*           <span class="material-symbols-rounded">
                    admin_panel_settings
                </span> *@

            </div>

            <div class="min-w-0">

                <h2 class="text-sm font-semibold text-slate-900">
                    Access & Memberships
                </h2>

                <p class="mt-0.5 text-xs text-slate-500">
                    Teams, groups, roles, permissions and supervision.
                </p>

            </div>

        </div>

    </div>

    <div class="p-4 sm:p-5">

        <div class="grid grid-cols-1 gap-5 xl:grid-cols-2">

            <!-- Roles -->
            <div class="rounded-xl border border-slate-200 p-4 xl:col-span-2">

                <!-- Heading -->
                <div class="flex flex-col gap-3 sm:flex-row
                sm:items-center sm:justify-between">

                    <div class="flex items-center gap-2">

               @*          <span class="material-symbols-rounded
                         text-[19px] text-emerald-600">
                            shield_person
                        </span> *@

                        <div>
                            <h3 class="text-sm font-semibold text-slate-900">
                                Roles
                            </h3>

                            <p class="mt-0.5 text-xs text-slate-500">
                                Organisation roles assigned to this staff member.
                            </p>
                        </div>

                    </div>

                    <span class="inline-flex w-fit items-center
                     rounded-full bg-slate-100
                     px-2.5 py-1 text-xs font-semibold
                     text-slate-700">

                        @Access.Roles.Count roles

                    </span>

                </div>

                @if (Access.Roles.Count == 0)
                {
                    <div class="mt-4 rounded-xl border border-dashed
                    border-slate-300 bg-slate-50
                    px-4 py-8 text-center">

                   @*      <span class="material-symbols-rounded
                         text-3xl text-slate-300">
                            shield
                        </span> *@

                        <p class="mt-2 text-sm font-medium text-slate-700">
                            No active organisation roles
                        </p>

                    </div>
                }
                else
                {
                    <!-- Search -->
                    <div class="relative mt-4">

            @*             <span class="material-symbols-rounded
                         absolute left-3 top-1/2
                         -translate-y-1/2 text-[19px]
                         text-slate-400">
                            search
                        </span> *@

                        <input type="text"
                               value="@_roleSearchText"
                               @oninput="HandleRoleSearch"
                               placeholder="Search roles..."
                               class="w-full rounded-xl border
                          border-slate-200 bg-slate-50
                          py-2.5 pl-10 pr-10 text-sm
                          text-slate-800 outline-none
                          transition
                          placeholder:text-slate-400
                          focus:border-indigo-300
                          focus:bg-white
                          focus:ring-2
                          focus:ring-indigo-100" />

                        @if (!string.IsNullOrWhiteSpace(_roleSearchText))
                        {
                            <button type="button"
                                    title="Clear search"
                                    @onclick="ClearRoleSearch"
                                    class="absolute right-2.5 top-1/2
                               flex h-7 w-7
                               -translate-y-1/2 items-center
                               justify-center rounded-lg
                               text-slate-400
                               hover:bg-slate-200
                               hover:text-slate-700">

                                <span class="material-symbols-rounded
                                 text-[17px]">
                                    close
                                </span>

                            </button>
                        }

                    </div>

                    <!-- Alphabet -->
                    <div class="mt-4">

                        <div class="flex gap-2 overflow-x-auto
                        pb-2">

                            <button type="button"
                                    @onclick="() => SelectRoleLetter(null)"
                                    class="@GetRoleLetterClass(null)">

                                <span>
                                    All
                                </span>

                                <span class="@GetRoleCountClass(null)">
                                    @Access.Roles.Count
                                </span>

                            </button>

                            @foreach (var group in RoleLetterGroups)
                            {
                                <button type="button"
                                        @onclick="() =>
                                SelectRoleLetter(group.Letter)"
                                        class="@GetRoleLetterClass(group.Letter)">

                                    <span>
                                        @group.Letter
                                    </span>

                                    <span class="@GetRoleCountClass(group.Letter)">
                                        @group.Count
                                    </span>

                                </button>
                            }

                        </div>

                    </div>

                    <!-- Result information -->
                    <div class="mt-3 flex flex-wrap items-center
                    justify-between gap-2">

                        <p class="text-xs text-slate-500">

                            @if (!string.IsNullOrWhiteSpace(_roleSearchText))
                            {
                                <span>
                                    @FilteredRoles.Count result@(FilteredRoles.Count == 1 ? "" : "s")
                                    for
                                    <strong class="font-semibold text-slate-700">
                                        "@_roleSearchText"
                                    </strong>
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(_selectedRoleLetter))
                            {
                                <span>
                                    @FilteredRoles.Count role@(FilteredRoles.Count == 1 ? "" : "s")
                                    beginning with
                                    <strong class="font-semibold text-slate-700">
                                        @_selectedRoleLetter
                                    </strong>
                                </span>
                            }
                            else
                            {
                                <span>
                                    Showing all @FilteredRoles.Count organisation roles
                                </span>
                            }

                        </p>

                    </div>

                    <!-- Role list -->
                    @if (FilteredRoles.Count == 0)
                    {
                        <div class="mt-4 rounded-xl bg-slate-50
                        px-4 py-8 text-center">

                            <span class="material-symbols-rounded
                             text-3xl text-slate-300">
                                search_off
                            </span>

                            <p class="mt-2 text-sm font-medium
                          text-slate-700">
                                No matching roles
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                Try another letter or search term.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="mt-4 max-h-[420px]
                        overflow-y-auto rounded-xl
                        border border-slate-200">

                            @foreach (var role in FilteredRoles)
                            {
                                <button type="button"
                                        @onclick="() => HandleRoleClickAsync(role)"
                                        class="flex w-full items-center
                                   justify-between gap-4
                                   border-b border-slate-100
                                   px-4 py-3 text-left
                                   transition
                                   last:border-b-0
                                   hover:bg-slate-50">

                                    <div class="min-w-0 flex-1">

                                        <div class="flex flex-wrap
                                        items-center gap-2">

                                            <p class="truncate text-sm
                                          font-semibold
                                          text-slate-800">
                                                @role.RoleName
                                            </p>

                                            @if (role.IsSystemRole)
                                            {
                                                <span class="inline-flex
                                                 shrink-0
                                                 rounded-full
                                                 bg-indigo-50
                                                 px-2 py-0.5
                                                 text-[10px]
                                                 font-semibold
                                                 text-indigo-700">
                                                    System
                                                </span>
                                            }

                                        </div>

                                        <div class="mt-1 flex flex-wrap
                                        items-center gap-x-3
                                        gap-y-1">

                                            @if (!string.IsNullOrWhiteSpace(
                                           role.RoleKey))
                                            {
                                                <span class="font-mono
                                                 text-[11px]
                                                 text-slate-500">
                                                    @role.RoleKey
                                                </span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(
                                           role.Source))
                                            {
                                                <span class="inline-flex
                                                 items-center
                                                 gap-1 text-[11px]
                                                 text-slate-400">

                                                    <span class="h-1 w-1
                                                     rounded-full
                                                     bg-slate-300">
                                                    </span>

                                                    @role.Source

                                                </span>
                                            }

                                        </div>

                                    </div>

                             @*        <span class="material-symbols-rounded
                                     shrink-0 text-[18px]
                                     text-slate-300">
                                        chevron_right
                                    </span> *@

                                </button>
                            }

                        </div>
                    }
                }

            </div>

        </div>

      
    </div>

</section>

@code {
    [Parameter, EditorRequired]
    public ProfileAccessDto Access { get; set; } =
        new();

        [Parameter]
public EventCallback<ProfileRoleDto> OnViewRole { get; set; }


    private string? _selectedRoleLetter;

    private string _roleSearchText =
        string.Empty;

    private sealed class RoleLetterGroup
    {
        public string Letter { get; set; } =
            string.Empty;

        public int Count { get; set; }
    }

    private List<RoleLetterGroup> RoleLetterGroups =>
        Access.Roles
            .Where(role =>
                !string.IsNullOrWhiteSpace(role.RoleName))
            .GroupBy(role =>
                GetFirstLetter(role.RoleName))
            .Where(group =>
                !string.IsNullOrWhiteSpace(group.Key))
            .OrderBy(group =>
                group.Key)
            .Select(group =>
                new RoleLetterGroup
                    {
                        Letter =
                            group.Key,

                        Count =
                            group.Count()
                    })
            .ToList();

    private List<ProfileRoleDto> FilteredRoles
    {
        get
        {
            IEnumerable<ProfileRoleDto> query =
                Access.Roles;

            /*
            * Alphabet filter.
                 */
            if (!string.IsNullOrWhiteSpace(
                _selectedRoleLetter))
            {
                query =
                    query.Where(role =>
                        GetFirstLetter(role.RoleName) ==
                        _selectedRoleLetter);
            }

            /*
            * Search filter.
                 */
            if (!string.IsNullOrWhiteSpace(
                _roleSearchText))
            {
                var search =
                    _roleSearchText.Trim();

                query =
                    query.Where(role =>
                        role.RoleName.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                        role.RoleKey.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderBy(role =>
                    role.RoleName)
                .ThenBy(role =>
                    role.RoleId)
                .ToList();
        }
    }

    private static string GetFirstLetter(
        string? roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName))
        {
            return "#";
        }

        var trimmed =
            roleName.Trim();

        var first =
            trimmed[0];

        if (char.IsLetter(first))
        {
            return char
                .ToUpperInvariant(first)
                .ToString();
        }

        return "#";
    }

    private void SelectRoleLetter(
        string? letter)
    {
        _selectedRoleLetter =
            letter;
    }

    private void HandleRoleSearch(
        ChangeEventArgs args)
    {
        _roleSearchText =
            args.Value?.ToString() ??
            string.Empty;

        /*
        * When searching, don't restrict the user
        * to the selected alphabet group.
             */
        if (!string.IsNullOrWhiteSpace(
            _roleSearchText))
        {
            _selectedRoleLetter =
                null;
        }
    }

    private void ClearRoleSearch()
    {
        _roleSearchText =
            string.Empty;
    }

    private string GetRoleLetterClass(
        string? letter)
    {
        var selected =
            string.Equals(
                _selectedRoleLetter,
                letter,
                StringComparison.OrdinalIgnoreCase);

        if (selected)
        {
            return
                "inline-flex shrink-0 items-center gap-1.5 " +
                "rounded-lg bg-indigo-600 px-2.5 py-1.5 " +
                "text-xs font-semibold text-white transition";
        }

        return
            "inline-flex shrink-0 items-center gap-1.5 " +
            "rounded-lg border border-slate-200 bg-white " +
            "px-2.5 py-1.5 text-xs font-semibold " +
            "text-slate-600 transition " +
            "hover:border-indigo-200 hover:bg-indigo-50 " +
            "hover:text-indigo-700";
    }

    private string GetRoleCountClass(
        string? letter)
    {
        var selected =
            string.Equals(
                _selectedRoleLetter,
                letter,
                StringComparison.OrdinalIgnoreCase);

        return selected
            ? "rounded bg-white/20 px-1.5 py-0.5 text-[10px]"
            : "rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-500";
    }

    private async Task HandleRoleClickAsync(
        ProfileRoleDto role)
    {
        if (OnViewRole.HasDelegate)
        {
            await OnViewRole.InvokeAsync(
                role);
        }
    }
}