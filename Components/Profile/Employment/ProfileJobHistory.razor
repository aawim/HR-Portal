@using HRM.Components.Shared
@using HRM.DTOs.JobPosition
@using HRM.DTOs.Profile

<section class="w-full overflow-hidden rounded-2xl border
                border-slate-200 bg-white shadow-sm">

    <!-- Header -->
    <div class="flex flex-col gap-3 border-b border-slate-200
                px-4 py-4 sm:flex-row sm:items-center
                sm:justify-between sm:px-5">

        <div class="flex min-w-0 items-center gap-3">

         @*    <div class="flex h-11 w-11 shrink-0 items-center
                        justify-center rounded-xl bg-slate-100
                        text-slate-700">

                <span class="material-symbols-rounded">
                    work_history
                </span>

            </div> *@

            <div class="min-w-0">

                <h2 class="text-sm font-semibold text-slate-900">
                    Position History
                </h2>

                <p class="mt-0.5 text-xs text-slate-500">
                    Previous positions and employment changes within
                    the organisation.
                </p>

            </div>

        </div>

        @if (!IsLoading && ValidHistory.Count > 0)
        {
            <span class="inline-flex w-fit items-center gap-2
                         rounded-full bg-slate-100 px-3 py-1.5
                         text-xs font-semibold text-slate-700">

             @*    <span class="material-symbols-rounded text-[16px]">
                    history
                </span> *@

                @ValidHistory.Count
                @(ValidHistory.Count == 1 ? "record" : "records")

            </span>
        }

    </div>

    <!-- Content -->
    <div class="p-4 sm:p-5">

        @if (IsLoading)
        {
            <div class="space-y-4">

                @for (var index = 0; index < 3; index++)
                {
                    <div class="flex animate-pulse gap-4">

                        <div class="flex flex-col items-center">

                            <div class="h-10 w-10 rounded-full
                                        bg-slate-200">
                            </div>

                            @if (index < 2)
                            {
                                <div class="mt-2 h-24 w-px
                                            bg-slate-200">
                                </div>
                            }

                        </div>

                        <div class="min-w-0 flex-1 rounded-xl
                                    border border-slate-200 p-4">

                            <div class="h-4 w-44 rounded bg-slate-200">
                            </div>

                            <div class="mt-3 h-3 w-32 rounded
                                        bg-slate-100">
                            </div>

                            <div class="mt-2 h-3 w-56 rounded
                                        bg-slate-100">
                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else if (ValidHistory.Count == 0)
        {
            <div class="rounded-xl border border-dashed
                        border-slate-300 bg-slate-50
                        px-5 py-10 text-center">

        @*         <div class="mx-auto flex h-12 w-12 items-center
                            justify-center rounded-full bg-white
                            text-slate-400 shadow-sm">

                    <span class="material-symbols-rounded text-[24px]">
                        history_toggle_off
                    </span>

                </div> *@

                <p class="mt-3 text-sm font-semibold text-slate-700">
                    No position history
                </p>

                <p class="mx-auto mt-1 max-w-md text-xs
                          leading-5 text-slate-500">
                    No previous approved position records are available
                    for this staff member.
                </p>

            </div>
        }
        else
        {
            <div class="space-y-0">

                @{
                    var orderedItems =
                    OrderedHistory.ToList();
                }

                @for (var index = 0;
               index < orderedItems.Count;
               index++)
                {
                    var historyItem =
                    orderedItems[index];

                    var isLast =
                    index == orderedItems.Count - 1;

                    <div class="flex gap-3 sm:gap-4">

                        <!-- Timeline marker -->
                        <div class="flex shrink-0 flex-col items-center">

                          @*   <div class="@GetTimelineIconClass(historyItem)">

                                <span class="material-symbols-rounded
                                             text-[19px]">
                                    @GetTimelineIcon(historyItem)
                                </span>

                            </div> *@

                            @if (!isLast)
                            {
                                <div class="my-2 min-h-10 w-px flex-1
                                            bg-slate-200">
                                </div>
                            }

                        </div>

                        <!-- History card -->
                        <article class="mb-4 min-w-0 flex-1 rounded-xl
                                        border border-slate-200
                                        bg-slate-50/40 p-4 transition
                                        hover:border-slate-300
                                        hover:bg-white hover:shadow-sm">

                            <div class="flex flex-col gap-4
                                        sm:flex-row sm:items-start
                                        sm:justify-between">

                                <div class="min-w-0 flex-1">

                                    <div class="flex flex-wrap
                                                items-center gap-2">

                                        <h3 class="break-words text-sm
                                                   font-semibold
                                                   text-slate-900">
                                            @GetPositionName(historyItem)
                                        </h3>

                                        <span class="@GetStateBadgeClass(
                                            historyItem)">
                                            @GetStateName(historyItem)
                                        </span>

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                   historyItem.OrganisationName))
                                    {
                                        <p class="mt-1 text-sm
                                                  text-slate-700">
                                            @historyItem.OrganisationName
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(historyItem.OrganisationStructureName))
                                    {
                                        <p class="mt-1 text-xs
                                                  text-slate-500">
                                            @historyItem.OrganisationStructureName
                                        </p>
                                    }

                                    <div class="mt-3 flex flex-wrap
                                                gap-x-5 gap-y-2
                                                text-xs text-slate-500">

                                        <span class="inline-flex
                                                     items-center gap-1.5">

                                       @*      <span class="material-symbols-rounded
                                                         text-[16px]">
                                                calendar_month
                                            </span> *@

                                            @GetEffectivePeriod(historyItem)

                                        </span>

                                        <span class="inline-flex
                                                     items-center gap-1.5">

                                       @*      <span class="material-symbols-rounded
                                                         text-[16px]">
                                                schedule
                                            </span> *@

                                            @GetDurationText(historyItem)

                                        </span>

                                        <span class="inline-flex
                                                     items-center gap-1.5">

                                          @*   <span class="material-symbols-rounded
                                                         text-[16px]">
                                                tag
                                            </span> *@

                                            Job @historyItem.JobId

                                        </span>

                                    </div>

                                </div>

                                <button type="button"
                                        disabled="@IsDisabled"
                                        @onclick="() =>
                                            HandleViewAsync(historyItem)"
                                        class="inline-flex w-full shrink-0
                                               items-center justify-center
                                               gap-2 rounded-lg border
                                               border-slate-200 bg-white
                                               px-3 py-2 text-sm
                                               font-medium text-slate-700
                                               transition
                                               hover:bg-slate-50
                                               disabled:cursor-not-allowed
                                               disabled:opacity-50
                                               sm:w-auto">

                         @*            <span class="material-symbols-rounded
                                                 text-[17px]">
                                        visibility
                                    </span> *@

                                    View

                                </button>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }

    </div>

</section>

@code {
    [Parameter]
    public IReadOnlyList<JobPositionHistoryDto> PositionHistory { get; set; }
    = Array.Empty<JobPositionHistoryDto>();

    [Parameter]
    public int StaffId { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public EventCallback<JobPositionHistoryDto> OnView { get; set; }

    private List<JobPositionHistoryDto> ValidHistory =>
        PositionHistory
            .Where(item =>
                item.JobPositionId > 0 &&
                item.JobId > 0 &&
                item.PositionId > 0)
            .ToList();

    private IEnumerable<JobPositionHistoryDto> OrderedHistory =>
        ValidHistory
            .OrderByDescending(item =>
                item.ToDate ?? item.FromDate)
            .ThenByDescending(item =>
                item.FromDate)
            .ThenByDescending(item =>
                item.JobPositionId);

    private async Task HandleViewAsync(
        JobPositionHistoryDto historyItem)
    {
        if (IsDisabled)
        {
            return;
        }

        if (OnView.HasDelegate)
        {
            await OnView.InvokeAsync(
                historyItem);
        }
    }

    private static string GetPositionName(
        JobPositionHistoryDto historyItem)
    {
        return string.IsNullOrWhiteSpace(
            historyItem.PositionName)
            ? "Unnamed position"
            : historyItem.PositionName;
    }

    private static string GetStateName(
        JobPositionHistoryDto historyItem)
    {
        return string.IsNullOrWhiteSpace(
            historyItem.JobPositionStateName)
            ? "Unknown"
            : historyItem.JobPositionStateName;
    }

    private static string GetEffectivePeriod(
        JobPositionHistoryDto historyItem)
    {
        if (!string.IsNullOrWhiteSpace(
            historyItem.EffectivePeriodText))
        {
            return historyItem.EffectivePeriodText;
        }

        return historyItem.ToDate.HasValue
            ? $"{historyItem.FromDate:dd MMM yyyy} – " +
              $"{historyItem.ToDate.Value:dd MMM yyyy}"
            : $"{historyItem.FromDate:dd MMM yyyy} – Present";
    }

    private static string GetDurationText(
        JobPositionHistoryDto historyItem)
    {
        var start =
            historyItem.FromDate.Date;

        var end =
            (historyItem.ToDate ?? DateTime.Today).Date;

        if (end < start)
        {
            return "Invalid period";
        }

        var years =
            end.Year - start.Year;

        var months =
            end.Month - start.Month;

        if (end.Day < start.Day)
        {
            months--;
        }

        if (months < 0)
        {
            years--;
            months += 12;
        }

        if (years <= 0 &&
            months <= 0)
        {
            var days =
                Math.Max(
                    1,
                    (end - start).Days + 1);

            return days == 1
                ? "1 day"
                : $"{days} days";
        }

        var parts =
            new List<string>();

        if (years > 0)
        {
            parts.Add(
                years == 1
                    ? "1 year"
                    : $"{years} years");
        }

        if (months > 0)
        {
            parts.Add(
                months == 1
                    ? "1 month"
                    : $"{months} months");
        }

        return string.Join(
            " ",
            parts);
    }

    private static string GetTimelineIcon(
        JobPositionHistoryDto historyItem)
    {
        var state =
            GetStateName(historyItem)
                .Trim()
                .ToUpperInvariant();

        if (historyItem.JobPositionStateId ==
            SharedConfig.JobPositionStates.APPROVED)
        {
            // return historyItem.ToDate.HasValue
            //     ? "work_history"
            //     : "verified";
        }

        if (state.Contains("REJECT"))
        {
            // return "cancel";
        }

        if (state.Contains("CANCEL"))
        {
            // return "block";
        }

        if (state.Contains("PENDING") ||
            state.Contains("VERIFY"))
        {
            return "pending_actions";
        }

        if (state.Contains("REMOVE") ||
            state.Contains("TERMINAT"))
        {
            // return "person_remove";
        }

        return "history";
    }

    private static string GetTimelineIconClass(
        JobPositionHistoryDto historyItem)
    {
        const string baseClass =
            "flex h-10 w-10 shrink-0 items-center " +
            "justify-center rounded-full border ";

        var state =
            GetStateName(historyItem)
                .Trim()
                .ToUpperInvariant();

        if (historyItem.JobPositionStateId ==
            SharedConfig.JobPositionStates.APPROVED)
        {
            return baseClass +
                   "border-emerald-200 bg-emerald-50 " +
                   "text-emerald-600";
        }

        if (state.Contains("REJECT") ||
            state.Contains("CANCEL"))
        {
            return baseClass +
                   "border-red-200 bg-red-50 text-red-600";
        }

        if (state.Contains("PENDING") ||
            state.Contains("VERIFY"))
        {
            return baseClass +
                   "border-amber-200 bg-amber-50 text-amber-600";
        }

        if (state.Contains("REMOVE") ||
            state.Contains("TERMINAT"))
        {
            return baseClass +
                   "border-slate-300 bg-slate-100 text-slate-600";
        }

        return baseClass +
               "border-slate-200 bg-white text-slate-500";
    }

    private static string GetStateBadgeClass(
        JobPositionHistoryDto historyItem)
    {
        const string baseClass =
            "inline-flex shrink-0 rounded-full px-2 py-0.5 " +
            "text-[10px] font-semibold uppercase tracking-wide ";

        var state =
            GetStateName(historyItem)
                .Trim()
                .ToUpperInvariant();

        if (historyItem.JobPositionStateId ==
            SharedConfig.JobPositionStates.APPROVED)
        {
            return baseClass +
                   "bg-emerald-100 text-emerald-700";
        }

        if (state.Contains("REJECT") ||
            state.Contains("CANCEL"))
        {
            return baseClass +
                   "bg-red-100 text-red-700";
        }

        if (state.Contains("PENDING") ||
            state.Contains("VERIFY"))
        {
            return baseClass +
                   "bg-amber-100 text-amber-700";
        }

        if (state.Contains("REMOVE") ||
            state.Contains("TERMINAT"))
        {
            return baseClass +
                   "bg-slate-200 text-slate-700";
        }

        return baseClass +
               "bg-slate-100 text-slate-600";
    }
}