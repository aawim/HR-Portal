@using HRM.DTOs.Profile

<section class="w-full overflow-hidden rounded-2xl border
                border-slate-200 bg-white shadow-sm">

    <div class="flex flex-col gap-3 border-b border-slate-200
                px-5 py-4 sm:flex-row sm:items-center
                sm:justify-between">

        <div class="flex min-w-0 items-center gap-3">

            <div class="flex h-11 w-11 shrink-0 items-center
                        justify-center rounded-xl bg-indigo-50
                        text-indigo-600">

                <span class="material-symbols-rounded">
                    badge
                </span>

            </div>

            <div class="min-w-0">

                <h2 class="text-sm font-semibold text-slate-900">
                    Active Positions
                </h2>

                <p class="mt-0.5 text-xs text-slate-500">
                    Current positions assigned to this staff member.
                </p>

            </div>

        </div>

        @if (ShowAddButton)
        {
            <button type="button"
                    disabled="@IsDisabled"
                    @onclick="HandleAddAsync"
                    class="inline-flex w-full items-center justify-center
                           gap-2 rounded-xl bg-indigo-600 px-4 py-2.5
                           text-sm font-semibold text-white transition
                           hover:bg-indigo-700
                           disabled:cursor-not-allowed
                           disabled:bg-slate-300
                           sm:w-auto">

                <span class="material-symbols-rounded text-[18px]">
                    add
                </span>

                Add position

            </button>
        }

    </div>

    <div class="p-4 sm:p-5">

        @if (IsLoading)
        {
            <div class="space-y-3">

                @for (var index = 0; index < 3; index++)
                {
                    <div class="animate-pulse rounded-xl border
                                border-slate-200 p-4">

                        <div class="flex items-start gap-3">

                            <div class="h-10 w-10 rounded-lg bg-slate-200"></div>

                            <div class="flex-1">
                                <div class="h-4 w-40 rounded bg-slate-200"></div>
                                <div class="mt-3 h-3 w-28 rounded bg-slate-100"></div>
                                <div class="mt-2 h-3 w-52 rounded bg-slate-100"></div>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else if (ActivePositions.Count == 0)
        {
            <div class="rounded-xl border border-dashed
                        border-slate-300 bg-slate-50
                        px-5 py-10 text-center">

                <div class="mx-auto flex h-12 w-12 items-center
                            justify-center rounded-full bg-white
                            text-slate-400 shadow-sm">

                    <span class="material-symbols-rounded text-[24px]">
                        work_off
                    </span>

                </div>

                <p class="mt-3 text-sm font-semibold text-slate-700">
                    No active positions
                </p>

                <p class="mx-auto mt-1 max-w-md text-xs leading-5
                          text-slate-500">
                    This staff member does not currently have an
                    active position assigned.
                </p>

                @if (ShowAddButton && !IsDisabled)
                {
                    <button type="button"
                            @onclick="HandleAddAsync"
                            class="mt-4 inline-flex items-center gap-2
                                   rounded-xl bg-indigo-600 px-4 py-2.5
                                   text-sm font-semibold text-white
                                   transition hover:bg-indigo-700">

                        <span class="material-symbols-rounded text-[18px]">
                            add
                        </span>

                        Assign position

                    </button>
                }

            </div>
        }
        else
        {
            <div class="space-y-3">

                @foreach (var position in OrderedPositions)
                {
                    <article class="group rounded-xl border border-slate-200
                                    bg-white p-4 transition
                                    hover:border-indigo-200
                                    hover:shadow-sm">

                        <div class="flex flex-col gap-4
                                    sm:flex-row sm:items-start
                                    sm:justify-between">

                            <div class="flex min-w-0 items-start gap-3">

                                <div class="flex h-10 w-10 shrink-0
                                            items-center justify-center
                                            rounded-lg bg-indigo-50
                                            text-indigo-600">

                                    <span class="material-symbols-rounded
                                                 text-[20px]">
                                        workspace_premium
                                    </span>

                                </div>

                                <div class="min-w-0">

                                    <div class="flex flex-wrap items-center gap-2">

                                        <h3 class="break-words text-sm
                                                   font-semibold
                                                   text-slate-900">
                                            @GetPositionName(position)
                                        </h3>

                                        @if (position.IsCurrent)
                                        {
                                            <span class="inline-flex items-center
                                                         gap-1 rounded-full
                                                         bg-emerald-100
                                                         px-2 py-0.5
                                                         text-[10px]
                                                         font-semibold uppercase
                                                         tracking-wide
                                                         text-emerald-700">

                                                <span class="h-1.5 w-1.5
                                                             rounded-full
                                                             bg-emerald-500">
                                                </span>

                                                Current
                                            </span>
                                        }

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                   position.OrganisationStructureName))
                                    {
                                        <p class="mt-1 text-xs text-slate-500">
                                            @position.OrganisationStructureName
                                        </p>
                                    }

                                    <div class="mt-3 flex flex-wrap gap-x-5
                                                gap-y-2 text-xs
                                                text-slate-500">

                                        <span class="inline-flex items-center gap-1.5">

                                            <span class="material-symbols-rounded
                                                         text-[16px]">
                                                calendar_month
                                            </span>

                                            @GetEffectivePeriod(position)

                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(
                                       position.JobPositionStateName))
                                        {
                                            <span class="inline-flex
                                                         items-center gap-1.5">

                                                <span class="material-symbols-rounded
                                                             text-[16px]">
                                                    info
                                                </span>

                                                @position.JobPositionStateName

                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                            <button type="button"
                                    disabled="@IsDisabled"
                                    @onclick="() => HandleViewAsync(position)"
                                    class="inline-flex w-full shrink-0
                                           items-center justify-center gap-2
                                           rounded-lg border border-slate-200
                                           bg-white px-3 py-2 text-sm
                                           font-medium text-slate-700
                                           transition hover:bg-slate-50
                                           disabled:cursor-not-allowed
                                           disabled:opacity-50
                                           sm:w-auto">

                                <span class="material-symbols-rounded text-[17px]">
                                    visibility
                                </span>

                                View

                            </button>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>

@code {
    [Parameter]
    public IReadOnlyList<ProfilePositionDto> Positions { get; set; } =
        Array.Empty<ProfilePositionDto>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool ShowAddButton { get; set; } = true;

    [Parameter]
    public EventCallback OnAdd { get; set; }

    [Parameter]
    public EventCallback<ProfilePositionDto> OnView { get; set; }

    private List<ProfilePositionDto> ActivePositions =>
        Positions
            .Where(position =>
                position.IsActive)
            .ToList();

    private IEnumerable<ProfilePositionDto> OrderedPositions =>
        ActivePositions
            .OrderByDescending(position =>
                position.IsCurrent)
            .ThenByDescending(position =>
                position.FromDate)
            .ThenByDescending(position =>
                position.JobPositionId);

    private async Task HandleAddAsync()
    {
        if (IsDisabled)
        {
            return;
        }

        if (OnAdd.HasDelegate)
        {
            await OnAdd.InvokeAsync();
        }
    }

    private async Task HandleViewAsync(
        ProfilePositionDto position)
    {
        if (IsDisabled)
        {
            return;
        }

        if (OnView.HasDelegate)
        {
            await OnView.InvokeAsync(position);
        }
    }

    private static string GetPositionName(
        ProfilePositionDto position)
    {
        return string.IsNullOrWhiteSpace(
            position.PositionName)
            ? "Unnamed position"
            : position.PositionName;
    }

    private static string GetEffectivePeriod(
        ProfilePositionDto position)
    {
        if (!string.IsNullOrWhiteSpace(
            position.EffectivePeriodText))
        {
            return position.EffectivePeriodText;
        }

        return position.ToDate.HasValue
            ? $"{position.FromDate:dd MMM yyyy} – " +
              $"{position.ToDate.Value:dd MMM yyyy}"
            : $"{position.FromDate:dd MMM yyyy} – Present";
    }

 
}