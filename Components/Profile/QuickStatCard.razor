<article class="min-w-0 rounded-2xl border border-slate-200
                bg-white p-4 shadow-sm transition
                hover:border-slate-300 hover:shadow-md">

    <div class="flex items-start justify-between gap-3">

        <div class="min-w-0">

            <p class="text-xs font-medium uppercase tracking-wide
                      text-slate-500">
                @Label
            </p>

            <p class="mt-2 truncate text-xl font-bold text-slate-900
                      sm:text-2xl">
                @Value
            </p>

        </div>

  @*       <div class="@IconContainerClass">

            <span class="material-symbols-rounded text-[21px]">
                @Icon
            </span>

        </div> *@

    </div>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mt-3 truncate text-xs text-slate-500"
           title="@Description">
            @Description
        </p>
    }

</article>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } =
        string.Empty;

    [Parameter]
    public string Value { get; set; } =
        "-";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Icon { get; set; } =
        "info";

    [Parameter]
    public string Tone { get; set; } =
        "slate";

    private string IconContainerClass =>
        Tone.ToLowerInvariant() switch
        {
            "emerald" =>
                BaseIconClass +
                "bg-emerald-50 text-emerald-600",

            "blue" =>
                BaseIconClass +
                "bg-blue-50 text-blue-600",

            "violet" =>
                BaseIconClass +
                "bg-violet-50 text-violet-600",

            "amber" =>
                BaseIconClass +
                "bg-amber-50 text-amber-600",

            "cyan" =>
                BaseIconClass +
                "bg-cyan-50 text-cyan-600",

            "red" =>
                BaseIconClass +
                "bg-red-50 text-red-600",

            _ =>
                BaseIconClass +
                "bg-slate-100 text-slate-600"
        };

    private const string BaseIconClass =
        "flex h-10 w-10 shrink-0 items-center " +
        "justify-center rounded-xl ";
}